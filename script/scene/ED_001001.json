{
 "source": "ED_001001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "ED_001001:0x10e8",
   "off": 4328,
   "max": 68,
   "kind": "dialogue",
   "jp": "龍馬　高杉　桂\\n土方　沖田\\nこの五人の全てを\\n振り絞ったロックでも",
   "en": "",
   "op": "0x62",
   "msg": "0x2008"
  },
  {
   "id": "ED_001001:0x113c",
   "off": 4412,
   "max": 56,
   "kind": "dialogue",
   "jp": "三百年もの間\\n降り積もった\\n怨霊たちの\\n悲しみを溶かし",
   "en": "",
   "op": "0x62",
   "msg": "0x2009"
  },
  {
   "id": "ED_001001:0x1184",
   "off": 4484,
   "max": 52,
   "kind": "dialogue",
   "jp": "その凝り固まった心を\\n解放することは\\n出来なかった",
   "en": "",
   "op": "0x62",
   "msg": "0x200a"
  },
  {
   "id": "ED_001001:0x11c8",
   "off": 4552,
   "max": 36,
   "kind": "dialogue",
   "jp": "慶喜に乗り移った\\n怨霊の勝利だった",
   "en": "",
   "op": "0x62",
   "msg": "0x200b"
  },
  {
   "id": "ED_001001:0x1ba4",
   "off": 7076,
   "max": 56,
   "kind": "dialogue",
   "jp": "響かぬ……\\nそのような歌で\\n我らの悲しみ\\n癒せはせぬ！",
   "en": "",
   "op": "0x62",
   "msg": "0x200c"
  },
  {
   "id": "ED_001001:0x2404",
   "off": 9220,
   "max": 44,
   "kind": "dialogue",
   "jp": "慶喜様\\n今こそ　こやつらを\\n虜にできます！",
   "en": "",
   "op": "0x62",
   "msg": "0x200d"
  },
  {
   "id": "ED_001001:0x2444",
   "off": 9284,
   "max": 28,
   "kind": "dialogue",
   "jp": "貴方様の夢が叶いますぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x200e"
  },
  {
   "id": "ED_001001:0x2a1c",
   "off": 10780,
   "max": 48,
   "kind": "dialogue",
   "jp": "そうだね　直弼\\n坂本達を仲間に\\nできるんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x200f"
  },
  {
   "id": "ED_001001:0x3140",
   "off": 12608,
   "max": 40,
   "kind": "dialogue",
   "jp": "そんな　わしらの歌が\\n届かない……っ",
   "en": "",
   "op": "0x62",
   "msg": "0x2010"
  },
  {
   "id": "ED_001001:0x3978",
   "off": 14712,
   "max": 36,
   "kind": "dialogue",
   "jp": "聴くのだ！\\n予の……徳川の歌を！",
   "en": "",
   "op": "0x62",
   "msg": "0x2011"
  },
  {
   "id": "ED_001001:0x3e18",
   "off": 15896,
   "max": 44,
   "kind": "dialogue",
   "jp": "そして予と一緒に歩もう\\nこの泰平の世を……",
   "en": "",
   "op": "0x62",
   "msg": "0x2012"
  },
  {
   "id": "ED_001001:0x46c0",
   "off": 18112,
   "max": 52,
   "kind": "dialogue",
   "jp": "ダメだ！\\n悲しみの波動が　声が……\\n呑み込まれる！",
   "en": "",
   "op": "0x62",
   "msg": "0x2013"
  },
  {
   "id": "ED_001001:0x4b70",
   "off": 19312,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんて　なんて……\\n悲しい歌なんだ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2014"
  },
  {
   "id": "ED_001001:0x54bc",
   "off": 21692,
   "max": 40,
   "kind": "dialogue",
   "jp": "将軍様！\\nやめるんだ\\n……ぐぅっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2015"
  },
  {
   "id": "ED_001001:0x5968",
   "off": 22888,
   "max": 56,
   "kind": "dialogue",
   "jp": "ダメだよ……\\n僕　この気持ちが\\nわかっちゃうんだ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2016"
  },
  {
   "id": "ED_001001:0x6180",
   "off": 24960,
   "max": 56,
   "kind": "dialogue",
   "jp": "悲しみに……\\nわしの魂が悲しみに\\n呑み込まれていく！",
   "en": "",
   "op": "0x62",
   "msg": "0x2017"
  },
  {
   "id": "ED_001001:0x6c38",
   "off": 27704,
   "max": 48,
   "kind": "dialogue",
   "jp": "さあ　歌おう\\n予を受け止めて\\nくれるんだろう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2018"
  },
  {
   "id": "ED_001001:0x6c78",
   "off": 27768,
   "max": 28,
   "kind": "dialogue",
   "jp": "共に行こう\\n我らはひとつ",
   "en": "",
   "op": "0x62",
   "msg": "0x2019"
  },
  {
   "id": "ED_001001:0x6ca4",
   "off": 27812,
   "max": 44,
   "kind": "dialogue",
   "jp": "仲間になるんだ！\\n天歌泰平の友として……！",
   "en": "",
   "op": "0x62",
   "msg": "0x201a"
  },
  {
   "id": "ED_001001:0x731c",
   "off": 29468,
   "max": 84,
   "kind": "dialogue",
   "jp": "城内は静謐に満ちていた\\nそこには怒りも喜びも\\n人らしい感情を表す者は\\nいない……",
   "en": "",
   "op": "0x62",
   "msg": "0x201b"
  },
  {
   "id": "ED_001001:0x7ad0",
   "off": 31440,
   "max": 40,
   "kind": "dialogue",
   "jp": "……これこそが\\n予が望んでいた天歌泰平",
   "en": "",
   "op": "0x62",
   "msg": "0x201c"
  },
  {
   "id": "ED_001001:0x7b08",
   "off": 31496,
   "max": 40,
   "kind": "dialogue",
   "jp": "誰もが悲しまず\\n苦しまず　差別もない",
   "en": "",
   "op": "0x62",
   "msg": "0x201d"
  },
  {
   "id": "ED_001001:0x8340",
   "off": 33600,
   "max": 40,
   "kind": "dialogue",
   "jp": "予は一人じゃない\\nこれからも　ずっと",
   "en": "",
   "op": "0x62",
   "msg": "0x201e"
  },
  {
   "id": "ED_001001:0x887c",
   "off": 34940,
   "max": 56,
   "kind": "dialogue",
   "jp": "重く暗い空気が立ちこめる中\\n慶喜が無邪気に微笑んでいる",
   "en": "",
   "op": "0x62",
   "msg": "0x201f"
  },
  {
   "id": "ED_001001:0x88c4",
   "off": 35012,
   "max": 76,
   "kind": "dialogue",
   "jp": "その背には徳川三百年の内に\\n積もり積もった怨念が\\n霊となって取り憑いていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2020"
  },
  {
   "id": "ED_001001:0x8920",
   "off": 35104,
   "max": 52,
   "kind": "dialogue",
   "jp": "否　慶喜そのものがすでに\\nその怨霊と同化している",
   "en": "",
   "op": "0x62",
   "msg": "0x2021"
  },
  {
   "id": "ED_001001:0x8d98",
   "off": 36248,
   "max": 36,
   "kind": "dialogue",
   "jp": "お前も\\nそう思うだろう？\\n坂本龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x2022"
  },
  {
   "id": "ED_001001:0x93fc",
   "off": 37884,
   "max": 28,
   "kind": "dialogue",
   "jp": "はっ　まっこと\\nそのとおり",
   "en": "",
   "op": "0x62",
   "msg": "0x2023"
  },
  {
   "id": "ED_001001:0x9994",
   "off": 39316,
   "max": 32,
   "kind": "dialogue",
   "jp": "慶喜の声に龍馬が\\n顔を上げる",
   "en": "",
   "op": "0x62",
   "msg": "0x2024"
  },
  {
   "id": "ED_001001:0x99c4",
   "off": 39364,
   "max": 84,
   "kind": "dialogue",
   "jp": "だがその目にかつての輝きは\\nすでになく\\nどんよりと感情を失った\\n死人の目をしている",
   "en": "",
   "op": "0x62",
   "msg": "0x2025"
  },
  {
   "id": "ED_001001:0x9fa0",
   "off": 40864,
   "max": 48,
   "kind": "dialogue",
   "jp": "我ら全てみな\\nこの身と心を\\n将軍様に捧げます",
   "en": "",
   "op": "0x62",
   "msg": "0x2026"
  },
  {
   "id": "ED_001001:0xa44c",
   "off": 42060,
   "max": 32,
   "kind": "dialogue",
   "jp": "全ては泰平の世の\\nために……",
   "en": "",
   "op": "0x62",
   "msg": "0x2027"
  },
  {
   "id": "ED_001001:0xad34",
   "off": 44340,
   "max": 56,
   "kind": "dialogue",
   "jp": "俺はこれを望んでいた\\nきっと　近藤さんも\\n喜んでくれる",
   "en": "",
   "op": "0x62",
   "msg": "0x2028"
  },
  {
   "id": "ED_001001:0xb1e8",
   "off": 45544,
   "max": 56,
   "kind": "dialogue",
   "jp": "ふふ　ず～っとず～っと\\n一緒だよ\\nみんなも将軍様も……",
   "en": "",
   "op": "0x62",
   "msg": "0x2029"
  },
  {
   "id": "ED_001001:0xb79c",
   "off": 47004,
   "max": 32,
   "kind": "dialogue",
   "jp": "誰もが龍馬と同じ目を\\nしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x202a"
  },
  {
   "id": "ED_001001:0xb7cc",
   "off": 47052,
   "max": 48,
   "kind": "dialogue",
   "jp": "みな泰平化され　\\nかつての情熱を\\n奪われている",
   "en": "",
   "op": "0x62",
   "msg": "0x202b"
  },
  {
   "id": "ED_001001:0xb80c",
   "off": 47116,
   "max": 40,
   "kind": "dialogue",
   "jp": "それを見て　慶喜は再び\\n満足げに笑った",
   "en": "",
   "op": "0x62",
   "msg": "0x202c"
  },
  {
   "id": "ED_001001:0xbc78",
   "off": 48248,
   "max": 68,
   "kind": "dialogue",
   "jp": "直弼　直弼　見てよ直弼\\n予はようやく手に入れたよ\\n心の平穏を……",
   "en": "",
   "op": "0x62",
   "msg": "0x202d"
  },
  {
   "id": "ED_001001:0xbccc",
   "off": 48332,
   "max": 56,
   "kind": "dialogue",
   "jp": "もう一人じゃない\\n孤独じゃない\\n怯えることなんてない",
   "en": "",
   "op": "0x62",
   "msg": "0x202e"
  },
  {
   "id": "ED_001001:0xc50c",
   "off": 50444,
   "max": 36,
   "kind": "dialogue",
   "jp": "予は永遠の絆を\\n手に入れたんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x202f"
  },
  {
   "id": "ED_001001:0xcc50",
   "off": 52304,
   "max": 44,
   "kind": "dialogue",
   "jp": "ねえ　直弼　お前も\\n喜んでくれるだろう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2030"
  },
  {
   "id": "ED_001001:0xd10c",
   "off": 53516,
   "max": 48,
   "kind": "dialogue",
   "jp": "慶喜は振り向いて\\n自らと同化した怨霊に囁いた",
   "en": "",
   "op": "0x62",
   "msg": "0x2031"
  },
  {
   "id": "ED_001001:0xd14c",
   "off": 53580,
   "max": 68,
   "kind": "dialogue",
   "jp": "歓喜の声を上げる怨霊の中\\nただ一人悲しげな顔を\\n浮かべるその男に",
   "en": "",
   "op": "0x62",
   "msg": "0x2032"
  },
  {
   "id": "ED_001001:0xd740",
   "off": 55104,
   "max": 28,
   "kind": "dialogue",
   "jp": "慶喜様……\\nおいたわしや",
   "en": "",
   "op": "0x62",
   "msg": "0x2033"
  },
  {
   "id": "ED_001001:0xdb10",
   "off": 56080,
   "max": 96,
   "kind": "dialogue",
   "jp": "だがその井伊の声は\\n慶喜に届くことはない\\n呪いに呑み込まれた将軍は\\nほの暗い幸福に浸っていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2034"
  },
  {
   "id": "ED_001001:0xe178",
   "off": 57720,
   "max": 52,
   "kind": "dialogue",
   "jp": "ふふふっ　はははっっ！\\nもう寂しくなんてないんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2035"
  },
  {
   "id": "ED_001001:0xe1c4",
   "off": 57796,
   "max": 20,
   "kind": "dialogue",
   "jp": "予は幸せだよ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2036"
  },
  {
   "id": "ED_001001:0xeb44",
   "off": 60228,
   "max": 56,
   "kind": "dialogue",
   "jp": "慶喜様はすでに\\n怨霊の力に取り込まれて\\nしまった……",
   "en": "",
   "op": "0x62",
   "msg": "0x2037"
  },
  {
   "id": "ED_001001:0xec28",
   "off": 60456,
   "max": 68,
   "kind": "dialogue",
   "jp": "どうして……どうして\\nこのようなことに\\nなってしまったのか……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2038"
  },
  {
   "id": "ED_001001:0xec7c",
   "off": 60540,
   "max": 76,
   "kind": "dialogue",
   "jp": "私はただ　あなたを……\\n慶喜様を孤独の淵より\\nお救いし　お守りしたかった",
   "en": "",
   "op": "0x62",
   "msg": "0x2039"
  },
  {
   "id": "ED_001001:0xed74",
   "off": 60788,
   "max": 32,
   "kind": "dialogue",
   "jp": "だが……慶喜様は\\nもはや……",
   "en": "",
   "op": "0x62",
   "msg": "0x203a"
  },
  {
   "id": "ED_001001:0xf324",
   "off": 62244,
   "max": 44,
   "kind": "dialogue",
   "jp": "実体をもたぬ井伊の\\n目から涙が零れ落ちる",
   "en": "",
   "op": "0x62",
   "msg": "0x203b"
  },
  {
   "id": "ED_001001:0xf794",
   "off": 63380,
   "max": 40,
   "kind": "dialogue",
   "jp": "直弼？　ん？　直弼？\\nどこだ？　直弼",
   "en": "",
   "op": "0x62",
   "msg": "0x203c"
  },
  {
   "id": "ED_001001:0xff6c",
   "off": 65388,
   "max": 44,
   "kind": "dialogue",
   "jp": "ここに……\\nおそばにおりますよ\\n慶喜様……",
   "en": "",
   "op": "0x62",
   "msg": "0x203d"
  },
  {
   "id": "ED_001001:0x10590",
   "off": 66960,
   "max": 52,
   "kind": "dialogue",
   "jp": "けれど\\n慶喜が不安を見せれば\\n優しく頬をすり寄せた",
   "en": "",
   "op": "0x62",
   "msg": "0x203e"
  },
  {
   "id": "ED_001001:0x10a08",
   "off": 68104,
   "max": 68,
   "kind": "dialogue",
   "jp": "そこにおったか！\\nふふ　そうじゃな　直弼は\\n予を置いてはいかぬ！",
   "en": "",
   "op": "0x62",
   "msg": "0x203f"
  },
  {
   "id": "ED_001001:0x10a5c",
   "off": 68188,
   "max": 32,
   "kind": "dialogue",
   "jp": "ずぅっとずぅっと\\n一緒じゃ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2040"
  },
  {
   "id": "ED_001001:0x10f20",
   "off": 69408,
   "max": 68,
   "kind": "dialogue",
   "jp": "夢幻の世界にその心を\\n囚われた悲しき主を\\n直弼は優しく抱きしめた",
   "en": "",
   "op": "0x62",
   "msg": "0x2041"
  },
  {
   "id": "ED_001001:0x11514",
   "off": 70932,
   "max": 64,
   "kind": "dialogue",
   "jp": "ああ　それでも　確かに\\nこれで良かったのかも\\nしれません……",
   "en": "",
   "op": "0x62",
   "msg": "0x2042"
  },
  {
   "id": "ED_001001:0x11564",
   "off": 71012,
   "max": 20,
   "kind": "dialogue",
   "jp": "ええ　これで……",
   "en": "",
   "op": "0x62",
   "msg": "0x2043"
  },
  {
   "id": "ED_001001:0x11a8c",
   "off": 72332,
   "max": 60,
   "kind": "dialogue",
   "jp": "永久に慶喜の側に\\nいられることを\\n井伊直弼は喜ぶしかない",
   "en": "",
   "op": "0x62",
   "msg": "0x2044"
  },
  {
   "id": "ED_001001:0x11ad8",
   "off": 72408,
   "max": 56,
   "kind": "dialogue",
   "jp": "二条城に響くのは\\nただ　慶喜の狂った\\n笑い声だけ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2045"
  },
  {
   "id": "ED_001001:0x12054",
   "off": 73812,
   "max": 16,
   "kind": "dialogue",
   "jp": "ＢＡＤ ＥＮＤ",
   "en": "",
   "op": "0x62",
   "msg": "0x2046"
  }
 ]
}
