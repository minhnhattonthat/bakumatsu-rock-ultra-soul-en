{
 "source": "ED_002001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "ED_002001:0x12f0",
   "off": 4848,
   "max": 44,
   "kind": "dialogue",
   "jp": "いや～　今日の雷舞も\\n最高じゃったぜよー",
   "en": "",
   "op": "0x62",
   "msg": "0x205b"
  },
  {
   "id": "ED_002001:0x19b8",
   "off": 6584,
   "max": 24,
   "kind": "dialogue",
   "jp": "……ふん\\nまあまあだ",
   "en": "",
   "op": "0x62",
   "msg": "0x205c"
  },
  {
   "id": "ED_002001:0x2014",
   "off": 8212,
   "max": 64,
   "kind": "dialogue",
   "jp": "そんなこと言って～\\nお客さんのノリも\\n良かったじゃないですか",
   "en": "",
   "op": "0x62",
   "msg": "0x205d"
  },
  {
   "id": "ED_002001:0x2968",
   "off": 10600,
   "max": 60,
   "kind": "dialogue",
   "jp": "っつか　龍馬　テメェ！\\nまーた二曲目の\\n入りでトチったな！",
   "en": "",
   "op": "0x62",
   "msg": "0x205e"
  },
  {
   "id": "ED_002001:0x33b8",
   "off": 13240,
   "max": 20,
   "kind": "dialogue",
   "jp": "げっ　バレてたのか",
   "en": "",
   "op": "0x62",
   "msg": "0x205f"
  },
  {
   "id": "ED_002001:0x3b54",
   "off": 15188,
   "max": 56,
   "kind": "dialogue",
   "jp": "あれくらいなら\\nカバーするのは造作もない\\n気にするな",
   "en": "",
   "op": "0x62",
   "msg": "0x2060"
  },
  {
   "id": "ED_002001:0x41d4",
   "off": 16852,
   "max": 52,
   "kind": "dialogue",
   "jp": "ヒジゾーさん！\\n優しいぜよ～～っ\\nくぅ　泣けるぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x2061"
  },
  {
   "id": "ED_002001:0x4684",
   "off": 18052,
   "max": 48,
   "kind": "dialogue",
   "jp": "下手が無理しても\\nミスが増えるだけだ\\nからな",
   "en": "",
   "op": "0x62",
   "msg": "0x2062"
  },
  {
   "id": "ED_002001:0x4c24",
   "off": 19492,
   "max": 68,
   "kind": "dialogue",
   "jp": "ううっ　ヒジゾーさんは\\nシンディと違って\\n淡々ときっついぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2063"
  },
  {
   "id": "ED_002001:0x53f4",
   "off": 21492,
   "max": 68,
   "kind": "dialogue",
   "jp": "いやいや　土方さんも\\nスカシくんと一緒で\\n素直じゃないだけだよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2064"
  },
  {
   "id": "ED_002001:0x5ae0",
   "off": 23264,
   "max": 12,
   "kind": "dialogue",
   "jp": "おい　総司",
   "en": "",
   "op": "0x62",
   "msg": "0x2065"
  },
  {
   "id": "ED_002001:0x6188",
   "off": 24968,
   "max": 88,
   "kind": "dialogue",
   "jp": "つまり　何かあっても俺が\\n手助け（フォロー）するから\\n気にせず歌え\\nってことですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x2066"
  },
  {
   "id": "ED_002001:0x6700",
   "off": 26368,
   "max": 12,
   "kind": "dialogue",
   "jp": "……桂まで",
   "en": "",
   "op": "0x62",
   "msg": "0x2067"
  },
  {
   "id": "ED_002001:0x6dac",
   "off": 28076,
   "max": 24,
   "kind": "dialogue",
   "jp": "ですよね～\\n土方さん～",
   "en": "",
   "op": "0x62",
   "msg": "0x2068"
  },
  {
   "id": "ED_002001:0x72dc",
   "off": 29404,
   "max": 32,
   "kind": "dialogue",
   "jp": "……余計なことを\\n言うな　総司",
   "en": "",
   "op": "0x62",
   "msg": "0x2069"
  },
  {
   "id": "ED_002001:0x7778",
   "off": 30584,
   "max": 64,
   "kind": "dialogue",
   "jp": "誤解されやすい土方さんの\\n言い訳（フォロー）してる\\nだけです～",
   "en": "",
   "op": "0x62",
   "msg": "0x206a"
  },
  {
   "id": "ED_002001:0x7f3c",
   "off": 32572,
   "max": 24,
   "kind": "dialogue",
   "jp": "ソウちん\\nあんがとな",
   "en": "",
   "op": "0x62",
   "msg": "0x206b"
  },
  {
   "id": "ED_002001:0x8594",
   "off": 34196,
   "max": 60,
   "kind": "dialogue",
   "jp": "いえいえ～♪\\nでも　土方さんは僕の\\nだからね　トサカくん",
   "en": "",
   "op": "0x62",
   "msg": "0x206c"
  },
  {
   "id": "ED_002001:0x8c2c",
   "off": 35884,
   "max": 12,
   "kind": "dialogue",
   "jp": "お　おお",
   "en": "",
   "op": "0x62",
   "msg": "0x206d"
  },
  {
   "id": "ED_002001:0x9434",
   "off": 37940,
   "max": 68,
   "kind": "dialogue",
   "jp": "それにしても……\\n本当に自由に歌を歌える\\nようになったんですねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x206e"
  },
  {
   "id": "ED_002001:0x9b14",
   "off": 39700,
   "max": 56,
   "kind": "dialogue",
   "jp": "井伊を倒し　幕府の\\n怨霊とやらを倒した\\nおかげだぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x206f"
  },
  {
   "id": "ED_002001:0xa1e8",
   "off": 41448,
   "max": 68,
   "kind": "dialogue",
   "jp": "上様……いやもう違うのか\\n慶喜様も思い切った\\n決断をなさったよね",
   "en": "",
   "op": "0x62",
   "msg": "0x2070"
  },
  {
   "id": "ED_002001:0xaa08",
   "off": 43528,
   "max": 72,
   "kind": "dialogue",
   "jp": "ああ　まさか幕府を解体し\\n新しい政府に全てを任せて\\nしまわれるとは……",
   "en": "",
   "op": "0x62",
   "msg": "0x2071"
  },
  {
   "id": "ED_002001:0xaecc",
   "off": 44748,
   "max": 56,
   "kind": "dialogue",
   "jp": "でもさ～\\n慶喜様はずっと幸せに\\nなったんじゃないかな",
   "en": "",
   "op": "0x62",
   "msg": "0x2072"
  },
  {
   "id": "ED_002001:0xb68c",
   "off": 46732,
   "max": 52,
   "kind": "dialogue",
   "jp": "だな　二条城の\\nあの部屋から出て\\n解放されたろう",
   "en": "",
   "op": "0x62",
   "msg": "0x2073"
  },
  {
   "id": "ED_002001:0xbd5c",
   "off": 48476,
   "max": 64,
   "kind": "dialogue",
   "jp": "お気の毒でしたものね\\nあれは監禁されていた\\nのと変わりない……",
   "en": "",
   "op": "0x62",
   "msg": "0x2074"
  },
  {
   "id": "ED_002001:0xc438",
   "off": 50232,
   "max": 32,
   "kind": "dialogue",
   "jp": "隠居用の屋敷は\\nささやかだが",
   "en": "",
   "op": "0x62",
   "msg": "0x2075"
  },
  {
   "id": "ED_002001:0xc468",
   "off": 50280,
   "max": 52,
   "kind": "dialogue",
   "jp": "気に入っておられる\\nようだし\\n良かったのだろうな",
   "en": "",
   "op": "0x62",
   "msg": "0x2076"
  },
  {
   "id": "ED_002001:0xcca8",
   "off": 52392,
   "max": 44,
   "kind": "dialogue",
   "jp": "わしはまた慶喜様の\\nところに歌いに行くぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2077"
  },
  {
   "id": "ED_002001:0xd3f0",
   "off": 54256,
   "max": 24,
   "kind": "dialogue",
   "jp": "へえ\\n僕も行こうかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x2078"
  },
  {
   "id": "ED_002001:0xda48",
   "off": 55880,
   "max": 52,
   "kind": "dialogue",
   "jp": "うんうん　ソウちんも\\n一緒に行くぜよ\\nそれに今度",
   "en": "",
   "op": "0x62",
   "msg": "0x2079"
  },
  {
   "id": "ED_002001:0xda8c",
   "off": 55948,
   "max": 44,
   "kind": "dialogue",
   "jp": "わしらの雷舞を聴きに来る\\n言うとったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x207a"
  },
  {
   "id": "ED_002001:0xe248",
   "off": 57928,
   "max": 12,
   "kind": "dialogue",
   "jp": "ええっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x207b"
  },
  {
   "id": "ED_002001:0xe8f0",
   "off": 59632,
   "max": 40,
   "kind": "dialogue",
   "jp": "おっ　おい！\\nいつの間にそんな話に！",
   "en": "",
   "op": "0x62",
   "msg": "0x207c"
  },
  {
   "id": "ED_002001:0xf124",
   "off": 61732,
   "max": 32,
   "kind": "dialogue",
   "jp": "なにせわしら\\n魂友だからなっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x207d"
  },
  {
   "id": "ED_002001:0xf5c0",
   "off": 62912,
   "max": 44,
   "kind": "dialogue",
   "jp": "雷舞の話も\\nいっぱいしたんじゃ\\nそしたら",
   "en": "",
   "op": "0x62",
   "msg": "0x207e"
  },
  {
   "id": "ED_002001:0xf5fc",
   "off": 62972,
   "max": 68,
   "kind": "dialogue",
   "jp": "まだ　外に出るのは\\n怖いけど　雷舞のために\\n頑張ると言うとったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x207f"
  },
  {
   "id": "ED_002001:0xfd68",
   "off": 64872,
   "max": 60,
   "kind": "dialogue",
   "jp": "なんと畏れおおい……\\n我々の雷舞に上様……\\nいや　慶喜様が",
   "en": "",
   "op": "0x62",
   "msg": "0x2080"
  },
  {
   "id": "ED_002001:0x1043c",
   "off": 66620,
   "max": 44,
   "kind": "dialogue",
   "jp": "慶喜様と魂友って　\\nトサカくん　すごいなー",
   "en": "",
   "op": "0x62",
   "msg": "0x2081"
  },
  {
   "id": "ED_002001:0x10b04",
   "off": 68356,
   "max": 40,
   "kind": "dialogue",
   "jp": "しかし　慶喜様が\\nいらっしゃるならば",
   "en": "",
   "op": "0x62",
   "msg": "0x2082"
  },
  {
   "id": "ED_002001:0x10b3c",
   "off": 68412,
   "max": 44,
   "kind": "dialogue",
   "jp": "次の雷舞　いつも以上に\\n気合いを入れねばな",
   "en": "",
   "op": "0x62",
   "msg": "0x2083"
  },
  {
   "id": "ED_002001:0x111a8",
   "off": 70056,
   "max": 56,
   "kind": "dialogue",
   "jp": "そんなもんかのう\\nいつもどおりでええと\\n思うんじゃが",
   "en": "",
   "op": "0x62",
   "msg": "0x2084"
  },
  {
   "id": "ED_002001:0x1165c",
   "off": 71260,
   "max": 36,
   "kind": "dialogue",
   "jp": "慶喜様に対して\\nそんなわけにいくか",
   "en": "",
   "op": "0x62",
   "msg": "0x2085"
  },
  {
   "id": "ED_002001:0x11d18",
   "off": 72984,
   "max": 36,
   "kind": "dialogue",
   "jp": "トサカくんは\\n度胸ありすぎだよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2086"
  },
  {
   "id": "ED_002001:0x122b8",
   "off": 74424,
   "max": 112,
   "kind": "dialogue",
   "jp": "そんなたわいもない\\nやりとりをしながら\\n京の町を歩く龍馬たち\\nしかし　そんな龍馬たちを\\n見つめる黒い影があった",
   "en": "",
   "op": "0x62",
   "msg": "0x2087"
  },
  {
   "id": "ED_002001:0x12768",
   "off": 75624,
   "max": 56,
   "kind": "dialogue",
   "jp": "まあ　でも\\n慶喜様が好きな歌は\\n入れようと思うんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x2088"
  },
  {
   "id": "ED_002001:0x12c30",
   "off": 76848,
   "max": 44,
   "kind": "dialogue",
   "jp": "そう言って龍馬が角を\\n曲がろうとした瞬間",
   "en": "",
   "op": "0x62",
   "msg": "0x2089"
  },
  {
   "id": "ED_002001:0x13484",
   "off": 78980,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぐっっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x208a"
  },
  {
   "id": "ED_002001:0x139ac",
   "off": 80300,
   "max": 36,
   "kind": "dialogue",
   "jp": "突然の銃声に\\nみんなの足が止まる",
   "en": "",
   "op": "0x62",
   "msg": "0x208b"
  },
  {
   "id": "ED_002001:0x139e0",
   "off": 80352,
   "max": 64,
   "kind": "dialogue",
   "jp": "そしてさっきまで\\n笑顔で話していた龍馬が\\nゆっくりと倒れていく",
   "en": "",
   "op": "0x62",
   "msg": "0x208c"
  },
  {
   "id": "ED_002001:0x142f8",
   "off": 82680,
   "max": 20,
   "kind": "dialogue",
   "jp": "\\fnt1龍馬！\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x208d"
  },
  {
   "id": "ED_002001:0x149b4",
   "off": 84404,
   "max": 24,
   "kind": "dialogue",
   "jp": "\\fnt1龍馬くんっ！\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x208e"
  },
  {
   "id": "ED_002001:0x14f58",
   "off": 85848,
   "max": 52,
   "kind": "dialogue",
   "jp": "高杉と桂が\\n龍馬に駆け寄り\\n土方が銃声の方を向く",
   "en": "",
   "op": "0x62",
   "msg": "0x208f"
  },
  {
   "id": "ED_002001:0x157b0",
   "off": 87984,
   "max": 20,
   "kind": "dialogue",
   "jp": "\\fnt1誰だっ\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x2090"
  },
  {
   "id": "ED_002001:0x15f0c",
   "off": 89868,
   "max": 56,
   "kind": "dialogue",
   "jp": "くくくっ……やったぞ！\\n徳川幕府の\\n恨み　思い知れ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2091"
  },
  {
   "id": "ED_002001:0x15f58",
   "off": 89944,
   "max": 16,
   "kind": "dialogue",
   "jp": "坂本　龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x2092"
  },
  {
   "id": "ED_002001:0x166f4",
   "off": 91892,
   "max": 24,
   "kind": "dialogue",
   "jp": "\\fnt1待てっっ！\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x2093"
  },
  {
   "id": "ED_002001:0x16ea0",
   "off": 93856,
   "max": 56,
   "kind": "dialogue",
   "jp": "無理だよ　土方さん\\nあいつ　忍だ\\n相当逃げ足が速い……",
   "en": "",
   "op": "0x62",
   "msg": "0x2094"
  },
  {
   "id": "ED_002001:0x17574",
   "off": 95604,
   "max": 8,
   "kind": "dialogue",
   "jp": "くっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2095"
  },
  {
   "id": "ED_002001:0x17da0",
   "off": 97696,
   "max": 40,
   "kind": "dialogue",
   "jp": "それより龍馬くんが\\n弾に当たって……っ",
   "en": "",
   "op": "0x62",
   "msg": "0x2096"
  },
  {
   "id": "ED_002001:0x18464",
   "off": 99428,
   "max": 52,
   "kind": "dialogue",
   "jp": "こいつ　胸を\\n撃たれてる……\\n息をしてねえんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2097"
  },
  {
   "id": "ED_002001:0x18c4c",
   "off": 101452,
   "max": 32,
   "kind": "dialogue",
   "jp": "まさか\\n心臓を撃たれたのか",
   "en": "",
   "op": "0x62",
   "msg": "0x2098"
  },
  {
   "id": "ED_002001:0x1930c",
   "off": 103180,
   "max": 16,
   "kind": "dialogue",
   "jp": "トサカくん",
   "en": "",
   "op": "0x62",
   "msg": "0x2099"
  },
  {
   "id": "ED_002001:0x198a8",
   "off": 104616,
   "max": 52,
   "kind": "dialogue",
   "jp": "胸を押さえて\\n地面に倒れた龍馬に\\nみんなが駆け寄る",
   "en": "",
   "op": "0x62",
   "msg": "0x209a"
  },
  {
   "id": "ED_002001:0x19fa4",
   "off": 106404,
   "max": 44,
   "kind": "dialogue",
   "jp": "おい！　目ぇ開けろよ！\\nおい！　嘘だろ……",
   "en": "",
   "op": "0x62",
   "msg": "0x209b"
  },
  {
   "id": "ED_002001:0x1a770",
   "off": 108400,
   "max": 24,
   "kind": "dialogue",
   "jp": "坂本……\\nそんなバカな",
   "en": "",
   "op": "0x62",
   "msg": "0x209c"
  },
  {
   "id": "ED_002001:0x1ab34",
   "off": 109364,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方も\\n目を閉じ動かない\\n龍馬を見て愕然と\\n膝をつく",
   "en": "",
   "op": "0x62",
   "msg": "0x209d"
  },
  {
   "id": "ED_002001:0x1b0e0",
   "off": 110816,
   "max": 60,
   "kind": "dialogue",
   "jp": "なぜだ……！\\nお前はあの呪いの歌にも\\n怨霊にも打ち勝った",
   "en": "",
   "op": "0x62",
   "msg": "0x209e"
  },
  {
   "id": "ED_002001:0x1b598",
   "off": 112024,
   "max": 48,
   "kind": "dialogue",
   "jp": "なのに　こんなところで\\nあっけなく死ぬのか",
   "en": "",
   "op": "0x62",
   "msg": "0x209f"
  },
  {
   "id": "ED_002001:0x1bee0",
   "off": 114400,
   "max": 48,
   "kind": "dialogue",
   "jp": "そんなのオレ様が許すか！\\nいいから目を開けろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x20a0"
  },
  {
   "id": "ED_002001:0x1bf20",
   "off": 114464,
   "max": 60,
   "kind": "dialogue",
   "jp": "オレ様はまだテメェに\\n言ってねぇことが\\n山ほどあるんだよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x20a1"
  },
  {
   "id": "ED_002001:0x1c6f4",
   "off": 116468,
   "max": 52,
   "kind": "dialogue",
   "jp": "俺もだ\\nこんなことならもっと\\n本音で話せば良かった",
   "en": "",
   "op": "0x62",
   "msg": "0x20a2"
  },
  {
   "id": "ED_002001:0x1cdc4",
   "off": 118212,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああ　口を開けば\\n喧嘩ばっかり売って……",
   "en": "",
   "op": "0x62",
   "msg": "0x20a3"
  },
  {
   "id": "ED_002001:0x1ce00",
   "off": 118272,
   "max": 36,
   "kind": "dialogue",
   "jp": "一言だけ　お前の音楽は\\n最高だって",
   "en": "",
   "op": "0x62",
   "msg": "0x20a4"
  },
  {
   "id": "ED_002001:0x1ce34",
   "off": 118324,
   "max": 68,
   "kind": "dialogue",
   "jp": "お前にならあのギターを\\n託せるっていつか言おうと\\n思ってたのに……",
   "en": "",
   "op": "0x62",
   "msg": "0x20a5"
  },
  {
   "id": "ED_002001:0x1d514",
   "off": 120084,
   "max": 52,
   "kind": "dialogue",
   "jp": "俺も技術のことばかり\\nとやかく言って\\nしまった……",
   "en": "",
   "op": "0x62",
   "msg": "0x20a6"
  },
  {
   "id": "ED_002001:0x1d558",
   "off": 120152,
   "max": 64,
   "kind": "dialogue",
   "jp": "そんなものじゃなく\\nお前の歌にある熱情を\\nただ尊敬していたのに",
   "en": "",
   "op": "0x62",
   "msg": "0x20a7"
  },
  {
   "id": "ED_002001:0x1dd80",
   "off": 122240,
   "max": 56,
   "kind": "dialogue",
   "jp": "死ぬな　坂本！\\n俺はお前ともっともっと\\n歌いたいんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x20a8"
  },
  {
   "id": "ED_002001:0x1e4b0",
   "off": 124080,
   "max": 64,
   "kind": "dialogue",
   "jp": "オレもだ！\\nオレももっとお前とずっと\\nロックをやりたい……！",
   "en": "",
   "op": "0x62",
   "msg": "0x20a9"
  },
  {
   "id": "ED_002001:0x1ea84",
   "off": 125572,
   "max": 88,
   "kind": "dialogue",
   "jp": "龍馬にすがるように\\n高杉と土方が嘆く\\nなぜか　その姿を\\n桂と沖田は遠巻きに\\nしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x20aa"
  },
  {
   "id": "ED_002001:0x1ef20",
   "off": 126752,
   "max": 56,
   "kind": "dialogue",
   "jp": "……くぅっ！\\n桂さんも何か龍馬に\\n言ってやってくれよ",
   "en": "",
   "op": "0x62",
   "msg": "0x20ab"
  },
  {
   "id": "ED_002001:0x1f5f4",
   "off": 128500,
   "max": 28,
   "kind": "dialogue",
   "jp": "総司も坂本に\\n別れを……",
   "en": "",
   "op": "0x62",
   "msg": "0x20ac"
  },
  {
   "id": "ED_002001:0x1fe00",
   "off": 130560,
   "max": 20,
   "kind": "dialogue",
   "jp": "そう言われても……",
   "en": "",
   "op": "0x62",
   "msg": "0x20ad"
  },
  {
   "id": "ED_002001:0x20290",
   "off": 131728,
   "max": 48,
   "kind": "dialogue",
   "jp": "だって　ねえ？\\nトサカくん　\\n狸寝入りだし？",
   "en": "",
   "op": "0x62",
   "msg": "0x20ae"
  },
  {
   "id": "ED_002001:0x2073c",
   "off": 132924,
   "max": 48,
   "kind": "dialogue",
   "jp": "息してますよね\\n血も流れ出して\\nませんし……",
   "en": "",
   "op": "0x62",
   "msg": "0x20af"
  },
  {
   "id": "ED_002001:0x211f8",
   "off": 135672,
   "max": 20,
   "kind": "dialogue",
   "jp": "\\fnt1……は？\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x20b0"
  },
  {
   "id": "ED_002001:0x21bf8",
   "off": 138232,
   "max": 52,
   "kind": "dialogue",
   "jp": "あ～っ！\\nなんでバラすんじゃ\\nソウちん　センセー！",
   "en": "",
   "op": "0x62",
   "msg": "0x20b1"
  },
  {
   "id": "ED_002001:0x21c44",
   "off": 138308,
   "max": 64,
   "kind": "dialogue",
   "jp": "せっかく珍しく\\nシンディとヒジゾーさんの\\n本音が聞けたのに……",
   "en": "",
   "op": "0x62",
   "msg": "0x20b2"
  },
  {
   "id": "ED_002001:0x22518",
   "off": 140568,
   "max": 36,
   "kind": "dialogue",
   "jp": "\\fnt1ええっ\\nな　なんで\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x20b3"
  },
  {
   "id": "ED_002001:0x22bd8",
   "off": 142296,
   "max": 44,
   "kind": "dialogue",
   "jp": "……生きているのか\\n心臓を撃たれて……？",
   "en": "",
   "op": "0x62",
   "msg": "0x20b4"
  },
  {
   "id": "ED_002001:0x233c8",
   "off": 144328,
   "max": 12,
   "kind": "dialogue",
   "jp": "てへっ☆",
   "en": "",
   "op": "0x62",
   "msg": "0x20b5"
  },
  {
   "id": "ED_002001:0x23c94",
   "off": 146580,
   "max": 48,
   "kind": "dialogue",
   "jp": "\\fnt1てへっじゃねえっ！\\n龍馬！　テメェ！\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x20b6"
  },
  {
   "id": "ED_002001:0x2485c",
   "off": 149596,
   "max": 28,
   "kind": "dialogue",
   "jp": "……騙したのか\\n坂本……",
   "en": "",
   "op": "0x62",
   "msg": "0x20b7"
  },
  {
   "id": "ED_002001:0x2503c",
   "off": 151612,
   "max": 44,
   "kind": "dialogue",
   "jp": "い　いや　騙したわけじゃ\\nないんじゃよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x20b8"
  },
  {
   "id": "ED_002001:0x25078",
   "off": 151672,
   "max": 68,
   "kind": "dialogue",
   "jp": "胸にどーんってきて痛くて\\n息が出来なくなってたのは\\n本当のことぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x20b9"
  },
  {
   "id": "ED_002001:0x256fc",
   "off": 153340,
   "max": 64,
   "kind": "dialogue",
   "jp": "というか　よく銃で胸を\\n撃たれて生きてるね\\nトサカくん　人間？",
   "en": "",
   "op": "0x62",
   "msg": "0x20ba"
  },
  {
   "id": "ED_002001:0x25bb8",
   "off": 154552,
   "max": 60,
   "kind": "dialogue",
   "jp": "わしは人間じゃ！\\nこれが胸に入ってたから\\n助かったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x20bb"
  },
  {
   "id": "ED_002001:0x266a4",
   "off": 157348,
   "max": 48,
   "kind": "dialogue",
   "jp": "おやおや\\nそれはギターの\\n爪（ピック）ですか",
   "en": "",
   "op": "0x62",
   "msg": "0x20bc"
  },
  {
   "id": "ED_002001:0x26b54",
   "off": 158548,
   "max": 52,
   "kind": "dialogue",
   "jp": "それで弾が止まるなんて\\nトサカくんは悪運強いなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x20bd"
  },
  {
   "id": "ED_002001:0x2732c",
   "off": 160556,
   "max": 40,
   "kind": "dialogue",
   "jp": "爪程度で防げるかよ\\nありえねえ……",
   "en": "",
   "op": "0x62",
   "msg": "0x20be"
  },
  {
   "id": "ED_002001:0x279ec",
   "off": 162284,
   "max": 40,
   "kind": "dialogue",
   "jp": "すぐ壊れるから\\n頑丈なの\\n作ったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x20bf"
  },
  {
   "id": "ED_002001:0x280b0",
   "off": 164016,
   "max": 44,
   "kind": "dialogue",
   "jp": "はい\\n私が作りました\\nじつは鉄で出来てます",
   "en": "",
   "op": "0x62",
   "msg": "0x20c0"
  },
  {
   "id": "ED_002001:0x280ec",
   "off": 164076,
   "max": 48,
   "kind": "dialogue",
   "jp": "さすがに　歪んでいますね\\n作り直さないと……",
   "en": "",
   "op": "0x62",
   "msg": "0x20c1"
  },
  {
   "id": "ED_002001:0x287b4",
   "off": 165812,
   "max": 40,
   "kind": "dialogue",
   "jp": "しばらく　気を失って\\nたんだと思うぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x20c2"
  },
  {
   "id": "ED_002001:0x287ec",
   "off": 165868,
   "max": 68,
   "kind": "dialogue",
   "jp": "目が覚めたらシンディと\\nヒジゾーさんがえっらい\\n泣いてるから……",
   "en": "",
   "op": "0x62",
   "msg": "0x20c3"
  },
  {
   "id": "ED_002001:0x28840",
   "off": 165952,
   "max": 24,
   "kind": "dialogue",
   "jp": "起きるに起きれんで……",
   "en": "",
   "op": "0x62",
   "msg": "0x20c4"
  },
  {
   "id": "ED_002001:0x291dc",
   "off": 168412,
   "max": 20,
   "kind": "dialogue",
   "jp": "誰も泣いてねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x20c5"
  },
  {
   "id": "ED_002001:0x29990",
   "off": 170384,
   "max": 28,
   "kind": "dialogue",
   "jp": "まったく\\n人騒がせなヤツだ",
   "en": "",
   "op": "0x62",
   "msg": "0x20c6"
  },
  {
   "id": "ED_002001:0x2a044",
   "off": 172100,
   "max": 44,
   "kind": "dialogue",
   "jp": "でもスカシくんも\\n土方さんも目が赤いよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x20c7"
  },
  {
   "id": "ED_002001:0x2a858",
   "off": 174168,
   "max": 40,
   "kind": "dialogue",
   "jp": "こ　これは\\n目にゴミが入っただけだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x20c8"
  },
  {
   "id": "ED_002001:0x2acfc",
   "off": 175356,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうだ\\n汗がしみただけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x20c9"
  },
  {
   "id": "ED_002001:0x2b4a8",
   "off": 177320,
   "max": 40,
   "kind": "dialogue",
   "jp": "俺はお前ともっともっと\\n歌いたいんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x20ca"
  },
  {
   "id": "ED_002001:0x2bbfc",
   "off": 179196,
   "max": 8,
   "kind": "dialogue",
   "jp": "うっ",
   "en": "",
   "op": "0x62",
   "msg": "0x20cb"
  },
  {
   "id": "ED_002001:0x2c1f0",
   "off": 180720,
   "max": 44,
   "kind": "dialogue",
   "jp": "オレももっとお前とずっと\\nロックをやりたい",
   "en": "",
   "op": "0x62",
   "msg": "0x20cc"
  },
  {
   "id": "ED_002001:0x2c948",
   "off": 182600,
   "max": 8,
   "kind": "dialogue",
   "jp": "ううっ",
   "en": "",
   "op": "0x62",
   "msg": "0x20cd"
  },
  {
   "id": "ED_002001:0x2cf34",
   "off": 184116,
   "max": 44,
   "kind": "dialogue",
   "jp": "二人が忘れても私は\\nちゃんと覚えてますよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x20ce"
  },
  {
   "id": "ED_002001:0x2d00c",
   "off": 184332,
   "max": 56,
   "kind": "dialogue",
   "jp": "あの言葉には二人の\\nロックが詰まってた\\n感激しました",
   "en": "",
   "op": "0x62",
   "msg": "0x20cf"
  },
  {
   "id": "ED_002001:0x2d6dc",
   "off": 186076,
   "max": 40,
   "kind": "dialogue",
   "jp": "さっすがメガネくん！\\n良いこと言うね～",
   "en": "",
   "op": "0x62",
   "msg": "0x20d0"
  },
  {
   "id": "ED_002001:0x2dda4",
   "off": 187812,
   "max": 56,
   "kind": "dialogue",
   "jp": "うんうん　あの言葉は\\nわしの胸にず～んと\\n響いたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x20d1"
  },
  {
   "id": "ED_002001:0x2e898",
   "off": 190616,
   "max": 40,
   "kind": "dialogue",
   "jp": "ほらほら観念して\\n素直になっちゃいなよ",
   "en": "",
   "op": "0x62",
   "msg": "0x20d2"
  },
  {
   "id": "ED_002001:0x2ed44",
   "off": 191812,
   "max": 32,
   "kind": "dialogue",
   "jp": "わしももう一回\\n聞きたいぜよー",
   "en": "",
   "op": "0x62",
   "msg": "0x20d3"
  },
  {
   "id": "ED_002001:0x2f5f8",
   "off": 194040,
   "max": 28,
   "kind": "dialogue",
   "jp": "だってさ　晋作\\n土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x20d4"
  },
  {
   "id": "ED_002001:0x2ff80",
   "off": 196480,
   "max": 32,
   "kind": "dialogue",
   "jp": "うるさい！　\\n二度も言うか！",
   "en": "",
   "op": "0x62",
   "msg": "0x20d5"
  },
  {
   "id": "ED_002001:0x306a0",
   "off": 198304,
   "max": 48,
   "kind": "dialogue",
   "jp": "あんな恥ずかしいことは\\n二度と言ってやらん！",
   "en": "",
   "op": "0x62",
   "msg": "0x20d6"
  },
  {
   "id": "ED_002001:0x30c68",
   "off": 199784,
   "max": 44,
   "kind": "dialogue",
   "jp": "それより　襲った者を\\n突き止めねばな……",
   "en": "",
   "op": "0x62",
   "msg": "0x20d7"
  },
  {
   "id": "ED_002001:0x314f8",
   "off": 201976,
   "max": 72,
   "kind": "dialogue",
   "jp": "そうそう　二度も\\n奇跡（ラッキー）は\\nないだろうし\\n幕府の残党か……",
   "en": "",
   "op": "0x62",
   "msg": "0x20d8"
  },
  {
   "id": "ED_002001:0x319bc",
   "off": 203196,
   "max": 52,
   "kind": "dialogue",
   "jp": "解体されたことに\\n怨みを持つ者も\\n多いだろうからな",
   "en": "",
   "op": "0x62",
   "msg": "0x20d9"
  },
  {
   "id": "ED_002001:0x32174",
   "off": 205172,
   "max": 36,
   "kind": "dialogue",
   "jp": "真面目な顔して\\n誤魔化しちゃって～",
   "en": "",
   "op": "0x62",
   "msg": "0x20da"
  },
  {
   "id": "ED_002001:0x32b38",
   "off": 207672,
   "max": 20,
   "kind": "dialogue",
   "jp": "真面目な話だっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x20db"
  },
  {
   "id": "ED_002001:0x33358",
   "off": 209752,
   "max": 64,
   "kind": "dialogue",
   "jp": "惜しかったぜよ～\\nセンセーとソウちんのも\\n聞きたかったぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x20dc"
  },
  {
   "id": "ED_002001:0x33a38",
   "off": 211512,
   "max": 68,
   "kind": "dialogue",
   "jp": "えっ　トサカくん\\n僕に愛を語られたいの？\\nいいよ～　語っちゃうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x20dd"
  },
  {
   "id": "ED_002001:0x34120",
   "off": 213280,
   "max": 48,
   "kind": "dialogue",
   "jp": "私の愛は龍馬くんに\\n届いてないんでしょうかね",
   "en": "",
   "op": "0x62",
   "msg": "0x20de"
  },
  {
   "id": "ED_002001:0x347f0",
   "off": 215024,
   "max": 44,
   "kind": "dialogue",
   "jp": "わー　そんなことは\\nないぜよ　センセー！",
   "en": "",
   "op": "0x62",
   "msg": "0x20df"
  },
  {
   "id": "ED_002001:0x34ea4",
   "off": 216740,
   "max": 68,
   "kind": "dialogue",
   "jp": "大好きじゃ！　センセーも\\nソウちんもシンディも\\nヒジゾーさんもっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x20e0"
  },
  {
   "id": "ED_002001:0x3555c",
   "off": 218460,
   "max": 60,
   "kind": "dialogue",
   "jp": "わいわいがやがやと\\n騒がしく龍馬たちは\\n京の街を歩いていく",
   "en": "",
   "op": "0x62",
   "msg": "0x20e1"
  },
  {
   "id": "ED_002001:0x355a8",
   "off": 218536,
   "max": 24,
   "kind": "dialogue",
   "jp": "暗殺騒ぎもなんのその",
   "en": "",
   "op": "0x62",
   "msg": "0x20e2"
  },
  {
   "id": "ED_002001:0x355d0",
   "off": 218576,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬たちのロック街道は\\nまだまだ続いていく……！",
   "en": "",
   "op": "0x62",
   "msg": "0x20e3"
  }
 ]
}
