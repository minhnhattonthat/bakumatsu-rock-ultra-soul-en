{
 "source": "ED_003001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "ED_003001:0x14b0",
   "off": 5296,
   "max": 56,
   "kind": "dialogue",
   "jp": "はあ　歌った　歌った\\n今日の雷舞は\\n最高だったぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x218b"
  },
  {
   "id": "ED_003001:0x1d54",
   "off": 7508,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレ様の熱い演奏に\\nみんな釘付けだった\\nからな",
   "en": "",
   "op": "0x62",
   "msg": "0x218c"
  },
  {
   "id": "ED_003001:0x2200",
   "off": 8704,
   "max": 64,
   "kind": "dialogue",
   "jp": "みんな喜んでましたね\\n新しいお客さんも\\nずいぶんと増えましたし",
   "en": "",
   "op": "0x62",
   "msg": "0x218d"
  },
  {
   "id": "ED_003001:0x27d4",
   "off": 10196,
   "max": 72,
   "kind": "dialogue",
   "jp": "龍馬達の奮闘で\\n徳川の怨霊も鎮まり\\n世は真の泰平を\\n取り戻しつつあった",
   "en": "",
   "op": "0x62",
   "msg": "0x218e"
  },
  {
   "id": "ED_003001:0x282c",
   "off": 10284,
   "max": 72,
   "kind": "dialogue",
   "jp": "天歌による洗脳も\\n徐々に解け\\nロックが人々に\\n受け入れられはじめたのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x218f"
  },
  {
   "id": "ED_003001:0x2cb4",
   "off": 11444,
   "max": 68,
   "kind": "dialogue",
   "jp": "ロックを堂々と歌えるまで\\n平和になったのは\\n素晴らしいことじゃなー",
   "en": "",
   "op": "0x62",
   "msg": "0x2190"
  },
  {
   "id": "ED_003001:0x2da0",
   "off": 11680,
   "max": 28,
   "kind": "dialogue",
   "jp": "なあ　シンディ\\nセンセー",
   "en": "",
   "op": "0x62",
   "msg": "0x2191"
  },
  {
   "id": "ED_003001:0x359c",
   "off": 13724,
   "max": 60,
   "kind": "dialogue",
   "jp": "なにを他人事みたいに\\n言ってやがるんだ\\nのんきな野郎だな",
   "en": "",
   "op": "0x62",
   "msg": "0x2192"
  },
  {
   "id": "ED_003001:0x3a54",
   "off": 14932,
   "max": 60,
   "kind": "dialogue",
   "jp": "龍馬くんには\\n自分のお手柄だなんて\\n意識はないんですって",
   "en": "",
   "op": "0x62",
   "msg": "0x2193"
  },
  {
   "id": "ED_003001:0x3fa8",
   "off": 16296,
   "max": 24,
   "kind": "dialogue",
   "jp": "だからムカつくんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2194"
  },
  {
   "id": "ED_003001:0x4884",
   "off": 18564,
   "max": 36,
   "kind": "dialogue",
   "jp": "おおっ　坂本龍馬さんと\\nその一味だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2195"
  },
  {
   "id": "ED_003001:0x51c4",
   "off": 20932,
   "max": 20,
   "kind": "dialogue",
   "jp": "誰が一味だ　誰が！",
   "en": "",
   "op": "0x62",
   "msg": "0x2196"
  },
  {
   "id": "ED_003001:0x5b64",
   "off": 23396,
   "max": 68,
   "kind": "dialogue",
   "jp": "新選組の土方さんと\\n沖田さんとの五人の雷舞\\nめちゃめちゃ良かった！",
   "en": "",
   "op": "0x62",
   "msg": "0x2197"
  },
  {
   "id": "ED_003001:0x6024",
   "off": 24612,
   "max": 56,
   "kind": "dialogue",
   "jp": "わはは　気に入って\\nもらえたなら\\nわしもうれしいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2198"
  },
  {
   "id": "ED_003001:0x64d8",
   "off": 25816,
   "max": 52,
   "kind": "dialogue",
   "jp": "次の雷舞も楽しみに\\nしてますよ！\\n頑張って下さい！",
   "en": "",
   "op": "0x62",
   "msg": "0x2199"
  },
  {
   "id": "ED_003001:0x6f3c",
   "off": 28476,
   "max": 60,
   "kind": "dialogue",
   "jp": "おう　わしはいつだって\\n全力で歌ってるぜよ\\nわはははは！",
   "en": "",
   "op": "0x62",
   "msg": "0x219a"
  },
  {
   "id": "ED_003001:0x7814",
   "off": 30740,
   "max": 8,
   "kind": "dialogue",
   "jp": "……",
   "en": "",
   "op": "0x62",
   "msg": "0x219b"
  },
  {
   "id": "ED_003001:0x8088",
   "off": 32904,
   "max": 24,
   "kind": "dialogue",
   "jp": "どうかしましたか　晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x219c"
  },
  {
   "id": "ED_003001:0x85b8",
   "off": 34232,
   "max": 20,
   "kind": "dialogue",
   "jp": "いや　なんでもねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x219d"
  },
  {
   "id": "ED_003001:0x8df0",
   "off": 36336,
   "max": 116,
   "kind": "dialogue",
   "jp": "町をゆく人々に歓迎されて\\n手放しで喜ぶ龍馬と\\n今ひとつ顔色が優れない\\n高杉の顔を　桂は不安な\\n面持ちで見比べていた",
   "en": "",
   "op": "0x62",
   "msg": "0x219e"
  },
  {
   "id": "ED_003001:0x98c8",
   "off": 39112,
   "max": 40,
   "kind": "dialogue",
   "jp": "だからー！\\n何でそこでつっ走るんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x219f"
  },
  {
   "id": "ED_003001:0x9fac",
   "off": 40876,
   "max": 44,
   "kind": "dialogue",
   "jp": "いやあ　夢中になると\\nつい走ってしまうぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x21a0"
  },
  {
   "id": "ED_003001:0xa454",
   "off": 42068,
   "max": 44,
   "kind": "dialogue",
   "jp": "バカか\\n少しは落ち着いて\\n周りの音を聴け！",
   "en": "",
   "op": "0x62",
   "msg": "0x21a1"
  },
  {
   "id": "ED_003001:0xac08",
   "off": 44040,
   "max": 48,
   "kind": "dialogue",
   "jp": "晋作は　龍馬くんに\\n合わせる気は\\nないんですか",
   "en": "",
   "op": "0x62",
   "msg": "0x21a2"
  },
  {
   "id": "ED_003001:0xb27c",
   "off": 45692,
   "max": 60,
   "kind": "dialogue",
   "jp": "あのなあ　桂さん\\n龍馬がオレ様に合わせる\\n気がねえんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x21a3"
  },
  {
   "id": "ED_003001:0xbbac",
   "off": 48044,
   "max": 60,
   "kind": "dialogue",
   "jp": "晋作なら龍馬くんに\\n合わせることが出来ると\\n思いますよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x21a4"
  },
  {
   "id": "ED_003001:0xc44c",
   "off": 50252,
   "max": 64,
   "kind": "dialogue",
   "jp": "オレ様の技術なら\\n合わせることは出来る\\nただ合わせるだけならな",
   "en": "",
   "op": "0x62",
   "msg": "0x21a5"
  },
  {
   "id": "ED_003001:0xc9a4",
   "off": 51620,
   "max": 20,
   "kind": "dialogue",
   "jp": "不本意なんですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x21a6"
  },
  {
   "id": "ED_003001:0xd2ac",
   "off": 53932,
   "max": 60,
   "kind": "dialogue",
   "jp": "オレ様は龍馬に合わせる\\nことがロックだとは\\n思わないんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x21a7"
  },
  {
   "id": "ED_003001:0xd2f8",
   "off": 54008,
   "max": 72,
   "kind": "dialogue",
   "jp": "それに桂さんに合わせる\\nことだって　オレ様は\\nロックと思っちゃいねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x21a8"
  },
  {
   "id": "ED_003001:0xdbbc",
   "off": 56252,
   "max": 48,
   "kind": "dialogue",
   "jp": "私もですか？\\n晋作はご機嫌斜め\\nなんですねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x21a9"
  },
  {
   "id": "ED_003001:0xe7dc",
   "off": 59356,
   "max": 44,
   "kind": "dialogue",
   "jp": "そんなんじゃねぇ！\\nだいたい桂さんは……",
   "en": "",
   "op": "0x62",
   "msg": "0x21aa"
  },
  {
   "id": "ED_003001:0xf0e8",
   "off": 61672,
   "max": 36,
   "kind": "dialogue",
   "jp": "わわっ　ケンカは\\nよくないぜよー",
   "en": "",
   "op": "0x62",
   "msg": "0x21ab"
  },
  {
   "id": "ED_003001:0xf8f0",
   "off": 63728,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬くん\\nケンカじゃないから\\n気にしないで下さい",
   "en": "",
   "op": "0x62",
   "msg": "0x21ac"
  },
  {
   "id": "ED_003001:0xfda0",
   "off": 64928,
   "max": 56,
   "kind": "dialogue",
   "jp": "いや　しかし\\n言い争いしていると\\n気が気じゃないぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x21ad"
  },
  {
   "id": "ED_003001:0x10560",
   "off": 66912,
   "max": 68,
   "kind": "dialogue",
   "jp": "優しいですね　龍馬くん\\nでも　これは私と晋作の\\n問題のようですから",
   "en": "",
   "op": "0x62",
   "msg": "0x21ae"
  },
  {
   "id": "ED_003001:0x107bc",
   "off": 67516,
   "max": 48,
   "kind": "dialogue",
   "jp": "ここは　二人だけで話を\\nさせてもらえませんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x21af"
  },
  {
   "id": "ED_003001:0x10f08",
   "off": 69384,
   "max": 60,
   "kind": "dialogue",
   "jp": "わかったぜよ\\nセンセーがそう言うなら\\nでもケンカはダメぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x21b0"
  },
  {
   "id": "ED_003001:0x113d4",
   "off": 70612,
   "max": 56,
   "kind": "dialogue",
   "jp": "龍馬は桂と高杉の\\n肩を軽く叩くと\\n部屋から出て行った",
   "en": "",
   "op": "0x62",
   "msg": "0x21b1"
  },
  {
   "id": "ED_003001:0x119d0",
   "off": 72144,
   "max": 60,
   "kind": "dialogue",
   "jp": "晋作は　私や龍馬くんに\\n合わせるのは\\n嫌だと言うのですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x21b2"
  },
  {
   "id": "ED_003001:0x12270",
   "off": 74352,
   "max": 64,
   "kind": "dialogue",
   "jp": "嫌だとは言ってねえ\\nただ　ずっとこのままで\\nいいのか　桂さん？",
   "en": "",
   "op": "0x62",
   "msg": "0x21b3"
  },
  {
   "id": "ED_003001:0x127c8",
   "off": 75720,
   "max": 20,
   "kind": "dialogue",
   "jp": "どういうことかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x21b4"
  },
  {
   "id": "ED_003001:0x12f64",
   "off": 77668,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬と組んで雷舞をやって\\n俺達の人気はうなぎ登りだ",
   "en": "",
   "op": "0x62",
   "msg": "0x21b5"
  },
  {
   "id": "ED_003001:0x12fa8",
   "off": 77736,
   "max": 48,
   "kind": "dialogue",
   "jp": "それに京では新選組と\\n人気を二分したって噂だ",
   "en": "",
   "op": "0x62",
   "msg": "0x21b6"
  },
  {
   "id": "ED_003001:0x13674",
   "off": 79476,
   "max": 48,
   "kind": "dialogue",
   "jp": "江戸での人気は新選組以上\\nだとも聞いていますね",
   "en": "",
   "op": "0x62",
   "msg": "0x21b7"
  },
  {
   "id": "ED_003001:0x13ce8",
   "off": 81128,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレ様は　その人気が\\nつまらねえんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x21b8"
  },
  {
   "id": "ED_003001:0x14228",
   "off": 82472,
   "max": 24,
   "kind": "dialogue",
   "jp": "人気が出ているのに？",
   "en": "",
   "op": "0x62",
   "msg": "0x21b9"
  },
  {
   "id": "ED_003001:0x14b34",
   "off": 84788,
   "max": 68,
   "kind": "dialogue",
   "jp": "なぜだろうな　桂さん\\nオレ様が求めているもの\\nとは　何かが違うんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x21ba"
  },
  {
   "id": "ED_003001:0x14c24",
   "off": 85028,
   "max": 44,
   "kind": "dialogue",
   "jp": "オレ様はもっとこう……\\nもっと……なにか",
   "en": "",
   "op": "0x62",
   "msg": "0x21bb"
  },
  {
   "id": "ED_003001:0x154b4",
   "off": 87220,
   "max": 72,
   "kind": "dialogue",
   "jp": "晋作の贔屓だという若者が\\n寺子屋で組（バンド）を\\n作った話を聞いても？",
   "en": "",
   "op": "0x62",
   "msg": "0x21bc"
  },
  {
   "id": "ED_003001:0x15a14",
   "off": 88596,
   "max": 68,
   "kind": "dialogue",
   "jp": "そりゃ　いやな気分じゃ\\nねえけど　でも\\nオレ様には実感がねえんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x21bd"
  },
  {
   "id": "ED_003001:0x1634c",
   "off": 90956,
   "max": 40,
   "kind": "dialogue",
   "jp": "桂さんは今の状況に\\n満足してるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x21be"
  },
  {
   "id": "ED_003001:0x16bd8",
   "off": 93144,
   "max": 60,
   "kind": "dialogue",
   "jp": "正直に告白すると\\n人気のおかげで顔が\\nバレてしまっていて",
   "en": "",
   "op": "0x62",
   "msg": "0x21bf"
  },
  {
   "id": "ED_003001:0x16c24",
   "off": 93220,
   "max": 72,
   "kind": "dialogue",
   "jp": "発明の材料集め中に\\n人が寄ってきてしまって\\n拾うことができないんです",
   "en": "",
   "op": "0x62",
   "msg": "0x21c0"
  },
  {
   "id": "ED_003001:0x172c4",
   "off": 94916,
   "max": 36,
   "kind": "dialogue",
   "jp": "……ゴミ拾いは\\nやめてもいいと思う",
   "en": "",
   "op": "0x62",
   "msg": "0x21c1"
  },
  {
   "id": "ED_003001:0x179b4",
   "off": 96692,
   "max": 24,
   "kind": "dialogue",
   "jp": "ゴミじゃなく宝です！",
   "en": "",
   "op": "0x62",
   "msg": "0x21c2"
  },
  {
   "id": "ED_003001:0x17aec",
   "off": 97004,
   "max": 44,
   "kind": "dialogue",
   "jp": "ま　そういう点では\\nちょっぴり窮屈ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x21c3"
  },
  {
   "id": "ED_003001:0x17b28",
   "off": 97064,
   "max": 36,
   "kind": "dialogue",
   "jp": "晋作も窮屈だと\\n思っているのかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x21c4"
  },
  {
   "id": "ED_003001:0x18064",
   "off": 98404,
   "max": 24,
   "kind": "dialogue",
   "jp": "窮屈ってよりつまらねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x21c5"
  },
  {
   "id": "ED_003001:0x18140",
   "off": 98624,
   "max": 56,
   "kind": "dialogue",
   "jp": "でも……\\nなんでつまらないのか\\n自分でもわからねえんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x21c6"
  },
  {
   "id": "ED_003001:0x18a6c",
   "off": 100972,
   "max": 68,
   "kind": "dialogue",
   "jp": "龍馬くんと三人で始めた\\n時は　大変だったけれど\\n楽しかったですね",
   "en": "",
   "op": "0x62",
   "msg": "0x21c7"
  },
  {
   "id": "ED_003001:0x1914c",
   "off": 102732,
   "max": 64,
   "kind": "dialogue",
   "jp": "ああ　命懸けのことも\\nあったが　だからこそ\\nやり甲斐もあったな",
   "en": "",
   "op": "0x62",
   "msg": "0x21c8"
  },
  {
   "id": "ED_003001:0x197d0",
   "off": 104400,
   "max": 48,
   "kind": "dialogue",
   "jp": "障害が多かったからこそ\\nやり甲斐もありましたね",
   "en": "",
   "op": "0x62",
   "msg": "0x21c9"
  },
  {
   "id": "ED_003001:0x19c7c",
   "off": 105596,
   "max": 68,
   "kind": "dialogue",
   "jp": "ああ　やり遂げた時の\\n達成感はハンパないし\\n今でも忘れちゃいねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x21ca"
  },
  {
   "id": "ED_003001:0x1a540",
   "off": 107840,
   "max": 20,
   "kind": "dialogue",
   "jp": "忘れられないですか",
   "en": "",
   "op": "0x62",
   "msg": "0x21cb"
  },
  {
   "id": "ED_003001:0x1abf0",
   "off": 109552,
   "max": 28,
   "kind": "dialogue",
   "jp": "当たり前だ\\n忘れるもんかよ",
   "en": "",
   "op": "0x62",
   "msg": "0x21cc"
  },
  {
   "id": "ED_003001:0x1b2a8",
   "off": 111272,
   "max": 48,
   "kind": "dialogue",
   "jp": "ふふ　晋作　ロックと\\n恋はちょっと似てますね",
   "en": "",
   "op": "0x62",
   "msg": "0x21cd"
  },
  {
   "id": "ED_003001:0x1bac0",
   "off": 113344,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんだよ　桂さん\\n藪から棒に",
   "en": "",
   "op": "0x62",
   "msg": "0x21ce"
  },
  {
   "id": "ED_003001:0x1bf5c",
   "off": 114524,
   "max": 48,
   "kind": "dialogue",
   "jp": "恋をした時の気持ちって\\n忘れられないでしょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x21cf"
  },
  {
   "id": "ED_003001:0x1c4a4",
   "off": 115876,
   "max": 32,
   "kind": "dialogue",
   "jp": "まあ……な\\nたぶん　そうだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x21d0"
  },
  {
   "id": "ED_003001:0x1c9dc",
   "off": 117212,
   "max": 64,
   "kind": "dialogue",
   "jp": "それに障害が多いほど\\n燃えるところも\\n恋とロックは似ています",
   "en": "",
   "op": "0x62",
   "msg": "0x21d1"
  },
  {
   "id": "ED_003001:0x1d520",
   "off": 120096,
   "max": 16,
   "kind": "dialogue",
   "jp": "……そうか！",
   "en": "",
   "op": "0x62",
   "msg": "0x21d2"
  },
  {
   "id": "ED_003001:0x1d548",
   "off": 120136,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレ様のロックに必要\\nなのはそれだったのか！",
   "en": "",
   "op": "0x62",
   "msg": "0x21d3"
  },
  {
   "id": "ED_003001:0x1dc98",
   "off": 122008,
   "max": 44,
   "kind": "dialogue",
   "jp": "うん？　つまらない\\n理由がわかりましたか？",
   "en": "",
   "op": "0x62",
   "msg": "0x21d4"
  },
  {
   "id": "ED_003001:0x1e360",
   "off": 123744,
   "max": 56,
   "kind": "dialogue",
   "jp": "ああ　桂さん\\nやっとわかったぜ\\nこれでスッキリしそうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x21d5"
  },
  {
   "id": "ED_003001:0x1e828",
   "off": 124968,
   "max": 88,
   "kind": "dialogue",
   "jp": "高杉はベースの弦を\\n調整（チューニング）しつつ\\n晴れ晴れとした表情を\\n浮かべたのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x21d6"
  },
  {
   "id": "ED_003001:0x1f19c",
   "off": 127388,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしらの歌を\\n最後まで聴いてくれて\\nありがとう！",
   "en": "",
   "op": "0x62",
   "msg": "0x21d7"
  },
  {
   "id": "ED_003001:0x1f944",
   "off": 129348,
   "max": 36,
   "kind": "dialogue",
   "jp": "きゃーっ！\\n龍馬さーん　ステキー！",
   "en": "",
   "op": "0x62",
   "msg": "0x21d8"
  },
  {
   "id": "ED_003001:0x20060",
   "off": 131168,
   "max": 52,
   "kind": "dialogue",
   "jp": "シンディ！　カッコイイ！\\n次も絶対来るからーっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x21d9"
  },
  {
   "id": "ED_003001:0x20734",
   "off": 132916,
   "max": 44,
   "kind": "dialogue",
   "jp": "ありがとうなーっ！\\n次の雷舞も頼むぜよーっ",
   "en": "",
   "op": "0x62",
   "msg": "0x21da"
  },
  {
   "id": "ED_003001:0x20bf0",
   "off": 134128,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬が観客の歓声に\\n応えた　その時――\\n高杉は言う",
   "en": "",
   "op": "0x62",
   "msg": "0x21db"
  },
  {
   "id": "ED_003001:0x21068",
   "off": 135272,
   "max": 24,
   "kind": "dialogue",
   "jp": "すまねえ\\n次はねえんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x21dc"
  },
  {
   "id": "ED_003001:0x21924",
   "off": 137508,
   "max": 36,
   "kind": "dialogue",
   "jp": "え？　ええっ？\\n次はないって……",
   "en": "",
   "op": "0x62",
   "msg": "0x21dd"
  },
  {
   "id": "ED_003001:0x222c0",
   "off": 139968,
   "max": 36,
   "kind": "dialogue",
   "jp": "オレ様は今日限りで\\n組から抜ける",
   "en": "",
   "op": "0x62",
   "msg": "0x21de"
  },
  {
   "id": "ED_003001:0x22d94",
   "off": 142740,
   "max": 44,
   "kind": "dialogue",
   "jp": "えええっ\\nシンディ　抜けるって\\nなんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x21df"
  },
  {
   "id": "ED_003001:0x23588",
   "off": 144776,
   "max": 60,
   "kind": "dialogue",
   "jp": "まさか　こんなに早く\\n言い出すとは\\n思いませんでしたね……",
   "en": "",
   "op": "0x62",
   "msg": "0x21e0"
  },
  {
   "id": "ED_003001:0x23a54",
   "off": 146004,
   "max": 68,
   "kind": "dialogue",
   "jp": "高杉が抜けると聞いて\\n騒然とする観客に向かって\\n高杉は語りかける",
   "en": "",
   "op": "0x62",
   "msg": "0x21e1"
  },
  {
   "id": "ED_003001:0x23edc",
   "off": 147164,
   "max": 60,
   "kind": "dialogue",
   "jp": "オレ様は龍馬や桂さんと\\n組んで今日までロックを\\nやって来た",
   "en": "",
   "op": "0x62",
   "msg": "0x21e2"
  },
  {
   "id": "ED_003001:0x23f28",
   "off": 147240,
   "max": 56,
   "kind": "dialogue",
   "jp": "命懸けだったが\\n楽しかったって\\n桂さんとも話したんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x21e3"
  },
  {
   "id": "ED_003001:0x245a0",
   "off": 148896,
   "max": 48,
   "kind": "dialogue",
   "jp": "だったら\\nなぜ抜けるなんて\\n言い出すんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x21e4"
  },
  {
   "id": "ED_003001:0x24ae8",
   "off": 150248,
   "max": 64,
   "kind": "dialogue",
   "jp": "今のまま安穏と過ごすのは\\nオレ様の性にあって\\nねえんだよ　龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x21e5"
  },
  {
   "id": "ED_003001:0x25424",
   "off": 152612,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレ様はオレ様の\\nロックを\\n見つけてぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x21e6"
  },
  {
   "id": "ED_003001:0x25cac",
   "off": 154796,
   "max": 56,
   "kind": "dialogue",
   "jp": "寂しいこと言うなよ\\nシンディ\\nこれからも一緒にやろう",
   "en": "",
   "op": "0x62",
   "msg": "0x21e7"
  },
  {
   "id": "ED_003001:0x265d8",
   "off": 157144,
   "max": 64,
   "kind": "dialogue",
   "jp": "いや　オレ様は決めた！\\n新しい　オレ様のロックを\\n探しに行く",
   "en": "",
   "op": "0x62",
   "msg": "0x21e8"
  },
  {
   "id": "ED_003001:0x26d38",
   "off": 159032,
   "max": 20,
   "kind": "dialogue",
   "jp": "本気ですか　晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x21e9"
  },
  {
   "id": "ED_003001:0x27390",
   "off": 160656,
   "max": 24,
   "kind": "dialogue",
   "jp": "ああ　オレ様は本気だぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x21ea"
  },
  {
   "id": "ED_003001:0x27a40",
   "off": 162368,
   "max": 64,
   "kind": "dialogue",
   "jp": "考え直してくれんか\\nシンディ　わしらは\\n三人でひとつなんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x21eb"
  },
  {
   "id": "ED_003001:0x27efc",
   "off": 163580,
   "max": 20,
   "kind": "dialogue",
   "jp": "すまねえな　龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x21ec"
  },
  {
   "id": "ED_003001:0x2885c",
   "off": 165980,
   "max": 20,
   "kind": "dialogue",
   "jp": "そこをなんとか！",
   "en": "",
   "op": "0x62",
   "msg": "0x21ed"
  },
  {
   "id": "ED_003001:0x28f90",
   "off": 167824,
   "max": 40,
   "kind": "dialogue",
   "jp": "龍馬くん　止めても無駄\\nのようですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x21ee"
  },
  {
   "id": "ED_003001:0x29064",
   "off": 168036,
   "max": 52,
   "kind": "dialogue",
   "jp": "そこまで言うのなら\\n覚悟は出来ていますね\\n晋作？",
   "en": "",
   "op": "0x62",
   "msg": "0x21ef"
  },
  {
   "id": "ED_003001:0x296dc",
   "off": 169692,
   "max": 36,
   "kind": "dialogue",
   "jp": "当然だ　桂さん\\n男に二言はねえよ",
   "en": "",
   "op": "0x62",
   "msg": "0x21f0"
  },
  {
   "id": "ED_003001:0x29f08",
   "off": 171784,
   "max": 60,
   "kind": "dialogue",
   "jp": "次に会う時はお互いに\\n好敵手（ライバル）に\\nなりますよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x21f1"
  },
  {
   "id": "ED_003001:0x2a74c",
   "off": 173900,
   "max": 60,
   "kind": "dialogue",
   "jp": "願ってもねえことだ\\nそうならねえと\\n抜ける意味がねえからな",
   "en": "",
   "op": "0x62",
   "msg": "0x21f2"
  },
  {
   "id": "ED_003001:0x2b1d0",
   "off": 176592,
   "max": 56,
   "kind": "dialogue",
   "jp": "上等です　晋作\\n龍馬くん　私達の組は\\n解散しましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x21f3"
  },
  {
   "id": "ED_003001:0x2bac0",
   "off": 178880,
   "max": 56,
   "kind": "dialogue",
   "jp": "えええええっ\\nセンセーまで　何を\\n言い出すぜよ～～！",
   "en": "",
   "op": "0x62",
   "msg": "0x21f4"
  },
  {
   "id": "ED_003001:0x2c1b8",
   "off": 180664,
   "max": 40,
   "kind": "dialogue",
   "jp": "解散か……さんざん　\\n言ってきたけどな",
   "en": "",
   "op": "0x62",
   "msg": "0x21f5"
  },
  {
   "id": "ED_003001:0x2c65c",
   "off": 181852,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうじゃ！　シンディは\\n一日三回は解散だと\\n言うとったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x21f6"
  },
  {
   "id": "ED_003001:0x2c740",
   "off": 182080,
   "max": 24,
   "kind": "dialogue",
   "jp": "だから　今度だって……",
   "en": "",
   "op": "0x62",
   "msg": "0x21f7"
  },
  {
   "id": "ED_003001:0x2d1c4",
   "off": 184772,
   "max": 48,
   "kind": "dialogue",
   "jp": "今度こそ本当に解散だ\\n理由は音楽性の違いだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x21f8"
  },
  {
   "id": "ED_003001:0x2dadc",
   "off": 187100,
   "max": 16,
   "kind": "dialogue",
   "jp": "シンディ……",
   "en": "",
   "op": "0x62",
   "msg": "0x21f9"
  },
  {
   "id": "ED_003001:0x2e004",
   "off": 188420,
   "max": 36,
   "kind": "dialogue",
   "jp": "そんな泣きそうな顔を\\nするな　龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x21fa"
  },
  {
   "id": "ED_003001:0x2e0d4",
   "off": 188628,
   "max": 52,
   "kind": "dialogue",
   "jp": "お前はもう　\\n一人（ソロ）で十分\\nやっていける！",
   "en": "",
   "op": "0x62",
   "msg": "0x21fb"
  },
  {
   "id": "ED_003001:0x2e7a4",
   "off": 190372,
   "max": 72,
   "kind": "dialogue",
   "jp": "そうですよ　龍馬くん\\nそれに　解散を言い出した\\nのは　晋作でなく私です",
   "en": "",
   "op": "0x62",
   "msg": "0x21fc"
  },
  {
   "id": "ED_003001:0x2ec68",
   "off": 191592,
   "max": 40,
   "kind": "dialogue",
   "jp": "センセー……\\nじゃ　ホントに解散か？",
   "en": "",
   "op": "0x62",
   "msg": "0x21fd"
  },
  {
   "id": "ED_003001:0x2f10c",
   "off": 192780,
   "max": 64,
   "kind": "dialogue",
   "jp": "はい　私達はそれぞれの\\nロックを　これから\\n目指しましょうね",
   "en": "",
   "op": "0x62",
   "msg": "0x21fe"
  },
  {
   "id": "ED_003001:0x2f660",
   "off": 194144,
   "max": 32,
   "kind": "dialogue",
   "jp": "センセー……\\n止めても無駄か？",
   "en": "",
   "op": "0x62",
   "msg": "0x21ff"
  },
  {
   "id": "ED_003001:0x2fb98",
   "off": 195480,
   "max": 32,
   "kind": "dialogue",
   "jp": "わがままでごめんね\\n龍馬くん",
   "en": "",
   "op": "0x62",
   "msg": "0x2200"
  },
  {
   "id": "ED_003001:0x300cc",
   "off": 196812,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや　わがままとは\\n思ってないんじゃ\\nセンセー",
   "en": "",
   "op": "0x62",
   "msg": "0x2201"
  },
  {
   "id": "ED_003001:0x30a48",
   "off": 199240,
   "max": 40,
   "kind": "dialogue",
   "jp": "でも　わしは寂しいぜよ\\nうおおおーっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2202"
  },
  {
   "id": "ED_003001:0x30f8c",
   "off": 200588,
   "max": 88,
   "kind": "dialogue",
   "jp": "観客の上げる悲鳴の中\\n高杉と桂は　観客達に\\n眩しい笑顔で一礼して\\n舞台を降りたのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x2203"
  },
  {
   "id": "ED_003001:0x30ff4",
   "off": 200692,
   "max": 64,
   "kind": "dialogue",
   "jp": "そして　龍馬も　寂しげに\\n振り返りながら　舞台を　\\n去った……",
   "en": "",
   "op": "0x62",
   "msg": "0x2204"
  },
  {
   "id": "ED_003001:0x31044",
   "off": 200772,
   "max": 64,
   "kind": "dialogue",
   "jp": "徳川の泰平化を阻止した\\n伝説の組はこうして\\n解散したのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x2205"
  },
  {
   "id": "ED_003001:0x31988",
   "off": 203144,
   "max": 32,
   "kind": "dialogue",
   "jp": "おー　いたいた！\\nシンディ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2206"
  },
  {
   "id": "ED_003001:0x31e80",
   "off": 204416,
   "max": 8,
   "kind": "dialogue",
   "jp": "晋作！",
   "en": "",
   "op": "0x62",
   "msg": "0x2207"
  },
  {
   "id": "ED_003001:0x3295c",
   "off": 207196,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍馬　桂さん！\\nなんでいるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2208"
  },
  {
   "id": "ED_003001:0x33280",
   "off": 209536,
   "max": 36,
   "kind": "dialogue",
   "jp": "センセーが教えて\\nくれたんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2209"
  },
  {
   "id": "ED_003001:0x33720",
   "off": 210720,
   "max": 12,
   "kind": "dialogue",
   "jp": "桂さん？",
   "en": "",
   "op": "0x62",
   "msg": "0x220a"
  },
  {
   "id": "ED_003001:0x33dc8",
   "off": 212424,
   "max": 64,
   "kind": "dialogue",
   "jp": "晋作がどうするかなんて\\n幼馴染みの私には\\nお見通しですよ　ふふ",
   "en": "",
   "op": "0x62",
   "msg": "0x220b"
  },
  {
   "id": "ED_003001:0x34320",
   "off": 213792,
   "max": 16,
   "kind": "dialogue",
   "jp": "……そうかよ",
   "en": "",
   "op": "0x62",
   "msg": "0x220c"
  },
  {
   "id": "ED_003001:0x349c8",
   "off": 215496,
   "max": 44,
   "kind": "dialogue",
   "jp": "本当にもう\\n行ってしまうんじゃな\\nシンディ",
   "en": "",
   "op": "0x62",
   "msg": "0x220d"
  },
  {
   "id": "ED_003001:0x34f68",
   "off": 216936,
   "max": 20,
   "kind": "dialogue",
   "jp": "止めても無駄だぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x220e"
  },
  {
   "id": "ED_003001:0x35620",
   "off": 218656,
   "max": 52,
   "kind": "dialogue",
   "jp": "ええ　知っています\\n晋作は松陰先生の後を\\n継いで",
   "en": "",
   "op": "0x62",
   "msg": "0x220f"
  },
  {
   "id": "ED_003001:0x35700",
   "off": 218880,
   "max": 52,
   "kind": "dialogue",
   "jp": "未開の地にロックを\\n伝えていくつもり\\nなのでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2210"
  },
  {
   "id": "ED_003001:0x35e74",
   "off": 220788,
   "max": 28,
   "kind": "dialogue",
   "jp": "ええっ\\nな　なんで……",
   "en": "",
   "op": "0x62",
   "msg": "0x2211"
  },
  {
   "id": "ED_003001:0x36314",
   "off": 221972,
   "max": 44,
   "kind": "dialogue",
   "jp": "だから　幼馴染みを\\n舐めたらいけませんよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2212"
  },
  {
   "id": "ED_003001:0x363ec",
   "off": 222188,
   "max": 40,
   "kind": "dialogue",
   "jp": "晋作は人気に満足する\\nのが嫌だった……",
   "en": "",
   "op": "0x62",
   "msg": "0x2213"
  },
  {
   "id": "ED_003001:0x364c0",
   "off": 222400,
   "max": 60,
   "kind": "dialogue",
   "jp": "都で安穏とロックを\\nするのは　性に合わない\\nのですよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x2214"
  },
  {
   "id": "ED_003001:0x365a8",
   "off": 222632,
   "max": 56,
   "kind": "dialogue",
   "jp": "障害もなくつまらない\\nそんなのは　ロック\\nじゃない……",
   "en": "",
   "op": "0x62",
   "msg": "0x2215"
  },
  {
   "id": "ED_003001:0x36ab8",
   "off": 223928,
   "max": 56,
   "kind": "dialogue",
   "jp": "いやっ　オレ様は\\nオレ様のロックを\\n探しに行くんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2216"
  },
  {
   "id": "ED_003001:0x36f74",
   "off": 225140,
   "max": 32,
   "kind": "dialogue",
   "jp": "はいはい　\\n好きに言ってなさい",
   "en": "",
   "op": "0x62",
   "msg": "0x2217"
  },
  {
   "id": "ED_003001:0x3762c",
   "off": 226860,
   "max": 36,
   "kind": "dialogue",
   "jp": "シンディは素直じゃ\\nないからなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2218"
  },
  {
   "id": "ED_003001:0x37cfc",
   "off": 228604,
   "max": 32,
   "kind": "dialogue",
   "jp": "うっ　うるさいっ！\\n黙れバカ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2219"
  },
  {
   "id": "ED_003001:0x384d0",
   "off": 230608,
   "max": 60,
   "kind": "dialogue",
   "jp": "私も松陰先生の弟子です\\nだから　旅に出ることに\\nしました",
   "en": "",
   "op": "0x62",
   "msg": "0x221a"
  },
  {
   "id": "ED_003001:0x385b8",
   "off": 230840,
   "max": 20,
   "kind": "dialogue",
   "jp": "晋作と同じようにね",
   "en": "",
   "op": "0x62",
   "msg": "0x221b"
  },
  {
   "id": "ED_003001:0x38ae4",
   "off": 232164,
   "max": 8,
   "kind": "dialogue",
   "jp": "桂さん",
   "en": "",
   "op": "0x62",
   "msg": "0x221c"
  },
  {
   "id": "ED_003001:0x39270",
   "off": 234096,
   "max": 48,
   "kind": "dialogue",
   "jp": "センセーも旅立つのか……\\nわしも行こうかのう",
   "en": "",
   "op": "0x62",
   "msg": "0x221d"
  },
  {
   "id": "ED_003001:0x39a80",
   "off": 236160,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍馬くんには　龍馬くんの\\n使命があるでしょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x221e"
  },
  {
   "id": "ED_003001:0x39ac0",
   "off": 236224,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬くんは　都でロックを\\n広めてください",
   "en": "",
   "op": "0x62",
   "msg": "0x221f"
  },
  {
   "id": "ED_003001:0x39f68",
   "off": 237416,
   "max": 40,
   "kind": "dialogue",
   "jp": "龍馬まで旅立ったら\\n贔屓が気の毒だろが",
   "en": "",
   "op": "0x62",
   "msg": "0x2220"
  },
  {
   "id": "ED_003001:0x3a714",
   "off": 239380,
   "max": 32,
   "kind": "dialogue",
   "jp": "……わし一人は\\n寂しいぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2221"
  },
  {
   "id": "ED_003001:0x3af14",
   "off": 241428,
   "max": 24,
   "kind": "dialogue",
   "jp": "一人じゃないでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2222"
  },
  {
   "id": "ED_003001:0x3b3a8",
   "off": 242600,
   "max": 20,
   "kind": "dialogue",
   "jp": "お迎えが来てるぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x2223"
  },
  {
   "id": "ED_003001:0x3bb48",
   "off": 244552,
   "max": 12,
   "kind": "dialogue",
   "jp": "お迎え？",
   "en": "",
   "op": "0x62",
   "msg": "0x2224"
  },
  {
   "id": "ED_003001:0x3c3a0",
   "off": 246688,
   "max": 36,
   "kind": "dialogue",
   "jp": "迎えではなく　見送りだ\\n高杉のな",
   "en": "",
   "op": "0x62",
   "msg": "0x2225"
  },
  {
   "id": "ED_003001:0x3c840",
   "off": 247872,
   "max": 40,
   "kind": "dialogue",
   "jp": "そうそう　スカシくんの\\n見送りだよー",
   "en": "",
   "op": "0x62",
   "msg": "0x2226"
  },
  {
   "id": "ED_003001:0x3c910",
   "off": 248080,
   "max": 44,
   "kind": "dialogue",
   "jp": "一度は組んだ相手だし\\n見送りくらいはね～",
   "en": "",
   "op": "0x62",
   "msg": "0x2227"
  },
  {
   "id": "ED_003001:0x3c94c",
   "off": 248140,
   "max": 52,
   "kind": "dialogue",
   "jp": "それと\\n新選組と合同雷舞が\\nあるのに　トサカくんが",
   "en": "",
   "op": "0x62",
   "msg": "0x2228"
  },
  {
   "id": "ED_003001:0x3ca28",
   "off": 248360,
   "max": 52,
   "kind": "dialogue",
   "jp": "うっかり船に\\n乗ったりしないように\\n見張りかなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2229"
  },
  {
   "id": "ED_003001:0x3d2ac",
   "off": 250540,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ギクッ",
   "en": "",
   "op": "0x62",
   "msg": "0x222a"
  },
  {
   "id": "ED_003001:0x3d900",
   "off": 252160,
   "max": 32,
   "kind": "dialogue",
   "jp": "あ　トサカくん\\nぎくってした！",
   "en": "",
   "op": "0x62",
   "msg": "0x222b"
  },
  {
   "id": "ED_003001:0x3dda4",
   "off": 253348,
   "max": 16,
   "kind": "dialogue",
   "jp": "あ……わははは",
   "en": "",
   "op": "0x62",
   "msg": "0x222c"
  },
  {
   "id": "ED_003001:0x3e450",
   "off": 255056,
   "max": 32,
   "kind": "dialogue",
   "jp": "坂本　無責任な真似は\\n許さんぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x222d"
  },
  {
   "id": "ED_003001:0x3eb0c",
   "off": 256780,
   "max": 20,
   "kind": "dialogue",
   "jp": "させませんよ　私が",
   "en": "",
   "op": "0x62",
   "msg": "0x222e"
  },
  {
   "id": "ED_003001:0x3f3ec",
   "off": 259052,
   "max": 36,
   "kind": "dialogue",
   "jp": "晋作　元気で\\n頑張ってくださいね",
   "en": "",
   "op": "0x62",
   "msg": "0x222f"
  },
  {
   "id": "ED_003001:0x3f420",
   "off": 259104,
   "max": 56,
   "kind": "dialogue",
   "jp": "私もすぐ旅立ちます\\nどこかで　会うかも\\nしれませんね",
   "en": "",
   "op": "0x62",
   "msg": "0x2230"
  },
  {
   "id": "ED_003001:0x3f8d4",
   "off": 260308,
   "max": 40,
   "kind": "dialogue",
   "jp": "お　おお\\n桂さんもそれまで\\n元気で……",
   "en": "",
   "op": "0x62",
   "msg": "0x2231"
  },
  {
   "id": "ED_003001:0x3fee8",
   "off": 261864,
   "max": 28,
   "kind": "dialogue",
   "jp": "龍馬も……\\n土方と沖田もな",
   "en": "",
   "op": "0x62",
   "msg": "0x2232"
  },
  {
   "id": "ED_003001:0x3ffb0",
   "off": 262064,
   "max": 44,
   "kind": "dialogue",
   "jp": "あんた達とやれた\\nロックは\\n最高だったよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2233"
  },
  {
   "id": "ED_003001:0x40788",
   "off": 264072,
   "max": 48,
   "kind": "dialogue",
   "jp": "わぁ　スカシくんが\\n素直なんて\\n気持ち悪～！",
   "en": "",
   "op": "0x62",
   "msg": "0x2234"
  },
  {
   "id": "ED_003001:0x41150",
   "off": 266576,
   "max": 48,
   "kind": "dialogue",
   "jp": "なんだとっ！\\nオレ様だって\\n最後くらいは……",
   "en": "",
   "op": "0x62",
   "msg": "0x2235"
  },
  {
   "id": "ED_003001:0x41898",
   "off": 268440,
   "max": 32,
   "kind": "dialogue",
   "jp": "お前のベースも\\n最高だったぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x2236"
  },
  {
   "id": "ED_003001:0x420b8",
   "off": 270520,
   "max": 16,
   "kind": "dialogue",
   "jp": "土方さんまで！",
   "en": "",
   "op": "0x62",
   "msg": "0x2237"
  },
  {
   "id": "ED_003001:0x42a98",
   "off": 273048,
   "max": 68,
   "kind": "dialogue",
   "jp": "うぉぉぉぉぉぉんっ！\\nシンディもヒジゾーさんも\\n泣かすな～～～っ",
   "en": "",
   "op": "0x62",
   "msg": "0x2238"
  },
  {
   "id": "ED_003001:0x42af4",
   "off": 273140,
   "max": 64,
   "kind": "dialogue",
   "jp": "元気でな　シンディ！\\nまた一緒に最高の\\nロックをするぜよ～～！",
   "en": "",
   "op": "0x62",
   "msg": "0x2239"
  },
  {
   "id": "ED_003001:0x431cc",
   "off": 274892,
   "max": 56,
   "kind": "dialogue",
   "jp": "スカシくん　またね！\\n僕がすっごい歌を\\n聴かせるから",
   "en": "",
   "op": "0x62",
   "msg": "0x223a"
  },
  {
   "id": "ED_003001:0x43214",
   "off": 274964,
   "max": 32,
   "kind": "dialogue",
   "jp": "勝手に死んだり\\nしないでね～",
   "en": "",
   "op": "0x62",
   "msg": "0x223b"
  },
  {
   "id": "ED_003001:0x43924",
   "off": 276772,
   "max": 36,
   "kind": "dialogue",
   "jp": "不吉なことを言うな！\\nあばよっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x223c"
  },
  {
   "id": "ED_003001:0x43fe4",
   "off": 278500,
   "max": 36,
   "kind": "dialogue",
   "jp": "晋作　どこかで\\nまた会いましょう！",
   "en": "",
   "op": "0x62",
   "msg": "0x223d"
  },
  {
   "id": "ED_003001:0x44524",
   "off": 279844,
   "max": 76,
   "kind": "dialogue",
   "jp": "そうして高杉は\\n旅立って行った\\nそれからまもなくして\\n桂も旅に出たのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x223e"
  },
  {
   "id": "ED_003001:0x44580",
   "off": 279936,
   "max": 36,
   "kind": "dialogue",
   "jp": "それから　\\nしばらくの時間が過ぎた",
   "en": "",
   "op": "0x62",
   "msg": "0x223f"
  },
  {
   "id": "ED_003001:0x44ec4",
   "off": 282308,
   "max": 40,
   "kind": "dialogue",
   "jp": "で　何で　ここに\\n桂さんがいるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2240"
  },
  {
   "id": "ED_003001:0x45590",
   "off": 284048,
   "max": 32,
   "kind": "dialogue",
   "jp": "おや　晋作\\n短い別れでしたねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2241"
  },
  {
   "id": "ED_003001:0x45ac4",
   "off": 285380,
   "max": 60,
   "kind": "dialogue",
   "jp": "とある田舎の街道で\\n高杉と桂はバッタリ\\n出会ってしまった",
   "en": "",
   "op": "0x62",
   "msg": "0x2242"
  },
  {
   "id": "ED_003001:0x46088",
   "off": 286856,
   "max": 52,
   "kind": "dialogue",
   "jp": "これも幼馴染みだからって\\n言うんじゃないだろうなっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2243"
  },
  {
   "id": "ED_003001:0x465d4",
   "off": 288212,
   "max": 48,
   "kind": "dialogue",
   "jp": "偶然に決まっているじゃ\\nないですか\\n嫌ですねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2244"
  },
  {
   "id": "ED_003001:0x46614",
   "off": 288276,
   "max": 52,
   "kind": "dialogue",
   "jp": "いくら幼馴染みだって\\n旅先で出会ったり\\nしませんよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2245"
  },
  {
   "id": "ED_003001:0x46b60",
   "off": 289632,
   "max": 16,
   "kind": "dialogue",
   "jp": "どうだか……",
   "en": "",
   "op": "0x62",
   "msg": "0x2246"
  },
  {
   "id": "ED_003001:0x47464",
   "off": 291940,
   "max": 40,
   "kind": "dialogue",
   "jp": "松陰先生のお導きかも\\nしれませんね……",
   "en": "",
   "op": "0x62",
   "msg": "0x2247"
  },
  {
   "id": "ED_003001:0x47b28",
   "off": 293672,
   "max": 16,
   "kind": "dialogue",
   "jp": "松陰先生の……",
   "en": "",
   "op": "0x62",
   "msg": "0x2248"
  },
  {
   "id": "ED_003001:0x4839c",
   "off": 295836,
   "max": 56,
   "kind": "dialogue",
   "jp": "互いに　松陰先生の\\n後を継ごうと\\n旅立ったのですからね",
   "en": "",
   "op": "0x62",
   "msg": "0x2249"
  },
  {
   "id": "ED_003001:0x48850",
   "off": 297040,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうかもしれねぇな",
   "en": "",
   "op": "0x62",
   "msg": "0x224a"
  },
  {
   "id": "ED_003001:0x48fec",
   "off": 298988,
   "max": 64,
   "kind": "dialogue",
   "jp": "では　松陰先生の\\nロックをこの日本中に\\n広めていきましょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x224b"
  },
  {
   "id": "ED_003001:0x490f0",
   "off": 299248,
   "max": 12,
   "kind": "dialogue",
   "jp": "二人で……",
   "en": "",
   "op": "0x62",
   "msg": "0x224c"
  },
  {
   "id": "ED_003001:0x49798",
   "off": 300952,
   "max": 56,
   "kind": "dialogue",
   "jp": "二人で　かぁ\\nま　出会っちまった\\nもんはしょうがねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x224d"
  },
  {
   "id": "ED_003001:0x49fb0",
   "off": 303024,
   "max": 48,
   "kind": "dialogue",
   "jp": "晋作のご飯が\\n恋しかったので\\n丁度いいですね～",
   "en": "",
   "op": "0x62",
   "msg": "0x224e"
  },
  {
   "id": "ED_003001:0x4a684",
   "off": 304772,
   "max": 20,
   "kind": "dialogue",
   "jp": "そういう理由かよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x224f"
  },
  {
   "id": "ED_003001:0x4b3bc",
   "off": 308156,
   "max": 28,
   "kind": "dialogue",
   "jp": "ふふっ　行きましょう\\n晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x2250"
  },
  {
   "id": "ED_003001:0x4b3e8",
   "off": 308200,
   "max": 60,
   "kind": "dialogue",
   "jp": "ロックを聴いたことがない\\n人たちがたくさん\\n待っていますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2251"
  },
  {
   "id": "ED_003001:0x4b8a0",
   "off": 309408,
   "max": 64,
   "kind": "dialogue",
   "jp": "おう　待ってやがれよ\\nオレ様がみんなに\\nロックを教えてやる！",
   "en": "",
   "op": "0x62",
   "msg": "0x2252"
  },
  {
   "id": "ED_003001:0x4bdf8",
   "off": 310776,
   "max": 16,
   "kind": "dialogue",
   "jp": "私達が　ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2253"
  },
  {
   "id": "ED_003001:0x4c38c",
   "off": 312204,
   "max": 32,
   "kind": "dialogue",
   "jp": "だな……\\nオレ様のベースと――",
   "en": "",
   "op": "0x62",
   "msg": "0x2254"
  },
  {
   "id": "ED_003001:0x4c8c4",
   "off": 313540,
   "max": 20,
   "kind": "dialogue",
   "jp": "私のドラムで――",
   "en": "",
   "op": "0x62",
   "msg": "0x2255"
  },
  {
   "id": "ED_003001:0x4cee8",
   "off": 315112,
   "max": 36,
   "kind": "dialogue",
   "jp": "最高のロックを\\n聴かせてやるぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2256"
  }
 ]
}
