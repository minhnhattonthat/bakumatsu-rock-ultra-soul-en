{
 "source": "ED_004001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "ED_004001:0x10e8",
   "off": 4328,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬達の奮闘により\\n徳川の怨霊が静まった後",
   "en": "",
   "op": "0x62",
   "msg": "0x20f8"
  },
  {
   "id": "ED_004001:0x1124",
   "off": 4388,
   "max": 36,
   "kind": "dialogue",
   "jp": "新選組の旗頭と\\nなった土方は……",
   "en": "",
   "op": "0x62",
   "msg": "0x20f9"
  },
  {
   "id": "ED_004001:0x1158",
   "off": 4440,
   "max": 64,
   "kind": "dialogue",
   "jp": "地に膝をつき　\\n荒い息を吐いてる\\n美男子の尻を\\n蹴り上げていた",
   "en": "",
   "op": "0x62",
   "msg": "0x20fa"
  },
  {
   "id": "ED_004001:0x1c38",
   "off": 7224,
   "max": 40,
   "kind": "dialogue",
   "jp": "あふ～ん　土方局長　\\nお許し下さい～",
   "en": "",
   "op": "0x62",
   "msg": "0x20fb"
  },
  {
   "id": "ED_004001:0x22f4",
   "off": 8948,
   "max": 52,
   "kind": "dialogue",
   "jp": "あふ～ん　\\n申し訳ありませんでしたっ\\n土方局長～",
   "en": "",
   "op": "0x62",
   "msg": "0x20fc"
  },
  {
   "id": "ED_004001:0x2c78",
   "off": 11384,
   "max": 64,
   "kind": "dialogue",
   "jp": "許してほしいなら\\nとっとと走り込みを続けろ\\n地面に寝そべるな",
   "en": "",
   "op": "0x62",
   "msg": "0x20fd"
  },
  {
   "id": "ED_004001:0x3788",
   "off": 14216,
   "max": 12,
   "kind": "dialogue",
   "jp": "あふ～～ん",
   "en": "",
   "op": "0x62",
   "msg": "0x20fe"
  },
  {
   "id": "ED_004001:0x3f28",
   "off": 16168,
   "max": 52,
   "kind": "dialogue",
   "jp": "……ったく\\n今年の新人は軟弱だな\\nすぐヘバりやがる",
   "en": "",
   "op": "0x62",
   "msg": "0x20ff"
  },
  {
   "id": "ED_004001:0x4008",
   "off": 16392,
   "max": 68,
   "kind": "dialogue",
   "jp": "新選組を結成した頃は\\nもっと気概のある奴が\\n集まっていたのに……",
   "en": "",
   "op": "0x62",
   "msg": "0x2100"
  },
  {
   "id": "ED_004001:0x46d8",
   "off": 18136,
   "max": 40,
   "kind": "dialogue",
   "jp": "なあ　そう思うだろ？\\n近藤さん　総司　",
   "en": "",
   "op": "0x62",
   "msg": "0x2101"
  },
  {
   "id": "ED_004001:0x4c14",
   "off": 19476,
   "max": 84,
   "kind": "dialogue",
   "jp": "口元を緩ませて振り返る土方\\nしかし誰もいない後ろを見て\\nバツが悪そうに舌打ちをした",
   "en": "",
   "op": "0x62",
   "msg": "0x2102"
  },
  {
   "id": "ED_004001:0x5220",
   "off": 21024,
   "max": 68,
   "kind": "dialogue",
   "jp": "何をしているんだ　俺は\\n近藤さんが死んだのは\\nだいぶ前の事だろう",
   "en": "",
   "op": "0x62",
   "msg": "0x2103"
  },
  {
   "id": "ED_004001:0x5274",
   "off": 21108,
   "max": 48,
   "kind": "dialogue",
   "jp": "新しい時代（うた）が　\\n始まろうとしてるのに",
   "en": "",
   "op": "0x62",
   "msg": "0x2104"
  },
  {
   "id": "ED_004001:0x52b4",
   "off": 21172,
   "max": 68,
   "kind": "dialogue",
   "jp": "こんな調子では\\n近藤さんに笑われてしまう\\nもっとしっかりしなくては",
   "en": "",
   "op": "0x62",
   "msg": "0x2105"
  },
  {
   "id": "ED_004001:0x5a20",
   "off": 23072,
   "max": 44,
   "kind": "dialogue",
   "jp": "……む？　そういえば\\n総司の姿が見えないな",
   "en": "",
   "op": "0x62",
   "msg": "0x2106"
  },
  {
   "id": "ED_004001:0x608c",
   "off": 24716,
   "max": 68,
   "kind": "dialogue",
   "jp": "土方局長　沖田組長なら　\\nついさっき屯所を\\n出て行かれましたよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2107"
  },
  {
   "id": "ED_004001:0x6a20",
   "off": 27168,
   "max": 52,
   "kind": "dialogue",
   "jp": "あいつ　\\nまた脱走したのか\\n全く何を考えてるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2108"
  },
  {
   "id": "ED_004001:0x6f70",
   "off": 28528,
   "max": 40,
   "kind": "dialogue",
   "jp": "青空を見上げて\\n土方は深いため息をつく",
   "en": "",
   "op": "0x62",
   "msg": "0x2109"
  },
  {
   "id": "ED_004001:0x6fa8",
   "off": 28584,
   "max": 68,
   "kind": "dialogue",
   "jp": "そして新人の稽古指導を\\n他の隊士に言い付けると\\n屯所から出て行った",
   "en": "",
   "op": "0x62",
   "msg": "0x210a"
  },
  {
   "id": "ED_004001:0x754c",
   "off": 30028,
   "max": 64,
   "kind": "dialogue",
   "jp": "その頃――\\n沖田は茶店の長椅子に座り\\n往来する人々を眺めていた",
   "en": "",
   "op": "0x62",
   "msg": "0x210b"
  },
  {
   "id": "ED_004001:0x7b0c",
   "off": 31500,
   "max": 48,
   "kind": "dialogue",
   "jp": "なあなあ　\\nそこの可愛いお嬢ちゃん\\nってばよう",
   "en": "",
   "op": "0x62",
   "msg": "0x210c"
  },
  {
   "id": "ED_004001:0x7fb8",
   "off": 32696,
   "max": 64,
   "kind": "dialogue",
   "jp": "こっち向いてくれよ\\nちょっとで良いからさあ\\n頼むよ　お嬢ちゃん",
   "en": "",
   "op": "0x62",
   "msg": "0x210d"
  },
  {
   "id": "ED_004001:0x877c",
   "off": 34684,
   "max": 72,
   "kind": "dialogue",
   "jp": "んー？　何　おじさん達\\n可愛いお嬢ちゃんって\\nもしかして　僕のこと？",
   "en": "",
   "op": "0x62",
   "msg": "0x210e"
  },
  {
   "id": "ED_004001:0x8e04",
   "off": 36356,
   "max": 60,
   "kind": "dialogue",
   "jp": "ああ　勿論だよ\\nお嬢ちゃんはとびきり\\n可愛いべっぴんさんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x210f"
  },
  {
   "id": "ED_004001:0x9354",
   "off": 37716,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふーん　ありがとう\\n一応感謝はしておくよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2110"
  },
  {
   "id": "ED_004001:0x9a18",
   "off": 39448,
   "max": 24,
   "kind": "dialogue",
   "jp": "お嬢ちゃん一人かい？",
   "en": "",
   "op": "0x62",
   "msg": "0x2111"
  },
  {
   "id": "ED_004001:0x9f44",
   "off": 40772,
   "max": 48,
   "kind": "dialogue",
   "jp": "うん　まあね\\nけどもうすぐしたら\\n連れが来るよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2112"
  },
  {
   "id": "ED_004001:0x9f84",
   "off": 40836,
   "max": 32,
   "kind": "dialogue",
   "jp": "ここで待ち合わせ\\nしてるから",
   "en": "",
   "op": "0x62",
   "msg": "0x2113"
  },
  {
   "id": "ED_004001:0xa63c",
   "off": 42556,
   "max": 68,
   "kind": "dialogue",
   "jp": "嘘つけ　さっきから\\nお嬢ちゃんを見ていたが\\n誰も来ないじゃないか",
   "en": "",
   "op": "0x62",
   "msg": "0x2114"
  },
  {
   "id": "ED_004001:0xad18",
   "off": 44312,
   "max": 60,
   "kind": "dialogue",
   "jp": "お嬢ちゃん\\n俺達と遊びに行こうぜ\\nきっと楽しいぞ？　なっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2115"
  },
  {
   "id": "ED_004001:0xb1d0",
   "off": 45520,
   "max": 24,
   "kind": "dialogue",
   "jp": "えー　気が乗らないなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2116"
  },
  {
   "id": "ED_004001:0xb290",
   "off": 45712,
   "max": 72,
   "kind": "dialogue",
   "jp": "もしも楽しくなかったら\\nおじさん達　ちゃあんと\\n責任取ってくれるの？",
   "en": "",
   "op": "0x62",
   "msg": "0x2117"
  },
  {
   "id": "ED_004001:0xb97c",
   "off": 47484,
   "max": 40,
   "kind": "dialogue",
   "jp": "ああ取る取る\\nだから一緒に行こうぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x2118"
  },
  {
   "id": "ED_004001:0xc03c",
   "off": 49212,
   "max": 52,
   "kind": "dialogue",
   "jp": "ほら　お嬢ちゃん\\n座ってないで\\nこっちに来いって",
   "en": "",
   "op": "0x62",
   "msg": "0x2119"
  },
  {
   "id": "ED_004001:0xc6d4",
   "off": 50900,
   "max": 52,
   "kind": "dialogue",
   "jp": "浪士達は\\n沖田の手首を掴み\\n強引に立ち上がらせる",
   "en": "",
   "op": "0x62",
   "msg": "0x211a"
  },
  {
   "id": "ED_004001:0xc718",
   "off": 50968,
   "max": 60,
   "kind": "dialogue",
   "jp": "その瞬間　\\n浪士達の後頭部めがけて\\n刀の柄が振り下ろされた",
   "en": "",
   "op": "0x62",
   "msg": "0x211b"
  },
  {
   "id": "ED_004001:0xcffc",
   "off": 53244,
   "max": 24,
   "kind": "dialogue",
   "jp": "いってえええええッッ",
   "en": "",
   "op": "0x62",
   "msg": "0x211c"
  },
  {
   "id": "ED_004001:0xd59c",
   "off": 54684,
   "max": 40,
   "kind": "dialogue",
   "jp": "鋭い一撃を受け\\n浪士達は咄嗟に振り返る",
   "en": "",
   "op": "0x62",
   "msg": "0x211d"
  },
  {
   "id": "ED_004001:0xd5d4",
   "off": 54740,
   "max": 48,
   "kind": "dialogue",
   "jp": "そこには\\n鬼の形相をした男が\\n無言で立っていた",
   "en": "",
   "op": "0x62",
   "msg": "0x211e"
  },
  {
   "id": "ED_004001:0xdbc4",
   "off": 56260,
   "max": 16,
   "kind": "dialogue",
   "jp": "………………",
   "en": "",
   "op": "0x62",
   "msg": "0x211f"
  },
  {
   "id": "ED_004001:0xdbe4",
   "off": 56292,
   "max": 56,
   "kind": "dialogue",
   "jp": "そいつに手を出すな\\n死にたくなかったら\\nとっとと消えろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2120"
  },
  {
   "id": "ED_004001:0xe528",
   "off": 58664,
   "max": 16,
   "kind": "dialogue",
   "jp": "ひいぃぃぃっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2121"
  },
  {
   "id": "ED_004001:0xebbc",
   "off": 60348,
   "max": 40,
   "kind": "dialogue",
   "jp": "わ　わかりましたっ\\nいますぐ消えます",
   "en": "",
   "op": "0x62",
   "msg": "0x2122"
  },
  {
   "id": "ED_004001:0xf068",
   "off": 61544,
   "max": 64,
   "kind": "dialogue",
   "jp": "クソッ　お嬢ちゃんに\\nこんな恐ろしい彼氏が\\nいたなんて……",
   "en": "",
   "op": "0x62",
   "msg": "0x2123"
  },
  {
   "id": "ED_004001:0xf834",
   "off": 63540,
   "max": 64,
   "kind": "dialogue",
   "jp": "だからさっき\\nそう言ったんだけどなぁ\\nま　いっか　ばいばーい",
   "en": "",
   "op": "0x62",
   "msg": "0x2124"
  },
  {
   "id": "ED_004001:0xfd04",
   "off": 64772,
   "max": 48,
   "kind": "dialogue",
   "jp": "浪士達は沖田に見送られ\\nそそくさと逃げ去った",
   "en": "",
   "op": "0x62",
   "msg": "0x2125"
  },
  {
   "id": "ED_004001:0x10178",
   "off": 65912,
   "max": 64,
   "kind": "dialogue",
   "jp": "お嬢ちゃんに彼氏？\\n……総司　お前また\\n女に間違われたのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2126"
  },
  {
   "id": "ED_004001:0x10800",
   "off": 67584,
   "max": 44,
   "kind": "dialogue",
   "jp": "あはっ　\\nさっすが土方さん\\n仰る通りです",
   "en": "",
   "op": "0x62",
   "msg": "0x2127"
  },
  {
   "id": "ED_004001:0x10980",
   "off": 67968,
   "max": 52,
   "kind": "dialogue",
   "jp": "否定するのも面倒だし\\n土方さんが来る頃だと\\n思って",
   "en": "",
   "op": "0x62",
   "msg": "0x2128"
  },
  {
   "id": "ED_004001:0x109c4",
   "off": 68036,
   "max": 32,
   "kind": "dialogue",
   "jp": "適当に話を\\n合わせてましたけど",
   "en": "",
   "op": "0x62",
   "msg": "0x2129"
  },
  {
   "id": "ED_004001:0x10f04",
   "off": 69380,
   "max": 32,
   "kind": "dialogue",
   "jp": "はぁぁ……\\nお前って奴は……",
   "en": "",
   "op": "0x62",
   "msg": "0x212a"
  },
  {
   "id": "ED_004001:0x11440",
   "off": 70720,
   "max": 72,
   "kind": "dialogue",
   "jp": "あはっ　土方さん　\\nため息が出る程　僕の事を\\n心配してくれてたんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x212b"
  },
  {
   "id": "ED_004001:0x11498",
   "off": 70808,
   "max": 40,
   "kind": "dialogue",
   "jp": "助けてくれて\\nありがとうございました♪",
   "en": "",
   "op": "0x62",
   "msg": "0x212c"
  },
  {
   "id": "ED_004001:0x11e10",
   "off": 73232,
   "max": 16,
   "kind": "dialogue",
   "jp": "この愚か者が",
   "en": "",
   "op": "0x62",
   "msg": "0x212d"
  },
  {
   "id": "ED_004001:0x12754",
   "off": 75604,
   "max": 40,
   "kind": "dialogue",
   "jp": "いったぁ～～\\n土方さん　何するの～！",
   "en": "",
   "op": "0x62",
   "msg": "0x212e"
  },
  {
   "id": "ED_004001:0x12dc8",
   "off": 77256,
   "max": 24,
   "kind": "dialogue",
   "jp": "浪士たちと痛み分けだ",
   "en": "",
   "op": "0x62",
   "msg": "0x212f"
  },
  {
   "id": "ED_004001:0x132f4",
   "off": 78580,
   "max": 40,
   "kind": "dialogue",
   "jp": "え～　僕は　罪のない\\n被害者でしょ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2130"
  },
  {
   "id": "ED_004001:0x13834",
   "off": 79924,
   "max": 60,
   "kind": "dialogue",
   "jp": "被害者だと？　よく言う\\n俺はお前を\\n助けたつもりはないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x2131"
  },
  {
   "id": "ED_004001:0x13880",
   "off": 80000,
   "max": 52,
   "kind": "dialogue",
   "jp": "非情な化け物から\\nか弱い浪士を\\n助けてやったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2132"
  },
  {
   "id": "ED_004001:0x13dc8",
   "off": 81352,
   "max": 32,
   "kind": "dialogue",
   "jp": "化け物って　\\n土方さん酷いー",
   "en": "",
   "op": "0x62",
   "msg": "0x2133"
  },
  {
   "id": "ED_004001:0x14264",
   "off": 82532,
   "max": 48,
   "kind": "dialogue",
   "jp": "稽古をサボった分際で\\n口ごたえをするんじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x2134"
  },
  {
   "id": "ED_004001:0x14ba0",
   "off": 84896,
   "max": 64,
   "kind": "dialogue",
   "jp": "いいか　総司\\nこんな事を続けていると\\n下の者に示しがつかないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x2135"
  },
  {
   "id": "ED_004001:0x14c8c",
   "off": 85132,
   "max": 44,
   "kind": "dialogue",
   "jp": "俺達は自分達の手で\\n新しい時代を掴みとった",
   "en": "",
   "op": "0x62",
   "msg": "0x2136"
  },
  {
   "id": "ED_004001:0x14d64",
   "off": 85348,
   "max": 76,
   "kind": "dialogue",
   "jp": "近藤さんがいない　今\\n俺と総司の二人で新選組を\\n纏め上げなくてはいけない",
   "en": "",
   "op": "0x62",
   "msg": "0x2137"
  },
  {
   "id": "ED_004001:0x14dc0",
   "off": 85440,
   "max": 44,
   "kind": "dialogue",
   "jp": "お前には　俺の後ろに\\nいてもらわないと困る",
   "en": "",
   "op": "0x62",
   "msg": "0x2138"
  },
  {
   "id": "ED_004001:0x15484",
   "off": 87172,
   "max": 20,
   "kind": "dialogue",
   "jp": "……わかってますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2139"
  },
  {
   "id": "ED_004001:0x154a8",
   "off": 87208,
   "max": 52,
   "kind": "dialogue",
   "jp": "僕達にとっても　\\n今が大事な時期って\\nことくらいは",
   "en": "",
   "op": "0x62",
   "msg": "0x213a"
  },
  {
   "id": "ED_004001:0x15584",
   "off": 87428,
   "max": 60,
   "kind": "dialogue",
   "jp": "トサカくん達は　\\nロックを極めるために\\n旅に出ちゃったし",
   "en": "",
   "op": "0x62",
   "msg": "0x213b"
  },
  {
   "id": "ED_004001:0x15668",
   "off": 87656,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方さんと僕で\\n何もかも頑張らなくちゃ\\nいけない事くらい",
   "en": "",
   "op": "0x62",
   "msg": "0x213c"
  },
  {
   "id": "ED_004001:0x15f04",
   "off": 89860,
   "max": 16,
   "kind": "dialogue",
   "jp": "だと良いんだが",
   "en": "",
   "op": "0x62",
   "msg": "0x213d"
  },
  {
   "id": "ED_004001:0x16428",
   "off": 91176,
   "max": 60,
   "kind": "dialogue",
   "jp": "本当ですって\\nだから僕はここで\\n土方さんを待ってたんです",
   "en": "",
   "op": "0x62",
   "msg": "0x213e"
  },
  {
   "id": "ED_004001:0x1697c",
   "off": 92540,
   "max": 20,
   "kind": "dialogue",
   "jp": "どういう意味だ？",
   "en": "",
   "op": "0x62",
   "msg": "0x213f"
  },
  {
   "id": "ED_004001:0x16f0c",
   "off": 93964,
   "max": 76,
   "kind": "dialogue",
   "jp": "怪訝そうに首を傾げる土方\\nすると茶屋の娘が　\\n苺の乗った菓子を持って来た",
   "en": "",
   "op": "0x62",
   "msg": "0x2140"
  },
  {
   "id": "ED_004001:0x17838",
   "off": 96312,
   "max": 12,
   "kind": "dialogue",
   "jp": "何だコレは",
   "en": "",
   "op": "0x62",
   "msg": "0x2141"
  },
  {
   "id": "ED_004001:0x18204",
   "off": 98820,
   "max": 80,
   "kind": "dialogue",
   "jp": "慶喜様にあやかって\\n作られた\\n苺慶喜（イチゴケーキ）と\\n羽麩愛（パフェ）です",
   "en": "",
   "op": "0x62",
   "msg": "0x2142"
  },
  {
   "id": "ED_004001:0x18264",
   "off": 98916,
   "max": 60,
   "kind": "dialogue",
   "jp": "今　京の女の子に\\n大人気の洋菓子（スイーツ）\\nなんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2143"
  },
  {
   "id": "ED_004001:0x187b8",
   "off": 100280,
   "max": 48,
   "kind": "dialogue",
   "jp": "洋菓子だと？\\nこんなものが\\n流行っているのか",
   "en": "",
   "op": "0x62",
   "msg": "0x2144"
  },
  {
   "id": "ED_004001:0x18c64",
   "off": 101476,
   "max": 64,
   "kind": "dialogue",
   "jp": "はい　土方さんここ最近\\n屯所に籠ってたから\\n知らなかったでしょ",
   "en": "",
   "op": "0x62",
   "msg": "0x2145"
  },
  {
   "id": "ED_004001:0x19370",
   "off": 103280,
   "max": 20,
   "kind": "dialogue",
   "jp": "うっ　それは……",
   "en": "",
   "op": "0x62",
   "msg": "0x2146"
  },
  {
   "id": "ED_004001:0x19c74",
   "off": 105588,
   "max": 52,
   "kind": "dialogue",
   "jp": "ねえ　土方さん\\n次の曲の歌詞に\\n苺慶喜と羽麩愛とか",
   "en": "",
   "op": "0x62",
   "msg": "0x2147"
  },
  {
   "id": "ED_004001:0x19cb8",
   "off": 105656,
   "max": 56,
   "kind": "dialogue",
   "jp": "洋菓子の名前を\\n取り入れてみたら\\n面白いと思いません？",
   "en": "",
   "op": "0x62",
   "msg": "0x2148"
  },
  {
   "id": "ED_004001:0x1a558",
   "off": 107864,
   "max": 28,
   "kind": "dialogue",
   "jp": "ふむ……\\n興味深い提案だな",
   "en": "",
   "op": "0x62",
   "msg": "0x2149"
  },
  {
   "id": "ED_004001:0x1a620",
   "off": 108064,
   "max": 60,
   "kind": "dialogue",
   "jp": "今までの新選組とは\\n一味違った曲を　\\n煌に届けられそうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x214a"
  },
  {
   "id": "ED_004001:0x1ab78",
   "off": 109432,
   "max": 60,
   "kind": "dialogue",
   "jp": "ふふ　でしょー？\\n土方さんなら　\\nわかってくれると思った",
   "en": "",
   "op": "0x62",
   "msg": "0x214b"
  },
  {
   "id": "ED_004001:0x1b4a4",
   "off": 111780,
   "max": 76,
   "kind": "dialogue",
   "jp": "愛獲として　最高の\\n表現（パフォーマンス）を\\nするために\\n稽古は欠かせない",
   "en": "",
   "op": "0x62",
   "msg": "0x214c"
  },
  {
   "id": "ED_004001:0x1b598",
   "off": 112024,
   "max": 44,
   "kind": "dialogue",
   "jp": "だけどそれだけでは\\n駄目だと僕は思うんです",
   "en": "",
   "op": "0x62",
   "msg": "0x214d"
  },
  {
   "id": "ED_004001:0x1bce4",
   "off": 113892,
   "max": 48,
   "kind": "dialogue",
   "jp": "何だと？　\\n稽古の他に\\n何が必要だと言うんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x214e"
  },
  {
   "id": "ED_004001:0x1c518",
   "off": 115992,
   "max": 60,
   "kind": "dialogue",
   "jp": "僕はね　土方さん\\n新選組がこれから先も\\n輝き続けるためには",
   "en": "",
   "op": "0x62",
   "msg": "0x214f"
  },
  {
   "id": "ED_004001:0x1c564",
   "off": 116068,
   "max": 64,
   "kind": "dialogue",
   "jp": "屯所の外に出て\\n町の人の話に耳を傾けたり\\n流行りものを見たり",
   "en": "",
   "op": "0x62",
   "msg": "0x2150"
  },
  {
   "id": "ED_004001:0x1c5b4",
   "off": 116148,
   "max": 84,
   "kind": "dialogue",
   "jp": "様々な所に\\n空中線（アンテナ）を\\n張り巡らせて　常に進化する\\n必要があると思います",
   "en": "",
   "op": "0x62",
   "msg": "0x2151"
  },
  {
   "id": "ED_004001:0x1c6b0",
   "off": 116400,
   "max": 40,
   "kind": "dialogue",
   "jp": "だから土方さん\\nそんなに固くならないで",
   "en": "",
   "op": "0x62",
   "msg": "0x2152"
  },
  {
   "id": "ED_004001:0x1c6e8",
   "off": 116456,
   "max": 72,
   "kind": "dialogue",
   "jp": "僕達がトサカくん達と\\n掴みとった時代を　今を\\nもっと楽しみましょうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2153"
  },
  {
   "id": "ED_004001:0x1cf90",
   "off": 118672,
   "max": 60,
   "kind": "dialogue",
   "jp": "ふっ……なるほどな\\n総司は総司なりに\\n色々と考えていたのか",
   "en": "",
   "op": "0x62",
   "msg": "0x2154"
  },
  {
   "id": "ED_004001:0x1cfdc",
   "off": 118748,
   "max": 68,
   "kind": "dialogue",
   "jp": "その考えを伝えるために\\nわざと稽古を抜け出し\\n俺を待っていたとはな",
   "en": "",
   "op": "0x62",
   "msg": "0x2155"
  },
  {
   "id": "ED_004001:0x1d534",
   "off": 120116,
   "max": 64,
   "kind": "dialogue",
   "jp": "僕は否定も肯定もしません\\nそう思いたければ　\\nご自由にどうぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x2156"
  },
  {
   "id": "ED_004001:0x1d584",
   "off": 120196,
   "max": 52,
   "kind": "dialogue",
   "jp": "でも屯所を抜け出した罰は\\n帳消しにしてほしいなぁ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2157"
  },
  {
   "id": "ED_004001:0x1da90",
   "off": 121488,
   "max": 24,
   "kind": "dialogue",
   "jp": "それとこれとは話は別だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2158"
  },
  {
   "id": "ED_004001:0x1dac0",
   "off": 121536,
   "max": 60,
   "kind": "dialogue",
   "jp": "総司　屯所に帰ったら\\n走り込み百周と\\n腕立て腹筋三百回だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2159"
  },
  {
   "id": "ED_004001:0x1e018",
   "off": 122904,
   "max": 16,
   "kind": "dialogue",
   "jp": "ええ～～～～",
   "en": "",
   "op": "0x62",
   "msg": "0x215a"
  },
  {
   "id": "ED_004001:0x1e4a4",
   "off": 124068,
   "max": 72,
   "kind": "dialogue",
   "jp": "その後は雷舞の稽古と\\n発声訓練\\n（ボイストレーニング）\\nも待ってるぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x215b"
  },
  {
   "id": "ED_004001:0x1ea5c",
   "off": 125532,
   "max": 20,
   "kind": "dialogue",
   "jp": "えぇえええ～～～",
   "en": "",
   "op": "0x62",
   "msg": "0x215c"
  },
  {
   "id": "ED_004001:0x1f4d8",
   "off": 128216,
   "max": 80,
   "kind": "dialogue",
   "jp": "一通りの稽古が終わったら\\nその後は……その　二人で\\n新曲の作詞に取り掛かろう",
   "en": "",
   "op": "0x62",
   "msg": "0x215d"
  },
  {
   "id": "ED_004001:0x1fbc8",
   "off": 129992,
   "max": 24,
   "kind": "dialogue",
   "jp": "……もう　仕方ないなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x215e"
  },
  {
   "id": "ED_004001:0x20170",
   "off": 131440,
   "max": 64,
   "kind": "dialogue",
   "jp": "沖田はにっこり笑うと\\n苺慶喜を匙ですくって\\n土方の口元に向けた",
   "en": "",
   "op": "0x62",
   "msg": "0x215f"
  },
  {
   "id": "ED_004001:0x20734",
   "off": 132916,
   "max": 36,
   "kind": "dialogue",
   "jp": "はい　土方さん\\nあーんしてください",
   "en": "",
   "op": "0x62",
   "msg": "0x2160"
  },
  {
   "id": "ED_004001:0x20ccc",
   "off": 134348,
   "max": 20,
   "kind": "dialogue",
   "jp": "おい　何の真似だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2161"
  },
  {
   "id": "ED_004001:0x2115c",
   "off": 135516,
   "max": 56,
   "kind": "dialogue",
   "jp": "屯所に帰る前に\\n流行りものの味を\\n勉強しておくんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2162"
  },
  {
   "id": "ED_004001:0x21d2c",
   "off": 138540,
   "max": 28,
   "kind": "dialogue",
   "jp": "だから　はい\\nあ～～～～ん",
   "en": "",
   "op": "0x62",
   "msg": "0x2163"
  },
  {
   "id": "ED_004001:0x22220",
   "off": 139808,
   "max": 48,
   "kind": "dialogue",
   "jp": "うっ　そんなもの\\n恥ずかしくて\\n食べられるか",
   "en": "",
   "op": "0x62",
   "msg": "0x2164"
  },
  {
   "id": "ED_004001:0x2276c",
   "off": 141164,
   "max": 56,
   "kind": "dialogue",
   "jp": "あっ　土方さん顔真っ赤\\n照れなくて良いのに\\n可愛いなー",
   "en": "",
   "op": "0x62",
   "msg": "0x2165"
  },
  {
   "id": "ED_004001:0x22d18",
   "off": 142616,
   "max": 16,
   "kind": "dialogue",
   "jp": "な　何だと",
   "en": "",
   "op": "0x62",
   "msg": "0x2166"
  },
  {
   "id": "ED_004001:0x231ac",
   "off": 143788,
   "max": 20,
   "kind": "dialogue",
   "jp": "土方さん　隙あり！",
   "en": "",
   "op": "0x62",
   "msg": "0x2167"
  },
  {
   "id": "ED_004001:0x238a0",
   "off": 145568,
   "max": 12,
   "kind": "dialogue",
   "jp": "むぐっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2168"
  },
  {
   "id": "ED_004001:0x23c60",
   "off": 146528,
   "max": 48,
   "kind": "dialogue",
   "jp": "土方の大きく開いた口に\\n沖田は匙を突っ込んだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2169"
  },
  {
   "id": "ED_004001:0x244dc",
   "off": 148700,
   "max": 20,
   "kind": "dialogue",
   "jp": "もぐもぐもぐ……",
   "en": "",
   "op": "0x62",
   "msg": "0x216a"
  },
  {
   "id": "ED_004001:0x2496c",
   "off": 149868,
   "max": 36,
   "kind": "dialogue",
   "jp": "ふふふ　土方さん\\nお味はいかが？",
   "en": "",
   "op": "0x62",
   "msg": "0x216b"
  },
  {
   "id": "ED_004001:0x249a0",
   "off": 149920,
   "max": 60,
   "kind": "dialogue",
   "jp": "あっ　\\nちなみにこの店のお代は\\n土方さんにお願いしますね",
   "en": "",
   "op": "0x62",
   "msg": "0x216c"
  },
  {
   "id": "ED_004001:0x249ec",
   "off": 149996,
   "max": 64,
   "kind": "dialogue",
   "jp": "先輩たるもの　後輩には\\n美味しいものを\\n奢るべきでしょ？　ね？",
   "en": "",
   "op": "0x62",
   "msg": "0x216d"
  },
  {
   "id": "ED_004001:0x25488",
   "off": 152712,
   "max": 48,
   "kind": "dialogue",
   "jp": "っっっ……総司ぃぃぃ\\nそこに正座しろぉぉっ",
   "en": "",
   "op": "0x62",
   "msg": "0x216e"
  },
  {
   "id": "ED_004001:0x25a74",
   "off": 154228,
   "max": 64,
   "kind": "dialogue",
   "jp": "茶屋に土方の怒号が響き渡り\\n沖田はその叫びを笑顔で\\n受け止める",
   "en": "",
   "op": "0x62",
   "msg": "0x216f"
  },
  {
   "id": "ED_004001:0x25ac4",
   "off": 154308,
   "max": 76,
   "kind": "dialogue",
   "jp": "そんな二人の様子を\\nいつの間にか集まっていた\\n煌達が和やかに見つめていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2170"
  },
  {
   "id": "ED_004001:0x260f4",
   "off": 155892,
   "max": 64,
   "kind": "dialogue",
   "jp": "きゃー！　今の見た\\n総司様が土方様に\\nあ～んをされたわよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2171"
  },
  {
   "id": "ED_004001:0x26614",
   "off": 157204,
   "max": 84,
   "kind": "dialogue",
   "jp": "土方様と総司様って\\n私生活（プライベート）でも\\n仲良しなのね♪\\nあ～～もう　素敵",
   "en": "",
   "op": "0x62",
   "msg": "0x2172"
  },
  {
   "id": "ED_004001:0x26e54",
   "off": 159316,
   "max": 76,
   "kind": "dialogue",
   "jp": "やっぱり新選組は最高よ！\\nどんなに時代が変わっても\\n私一生ついていくわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2173"
  },
  {
   "id": "ED_004001:0x27338",
   "off": 160568,
   "max": 48,
   "kind": "dialogue",
   "jp": "少女の言葉に『私も！』\\n『私も』と声が上がる",
   "en": "",
   "op": "0x62",
   "msg": "0x2174"
  },
  {
   "id": "ED_004001:0x27378",
   "off": 160632,
   "max": 60,
   "kind": "dialogue",
   "jp": "こうして新選組は\\n大勢の煌達に支持され\\n日本一の愛獲として",
   "en": "",
   "op": "0x62",
   "msg": "0x2175"
  },
  {
   "id": "ED_004001:0x273c4",
   "off": 160708,
   "max": 24,
   "kind": "dialogue",
   "jp": "永遠に輝き続けるのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2176"
  }
 ]
}
