{
 "source": "ED_005001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "ED_005001:0x129c",
   "off": 4764,
   "max": 40,
   "kind": "dialogue",
   "jp": "――二条城\\n雷舞舞台（ライブステージ）",
   "en": "",
   "op": "0x62",
   "msg": "0x1f4a"
  },
  {
   "id": "ED_005001:0x12d4",
   "off": 4820,
   "max": 56,
   "kind": "dialogue",
   "jp": "慶喜を救った\\n龍馬たちのロックは\\nたちまち有名になった",
   "en": "",
   "op": "0x62",
   "msg": "0x1f4b"
  },
  {
   "id": "ED_005001:0x131c",
   "off": 4892,
   "max": 60,
   "kind": "dialogue",
   "jp": "禁令は解かれ\\n自由に音楽を\\n奏でられるように\\nなった日本",
   "en": "",
   "op": "0x62",
   "msg": "0x1f4c"
  },
  {
   "id": "ED_005001:0x1368",
   "off": 4968,
   "max": 68,
   "kind": "dialogue",
   "jp": "その日本全国を\\n龍馬たちは駆け巡り\\n請われるままに\\n雷舞を行った",
   "en": "",
   "op": "0x62",
   "msg": "0x1f4d"
  },
  {
   "id": "ED_005001:0x13bc",
   "off": 5052,
   "max": 52,
   "kind": "dialogue",
   "jp": "江戸 大阪 尾張 福岡\\nそして……\\nここ　京の二条城",
   "en": "",
   "op": "0x62",
   "msg": "0x1f4e"
  },
  {
   "id": "ED_005001:0x1400",
   "off": 5120,
   "max": 64,
   "kind": "dialogue",
   "jp": "巨大な雷舞舞台を巡る\\n五大ツアーもいよいよ\\n最終舞台であった",
   "en": "",
   "op": "0x62",
   "msg": "0x1f4f"
  },
  {
   "id": "ED_005001:0x1c58",
   "off": 7256,
   "max": 64,
   "kind": "dialogue",
   "jp": "みんなー！\\n今日もわしらの雷舞に\\n来てくれてありがとなーっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f50"
  },
  {
   "id": "ED_005001:0x2720",
   "off": 10016,
   "max": 40,
   "kind": "dialogue",
   "jp": "今宵の蘭出舞（ランデブー）も\\n最高か？",
   "en": "",
   "op": "0x62",
   "msg": "0x1f51"
  },
  {
   "id": "ED_005001:0x2bcc",
   "off": 11212,
   "max": 24,
   "kind": "dialogue",
   "jp": "イエェェェェェェイ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f52"
  },
  {
   "id": "ED_005001:0x3064",
   "off": 12388,
   "max": 36,
   "kind": "dialogue",
   "jp": "なら良い\\n俺たちの歌に酔いしれろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f53"
  },
  {
   "id": "ED_005001:0x3988",
   "off": 14728,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふふっ\\nみんなに聴いてもらえて\\n嬉しいよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x1f54"
  },
  {
   "id": "ED_005001:0x4050",
   "off": 16464,
   "max": 52,
   "kind": "dialogue",
   "jp": "どんどん歌いますから\\nはりきって\\n聴いてくださいね",
   "en": "",
   "op": "0x62",
   "msg": "0x1f55"
  },
  {
   "id": "ED_005001:0x496c",
   "off": 18796,
   "max": 56,
   "kind": "dialogue",
   "jp": "だーっ！\\n無駄口を叩かずに\\nさっさと次の曲に行くぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f56"
  },
  {
   "id": "ED_005001:0x5210",
   "off": 21008,
   "max": 48,
   "kind": "dialogue",
   "jp": "はいはい晋作は\\n照れて挨拶が\\nできないんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x1f57"
  },
  {
   "id": "ED_005001:0x5250",
   "off": 21072,
   "max": 36,
   "kind": "dialogue",
   "jp": "だから次の歌が\\n早く歌いたいんです",
   "en": "",
   "op": "0x62",
   "msg": "0x1f58"
  },
  {
   "id": "ED_005001:0x57e8",
   "off": 22504,
   "max": 36,
   "kind": "dialogue",
   "jp": "なっ！　\\nそういうわけじゃねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f59"
  },
  {
   "id": "ED_005001:0x5c90",
   "off": 23696,
   "max": 44,
   "kind": "dialogue",
   "jp": "贔屓のみなさんにもっと\\n語りかけましょうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f5a"
  },
  {
   "id": "ED_005001:0x6440",
   "off": 25664,
   "max": 56,
   "kind": "dialogue",
   "jp": "あははっ\\nじゃあ　歌は僕たちに\\n任せて挨拶やってよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x1f5b"
  },
  {
   "id": "ED_005001:0x6c84",
   "off": 27780,
   "max": 56,
   "kind": "dialogue",
   "jp": "ふざけんな！\\nオレ様は歌いたくないとは\\n言ってねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f5c"
  },
  {
   "id": "ED_005001:0x72f8",
   "off": 29432,
   "max": 44,
   "kind": "dialogue",
   "jp": "そういうわけじゃないとか\\n言ったくせに～",
   "en": "",
   "op": "0x62",
   "msg": "0x1f5d"
  },
  {
   "id": "ED_005001:0x77a0",
   "off": 30624,
   "max": 40,
   "kind": "dialogue",
   "jp": "挨拶が照れるってのを\\n否定しただけだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f5e"
  },
  {
   "id": "ED_005001:0x7f4c",
   "off": 32588,
   "max": 56,
   "kind": "dialogue",
   "jp": "まあまあシンディは\\nちぃっとばかり\\n素直じゃないんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f5f"
  },
  {
   "id": "ED_005001:0x8620",
   "off": 34336,
   "max": 48,
   "kind": "dialogue",
   "jp": "そうそう　素直じゃないし\\n照れ屋なんですよねー",
   "en": "",
   "op": "0x62",
   "msg": "0x1f60"
  },
  {
   "id": "ED_005001:0x8eb4",
   "off": 36532,
   "max": 48,
   "kind": "dialogue",
   "jp": "だから　お前ら\\nオレ様のことを\\n勝手に語るな！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f61"
  },
  {
   "id": "ED_005001:0x9cfc",
   "off": 40188,
   "max": 56,
   "kind": "dialogue",
   "jp": "ってテメェも何一人で\\n勝手に始めてやがんだ！\\n土方！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f62"
  },
  {
   "id": "ED_005001:0xa374",
   "off": 41844,
   "max": 20,
   "kind": "dialogue",
   "jp": "……演らないのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1f63"
  },
  {
   "id": "ED_005001:0xa858",
   "off": 43096,
   "max": 36,
   "kind": "dialogue",
   "jp": "アホ！　\\n演るに決まってんだろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f64"
  },
  {
   "id": "ED_005001:0xa894",
   "off": 43156,
   "max": 44,
   "kind": "dialogue",
   "jp": "おい　龍馬　桂さん\\nあと……おまけの沖田！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f65"
  },
  {
   "id": "ED_005001:0xb044",
   "off": 45124,
   "max": 24,
   "kind": "dialogue",
   "jp": "おまけは余計じゃない？",
   "en": "",
   "op": "0x62",
   "msg": "0x1f66"
  },
  {
   "id": "ED_005001:0xb9c8",
   "off": 47560,
   "max": 20,
   "kind": "dialogue",
   "jp": "いいから　いくぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f67"
  },
  {
   "id": "ED_005001:0xc5ac",
   "off": 50604,
   "max": 28,
   "kind": "dialogue",
   "jp": "はいはい\\n合わせますよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f68"
  },
  {
   "id": "ED_005001:0xcf18",
   "off": 53016,
   "max": 24,
   "kind": "dialogue",
   "jp": "もう～しょうがないなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f69"
  },
  {
   "id": "ED_005001:0xd844",
   "off": 55364,
   "max": 52,
   "kind": "dialogue",
   "jp": "よーし！\\nシャウト！　シャウト！\\nシャウトじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f6a"
  },
  {
   "id": "ED_005001:0xd888",
   "off": 55432,
   "max": 28,
   "kind": "dialogue",
   "jp": "わしらの歌を聴くぜよぉ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f6b"
  },
  {
   "id": "ED_005001:0xe610",
   "off": 58896,
   "max": 24,
   "kind": "dialogue",
   "jp": "素晴らしい雷舞であった",
   "en": "",
   "op": "0x62",
   "msg": "0x1f6c"
  },
  {
   "id": "ED_005001:0xec70",
   "off": 60528,
   "max": 44,
   "kind": "dialogue",
   "jp": "おっ\\n来てくれたんか\\n\\fnt1ヨッシー！\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x1f6d"
  },
  {
   "id": "ED_005001:0xf480",
   "off": 62592,
   "max": 28,
   "kind": "dialogue",
   "jp": "\\fnt1よ　ヨッシー\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x1f6e"
  },
  {
   "id": "ED_005001:0xfb48",
   "off": 64328,
   "max": 48,
   "kind": "dialogue",
   "jp": "まさかとは思うが\\n上様のことでは\\nあるまいな？",
   "en": "",
   "op": "0x62",
   "msg": "0x1f6f"
  },
  {
   "id": "ED_005001:0x10218",
   "off": 66072,
   "max": 16,
   "kind": "dialogue",
   "jp": "そうじゃが？",
   "en": "",
   "op": "0x62",
   "msg": "0x1f70"
  },
  {
   "id": "ED_005001:0x10db0",
   "off": 69040,
   "max": 16,
   "kind": "dialogue",
   "jp": "よし　斬ろう",
   "en": "",
   "op": "0x62",
   "msg": "0x1f71"
  },
  {
   "id": "ED_005001:0x11680",
   "off": 71296,
   "max": 32,
   "kind": "dialogue",
   "jp": "わ～　土方さんが\\n怒ってるぅ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f72"
  },
  {
   "id": "ED_005001:0x11cf4",
   "off": 72948,
   "max": 44,
   "kind": "dialogue",
   "jp": "って見てないで\\n止めてください\\n沖田くん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f73"
  },
  {
   "id": "ED_005001:0x1219c",
   "off": 74140,
   "max": 60,
   "kind": "dialogue",
   "jp": "だって～　僕\\n人斬ってる土方さん\\nけっこう好きなんだよね",
   "en": "",
   "op": "0x62",
   "msg": "0x1f74"
  },
  {
   "id": "ED_005001:0x129bc",
   "off": 76220,
   "max": 32,
   "kind": "dialogue",
   "jp": "さらっと物騒なことを\\n言うな！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f75"
  },
  {
   "id": "ED_005001:0x13098",
   "off": 77976,
   "max": 44,
   "kind": "dialogue",
   "jp": "良いのだ　土方\\n龍馬と予は\\n魂友なのだから",
   "en": "",
   "op": "0x62",
   "msg": "0x1f76"
  },
  {
   "id": "ED_005001:0x13708",
   "off": 79624,
   "max": 16,
   "kind": "dialogue",
   "jp": "しかし……！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f77"
  },
  {
   "id": "ED_005001:0x13b94",
   "off": 80788,
   "max": 36,
   "kind": "dialogue",
   "jp": "予はもう将軍でもないし\\n幕府もない",
   "en": "",
   "op": "0x62",
   "msg": "0x1f78"
  },
  {
   "id": "ED_005001:0x13bc8",
   "off": 80840,
   "max": 36,
   "kind": "dialogue",
   "jp": "何より龍馬とは\\n友達になったのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f79"
  },
  {
   "id": "ED_005001:0x13bfc",
   "off": 80892,
   "max": 36,
   "kind": "dialogue",
   "jp": "気軽に呼んでもらえて\\n予は嬉しい",
   "en": "",
   "op": "0x62",
   "msg": "0x1f7a"
  },
  {
   "id": "ED_005001:0x14138",
   "off": 82232,
   "max": 60,
   "kind": "dialogue",
   "jp": "上……慶喜様が\\nそうおっしゃられるのなら\\n刀を納めましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x1f7b"
  },
  {
   "id": "ED_005001:0x148f8",
   "off": 84216,
   "max": 24,
   "kind": "dialogue",
   "jp": "ふい～\\nおっかなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x1f7c"
  },
  {
   "id": "ED_005001:0x14e24",
   "off": 85540,
   "max": 40,
   "kind": "dialogue",
   "jp": "しかし一度は幕府に\\n反抗したってのに",
   "en": "",
   "op": "0x62",
   "msg": "0x1f7d"
  },
  {
   "id": "ED_005001:0x14e5c",
   "off": 85596,
   "max": 48,
   "kind": "dialogue",
   "jp": "ヒジゾーさんはヨッシーを\\n敬っちょるんじゃのう",
   "en": "",
   "op": "0x62",
   "msg": "0x1f7e"
  },
  {
   "id": "ED_005001:0x15528",
   "off": 87336,
   "max": 52,
   "kind": "dialogue",
   "jp": "俺が抗ったのはあくまで\\n大老井伊の悪辣なやり口だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f7f"
  },
  {
   "id": "ED_005001:0x1556c",
   "off": 87404,
   "max": 48,
   "kind": "dialogue",
   "jp": "近藤さんが尊敬していた\\n慶喜様を悪くは思えない",
   "en": "",
   "op": "0x62",
   "msg": "0x1f80"
  },
  {
   "id": "ED_005001:0x15d7c",
   "off": 89468,
   "max": 44,
   "kind": "dialogue",
   "jp": "しかし　将軍をおやめに\\nなったとはいえ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1f81"
  },
  {
   "id": "ED_005001:0x15db8",
   "off": 89528,
   "max": 48,
   "kind": "dialogue",
   "jp": "このような場所にお一人で\\nよろしいのですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1f82"
  },
  {
   "id": "ED_005001:0x16264",
   "off": 90724,
   "max": 40,
   "kind": "dialogue",
   "jp": "魂友の龍馬がおるから\\n一人ではないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f83"
  },
  {
   "id": "ED_005001:0x16924",
   "off": 92452,
   "max": 32,
   "kind": "dialogue",
   "jp": "おう　わしが\\nついてるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f84"
  },
  {
   "id": "ED_005001:0x170cc",
   "off": 94412,
   "max": 52,
   "kind": "dialogue",
   "jp": "上……慶喜様は\\n江戸に行かなくて\\nいいんですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1f85"
  },
  {
   "id": "ED_005001:0x17110",
   "off": 94480,
   "max": 36,
   "kind": "dialogue",
   "jp": "新政府だなんだと\\n忙しそうですけど",
   "en": "",
   "op": "0x62",
   "msg": "0x1f86"
  },
  {
   "id": "ED_005001:0x177d0",
   "off": 96208,
   "max": 48,
   "kind": "dialogue",
   "jp": "いいのだ\\nあちらは勝がなんとか\\nしてくれよう",
   "en": "",
   "op": "0x62",
   "msg": "0x1f87"
  },
  {
   "id": "ED_005001:0x17e84",
   "off": 97924,
   "max": 64,
   "kind": "dialogue",
   "jp": "予も長年の悲しみ\\n徳川の怨霊から解放され\\n自由になれたのだから",
   "en": "",
   "op": "0x62",
   "msg": "0x1f88"
  },
  {
   "id": "ED_005001:0x17ed4",
   "off": 98004,
   "max": 60,
   "kind": "dialogue",
   "jp": "しばらくは好きなように\\n日々を　歌を楽しもうと\\n思うのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f89"
  },
  {
   "id": "ED_005001:0x1862c",
   "off": 99884,
   "max": 20,
   "kind": "dialogue",
   "jp": "それはいいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f8a"
  },
  {
   "id": "ED_005001:0x18b54",
   "off": 101204,
   "max": 64,
   "kind": "dialogue",
   "jp": "ヨッシーは今まで一人で\\n重いもんを背負いすぎ\\nじゃったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f8b"
  },
  {
   "id": "ED_005001:0x18ba4",
   "off": 101284,
   "max": 52,
   "kind": "dialogue",
   "jp": "それを下ろして\\n軽くなった今\\nどこへでも行ける！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f8c"
  },
  {
   "id": "ED_005001:0x19274",
   "off": 103028,
   "max": 32,
   "kind": "dialogue",
   "jp": "どこへでもか……ふふっ\\nいいな",
   "en": "",
   "op": "0x62",
   "msg": "0x1f8d"
  },
  {
   "id": "ED_005001:0x1992c",
   "off": 104748,
   "max": 32,
   "kind": "dialogue",
   "jp": "確かにそういうのは\\n良いよね",
   "en": "",
   "op": "0x62",
   "msg": "0x1f8e"
  },
  {
   "id": "ED_005001:0x1995c",
   "off": 104796,
   "max": 40,
   "kind": "dialogue",
   "jp": "風の向くまま\\n気の向くまま……ふふっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f8f"
  },
  {
   "id": "ED_005001:0x19994",
   "off": 104852,
   "max": 20,
   "kind": "dialogue",
   "jp": "どこへ行こうかなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f90"
  },
  {
   "id": "ED_005001:0x19ff4",
   "off": 106484,
   "max": 48,
   "kind": "dialogue",
   "jp": "総司……\\nお前　新選組はどうする\\nつもりだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1f91"
  },
  {
   "id": "ED_005001:0x1a538",
   "off": 107832,
   "max": 36,
   "kind": "dialogue",
   "jp": "やだな　土方さん\\n想像だけですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f92"
  },
  {
   "id": "ED_005001:0x1a56c",
   "off": 107884,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方さんを置いて\\nどこかに行くわけ\\nないじゃないですか～",
   "en": "",
   "op": "0x62",
   "msg": "0x1f93"
  },
  {
   "id": "ED_005001:0x1a5b8",
   "off": 107960,
   "max": 36,
   "kind": "dialogue",
   "jp": "それに　ここは結構\\n気に入ってるし",
   "en": "",
   "op": "0x62",
   "msg": "0x1f94"
  },
  {
   "id": "ED_005001:0x1ad64",
   "off": 109924,
   "max": 28,
   "kind": "dialogue",
   "jp": "オレ様は\\n気に入らんがな",
   "en": "",
   "op": "0x62",
   "msg": "0x1f95"
  },
  {
   "id": "ED_005001:0x1b41c",
   "off": 111644,
   "max": 32,
   "kind": "dialogue",
   "jp": "晋作　そこは素直に\\nなろうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f96"
  },
  {
   "id": "ED_005001:0x1bc04",
   "off": 113668,
   "max": 40,
   "kind": "dialogue",
   "jp": "桂さん　オレ様は\\nマジで言ってるんだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f97"
  },
  {
   "id": "ED_005001:0x1bc3c",
   "off": 113724,
   "max": 44,
   "kind": "dialogue",
   "jp": "こんなところでなんて\\n満足してねえってな",
   "en": "",
   "op": "0x62",
   "msg": "0x1f98"
  },
  {
   "id": "ED_005001:0x1c214",
   "off": 115220,
   "max": 24,
   "kind": "dialogue",
   "jp": "龍馬　お前もそうだろ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1f99"
  },
  {
   "id": "ED_005001:0x1c8c4",
   "off": 116932,
   "max": 44,
   "kind": "dialogue",
   "jp": "そうじゃな　わしも\\nちょっと考えてたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f9a"
  },
  {
   "id": "ED_005001:0x1d25c",
   "off": 119388,
   "max": 68,
   "kind": "dialogue",
   "jp": "トサカくんが　考えるぅ？\\nうわ　天気大丈夫かな\\n槍とか降ってきそう",
   "en": "",
   "op": "0x62",
   "msg": "0x1f9b"
  },
  {
   "id": "ED_005001:0x1da68",
   "off": 121448,
   "max": 36,
   "kind": "dialogue",
   "jp": "総司　いくらなんでも\\nそれは失礼だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1f9c"
  },
  {
   "id": "ED_005001:0x1e128",
   "off": 123176,
   "max": 48,
   "kind": "dialogue",
   "jp": "沖田くんの気持ちは\\nわからないでもないですね",
   "en": "",
   "op": "0x62",
   "msg": "0x1f9d"
  },
  {
   "id": "ED_005001:0x1e7a0",
   "off": 124832,
   "max": 24,
   "kind": "dialogue",
   "jp": "だよねぇ　メガネくん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1f9e"
  },
  {
   "id": "ED_005001:0x1ef44",
   "off": 126788,
   "max": 36,
   "kind": "dialogue",
   "jp": "ソウちんもセンセーも\\nひどいぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x1f9f"
  },
  {
   "id": "ED_005001:0x1ef78",
   "off": 126840,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしはもっと\\nロックの事が\\n知りたいぜよ！\\nだから……",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa0"
  },
  {
   "id": "ED_005001:0x1f854",
   "off": 129108,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしは　ロックが\\n生まれた場所へ\\n行ってみたいんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa1"
  },
  {
   "id": "ED_005001:0x200c4",
   "off": 131268,
   "max": 52,
   "kind": "dialogue",
   "jp": "よし！　よく言った龍馬！\\nオレ様もそう思ってたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa2"
  },
  {
   "id": "ED_005001:0x208fc",
   "off": 133372,
   "max": 76,
   "kind": "dialogue",
   "jp": "ええーっ　ちょっと待ってよ\\nロックが生まれた所って\\nこの国じゃないよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa3"
  },
  {
   "id": "ED_005001:0x21068",
   "off": 135272,
   "max": 68,
   "kind": "dialogue",
   "jp": "ロックの発祥は　メリケン\\nだと　松陰先生が\\n教えてくれましたが……",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa4"
  },
  {
   "id": "ED_005001:0x21748",
   "off": 137032,
   "max": 40,
   "kind": "dialogue",
   "jp": "欧羅巴（ヨーロッパ）でも\\n盛んらしいぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa5"
  },
  {
   "id": "ED_005001:0x21e08",
   "off": 138760,
   "max": 52,
   "kind": "dialogue",
   "jp": "そうか！　行くところが\\nいっぱいあるんじゃなー！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa6"
  },
  {
   "id": "ED_005001:0x22480",
   "off": 140416,
   "max": 68,
   "kind": "dialogue",
   "jp": "あるんじゃなーって　\\n龍馬くん　この国を出て\\n行くつもりですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa7"
  },
  {
   "id": "ED_005001:0x22940",
   "off": 141632,
   "max": 44,
   "kind": "dialogue",
   "jp": "おう！　世界は広いん\\nじゃろう　センセー",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa8"
  },
  {
   "id": "ED_005001:0x2297c",
   "off": 141692,
   "max": 40,
   "kind": "dialogue",
   "jp": "どんなロックがあるのか\\n楽しみぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fa9"
  },
  {
   "id": "ED_005001:0x22a4c",
   "off": 141900,
   "max": 48,
   "kind": "dialogue",
   "jp": "それで　わしは世界中で\\nロックを歌うんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1faa"
  },
  {
   "id": "ED_005001:0x23204",
   "off": 143876,
   "max": 48,
   "kind": "dialogue",
   "jp": "そうだぜ！　本場だから\\nって負けてられるか！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fab"
  },
  {
   "id": "ED_005001:0x23ad4",
   "off": 146132,
   "max": 32,
   "kind": "dialogue",
   "jp": "オレ様の歌で\\n圧倒してやるぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fac"
  },
  {
   "id": "ED_005001:0x2425c",
   "off": 148060,
   "max": 68,
   "kind": "dialogue",
   "jp": "おお　シンディ！　\\nわしらのロックを世界に\\n聴かせるぜよーーーっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fad"
  },
  {
   "id": "ED_005001:0x24aa4",
   "off": 150180,
   "max": 60,
   "kind": "dialogue",
   "jp": "……龍馬くん　晋作\\n本気ですか？\\n……本気ですよね　ふう",
   "en": "",
   "op": "0x62",
   "msg": "0x1fae"
  },
  {
   "id": "ED_005001:0x2517c",
   "off": 151932,
   "max": 56,
   "kind": "dialogue",
   "jp": "確かに今　日本には\\n外国からの船が\\n来るようになった",
   "en": "",
   "op": "0x62",
   "msg": "0x1faf"
  },
  {
   "id": "ED_005001:0x251c4",
   "off": 152004,
   "max": 40,
   "kind": "dialogue",
   "jp": "外国に渡ることも\\n不可能ではないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb0"
  },
  {
   "id": "ED_005001:0x25704",
   "off": 153348,
   "max": 56,
   "kind": "dialogue",
   "jp": "だが　ロックの本場の\\n外国で　我らの歌が\\n通じるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb1"
  },
  {
   "id": "ED_005001:0x25dd4",
   "off": 155092,
   "max": 64,
   "kind": "dialogue",
   "jp": "ちょっと無謀じゃない？\\nせっかく日本に煌が\\nいっぱいいるのにさ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb2"
  },
  {
   "id": "ED_005001:0x264ac",
   "off": 156844,
   "max": 40,
   "kind": "dialogue",
   "jp": "ほんでもやってみんと\\nわからんじゃろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb3"
  },
  {
   "id": "ED_005001:0x264e4",
   "off": 156900,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしは難しいことは\\nようわからん",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb4"
  },
  {
   "id": "ED_005001:0x26518",
   "off": 156952,
   "max": 64,
   "kind": "dialogue",
   "jp": "満足して　そこで\\n止まってしまったら\\nそれはロックじゃないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb5"
  },
  {
   "id": "ED_005001:0x26d60",
   "off": 159072,
   "max": 56,
   "kind": "dialogue",
   "jp": "ア　ローリングストーン\\nギャザーズ　ノーモス\\nですか",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb6"
  },
  {
   "id": "ED_005001:0x27608",
   "off": 161288,
   "max": 20,
   "kind": "dialogue",
   "jp": "あ？　ろーりん？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb7"
  },
  {
   "id": "ED_005001:0x27aa4",
   "off": 162468,
   "max": 52,
   "kind": "dialogue",
   "jp": "転がる石に苔は生えない\\nロックの心意気の一つですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb8"
  },
  {
   "id": "ED_005001:0x28260",
   "off": 164448,
   "max": 60,
   "kind": "dialogue",
   "jp": "ま　バカのことだから\\n何にも考えずに\\n言ってるんだろうがな",
   "en": "",
   "op": "0x62",
   "msg": "0x1fb9"
  },
  {
   "id": "ED_005001:0x28a78",
   "off": 166520,
   "max": 28,
   "kind": "dialogue",
   "jp": "トサカくんは\\n天然だからね",
   "en": "",
   "op": "0x62",
   "msg": "0x1fba"
  },
  {
   "id": "ED_005001:0x28f10",
   "off": 167696,
   "max": 44,
   "kind": "dialogue",
   "jp": "それで　桂　それは\\nどういう意味なんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fbb"
  },
  {
   "id": "ED_005001:0x296c4",
   "off": 169668,
   "max": 64,
   "kind": "dialogue",
   "jp": "転がり続ける石に苔が\\n生えないように\\n動き続けろってことだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fbc"
  },
  {
   "id": "ED_005001:0x29c1c",
   "off": 171036,
   "max": 68,
   "kind": "dialogue",
   "jp": "余計なしがらみやいろんな\\nものでロック魂が\\n淀んでしまわないように",
   "en": "",
   "op": "0x62",
   "msg": "0x1fbd"
  },
  {
   "id": "ED_005001:0x29c70",
   "off": 171120,
   "max": 52,
   "kind": "dialogue",
   "jp": "常に挑戦し続けることが\\nロック……\\n確かにそうだね",
   "en": "",
   "op": "0x62",
   "msg": "0x1fbe"
  },
  {
   "id": "ED_005001:0x2a33c",
   "off": 172860,
   "max": 52,
   "kind": "dialogue",
   "jp": "じゃろう？\\nだから　今度は世界に\\n飛び立つんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fbf"
  },
  {
   "id": "ED_005001:0x2aa08",
   "off": 174600,
   "max": 52,
   "kind": "dialogue",
   "jp": "トサカくんって　\\n底知れない　バカ\\nだよねぇ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc0"
  },
  {
   "id": "ED_005001:0x2b0d8",
   "off": 176344,
   "max": 60,
   "kind": "dialogue",
   "jp": "バカは承知だ\\n今度ばかりはオレ様も\\nお前と同じ気持ちだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc1"
  },
  {
   "id": "ED_005001:0x2b8fc",
   "off": 178428,
   "max": 36,
   "kind": "dialogue",
   "jp": "誰も行かなくても\\nオレ様は行くぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc2"
  },
  {
   "id": "ED_005001:0x2c100",
   "off": 180480,
   "max": 28,
   "kind": "dialogue",
   "jp": "龍馬も\\nついて来てもいいぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc3"
  },
  {
   "id": "ED_005001:0x2c630",
   "off": 181808,
   "max": 48,
   "kind": "dialogue",
   "jp": "ついて来るのは\\nシンディの方だと\\n思うぜよー",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc4"
  },
  {
   "id": "ED_005001:0x2cd0c",
   "off": 183564,
   "max": 16,
   "kind": "dialogue",
   "jp": "なんだとーっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc5"
  },
  {
   "id": "ED_005001:0x2d520",
   "off": 185632,
   "max": 16,
   "kind": "dialogue",
   "jp": "待て　俺も行く",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc6"
  },
  {
   "id": "ED_005001:0x2db7c",
   "off": 187260,
   "max": 32,
   "kind": "dialogue",
   "jp": "怖じ気づいたんじゃ\\nねえのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc7"
  },
  {
   "id": "ED_005001:0x2e018",
   "off": 188440,
   "max": 56,
   "kind": "dialogue",
   "jp": "確かにそんな気持ちも\\nある　未知の地は\\n恐ろしいものだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc8"
  },
  {
   "id": "ED_005001:0x2e060",
   "off": 188512,
   "max": 64,
   "kind": "dialogue",
   "jp": "だがここで退いては\\n近藤さんから継いだ\\n新選組の名に傷がつく",
   "en": "",
   "op": "0x62",
   "msg": "0x1fc9"
  },
  {
   "id": "ED_005001:0x2e824",
   "off": 190500,
   "max": 24,
   "kind": "dialogue",
   "jp": "んじゃ　決まりじゃな！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fca"
  },
  {
   "id": "ED_005001:0x2eed4",
   "off": 192212,
   "max": 36,
   "kind": "dialogue",
   "jp": "土方さんが行くなら\\n僕も行こうっと",
   "en": "",
   "op": "0x62",
   "msg": "0x1fcb"
  },
  {
   "id": "ED_005001:0x2f594",
   "off": 193940,
   "max": 32,
   "kind": "dialogue",
   "jp": "で　桂さんは\\nどうするんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fcc"
  },
  {
   "id": "ED_005001:0x2fc50",
   "off": 195664,
   "max": 52,
   "kind": "dialogue",
   "jp": "この流れで私が\\n行かないとか\\nあり得ないでしょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fcd"
  },
  {
   "id": "ED_005001:0x2fc94",
   "off": 195732,
   "max": 36,
   "kind": "dialogue",
   "jp": "あなた達だけでは不安\\nですからねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fce"
  },
  {
   "id": "ED_005001:0x305cc",
   "off": 198092,
   "max": 60,
   "kind": "dialogue",
   "jp": "よっしゃー！\\nこれで海の向こうでも\\n五人で音楽がやれるな！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fcf"
  },
  {
   "id": "ED_005001:0x30f54",
   "off": 200532,
   "max": 16,
   "kind": "dialogue",
   "jp": "ま　待ってくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd0"
  },
  {
   "id": "ED_005001:0x315ac",
   "off": 202156,
   "max": 60,
   "kind": "dialogue",
   "jp": "あっ　ヨッシー\\nすまん！　置いてけぼりに\\nしてしもうたな",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd1"
  },
  {
   "id": "ED_005001:0x31b00",
   "off": 203520,
   "max": 60,
   "kind": "dialogue",
   "jp": "それは構わぬ\\nだが　その旅　予も同行\\nさせてはくれぬか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd2"
  },
  {
   "id": "ED_005001:0x32598",
   "off": 206232,
   "max": 20,
   "kind": "dialogue",
   "jp": "なっ？　慶喜様",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd3"
  },
  {
   "id": "ED_005001:0x32d74",
   "off": 208244,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍馬は先ほど　予は\\nどこにでも行けると言うた",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd4"
  },
  {
   "id": "ED_005001:0x32db4",
   "off": 208308,
   "max": 32,
   "kind": "dialogue",
   "jp": "ならば予も\\n連れて行ってほしい",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd5"
  },
  {
   "id": "ED_005001:0x33574",
   "off": 210292,
   "max": 44,
   "kind": "dialogue",
   "jp": "友と同じ音楽を楽しむ旅を\\n予もしたいのだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd6"
  },
  {
   "id": "ED_005001:0x33d60",
   "off": 212320,
   "max": 24,
   "kind": "dialogue",
   "jp": "ど　どうしましょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd7"
  },
  {
   "id": "ED_005001:0x343c4",
   "off": 213956,
   "max": 48,
   "kind": "dialogue",
   "jp": "どうもこうも……龍馬の\\n答えなら決まってんだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd8"
  },
  {
   "id": "ED_005001:0x34f00",
   "off": 216832,
   "max": 28,
   "kind": "dialogue",
   "jp": "もっちろんぜよーーーっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fd9"
  },
  {
   "id": "ED_005001:0x35754",
   "off": 218964,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ほらな",
   "en": "",
   "op": "0x62",
   "msg": "0x1fda"
  },
  {
   "id": "ED_005001:0x35e04",
   "off": 220676,
   "max": 32,
   "kind": "dialogue",
   "jp": "ヨッシーもわしらの\\n仲間じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fdb"
  },
  {
   "id": "ED_005001:0x35e34",
   "off": 220724,
   "max": 64,
   "kind": "dialogue",
   "jp": "ちゅうわけで　\\nこれからは　ヨッシーを\\nみんなもよろしくな！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fdc"
  },
  {
   "id": "ED_005001:0x36650",
   "off": 222800,
   "max": 24,
   "kind": "dialogue",
   "jp": "……いいのか\\nそれで",
   "en": "",
   "op": "0x62",
   "msg": "0x1fdd"
  },
  {
   "id": "ED_005001:0x36ae4",
   "off": 223972,
   "max": 56,
   "kind": "dialogue",
   "jp": "あはは\\nトサカくん言っても\\n聞かないですよ　土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x1fde"
  },
  {
   "id": "ED_005001:0x37514",
   "off": 226580,
   "max": 56,
   "kind": "dialogue",
   "jp": "そんじゃそうと決まれば\\n海の向こうへ\\n烈　ゴーじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1fdf"
  },
  {
   "id": "ED_005001:0x37dd4",
   "off": 228820,
   "max": 68,
   "kind": "dialogue",
   "jp": "数年後――\\nロックな魂を持つ若者達は\\n大海原の向こうへと\\n旅立った",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe0"
  },
  {
   "id": "ED_005001:0x387c8",
   "off": 231368,
   "max": 36,
   "kind": "dialogue",
   "jp": "俺の歌が聴きたいのならば\\n静まれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe1"
  },
  {
   "id": "ED_005001:0x387fc",
   "off": 231420,
   "max": 40,
   "kind": "dialogue",
   "jp": "今宵はお主達と\\n新選組の蘭出舞の日だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe2"
  },
  {
   "id": "ED_005001:0x38834",
   "off": 231476,
   "max": 52,
   "kind": "dialogue",
   "jp": "俺たちの歌と踊りに\\n酔いしれ……\\n身も心も捧げろ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe3"
  },
  {
   "id": "ED_005001:0x38f00",
   "off": 233216,
   "max": 48,
   "kind": "dialogue",
   "jp": "今日も来て下さって\\n皆さんありがとうございます",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe4"
  },
  {
   "id": "ED_005001:0x38f40",
   "off": 233280,
   "max": 68,
   "kind": "dialogue",
   "jp": "やだなぁそんなにみんなに\\n見られちゃうと\\nちょっと恥ずかしいな……",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe5"
  },
  {
   "id": "ED_005001:0x38f94",
   "off": 233364,
   "max": 64,
   "kind": "dialogue",
   "jp": "ふふ　今日もハートに\\nズッキューンってする歌\\nしちゃいますね～",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe6"
  },
  {
   "id": "ED_005001:0x39670",
   "off": 235120,
   "max": 60,
   "kind": "dialogue",
   "jp": "わたしの声は小さくて\\nまだまだ　世界の皆には\\n届けられない",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe7"
  },
  {
   "id": "ED_005001:0x396bc",
   "off": 235196,
   "max": 52,
   "kind": "dialogue",
   "jp": "でも\\nきっと明日は未来来る！\\nだから　付いてきて",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe8"
  },
  {
   "id": "ED_005001:0x39700",
   "off": 235264,
   "max": 56,
   "kind": "dialogue",
   "jp": "ハイスピードで\\n駆け抜けるよ\\n烈！　ロックンロール",
   "en": "",
   "op": "0x62",
   "msg": "0x1fe9"
  },
  {
   "id": "ED_005001:0x39dd4",
   "off": 237012,
   "max": 60,
   "kind": "dialogue",
   "jp": "ヤバイ　来たぜ来たぜ……\\nオレの中で\\nなんかが雷光した",
   "en": "",
   "op": "0x62",
   "msg": "0x1fea"
  },
  {
   "id": "ED_005001:0x3a328",
   "off": 238376,
   "max": 36,
   "kind": "dialogue",
   "jp": "来い来い来い\\nクールに行くぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1feb"
  },
  {
   "id": "ED_005001:0x3a35c",
   "off": 238428,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレ様の歌で\\nてめーら昇天せてやる",
   "en": "",
   "op": "0x62",
   "msg": "0x1fec"
  },
  {
   "id": "ED_005001:0x3af98",
   "off": 241560,
   "max": 60,
   "kind": "dialogue",
   "jp": "よし！　\\n燃えてきた燃えてきた\\n燃えてきたぜよぉぉぉぉ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fed"
  },
  {
   "id": "ED_005001:0x3afe4",
   "off": 241636,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしの中で\\n何かが迸るんじゃ　",
   "en": "",
   "op": "0x62",
   "msg": "0x1fee"
  },
  {
   "id": "ED_005001:0x3b018",
   "off": 241688,
   "max": 40,
   "kind": "dialogue",
   "jp": "おまんらに届けたいって\\n叫ぶんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1fef"
  },
  {
   "id": "ED_005001:0x3b050",
   "off": 241744,
   "max": 60,
   "kind": "dialogue",
   "jp": "シャウトシャウト\\nシャウトぉぉ　\\nわしの歌を聴くぜよぉ",
   "en": "",
   "op": "0x62",
   "msg": "0x1ff0"
  },
  {
   "id": "ED_005001:0x3bce0",
   "off": 244960,
   "max": 60,
   "kind": "dialogue",
   "jp": "彼らは自らの作り上げた\\nロックを手に世界へと\\n進んでいく",
   "en": "",
   "op": "0x62",
   "msg": "0x1ff1"
  },
  {
   "id": "ED_005001:0x3bd2c",
   "off": 245036,
   "max": 24,
   "kind": "dialogue",
   "jp": "どこまでもどこまでも",
   "en": "",
   "op": "0x62",
   "msg": "0x1ff2"
  },
  {
   "id": "ED_005001:0x3bd54",
   "off": 245076,
   "max": 20,
   "kind": "dialogue",
   "jp": "転がる石のように",
   "en": "",
   "op": "0x62",
   "msg": "0x1ff3"
  }
 ]
}
