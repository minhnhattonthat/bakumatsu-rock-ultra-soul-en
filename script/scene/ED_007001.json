{
 "source": "ED_007001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "ED_007001:0x10e8",
   "off": 4328,
   "max": 36,
   "kind": "dialogue",
   "jp": "井伊の天歌に敗れ\\n地に伏した五人",
   "en": "",
   "op": "0x62",
   "msg": "0x58b9"
  },
  {
   "id": "ED_007001:0x111c",
   "off": 4380,
   "max": 68,
   "kind": "dialogue",
   "jp": "魂は天歌と共に\\n天へと散り\\n抜け殻となった体だけが\\nそこにあった",
   "en": "",
   "op": "0x62",
   "msg": "0x58ba"
  },
  {
   "id": "ED_007001:0x1170",
   "off": 4464,
   "max": 44,
   "kind": "dialogue",
   "jp": "天守閣に立つ\\n井伊の影が\\n江戸を覆いつくす",
   "en": "",
   "op": "0x62",
   "msg": "0x58bb"
  },
  {
   "id": "ED_007001:0x19c0",
   "off": 6592,
   "max": 32,
   "kind": "dialogue",
   "jp": "志士共よ\\n貴様らの希望は潰えた",
   "en": "",
   "op": "0x62",
   "msg": "0x58bc"
  },
  {
   "id": "ED_007001:0x19f0",
   "off": 6640,
   "max": 60,
   "kind": "dialogue",
   "jp": "我は宣言しよう\\n新たな世　泰平の世は\\nここから始まるのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x58bd"
  },
  {
   "id": "ED_007001:0x1f44",
   "off": 8004,
   "max": 40,
   "kind": "dialogue",
   "jp": "ふふふ　ははははは\\nハーハッハッハ！",
   "en": "",
   "op": "0x62",
   "msg": "0x58be"
  },
  {
   "id": "ED_007001:0x282c",
   "off": 10284,
   "max": 36,
   "kind": "dialogue",
   "jp": "志士との\\n壮絶な戦いから\\n三年――",
   "en": "",
   "op": "0x62",
   "msg": "0x58bf"
  },
  {
   "id": "ED_007001:0x2c94",
   "off": 11412,
   "max": 12,
   "kind": "dialogue",
   "jp": "直弼ー！",
   "en": "",
   "op": "0x62",
   "msg": "0x58c0"
  },
  {
   "id": "ED_007001:0x333c",
   "off": 13116,
   "max": 28,
   "kind": "dialogue",
   "jp": "慶喜様ー！\\nいかがですか",
   "en": "",
   "op": "0x62",
   "msg": "0x58c1"
  },
  {
   "id": "ED_007001:0x39f4",
   "off": 14836,
   "max": 48,
   "kind": "dialogue",
   "jp": "馬の稽古みたいだよ\\nぐるぐるぐるぐる楽しいよー",
   "en": "",
   "op": "0x62",
   "msg": "0x58c2"
  },
  {
   "id": "ED_007001:0x40c0",
   "off": 16576,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああ　まさしく天使",
   "en": "",
   "op": "0x62",
   "msg": "0x58c3"
  },
  {
   "id": "ED_007001:0x4a8c",
   "off": 19084,
   "max": 32,
   "kind": "dialogue",
   "jp": "あっち\\n今度はあっちに乗ろう！",
   "en": "",
   "op": "0x62",
   "msg": "0x58c4"
  },
  {
   "id": "ED_007001:0x4fc4",
   "off": 20420,
   "max": 68,
   "kind": "dialogue",
   "jp": "おっと　そっちは\\n年齢制限がありますから\\n一緒でないと乗れませんよ",
   "en": "",
   "op": "0x62",
   "msg": "0x58c5"
  },
  {
   "id": "ED_007001:0x5510",
   "off": 21776,
   "max": 24,
   "kind": "dialogue",
   "jp": "直弼ー\\n早く早くー！",
   "en": "",
   "op": "0x62",
   "msg": "0x58c6"
  },
  {
   "id": "ED_007001:0x5aa4",
   "off": 23204,
   "max": 32,
   "kind": "dialogue",
   "jp": "止まる間もなく\\n駆け出す慶喜",
   "en": "",
   "op": "0x62",
   "msg": "0x58c7"
  },
  {
   "id": "ED_007001:0x5ad4",
   "off": 23252,
   "max": 60,
   "kind": "dialogue",
   "jp": "目の前には\\n波のようにうねる線路と\\n山のごとき高さの建物",
   "en": "",
   "op": "0x62",
   "msg": "0x58c8"
  },
  {
   "id": "ED_007001:0x6208",
   "off": 25096,
   "max": 32,
   "kind": "dialogue",
   "jp": "ぎゃー　止めてー\\n直弼ー直弼ー",
   "en": "",
   "op": "0x62",
   "msg": "0x58c9"
  },
  {
   "id": "ED_007001:0x6990",
   "off": 27024,
   "max": 56,
   "kind": "dialogue",
   "jp": "徳川の男子たる者\\nこの程度で音を上げては\\nいけません！",
   "en": "",
   "op": "0x62",
   "msg": "0x58ca"
  },
  {
   "id": "ED_007001:0x6d8c",
   "off": 28044,
   "max": 44,
   "kind": "dialogue",
   "jp": "凄まじい速度で右に左に\\n体が揺さぶられる",
   "en": "",
   "op": "0x62",
   "msg": "0x58cb"
  },
  {
   "id": "ED_007001:0x6dc8",
   "off": 28104,
   "max": 68,
   "kind": "dialogue",
   "jp": "必死に井伊へ\\nしがみつく慶喜\\n井伊の口の端には\\n喜色が浮かんでいる",
   "en": "",
   "op": "0x62",
   "msg": "0x58cc"
  },
  {
   "id": "ED_007001:0x711c",
   "off": 28956,
   "max": 40,
   "kind": "dialogue",
   "jp": "うーわー\\n地面が地面が！\\n空が空が！",
   "en": "",
   "op": "0x62",
   "msg": "0x58cd"
  },
  {
   "id": "ED_007001:0x765c",
   "off": 30300,
   "max": 60,
   "kind": "dialogue",
   "jp": "慶喜様\\n腹部に力を入れるのです\\n天歌を制すもの天地を制す",
   "en": "",
   "op": "0x62",
   "msg": "0x58ce"
  },
  {
   "id": "ED_007001:0x7b1c",
   "off": 31516,
   "max": 12,
   "kind": "dialogue",
   "jp": "直弼～～",
   "en": "",
   "op": "0x62",
   "msg": "0x58cf"
  },
  {
   "id": "ED_007001:0x893c",
   "off": 35132,
   "max": 16,
   "kind": "dialogue",
   "jp": "何よりも……",
   "en": "",
   "op": "0x62",
   "msg": "0x58d0"
  },
  {
   "id": "ED_007001:0x895c",
   "off": 35164,
   "max": 28,
   "kind": "dialogue",
   "jp": "直弼　そなたがいてくれる",
   "en": "",
   "op": "0x62",
   "msg": "0x58d1"
  },
  {
   "id": "ED_007001:0x8df4",
   "off": 36340,
   "max": 8,
   "kind": "dialogue",
   "jp": "慶喜様",
   "en": "",
   "op": "0x62",
   "msg": "0x58d2"
  },
  {
   "id": "ED_007001:0x9380",
   "off": 37760,
   "max": 28,
   "kind": "dialogue",
   "jp": "井伊の傍らへ\\n寄りそう慶喜",
   "en": "",
   "op": "0x62",
   "msg": "0x58d3"
  },
  {
   "id": "ED_007001:0x93ac",
   "off": 37804,
   "max": 56,
   "kind": "dialogue",
   "jp": "ゆっくりと流れる時の中\\n心地よい温もりが\\n二人を包む",
   "en": "",
   "op": "0x62",
   "msg": "0x58d4"
  },
  {
   "id": "ED_007001:0x996c",
   "off": 39276,
   "max": 40,
   "kind": "dialogue",
   "jp": "直弼　これからも\\n予の側に　いておくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x58d5"
  },
  {
   "id": "ED_007001:0x9eac",
   "off": 40620,
   "max": 48,
   "kind": "dialogue",
   "jp": "もちろんです\\n私は慶喜様と共に\\nいつまでも……",
   "en": "",
   "op": "0x62",
   "msg": "0x58d6"
  },
  {
   "id": "ED_007001:0xa3f4",
   "off": 41972,
   "max": 36,
   "kind": "dialogue",
   "jp": "約束だよ！\\nずっと　ずっとだよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x58d7"
  },
  {
   "id": "ED_007001:0xa894",
   "off": 43156,
   "max": 24,
   "kind": "dialogue",
   "jp": "ええ　ずっとおりますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x58d8"
  },
  {
   "id": "ED_007001:0xb234",
   "off": 45620,
   "max": 24,
   "kind": "dialogue",
   "jp": "貴様　何をやっている",
   "en": "",
   "op": "0x62",
   "msg": "0x58d9"
  },
  {
   "id": "ED_007001:0xb6cc",
   "off": 46796,
   "max": 12,
   "kind": "dialogue",
   "jp": "……何とは",
   "en": "",
   "op": "0x62",
   "msg": "0x58da"
  },
  {
   "id": "ED_007001:0xbb54",
   "off": 47956,
   "max": 40,
   "kind": "dialogue",
   "jp": "我らとの契約　徳川の世\\n天歌泰平の世界",
   "en": "",
   "op": "0x62",
   "msg": "0x58db"
  },
  {
   "id": "ED_007001:0xbb90",
   "off": 48016,
   "max": 64,
   "kind": "dialogue",
   "jp": "それを血迷うたか\\n徳川園（ランド）の建設\\n名君慶喜の治世だと？",
   "en": "",
   "op": "0x62",
   "msg": "0x58dc"
  },
  {
   "id": "ED_007001:0xc0ec",
   "off": 49388,
   "max": 16,
   "kind": "dialogue",
   "jp": "ふっ　知らんな",
   "en": "",
   "op": "0x62",
   "msg": "0x58dd"
  },
  {
   "id": "ED_007001:0xc578",
   "off": 50552,
   "max": 16,
   "kind": "dialogue",
   "jp": "な……に……？",
   "en": "",
   "op": "0x62",
   "msg": "0x58de"
  },
  {
   "id": "ED_007001:0xcaa4",
   "off": 51876,
   "max": 64,
   "kind": "dialogue",
   "jp": "我は徳川の世など\\nどうでもいいのだ\\n慶喜様が幸せであれば良い",
   "en": "",
   "op": "0x62",
   "msg": "0x58df"
  },
  {
   "id": "ED_007001:0xcaf4",
   "off": 51956,
   "max": 72,
   "kind": "dialogue",
   "jp": "孤独の淵よりお救いし\\nお守りする\\nあの方の望みを\\n叶えるのが我の望み",
   "en": "",
   "op": "0x62",
   "msg": "0x58e0"
  },
  {
   "id": "ED_007001:0xcfb8",
   "off": 53176,
   "max": 12,
   "kind": "dialogue",
   "jp": "貴様……",
   "en": "",
   "op": "0x62",
   "msg": "0x58e1"
  },
  {
   "id": "ED_007001:0xd37c",
   "off": 54140,
   "max": 40,
   "kind": "dialogue",
   "jp": "怨霊から電光が\\nほとばしり\\n井伊を襲う",
   "en": "",
   "op": "0x62",
   "msg": "0x58e2"
  },
  {
   "id": "ED_007001:0xd3b4",
   "off": 54196,
   "max": 40,
   "kind": "dialogue",
   "jp": "だが電光は\\n体に触れる直前で\\n霧散した",
   "en": "",
   "op": "0x62",
   "msg": "0x58e3"
  },
  {
   "id": "ED_007001:0xd910",
   "off": 55568,
   "max": 8,
   "kind": "dialogue",
   "jp": "何",
   "en": "",
   "op": "0x62",
   "msg": "0x58e4"
  },
  {
   "id": "ED_007001:0xde34",
   "off": 56884,
   "max": 32,
   "kind": "dialogue",
   "jp": "この目を捧げ\\n交わした呪……",
   "en": "",
   "op": "0x62",
   "msg": "0x58e5"
  },
  {
   "id": "ED_007001:0xde64",
   "off": 56932,
   "max": 48,
   "kind": "dialogue",
   "jp": "それだけで　いつまでも\\n我を縛れると思うてか",
   "en": "",
   "op": "0x62",
   "msg": "0x58e6"
  },
  {
   "id": "ED_007001:0xe310",
   "off": 58128,
   "max": 40,
   "kind": "dialogue",
   "jp": "慶喜様への愛の前に\\n貴様の呪など無力",
   "en": "",
   "op": "0x62",
   "msg": "0x58e7"
  },
  {
   "id": "ED_007001:0xe6fc",
   "off": 59132,
   "max": 44,
   "kind": "dialogue",
   "jp": "井伊から放たれた鬼気に\\n怨霊の影がたじろぐ",
   "en": "",
   "op": "0x62",
   "msg": "0x58e8"
  },
  {
   "id": "ED_007001:0xead4",
   "off": 60116,
   "max": 16,
   "kind": "dialogue",
   "jp": "身の程を知れ！",
   "en": "",
   "op": "0x62",
   "msg": "0x58e9"
  },
  {
   "id": "ED_007001:0xeaf4",
   "off": 60148,
   "max": 60,
   "kind": "dialogue",
   "jp": "我こそは井伊直弼\\n慶喜様の大老にして\\n天下を治むる者ぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x58ea"
  },
  {
   "id": "ED_007001:0xf3ac",
   "off": 62380,
   "max": 40,
   "kind": "dialogue",
   "jp": "井伊と怨霊の間で\\n力が光となり交差する",
   "en": "",
   "op": "0x62",
   "msg": "0x58eb"
  },
  {
   "id": "ED_007001:0xf818",
   "off": 63512,
   "max": 20,
   "kind": "dialogue",
   "jp": "ぐごぐごおお……",
   "en": "",
   "op": "0x62",
   "msg": "0x58ec"
  },
  {
   "id": "ED_007001:0xfcac",
   "off": 64684,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぬうん！",
   "en": "",
   "op": "0x62",
   "msg": "0x58ed"
  },
  {
   "id": "ED_007001:0x1046c",
   "off": 66668,
   "max": 36,
   "kind": "dialogue",
   "jp": "轟音が響き渡り\\n光が世界を満たした",
   "en": "",
   "op": "0x62",
   "msg": "0x58ee"
  },
  {
   "id": "ED_007001:0x104a0",
   "off": 66720,
   "max": 52,
   "kind": "dialogue",
   "jp": "光が消えた時\\nそこには瞑目する\\n井伊の姿があった",
   "en": "",
   "op": "0x62",
   "msg": "0x58ef"
  },
  {
   "id": "ED_007001:0x10a78",
   "off": 68216,
   "max": 64,
   "kind": "dialogue",
   "jp": "静かに眠るが良い\\n徳川は……慶喜様の世は\\nこの直弼が引き受けた",
   "en": "",
   "op": "0x62",
   "msg": "0x58f0"
  },
  {
   "id": "ED_007001:0x10f54",
   "off": 69460,
   "max": 56,
   "kind": "dialogue",
   "jp": "徳川の世は\\nこれよりさらに\\n三百年の間\\n続くこととなる",
   "en": "",
   "op": "0x62",
   "msg": "0x58f1"
  },
  {
   "id": "ED_007001:0x10f9c",
   "off": 69532,
   "max": 36,
   "kind": "dialogue",
   "jp": "徳川園（ランド）の\\n世界進出と共に",
   "en": "",
   "op": "0x62",
   "msg": "0x58f2"
  },
  {
   "id": "ED_007001:0x11350",
   "off": 70480,
   "max": 20,
   "kind": "dialogue",
   "jp": "ＢＡＤ　ＥＮＤ…？",
   "en": "",
   "op": "0x62",
   "msg": "0x58f3"
  }
 ]
}
