{
 "source": "ED_008001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "ED_008001:0x10e8",
   "off": 4328,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬があやうく\\n暗殺されかけた\\n丁度その頃",
   "en": "",
   "op": "0x62",
   "msg": "0x5925"
  },
  {
   "id": "ED_008001:0x1460",
   "off": 5216,
   "max": 68,
   "kind": "dialogue",
   "jp": "居酒屋で飲んでいた\\n暗黒桜桃隊たちは\\n店を出て\\n夜風に吹かれていた",
   "en": "",
   "op": "0x62",
   "msg": "0x5926"
  },
  {
   "id": "ED_008001:0x19a4",
   "off": 6564,
   "max": 68,
   "kind": "dialogue",
   "jp": "あー飲んだ飲んだ\\nやっぱりアンタたちと\\n一緒にいるのが最高だわ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5927"
  },
  {
   "id": "ED_008001:0x208c",
   "off": 8332,
   "max": 52,
   "kind": "dialogue",
   "jp": "当然です……\\n私はいつだって\\n姐さんと一緒よ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5928"
  },
  {
   "id": "ED_008001:0x2760",
   "off": 10080,
   "max": 44,
   "kind": "dialogue",
   "jp": "ぁたしも～\\nず～～～っと\\n一緒れぇ～っす☆",
   "en": "",
   "op": "0x62",
   "msg": "0x5929"
  },
  {
   "id": "ED_008001:0x2c1c",
   "off": 11292,
   "max": 56,
   "kind": "dialogue",
   "jp": "その時　一人の男が\\n角を曲がってきて\\nお龍と衝突した",
   "en": "",
   "op": "0x62",
   "msg": "0x592a"
  },
  {
   "id": "ED_008001:0x33f0",
   "off": 13296,
   "max": 12,
   "kind": "dialogue",
   "jp": "あいたっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x592b"
  },
  {
   "id": "ED_008001:0x3a38",
   "off": 14904,
   "max": 24,
   "kind": "dialogue",
   "jp": "くっ\\n邪魔だこの女！",
   "en": "",
   "op": "0x62",
   "msg": "0x592c"
  },
  {
   "id": "ED_008001:0x3f6c",
   "off": 16236,
   "max": 76,
   "kind": "dialogue",
   "jp": "コラ！\\nこんないたいけな少女に\\nぶつかっておいて\\nその言いぐさはなんだい！",
   "en": "",
   "op": "0x62",
   "msg": "0x592d"
  },
  {
   "id": "ED_008001:0x443c",
   "off": 17468,
   "max": 24,
   "kind": "dialogue",
   "jp": "誰がいたいけな少女だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x592e"
  },
  {
   "id": "ED_008001:0x4a28",
   "off": 18984,
   "max": 12,
   "kind": "dialogue",
   "jp": "何を～～",
   "en": "",
   "op": "0x62",
   "msg": "0x592f"
  },
  {
   "id": "ED_008001:0x5370",
   "off": 21360,
   "max": 28,
   "kind": "dialogue",
   "jp": "あっ……\\n姐さん待っ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5930"
  },
  {
   "id": "ED_008001:0x5fb8",
   "off": 24504,
   "max": 20,
   "kind": "dialogue",
   "jp": "どりゃああああ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5931"
  },
  {
   "id": "ED_008001:0x67b8",
   "off": 26552,
   "max": 48,
   "kind": "dialogue",
   "jp": "豪快に\\n剛腕撃（ラリアット）を\\n食らわせるお龍",
   "en": "",
   "op": "0x62",
   "msg": "0x5932"
  },
  {
   "id": "ED_008001:0x6fec",
   "off": 28652,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぐおっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5933"
  },
  {
   "id": "ED_008001:0x7514",
   "off": 29972,
   "max": 76,
   "kind": "dialogue",
   "jp": "……貴様！この俺を誰だと\\n思ってる！たった今人一人\\n殺してきたばかりの……",
   "en": "",
   "op": "0x62",
   "msg": "0x5934"
  },
  {
   "id": "ED_008001:0x800c",
   "off": 32780,
   "max": 12,
   "kind": "dialogue",
   "jp": "知るかー！",
   "en": "",
   "op": "0x62",
   "msg": "0x5935"
  },
  {
   "id": "ED_008001:0x8870",
   "off": 34928,
   "max": 32,
   "kind": "dialogue",
   "jp": "さらに踏みつけ\\n蹴飛ばすお龍",
   "en": "",
   "op": "0x62",
   "msg": "0x5936"
  },
  {
   "id": "ED_008001:0x8e74",
   "off": 36468,
   "max": 24,
   "kind": "dialogue",
   "jp": "だっしゃ～\\nコラー！",
   "en": "",
   "op": "0x62",
   "msg": "0x5937"
  },
  {
   "id": "ED_008001:0x9534",
   "off": 38196,
   "max": 52,
   "kind": "dialogue",
   "jp": "姐さんダメよ……\\nもう暗殺は\\nやめたんだから……",
   "en": "",
   "op": "0x62",
   "msg": "0x5938"
  },
  {
   "id": "ED_008001:0x9bf8",
   "off": 39928,
   "max": 44,
   "kind": "dialogue",
   "jp": "お龍を止める振りして\\nその体をさわる幾松",
   "en": "",
   "op": "0x62",
   "msg": "0x5939"
  },
  {
   "id": "ED_008001:0xa550",
   "off": 42320,
   "max": 40,
   "kind": "dialogue",
   "jp": "くぉら～幾松！\\nどこさわってんだい！",
   "en": "",
   "op": "0x62",
   "msg": "0x593a"
  },
  {
   "id": "ED_008001:0xaa98",
   "off": 43672,
   "max": 64,
   "kind": "dialogue",
   "jp": "ごめんなさい……\\n姐さんの肌があまりにも\\n綺麗なものだから……",
   "en": "",
   "op": "0x62",
   "msg": "0x593b"
  },
  {
   "id": "ED_008001:0xafd0",
   "off": 45008,
   "max": 48,
   "kind": "dialogue",
   "jp": "もう\\n酔ったらすぐ人の体\\nさわるのやめなさい！",
   "en": "",
   "op": "0x62",
   "msg": "0x593c"
  },
  {
   "id": "ED_008001:0xb78c",
   "off": 46988,
   "max": 40,
   "kind": "dialogue",
   "jp": "ぁはは～\\nラメれすよぉ\\n姐さんたちぃ",
   "en": "",
   "op": "0x62",
   "msg": "0x593d"
  },
  {
   "id": "ED_008001:0xb7c4",
   "off": 47044,
   "max": 48,
   "kind": "dialogue",
   "jp": "こんな時はぁ\\nみんなれ歌いましょ～\\nせーのぉ！",
   "en": "",
   "op": "0x62",
   "msg": "0x593e"
  },
  {
   "id": "ED_008001:0xc000",
   "off": 49152,
   "max": 40,
   "kind": "dialogue",
   "jp": "さーくるさーくる～♪\\n君とずっとぉ～♪",
   "en": "",
   "op": "0x62",
   "msg": "0x593f"
  },
  {
   "id": "ED_008001:0xc744",
   "off": 51012,
   "max": 36,
   "kind": "dialogue",
   "jp": "まったく\\nアンタは呑気なんだから",
   "en": "",
   "op": "0x62",
   "msg": "0x5940"
  },
  {
   "id": "ED_008001:0xcf74",
   "off": 53108,
   "max": 24,
   "kind": "dialogue",
   "jp": "さぁ狂ぅさぁ狂ぅ～♪",
   "en": "",
   "op": "0x62",
   "msg": "0x5941"
  },
  {
   "id": "ED_008001:0xd83c",
   "off": 55356,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぐぅぅ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5942"
  },
  {
   "id": "ED_008001:0xdf44",
   "off": 57156,
   "max": 36,
   "kind": "dialogue",
   "jp": "こらおうの！\\n天歌はやめなさい！",
   "en": "",
   "op": "0x62",
   "msg": "0x5943"
  },
  {
   "id": "ED_008001:0xe608",
   "off": 58888,
   "max": 12,
   "kind": "dialogue",
   "jp": "はぁ～ぃ",
   "en": "",
   "op": "0x62",
   "msg": "0x5944"
  },
  {
   "id": "ED_008001:0xee70",
   "off": 61040,
   "max": 56,
   "kind": "dialogue",
   "jp": "ちょっとアンタたち\\n店の外で\\n騒ぐんじゃないわよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5945"
  },
  {
   "id": "ED_008001:0xf55c",
   "off": 62812,
   "max": 12,
   "kind": "dialogue",
   "jp": "おわっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5946"
  },
  {
   "id": "ED_008001:0xfccc",
   "off": 64716,
   "max": 108,
   "kind": "dialogue",
   "jp": "店から出てきた\\nお登勢だったが\\n何かにつまずいて\\n男に全体重を乗せた\\n体圧迫（ボディプレス）を\\n見舞った",
   "en": "",
   "op": "0x62",
   "msg": "0x5947"
  },
  {
   "id": "ED_008001:0x10040",
   "off": 65600,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぐほっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5948"
  },
  {
   "id": "ED_008001:0x10610",
   "off": 67088,
   "max": 36,
   "kind": "dialogue",
   "jp": "あら\\nこんなとこで\\n寝てちゃだめよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5949"
  },
  {
   "id": "ED_008001:0x10b50",
   "off": 68432,
   "max": 36,
   "kind": "dialogue",
   "jp": "ん？　ちょっといい\\n男じゃないの",
   "en": "",
   "op": "0x62",
   "msg": "0x594a"
  },
  {
   "id": "ED_008001:0x11088",
   "off": 69768,
   "max": 36,
   "kind": "dialogue",
   "jp": "もう　連れて\\n帰っちゃおうかしら♪",
   "en": "",
   "op": "0x62",
   "msg": "0x594b"
  },
  {
   "id": "ED_008001:0x11614",
   "off": 71188,
   "max": 20,
   "kind": "dialogue",
   "jp": "た……\\n助けて……",
   "en": "",
   "op": "0x62",
   "msg": "0x594c"
  },
  {
   "id": "ED_008001:0x119d8",
   "off": 72152,
   "max": 56,
   "kind": "dialogue",
   "jp": "この不運な男こそ\\n龍馬を狙った暗殺者\\nだったのだが……",
   "en": "",
   "op": "0x62",
   "msg": "0x594d"
  },
  {
   "id": "ED_008001:0x11a20",
   "off": 72224,
   "max": 40,
   "kind": "dialogue",
   "jp": "お龍たちがそれを\\n知る由もなかった……",
   "en": "",
   "op": "0x62",
   "msg": "0x594e"
  },
  {
   "id": "ED_008001:0x11ffc",
   "off": 73724,
   "max": 36,
   "kind": "dialogue",
   "jp": "ほら　気付けのキッスよ\\nむちゅ～～",
   "en": "",
   "op": "0x62",
   "msg": "0x594f"
  },
  {
   "id": "ED_008001:0x12a34",
   "off": 76340,
   "max": 16,
   "kind": "dialogue",
   "jp": "ぎゃあああああ",
   "en": "",
   "op": "0x62",
   "msg": "0x5950"
  }
 ]
}
