   "en": "Me toooo~\\nAlwaysh\\ntogesherrr\\nfo~~~reverrr~",
   "op": "0x62",
   "msg": "0x5929"
  },
  {
   "id": "ED_008001:0x2c1c",
   "off": 11292,
   "max": 56,
   "kind": "dialogue",
   "jp": "その時　一人の男が\\n角を曲がってきて\\nお龍と衝突した",
