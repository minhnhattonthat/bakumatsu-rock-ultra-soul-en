   "msg": "0x592c"
  },
  {
   "id": "ED_008001:0x3f6c",
   "off": 16236,
   "max": 76,
   "kind": "dialogue",
   "jp": "コラ！\\nこんないたいけな少女に\\nぶつかっておいて\\nその言いぐさはなんだい！",
   "en": "Hey! You crash\\ninto an innocent\\nyoung girl and\\nthat's what you've\\ngot to say!?",
