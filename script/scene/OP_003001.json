{
 "source": "OP_003001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "OP_003001:0x129c",
   "off": 4764,
   "max": 88,
   "kind": "dialogue",
   "jp": "太平洋――\\n他国へと繋がるこの大海を\\n荒波も物ともせず突き進む\\n四隻の蒸気船があった",
   "en": "",
   "op": "0x62",
   "msg": "0x4e20"
  },
  {
   "id": "OP_003001:0x1304",
   "off": 4868,
   "max": 68,
   "kind": "dialogue",
   "jp": "その中でも　一際\\n煌びやかな船から\\n派手なギターの音が\\n鳴り響く",
   "en": "",
   "op": "0x62",
   "msg": "0x4e21"
  },
  {
   "id": "OP_003001:0x1ab8",
   "off": 6840,
   "max": 40,
   "kind": "dialogue",
   "jp": "イッツ　ロケンロゥ！\\nゴキゲンな荒波だ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e22"
  },
  {
   "id": "OP_003001:0x21d4",
   "off": 8660,
   "max": 60,
   "kind": "dialogue",
   "jp": "男は一人　船の舳先に立ち\\n逆巻く荒波を楽しげに\\n眺めている",
   "en": "",
   "op": "0x62",
   "msg": "0x4e23"
  },
  {
   "id": "OP_003001:0x2650",
   "off": 9808,
   "max": 56,
   "kind": "dialogue",
   "jp": "だが　どんな荒波よりも\\nオレのロックの方が\\n激しい……",
   "en": "",
   "op": "0x62",
   "msg": "0x4e24"
  },
  {
   "id": "OP_003001:0x2730",
   "off": 10032,
   "max": 64,
   "kind": "dialogue",
   "jp": "どんな障害も　オレを\\n止めることは出来ない\\nそうだろう？　Ｊ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e25"
  },
  {
   "id": "OP_003001:0x2d38",
   "off": 11576,
   "max": 56,
   "kind": "dialogue",
   "jp": "男が振り返ると\\nそこには一人の\\nギタリストが立っていた",
   "en": "",
   "op": "0x62",
   "msg": "0x4e26"
  },
  {
   "id": "OP_003001:0x38c0",
   "off": 14528,
   "max": 32,
   "kind": "dialogue",
   "jp": "そうだとも　Ｊ\\nこのオレ……",
   "en": "",
   "op": "0x62",
   "msg": "0x4e27"
  },
  {
   "id": "OP_003001:0x3c54",
   "off": 15444,
   "max": 84,
   "kind": "dialogue",
   "jp": "マシューカルブレイス\\nペリージュニアの\\n行く手を\\n阻むものなどありはしない",
   "en": "",
   "op": "0x62",
   "msg": "0x4e28"
  },
  {
   "id": "OP_003001:0x46fc",
   "off": 18172,
   "max": 88,
   "kind": "dialogue",
   "jp": "Ｊと呼ばれた男は\\n口を一文字に\\n引き結んだまま\\n一言も発さず\\n代わりにギターを奏でる",
   "en": "",
   "op": "0x62",
   "msg": "0x4e29"
  },
  {
   "id": "OP_003001:0x4af4",
   "off": 19188,
   "max": 52,
   "kind": "dialogue",
   "jp": "オレたちがこれから行く国\\nニッポンは　小さな島国",
   "en": "",
   "op": "0x62",
   "msg": "0x4e2a"
  },
  {
   "id": "OP_003001:0x4b38",
   "off": 19256,
   "max": 48,
   "kind": "dialogue",
   "jp": "我がステイツに比べれば\\nあまりにちっぽけだ……",
   "en": "",
   "op": "0x62",
   "msg": "0x4e2b"
  },
  {
   "id": "OP_003001:0x4c10",
   "off": 19472,
   "max": 64,
   "kind": "dialogue",
   "jp": "オレとお前のロックに\\n魅せられて　たちまち\\n開国しちまうだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x4e2c"
  },
  {
   "id": "OP_003001:0x537c",
   "off": 21372,
   "max": 68,
   "kind": "dialogue",
   "jp": "オレのような\\nロックスターに\\nこんなイージーな任務を\\nやらせるとは",
   "en": "",
   "op": "0x62",
   "msg": "0x4e2d"
  },
  {
   "id": "OP_003001:0x53d0",
   "off": 21456,
   "max": 44,
   "kind": "dialogue",
   "jp": "我が海軍のジジイ共も\\nモウロクしたもんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e2e"
  },
  {
   "id": "OP_003001:0x5910",
   "off": 22800,
   "max": 12,
   "kind": "dialogue",
   "jp": "とはいえ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e2f"
  },
  {
   "id": "OP_003001:0x5d98",
   "off": 23960,
   "max": 84,
   "kind": "dialogue",
   "jp": "ニッポンのガールや\\nレディに　ロックの――\\nいやオレの魅力を\\n教えるのは　楽しみだ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e30"
  },
  {
   "id": "OP_003001:0x6a64",
   "off": 27236,
   "max": 24,
   "kind": "dialogue",
   "jp": "さあ　ショウタイムだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4e31"
  },
  {
   "id": "OP_003001:0x7504",
   "off": 29956,
   "max": 60,
   "kind": "dialogue",
   "jp": "ロックを奏でながら\\n四隻の船は浦賀の港へ\\n突き進んでゆく",
   "en": "",
   "op": "0x62",
   "msg": "0x4e32"
  },
  {
   "id": "OP_003001:0x7550",
   "off": 30032,
   "max": 60,
   "kind": "dialogue",
   "jp": "これが後の世に\\n黒船来航と呼ばれる\\n出来事の始まりだった",
   "en": "",
   "op": "0x62",
   "msg": "0x4e33"
  },
  {
   "id": "OP_003001:0x7f74",
   "off": 32628,
   "max": 52,
   "kind": "dialogue",
   "jp": "オーライ！　ハニーたち\\nオレのロック　感じてる？",
   "en": "",
   "op": "0x62",
   "msg": "0x4e34"
  },
  {
   "id": "OP_003001:0x85e0",
   "off": 34272,
   "max": 56,
   "kind": "dialogue",
   "jp": "みんなの鼓動が\\nオレのハートを高鳴らせる\\n最高の気分だ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e35"
  },
  {
   "id": "OP_003001:0x8db4",
   "off": 36276,
   "max": 16,
   "kind": "dialogue",
   "jp": "愛してるぜ……",
   "en": "",
   "op": "0x62",
   "msg": "0x4e36"
  },
  {
   "id": "OP_003001:0x95c8",
   "off": 38344,
   "max": 36,
   "kind": "dialogue",
   "jp": "オッケー　オッケー\\n大体オッケー",
   "en": "",
   "op": "0x62",
   "msg": "0x4e37"
  },
  {
   "id": "OP_003001:0x9be8",
   "off": 39912,
   "max": 60,
   "kind": "dialogue",
   "jp": "ジュニアが\\n一声かけるたびに\\n会場一杯に\\n黄色い声が響く",
   "en": "",
   "op": "0x62",
   "msg": "0x4e38"
  },
  {
   "id": "OP_003001:0xa1ac",
   "off": 41388,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああっ\\nジュニア様ってば\\nなんて激しいの",
   "en": "",
   "op": "0x62",
   "msg": "0x4e39"
  },
  {
   "id": "OP_003001:0xa654",
   "off": 42580,
   "max": 60,
   "kind": "dialogue",
   "jp": "それにあの\\n甘い言葉（トーク）……\\n胸がキュンとしちゃう",
   "en": "",
   "op": "0x62",
   "msg": "0x4e3a"
  },
  {
   "id": "OP_003001:0xab0c",
   "off": 43788,
   "max": 48,
   "kind": "dialogue",
   "jp": "こんな凄い雷舞\\n今まで体験したこと\\n無いわ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4e3b"
  },
  {
   "id": "OP_003001:0xb430",
   "off": 46128,
   "max": 36,
   "kind": "dialogue",
   "jp": "もう　新選組から\\n乗り換えちゃう！",
   "en": "",
   "op": "0x62",
   "msg": "0x4e3c"
  },
  {
   "id": "OP_003001:0xbaf0",
   "off": 47856,
   "max": 52,
   "kind": "dialogue",
   "jp": "ドキドキが止まらないの！\\n本物って感じがするわ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4e3d"
  },
  {
   "id": "OP_003001:0xc38c",
   "off": 50060,
   "max": 52,
   "kind": "dialogue",
   "jp": "ハニーたち\\nわかってるね\\nオレのロックこそ本物だ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e3e"
  },
  {
   "id": "OP_003001:0xc3d0",
   "off": 50128,
   "max": 60,
   "kind": "dialogue",
   "jp": "史上最高のオレが\\n目の前にいるんだ\\n興奮するのは仕方ない",
   "en": "",
   "op": "0x62",
   "msg": "0x4e3f"
  },
  {
   "id": "OP_003001:0xca8c",
   "off": 51852,
   "max": 40,
   "kind": "dialogue",
   "jp": "だけど\\n今日は君だけの\\nオレでいよう",
   "en": "",
   "op": "0x62",
   "msg": "0x4e40"
  },
  {
   "id": "OP_003001:0xd39c",
   "off": 54172,
   "max": 64,
   "kind": "dialogue",
   "jp": "きゃあああっ\\n私に話しかけてくれたわっ\\nああっ　失神しそう……",
   "en": "",
   "op": "0x62",
   "msg": "0x4e41"
  },
  {
   "id": "OP_003001:0xdb00",
   "off": 56064,
   "max": 60,
   "kind": "dialogue",
   "jp": "オレの熱い\\nラブ アンド パッションを\\nレディたちに捧げよう",
   "en": "",
   "op": "0x62",
   "msg": "0x4e42"
  },
  {
   "id": "OP_003001:0xe478",
   "off": 58488,
   "max": 60,
   "kind": "dialogue",
   "jp": "あぁん　あんなことを\\n言われたら\\n私　溶けちゃいそう……",
   "en": "",
   "op": "0x62",
   "msg": "0x4e43"
  },
  {
   "id": "OP_003001:0xe938",
   "off": 59704,
   "max": 48,
   "kind": "dialogue",
   "jp": "ステキ……\\nもうジュニア様しか\\n見えないわ♪",
   "en": "",
   "op": "0x62",
   "msg": "0x4e44"
  },
  {
   "id": "OP_003001:0xf240",
   "off": 62016,
   "max": 48,
   "kind": "dialogue",
   "jp": "レディたちは　オレだけを\\n見つめていればいい",
   "en": "",
   "op": "0x62",
   "msg": "0x4e45"
  },
  {
   "id": "OP_003001:0xf280",
   "off": 62080,
   "max": 72,
   "kind": "dialogue",
   "jp": "レディたちの熱い想いを\\nオレのロックで数百倍に\\nして返してみせよう！",
   "en": "",
   "op": "0x62",
   "msg": "0x4e46"
  },
  {
   "id": "OP_003001:0xfc0c",
   "off": 64524,
   "max": 64,
   "kind": "dialogue",
   "jp": "くそ　いつも女ばかり\\nひいきにしやがって\\n男の方は見もしねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e47"
  },
  {
   "id": "OP_003001:0x103dc",
   "off": 66524,
   "max": 24,
   "kind": "dialogue",
   "jp": "おっと\\n言い忘れてた",
   "en": "",
   "op": "0x62",
   "msg": "0x4e48"
  },
  {
   "id": "OP_003001:0x1049c",
   "off": 66716,
   "max": 56,
   "kind": "dialogue",
   "jp": "三階席のゴミ共は\\nオレの視界に入るなよ\\n呼吸もするな",
   "en": "",
   "op": "0x62",
   "msg": "0x4e49"
  },
  {
   "id": "OP_003001:0x10c68",
   "off": 68712,
   "max": 76,
   "kind": "dialogue",
   "jp": "ビンビンに滾った\\nオレのハートが萎える\\nオレのハートは\\nレディたちのものだ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e4a"
  },
  {
   "id": "OP_003001:0x118c0",
   "off": 71872,
   "max": 72,
   "kind": "dialogue",
   "jp": "俺達　男はゴミ扱いかよ！\\nでもジュニアのロック\\nカッコイイんだよな……",
   "en": "",
   "op": "0x62",
   "msg": "0x4e4b"
  },
  {
   "id": "OP_003001:0x11d84",
   "off": 73092,
   "max": 40,
   "kind": "dialogue",
   "jp": "ああ　確かに\\n本場のロックって感じだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e4c"
  },
  {
   "id": "OP_003001:0x12328",
   "off": 74536,
   "max": 104,
   "kind": "dialogue",
   "jp": "男達は文句を言いながらも\\nジュニアの魅力的な\\n音楽には抗えないのか\\n皆　指や肩で\\nリズムを取っている",
   "en": "",
   "op": "0x62",
   "msg": "0x4e4d"
  },
  {
   "id": "OP_003001:0x12798",
   "off": 75672,
   "max": 76,
   "kind": "dialogue",
   "jp": "会場に渦巻くのは\\n熱狂　興奮　感動\\nそれらが熱風のように\\n吹き荒れていた",
   "en": "",
   "op": "0x62",
   "msg": "0x4e4e"
  },
  {
   "id": "OP_003001:0x12ee8",
   "off": 77544,
   "max": 36,
   "kind": "dialogue",
   "jp": "ジュニア様は\\nロックの神様だわ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4e4f"
  },
  {
   "id": "OP_003001:0x13628",
   "off": 79400,
   "max": 64,
   "kind": "dialogue",
   "jp": "まあ　大体そんな感じ\\nオレはロックの申し子\\n神と呼んで問題ない",
   "en": "",
   "op": "0x62",
   "msg": "0x4e50"
  },
  {
   "id": "OP_003001:0x13db4",
   "off": 81332,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x4e51"
  },
  {
   "id": "OP_003001:0x142ec",
   "off": 82668,
   "max": 60,
   "kind": "dialogue",
   "jp": "オーケー　Ｊ\\n当たり前の事なんて\\nわざわざ言うまでもない",
   "en": "",
   "op": "0x62",
   "msg": "0x4e52"
  },
  {
   "id": "OP_003001:0x14338",
   "off": 82744,
   "max": 60,
   "kind": "dialogue",
   "jp": "オレの最高のロックを\\nもっと聴かせてやれって\\n言うんだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x4e53"
  },
  {
   "id": "OP_003001:0x14f48",
   "off": 85832,
   "max": 72,
   "kind": "dialogue",
   "jp": "ええっ　Ｊ様は喋って\\nないのに　ジュニア様は\\n言ってることが分かるの？",
   "en": "",
   "op": "0x62",
   "msg": "0x4e54"
  },
  {
   "id": "OP_003001:0x1540c",
   "off": 87052,
   "max": 68,
   "kind": "dialogue",
   "jp": "知らなかった？\\nジュニア様は彼がギターを\\n鳴らすだけで理解できるの",
   "en": "",
   "op": "0x62",
   "msg": "0x4e55"
  },
  {
   "id": "OP_003001:0x15e68",
   "off": 89704,
   "max": 68,
   "kind": "dialogue",
   "jp": "そう　オレとＪの間に\\n余計な言葉は不要さ\\n音楽があれば大体オッケー",
   "en": "",
   "op": "0x62",
   "msg": "0x4e56"
  },
  {
   "id": "OP_003001:0x15ebc",
   "off": 89788,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうだろう　Ｊ？",
   "en": "",
   "op": "0x62",
   "msg": "0x4e57"
  },
  {
   "id": "OP_003001:0x16458",
   "off": 91224,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x4e58"
  },
  {
   "id": "OP_003001:0x16fb8",
   "off": 94136,
   "max": 52,
   "kind": "dialogue",
   "jp": "すげぇな……\\nやっぱこいつらは\\nただ者じゃないぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e59"
  },
  {
   "id": "OP_003001:0x1785c",
   "off": 96348,
   "max": 56,
   "kind": "dialogue",
   "jp": "さあ　レディたち\\nトークは終了だ\\nまた熱く狂ってくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e5a"
  },
  {
   "id": "OP_003001:0x178a4",
   "off": 96420,
   "max": 44,
   "kind": "dialogue",
   "jp": "次の歌もここに咲く\\nレディたちへ捧げよう！",
   "en": "",
   "op": "0x62",
   "msg": "0x4e5b"
  },
  {
   "id": "OP_003001:0x181e4",
   "off": 98788,
   "max": 76,
   "kind": "dialogue",
   "jp": "ホットでスパイシーな\\nオレのラブを受け止めろ！\\nイッツ　ロケンロゥーッ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4e5c"
  },
  {
   "id": "OP_003001:0x18a6c",
   "off": 100972,
   "max": 64,
   "kind": "dialogue",
   "jp": "『泰平の　眠りを覚ます\\n神ロック　たつた一曲で\\n夜も眠れず』",
   "en": "",
   "op": "0x62",
   "msg": "0x4e5d"
  },
  {
   "id": "OP_003001:0x18ce4",
   "off": 101604,
   "max": 88,
   "kind": "dialogue",
   "jp": "ジュニアがもたらした\\n本場のロックは\\n一曲聴いただけで\\n眠れないほど\\n興奮すると言われ",
   "en": "",
   "op": "0x62",
   "msg": "0x4e5e"
  },
  {
   "id": "OP_003001:0x18f74",
   "off": 102260,
   "max": 32,
   "kind": "dialogue",
   "jp": "瞬く間に\\n民衆へと知れ渡った",
   "en": "",
   "op": "0x62",
   "msg": "0x4e5f"
  },
  {
   "id": "OP_003001:0x1931c",
   "off": 103196,
   "max": 60,
   "kind": "dialogue",
   "jp": "その人気はやがて\\n日本中を巻き込んで\\nゆくことになる――",
   "en": "",
   "op": "0x62",
   "msg": "0x4e60"
  },
  {
   "id": "OP_003001:0x19368",
   "off": 103272,
   "max": 44,
   "kind": "dialogue",
   "jp": "日本の開国という\\n大いなる野望と共に――",
   "en": "",
   "op": "0x62",
   "msg": "0x4e61"
  }
 ]
}
