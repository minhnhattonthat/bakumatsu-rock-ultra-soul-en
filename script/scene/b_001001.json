{
 "source": "b_001001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_001001:0x10f4",
   "off": 4340,
   "max": 84,
   "kind": "dialogue",
   "jp": "意気揚々と土佐の地を\\n出発した龍馬は\\n京の都で\\n己の実力を試そうと\\n熱く燃えていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2cc4"
  },
  {
   "id": "b_001001:0x1588",
   "off": 5512,
   "max": 44,
   "kind": "dialogue",
   "jp": "まず\\n大舞台の会場に\\n行ってみないとなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2cc5"
  },
  {
   "id": "b_001001:0x1e3c",
   "off": 7740,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x2cc6"
  },
  {
   "id": "b_001001:0x2358",
   "off": 9048,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x2cc7"
  },
  {
   "id": "b_001001:0x2bcc",
   "off": 11212,
   "max": 24,
   "kind": "dialogue",
   "jp": "ここはどこだああぁ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x2cc8"
  },
  {
   "id": "b_001001:0x30f8",
   "off": 12536,
   "max": 28,
   "kind": "dialogue",
   "jp": "そして\\nさっそく迷っていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2cc9"
  },
  {
   "id": "b_001001:0x36ac",
   "off": 13996,
   "max": 56,
   "kind": "dialogue",
   "jp": "そ　そもそも\\n道がまっすぐだらけで\\n店も似すぎぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2cca"
  },
  {
   "id": "b_001001:0x3bfc",
   "off": 15356,
   "max": 116,
   "kind": "dialogue",
   "jp": "碁盤の目になった\\n京の町並みは\\n土佐から出てきたばかりの\\n龍馬にとって\\nどこも同じに見え\\n難解な迷路となっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2ccb"
  },
  {
   "id": "b_001001:0x40b0",
   "off": 16560,
   "max": 48,
   "kind": "dialogue",
   "jp": "うう\\nこうしてる内にも\\n大舞台がはじまるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ccc"
  },
  {
   "id": "b_001001:0x4650",
   "off": 18000,
   "max": 32,
   "kind": "dialogue",
   "jp": "どうしたら\\nいいんだぁ～っ ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ccd"
  },
  {
   "id": "b_001001:0x4ef8",
   "off": 20216,
   "max": 56,
   "kind": "dialogue",
   "jp": "急いで帰らねば\\n近藤さんとの約束の\\n時間に遅れてしまう",
   "en": "",
   "op": "0x62",
   "msg": "0x2cce"
  },
  {
   "id": "b_001001:0x53ac",
   "off": 21420,
   "max": 32,
   "kind": "dialogue",
   "jp": "どうしたら\\nいいんだぁ～っ ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ccf"
  },
  {
   "id": "b_001001:0x5d4c",
   "off": 23884,
   "max": 24,
   "kind": "dialogue",
   "jp": "なんだ……？\\n今の声は",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd0"
  },
  {
   "id": "b_001001:0x679c",
   "off": 26524,
   "max": 44,
   "kind": "dialogue",
   "jp": "おお\\nちょうどいいところに\\n人が来たぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd1"
  },
  {
   "id": "b_001001:0x67d8",
   "off": 26584,
   "max": 48,
   "kind": "dialogue",
   "jp": "なぁ　そこの人！\\nわしゃ\\nどうすればいいっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd2"
  },
  {
   "id": "b_001001:0x6d20",
   "off": 27936,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd3"
  },
  {
   "id": "b_001001:0x71a8",
   "off": 29096,
   "max": 24,
   "kind": "dialogue",
   "jp": "突然なんだ\\nこの男は？",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd4"
  },
  {
   "id": "b_001001:0x7a88",
   "off": 31368,
   "max": 32,
   "kind": "dialogue",
   "jp": "わしは行くところが\\nあるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd5"
  },
  {
   "id": "b_001001:0x7ab8",
   "off": 31416,
   "max": 44,
   "kind": "dialogue",
   "jp": "だけど道がわからん！\\nどうすればいいぃ～ ",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd6"
  },
  {
   "id": "b_001001:0x7ffc",
   "off": 32764,
   "max": 36,
   "kind": "dialogue",
   "jp": "……誰かに道を聞けば\\nいいだろう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd7"
  },
  {
   "id": "b_001001:0x87ac",
   "off": 34732,
   "max": 4,
   "kind": "dialogue",
   "jp": " ",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd8"
  },
  {
   "id": "b_001001:0x8cc4",
   "off": 36036,
   "max": 40,
   "kind": "dialogue",
   "jp": "そ　そうか！\\n道を聞けばいいんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2cd9"
  },
  {
   "id": "b_001001:0x9374",
   "off": 37748,
   "max": 8,
   "kind": "dialogue",
   "jp": "…… ",
   "en": "",
   "op": "0x62",
   "msg": "0x2cda"
  },
  {
   "id": "b_001001:0x998c",
   "off": 39308,
   "max": 40,
   "kind": "dialogue",
   "jp": "誰に道を聞けば\\nいいんじゃぁぁ～っ ",
   "en": "",
   "op": "0x62",
   "msg": "0x2cdb"
  },
  {
   "id": "b_001001:0xa288",
   "off": 41608,
   "max": 32,
   "kind": "dialogue",
   "jp": "頭を抱えて\\nわめき始めた……",
   "en": "",
   "op": "0x62",
   "msg": "0x2cdc"
  },
  {
   "id": "b_001001:0xa2b8",
   "off": 41656,
   "max": 52,
   "kind": "dialogue",
   "jp": "……なんだこいつは\\n関わり合いに\\nなりたくないな",
   "en": "",
   "op": "0x62",
   "msg": "0x2cdd"
  },
  {
   "id": "b_001001:0xab3c",
   "off": 43836,
   "max": 20,
   "kind": "dialogue",
   "jp": "あっ！\\nそうだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2cde"
  },
  {
   "id": "b_001001:0xb860",
   "off": 47200,
   "max": 8,
   "kind": "dialogue",
   "jp": "うっ ",
   "en": "",
   "op": "0x62",
   "msg": "0x2cdf"
  },
  {
   "id": "b_001001:0xbce4",
   "off": 48356,
   "max": 44,
   "kind": "dialogue",
   "jp": "あんただ　あんた！\\nちょ～っと　いいかっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce0"
  },
  {
   "id": "b_001001:0xc368",
   "off": 50024,
   "max": 28,
   "kind": "dialogue",
   "jp": "着物の袖を\\n引っ張るな！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce1"
  },
  {
   "id": "b_001001:0xc898",
   "off": 51352,
   "max": 72,
   "kind": "dialogue",
   "jp": "おお　すまんすまん\\nあんたがどこかに行って\\nしまいそうだったからな！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce2"
  },
  {
   "id": "b_001001:0xce6c",
   "off": 52844,
   "max": 32,
   "kind": "dialogue",
   "jp": "逃げ遅れたな……\\n……仕方ない",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce3"
  },
  {
   "id": "b_001001:0xd3a4",
   "off": 54180,
   "max": 16,
   "kind": "dialogue",
   "jp": "それで　何用だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce4"
  },
  {
   "id": "b_001001:0xd830",
   "off": 55344,
   "max": 56,
   "kind": "dialogue",
   "jp": "大舞台をやってる場所\\nまでの道を教えて\\n欲しいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce5"
  },
  {
   "id": "b_001001:0xdd80",
   "off": 56704,
   "max": 16,
   "kind": "dialogue",
   "jp": "大舞台だと？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce6"
  },
  {
   "id": "b_001001:0xe20c",
   "off": 57868,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうじゃ！\\nこっからどうやって\\n行けばいいか知ってるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce7"
  },
  {
   "id": "b_001001:0xe6c4",
   "off": 59076,
   "max": 36,
   "kind": "dialogue",
   "jp": "大舞台を受けるつもりの\\n者か……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce8"
  },
  {
   "id": "b_001001:0xe6f8",
   "off": 59128,
   "max": 52,
   "kind": "dialogue",
   "jp": "だが　紹介状を\\n持っているようには\\n見えないな……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ce9"
  },
  {
   "id": "b_001001:0xec44",
   "off": 60484,
   "max": 48,
   "kind": "dialogue",
   "jp": "大舞台を受けるのではなく\\n雑用に呼ばれた者か？",
   "en": "",
   "op": "0x62",
   "msg": "0x2cea"
  },
  {
   "id": "b_001001:0xf0f0",
   "off": 61680,
   "max": 44,
   "kind": "dialogue",
   "jp": "何にせよ　俺には\\n関わり合いのない\\n者だな",
   "en": "",
   "op": "0x62",
   "msg": "0x2ceb"
  },
  {
   "id": "b_001001:0xf598",
   "off": 62872,
   "max": 32,
   "kind": "dialogue",
   "jp": "大舞台の会場ならば\\n知っている",
   "en": "",
   "op": "0x62",
   "msg": "0x2cec"
  },
  {
   "id": "b_001001:0xfad4",
   "off": 64212,
   "max": 32,
   "kind": "dialogue",
   "jp": "おお　やった！\\n助かるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ced"
  },
  {
   "id": "b_001001:0xff70",
   "off": 65392,
   "max": 24,
   "kind": "dialogue",
   "jp": "この道をまっすぐ進め",
   "en": "",
   "op": "0x62",
   "msg": "0x2cee"
  },
  {
   "id": "b_001001:0x1049c",
   "off": 66716,
   "max": 12,
   "kind": "dialogue",
   "jp": "ほうほう",
   "en": "",
   "op": "0x62",
   "msg": "0x2cef"
  },
  {
   "id": "b_001001:0x10924",
   "off": 67876,
   "max": 24,
   "kind": "dialogue",
   "jp": "そうしたら団子屋がある",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf0"
  },
  {
   "id": "b_001001:0x110c4",
   "off": 69828,
   "max": 72,
   "kind": "dialogue",
   "jp": "そうだ\\n帰りに団子屋で\\n近藤さんへの\\nお土産として\\n団子を買っていこう",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf1"
  },
  {
   "id": "b_001001:0x117a4",
   "off": 71588,
   "max": 48,
   "kind": "dialogue",
   "jp": "それで　団子屋を見たら\\nどうしたらいいぜよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf2"
  },
  {
   "id": "b_001001:0x11e78",
   "off": 73336,
   "max": 44,
   "kind": "dialogue",
   "jp": "近藤さんが好きな団子は\\nなんだったか……",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf3"
  },
  {
   "id": "b_001001:0x12544",
   "off": 75076,
   "max": 44,
   "kind": "dialogue",
   "jp": "おーい　団子屋で\\nわしゃどうすればいい？",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf4"
  },
  {
   "id": "b_001001:0x12c0c",
   "off": 76812,
   "max": 32,
   "kind": "dialogue",
   "jp": "あの菓子の名前は\\nたしか……",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf5"
  },
  {
   "id": "b_001001:0x13144",
   "off": 78148,
   "max": 16,
   "kind": "dialogue",
   "jp": "間借り団子だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf6"
  },
  {
   "id": "b_001001:0x137ec",
   "off": 79852,
   "max": 48,
   "kind": "dialogue",
   "jp": "ほうほう！　曲がる！\\n団子屋で曲がるんじゃな",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf7"
  },
  {
   "id": "b_001001:0x13eb8",
   "off": 81592,
   "max": 36,
   "kind": "dialogue",
   "jp": "ああ　間借り団子を\\n買って帰らねば",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf8"
  },
  {
   "id": "b_001001:0x14574",
   "off": 83316,
   "max": 48,
   "kind": "dialogue",
   "jp": "……頷いてるから\\n曲がっていいんだな……？\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x2cf9"
  },
  {
   "id": "b_001001:0x145b4",
   "off": 83380,
   "max": 40,
   "kind": "dialogue",
   "jp": "そっから　どう行ったら\\nいいんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2cfa"
  },
  {
   "id": "b_001001:0x14dc0",
   "off": 85440,
   "max": 40,
   "kind": "dialogue",
   "jp": "ん？\\nああ大舞台会場への\\n道順だったな",
   "en": "",
   "op": "0x62",
   "msg": "0x2cfb"
  },
  {
   "id": "b_001001:0x15264",
   "off": 86628,
   "max": 44,
   "kind": "dialogue",
   "jp": "この道をまっすぐ行くと\\nいいのだから……",
   "en": "",
   "op": "0x62",
   "msg": "0x2cfc"
  },
  {
   "id": "b_001001:0x1570c",
   "off": 87820,
   "max": 76,
   "kind": "dialogue",
   "jp": "その団子屋を目印にして\\nそこからはまっすぐ歩け\\nその後　突き当たりを右だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2cfd"
  },
  {
   "id": "b_001001:0x15d10",
   "off": 89360,
   "max": 28,
   "kind": "dialogue",
   "jp": "わかったぜよ！\\n助かった！",
   "en": "",
   "op": "0x62",
   "msg": "0x2cfe"
  },
  {
   "id": "b_001001:0x16294",
   "off": 90772,
   "max": 8,
   "kind": "dialogue",
   "jp": "……",
   "en": "",
   "op": "0x62",
   "msg": "0x2cff"
  },
  {
   "id": "b_001001:0x1672c",
   "off": 91948,
   "max": 28,
   "kind": "dialogue",
   "jp": "男はそのまま去って行った",
   "en": "",
   "op": "0x62",
   "msg": "0x2d00"
  },
  {
   "id": "b_001001:0x16d64",
   "off": 93540,
   "max": 40,
   "kind": "dialogue",
   "jp": "口数は少ないが\\n親切な奴だったなあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d01"
  },
  {
   "id": "b_001001:0x16d9c",
   "off": 93596,
   "max": 32,
   "kind": "dialogue",
   "jp": "よぉし！\\nまずは団子屋ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d02"
  },
  {
   "id": "b_001001:0x1724c",
   "off": 94796,
   "max": 32,
   "kind": "dialogue",
   "jp": "龍馬は意気揚々と\\n歩き始めた",
   "en": "",
   "op": "0x62",
   "msg": "0x2d03"
  },
  {
   "id": "b_001001:0x176b4",
   "off": 95924,
   "max": 56,
   "kind": "dialogue",
   "jp": "おかしい……\\n全然突き当たりに\\nたどり着かんぜよ……っ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d04"
  },
  {
   "id": "b_001001:0x176fc",
   "off": 95996,
   "max": 48,
   "kind": "dialogue",
   "jp": "ちゃんと団子屋の角で\\n曲がったはずなんだが……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d05"
  },
  {
   "id": "b_001001:0x1773c",
   "off": 96060,
   "max": 40,
   "kind": "dialogue",
   "jp": "うーん\\nわしは道を間違え\\nたか……？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d06"
  },
  {
   "id": "b_001001:0x18464",
   "off": 99428,
   "max": 8,
   "kind": "dialogue",
   "jp": "わっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d07"
  },
  {
   "id": "b_001001:0x18b84",
   "off": 101252,
   "max": 12,
   "kind": "dialogue",
   "jp": "うひゃっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d08"
  },
  {
   "id": "b_001001:0x1924c",
   "off": 102988,
   "max": 12,
   "kind": "dialogue",
   "jp": "痛～～っ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d09"
  },
  {
   "id": "b_001001:0x198ac",
   "off": 104620,
   "max": 64,
   "kind": "dialogue",
   "jp": "おいこら　そこの奴\\nこの僕にぶつかるとか\\nどういうつもりだよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d0a"
  },
  {
   "id": "b_001001:0x19d68",
   "off": 105832,
   "max": 56,
   "kind": "dialogue",
   "jp": "おおう　すまんぜよ！\\n周りを見てて\\n気づかなかった！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d0b"
  },
  {
   "id": "b_001001:0x1a328",
   "off": 107304,
   "max": 60,
   "kind": "dialogue",
   "jp": "……なんか　こいつ……\\n間抜けな感じが\\nぷんぷんするなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d0c"
  },
  {
   "id": "b_001001:0x1a918",
   "off": 108824,
   "max": 52,
   "kind": "dialogue",
   "jp": "ちょうどいい！\\n大舞台の場所を\\n教えてくれないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d0d"
  },
  {
   "id": "b_001001:0x1ade0",
   "off": 110048,
   "max": 20,
   "kind": "dialogue",
   "jp": "はぁ？　大舞台？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d0e"
  },
  {
   "id": "b_001001:0x1b308",
   "off": 111368,
   "max": 52,
   "kind": "dialogue",
   "jp": "こいつ大舞台を受けるのに\\n僕のことを知らないの？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d0f"
  },
  {
   "id": "b_001001:0x1b7b8",
   "off": 112568,
   "max": 20,
   "kind": "dialogue",
   "jp": "悪いが頼むぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2d10"
  },
  {
   "id": "b_001001:0x1bce0",
   "off": 113888,
   "max": 56,
   "kind": "dialogue",
   "jp": "そりゃあ　きゃーきゃー\\n言われたら\\n鬱陶しいけどさー",
   "en": "",
   "op": "0x62",
   "msg": "0x2d11"
  },
  {
   "id": "b_001001:0x1c6d4",
   "off": 116436,
   "max": 8,
   "kind": "dialogue",
   "jp": "……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d12"
  },
  {
   "id": "b_001001:0x1cfe8",
   "off": 118760,
   "max": 12,
   "kind": "dialogue",
   "jp": "どうした？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d13"
  },
  {
   "id": "b_001001:0x1d510",
   "off": 120080,
   "max": 56,
   "kind": "dialogue",
   "jp": "えっとねぇ～　大舞台は\\nこっちじゃなくて\\nあっちだよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2d14"
  },
  {
   "id": "b_001001:0x1d8f4",
   "off": 121076,
   "max": 48,
   "kind": "dialogue",
   "jp": "道を尋ねた相手は\\n龍馬の進行方向を\\n指さした",
   "en": "",
   "op": "0x62",
   "msg": "0x2d15"
  },
  {
   "id": "b_001001:0x1de04",
   "off": 122372,
   "max": 32,
   "kind": "dialogue",
   "jp": "おりゃ？\\nこっちであってたか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d16"
  },
  {
   "id": "b_001001:0x1e314",
   "off": 123668,
   "max": 20,
   "kind": "dialogue",
   "jp": "うんうん\\nそうそう",
   "en": "",
   "op": "0x62",
   "msg": "0x2d17"
  },
  {
   "id": "b_001001:0x1e8dc",
   "off": 125148,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうかー\\n助かったぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d18"
  },
  {
   "id": "b_001001:0x1e908",
   "off": 125192,
   "max": 40,
   "kind": "dialogue",
   "jp": "それじゃ　わしは急ぐで\\nさらばぜよー",
   "en": "",
   "op": "0x62",
   "msg": "0x2d19"
  },
  {
   "id": "b_001001:0x1edac",
   "off": 126380,
   "max": 24,
   "kind": "dialogue",
   "jp": "はいはい\\nさようなら～",
   "en": "",
   "op": "0x62",
   "msg": "0x2d1a"
  },
  {
   "id": "b_001001:0x1f6bc",
   "off": 128700,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x2d1b"
  },
  {
   "id": "b_001001:0x1f6d8",
   "off": 128728,
   "max": 68,
   "kind": "dialogue",
   "jp": "あっちにあるのは\\n新選組直轄の\\n専門小物（グッズ）屋\\nだ～け～ど～",
   "en": "",
   "op": "0x62",
   "msg": "0x2d1c"
  },
  {
   "id": "b_001001:0x1fc30",
   "off": 130096,
   "max": 76,
   "kind": "dialogue",
   "jp": "でもお店でなら\\n大舞台会場への\\n行き方は聞けるし\\nいいんじゃないかな～？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d1d"
  },
  {
   "id": "b_001001:0x1fd24",
   "off": 130340,
   "max": 72,
   "kind": "dialogue",
   "jp": "ていうか大舞台を受ける\\nつもりなら大先輩の\\n顔くらい覚えてろっつーの",
   "en": "",
   "op": "0x62",
   "msg": "0x2d1e"
  },
  {
   "id": "b_001001:0x20288",
   "off": 131720,
   "max": 32,
   "kind": "dialogue",
   "jp": "新選組一番隊組長である\\nこの僕",
   "en": "",
   "op": "0x62",
   "msg": "0x2d1f"
  },
  {
   "id": "b_001001:0x202b8",
   "off": 131768,
   "max": 32,
   "kind": "dialogue",
   "jp": "――沖田総司の\\n顔くらいはね",
   "en": "",
   "op": "0x62",
   "msg": "0x2d20"
  },
  {
   "id": "b_001001:0x207ec",
   "off": 133100,
   "max": 92,
   "kind": "dialogue",
   "jp": "美しい少年――沖田総司は\\n去っていった男を振り返る\\nこともなくどこぞへと\\n消えたのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x2d21"
  },
  {
   "id": "b_001001:0x20fb4",
   "off": 135092,
   "max": 44,
   "kind": "dialogue",
   "jp": "また違うところに\\n着いた気がするぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d22"
  },
  {
   "id": "b_001001:0x20ff0",
   "off": 135152,
   "max": 48,
   "kind": "dialogue",
   "jp": "新選組の専門小物を\\n売ってる店はあったが……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d23"
  },
  {
   "id": "b_001001:0x218ec",
   "off": 137452,
   "max": 44,
   "kind": "dialogue",
   "jp": "わしが行きたいのは\\n大舞台会場ぜよーー！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d24"
  },
  {
   "id": "b_001001:0x22038",
   "off": 139320,
   "max": 40,
   "kind": "dialogue",
   "jp": "……おや　どうかしたのか\\nそこの兄さん",
   "en": "",
   "op": "0x62",
   "msg": "0x2d25"
  },
  {
   "id": "b_001001:0x22070",
   "off": 139376,
   "max": 44,
   "kind": "dialogue",
   "jp": "大舞台がどうとか\\n言っていた気がするが？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d26"
  },
  {
   "id": "b_001001:0x2252c",
   "off": 140588,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍馬の前に\\nまた新たな男が現れた",
   "en": "",
   "op": "0x62",
   "msg": "0x2d27"
  },
  {
   "id": "b_001001:0x22ad4",
   "off": 142036,
   "max": 60,
   "kind": "dialogue",
   "jp": "いやぁ……\\n何度人に道を聞いても\\n迷子になってしまって……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d28"
  },
  {
   "id": "b_001001:0x22b20",
   "off": 142112,
   "max": 44,
   "kind": "dialogue",
   "jp": "土佐の田舎者には\\n京の町は広すぎるぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d29"
  },
  {
   "id": "b_001001:0x23064",
   "off": 143460,
   "max": 32,
   "kind": "dialogue",
   "jp": "はっはっは\\n気にすることはない",
   "en": "",
   "op": "0x62",
   "msg": "0x2d2a"
  },
  {
   "id": "b_001001:0x23094",
   "off": 143508,
   "max": 44,
   "kind": "dialogue",
   "jp": "俺もこちらに来た当初は\\nよく迷ったものだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d2b"
  },
  {
   "id": "b_001001:0x235d4",
   "off": 144852,
   "max": 12,
   "kind": "dialogue",
   "jp": "そうか！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d2c"
  },
  {
   "id": "b_001001:0x23a5c",
   "off": 146012,
   "max": 60,
   "kind": "dialogue",
   "jp": "それに大舞台に\\n行きたいのなら\\n俺が連れて行ってあげよう",
   "en": "",
   "op": "0x62",
   "msg": "0x2d2d"
  },
  {
   "id": "b_001001:0x24160",
   "off": 147808,
   "max": 12,
   "kind": "dialogue",
   "jp": "なんだと！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d2e"
  },
  {
   "id": "b_001001:0x245e8",
   "off": 148968,
   "max": 40,
   "kind": "dialogue",
   "jp": "そちらに俺も用が\\nあってね　ついでだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d2f"
  },
  {
   "id": "b_001001:0x24b2c",
   "off": 150316,
   "max": 32,
   "kind": "dialogue",
   "jp": "ありがたい！\\n恩に着るぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d30"
  },
  {
   "id": "b_001001:0x24fc8",
   "off": 151496,
   "max": 24,
   "kind": "dialogue",
   "jp": "袖すり合うも多生の縁だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d31"
  },
  {
   "id": "b_001001:0x2545c",
   "off": 152668,
   "max": 16,
   "kind": "dialogue",
   "jp": "助かったぜよー",
   "en": "",
   "op": "0x62",
   "msg": "0x2d32"
  },
  {
   "id": "b_001001:0x258e8",
   "off": 153832,
   "max": 68,
   "kind": "dialogue",
   "jp": "わしゃこのまま迷って\\nたどり着けないんじゃ\\nないかと思ったぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d33"
  },
  {
   "id": "b_001001:0x25e44",
   "off": 155204,
   "max": 16,
   "kind": "dialogue",
   "jp": "では　行こうか",
   "en": "",
   "op": "0x62",
   "msg": "0x2d34"
  },
  {
   "id": "b_001001:0x26368",
   "off": 156520,
   "max": 20,
   "kind": "dialogue",
   "jp": "おう！\\n頼むぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d35"
  },
  {
   "id": "b_001001:0x26908",
   "off": 157960,
   "max": 36,
   "kind": "dialogue",
   "jp": "二人は並んで歩き\\n始めたのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x2d36"
  },
  {
   "id": "b_001001:0x27078",
   "off": 159864,
   "max": 40,
   "kind": "dialogue",
   "jp": "ほら　もうすぐだ\\nこの道の向こうに……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d37"
  },
  {
   "id": "b_001001:0x27654",
   "off": 161364,
   "max": 32,
   "kind": "dialogue",
   "jp": "おおう！　建物が\\n見えたぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d38"
  },
  {
   "id": "b_001001:0x27a20",
   "off": 162336,
   "max": 52,
   "kind": "dialogue",
   "jp": "探しに探した大舞台会場が\\n龍馬の目に飛び込んでくる",
   "en": "",
   "op": "0x62",
   "msg": "0x2d39"
  },
  {
   "id": "b_001001:0x27df4",
   "off": 163316,
   "max": 60,
   "kind": "dialogue",
   "jp": "何かお礼をしたいが\\nわしゃ　今は何も\\n持ってなくてなぁ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d3a"
  },
  {
   "id": "b_001001:0x27f7c",
   "off": 163708,
   "max": 56,
   "kind": "dialogue",
   "jp": "よし！\\n次に会うた時に　あんたに\\n何か礼をするぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d3b"
  },
  {
   "id": "b_001001:0x284cc",
   "off": 165068,
   "max": 32,
   "kind": "dialogue",
   "jp": "それはそれは\\n楽しみなことだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d3c"
  },
  {
   "id": "b_001001:0x28968",
   "off": 166248,
   "max": 44,
   "kind": "dialogue",
   "jp": "では　名乗っておくぜよ\\nわしは　坂も……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d3d"
  },
  {
   "id": "b_001001:0x28eac",
   "off": 167596,
   "max": 32,
   "kind": "dialogue",
   "jp": "いや　名前は聞かないで\\nおこう",
   "en": "",
   "op": "0x62",
   "msg": "0x2d3e"
  },
  {
   "id": "b_001001:0x293e8",
   "off": 168936,
   "max": 12,
   "kind": "dialogue",
   "jp": "ほえっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d3f"
  },
  {
   "id": "b_001001:0x29870",
   "off": 170096,
   "max": 52,
   "kind": "dialogue",
   "jp": "君は大舞台を受けて\\n合格するつもり\\nなのだろう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d40"
  },
  {
   "id": "b_001001:0x29db8",
   "off": 171448,
   "max": 12,
   "kind": "dialogue",
   "jp": "もちろん！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d41"
  },
  {
   "id": "b_001001:0x2a240",
   "off": 172608,
   "max": 52,
   "kind": "dialogue",
   "jp": "では会うべき時が来たら\\n我々は必ず再会するだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x2d42"
  },
  {
   "id": "b_001001:0x2a788",
   "off": 173960,
   "max": 20,
   "kind": "dialogue",
   "jp": "会うべき時……？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d43"
  },
  {
   "id": "b_001001:0x2acb4",
   "off": 175284,
   "max": 8,
   "kind": "dialogue",
   "jp": "ああ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d44"
  },
  {
   "id": "b_001001:0x2b138",
   "off": 176440,
   "max": 48,
   "kind": "dialogue",
   "jp": "そしてその時にこそ\\nお礼をもらうことにしよう",
   "en": "",
   "op": "0x62",
   "msg": "0x2d45"
  },
  {
   "id": "b_001001:0x2b5ec",
   "off": 177644,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしには　よく\\nわからないんだが　\\nそれでいいのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d46"
  },
  {
   "id": "b_001001:0x2bb3c",
   "off": 179004,
   "max": 16,
   "kind": "dialogue",
   "jp": "ああ　いいとも",
   "en": "",
   "op": "0x62",
   "msg": "0x2d47"
  },
  {
   "id": "b_001001:0x2bb5c",
   "off": 179036,
   "max": 48,
   "kind": "dialogue",
   "jp": "そのためには大舞台で\\n必ず合格してくるといい",
   "en": "",
   "op": "0x62",
   "msg": "0x2d48"
  },
  {
   "id": "b_001001:0x2bb9c",
   "off": 179100,
   "max": 40,
   "kind": "dialogue",
   "jp": "君と再会できることを\\n楽しみにしている",
   "en": "",
   "op": "0x62",
   "msg": "0x2d49"
  },
  {
   "id": "b_001001:0x2c24c",
   "off": 180812,
   "max": 64,
   "kind": "dialogue",
   "jp": "わかったぜよ！\\nあんたはわしに　発破を\\nかけてくれたんじゃな！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d4a"
  },
  {
   "id": "b_001001:0x2c7a4",
   "off": 182180,
   "max": 16,
   "kind": "dialogue",
   "jp": "そんなところだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d4b"
  },
  {
   "id": "b_001001:0x2cf6c",
   "off": 184172,
   "max": 36,
   "kind": "dialogue",
   "jp": "さて　俺も用事があるから\\nここで",
   "en": "",
   "op": "0x62",
   "msg": "0x2d4c"
  },
  {
   "id": "b_001001:0x2d40c",
   "off": 185356,
   "max": 52,
   "kind": "dialogue",
   "jp": "おう！\\nではどこかでまた会おう！\\n親切なおっさん！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d4d"
  },
  {
   "id": "b_001001:0x2d8bc",
   "off": 186556,
   "max": 24,
   "kind": "dialogue",
   "jp": "ではな\\n楽しい兄さん！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d4e"
  },
  {
   "id": "b_001001:0x2e34c",
   "off": 189260,
   "max": 36,
   "kind": "dialogue",
   "jp": "ふぅ……！\\nようやく着いたぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2d4f"
  },
  {
   "id": "b_001001:0x2e380",
   "off": 189312,
   "max": 52,
   "kind": "dialogue",
   "jp": "それにしても今日は\\n親切な人に三人も\\n出会ったなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d50"
  },
  {
   "id": "b_001001:0x2e464",
   "off": 189540,
   "max": 28,
   "kind": "dialogue",
   "jp": "わしゃ\\n気分がいいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d51"
  },
  {
   "id": "b_001001:0x2e8fc",
   "off": 190716,
   "max": 44,
   "kind": "dialogue",
   "jp": "うおおおおぉぉぉ～～！\\nがんばるぜよ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d52"
  },
  {
   "id": "b_001001:0x2edb8",
   "off": 191928,
   "max": 64,
   "kind": "dialogue",
   "jp": "大きく叫んだ龍馬は\\n意気揚々と大舞台会場へ\\n向かったのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x2d53"
  },
  {
   "id": "b_001001:0x2ee08",
   "off": 192008,
   "max": 112,
   "kind": "dialogue",
   "jp": "その後　紹介状のない者は\\n駄目だと　門前払いを\\n食らわされる龍馬であったが\\nこのときの彼は\\nまだそれを知らない",
   "en": "",
   "op": "0x62",
   "msg": "0x2d54"
  },
  {
