{
 "source": "b_002001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_002001:0x1558",
   "off": 5464,
   "max": 44,
   "kind": "dialogue",
   "jp": "雨がやむ気配はないですね\\n夜まで降るのかも",
   "en": "",
   "op": "0x62",
   "msg": "0x28d2"
  },
  {
   "id": "b_002001:0x1a74",
   "off": 6772,
   "max": 60,
   "kind": "dialogue",
   "jp": "じっとするのは退屈だし\\nどこかへ出てパッと\\n遊びたいなぁ～",
   "en": "",
   "op": "0x62",
   "msg": "0x28d3"
  },
  {
   "id": "b_002001:0x214c",
   "off": 8524,
   "max": 52,
   "kind": "dialogue",
   "jp": "子供かおまえは\\nわざわざ濡れに行くこたぁ\\nねえだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x28d4"
  },
  {
   "id": "b_002001:0x281c",
   "off": 10268,
   "max": 60,
   "kind": "dialogue",
   "jp": "龍馬くん　退屈だったら\\nヱゲレスの書物でも\\n読みますか？",
   "en": "",
   "op": "0x62",
   "msg": "0x28d5"
  },
  {
   "id": "b_002001:0x2d6c",
   "off": 11628,
   "max": 68,
   "kind": "dialogue",
   "jp": "わしはヱゲレスの書物より\\nヱゲレスの生のロックを\\n聴いてみたいっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x28d6"
  },
  {
   "id": "b_002001:0x344c",
   "off": 13388,
   "max": 36,
   "kind": "dialogue",
   "jp": "どうせエゲレス語が\\n読めねえんだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x28d7"
  },
  {
   "id": "b_002001:0x3c9c",
   "off": 15516,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしだって少しは読めるぞ\\n掘った芋弄るな！　とか",
   "en": "",
   "op": "0x62",
   "msg": "0x28d8"
  },
  {
   "id": "b_002001:0x44a8",
   "off": 17576,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんだそりゃ\\nわけわからねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x28d9"
  },
  {
   "id": "b_002001:0x4b64",
   "off": 19300,
   "max": 60,
   "kind": "dialogue",
   "jp": "そういえば龍馬くんって\\n土佐にいた時はどうしてた\\nのです？",
   "en": "",
   "op": "0x62",
   "msg": "0x28da"
  },
  {
   "id": "b_002001:0x501c",
   "off": 20508,
   "max": 40,
   "kind": "dialogue",
   "jp": "大自然に囲まれて\\n楽しく遊んでたなー",
   "en": "",
   "op": "0x62",
   "msg": "0x28db"
  },
  {
   "id": "b_002001:0x56e0",
   "off": 22240,
   "max": 24,
   "kind": "dialogue",
   "jp": "勉学はしなかったのかよ",
   "en": "",
   "op": "0x62",
   "msg": "0x28dc"
  },
  {
   "id": "b_002001:0x5b74",
   "off": 23412,
   "max": 60,
   "kind": "dialogue",
   "jp": "勉学も剣術もしてたし\\nいっぱいと遊ぶことも\\n忘れんかったな",
   "en": "",
   "op": "0x62",
   "msg": "0x28dd"
  },
  {
   "id": "b_002001:0x624c",
   "off": 25164,
   "max": 60,
   "kind": "dialogue",
   "jp": "土佐の遊びって\\n私達の遊びとは違うのか\\n興味がありますね",
   "en": "",
   "op": "0x62",
   "msg": "0x28de"
  },
  {
   "id": "b_002001:0x679c",
   "off": 26524,
   "max": 64,
   "kind": "dialogue",
   "jp": "よく聞いてくれた\\n土佐の遊びはわいるどで\\nえきさいてぃんぐじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x28df"
  },
  {
   "id": "b_002001:0x6e78",
   "off": 28280,
   "max": 48,
   "kind": "dialogue",
   "jp": "土佐はなーんもねえだろ\\n自然は豊かそうだけどな",
   "en": "",
   "op": "0x62",
   "msg": "0x28e0"
  },
  {
   "id": "b_002001:0x7324",
   "off": 29476,
   "max": 68,
   "kind": "dialogue",
   "jp": "鍾乳洞で探検遊びして\\n中で迷子になって二日ほど\\n迷路を彷徨ったなー",
   "en": "",
   "op": "0x62",
   "msg": "0x28e1"
  },
  {
   "id": "b_002001:0x7b3c",
   "off": 31548,
   "max": 44,
   "kind": "dialogue",
   "jp": "危ないですね……\\nでもよく助かりましたね",
   "en": "",
   "op": "0x62",
   "msg": "0x28e2"
  },
  {
   "id": "b_002001:0x80f0",
   "off": 33008,
   "max": 68,
   "kind": "dialogue",
   "jp": "腹が減って　腹が減って\\nそしたら美味そうな匂いが\\n漂ってきたんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x28e3"
  },
  {
   "id": "b_002001:0x87d0",
   "off": 34768,
   "max": 20,
   "kind": "dialogue",
   "jp": "鍾乳洞の中でか？",
   "en": "",
   "op": "0x62",
   "msg": "0x28e4"
  },
  {
   "id": "b_002001:0x8c60",
   "off": 35936,
   "max": 56,
   "kind": "dialogue",
   "jp": "そうなんじゃ\\nこりゃたまらんと\\n匂いの方へ歩いたんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x28e5"
  },
  {
   "id": "b_002001:0x8d40",
   "off": 36160,
   "max": 76,
   "kind": "dialogue",
   "jp": "なんとそれは鍾乳洞の\\n入り口近くの茶店から漂う\\n団子の匂いだったんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x28e6"
  },
  {
   "id": "b_002001:0x9560",
   "off": 38240,
   "max": 48,
   "kind": "dialogue",
   "jp": "団子の匂いに誘われて\\n助かったってことですか",
   "en": "",
   "op": "0x62",
   "msg": "0x28e7"
  },
  {
   "id": "b_002001:0x9a80",
   "off": 39552,
   "max": 28,
   "kind": "dialogue",
   "jp": "そういうことじゃ\\nわはは",
   "en": "",
   "op": "0x62",
   "msg": "0x28e8"
  },
  {
   "id": "b_002001:0xa270",
   "off": 41584,
   "max": 40,
   "kind": "dialogue",
   "jp": "わははじゃねーだろ\\n動物かよおまえは",
   "en": "",
   "op": "0x62",
   "msg": "0x28e9"
  },
  {
   "id": "b_002001:0xa2a8",
   "off": 41640,
   "max": 60,
   "kind": "dialogue",
   "jp": "松蔭先生も鍾乳洞で\\n迷子になったらしいけど\\n命懸けすぎだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x28ea"
  },
  {
   "id": "b_002001:0xa9f4",
   "off": 43508,
   "max": 60,
   "kind": "dialogue",
   "jp": "土佐の鍾乳洞というと……\\n龍河洞（りゅうがどう）\\nですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x28eb"
  },
  {
   "id": "b_002001:0xaf44",
   "off": 44868,
   "max": 40,
   "kind": "dialogue",
   "jp": "そうじゃ\\nさすがセンセー\\n物知りじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x28ec"
  },
  {
   "id": "b_002001:0xb484",
   "off": 46212,
   "max": 44,
   "kind": "dialogue",
   "jp": "あと　土佐と言えば\\nカツオと鯨が有名ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x28ed"
  },
  {
   "id": "b_002001:0xb9c4",
   "off": 47556,
   "max": 24,
   "kind": "dialogue",
   "jp": "そうじゃ　カツオと鯨！",
   "en": "",
   "op": "0x62",
   "msg": "0x28ee"
  },
  {
   "id": "b_002001:0xb9ec",
   "off": 47596,
   "max": 60,
   "kind": "dialogue",
   "jp": "カツオは旬になると\\n漁船がカツオで真っ黒い\\n山になるんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x28ef"
  },
  {
   "id": "b_002001:0xc1fc",
   "off": 49660,
   "max": 40,
   "kind": "dialogue",
   "jp": "そんなに獲れるのかよ\\n話盛りすぎだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x28f0"
  },
  {
   "id": "b_002001:0xc714",
   "off": 50964,
   "max": 68,
   "kind": "dialogue",
   "jp": "大げさじゃないって\\n船が半分ぐらい沈みかける\\nほどに獲れるんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x28f1"
  },
  {
   "id": "b_002001:0xc768",
   "off": 51048,
   "max": 68,
   "kind": "dialogue",
   "jp": "わしはカツオが好きでな\\n漁から戻ってくるのを\\n心待ちにしてたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x28f2"
  },
  {
   "id": "b_002001:0xcc28",
   "off": 52264,
   "max": 40,
   "kind": "dialogue",
   "jp": "へえ　カツオ漁ってのは\\n網でやるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x28f3"
  },
  {
   "id": "b_002001:0xd0cc",
   "off": 53452,
   "max": 64,
   "kind": "dialogue",
   "jp": "よくぞ聞いてくれた！\\n網なんぞ使わん\\n土佐の漁師は一本釣りじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x28f4"
  },
  {
   "id": "b_002001:0xd624",
   "off": 54820,
   "max": 36,
   "kind": "dialogue",
   "jp": "一本釣りなんて\\n効率が悪くねえか？",
   "en": "",
   "op": "0x62",
   "msg": "0x28f5"
  },
  {
   "id": "b_002001:0xdb5c",
   "off": 56156,
   "max": 64,
   "kind": "dialogue",
   "jp": "カツオは鯨と一緒に\\n泳ぐから網が使えん\\n一本釣りが基本なんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x28f6"
  },
  {
   "id": "b_002001:0xdc44",
   "off": 56388,
   "max": 68,
   "kind": "dialogue",
   "jp": "勇壮な海の男達が\\n竿一本でカツオを釣る！\\n海でもロックなんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x28f7"
  },
  {
   "id": "b_002001:0xe324",
   "off": 58148,
   "max": 64,
   "kind": "dialogue",
   "jp": "素晴らしそうですね\\nカツオの一本釣りは\\n私も見てみたいですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x28f8"
  },
  {
   "id": "b_002001:0xe878",
   "off": 59512,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしも船に乗った\\nことがあるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x28f9"
  },
  {
   "id": "b_002001:0xed18",
   "off": 60696,
   "max": 32,
   "kind": "dialogue",
   "jp": "龍馬くんも\\n釣れたんですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x28fa"
  },
  {
   "id": "b_002001:0xf3b8",
   "off": 62392,
   "max": 64,
   "kind": "dialogue",
   "jp": "でっかいカツオが掛かって\\nわし対カツオの一本勝負に\\nなった！",
   "en": "",
   "op": "0x62",
   "msg": "0x28fb"
  },
  {
   "id": "b_002001:0xf408",
   "off": 62472,
   "max": 76,
   "kind": "dialogue",
   "jp": "ものすごい力で逃げようと\\nするカツオと　釣り上げて\\n食おうとするわしの勝負",
   "en": "",
   "op": "0x62",
   "msg": "0x28fc"
  },
  {
   "id": "b_002001:0xf8d0",
   "off": 63696,
   "max": 24,
   "kind": "dialogue",
   "jp": "カツオは命懸けだからな",
   "en": "",
   "op": "0x62",
   "msg": "0x28fd"
  },
  {
   "id": "b_002001:0xfdfc",
   "off": 65020,
   "max": 72,
   "kind": "dialogue",
   "jp": "あと少しでカツオの鼻面が\\n海面にみえて来た！\\nってところまで頑張った",
   "en": "",
   "op": "0x62",
   "msg": "0x28fe"
  },
  {
   "id": "b_002001:0x105f4",
   "off": 67060,
   "max": 24,
   "kind": "dialogue",
   "jp": "釣り上げたんですね！",
   "en": "",
   "op": "0x62",
   "msg": "0x28ff"
  },
  {
   "id": "b_002001:0x10b20",
   "off": 68384,
   "max": 60,
   "kind": "dialogue",
   "jp": "いや　わしがカツオに\\n釣られて海へドボンじゃ\\nわはははは",
   "en": "",
   "op": "0x62",
   "msg": "0x2900"
  },
  {
   "id": "b_002001:0x11330",
   "off": 70448,
   "max": 48,
   "kind": "dialogue",
   "jp": "そんなこっちゃねーかと\\n思ってたらそのまんまか",
   "en": "",
   "op": "0x62",
   "msg": "0x2901"
  },
  {
   "id": "b_002001:0x11a84",
   "off": 72324,
   "max": 60,
   "kind": "dialogue",
   "jp": "海に落ちたわしを\\n漁師が一本釣りで\\n釣り上げてくれてなー",
   "en": "",
   "op": "0x62",
   "msg": "0x2902"
  },
  {
   "id": "b_002001:0x11ad0",
   "off": 72400,
   "max": 68,
   "kind": "dialogue",
   "jp": "さすが土佐の漁師\\nわしの帯に張りを引っかけ\\n釣り上げたってわけじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x2903"
  },
  {
   "id": "b_002001:0x121b0",
   "off": 74160,
   "max": 68,
   "kind": "dialogue",
   "jp": "すごい体験です　龍馬くん\\nヱゲレスの本よりも\\nドキドキしますよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2904"
  },
  {
   "id": "b_002001:0x12708",
   "off": 75528,
   "max": 56,
   "kind": "dialogue",
   "jp": "わははは\\n土佐の子供はわいるどで\\nえきさいてぃんぐ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2905"
  },
  {
   "id": "b_002001:0x12750",
   "off": 75600,
   "max": 44,
   "kind": "dialogue",
   "jp": "あと　わしは鯨に飲まれた\\nことがあるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2906"
  },
  {
   "id": "b_002001:0x12dcc",
   "off": 77260,
   "max": 44,
   "kind": "dialogue",
   "jp": "ええっ \\n鯨って人を食べないはず\\nですけど",
   "en": "",
   "op": "0x62",
   "msg": "0x2907"
  },
  {
   "id": "b_002001:0x134b8",
   "off": 79032,
   "max": 32,
   "kind": "dialogue",
   "jp": "それが食われたんじゃ\\nセンセー",
   "en": "",
   "op": "0x62",
   "msg": "0x2908"
  },
  {
   "id": "b_002001:0x136ec",
   "off": 79596,
   "max": 56,
   "kind": "dialogue",
   "jp": "でっかい鯨に\\nぱくっと飲まれて\\n死ぬかと思ったぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2909"
  },
  {
   "id": "b_002001:0x13e34",
   "off": 81460,
   "max": 20,
   "kind": "dialogue",
   "jp": "ウソつけ　この野郎",
   "en": "",
   "op": "0x62",
   "msg": "0x290a"
  },
  {
   "id": "b_002001:0x143e0",
   "off": 82912,
   "max": 52,
   "kind": "dialogue",
   "jp": "ウソじゃないって\\nガチで恐ろしい目に\\n遭ったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x290b"
  },
  {
   "id": "b_002001:0x1455c",
   "off": 83292,
   "max": 60,
   "kind": "dialogue",
   "jp": "今思い出しても\\n背筋がゾクゾクする\\n恐ろしい体験だった～",
   "en": "",
   "op": "0x62",
   "msg": "0x290c"
  },
  {
   "id": "b_002001:0x14e14",
   "off": 85524,
   "max": 52,
   "kind": "dialogue",
   "jp": "詳しく話して下さい\\n龍馬くん\\nすごく興味があります",
   "en": "",
   "op": "0x62",
   "msg": "0x290d"
  },
  {
   "id": "b_002001:0x15650",
   "off": 87632,
   "max": 40,
   "kind": "dialogue",
   "jp": "おいおい　桂さんよ\\n本気にしてるのか",
   "en": "",
   "op": "0x62",
   "msg": "0x290e"
  },
  {
   "id": "b_002001:0x15fc8",
   "off": 90056,
   "max": 20,
   "kind": "dialogue",
   "jp": "まあシンディも聞け",
   "en": "",
   "op": "0x62",
   "msg": "0x290f"
  },
  {
   "id": "b_002001:0x15fec",
   "off": 90092,
   "max": 44,
   "kind": "dialogue",
   "jp": "ありゃあ　わしがまだ\\n五つか六つの頃だった",
   "en": "",
   "op": "0x62",
   "msg": "0x2910"
  },
  {
   "id": "b_002001:0x16028",
   "off": 90152,
   "max": 60,
   "kind": "dialogue",
   "jp": "今日は大漁じゃという\\n知らせを聞いて\\n港へ見に行ったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2911"
  },
  {
   "id": "b_002001:0x16aa0",
   "off": 92832,
   "max": 48,
   "kind": "dialogue",
   "jp": "そういう知らせが届く\\nようになっているんですか",
   "en": "",
   "op": "0x62",
   "msg": "0x2912"
  },
  {
   "id": "b_002001:0x16f4c",
   "off": 94028,
   "max": 68,
   "kind": "dialogue",
   "jp": "漁港が近いしな　近所に\\n漁師さんが住んでいて\\n家族に話が届くぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2913"
  },
  {
   "id": "b_002001:0x17038",
   "off": 94264,
   "max": 60,
   "kind": "dialogue",
   "jp": "港へ駆けつけたら\\nでっかい鯨がいくつも\\n揚がっていたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2914"
  },
  {
   "id": "b_002001:0x17084",
   "off": 94340,
   "max": 60,
   "kind": "dialogue",
   "jp": "こりゃでかい鯨だ\\n大人でもひと飲みに\\nするだろうと思ってな",
   "en": "",
   "op": "0x62",
   "msg": "0x2915"
  },
  {
   "id": "b_002001:0x17710",
   "off": 96016,
   "max": 36,
   "kind": "dialogue",
   "jp": "そんなに大きな鯨が\\n揚がるんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x2916"
  },
  {
   "id": "b_002001:0x17bb0",
   "off": 97200,
   "max": 52,
   "kind": "dialogue",
   "jp": "そりゃあもう\\n一人ではとうてい\\n食えん大きさじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2917"
  },
  {
   "id": "b_002001:0x1842c",
   "off": 99372,
   "max": 68,
   "kind": "dialogue",
   "jp": "どこの世界に鯨一頭\\n一人で食う奴がいるんだよ\\n大人でも無理だろうが",
   "en": "",
   "op": "0x62",
   "msg": "0x2918"
  },
  {
   "id": "b_002001:0x18b0c",
   "off": 101132,
   "max": 56,
   "kind": "dialogue",
   "jp": "そうですか？\\n干し肉にすれば\\nしばらく保存できますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2919"
  },
  {
   "id": "b_002001:0x18fc0",
   "off": 102336,
   "max": 44,
   "kind": "dialogue",
   "jp": "あのなあ　桂さん\\n食い終わる前に飽きるだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x291a"
  },
  {
   "id": "b_002001:0x196f8",
   "off": 104184,
   "max": 64,
   "kind": "dialogue",
   "jp": "わはは\\nセンセーは天然入ってる\\nから　シンディも\\n苦労するなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x291b"
  },
  {
   "id": "b_002001:0x19cf0",
   "off": 105712,
   "max": 52,
   "kind": "dialogue",
   "jp": "天然のおまえが言うな！\\n桂さんも何か言ってやれよ",
   "en": "",
   "op": "0x62",
   "msg": "0x291c"
  },
  {
   "id": "b_002001:0x1a3c0",
   "off": 107456,
   "max": 44,
   "kind": "dialogue",
   "jp": "んー　だから龍馬くんと\\n息が合うんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x291d"
  },
  {
   "id": "b_002001:0x1aab0",
   "off": 109232,
   "max": 64,
   "kind": "dialogue",
   "jp": "なんかもう　どうでも\\nよくなってくるような\\n反応だな　桂さんよ",
   "en": "",
   "op": "0x62",
   "msg": "0x291e"
  },
  {
   "id": "b_002001:0x1b008",
   "off": 110600,
   "max": 68,
   "kind": "dialogue",
   "jp": "それで龍馬くん\\nどうして鯨に飲まれたのか\\n聞かせてもらいたいです",
   "en": "",
   "op": "0x62",
   "msg": "0x291f"
  },
  {
   "id": "b_002001:0x1b920",
   "off": 112928,
   "max": 68,
   "kind": "dialogue",
   "jp": "そうそう　その話！\\n鯨の中でも一番でかい奴の\\n鼻面に近付いた時だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2920"
  },
  {
   "id": "b_002001:0x1b974",
   "off": 113012,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしの背丈を超える口が\\nがばーっと開いたんぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2921"
  },
  {
   "id": "b_002001:0x1b9b8",
   "off": 113080,
   "max": 64,
   "kind": "dialogue",
   "jp": "こりゃいかん　食われると\\n思って逃げようとした\\nその時じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2922"
  },
  {
   "id": "b_002001:0x1be74",
   "off": 114292,
   "max": 24,
   "kind": "dialogue",
   "jp": "ドキドキしますね　晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x2923"
  },
  {
   "id": "b_002001:0x1c660",
   "off": 116320,
   "max": 56,
   "kind": "dialogue",
   "jp": "話半分に聞いてろよ\\n桂さんは\\nで　どうなったんだよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2924"
  },
  {
   "id": "b_002001:0x1cb88",
   "off": 117640,
   "max": 60,
   "kind": "dialogue",
   "jp": "わしの足が縄に絡まって\\n動けんところを\\n鯨の口がぱくっと！",
   "en": "",
   "op": "0x62",
   "msg": "0x2925"
  },
  {
   "id": "b_002001:0x1d260",
   "off": 119392,
   "max": 28,
   "kind": "dialogue",
   "jp": "うわー\\nそれは怖いですね",
   "en": "",
   "op": "0x62",
   "msg": "0x2926"
  },
  {
   "id": "b_002001:0x1d790",
   "off": 120720,
   "max": 64,
   "kind": "dialogue",
   "jp": "頭から飲まれたんじゃ\\nまともに息も出来んし\\n恐ろしかった……",
   "en": "",
   "op": "0x62",
   "msg": "0x2927"
  },
  {
   "id": "b_002001:0x1dce8",
   "off": 122088,
   "max": 36,
   "kind": "dialogue",
   "jp": "鯨の口の中って\\n想像も出来ませんね",
   "en": "",
   "op": "0x62",
   "msg": "0x2928"
  },
  {
   "id": "b_002001:0x1e220",
   "off": 123424,
   "max": 40,
   "kind": "dialogue",
   "jp": "口の中が生臭くて\\nそりゃあもう臭い臭い",
   "en": "",
   "op": "0x62",
   "msg": "0x2929"
  },
  {
   "id": "b_002001:0x1e8e4",
   "off": 125156,
   "max": 68,
   "kind": "dialogue",
   "jp": "あたりまえだろ\\nというか息できないのに\\nなんで匂いがわかるんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x292a"
  },
  {
   "id": "b_002001:0x1ee3c",
   "off": 126524,
   "max": 40,
   "kind": "dialogue",
   "jp": "逃げ出した時に\\n着物が臭かったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x292b"
  },
  {
   "id": "b_002001:0x1f500",
   "off": 128256,
   "max": 48,
   "kind": "dialogue",
   "jp": "私の興味はそこですよ\\nどうやって助かったんです",
   "en": "",
   "op": "0x62",
   "msg": "0x292c"
  },
  {
   "id": "b_002001:0x1fa44",
   "off": 129604,
   "max": 36,
   "kind": "dialogue",
   "jp": "不幸中の幸いか\\n腹の中に先客がいた",
   "en": "",
   "op": "0x62",
   "msg": "0x292d"
  },
  {
   "id": "b_002001:0x2012c",
   "off": 131372,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬くんの他にも\\n飲まれた人がいましたか！",
   "en": "",
   "op": "0x62",
   "msg": "0x292e"
  },
  {
   "id": "b_002001:0x2066c",
   "off": 132716,
   "max": 68,
   "kind": "dialogue",
   "jp": "ごっつい刃物を持った\\n漁師のおっさんが\\n腹の中を切り始めたんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x292f"
  },
  {
   "id": "b_002001:0x206c0",
   "off": 132800,
   "max": 52,
   "kind": "dialogue",
   "jp": "鯨が痛がって暴れたんで\\nわしは吐き出されたんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x2930"
  },
  {
   "id": "b_002001:0x20db8",
   "off": 134584,
   "max": 52,
   "kind": "dialogue",
   "jp": "すごい体験です　龍馬くん\\n私も体験してみたいです",
   "en": "",
   "op": "0x62",
   "msg": "0x2931"
  },
  {
   "id": "b_002001:0x20dfc",
   "off": 134652,
   "max": 48,
   "kind": "dialogue",
   "jp": "ねえ晋作　紀州に行けば\\n鯨漁を見られますよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x2932"
  },
  {
   "id": "b_002001:0x21600",
   "off": 136704,
   "max": 64,
   "kind": "dialogue",
   "jp": "あのなあ　桂さん\\n龍馬の話を鵜呑みにするな\\nよ～く考えてみろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2933"
  },
  {
   "id": "b_002001:0x21650",
   "off": 136784,
   "max": 60,
   "kind": "dialogue",
   "jp": "漁港に揚げられた鯨が\\n生きてると思うか？\\n暴れて大変だぞ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2934"
  },
  {
   "id": "b_002001:0x21c18",
   "off": 138264,
   "max": 68,
   "kind": "dialogue",
   "jp": "ああ　そういえばそうです\\n鯨はとどめを刺してから\\n陸に運ぶんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x2935"
  },
  {
   "id": "b_002001:0x220d8",
   "off": 139480,
   "max": 44,
   "kind": "dialogue",
   "jp": "だからよ　龍馬の話は\\n嘘っぱちだってんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2936"
  },
  {
   "id": "b_002001:0x2261c",
   "off": 140828,
   "max": 24,
   "kind": "dialogue",
   "jp": "でも鯨に飲まれたって",
   "en": "",
   "op": "0x62",
   "msg": "0x2937"
  },
  {
   "id": "b_002001:0x22ccc",
   "off": 142540,
   "max": 56,
   "kind": "dialogue",
   "jp": "わははは……\\n正直言うと　ちょっぴり\\n話を盛ったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x2938"
  },
  {
   "id": "b_002001:0x22d14",
   "off": 142612,
   "max": 72,
   "kind": "dialogue",
   "jp": "本当は漁師のおっさん達が\\n面白がって　わしを\\n鯨の口へ放り込んだんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2939"
  },
  {
   "id": "b_002001:0x22d6c",
   "off": 142700,
   "max": 68,
   "kind": "dialogue",
   "jp": "山ほど鯨を食べるから\\n一度食われてみるんじゃ！\\nなんて　言われてな",
   "en": "",
   "op": "0x62",
   "msg": "0x293a"
  },
  {
   "id": "b_002001:0x2344c",
   "off": 144460,
   "max": 36,
   "kind": "dialogue",
   "jp": "ほれみろ\\nとんだヨタ話じゃねえか",
   "en": "",
   "op": "0x62",
   "msg": "0x293b"
  },
  {
   "id": "b_002001:0x23988",
   "off": 145800,
   "max": 60,
   "kind": "dialogue",
   "jp": "でも面白い話でしたよ\\n私も鯨の口の中に\\n入ってみたいですね",
   "en": "",
   "op": "0x62",
   "msg": "0x293c"
  },
  {
   "id": "b_002001:0x2405c",
   "off": 147548,
   "max": 72,
   "kind": "dialogue",
   "jp": "ロックを深く理解するには\\n鯨に飲まれるのがいい\\nシンディも飲まれてみ？",
   "en": "",
   "op": "0x62",
   "msg": "0x293d"
  },
  {
   "id": "b_002001:0x24520",
   "off": 148768,
   "max": 68,
   "kind": "dialogue",
   "jp": "はっ　またヨタかよ\\nそんなことをしなくても\\nオレ様のロックは最高だ",
   "en": "",
   "op": "0x62",
   "msg": "0x293e"
  },
  {
   "id": "b_002001:0x24c00",
   "off": 150528,
   "max": 48,
   "kind": "dialogue",
   "jp": "もっと高みに登れるかも\\n知れないですよ　晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x293f"
  },
  {
   "id": "b_002001:0x25148",
   "off": 151880,
   "max": 44,
   "kind": "dialogue",
   "jp": "あのなあ　桂さん\\nお人好しもたいがいにしろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2940"
  },
  {
   "id": "b_002001:0x255f0",
   "off": 153072,
   "max": 48,
   "kind": "dialogue",
   "jp": "そうですかね？\\n何事も体験だと思いますよ\\n晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x2941"
  },
  {
   "id": "b_002001:0x256cc",
   "off": 153292,
   "max": 72,
   "kind": "dialogue",
   "jp": "既成概念に縛られていたら\\n真のロックは難しいんじゃ\\nないかと思うんです",
   "en": "",
   "op": "0x62",
   "msg": "0x2942"
  },
  {
   "id": "b_002001:0x25c2c",
   "off": 154668,
   "max": 64,
   "kind": "dialogue",
   "jp": "はあ　お説教かよ\\n付き合い切れねえ\\nオレ様は湯を沸かしてくる",
   "en": "",
   "op": "0x62",
   "msg": "0x2943"
  },
  {
   "id": "b_002001:0x25c7c",
   "off": 154748,
   "max": 72,
   "kind": "dialogue",
   "jp": "龍馬のヨタ話を聞いてたら\\n体中が生臭い気がしてきて\\nたまらねえからな",
   "en": "",
   "op": "0x62",
   "msg": "0x2944"
  },
  {
   "id": "b_002001:0x261dc",
   "off": 156124,
   "max": 68,
   "kind": "dialogue",
   "jp": "ふふっ　晋作もヨタって\\n言いながら　しっかり\\n話を聞いてたんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x2945"
  },
  {
   "id": "b_002001:0x26230",
   "off": 156208,
   "max": 56,
   "kind": "dialogue",
   "jp": "ねえ　龍馬くん\\nもっと聞かせて欲しいです\\n土佐でのお話",
   "en": "",
   "op": "0x62",
   "msg": "0x2946"
  },
  {
   "id": "b_002001:0x26900",
   "off": 157952,
   "max": 40,
   "kind": "dialogue",
   "jp": "おう　いくらでも話すぞ\\n盛りは少なめで",
   "en": "",
   "op": "0x62",
   "msg": "0x2947"
  },
  {
   "id": "b_002001:0x26e40",
   "off": 159296,
   "max": 72,
   "kind": "dialogue",
   "jp": "盛っていてもいいですよ\\n龍馬くんのお話は楽しくて\\nワクワクしますから",
   "en": "",
   "op": "0x62",
   "msg": "0x2948"
  },
  {
   "id": "b_002001:0x2739c",
   "off": 160668,
   "max": 28,
   "kind": "dialogue",
   "jp": "おう\\nじゃあ盛り盛りで！",
   "en": "",
   "op": "0x62",
   "msg": "0x2949"
  },
  {
   "id": "b_002001:0x27848",
   "off": 161864,
   "max": 72,
   "kind": "dialogue",
   "jp": "こうして――\\n龍馬は高杉と桂に\\n懐かしい土佐での\\n思い出を語り続けた",
   "en": "",
   "op": "0x62",
   "msg": "0x294a"
  }
 ]
}
