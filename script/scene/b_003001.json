{
 "source": "b_003001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_003001:0x12dc",
   "off": 4828,
   "max": 52,
   "kind": "dialogue",
   "jp": "はい　お待たせ\\n今日の昼定食は\\nすぱげってぃーね",
   "en": "",
   "op": "0x62",
   "msg": "0x2710"
  },
  {
   "id": "b_003001:0x18c4",
   "off": 6340,
   "max": 72,
   "kind": "dialogue",
   "jp": "うおおお　うまそうじゃ\\nええ香りがしてたまらん\\nこれは……細いうどん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2711"
  },
  {
   "id": "b_003001:0x1d88",
   "off": 7560,
   "max": 44,
   "kind": "dialogue",
   "jp": "うどんじゃなく　ぱすた\\n伊太利亜の麺なの",
   "en": "",
   "op": "0x62",
   "msg": "0x2712"
  },
  {
   "id": "b_003001:0x22c8",
   "off": 8904,
   "max": 52,
   "kind": "dialogue",
   "jp": "おおおー　ぱすたー\\nようわからんが\\n美味そうじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x2713"
  },
  {
   "id": "b_003001:0x2778",
   "off": 10104,
   "max": 48,
   "kind": "dialogue",
   "jp": "お味のほうもバッチリよ\\n温かいうちに食べてね",
   "en": "",
   "op": "0x62",
   "msg": "0x2714"
  },
  {
   "id": "b_003001:0x2df4",
   "off": 11764,
   "max": 16,
   "kind": "dialogue",
   "jp": "おう　頂きます",
   "en": "",
   "op": "0x62",
   "msg": "0x2715"
  },
  {
   "id": "b_003001:0x34a0",
   "off": 13472,
   "max": 16,
   "kind": "dialogue",
   "jp": "では頂きます",
   "en": "",
   "op": "0x62",
   "msg": "0x2716"
  },
  {
   "id": "b_003001:0x3b3c",
   "off": 15164,
   "max": 68,
   "kind": "dialogue",
   "jp": "このぱすたは美味い！\\n土佐のうどんも美味いが\\n料理に幅がないからな",
   "en": "",
   "op": "0x62",
   "msg": "0x2717"
  },
  {
   "id": "b_003001:0x4224",
   "off": 16932,
   "max": 44,
   "kind": "dialogue",
   "jp": "ぱすたには唐辛子が\\n良く似合う　美味い！",
   "en": "",
   "op": "0x62",
   "msg": "0x2718"
  },
  {
   "id": "b_003001:0x4768",
   "off": 18280,
   "max": 60,
   "kind": "dialogue",
   "jp": "茹で方も味付けも\\nすごく研究されていて\\n美味しいですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x2719"
  },
  {
   "id": "b_003001:0x4e3c",
   "off": 20028,
   "max": 52,
   "kind": "dialogue",
   "jp": "ふふふっ\\nそう言ってくれると\\n作りがいがあるわねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x271a"
  },
  {
   "id": "b_003001:0x54fc",
   "off": 21756,
   "max": 24,
   "kind": "dialogue",
   "jp": "お登勢やん\\nお代わり！",
   "en": "",
   "op": "0x62",
   "msg": "0x271b"
  },
  {
   "id": "b_003001:0x5990",
   "off": 22928,
   "max": 40,
   "kind": "dialogue",
   "jp": "はいはい　龍ちゃんは\\nよく食べるわねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x271c"
  },
  {
   "id": "b_003001:0x6004",
   "off": 24580,
   "max": 20,
   "kind": "dialogue",
   "jp": "オレ様もお代わりだ",
   "en": "",
   "op": "0x62",
   "msg": "0x271d"
  },
  {
   "id": "b_003001:0x6494",
   "off": 25748,
   "max": 68,
   "kind": "dialogue",
   "jp": "はいはい　晋ちゃんも\\nよく食べるわねえ\\n五郎ちゃん　お代わりは？",
   "en": "",
   "op": "0x62",
   "msg": "0x271e"
  },
  {
   "id": "b_003001:0x6c60",
   "off": 27744,
   "max": 48,
   "kind": "dialogue",
   "jp": "私はゆっくり食べてるから\\nあとでお代わりします",
   "en": "",
   "op": "0x62",
   "msg": "0x271f"
  },
  {
   "id": "b_003001:0x71a4",
   "off": 29092,
   "max": 48,
   "kind": "dialogue",
   "jp": "ゆっくりと食べてると\\nみんな食べられちゃうわよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2720"
  },
  {
   "id": "b_003001:0x7650",
   "off": 30288,
   "max": 56,
   "kind": "dialogue",
   "jp": "食事ぐらいは\\nゆっくり食べないと\\n消化に悪いですからね",
   "en": "",
   "op": "0x62",
   "msg": "0x2721"
  },
  {
   "id": "b_003001:0x7b9c",
   "off": 31644,
   "max": 48,
   "kind": "dialogue",
   "jp": "はあ～\\n五郎ちゃんは食べ方が\\n優雅でステキよね",
   "en": "",
   "op": "0x62",
   "msg": "0x2722"
  },
  {
   "id": "b_003001:0x8048",
   "off": 32840,
   "max": 20,
   "kind": "dialogue",
   "jp": "えっ　そうですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2723"
  },
  {
   "id": "b_003001:0x84d8",
   "off": 34008,
   "max": 44,
   "kind": "dialogue",
   "jp": "いつ見ても上品な食べ方で\\n感心してるのよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2724"
  },
  {
   "id": "b_003001:0x8ba8",
   "off": 35752,
   "max": 56,
   "kind": "dialogue",
   "jp": "まあ　桂さんは家柄が\\n良いしな\\nオレ様とは違うんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2725"
  },
  {
   "id": "b_003001:0x9280",
   "off": 37504,
   "max": 64,
   "kind": "dialogue",
   "jp": "シンディらしくないな\\n家柄うんぬんなんぞ\\nロックじゃないじゃろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2726"
  },
  {
   "id": "b_003001:0x995c",
   "off": 39260,
   "max": 64,
   "kind": "dialogue",
   "jp": "うるせえよ　龍馬は\\nオレ様にはオレ様の\\nロック論があるんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2727"
  },
  {
   "id": "b_003001:0x9eb4",
   "off": 40628,
   "max": 40,
   "kind": "dialogue",
   "jp": "じゃあごゆっくり\\n好きにお代わりしてね",
   "en": "",
   "op": "0x62",
   "msg": "0x2728"
  },
  {
   "id": "b_003001:0xa608",
   "off": 42504,
   "max": 64,
   "kind": "dialogue",
   "jp": "しかしまあ　センセーが\\n良家のご子息ってのは\\n合点がいくなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2729"
  },
  {
   "id": "b_003001:0xaac4",
   "off": 43716,
   "max": 28,
   "kind": "dialogue",
   "jp": "躾が行き届いている点か？",
   "en": "",
   "op": "0x62",
   "msg": "0x272a"
  },
  {
   "id": "b_003001:0xaf5c",
   "off": 44892,
   "max": 64,
   "kind": "dialogue",
   "jp": "お登勢やんの言う通り\\n飯を食うのが上品じゃ\\nけど料理は作れん",
   "en": "",
   "op": "0x62",
   "msg": "0x272b"
  },
  {
   "id": "b_003001:0xb638",
   "off": 46648,
   "max": 64,
   "kind": "dialogue",
   "jp": "魚を三枚に下ろすとか\\n私は苦手ですからね\\n晋作には敵わないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x272c"
  },
  {
   "id": "b_003001:0xbb90",
   "off": 48016,
   "max": 68,
   "kind": "dialogue",
   "jp": "藩医のせがれに生まれて\\nばあやの上げ膳据え膳じゃ\\n無理もねえだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x272d"
  },
  {
   "id": "b_003001:0xbc80",
   "off": 48256,
   "max": 68,
   "kind": "dialogue",
   "jp": "オレ様の家は飯の度に\\n戦みたいなものだったし\\n自炊も得意なわけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x272e"
  },
  {
   "id": "b_003001:0xc6c0",
   "off": 50880,
   "max": 28,
   "kind": "dialogue",
   "jp": "なるほど\\n合点がいった！",
   "en": "",
   "op": "0x62",
   "msg": "0x272f"
  },
  {
   "id": "b_003001:0xd008",
   "off": 53256,
   "max": 16,
   "kind": "dialogue",
   "jp": "なにがだよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2730"
  },
  {
   "id": "b_003001:0xd738",
   "off": 55096,
   "max": 48,
   "kind": "dialogue",
   "jp": "シンディが\\nがさつなところに\\n合点がいった！",
   "en": "",
   "op": "0x62",
   "msg": "0x2731"
  },
  {
   "id": "b_003001:0xdc80",
   "off": 56448,
   "max": 56,
   "kind": "dialogue",
   "jp": "ガサツが着物着て\\n歩いているような\\nおまえがいうな！",
   "en": "",
   "op": "0x62",
   "msg": "0x2732"
  },
  {
   "id": "b_003001:0xe2d8",
   "off": 58072,
   "max": 52,
   "kind": "dialogue",
   "jp": "あいたーっ！\\n叩かれたら鼻から\\nぱすたが出たぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2733"
  },
  {
   "id": "b_003001:0xe828",
   "off": 59432,
   "max": 60,
   "kind": "dialogue",
   "jp": "汚ぇなあ　まったく\\nちっとは桂さんを見習って\\n静かに食え",
   "en": "",
   "op": "0x62",
   "msg": "0x2734"
  },
  {
   "id": "b_003001:0xf35c",
   "off": 62300,
   "max": 48,
   "kind": "dialogue",
   "jp": "晋作　騒がしいです\\n食事時は静かにしましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2735"
  },
  {
   "id": "b_003001:0xfc90",
   "off": 64656,
   "max": 16,
   "kind": "dialogue",
   "jp": "す　すまねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x2736"
  },
  {
   "id": "b_003001:0x101b8",
   "off": 65976,
   "max": 60,
   "kind": "dialogue",
   "jp": "食べ物に感謝する心は\\nロックの心にも\\n通じると思うんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2737"
  },
  {
   "id": "b_003001:0x1088c",
   "off": 67724,
   "max": 72,
   "kind": "dialogue",
   "jp": "おお　さすがセンセーじゃ\\n食べ物を粗末にするのは\\nロックとはいえん！",
   "en": "",
   "op": "0x62",
   "msg": "0x2738"
  },
  {
   "id": "b_003001:0x10dec",
   "off": 69100,
   "max": 76,
   "kind": "dialogue",
   "jp": "まあな　しかしそういう\\n既成概念を覆す型破りも\\nロックの内じゃねえのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2739"
  },
  {
   "id": "b_003001:0x1134c",
   "off": 70476,
   "max": 40,
   "kind": "dialogue",
   "jp": "破天荒なロックは\\nわしの望むところじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x273a"
  },
  {
   "id": "b_003001:0x11a4c",
   "off": 72268,
   "max": 76,
   "kind": "dialogue",
   "jp": "型破りと破天荒は別ですよ\\nそれにどちらも基本的な\\n心がしっかりしてないとね",
   "en": "",
   "op": "0x62",
   "msg": "0x273b"
  },
  {
   "id": "b_003001:0x11aa8",
   "off": 72360,
   "max": 64,
   "kind": "dialogue",
   "jp": "人を敬う気持ちや\\n感謝の心がなければ\\n上辺だけの歌になるんです",
   "en": "",
   "op": "0x62",
   "msg": "0x273c"
  },
  {
   "id": "b_003001:0x11af8",
   "off": 72440,
   "max": 60,
   "kind": "dialogue",
   "jp": "そんな歌では人の心に\\n語りかけるなんて\\n無理じゃないですか",
   "en": "",
   "op": "0x62",
   "msg": "0x273d"
  },
  {
   "id": "b_003001:0x1204c",
   "off": 73804,
   "max": 28,
   "kind": "dialogue",
   "jp": "……正論過ぎて言葉がねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x273e"
  },
  {
   "id": "b_003001:0x1257c",
   "off": 75132,
   "max": 44,
   "kind": "dialogue",
   "jp": "そんな難しいことは考えて\\nおらんかった……",
   "en": "",
   "op": "0x62",
   "msg": "0x273f"
  },
  {
   "id": "b_003001:0x12ac0",
   "off": 76480,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬くんのロックは\\n理屈じゃないですから",
   "en": "",
   "op": "0x62",
   "msg": "0x2740"
  },
  {
   "id": "b_003001:0x12b98",
   "off": 76696,
   "max": 56,
   "kind": "dialogue",
   "jp": "深く考えないほうが\\n良いんじゃないと\\nそう思いますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2741"
  },
  {
   "id": "b_003001:0x130e8",
   "off": 78056,
   "max": 36,
   "kind": "dialogue",
   "jp": "バカの考え休むに似たり\\nっつーしな",
   "en": "",
   "op": "0x62",
   "msg": "0x2742"
  },
  {
   "id": "b_003001:0x13624",
   "off": 79396,
   "max": 36,
   "kind": "dialogue",
   "jp": "あははは……\\nひどいですね　晋作は",
   "en": "",
   "op": "0x62",
   "msg": "0x2743"
  },
  {
   "id": "b_003001:0x13b5c",
   "off": 80732,
   "max": 52,
   "kind": "dialogue",
   "jp": "ええ話が聞けた\\nぱすたも美味いし\\n最高の気分じゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x2744"
  },
  {
   "id": "b_003001:0x13ba0",
   "off": 80800,
   "max": 68,
   "kind": "dialogue",
   "jp": "それにしてもセンセーは\\nお人がええところが\\n本当に良家の出じゃな～",
   "en": "",
   "op": "0x62",
   "msg": "0x2745"
  },
  {
   "id": "b_003001:0x140fc",
   "off": 82172,
   "max": 60,
   "kind": "dialogue",
   "jp": "まあな　桂さんは\\n子供の頃から　お人好しの\\nところがあるな",
   "en": "",
   "op": "0x62",
   "msg": "0x2746"
  },
  {
   "id": "b_003001:0x14650",
   "off": 83536,
   "max": 44,
   "kind": "dialogue",
   "jp": "そうかな？　私は普通だと\\n思っていますけど",
   "en": "",
   "op": "0x62",
   "msg": "0x2747"
  },
  {
   "id": "b_003001:0x14b94",
   "off": 84884,
   "max": 40,
   "kind": "dialogue",
   "jp": "そう思ってるのは\\nあんただけだ　桂さん",
   "en": "",
   "op": "0x62",
   "msg": "0x2748"
  },
  {
   "id": "b_003001:0x14c68",
   "off": 85096,
   "max": 52,
   "kind": "dialogue",
   "jp": "桂さんが立ち売りに\\n騙された時のこと\\n覚えてるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2749"
  },
  {
   "id": "b_003001:0x151b4",
   "off": 86452,
   "max": 72,
   "kind": "dialogue",
   "jp": "あったね　そんなこと\\nあの時はごめんなさい\\n晋作に迷惑掛けてしまって",
   "en": "",
   "op": "0x62",
   "msg": "0x274a"
  },
  {
   "id": "b_003001:0x15710",
   "off": 87824,
   "max": 24,
   "kind": "dialogue",
   "jp": "なにがあったんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x274b"
  },
  {
   "id": "b_003001:0x15c40",
   "off": 89152,
   "max": 72,
   "kind": "dialogue",
   "jp": "私がまだ幼い頃の話だけど\\n立ち売りの行商人から\\nお菓子を買ったんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x274c"
  },
  {
   "id": "b_003001:0x15d34",
   "off": 89396,
   "max": 76,
   "kind": "dialogue",
   "jp": "晋作と一緒に食べようと\\n思って買ったんですけどね\\nそれで騙されてしまって",
   "en": "",
   "op": "0x62",
   "msg": "0x274d"
  },
  {
   "id": "b_003001:0x16294",
   "off": 90772,
   "max": 24,
   "kind": "dialogue",
   "jp": "どう騙されたんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x274e"
  },
  {
   "id": "b_003001:0x16728",
   "off": 91944,
   "max": 52,
   "kind": "dialogue",
   "jp": "珍しいカスティラって菓子\\nだというのがインチキでな",
   "en": "",
   "op": "0x62",
   "msg": "0x274f"
  },
  {
   "id": "b_003001:0x1676c",
   "off": 92012,
   "max": 40,
   "kind": "dialogue",
   "jp": "木の端切れに色を塗った\\nだけだったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2750"
  },
  {
   "id": "b_003001:0x16ca8",
   "off": 93352,
   "max": 44,
   "kind": "dialogue",
   "jp": "なんじゃと！\\nそれはひどい\\n行商人だなっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2751"
  },
  {
   "id": "b_003001:0x17150",
   "off": 94544,
   "max": 44,
   "kind": "dialogue",
   "jp": "楽しみにしてたから\\nガッカリしちゃってね",
   "en": "",
   "op": "0x62",
   "msg": "0x2752"
  },
  {
   "id": "b_003001:0x17694",
   "off": 95892,
   "max": 76,
   "kind": "dialogue",
   "jp": "勉学は優秀でも　桂さんは\\nどこかボケッとしてるから\\n悪い野郎に騙されたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2753"
  },
  {
   "id": "b_003001:0x17d30",
   "off": 97584,
   "max": 52,
   "kind": "dialogue",
   "jp": "珍しくて嬉しいなとしか\\n考えてなかったですからー",
   "en": "",
   "op": "0x62",
   "msg": "0x2754"
  },
  {
   "id": "b_003001:0x182ec",
   "off": 99052,
   "max": 44,
   "kind": "dialogue",
   "jp": "金取られてニセモノとは\\nそりゃガッカリぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2755"
  },
  {
   "id": "b_003001:0x18830",
   "off": 100400,
   "max": 60,
   "kind": "dialogue",
   "jp": "騙された私が悪いし\\n勉強代だって言ったら\\n晋作が激昂してね",
   "en": "",
   "op": "0x62",
   "msg": "0x2756"
  },
  {
   "id": "b_003001:0x18e20",
   "off": 101920,
   "max": 64,
   "kind": "dialogue",
   "jp": "当たり前だろうが\\n泣き寝入りするなんて\\nロックじゃねえからな",
   "en": "",
   "op": "0x62",
   "msg": "0x2757"
  },
  {
   "id": "b_003001:0x193ec",
   "off": 103404,
   "max": 64,
   "kind": "dialogue",
   "jp": "晋作はすごい剣幕で\\n薪を片手に行商人を\\n追っていったんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2758"
  },
  {
   "id": "b_003001:0x19940",
   "off": 104768,
   "max": 48,
   "kind": "dialogue",
   "jp": "ほう　シンディは\\n熱い男だから\\n納得がゆくな",
   "en": "",
   "op": "0x62",
   "msg": "0x2759"
  },
  {
   "id": "b_003001:0x19e88",
   "off": 106120,
   "max": 60,
   "kind": "dialogue",
   "jp": "そんなんじゃねえよ\\n幼い子供を騙すなんざ\\n許されねえからな",
   "en": "",
   "op": "0x62",
   "msg": "0x275a"
  },
  {
   "id": "b_003001:0x1a340",
   "off": 107328,
   "max": 72,
   "kind": "dialogue",
   "jp": "シンディは悪い行商人を\\n薪でボコボコにこらしめた\\nというオチじゃな！",
   "en": "",
   "op": "0x62",
   "msg": "0x275b"
  },
  {
   "id": "b_003001:0x1a9d8",
   "off": 109016,
   "max": 12,
   "kind": "dialogue",
   "jp": "ま　まあな",
   "en": "",
   "op": "0x62",
   "msg": "0x275c"
  },
  {
   "id": "b_003001:0x1af6c",
   "off": 110444,
   "max": 32,
   "kind": "dialogue",
   "jp": "あれ？\\n成敗せんかったのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x275d"
  },
  {
   "id": "b_003001:0x1b4a4",
   "off": 111780,
   "max": 60,
   "kind": "dialogue",
   "jp": "返り討ちにされて\\nボコボコになって\\n帰って来たんですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x275e"
  },
  {
   "id": "b_003001:0x1bee0",
   "off": 114400,
   "max": 40,
   "kind": "dialogue",
   "jp": "か　桂さんっ\\nばらしてんじゃねえよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x275f"
  },
  {
   "id": "b_003001:0x1c7b0",
   "off": 116656,
   "max": 68,
   "kind": "dialogue",
   "jp": "たんこぶと傷だらけで\\nそれでも手にはしっかり\\n代金を握りしめててね",
   "en": "",
   "op": "0x62",
   "msg": "0x2760"
  },
  {
   "id": "b_003001:0x1c804",
   "off": 116740,
   "max": 60,
   "kind": "dialogue",
   "jp": "気を付けろよ\\n世の中には悪い大人が\\nたくさんいるからなって",
   "en": "",
   "op": "0x62",
   "msg": "0x2761"
  },
  {
   "id": "b_003001:0x1cd58",
   "off": 118104,
   "max": 48,
   "kind": "dialogue",
   "jp": "それは思い出さなくても\\nいい話だぜ　桂さんよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2762"
  },
  {
   "id": "b_003001:0x1cd98",
   "off": 118168,
   "max": 68,
   "kind": "dialogue",
   "jp": "コロッと騙されるような\\nお人好しだってことを\\n思い出せっつってんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2763"
  },
  {
   "id": "b_003001:0x1d8d0",
   "off": 121040,
   "max": 64,
   "kind": "dialogue",
   "jp": "まさに男の中の男！\\nシンディは真の男じゃ\\nわしは感激したっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2764"
  },
  {
   "id": "b_003001:0x1e24c",
   "off": 123468,
   "max": 72,
   "kind": "dialogue",
   "jp": "晋作は子供の頃から\\nとても正義感が強い男でね\\n私はよく助けられたのです",
   "en": "",
   "op": "0x62",
   "msg": "0x2765"
  },
  {
   "id": "b_003001:0x1e7a8",
   "off": 124840,
   "max": 36,
   "kind": "dialogue",
   "jp": "うんうん　ええ男じゃな\\nシンディ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2766"
  },
  {
   "id": "b_003001:0x1f34c",
   "off": 127820,
   "max": 44,
   "kind": "dialogue",
   "jp": "やめろ　龍馬\\n肩を叩くな\\n飯がまずくなる",
   "en": "",
   "op": "0x62",
   "msg": "0x2767"
  },
  {
   "id": "b_003001:0x1f868",
   "off": 129128,
   "max": 36,
   "kind": "dialogue",
   "jp": "あははっ　晋作\\n照れてるんですか",
   "en": "",
   "op": "0x62",
   "msg": "0x2768"
  },
  {
   "id": "b_003001:0x1fda4",
   "off": 130468,
   "max": 56,
   "kind": "dialogue",
   "jp": "オレ様が桂さんを\\n助けたのは　別の意味も\\nあったけどな",
   "en": "",
   "op": "0x62",
   "msg": "0x2769"
  },
  {
   "id": "b_003001:0x2075c",
   "off": 132956,
   "max": 40,
   "kind": "dialogue",
   "jp": "あ……もうやめましょう\\nこの話は　ね？",
   "en": "",
   "op": "0x62",
   "msg": "0x276a"
  },
  {
   "id": "b_003001:0x20e08",
   "off": 134664,
   "max": 44,
   "kind": "dialogue",
   "jp": "オレ様の話ばかりじゃ\\n龍馬もつまらねえだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x276b"
  },
  {
   "id": "b_003001:0x216f4",
   "off": 136948,
   "max": 36,
   "kind": "dialogue",
   "jp": "もっといろいろな\\n話を聞きたいぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x276c"
  },
  {
   "id": "b_003001:0x21c30",
   "off": 138288,
   "max": 68,
   "kind": "dialogue",
   "jp": "今の桂さんは大人しいけど\\n元々はクソが付くほど\\n悪ガキだったんだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x276d"
  },
  {
   "id": "b_003001:0x22188",
   "off": 139656,
   "max": 44,
   "kind": "dialogue",
   "jp": "ほうほう　そりゃすぐには\\n信じられん話じゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x276e"
  },
  {
   "id": "b_003001:0x226cc",
   "off": 141004,
   "max": 64,
   "kind": "dialogue",
   "jp": "船から荷を運ぶ小舟を\\n揺すってひっくり返したり\\nしてたもんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x276f"
  },
  {
   "id": "b_003001:0x22cc4",
   "off": 142532,
   "max": 52,
   "kind": "dialogue",
   "jp": "あはは……なぜ\\n浮かぶのか不思議だった\\nんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2770"
  },
  {
   "id": "b_003001:0x23210",
   "off": 143888,
   "max": 64,
   "kind": "dialogue",
   "jp": "好奇心が強くて　\\nなんでも試してみないと\\n気が済まなくてなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2771"
  },
  {
   "id": "b_003001:0x23260",
   "off": 143968,
   "max": 36,
   "kind": "dialogue",
   "jp": "次から次へと　\\n何かしでかすんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2772"
  },
  {
   "id": "b_003001:0x23798",
   "off": 145304,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんか　センセー\\nらしいぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2773"
  },
  {
   "id": "b_003001:0x23d6c",
   "off": 146796,
   "max": 52,
   "kind": "dialogue",
   "jp": "それで痛い目を見る\\nこともあるからな\\nなあ　桂さん",
   "en": "",
   "op": "0x62",
   "msg": "0x2774"
  },
  {
   "id": "b_003001:0x2432c",
   "off": 148268,
   "max": 64,
   "kind": "dialogue",
   "jp": "そうですね\\n小舟をひっくり返した時に\\n殴られて骨身に染みました",
   "en": "",
   "op": "0x62",
   "msg": "0x2775"
  },
  {
   "id": "b_003001:0x24880",
   "off": 149632,
   "max": 28,
   "kind": "dialogue",
   "jp": "おおっ\\n怪我でもしたか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2776"
  },
  {
   "id": "b_003001:0x24db4",
   "off": 150964,
   "max": 76,
   "kind": "dialogue",
   "jp": "おでこが切れてしまってね\\n父に怪我の理由を聞かれて\\n答えられなくてね……",
   "en": "",
   "op": "0x62",
   "msg": "0x2777"
  },
  {
   "id": "b_003001:0x24e10",
   "off": 151056,
   "max": 68,
   "kind": "dialogue",
   "jp": "そしたら晋作が家に来て\\nケンカして怪我させました\\nごめんなさいって",
   "en": "",
   "op": "0x62",
   "msg": "0x2778"
  },
  {
   "id": "b_003001:0x257f4",
   "off": 153588,
   "max": 32,
   "kind": "dialogue",
   "jp": "ええっ \\nそんなことあったか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2779"
  },
  {
   "id": "b_003001:0x25f24",
   "off": 155428,
   "max": 52,
   "kind": "dialogue",
   "jp": "晋作は　忘れたんですか？\\n私を庇ってくれたんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x277a"
  },
  {
   "id": "b_003001:0x26470",
   "off": 156784,
   "max": 24,
   "kind": "dialogue",
   "jp": "ああ　すっかり忘れてた",
   "en": "",
   "op": "0x62",
   "msg": "0x277b"
  },
  {
   "id": "b_003001:0x269a0",
   "off": 158112,
   "max": 44,
   "kind": "dialogue",
   "jp": "それがあって私は\\n悪さをしなくなったのに",
   "en": "",
   "op": "0x62",
   "msg": "0x277c"
  },
  {
   "id": "b_003001:0x26ee4",
   "off": 159460,
   "max": 48,
   "kind": "dialogue",
   "jp": "はあ……\\n余計な話で蒸し返すんじゃ\\nなかったな",
   "en": "",
   "op": "0x62",
   "msg": "0x277d"
  },
  {
   "id": "b_003001:0x2774c",
   "off": 161612,
   "max": 68,
   "kind": "dialogue",
   "jp": "シンディは　わしには\\nちょっぴり冷たいけど\\n本当に　ええ男じゃあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x277e"
  },
  {
   "id": "b_003001:0x27d48",
   "off": 163144,
   "max": 52,
   "kind": "dialogue",
   "jp": "おまえみたいな\\nバカの相手をするのは\\n疲れるからな",
   "en": "",
   "op": "0x62",
   "msg": "0x277f"
  },
  {
   "id": "b_003001:0x28290",
   "off": 164496,
   "max": 56,
   "kind": "dialogue",
   "jp": "はあ　それは厳しいのう\\n気苦労が絶えんなあ\\nシンディ",
   "en": "",
   "op": "0x62",
   "msg": "0x2780"
  },
  {
   "id": "b_003001:0x287e0",
   "off": 165856,
   "max": 24,
   "kind": "dialogue",
   "jp": "だからおまえが言うな！",
   "en": "",
   "op": "0x62",
   "msg": "0x2781"
  },
  {
   "id": "b_003001:0x291f4",
   "off": 168436,
   "max": 52,
   "kind": "dialogue",
   "jp": "晋作は昔から\\n人の面倒を見るのが\\n好きでしたから",
   "en": "",
   "op": "0x62",
   "msg": "0x2782"
  },
  {
   "id": "b_003001:0x2973c",
   "off": 169788,
   "max": 72,
   "kind": "dialogue",
   "jp": "天然過ぎて危なっかしくて\\n見てられないからだろうが\\n桂さんの場合はっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2783"
  },
  {
   "id": "b_003001:0x29c00",
   "off": 171008,
   "max": 60,
   "kind": "dialogue",
   "jp": "自ら面倒事に立ち向かう\\n男の中の男！\\nこれこそロックじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2784"
  },
  {
   "id": "b_003001:0x2a154",
   "off": 172372,
   "max": 16,
   "kind": "dialogue",
   "jp": "……そうかよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2785"
  },
  {
   "id": "b_003001:0x2a210",
   "off": 172560,
   "max": 36,
   "kind": "dialogue",
   "jp": "お代わり……って\\nぱすたがねえな",
   "en": "",
   "op": "0x62",
   "msg": "0x2786"
  },
  {
   "id": "b_003001:0x2a884",
   "off": 174212,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍馬くんがぱすた全部\\n食べちゃったみたいです",
   "en": "",
   "op": "0x62",
   "msg": "0x2787"
  },
  {
   "id": "b_003001:0x2aedc",
   "off": 175836,
   "max": 16,
   "kind": "dialogue",
   "jp": "いつの間に……",
   "en": "",
   "op": "0x62",
   "msg": "0x2788"
  },
  {
   "id": "b_003001:0x2b474",
   "off": 177268,
   "max": 36,
   "kind": "dialogue",
   "jp": "うはははは\\nやっと腹八分になった",
   "en": "",
   "op": "0x62",
   "msg": "0x2789"
  },
  {
   "id": "b_003001:0x2b9b0",
   "off": 178608,
   "max": 32,
   "kind": "dialogue",
   "jp": "あんだけ食って\\n八分目かよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x278a"
  },
  {
   "id": "b_003001:0x2be4c",
   "off": 179788,
   "max": 36,
   "kind": "dialogue",
   "jp": "健康の為に飯は控えめに\\nするんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x278b"
  },
  {
   "id": "b_003001:0x2c388",
   "off": 181128,
   "max": 44,
   "kind": "dialogue",
   "jp": "健康に気遣うとか\\nロックじゃねえだろ……",
   "en": "",
   "op": "0x62",
   "msg": "0x278c"
  },
  {
   "id": "b_003001:0x2c8c8",
   "off": 182472,
   "max": 68,
   "kind": "dialogue",
   "jp": "それは違うぜよ　シンディ\\n健全なロックは\\n健全な体と魂に宿るんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x278d"
  },
  {
   "id": "b_003001:0x2ce24",
   "off": 183844,
   "max": 52,
   "kind": "dialogue",
   "jp": "あのなあ\\n食うだけ食っといて\\n偉そうに言うなっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x278e"
  },
  {
   "id": "b_003001:0x2d868",
   "off": 186472,
   "max": 56,
   "kind": "dialogue",
   "jp": "だーかーら！\\n食事は静かにしましょう\\n晋作　龍馬くん",
   "en": "",
   "op": "0x62",
   "msg": "0x278f"
  },
  {
   "id": "b_003001:0x2e428",
   "off": 189480,
   "max": 16,
   "kind": "dialogue",
   "jp": "すみません……",
   "en": "",
   "op": "0x62",
   "msg": "0x2790"
  },
  {
   "id": "b_003001:0x2eb80",
   "off": 191360,
   "max": 68,
   "kind": "dialogue",
   "jp": "穏やかに憤慨する桂に\\n高杉と龍馬は小さくなって\\nしまったのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x2791"
  }
 ]
}
