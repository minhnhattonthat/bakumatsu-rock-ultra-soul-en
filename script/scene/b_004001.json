{
 "source": "b_004001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_004001:0x10e8",
   "off": 4328,
   "max": 68,
   "kind": "dialogue",
   "jp": "――これは\\n龍馬高杉桂の三人が\\n新選組と敵対していた\\n頃の話",
   "en": "",
   "op": "0x62",
   "msg": "0x2e5e"
  },
  {
   "id": "b_004001:0x1878",
   "off": 6264,
   "max": 48,
   "kind": "dialogue",
   "jp": "ねえねえ\\nあの隊列を見て！\\n新選組の皆様よ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e5f"
  },
  {
   "id": "b_004001:0x1f74",
   "off": 8052,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああ　本当だわっ\\n町の見回りをされてるのね",
   "en": "",
   "op": "0x62",
   "msg": "0x2e60"
  },
  {
   "id": "b_004001:0x2664",
   "off": 9828,
   "max": 64,
   "kind": "dialogue",
   "jp": "隊の先頭にいるのは\\n土方様と総司様だわ\\nああ　今日も麗しいっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e61"
  },
  {
   "id": "b_004001:0x2b20",
   "off": 11040,
   "max": 44,
   "kind": "dialogue",
   "jp": "土方様　総司様\\nお慕いしております～～！",
   "en": "",
   "op": "0x62",
   "msg": "0x2e62"
  },
  {
   "id": "b_004001:0x2fc8",
   "off": 12232,
   "max": 36,
   "kind": "dialogue",
   "jp": "新選組万歳\\n愛獲最高です～～～",
   "en": "",
   "op": "0x62",
   "msg": "0x2e63"
  },
  {
   "id": "b_004001:0x3794",
   "off": 14228,
   "max": 60,
   "kind": "dialogue",
   "jp": "隊列を組んで歩く\\n新選組に大勢の女性が\\n黄色い声を上げる",
   "en": "",
   "op": "0x62",
   "msg": "0x2e64"
  },
  {
   "id": "b_004001:0x37e0",
   "off": 14304,
   "max": 64,
   "kind": "dialogue",
   "jp": "その声援を受けて沖田は\\n爽やかに微笑みながら\\n群衆に手を振った",
   "en": "",
   "op": "0x62",
   "msg": "0x2e65"
  },
  {
   "id": "b_004001:0x3c60",
   "off": 15456,
   "max": 36,
   "kind": "dialogue",
   "jp": "みんな　ありがとう～\\n大好きだよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2e66"
  },
  {
   "id": "b_004001:0x3c94",
   "off": 15508,
   "max": 40,
   "kind": "dialogue",
   "jp": "これからも僕達の事を\\n沢山応援してね～",
   "en": "",
   "op": "0x62",
   "msg": "0x2e67"
  },
  {
   "id": "b_004001:0x484c",
   "off": 18508,
   "max": 52,
   "kind": "dialogue",
   "jp": "ぎゃあああっ　\\n総司様ああああ\\n素敵ですうううう",
   "en": "",
   "op": "0x62",
   "msg": "0x2e68"
  },
  {
   "id": "b_004001:0x4d04",
   "off": 19716,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方様も一言\\nお願いします～～\\n手も振って～～～",
   "en": "",
   "op": "0x62",
   "msg": "0x2e69"
  },
  {
   "id": "b_004001:0x57fc",
   "off": 22524,
   "max": 16,
   "kind": "dialogue",
   "jp": "………………",
   "en": "",
   "op": "0x62",
   "msg": "0x2e6a"
  },
  {
   "id": "b_004001:0x60a4",
   "off": 24740,
   "max": 52,
   "kind": "dialogue",
   "jp": "あ　あら？　土方様～～？\\nどうされたんですか～～？",
   "en": "",
   "op": "0x62",
   "msg": "0x2e6b"
  },
  {
   "id": "b_004001:0x6718",
   "off": 26392,
   "max": 24,
   "kind": "dialogue",
   "jp": "あ　ちょっとごめんね～",
   "en": "",
   "op": "0x62",
   "msg": "0x2e6c"
  },
  {
   "id": "b_004001:0x70dc",
   "off": 28892,
   "max": 32,
   "kind": "dialogue",
   "jp": "ほら　土方さん\\n煌の前ですよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2e6d"
  },
  {
   "id": "b_004001:0x7578",
   "off": 30072,
   "max": 16,
   "kind": "dialogue",
   "jp": "………………",
   "en": "",
   "op": "0x62",
   "msg": "0x2e6e"
  },
  {
   "id": "b_004001:0x7a0c",
   "off": 31244,
   "max": 48,
   "kind": "dialogue",
   "jp": "ほらほらムッとしないで\\nカワイイ犬の写真ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e6f"
  },
  {
   "id": "b_004001:0x7f5c",
   "off": 32604,
   "max": 28,
   "kind": "dialogue",
   "jp": "……む……\\nかわいい……",
   "en": "",
   "op": "0x62",
   "msg": "0x2e70"
  },
  {
   "id": "b_004001:0x802c",
   "off": 32812,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや……\\n悪いがそんな気分\\nじゃないんだ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2e71"
  },
  {
   "id": "b_004001:0x86e8",
   "off": 34536,
   "max": 28,
   "kind": "dialogue",
   "jp": "もー\\nこりゃ相当重症だね",
   "en": "",
   "op": "0x62",
   "msg": "0x2e72"
  },
  {
   "id": "b_004001:0x8930",
   "off": 35120,
   "max": 80,
   "kind": "dialogue",
   "jp": "あー　みんな　ごめんね\\n土方さん　太陽の下に出ると\\n具合が悪くなる体質なんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e73"
  },
  {
   "id": "b_004001:0x8fcc",
   "off": 36812,
   "max": 24,
   "kind": "dialogue",
   "jp": "まあ　そうなんですか",
   "en": "",
   "op": "0x62",
   "msg": "0x2e74"
  },
  {
   "id": "b_004001:0x9460",
   "off": 37984,
   "max": 64,
   "kind": "dialogue",
   "jp": "うん　だから町の見回りは\\n僕らに任せるように\\n言ったんだけど",
   "en": "",
   "op": "0x62",
   "msg": "0x2e75"
  },
  {
   "id": "b_004001:0x94b0",
   "off": 38064,
   "max": 48,
   "kind": "dialogue",
   "jp": "みんなの事が心配だって\\n土方さん　聞かなくて",
   "en": "",
   "op": "0x62",
   "msg": "0x2e76"
  },
  {
   "id": "b_004001:0xa164",
   "off": 41316,
   "max": 64,
   "kind": "dialogue",
   "jp": "きゃぁぁっ　土方様\\n私達の事を考えて下さって\\nいるのですねっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e77"
  },
  {
   "id": "b_004001:0xa620",
   "off": 42528,
   "max": 32,
   "kind": "dialogue",
   "jp": "素晴らしいです\\n土方様～～",
   "en": "",
   "op": "0x62",
   "msg": "0x2e78"
  },
  {
   "id": "b_004001:0xaabc",
   "off": 43708,
   "max": 44,
   "kind": "dialogue",
   "jp": "仏　\\n貴方が仏だったのですねっ\\n土方様",
   "en": "",
   "op": "0x62",
   "msg": "0x2e79"
  },
  {
   "id": "b_004001:0xb490",
   "off": 46224,
   "max": 52,
   "kind": "dialogue",
   "jp": "うん　じゃあそういう事で\\n土方さんと僕は失礼するね",
   "en": "",
   "op": "0x62",
   "msg": "0x2e7a"
  },
  {
   "id": "b_004001:0xb56c",
   "off": 46444,
   "max": 20,
   "kind": "dialogue",
   "jp": "君達　後はお願いね",
   "en": "",
   "op": "0x62",
   "msg": "0x2e7b"
  },
  {
   "id": "b_004001:0xbbc0",
   "off": 48064,
   "max": 24,
   "kind": "dialogue",
   "jp": "はい　お任せください",
   "en": "",
   "op": "0x62",
   "msg": "0x2e7c"
  },
  {
   "id": "b_004001:0xc4a0",
   "off": 50336,
   "max": 68,
   "kind": "dialogue",
   "jp": "土方さん　行きましょう\\nそんな顔で公の場にいると\\n煌が減りますから",
   "en": "",
   "op": "0x62",
   "msg": "0x2e7d"
  },
  {
   "id": "b_004001:0xc960",
   "off": 51552,
   "max": 24,
   "kind": "dialogue",
   "jp": "………………\\nわかった",
   "en": "",
   "op": "0x62",
   "msg": "0x2e7e"
  },
  {
   "id": "b_004001:0xcef4",
   "off": 52980,
   "max": 68,
   "kind": "dialogue",
   "jp": "土方は沖田の言葉に頷くと\\n彼と共に人通りの少ない\\n路地裏へ向かった",
   "en": "",
   "op": "0x62",
   "msg": "0x2e7f"
  },
  {
   "id": "b_004001:0xd6ac",
   "off": 54956,
   "max": 40,
   "kind": "dialogue",
   "jp": "ふぅ……\\nここまで来れば\\n大丈夫か……",
   "en": "",
   "op": "0x62",
   "msg": "0x2e80"
  },
  {
   "id": "b_004001:0xdd18",
   "off": 56600,
   "max": 16,
   "kind": "dialogue",
   "jp": "………………",
   "en": "",
   "op": "0x62",
   "msg": "0x2e81"
  },
  {
   "id": "b_004001:0xe5f0",
   "off": 58864,
   "max": 68,
   "kind": "dialogue",
   "jp": "ちょっと土方さん\\nいつまでムクれてるんです\\nいい加減にして下さいよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e82"
  },
  {
   "id": "b_004001:0xeb4c",
   "off": 60236,
   "max": 36,
   "kind": "dialogue",
   "jp": "……俺なりに\\n注意を払ってはいる",
   "en": "",
   "op": "0x62",
   "msg": "0x2e83"
  },
  {
   "id": "b_004001:0xeb80",
   "off": 60288,
   "max": 64,
   "kind": "dialogue",
   "jp": "だが奴らの事を考えると\\nどうしても表情が\\n強張ってしまうんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e84"
  },
  {
   "id": "b_004001:0xf03c",
   "off": 61500,
   "max": 36,
   "kind": "dialogue",
   "jp": "奴らって　\\nトサカくん達の事ですか",
   "en": "",
   "op": "0x62",
   "msg": "0x2e85"
  },
  {
   "id": "b_004001:0xf4dc",
   "off": 62684,
   "max": 8,
   "kind": "dialogue",
   "jp": "ああ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e86"
  },
  {
   "id": "b_004001:0xf960",
   "off": 63840,
   "max": 20,
   "kind": "dialogue",
   "jp": "はあ　やっぱりね",
   "en": "",
   "op": "0x62",
   "msg": "0x2e87"
  },
  {
   "id": "b_004001:0x10104",
   "off": 65796,
   "max": 64,
   "kind": "dialogue",
   "jp": "奴らは　俺達の目を盗み\\n毎日のように突風雷舞を\\nおこなっている",
   "en": "",
   "op": "0x62",
   "msg": "0x2e88"
  },
  {
   "id": "b_004001:0x10154",
   "off": 65876,
   "max": 64,
   "kind": "dialogue",
   "jp": "こんな暴挙は許せない\\n一刻も早く　俺達の手で\\n捕まえなければ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e89"
  },
  {
   "id": "b_004001:0x106ac",
   "off": 67244,
   "max": 48,
   "kind": "dialogue",
   "jp": "だがあと一歩のところで\\nいつも逃げられてしまう",
   "en": "",
   "op": "0x62",
   "msg": "0x2e8a"
  },
  {
   "id": "b_004001:0x106ec",
   "off": 67308,
   "max": 48,
   "kind": "dialogue",
   "jp": "俺達は　\\nたった三人の男に\\n振り回されている",
   "en": "",
   "op": "0x62",
   "msg": "0x2e8b"
  },
  {
   "id": "b_004001:0x10f2c",
   "off": 69420,
   "max": 24,
   "kind": "dialogue",
   "jp": "こんな屈辱は初めてだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e8c"
  },
  {
   "id": "b_004001:0x10f5c",
   "off": 69468,
   "max": 76,
   "kind": "dialogue",
   "jp": "今日こそ奴らを捕まえて\\n目玉をくり抜き　口を裂き\\nありとあらゆる罰を与え",
   "en": "",
   "op": "0x62",
   "msg": "0x2e8d"
  },
  {
   "id": "b_004001:0x11514",
   "off": 70932,
   "max": 24,
   "kind": "dialogue",
   "jp": "釜茹でにしてやる……",
   "en": "",
   "op": "0x62",
   "msg": "0x2e8e"
  },
  {
   "id": "b_004001:0x11c48",
   "off": 72776,
   "max": 24,
   "kind": "dialogue",
   "jp": "あ　それ良いですねー",
   "en": "",
   "op": "0x62",
   "msg": "0x2e8f"
  },
  {
   "id": "b_004001:0x122d8",
   "off": 74456,
   "max": 56,
   "kind": "dialogue",
   "jp": "でも釜茹でよりも\\n油でこんがり揚げる方が\\n僕の好みかな",
   "en": "",
   "op": "0x62",
   "msg": "0x2e90"
  },
  {
   "id": "b_004001:0x12bd0",
   "off": 76752,
   "max": 40,
   "kind": "dialogue",
   "jp": "坂本　高杉　桂\\n今日がお前達の命日だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e91"
  },
  {
   "id": "b_004001:0x1322c",
   "off": 78380,
   "max": 48,
   "kind": "dialogue",
   "jp": "土方は\\n道端の小石を睨み付け\\n乱暴に蹴り上げる",
   "en": "",
   "op": "0x62",
   "msg": "0x2e92"
  },
  {
   "id": "b_004001:0x1326c",
   "off": 78444,
   "max": 92,
   "kind": "dialogue",
   "jp": "宙に浮いた小石は弧を描き\\n前方の瓦落多（ガラクタ）\\n置き場に\\nコツンと音を立てて当たった",
   "en": "",
   "op": "0x62",
   "msg": "0x2e93"
  },
  {
   "id": "b_004001:0x132d8",
   "off": 78552,
   "max": 12,
   "kind": "dialogue",
   "jp": "……すると",
   "en": "",
   "op": "0x62",
   "msg": "0x2e94"
  },
  {
   "id": "b_004001:0x1374c",
   "off": 79692,
   "max": 12,
   "kind": "dialogue",
   "jp": "くぅん……",
   "en": "",
   "op": "0x62",
   "msg": "0x2e95"
  },
  {
   "id": "b_004001:0x13be8",
   "off": 80872,
   "max": 68,
   "kind": "dialogue",
   "jp": "瓦落多置き場の中から\\nもじゃもじゃ頭の男が\\nひょっこりと顔を出した",
   "en": "",
   "op": "0x62",
   "msg": "0x2e96"
  },
  {
   "id": "b_004001:0x14078",
   "off": 82040,
   "max": 12,
   "kind": "dialogue",
   "jp": "む……？",
   "en": "",
   "op": "0x62",
   "msg": "0x2e97"
  },
  {
   "id": "b_004001:0x146c4",
   "off": 83652,
   "max": 12,
   "kind": "dialogue",
   "jp": "……あれ",
   "en": "",
   "op": "0x62",
   "msg": "0x2e98"
  },
  {
   "id": "b_004001:0x146e0",
   "off": 83680,
   "max": 44,
   "kind": "dialogue",
   "jp": "もしかして　\\nそこにいるのは\\nトサカくん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2e99"
  },
  {
   "id": "b_004001:0x14e90",
   "off": 85648,
   "max": 12,
   "kind": "dialogue",
   "jp": "くぅ……？",
   "en": "",
   "op": "0x62",
   "msg": "0x2e9a"
  },
  {
   "id": "b_004001:0x1532c",
   "off": 86828,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方と沖田は　\\n突然現れた男の顔を\\nまじまじと凝視した",
   "en": "",
   "op": "0x62",
   "msg": "0x2e9b"
  },
  {
   "id": "b_004001:0x158e8",
   "off": 88296,
   "max": 44,
   "kind": "dialogue",
   "jp": "……このニヤけた顔\\n間違いなく　坂本だな",
   "en": "",
   "op": "0x62",
   "msg": "0x2e9c"
  },
  {
   "id": "b_004001:0x15d90",
   "off": 89488,
   "max": 64,
   "kind": "dialogue",
   "jp": "ですね　トサカくんです\\nけど何でこんな所に\\nいるんでしょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2e9d"
  },
  {
   "id": "b_004001:0x1624c",
   "off": 90700,
   "max": 60,
   "kind": "dialogue",
   "jp": "それも気になるが\\n俺達が近づいても\\nなぜ逃げようとしない",
   "en": "",
   "op": "0x62",
   "msg": "0x2e9e"
  },
  {
   "id": "b_004001:0x16704",
   "off": 91908,
   "max": 44,
   "kind": "dialogue",
   "jp": "さあ　わかりません\\nトサカくん　どうして？",
   "en": "",
   "op": "0x62",
   "msg": "0x2e9f"
  },
  {
   "id": "b_004001:0x16bac",
   "off": 93100,
   "max": 24,
   "kind": "dialogue",
   "jp": "大人しく答えろ\\n坂本",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea0"
  },
  {
   "id": "b_004001:0x17350",
   "off": 95056,
   "max": 12,
   "kind": "dialogue",
   "jp": "くぅん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea1"
  },
  {
   "id": "b_004001:0x177ec",
   "off": 96236,
   "max": 60,
   "kind": "dialogue",
   "jp": "眼光鋭く問い詰める\\n土方を\\n龍馬はつぶらな瞳で\\n見つめ返す",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea2"
  },
  {
   "id": "b_004001:0x17838",
   "off": 96312,
   "max": 12,
   "kind": "dialogue",
   "jp": "そして……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea3"
  },
  {
   "id": "b_004001:0x17e44",
   "off": 97860,
   "max": 12,
   "kind": "dialogue",
   "jp": "きゃわんっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea4"
  },
  {
   "id": "b_004001:0x18364",
   "off": 99172,
   "max": 28,
   "kind": "dialogue",
   "jp": "土方に\\n勢いよく抱きついた",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea5"
  },
  {
   "id": "b_004001:0x18fa4",
   "off": 102308,
   "max": 48,
   "kind": "dialogue",
   "jp": "んな\\nさささささ坂本っ　\\nどういうつもりだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea6"
  },
  {
   "id": "b_004001:0x19460",
   "off": 103520,
   "max": 40,
   "kind": "dialogue",
   "jp": "きゃわん　きゃわんっ\\nわわん　わわんっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea7"
  },
  {
   "id": "b_004001:0x199a8",
   "off": 104872,
   "max": 52,
   "kind": "dialogue",
   "jp": "おい　こらっ\\n顔を近づけるな\\n頬ずりをするなっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea8"
  },
  {
   "id": "b_004001:0x1a26c",
   "off": 107116,
   "max": 60,
   "kind": "dialogue",
   "jp": "ん～～　トサカくんの\\n様子が明らかに変だ\\nまるで犬みたい",
   "en": "",
   "op": "0x62",
   "msg": "0x2ea9"
  },
  {
   "id": "b_004001:0x1a8f4",
   "off": 108788,
   "max": 16,
   "kind": "dialogue",
   "jp": "くっ……確かに",
   "en": "",
   "op": "0x62",
   "msg": "0x2eaa"
  },
  {
   "id": "b_004001:0x1a914",
   "off": 108820,
   "max": 56,
   "kind": "dialogue",
   "jp": "この懐きようは　\\n主人に尻尾を振る犬\\nそっくりだな……",
   "en": "",
   "op": "0x62",
   "msg": "0x2eab"
  },
  {
   "id": "b_004001:0x1adc8",
   "off": 110024,
   "max": 64,
   "kind": "dialogue",
   "jp": "そうですねー\\nどうしてトサカくんは\\n犬の真似をしてるんだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x2eac"
  },
  {
   "id": "b_004001:0x1aeb0",
   "off": 110256,
   "max": 60,
   "kind": "dialogue",
   "jp": "まさか　何か企んでる？\\n僕らを罠に掛けようと\\nしてるとか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ead"
  },
  {
   "id": "b_004001:0x1aefc",
   "off": 110332,
   "max": 72,
   "kind": "dialogue",
   "jp": "土方さんが動物好きだと\\n見抜いて　犬の真似を\\nしてるなら侮れないなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2eae"
  },
  {
   "id": "b_004001:0x1afec",
   "off": 110572,
   "max": 72,
   "kind": "dialogue",
   "jp": "でも　細かい事はいっか！\\n敵に抵抗される前に\\nやっちゃえば良いだけだし",
   "en": "",
   "op": "0x62",
   "msg": "0x2eaf"
  },
  {
   "id": "b_004001:0x1b044",
   "off": 110660,
   "max": 52,
   "kind": "dialogue",
   "jp": "ねえねえ　土方さん\\n取り乱すのは\\nそこら辺にして",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb0"
  },
  {
   "id": "b_004001:0x1b128",
   "off": 110888,
   "max": 56,
   "kind": "dialogue",
   "jp": "トサカくんの目玉を\\nさっさと\\nくり抜いちゃいましょうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb1"
  },
  {
   "id": "b_004001:0x1b5dc",
   "off": 112092,
   "max": 52,
   "kind": "dialogue",
   "jp": "あ……ああ　そうだな\\n様子がおかしくても\\n敵は敵だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb2"
  },
  {
   "id": "b_004001:0x1c02c",
   "off": 114732,
   "max": 36,
   "kind": "dialogue",
   "jp": "今ここで　\\n俺が罰を与えてやる",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb3"
  },
  {
   "id": "b_004001:0x1c698",
   "off": 116376,
   "max": 44,
   "kind": "dialogue",
   "jp": "土方は気を取り直すと\\n龍馬を再び睨みつけた",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb4"
  },
  {
   "id": "b_004001:0x1cf2c",
   "off": 118572,
   "max": 16,
   "kind": "dialogue",
   "jp": "……くぅぅん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb5"
  },
  {
   "id": "b_004001:0x1d414",
   "off": 119828,
   "max": 44,
   "kind": "dialogue",
   "jp": "ぐっ……\\nそんなつぶらな瞳で\\n俺を見るなっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb6"
  },
  {
   "id": "b_004001:0x1dac8",
   "off": 121544,
   "max": 44,
   "kind": "dialogue",
   "jp": "土方はうろたえながら\\n龍馬の目元を拭った",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb7"
  },
  {
   "id": "b_004001:0x1e074",
   "off": 122996,
   "max": 36,
   "kind": "dialogue",
   "jp": "ちょっと土方さん\\n何　してるんです",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb8"
  },
  {
   "id": "b_004001:0x1e778",
   "off": 124792,
   "max": 52,
   "kind": "dialogue",
   "jp": "はっ\\nこ　これは　つい\\n坂本が本物の犬に見えて",
   "en": "",
   "op": "0x62",
   "msg": "0x2eb9"
  },
  {
   "id": "b_004001:0x1eccc",
   "off": 126156,
   "max": 44,
   "kind": "dialogue",
   "jp": "睫毛についていた埃を\\n取ってしまった……",
   "en": "",
   "op": "0x62",
   "msg": "0x2eba"
  },
  {
   "id": "b_004001:0x1f290",
   "off": 127632,
   "max": 60,
   "kind": "dialogue",
   "jp": "ふーん？\\nなら先に　トサカくんの\\n口を裂いちゃいましょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x2ebb"
  },
  {
   "id": "b_004001:0x1f8b8",
   "off": 129208,
   "max": 40,
   "kind": "dialogue",
   "jp": "あ　ああ　そうだな\\n坂本　じっとしてろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ebc"
  },
  {
   "id": "b_004001:0x20104",
   "off": 131332,
   "max": 36,
   "kind": "dialogue",
   "jp": "今度こそ　\\nお前に罰を与えてやる！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ebd"
  },
  {
   "id": "b_004001:0x208f4",
   "off": 133364,
   "max": 20,
   "kind": "dialogue",
   "jp": "……きゅぅぅん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ebe"
  },
  {
   "id": "b_004001:0x21100",
   "off": 135424,
   "max": 48,
   "kind": "dialogue",
   "jp": "ぐっ……ぐぅぅぅっ\\n切なそうに鼻を鳴らすなっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ebf"
  },
  {
   "id": "b_004001:0x216ac",
   "off": 136876,
   "max": 40,
   "kind": "dialogue",
   "jp": "土方は龍馬の口元に\\n布を強く押しあてた",
   "en": "",
   "op": "0x62",
   "msg": "0x2ec0"
  },
  {
   "id": "b_004001:0x21b14",
   "off": 138004,
   "max": 60,
   "kind": "dialogue",
   "jp": "って　土方さん\\n今度はトサカくんの口元を\\n拭ってあげてるし",
   "en": "",
   "op": "0x62",
   "msg": "0x2ec1"
  },
  {
   "id": "b_004001:0x22194",
   "off": 139668,
   "max": 36,
   "kind": "dialogue",
   "jp": "し　仕方ないだろう\\n坂本の口元に",
   "en": "",
   "op": "0x62",
   "msg": "0x2ec2"
  },
  {
   "id": "b_004001:0x221c8",
   "off": 139720,
   "max": 44,
   "kind": "dialogue",
   "jp": "食いかすのような物が\\nついていたからな……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ec3"
  },
  {
   "id": "b_004001:0x22678",
   "off": 140920,
   "max": 24,
   "kind": "dialogue",
   "jp": "あーもう　じれったい",
   "en": "",
   "op": "0x62",
   "msg": "0x2ec4"
  },
  {
   "id": "b_004001:0x22738",
   "off": 141112,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方さん　屯所に戻って\\nトサカくんを釜茹でに\\nしましょうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ec5"
  },
  {
   "id": "b_004001:0x22bf0",
   "off": 142320,
   "max": 60,
   "kind": "dialogue",
   "jp": "そ　そうだな\\n瓦落多置き場に居たから\\n体が汚れてるだろうし",
   "en": "",
   "op": "0x62",
   "msg": "0x2ec6"
  },
  {
   "id": "b_004001:0x22cd8",
   "off": 142552,
   "max": 32,
   "kind": "dialogue",
   "jp": "釜茹でにして\\n綺麗にしてやろう",
   "en": "",
   "op": "0x62",
   "msg": "0x2ec7"
  },
  {
   "id": "b_004001:0x2320c",
   "off": 143884,
   "max": 16,
   "kind": "dialogue",
   "jp": "綺麗にって……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ec8"
  },
  {
   "id": "b_004001:0x2322c",
   "off": 143916,
   "max": 60,
   "kind": "dialogue",
   "jp": "まさかトサカくんを\\n適温のお湯に入れてあげる\\nつもりですか",
