   "off": 120900,
   "max": 28,
   "kind": "dialogue",
   "jp": "違うでしょ？\\n笑顔でしょ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2db4"
  },
  {
   "id": "b_005001:0x1dcdc",
   "off": 122076,
   "max": 40,
   "kind": "dialogue",
   "jp": "あふ～ん……\\nありがとうございます",
   "en": "",
   "op": "0x62",
   "msg": "0x2db5"
  },
  {
   "id": "b_005001:0x1e218",
   "off": 123416,
   "max": 40,
   "kind": "dialogue",
   "jp": "何　嬉しそうな顔してるの\\n違うでしょ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2db6"
  },
  {
   "id": "b_005001:0x1e250",
   "off": 123472,
   "max": 60,
   "kind": "dialogue",
   "jp": "僕たちは喜ばせる側\\nそれなのに　喜んじゃって\\nどうするの？",
   "en": "",
   "op": "0x62",
   "msg": "0x2db7"
  },
  {
   "id": "b_005001:0x1e918",
   "off": 125208,
   "max": 64,
   "kind": "dialogue",
   "jp": "あは～ん……\\n我々は皆を喜ばせるために\\n存在するのであります！",
   "en": "",
   "op": "0x62",
   "msg": "0x2db8"
  },
  {
   "id": "b_005001:0x1f2e0",
   "off": 127712,
   "max": 36,
   "kind": "dialogue",
   "jp": "速度（ペース）が\\n落ちているぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x2db9"
  },
  {
   "id": "b_005001:0x1fb58",
   "off": 129880,
   "max": 24,
   "kind": "dialogue",
   "jp": "さー　えっさっさー",
   "en": "",
   "op": "0x62",
   "msg": "0x2dba"
  },
  {
   "id": "b_005001:0x202f0",
   "off": 131824,
   "max": 12,
   "kind": "dialogue",
   "jp": "次は……",
   "en": "",
   "op": "0x62",
   "msg": "0x2dbb"
  },
  {
   "id": "b_005001:0x20998",
   "off": 133528,
   "max": 20,
   "kind": "dialogue",
   "jp": "……はぁ……はぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2dbc"
  },
  {
   "id": "b_005001:0x211b8",
   "off": 135608,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ニヤリ",
   "en": "",
   "op": "0x62",
   "msg": "0x2dbd"
  },
  {
   "id": "b_005001:0x212f0",
   "off": 135920,
   "max": 40,
   "kind": "dialogue",
   "jp": "と　思わせといて\\nそこのトサカ頭くん",
   "en": "",
   "op": "0x62",
   "msg": "0x2dbe"
  },
  {
   "id": "b_005001:0x21af0",
   "off": 137968,
   "max": 56,
   "kind": "dialogue",
   "jp": "お？　わ　わしか？\\nじゃなかった\\nさー　えっさっさー！",
   "en": "",
   "op": "0x62",
   "msg": "0x2dbf"
  },
  {
   "id": "b_005001:0x2203c",
   "off": 139324,
   "max": 44,
   "kind": "dialogue",
   "jp": "近藤さんの素晴らしい\\nところを三つあげて",
   "en": "",
   "op": "0x62",
   "msg": "0x2dc0"
  },
  {
   "id": "b_005001:0x22584",
   "off": 140676,
   "max": 36,
   "kind": "dialogue",
   "jp": "そ　そんな急に言われても\\nわからん",
   "en": "",
   "op": "0x62",
   "msg": "0x2dc1"
  },
  {
   "id": "b_005001:0x22d44",
   "off": 142660,
   "max": 36,
   "kind": "dialogue",
   "jp": "バカ　ここは嘘でも\\n答えておくんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2dc2"
  },
  {
   "id": "b_005001:0x23514",
   "off": 144660,
   "max": 52,
   "kind": "dialogue",
   "jp": "正解\\n挙げたらきりがないし\\n三つに絞れないよね",
   "en": "",
   "op": "0x62",
   "msg": "0x2dc3"
  },
  {
   "id": "b_005001:0x235f8",
   "off": 144888,
   "max": 56,
   "kind": "dialogue",
   "jp": "トサカくんは\\n休んでいいよ～\\nてか　一緒にお茶しよう",
