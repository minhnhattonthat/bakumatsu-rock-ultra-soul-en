   "msg": "0x2e42"
  },
  {
   "id": "b_005001:0x56ab0",
   "off": 354992,
   "max": 64,
   "kind": "dialogue",
   "jp": "みんなの笑顔にこそ\\nロック魂は有るんじゃ\\nありがとうぜよ～",
