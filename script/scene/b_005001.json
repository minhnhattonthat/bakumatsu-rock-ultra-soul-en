   "msg": "0x2e41"
  },
  {
   "id": "b_005001:0x563f0",
   "off": 353264,
   "max": 40,
   "kind": "dialogue",
   "jp": "音楽に　天歌とロックに\\n垣根など無い",
   "en": "",
