   "op": "0x62",
   "msg": "0x2dd8"
  },
  {
   "id": "b_005001:0x2ba68",
   "off": 178792,
   "max": 28,
   "kind": "dialogue",
   "jp": "お母さんとか呼ぶなーー！",
