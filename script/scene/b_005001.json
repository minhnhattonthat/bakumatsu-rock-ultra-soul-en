   "op": "0x62",
   "msg": "0x2ddb"
  },
  {
   "id": "b_005001:0x2cf6c",
   "off": 184172,
   "max": 60,
   "kind": "dialogue",
   "jp": "でしょ？　だから\\nみんな掃除したがらなくて\\n困ってたんだ",
