   "op": "0x62",
   "msg": "0x2de4"
  },
  {
   "id": "b_005001:0x312a0",
   "off": 201376,
   "max": 20,
   "kind": "dialogue",
   "jp": "そんなことはないが",
   "en": "",
   "op": "0x62",
   "msg": "0x2de5"
  },
  {
   "id": "b_005001:0x31730",
   "off": 202544,
   "max": 24,
   "kind": "dialogue",
   "jp": "だったらいいじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x2de6"
  },
  {
   "id": "b_005001:0x32050",
   "off": 204880,
   "max": 20,
   "kind": "dialogue",
   "jp": "新選組が来たぞー",
   "en": "",
   "op": "0x62",
   "msg": "0x2de7"
  },
  {
   "id": "b_005001:0x328b8",
