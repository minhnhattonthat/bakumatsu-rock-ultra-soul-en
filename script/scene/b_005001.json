   "op": "0x62",
   "msg": "0x2ddc"
  },
  {
   "id": "b_005001:0x2d7a4",
   "off": 186276,
   "max": 32,
   "kind": "dialogue",
   "jp": "こういう時こそ\\n私の発明品！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ddd"
  },
  {
   "id": "b_005001:0x2e1bc",
   "off": 188860,
   "max": 72,
   "kind": "dialogue",
   "jp": "この砕芥露（サイクロフ）\\n掃除機と除処（ジョカー）\\nハタキの出番ですね",
