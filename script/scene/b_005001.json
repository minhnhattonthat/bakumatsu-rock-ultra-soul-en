   "id": "b_005001:0x2fd18",
   "off": 195864,
   "max": 52,
   "kind": "dialogue",
   "jp": "あれ　沖田くん？\\n沖田くん？\\nちょっとドア開かない",
   "en": "",
   "op": "0x62",
   "msg": "0x2de2"
  },
  {
   "id": "b_005001:0x306e8",
