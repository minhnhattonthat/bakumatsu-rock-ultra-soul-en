   "op": "0x62",
   "msg": "0x2df1"
  },
  {
   "id": "b_005001:0x37068",
   "off": 225384,
   "max": 28,
   "kind": "dialogue",
   "jp": "あ　あの人は\\n初めて見るわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2df2"
  },
