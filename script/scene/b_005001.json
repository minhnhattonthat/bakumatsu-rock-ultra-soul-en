   "op": "0x62",
   "msg": "0x2deb"
  },
  {
   "id": "b_005001:0x34bd8",
   "off": 216024,
   "max": 24,
   "kind": "dialogue",
   "jp": "飛べ！　舞え！　歌え！",
   "en": "",
   "op": "0x62",
   "msg": "0x2dec"
  },
  {
   "id": "b_005001:0x354c0",
   "off": 218304,
   "max": 32,
   "kind": "dialogue",
   "jp": "アレは\\n何をやっとるんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ded"
  },
  {
   "id": "b_005001:0x3595c",
   "off": 219484,
   "max": 88,
   "kind": "dialogue",
   "jp": "精神鍛錬\\n（イメージトレーニング）だよ\\n舞台であがったりしない\\nような心構えを作るんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2dee"
  },
  {
   "id": "b_005001:0x35ec8",
   "off": 220872,
   "max": 44,
   "kind": "dialogue",
   "jp": "街の中を走りながらか？\\n変な鍛錬じゃのう",
   "en": "",
   "op": "0x62",
   "msg": "0x2def"
  },
