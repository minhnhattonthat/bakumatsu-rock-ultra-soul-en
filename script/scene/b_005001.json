   "op": "0x62",
   "msg": "0x2e40"
  },
  {
   "id": "b_005001:0x55df4",
   "off": 351732,
   "max": 76,
   "kind": "dialogue",
   "jp": "新選組と出会ったことで\\n龍馬達は新しいロック魂を\\n手に入れることができた",
