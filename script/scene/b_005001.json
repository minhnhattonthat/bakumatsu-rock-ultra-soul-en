{
 "source": "b_005001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_005001:0x10e8",
   "off": 4328,
   "max": 92,
   "kind": "dialogue",
   "jp": "これは龍馬たちと新選組が\\nまだ相容れなかった頃に\\nもしかしたらあったかも\\nしれない話……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d6e"
  },
  {
   "id": "b_005001:0x1584",
   "off": 5508,
   "max": 40,
   "kind": "dialogue",
   "jp": "……それにしても\\n新選組は強力じゃなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d6f"
  },
  {
   "id": "b_005001:0x1bf0",
   "off": 7152,
   "max": 72,
   "kind": "dialogue",
   "jp": "ああ……他の皆はロックで\\n天歌の洗脳が解けるのに\\n愛獲煌達に変化は無い",
   "en": "",
   "op": "0x62",
   "msg": "0x2d70"
  },
  {
   "id": "b_005001:0x22d4",
   "off": 8916,
   "max": 44,
   "kind": "dialogue",
   "jp": "……一体　どこに\\nその秘密があるのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d71"
  },
  {
   "id": "b_005001:0x2b10",
   "off": 11024,
   "max": 36,
   "kind": "dialogue",
   "jp": "ふ～ん\\nそんなに\\n知りたいのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d72"
  },
  {
   "id": "b_005001:0x3498",
   "off": 13464,
   "max": 32,
   "kind": "dialogue",
   "jp": "うわわ\\nあんた　新選組の……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d73"
  },
  {
   "id": "b_005001:0x3af4",
   "off": 15092,
   "max": 60,
   "kind": "dialogue",
   "jp": "やあ　局長の近藤だ\\n君達が突風雷舞をしている\\nお尋ね者だな",
   "en": "",
   "op": "0x62",
   "msg": "0x2d74"
  },
  {
   "id": "b_005001:0x4044",
   "off": 16452,
   "max": 56,
   "kind": "dialogue",
   "jp": "すごい笑顔ぜよ　なあ\\n握手をしてもらっても\\nいいか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d75"
  },
  {
   "id": "b_005001:0x487c",
   "off": 18556,
   "max": 24,
   "kind": "dialogue",
   "jp": "だ　だめだよ\\n龍馬くん",
   "en": "",
   "op": "0x62",
   "msg": "0x2d76"
  },
  {
   "id": "b_005001:0x4d10",
   "off": 19728,
   "max": 28,
   "kind": "dialogue",
   "jp": "かまわないよ\\nはっはっは",
   "en": "",
   "op": "0x62",
   "msg": "0x2d77"
  },
  {
   "id": "b_005001:0x5548",
   "off": 21832,
   "max": 44,
   "kind": "dialogue",
   "jp": "おい　相手は幕府の手先だ\\n何やってんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d78"
  },
  {
   "id": "b_005001:0x5bc8",
   "off": 23496,
   "max": 44,
   "kind": "dialogue",
   "jp": "な　なんか　笑顔に\\n乗せられてしまった……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d79"
  },
  {
   "id": "b_005001:0x6180",
   "off": 24960,
   "max": 36,
   "kind": "dialogue",
   "jp": "バカ　簡単に\\n騙されるんじゃねぇ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d7a"
  },
  {
   "id": "b_005001:0x6a48",
   "off": 27208,
   "max": 56,
   "kind": "dialogue",
   "jp": "騙してはいないさ\\n俺は君達と仲良く\\nなりたいだけなんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d7b"
  },
  {
   "id": "b_005001:0x71bc",
   "off": 29116,
   "max": 60,
   "kind": "dialogue",
   "jp": "……な　なんだ\\nこの警戒心を破壊する\\n爽やかな笑顔は……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d7c"
  },
  {
   "id": "b_005001:0x7b14",
   "off": 31508,
   "max": 36,
   "kind": "dialogue",
   "jp": "はっはっは\\nよろしくな\\n高杉くん",
   "en": "",
   "op": "0x62",
   "msg": "0x2d7d"
  },
  {
   "id": "b_005001:0x8444",
   "off": 33860,
   "max": 44,
   "kind": "dialogue",
   "jp": "……う……幕府も\\n新選組も嫌いだ\\nだが……",
   "en": "",
   "op": "0x62",
   "msg": "0x2d7e"
  },
  {
   "id": "b_005001:0x8524",
   "off": 34084,
   "max": 48,
   "kind": "dialogue",
   "jp": "べ　別に　お前のことまで\\n嫌いじゃないんだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d7f"
  },
  {
   "id": "b_005001:0x8748",
   "off": 34632,
   "max": 32,
   "kind": "dialogue",
   "jp": "……とかいう気分に\\nなってきた",
   "en": "",
   "op": "0x62",
   "msg": "0x2d80"
  },
  {
   "id": "b_005001:0x8cf4",
   "off": 36084,
   "max": 60,
   "kind": "dialogue",
   "jp": "これこそが　新選組の持つ\\n不思議な力……\\nそう　言うなれば",
   "en": "",
   "op": "0x62",
   "msg": "0x2d81"
  },
  {
   "id": "b_005001:0x8fdc",
   "off": 36828,
   "max": 36,
   "kind": "dialogue",
   "jp": "笑顔ノ魔法\\n（マジカルスマイル）",
   "en": "",
   "op": "0x62",
   "msg": "0x2d82"
  },
  {
   "id": "b_005001:0x9a30",
   "off": 39472,
   "max": 36,
   "kind": "dialogue",
   "jp": "笑顔ノ魔法……\\n恐ろしい技ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x2d83"
  },
  {
   "id": "b_005001:0xa0ec",
   "off": 41196,
   "max": 40,
   "kind": "dialogue",
   "jp": "ああ　このオッサン\\nわしは　好きぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d84"
  },
  {
   "id": "b_005001:0xa124",
   "off": 41252,
   "max": 44,
   "kind": "dialogue",
   "jp": "前にも親切にしてもらった\\nことがあるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d85"
  },
  {
   "id": "b_005001:0xa878",
   "off": 43128,
   "max": 48,
   "kind": "dialogue",
   "jp": "ば　バカ\\n惑わされるな\\nそれが奴等の手だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d86"
  },
  {
   "id": "b_005001:0xaf40",
   "off": 44864,
   "max": 36,
   "kind": "dialogue",
   "jp": "なあ　あんたも\\nロック好きなんか",
   "en": "",
   "op": "0x62",
   "msg": "0x2d87"
  },
  {
   "id": "b_005001:0xb47c",
   "off": 46204,
   "max": 48,
   "kind": "dialogue",
   "jp": "音を奏でる　歌を歌う\\nそれに何か名前は必要か",
   "en": "",
   "op": "0x62",
   "msg": "0x2d88"
  },
  {
   "id": "b_005001:0xb560",
   "off": 46432,
   "max": 24,
   "kind": "dialogue",
   "jp": "否！\\n必要なのは愛だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d89"
  },
  {
   "id": "b_005001:0xbc1c",
   "off": 48156,
   "max": 44,
   "kind": "dialogue",
   "jp": "愛……素晴らしいです\\n尊敬してしまいそう～",
   "en": "",
   "op": "0x62",
   "msg": "0x2d8a"
  },
  {
   "id": "b_005001:0xc338",
   "off": 49976,
   "max": 20,
   "kind": "dialogue",
   "jp": "か　桂さんまで",
   "en": "",
   "op": "0x62",
   "msg": "0x2d8b"
  },
  {
   "id": "b_005001:0xc864",
   "off": 51300,
   "max": 40,
   "kind": "dialogue",
   "jp": "高杉くんは何か\\n誤解しているようだが",
   "en": "",
   "op": "0x62",
   "msg": "0x2d8c"
  },
  {
   "id": "b_005001:0xc89c",
   "off": 51356,
   "max": 68,
   "kind": "dialogue",
   "jp": "新選組は天歌で人々の心を\\n掴んでいるのではない……\\n天歌は手段だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d8d"
  },
  {
   "id": "b_005001:0xd2c0",
   "off": 53952,
   "max": 64,
   "kind": "dialogue",
   "jp": "そう　すべては歌で\\n愛と平和を築くため\\n愛獲活動をしている",
   "en": "",
   "op": "0x62",
   "msg": "0x2d8e"
  },
  {
   "id": "b_005001:0xda6c",
   "off": 55916,
   "max": 64,
   "kind": "dialogue",
   "jp": "こいつ　頭大丈夫か？\\nとか思わなくもないが\\n……嫌いじゃないぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d8f"
  },
  {
   "id": "b_005001:0xe548",
   "off": 58696,
   "max": 16,
   "kind": "dialogue",
   "jp": "新選組　集合",
   "en": "",
   "op": "0x62",
   "msg": "0x2d90"
  },
  {
   "id": "b_005001:0xea34",
   "off": 59956,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方の声に\\n練習のために散っていた\\n隊士達の手が止まる",
   "en": "",
   "op": "0x62",
   "msg": "0x2d91"
  },
  {
   "id": "b_005001:0xeeb0",
   "off": 61104,
   "max": 64,
   "kind": "dialogue",
   "jp": "皆　元気にしていたか？\\n今日は　新選組の\\n新しい仲間を紹介する",
   "en": "",
   "op": "0x62",
   "msg": "0x2d92"
  },
  {
   "id": "b_005001:0xef00",
   "off": 61184,
   "max": 48,
   "kind": "dialogue",
   "jp": "坂本龍馬くん\\n高杉晋作くん\\n桂小五郎くん　だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d93"
  },
  {
   "id": "b_005001:0xf838",
   "off": 63544,
   "max": 8,
   "kind": "dialogue",
   "jp": "なっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d94"
  },
  {
   "id": "b_005001:0x10170",
   "off": 65904,
   "max": 36,
   "kind": "dialogue",
   "jp": "坂本龍馬じゃ\\nよろしく頼むぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2d95"
  },
  {
   "id": "b_005001:0x10a28",
   "off": 68136,
   "max": 20,
   "kind": "dialogue",
   "jp": "……た　高杉晋作だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d96"
  },
  {
   "id": "b_005001:0x112d0",
   "off": 70352,
   "max": 36,
   "kind": "dialogue",
   "jp": "桂小五郎です\\nよろしくお願いします",
   "en": "",
   "op": "0x62",
   "msg": "0x2d97"
  },
  {
   "id": "b_005001:0x11a1c",
   "off": 72220,
   "max": 36,
   "kind": "dialogue",
   "jp": "近藤さん\\nあの　こいつらは……？",
   "en": "",
   "op": "0x62",
   "msg": "0x2d98"
  },
  {
   "id": "b_005001:0x12084",
   "off": 73860,
   "max": 44,
   "kind": "dialogue",
   "jp": "俺が町で\\n勧誘（スカウト）\\nしてきたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d99"
  },
  {
   "id": "b_005001:0x1283c",
   "off": 75836,
   "max": 64,
   "kind": "dialogue",
   "jp": "わあ　後輩が出来るなんて\\n嬉しいな　僕は沖田総司\\nよろしくね～",
   "en": "",
   "op": "0x62",
   "msg": "0x2d9a"
  },
  {
   "id": "b_005001:0x12ebc",
   "off": 77500,
   "max": 68,
   "kind": "dialogue",
   "jp": "おお　さすが新選組\\nソウちんはいい男じゃな～\\nよろしく頼むぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2d9b"
  },
  {
   "id": "b_005001:0x1359c",
   "off": 79260,
   "max": 60,
   "kind": "dialogue",
   "jp": "だろう？\\n総司は本当にいい男なんだ\\n坂本は見る目があるな",
   "en": "",
   "op": "0x62",
   "msg": "0x2d9c"
  },
  {
   "id": "b_005001:0x13d64",
   "off": 81252,
   "max": 44,
   "kind": "dialogue",
   "jp": "そんな……近藤さんたら\\n照れちゃいますよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2d9d"
  },
  {
   "id": "b_005001:0x14434",
   "off": 82996,
   "max": 24,
   "kind": "dialogue",
   "jp": "……けっ\\nぶりっ子が",
   "en": "",
   "op": "0x62",
   "msg": "0x2d9e"
  },
  {
   "id": "b_005001:0x14a8c",
   "off": 84620,
   "max": 32,
   "kind": "dialogue",
   "jp": "あ　こっちの人も\\nよろしくね",
   "en": "",
   "op": "0x62",
   "msg": "0x2d9f"
  },
  {
   "id": "b_005001:0x15194",
   "off": 86420,
   "max": 68,
   "kind": "dialogue",
   "jp": "近藤さんに勧誘された\\nからって　いい気に\\nなってんじゃネェぞ　コラ",
   "en": "",
   "op": "0x62",
   "msg": "0x2da0"
  },
  {
   "id": "b_005001:0x157fc",
   "off": 88060,
   "max": 28,
   "kind": "dialogue",
   "jp": "こっちの人も\\nよろしく～",
   "en": "",
   "op": "0x62",
   "msg": "0x2da1"
  },
  {
   "id": "b_005001:0x15fa4",
   "off": 90020,
   "max": 16,
   "kind": "dialogue",
   "jp": "ど　どうも……",
   "en": "",
   "op": "0x62",
   "msg": "0x2da2"
  },
  {
   "id": "b_005001:0x165d0",
   "off": 91600,
   "max": 56,
   "kind": "dialogue",
   "jp": "僕より目立ったら\\n桂剥きにして\\n鴨川に浮かべるからね～",
   "en": "",
   "op": "0x62",
   "msg": "0x2da3"
  },
  {
   "id": "b_005001:0x16ba8",
   "off": 93096,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x2da4"
  },
  {
   "id": "b_005001:0x17424",
   "off": 95268,
   "max": 56,
   "kind": "dialogue",
   "jp": "ですから　近藤さん\\nこいつらは\\n幕府のお尋ね者の……",
   "en": "",
   "op": "0x62",
   "msg": "0x2da5"
  },
  {
   "id": "b_005001:0x17aa8",
   "off": 96936,
   "max": 56,
   "kind": "dialogue",
   "jp": "トシ……俺が勧誘して\\nきた人間が\\n認められないのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2da6"
  },
  {
   "id": "b_005001:0x17ff8",
   "off": 98296,
   "max": 32,
   "kind": "dialogue",
   "jp": "……うっ\\nそんなつもりでは……",
   "en": "",
   "op": "0x62",
   "msg": "0x2da7"
  },
  {
   "id": "b_005001:0x18494",
   "off": 99476,
   "max": 48,
   "kind": "dialogue",
   "jp": "まあ　いい\\nすぐに音を上げて本性を\\n現すだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x2da8"
  },
  {
   "id": "b_005001:0x18f64",
   "off": 102244,
   "max": 36,
   "kind": "dialogue",
   "jp": "訓練を開始する\\nまずは　走り込みだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2da9"
  },
  {
   "id": "b_005001:0x19758",
   "off": 104280,
   "max": 16,
   "kind": "dialogue",
   "jp": "さー　えっさー",
   "en": "",
   "op": "0x62",
   "msg": "0x2daa"
  },
  {
   "id": "b_005001:0x19ef4",
   "off": 106228,
   "max": 36,
   "kind": "dialogue",
   "jp": "はっ　ほっ　ほっ\\n割とふつうじゃの",
   "en": "",
   "op": "0x62",
   "msg": "0x2dab"
  },
  {
   "id": "b_005001:0x1a55c",
   "off": 107868,
   "max": 56,
   "kind": "dialogue",
   "jp": "ふっ　ふっ　ふっ\\nまあ　何をするにも\\n体力は基本だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2dac"
  },
  {
   "id": "b_005001:0x1adfc",
   "off": 110076,
   "max": 72,
   "kind": "dialogue",
   "jp": "走り込みくらいは……\\nし……していましたが\\nこういうのは……に　苦手",
   "en": "",
   "op": "0x62",
   "msg": "0x2dad"
  },
  {
   "id": "b_005001:0x1b334",
   "off": 111412,
   "max": 40,
   "kind": "dialogue",
   "jp": "ふっ　ふっ　ふっ\\n桂さんは　ひ弱すぎる",
   "en": "",
   "op": "0x62",
   "msg": "0x2dae"
  },
  {
   "id": "b_005001:0x1b9f4",
   "off": 113140,
   "max": 12,
   "kind": "dialogue",
   "jp": "じゃのう",
   "en": "",
   "op": "0x62",
   "msg": "0x2daf"
  },
  {
   "id": "b_005001:0x1c360",
   "off": 115552,
   "max": 48,
   "kind": "dialogue",
   "jp": "では　そろそろ\\n抜き打ち問答を\\n開始する　沖田",
   "en": "",
   "op": "0x62",
   "msg": "0x2db0"
  },
  {
   "id": "b_005001:0x1ca28",
   "off": 117288,
   "max": 76,
   "kind": "dialogue",
   "jp": "は～い　一番隊組長\\nそして新選組の\\n中央（センター）\\n沖田からみんなに質問",
   "en": "",
   "op": "0x62",
   "msg": "0x2db1"
  },
  {
   "id": "b_005001:0x1cb1c",
   "off": 117532,
   "max": 52,
   "kind": "dialogue",
   "jp": "愛獲に大切な物は\\nな～んだ？\\nそこの隊士こたえて",
   "en": "",
   "op": "0x62",
   "msg": "0x2db2"
  },
  {
   "id": "b_005001:0x1d190",
   "off": 119184,
   "max": 40,
   "kind": "dialogue",
   "jp": "さー　えっさー\\nまずは体力であります",
   "en": "",
   "op": "0x62",
   "msg": "0x2db3"
  },
  {
