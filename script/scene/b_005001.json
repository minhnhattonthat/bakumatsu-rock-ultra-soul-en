   "op": "0x62",
   "msg": "0x2de3"
  },
  {
   "id": "b_005001:0x30d50",
   "off": 200016,
   "max": 60,
   "kind": "dialogue",
   "jp": "いいのいいの\\nそれとも　メガネくんの\\n発明が信用出来ない？",
