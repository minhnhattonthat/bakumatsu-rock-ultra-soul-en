   "op": "0x62",
   "msg": "0x2de8"
  },
  {
   "id": "b_005001:0x331cc",
   "off": 209356,
   "max": 32,
   "kind": "dialogue",
   "jp": "とっても　凛々しい\\nこの踊りー",
   "en": "",
   "op": "0x62",
   "msg": "0x2de9"
  },
  {
   "id": "b_005001:0x33a4c",
