{
 "source": "b_007001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_007001:0x12f0",
   "off": 4848,
   "max": 48,
   "kind": "dialogue",
   "jp": "愛獲の僕が　\\nお使いなんて……\\n侮辱だよね～",
   "en": "",
   "op": "0x62",
   "msg": "0x2fda"
  },
  {
   "id": "b_007001:0x1330",
   "off": 4912,
   "max": 24,
   "kind": "dialogue",
   "jp": "土方さん　ひどいよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2fdb"
  },
  {
   "id": "b_007001:0x16f4",
   "off": 5876,
   "max": 68,
   "kind": "dialogue",
   "jp": "現在　テラーダでは\\n龍馬帰還と看板娘獲得記念\\n宴会が開かれている",
   "en": "",
   "op": "0x62",
   "msg": "0x2fdc"
  },
  {
   "id": "b_007001:0x1748",
   "off": 5960,
   "max": 92,
   "kind": "dialogue",
   "jp": "足りなくなった酒を\\n買うよう言いつけられた\\n沖田は　不満を顔に\\n浮かべて　道を\\n歩いていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2fdd"
  },
  {
   "id": "b_007001:0x1b44",
   "off": 6980,
   "max": 56,
   "kind": "dialogue",
   "jp": "まあ　酔っぱらいの中に\\nいるより　外の方が\\nマシかもね",
   "en": "",
   "op": "0x62",
   "msg": "0x2fde"
  },
  {
   "id": "b_007001:0x1b8c",
   "off": 7052,
   "max": 48,
   "kind": "dialogue",
   "jp": "でも　酒屋ってどこさ？\\n行き過ぎちゃったかな",
   "en": "",
   "op": "0x62",
   "msg": "0x2fdf"
  },
  {
   "id": "b_007001:0x20d0",
   "off": 8400,
   "max": 48,
   "kind": "dialogue",
   "jp": "ま　いっか　\\n夜のお散歩だ\\n月が綺麗だしね～",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe0"
  },
  {
   "id": "b_007001:0x2614",
   "off": 9748,
   "max": 60,
   "kind": "dialogue",
   "jp": "新選組にいる時には\\nこんな事　思ったりも\\nしなかったな……",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe1"
  },
  {
   "id": "b_007001:0x2c40",
   "off": 11328,
   "max": 80,
   "kind": "dialogue",
   "jp": "月の光に照らされて\\n沖田は自分の中に\\n穏やかな気持ちが\\n満ちていくのを感じる",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe2"
  },
  {
   "id": "b_007001:0x2ca0",
   "off": 11424,
   "max": 52,
   "kind": "dialogue",
   "jp": "月はまるで　近藤の笑顔の\\nようだと　沖田は思った",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe3"
  },
  {
   "id": "b_007001:0x2fdc",
   "off": 12252,
   "max": 60,
   "kind": "dialogue",
   "jp": "ねぇ……近藤さん\\n僕は元気にやってるよ\\n土方さんも　大丈夫",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe4"
  },
  {
   "id": "b_007001:0x302c",
   "off": 12332,
   "max": 52,
   "kind": "dialogue",
   "jp": "まだ　沈んでいるけど……\\nでも　悲しむ暇もないほど",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe5"
  },
  {
   "id": "b_007001:0x376c",
   "off": 14188,
   "max": 48,
   "kind": "dialogue",
   "jp": "トサカくんたちが　色々と\\nやらかしてくれるから",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe6"
  },
  {
   "id": "b_007001:0x3844",
   "off": 14404,
   "max": 36,
   "kind": "dialogue",
   "jp": "だから　心配しないでね\\n近藤さん",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe7"
  },
  {
   "id": "b_007001:0x3ce4",
   "off": 15588,
   "max": 60,
   "kind": "dialogue",
   "jp": "僕はもう迷わないよ\\n貴方がくれた命……\\n貴方が望んだ夢……",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe8"
  },
  {
   "id": "b_007001:0x3d30",
   "off": 15664,
   "max": 56,
   "kind": "dialogue",
   "jp": "近藤さんという月が\\n僕の心の夜道を\\n照らしてくれるから",
   "en": "",
   "op": "0x62",
   "msg": "0x2fe9"
  },
  {
   "id": "b_007001:0x3e10",
   "off": 15888,
   "max": 36,
   "kind": "dialogue",
   "jp": "あの時のように\\n間違ったりしないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2fea"
  },
  {
   "id": "b_007001:0x4628",
   "off": 17960,
   "max": 32,
   "kind": "dialogue",
   "jp": "なにもいらない\\n何も欲しくない",
   "en": "",
   "op": "0x62",
   "msg": "0x2feb"
  },
  {
   "id": "b_007001:0x4658",
   "off": 18008,
   "max": 52,
   "kind": "dialogue",
   "jp": "でも　近藤さんが望むなら\\n近藤さんのためなら……",
   "en": "",
   "op": "0x62",
   "msg": "0x2fec"
  },
  {
   "id": "b_007001:0x4b08",
   "off": 19208,
   "max": 52,
   "kind": "dialogue",
   "jp": "修羅　外道……\\n闇に落ちても\\n僕は　構わない……",
   "en": "",
   "op": "0x62",
   "msg": "0x2fed"
  },
  {
   "id": "b_007001:0x4fb8",
   "off": 20408,
   "max": 36,
   "kind": "dialogue",
   "jp": "そう思うことが　　\\nその間違いが",
   "en": "",
   "op": "0x62",
   "msg": "0x2fee"
  },
  {
   "id": "b_007001:0x4fec",
   "off": 20460,
   "max": 36,
   "kind": "dialogue",
   "jp": "近藤さんを\\n死なせてしまった……",
   "en": "",
   "op": "0x62",
   "msg": "0x2fef"
  },
  {
   "id": "b_007001:0x5864",
   "off": 22628,
   "max": 48,
   "kind": "dialogue",
   "jp": "――それは\\n沖田が龍馬たちと\\n出会う前の話……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff0"
  },
  {
   "id": "b_007001:0x5cd4",
   "off": 23764,
   "max": 64,
   "kind": "dialogue",
   "jp": "今日も　雷舞を観に\\nうじゃうじゃ来てるな～\\nよっぽど暇なんだね",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff1"
  },
  {
   "id": "b_007001:0x6344",
   "off": 25412,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんだよ\\n今　忙しいんだけど\\n……げ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff2"
  },
  {
   "id": "b_007001:0x6bfc",
   "off": 27644,
   "max": 60,
   "kind": "dialogue",
   "jp": "そういう　お前は\\n舞台に出ていて\\n忙しいんじゃなかったか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff3"
  },
  {
   "id": "b_007001:0x714c",
   "off": 29004,
   "max": 44,
   "kind": "dialogue",
   "jp": "あれ～　どうして\\n土方さんが茶屋にいるの？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff4"
  },
  {
   "id": "b_007001:0x76ec",
   "off": 30444,
   "max": 60,
   "kind": "dialogue",
   "jp": "お前が出番が近くなっても\\n戻ってこないからだ\\n来いっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff5"
  },
  {
   "id": "b_007001:0x8274",
   "off": 33396,
   "max": 48,
   "kind": "dialogue",
   "jp": "本当に申し訳ありません\\n俺の監督不行き届きです",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff6"
  },
  {
   "id": "b_007001:0x88e8",
   "off": 35048,
   "max": 56,
   "kind": "dialogue",
   "jp": "いやいや　出番には\\n間に合ったんだから\\n良しとしよう",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff7"
  },
  {
   "id": "b_007001:0x8e38",
   "off": 36408,
   "max": 64,
   "kind": "dialogue",
   "jp": "いいえ　舞台袖で待つのも\\n隊士の務めです\\nほら　お前も謝れ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff8"
  },
  {
   "id": "b_007001:0x95fc",
   "off": 38396,
   "max": 28,
   "kind": "dialogue",
   "jp": "……は～い\\nごめんなさい",
   "en": "",
   "op": "0x62",
   "msg": "0x2ff9"
  },
  {
   "id": "b_007001:0x9c64",
   "off": 40036,
   "max": 44,
   "kind": "dialogue",
   "jp": "どうして　舞台袖から\\n抜け出したんだ\\n総司",
   "en": "",
   "op": "0x62",
   "msg": "0x2ffa"
  },
  {
   "id": "b_007001:0xa1a4",
   "off": 41380,
   "max": 60,
   "kind": "dialogue",
   "jp": "珍しい柄の蝶がいたんです\\n捕まえて近藤さんに\\n見せたくて",
   "en": "",
   "op": "0x62",
   "msg": "0x2ffb"
  },
  {
   "id": "b_007001:0xa88c",
   "off": 43148,
   "max": 52,
   "kind": "dialogue",
   "jp": "蝶がいるのは花畑だ\\n茶屋の二階に\\n蝶などいるか！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ffc"
  },
  {
   "id": "b_007001:0xb0c8",
   "off": 45256,
   "max": 52,
   "kind": "dialogue",
   "jp": "茶屋の二階に住む蝶か……\\nそりゃあ別嬪だっただろう",
   "en": "",
   "op": "0x62",
   "msg": "0x2ffd"
  },
  {
   "id": "b_007001:0xb904",
   "off": 47364,
   "max": 48,
   "kind": "dialogue",
   "jp": "近藤さん　総司の\\n言う事を\\n信じるんですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ffe"
  },
  {
   "id": "b_007001:0xbdb0",
   "off": 48560,
   "max": 40,
   "kind": "dialogue",
   "jp": "隊士の言う事を疑う\\n局長は居ないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x2fff"
  },
  {
   "id": "b_007001:0xbde8",
   "off": 48616,
   "max": 60,
   "kind": "dialogue",
   "jp": "それに俺でも　そんな\\n珍しい蝶なら\\n捕まえてみたいと思うさ",
   "en": "",
   "op": "0x62",
   "msg": "0x3000"
  },
  {
   "id": "b_007001:0xc804",
   "off": 51204,
   "max": 72,
   "kind": "dialogue",
   "jp": "そうそう　だめだよ～\\n純真な少年の好奇心や\\n真心を信じられないなんて",
   "en": "",
   "op": "0x62",
   "msg": "0x3001"
  },
  {
   "id": "b_007001:0xd028",
   "off": 53288,
   "max": 20,
   "kind": "dialogue",
   "jp": "このクソガキ……",
   "en": "",
   "op": "0x62",
   "msg": "0x3002"
  },
  {
   "id": "b_007001:0xd7cc",
   "off": 55244,
   "max": 60,
   "kind": "dialogue",
   "jp": "あははっ　次は舞台のこと\\n忘れないように\\n気をつけま～す",
   "en": "",
   "op": "0x62",
   "msg": "0x3003"
  },
  {
   "id": "b_007001:0xdea4",
   "off": 56996,
   "max": 44,
   "kind": "dialogue",
   "jp": "ほら　こう言ってるし\\nもう許してあげなさい",
   "en": "",
   "op": "0x62",
   "msg": "0x3004"
  },
  {
   "id": "b_007001:0xe514",
   "off": 58644,
   "max": 28,
   "kind": "dialogue",
   "jp": "……ちっ\\n次は無いからな",
   "en": "",
   "op": "0x62",
   "msg": "0x3005"
  },
  {
   "id": "b_007001:0xecb4",
   "off": 60596,
   "max": 16,
   "kind": "dialogue",
   "jp": "はい　は～い",
   "en": "",
   "op": "0x62",
   "msg": "0x3006"
  },
  {
   "id": "b_007001:0xf684",
   "off": 63108,
   "max": 56,
   "kind": "dialogue",
   "jp": "……あ～あ\\n近藤さんも土方さんも\\n本当にチョロいな～",
   "en": "",
   "op": "0x62",
   "msg": "0x3007"
  },
  {
   "id": "b_007001:0xfb4c",
   "off": 64332,
   "max": 108,
   "kind": "dialogue",
   "jp": "当時の新選組は\\n局長の近藤　副長の土方\\nそして　沖田の三人が\\n一番人気の隊として\\n雷舞のトリを務めていた",
   "en": "",
   "op": "0x62",
   "msg": "0x3008"
  },
  {
   "id": "b_007001:0xfbc8",
   "off": 64456,
   "max": 76,
   "kind": "dialogue",
   "jp": "人気実力ともに\\n新選組随一の三人……\\nしかし　それを\\n快く思わない者も居た",
   "en": "",
   "op": "0x62",
   "msg": "0x3009"
  },
  {
   "id": "b_007001:0x10054",
   "off": 65620,
   "max": 60,
   "kind": "dialogue",
   "jp": "……なんで沖田が\\n近藤さんや土方さんと\\n一緒の組なんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x300a"
  },
  {
   "id": "b_007001:0x10808",
   "off": 67592,
   "max": 48,
   "kind": "dialogue",
   "jp": "顔がいいからだろ？\\n練習もろくに\\n出ない癖に",
   "en": "",
   "op": "0x62",
   "msg": "0x300b"
  },
  {
   "id": "b_007001:0x10d28",
   "off": 68904,
   "max": 48,
   "kind": "dialogue",
   "jp": "最近　客の入りが\\n悪いのだって\\nアイツの……",
   "en": "",
   "op": "0x62",
   "msg": "0x300c"
  },
  {
   "id": "b_007001:0x11648",
   "off": 71240,
   "max": 44,
   "kind": "dialogue",
   "jp": "そういうの人のせいに\\nするってよくないな～",
   "en": "",
   "op": "0x62",
   "msg": "0x300d"
  },
  {
   "id": "b_007001:0x11f58",
   "off": 73560,
   "max": 16,
   "kind": "dialogue",
   "jp": "なっ　沖田！",
   "en": "",
   "op": "0x62",
   "msg": "0x300e"
  },
  {
   "id": "b_007001:0x12600",
   "off": 75264,
   "max": 76,
   "kind": "dialogue",
   "jp": "僕は近藤さんと土方さんの\\nオマケだし　練習も舞台も\\n時々しか出ないけど……",
   "en": "",
   "op": "0x62",
   "msg": "0x300f"
  },
  {
   "id": "b_007001:0x126f4",
   "off": 75508,
   "max": 76,
   "kind": "dialogue",
   "jp": "おかしいよね？　一番隊に\\n入る前から君たちより\\n姿絵の売り上げはいいんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3010"
  },
  {
   "id": "b_007001:0x12dd8",
   "off": 77272,
   "max": 44,
   "kind": "dialogue",
   "jp": "それは　煌は\\nお前の顔しか\\n見てないからだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3011"
  },
  {
   "id": "b_007001:0x13444",
   "off": 78916,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうだそうだ\\n俺たちは毎日　厳しい\\n練習に耐えて頑張ってる",
   "en": "",
   "op": "0x62",
   "msg": "0x3012"
  },
  {
   "id": "b_007001:0x13c04",
   "off": 80900,
   "max": 24,
   "kind": "dialogue",
   "jp": "ふ～ん　頑張ってる　ね",
   "en": "",
   "op": "0x62",
   "msg": "0x3013"
  },
  {
   "id": "b_007001:0x13c2c",
   "off": 80940,
   "max": 72,
   "kind": "dialogue",
   "jp": "一生懸命に練習した結果が\\n見た目に負ける程度なら\\n……やる必要あるの？",
   "en": "",
   "op": "0x62",
   "msg": "0x3014"
  },
  {
   "id": "b_007001:0x1430c",
   "off": 82700,
   "max": 12,
   "kind": "dialogue",
   "jp": "……くっ",
   "en": "",
   "op": "0x62",
   "msg": "0x3015"
  },
  {
   "id": "b_007001:0x149b0",
   "off": 84400,
   "max": 68,
   "kind": "dialogue",
   "jp": "ほら　その顔……ふふっ\\nそういう顔してるから\\n煌が逃げるんだよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x3016"
  },
  {
   "id": "b_007001:0x14a04",
   "off": 84484,
   "max": 72,
   "kind": "dialogue",
   "jp": "他人の陰口を言う暇が\\nあるなら大好きな練習に\\n笑顔の練習も加えたら？",
   "en": "",
   "op": "0x62",
   "msg": "0x3017"
  },
  {
   "id": "b_007001:0x1552c",
   "off": 87340,
   "max": 60,
   "kind": "dialogue",
   "jp": "バカらしい……\\n愛獲なんてなりたくて\\nなったわけじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x3018"
  },
  {
   "id": "b_007001:0x159f8",
   "off": 88568,
   "max": 68,
   "kind": "dialogue",
   "jp": "呑気に人の悪口を言う\\n隊士達の馬鹿さ加減に\\n沖田はイライラしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x3019"
  },
  {
   "id": "b_007001:0x15a4c",
   "off": 88652,
   "max": 80,
   "kind": "dialogue",
   "jp": "今の新選組の雷舞を\\n仕切っているのは\\n自分の利益しか考えない\\n幕府のお偉方だ",
   "en": "",
   "op": "0x62",
   "msg": "0x301a"
  },
  {
   "id": "b_007001:0x15edc",
   "off": 89820,
   "max": 72,
   "kind": "dialogue",
   "jp": "……そんな年寄の考えた\\n雷舞なんて時代遅れって\\nなんで気付かないんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x301b"
  },
  {
   "id": "b_007001:0x15f34",
   "off": 89908,
   "max": 68,
   "kind": "dialogue",
   "jp": "……なのに近藤さんは\\n米つきバッタみたいだよ\\n幕府にぺこぺこしてさ",
   "en": "",
   "op": "0x62",
   "msg": "0x301c"
  },
  {
   "id": "b_007001:0x15f88",
   "off": 89992,
   "max": 68,
   "kind": "dialogue",
   "jp": "土方さんは土方さんで\\n近藤さんの言うこと\\n素直に聞いちゃって……",
   "en": "",
   "op": "0x62",
   "msg": "0x301d"
  },
  {
   "id": "b_007001:0x16074",
   "off": 90228,
   "max": 56,
   "kind": "dialogue",
   "jp": "……バカじゃない？\\n昔はあんなんじゃ\\nなかったのに……",
   "en": "",
   "op": "0x62",
   "msg": "0x301e"
  },
  {
   "id": "b_007001:0x16a60",
   "off": 92768,
   "max": 76,
   "kind": "dialogue",
   "jp": "明けない夜が無いように\\n止まない雨が無いように\\n世の乱れもいつかは収まる",
   "en": "",
   "op": "0x62",
   "msg": "0x301f"
  },
  {
   "id": "b_007001:0x16abc",
   "off": 92860,
   "max": 76,
   "kind": "dialogue",
   "jp": "その時に必要とされるのは\\n人を傷つける刀じゃない\\n人の心を安らがせる歌だ",
   "en": "",
   "op": "0x62",
   "msg": "0x3020"
  },
  {
   "id": "b_007001:0x16b18",
   "off": 92952,
   "max": 60,
   "kind": "dialogue",
   "jp": "歌の力で戦乱を終わらせた\\n徳川家康公のように\\n私はなりたい",
   "en": "",
   "op": "0x62",
   "msg": "0x3021"
  },
  {
   "id": "b_007001:0x1706c",
   "off": 94316,
   "max": 60,
   "kind": "dialogue",
   "jp": "歌でこの国を平和にしよう\\n付いてきてくれるか？\\nトシ　総司",
   "en": "",
   "op": "0x62",
   "msg": "0x3022"
  },
  {
   "id": "b_007001:0x17538",
   "off": 95544,
   "max": 112,
   "kind": "dialogue",
   "jp": "そう言って笑う\\n近藤さんの笑顔のまぶしさに\\nひねくれ　ねじくれた心まで\\nほぐされていくような\\n気持ちになった",
   "en": "",
   "op": "0x62",
   "msg": "0x3023"
  },
  {
   "id": "b_007001:0x17cf0",
   "off": 97520,
   "max": 44,
   "kind": "dialogue",
   "jp": "……って\\nそれに　ひょこひょこ\\n付いてきて",
   "en": "",
   "op": "0x62",
   "msg": "0x3024"
  },
  {
   "id": "b_007001:0x17d2c",
   "off": 97580,
   "max": 44,
   "kind": "dialogue",
   "jp": "ぶーぶー言ってる\\n僕が一番バカなのかな～",
   "en": "",
   "op": "0x62",
   "msg": "0x3025"
  },
  {
   "id": "b_007001:0x1826c",
   "off": 98924,
   "max": 32,
   "kind": "dialogue",
   "jp": "き～めた\\n夕方の雷舞はさぼり！",
   "en": "",
   "op": "0x62",
   "msg": "0x3026"
  },
  {
   "id": "b_007001:0x18c44",
   "off": 101444,
   "max": 56,
   "kind": "dialogue",
   "jp": "近藤さん\\n幕府の使者と名乗る方が\\nいらっしゃっています",
   "en": "",
   "op": "0x62",
   "msg": "0x3027"
  },
  {
   "id": "b_007001:0x19318",
   "off": 103192,
   "max": 40,
   "kind": "dialogue",
   "jp": "……幕府の？\\nわかった　すぐに行こう",
   "en": "",
   "op": "0x62",
   "msg": "0x3028"
  },
  {
   "id": "b_007001:0x197bc",
   "off": 104380,
   "max": 52,
   "kind": "dialogue",
   "jp": "トシは舞台前練習\\n（リハーサル）を\\n続けていてくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x3029"
  },
  {
   "id": "b_007001:0x19e8c",
   "off": 106124,
   "max": 8,
   "kind": "dialogue",
   "jp": "はい",
   "en": "",
   "op": "0x62",
   "msg": "0x302a"
  },
  {
   "id": "b_007001:0x1a858",
   "off": 108632,
   "max": 24,
   "kind": "dialogue",
   "jp": "きゃー\\n総司さ～～ん",
   "en": "",
   "op": "0x62",
   "msg": "0x302b"
  },
  {
   "id": "b_007001:0x1ae28",
   "off": 110120,
   "max": 32,
   "kind": "dialogue",
   "jp": "もう　どこに\\n行ったのかしら？",
   "en": "",
   "op": "0x62",
   "msg": "0x302c"
  },
  {
   "id": "b_007001:0x1b63c",
   "off": 112188,
   "max": 52,
   "kind": "dialogue",
   "jp": "……やれやれ\\n街中に出てきたのは\\n失敗だったかな",
   "en": "",
   "op": "0x62",
   "msg": "0x302d"
  },
  {
   "id": "b_007001:0x1b680",
   "off": 112256,
   "max": 60,
   "kind": "dialogue",
   "jp": "今日は雷舞もあるし\\n僕の顔を知ってる人も\\n多いだろうしね～",
   "en": "",
   "op": "0x62",
   "msg": "0x302e"
  },
  {
   "id": "b_007001:0x1b764",
   "off": 112484,
   "max": 48,
   "kind": "dialogue",
   "jp": "裏の方を抜けて\\n山にでも行こうかな……\\nん？",
   "en": "",
   "op": "0x62",
   "msg": "0x302f"
  },
  {
   "id": "b_007001:0x1beac",
   "off": 114348,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x3030"
  },
  {
   "id": "b_007001:0x1c470",
   "off": 115824,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x3031"
  },
  {
   "id": "b_007001:0x1cc90",
   "off": 117904,
   "max": 40,
   "kind": "dialogue",
   "jp": "あれは……近藤さん？\\nその隣は……誰？",
   "en": "",
   "op": "0x62",
   "msg": "0x3032"
  },
  {
   "id": "b_007001:0x1d064",
   "off": 118884,
   "max": 104,
   "kind": "dialogue",
   "jp": "土方に拾われるまで\\n盗賊に育てられたことや\\n愛獲になってからは\\n大名の娘など　煌からの\\n贈り物などで",
   "en": "",
   "op": "0x62",
   "msg": "0x3033"
  },
  {
   "id": "b_007001:0x1d304",
   "off": 119556,
   "max": 44,
   "kind": "dialogue",
   "jp": "沖田は若いながらも\\nかなりの目利きだった",
   "en": "",
   "op": "0x62",
   "msg": "0x3034"
  },
  {
   "id": "b_007001:0x1d568",
   "off": 120168,
   "max": 92,
   "kind": "dialogue",
   "jp": "目立たないようにしては\\nいるが　その物腰や着物の\\n生地や仕立ての良さは\\n離れていてもわかる",
   "en": "",
   "op": "0x62",
   "msg": "0x3035"
  },
  {
   "id": "b_007001:0x1d7fc",
   "off": 120828,
   "max": 56,
   "kind": "dialogue",
   "jp": "近藤の隣にいる者は\\nただの武士ではないと\\nわかったのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3036"
  },
  {
   "id": "b_007001:0x1ddd4",
   "off": 122324,
   "max": 20,
   "kind": "dialogue",
   "jp": "……久しいな　近藤",
   "en": "",
   "op": "0x62",
   "msg": "0x3037"
  },
  {
   "id": "b_007001:0x1e484",
   "off": 124036,
   "max": 64,
   "kind": "dialogue",
   "jp": "井伊様に置かれましても\\nつつがなくお過ごしのようで\\n大変に……",
   "en": "",
   "op": "0x62",
   "msg": "0x3038"
  },
  {
   "id": "b_007001:0x1eca4",
   "off": 126116,
   "max": 12,
   "kind": "dialogue",
   "jp": "挨拶はいい",
   "en": "",
   "op": "0x62",
   "msg": "0x3039"
  },
  {
   "id": "b_007001:0x1f1c8",
   "off": 127432,
   "max": 48,
   "kind": "dialogue",
   "jp": "何故　我がわざわざ\\n出向いたのか\\nわかるな？",
   "en": "",
   "op": "0x62",
   "msg": "0x303a"
  },
  {
   "id": "b_007001:0x1f710",
   "off": 128784,
   "max": 56,
   "kind": "dialogue",
   "jp": "新しい天歌の話でしたら\\nお断りさせて\\nいただいたかと",
   "en": "",
   "op": "0x62",
   "msg": "0x303b"
  },
  {
   "id": "b_007001:0x1fc60",
   "off": 130144,
   "max": 28,
   "kind": "dialogue",
   "jp": "……ふん\\n気は変わらぬか",
   "en": "",
   "op": "0x62",
   "msg": "0x303c"
  },
  {
   "id": "b_007001:0x20230",
   "off": 131632,
   "max": 56,
   "kind": "dialogue",
   "jp": "そう言えば最近……\\n新選組の雷舞\\n客が減っているとか？",
   "en": "",
   "op": "0x62",
   "msg": "0x303d"
  },
  {
   "id": "b_007001:0x20788",
   "off": 133000,
   "max": 48,
   "kind": "dialogue",
   "jp": "……それは\\n私の不徳の致すところで\\nございます",
   "en": "",
   "op": "0x62",
   "msg": "0x303e"
  },
  {
   "id": "b_007001:0x20f40",
   "off": 134976,
   "max": 44,
   "kind": "dialogue",
   "jp": "誤解をするな　近藤\\n責めているわけではない",
   "en": "",
   "op": "0x62",
   "msg": "0x303f"
  },
  {
   "id": "b_007001:0x21018",
   "off": 135192,
   "max": 72,
   "kind": "dialogue",
   "jp": "都の乱れは目を覆うほどだ\\n逃げ出す民も多い……\\n上様も嘆いておられる",
   "en": "",
   "op": "0x62",
   "msg": "0x3040"
  },
  {
   "id": "b_007001:0x21070",
   "off": 135280,
   "max": 44,
   "kind": "dialogue",
   "jp": "民に安寧を促す歌が\\n必要だとわかっておろう",
   "en": "",
   "op": "0x62",
   "msg": "0x3041"
  },
  {
   "id": "b_007001:0x21148",
   "off": 135496,
   "max": 36,
   "kind": "dialogue",
   "jp": "なぜ　それを歌おうとは\\nしない？",
   "en": "",
   "op": "0x62",
   "msg": "0x3042"
  },
  {
   "id": "b_007001:0x21808",
   "off": 137224,
   "max": 64,
   "kind": "dialogue",
   "jp": "新選組内でも　新しい試み\\n新たなる団主に取り組んで\\nおります",
   "en": "",
   "op": "0x62",
   "msg": "0x3043"
  },
  {
   "id": "b_007001:0x2203c",
   "off": 139324,
   "max": 60,
   "kind": "dialogue",
   "jp": "ならば……\\n我の新たな天歌の話も\\nそこに加えればよかろう",
   "en": "",
   "op": "0x62",
   "msg": "0x3044"
  },
  {
   "id": "b_007001:0x22124",
   "off": 139556,
   "max": 60,
   "kind": "dialogue",
   "jp": "我が直々に力を貸して\\nやるというのだ\\n悪い話ではあるまい？",
   "en": "",
   "op": "0x62",
   "msg": "0x3045"
  },
  {
   "id": "b_007001:0x22678",
   "off": 140920,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x3046"
  },
  {
   "id": "b_007001:0x22b9c",
   "off": 142236,
   "max": 48,
   "kind": "dialogue",
   "jp": "強情な男よ\\nだが　我はお前の\\nそこを買っておる",
   "en": "",
   "op": "0x62",
   "msg": "0x3047"
  },
  {
   "id": "b_007001:0x23048",
   "off": 143432,
   "max": 68,
   "kind": "dialogue",
   "jp": "だからこそ　新選組という\\n大所帯を纏めることの\\nできる男なのだとな",
   "en": "",
   "op": "0x62",
   "msg": "0x3048"
  },
  {
   "id": "b_007001:0x235a4",
   "off": 144804,
   "max": 68,
   "kind": "dialogue",
   "jp": "幕府の大老　井伊様に\\nそこまでお褒めいただき\\n感無量でございます",
   "en": "",
   "op": "0x62",
   "msg": "0x3049"
  },
  {
   "id": "b_007001:0x23a64",
   "off": 146020,
   "max": 68,
   "kind": "dialogue",
   "jp": "我はお前のことを\\nよく　よく　知っておる\\nだからこそ後ろ盾もしよう",
   "en": "",
   "op": "0x62",
   "msg": "0x304a"
  },
  {
   "id": "b_007001:0x23fc0",
   "off": 147392,
   "max": 56,
   "kind": "dialogue",
   "jp": "しかし　悲しいかな\\n幕臣の主な者達は\\nお前を知らぬのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x304b"
  },
  {
   "id": "b_007001:0x24898",
   "off": 149656,
   "max": 64,
   "kind": "dialogue",
   "jp": "……人気のある者だけ残し\\n新選組を解散させよと\\n言う者までいる",
   "en": "",
   "op": "0x62",
   "msg": "0x304c"
  },
  {
   "id": "b_007001:0x25160",
   "off": 151904,
   "max": 32,
   "kind": "dialogue",
   "jp": "どうか\\nどうか　それだけは……",
   "en": "",
   "op": "0x62",
   "msg": "0x304d"
  },
  {
   "id": "b_007001:0x25190",
   "off": 151952,
   "max": 44,
   "kind": "dialogue",
   "jp": "隊士達は\\n私の大事な友であり\\n家族なのです",
   "en": "",
   "op": "0x62",
   "msg": "0x304e"
  },
  {
   "id": "b_007001:0x258dc",
   "off": 153820,
   "max": 64,
   "kind": "dialogue",
   "jp": "お前の気持ちはよくわかる\\n仲間思いの良い局長と\\n我も知っておる",
   "en": "",
   "op": "0x62",
   "msg": "0x304f"
  },
  {
   "id": "b_007001:0x2592c",
   "off": 153900,
   "max": 68,
   "kind": "dialogue",
   "jp": "しかし　結果が出なければ\\n幕府にとって新選組など\\n何の意味も無い",
   "en": "",
   "op": "0x62",
   "msg": "0x3050"
  },
  {
   "id": "b_007001:0x25e00",
   "off": 155136,
   "max": 48,
   "kind": "dialogue",
   "jp": "井伊の意味有りげな\\n微笑みに\\n近藤は膝を突く",
   "en": "",
   "op": "0x62",
   "msg": "0x3051"
  },
  {
   "id": "b_007001:0x26594",
   "off": 157076,
   "max": 28,
   "kind": "dialogue",
   "jp": "なにとぞ\\nそれだけは……",
   "en": "",
   "op": "0x62",
   "msg": "0x3052"
  },
  {
   "id": "b_007001:0x26ac4",
   "off": 158404,
   "max": 60,
   "kind": "dialogue",
   "jp": "井伊は地にひれ伏す\\n近藤の頭を扇で撫で\\nそして首をなぞる",
   "en": "",
   "op": "0x62",
   "msg": "0x3053"
  },
  {
   "id": "b_007001:0x270b8",
   "off": 159928,
   "max": 64,
   "kind": "dialogue",
   "jp": "ならば　春の大舞台\\nその後の新選組雷舞……\\n皆の前で腹を切れ",
   "en": "",
   "op": "0x62",
   "msg": "0x3054"
  },
  {
   "id": "b_007001:0x27888",
   "off": 161928,
   "max": 12,
   "kind": "dialogue",
   "jp": "……なっ",
   "en": "",
   "op": "0x62",
   "msg": "0x3055"
  },
  {
   "id": "b_007001:0x2807c",
   "off": 163964,
   "max": 72,
   "kind": "dialogue",
   "jp": "隊士は泣き京中の噂となり\\n離れていた者どもも\\nお前を憐れみ戻るだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x3056"
  },
  {
   "id": "b_007001:0x285dc",
   "off": 165340,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x3057"
  },
  {
   "id": "b_007001:0x28b00",
   "off": 166656,
   "max": 60,
   "kind": "dialogue",
   "jp": "それが嫌なのであれば\\n次の雷舞までに\\n民の人気を戻せばいい",
   "en": "",
   "op": "0x62",
   "msg": "0x3058"
  },
  {
   "id": "b_007001:0x29054",
   "off": 168020,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x3059"
  },
  {
   "id": "b_007001:0x29578",
   "off": 169336,
   "max": 52,
   "kind": "dialogue",
   "jp": "まあ良い\\nまずは今宵の雷舞を\\n楽しみにしておるぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x305a"
  },
  {
   "id": "b_007001:0x29ac4",
   "off": 170692,
   "max": 12,
   "kind": "dialogue",
   "jp": "……くっ",
   "en": "",
   "op": "0x62",
   "msg": "0x305b"
  },
  {
   "id": "b_007001:0x2a7a4",
   "off": 173988,
   "max": 64,
   "kind": "dialogue",
   "jp": "……そろそろ出て来い\\n後をつけてきているのは\\nわかっているぞ？",
   "en": "",
   "op": "0x62",
   "msg": "0x305c"
  },
  {
   "id": "b_007001:0x2ad98",
   "off": 175512,
   "max": 68,
   "kind": "dialogue",
   "jp": "あれ？　ばれてた？\\n尾行とか　馴れないことは\\nするもんじゃないね",
   "en": "",
   "op": "0x62",
   "msg": "0x305d"
  },
  {
   "id": "b_007001:0x2b6a4",
   "off": 177828,
   "max": 72,
   "kind": "dialogue",
   "jp": "いや　なかなかであった\\n……その殺気さえ上手く\\n隠せていればの話だがな",
   "en": "",
   "op": "0x62",
   "msg": "0x305e"
  },
  {
   "id": "b_007001:0x2bb68",
   "off": 179048,
   "max": 52,
   "kind": "dialogue",
   "jp": "……偉い人が供も\\n連れずに歩いてちゃ\\nだめだよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x305f"
  },
  {
   "id": "b_007001:0x2bbac",
   "off": 179116,
   "max": 52,
   "kind": "dialogue",
   "jp": "京の街は物騒で\\nそれこそ辻斬りとか\\n多いんだからさ",
   "en": "",
   "op": "0x62",
   "msg": "0x3060"
  },
  {
   "id": "b_007001:0x2c0f8",
   "off": 180472,
   "max": 44,
   "kind": "dialogue",
   "jp": "それを取り締まるのが\\n新選組の仕事だろう？",
   "en": "",
   "op": "0x62",
   "msg": "0x3061"
  },
  {
   "id": "b_007001:0x2cb20",
   "off": 183072,
   "max": 52,
   "kind": "dialogue",
   "jp": "怪しいヤツを\\n取り締まるのも\\n新選組の仕事だよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x3062"
  },
  {
   "id": "b_007001:0x2d328",
   "off": 185128,
   "max": 60,
   "kind": "dialogue",
   "jp": "我に刃を向けるのが\\nどういう意味なのか\\nわかっているのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x3063"
  },
  {
   "id": "b_007001:0x2d9fc",
   "off": 186876,
   "max": 76,
   "kind": "dialogue",
   "jp": "さあ？　アンタのことは\\n知らないし　わかる頃には\\n首が飛んでるんでしょ？",
   "en": "",
   "op": "0x62",
   "msg": "0x3064"
  },
  {
   "id": "b_007001:0x2e08c",
   "off": 188556,
   "max": 48,
   "kind": "dialogue",
   "jp": "……面白い\\n本当に近藤は\\nいい隊士を育てている",
   "en": "",
   "op": "0x62",
   "msg": "0x3065"
  },
  {
   "id": "b_007001:0x2e5d0",
   "off": 189904,
   "max": 72,
   "kind": "dialogue",
   "jp": "まだまだ　ガキだよ\\n愛獲なんてチャラチャラの\\n侍ごっこかと思ってたら",
   "en": "",
   "op": "0x62",
   "msg": "0x3066"
  },
  {
   "id": "b_007001:0x2e628",
   "off": 189992,
   "max": 52,
   "kind": "dialogue",
   "jp": "近藤さんてば\\n命がけなんだもん\\nすっごく　やな気分",
   "en": "",
   "op": "0x62",
   "msg": "0x3067"
  },
  {
   "id": "b_007001:0x2e704",
   "off": 190212,
   "max": 48,
   "kind": "dialogue",
   "jp": "断っておくけど\\nアンタにじゃない\\n自分にだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3068"
  },
  {
   "id": "b_007001:0x2ec4c",
   "off": 191564,
   "max": 12,
   "kind": "dialogue",
   "jp": "ほう……？",
   "en": "",
   "op": "0x62",
   "msg": "0x3069"
  },
  {
   "id": "b_007001:0x2f16c",
   "off": 192876,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああそうだ\\nまずはその着物\\n脱いでくれる？",
   "en": "",
   "op": "0x62",
   "msg": "0x306a"
  },
  {
   "id": "b_007001:0x2f1a8",
   "off": 192936,
   "max": 56,
   "kind": "dialogue",
   "jp": "物取りがやったように\\n見せたいから\\n汚したくないんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x306b"
  },
  {
   "id": "b_007001:0x2f6f8",
   "off": 194296,
   "max": 20,
   "kind": "dialogue",
   "jp": "嫌だと言ったら？",
   "en": "",
   "op": "0x62",
   "msg": "0x306c"
  },
  {
   "id": "b_007001:0x2fc20",
   "off": 195616,
   "max": 68,
   "kind": "dialogue",
   "jp": "普通に斬るだけかな？\\n財布は抜いて　鴨川に\\n捨てさせて貰うけどっ",
   "en": "",
   "op": "0x62",
   "msg": "0x306d"
  },
  {
   "id": "b_007001:0x30e50",
   "off": 200272,
   "max": 12,
   "kind": "dialogue",
   "jp": "なっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x306e"
  },
  {
   "id": "b_007001:0x31378",
   "off": 201592,
   "max": 80,
   "kind": "dialogue",
   "jp": "間合いは完璧だった\\n踏み込みも確実だった\\n刀を抜く暇など\\n与えなかったはずだ",
   "en": "",
   "op": "0x62",
   "msg": "0x306f"
  },
  {
   "id": "b_007001:0x3194c",
   "off": 203084,
   "max": 40,
   "kind": "dialogue",
   "jp": "やれやれ　新選組が\\n物取りの真似か？",
   "en": "",
   "op": "0x62",
   "msg": "0x3070"
  },
  {
   "id": "b_007001:0x31d20",
   "off": 204064,
   "max": 104,
   "kind": "dialogue",
   "jp": "……しかし　目の前に\\nその男は無傷で立っていた\\n沖田をあざ笑うかのように\\n扇を広げ　涼しげに微笑んだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3071"
  },
  {
   "id": "b_007001:0x324dc",
   "off": 206044,
   "max": 60,
   "kind": "dialogue",
   "jp": "……なるほど鉄扇か\\nその扇　骨に鉄を仕込んで\\nあるんだね",
   "en": "",
   "op": "0x62",
   "msg": "0x3072"
  },
  {
   "id": "b_007001:0x32e7c",
   "off": 208508,
   "max": 44,
   "kind": "dialogue",
   "jp": "……仕込んであるのは\\n鉄だけではないぞ？",
   "en": "",
   "op": "0x62",
   "msg": "0x3073"
  },
  {
   "id": "b_007001:0x332fc",
   "off": 209660,
   "max": 84,
   "kind": "dialogue",
   "jp": "井伊が扇ぐ度\\n今まで沖田が　かいだことも\\nないような不思議な香りが\\n広まっていく",
   "en": "",
   "op": "0x62",
   "msg": "0x3074"
  },
  {
   "id": "b_007001:0x33950",
   "off": 211280,
   "max": 40,
   "kind": "dialogue",
   "jp": "な……に……これ……\\n頭がくらくらする",
   "en": "",
   "op": "0x62",
   "msg": "0x3075"
  },
  {
   "id": "b_007001:0x3426c",
   "off": 213612,
   "max": 32,
   "kind": "dialogue",
   "jp": "没薬に迷迭香を\\n混ぜたものだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3076"
  },
  {
   "id": "b_007001:0x3429c",
   "off": 213660,
   "max": 36,
   "kind": "dialogue",
   "jp": "我はよく狙われるのでな\\n護身用だ",
   "en": "",
   "op": "0x62",
   "msg": "0x3077"
  },
  {
   "id": "b_007001:0x34a6c",
   "off": 215660,
   "max": 64,
   "kind": "dialogue",
   "jp": "くっ　これぐらい……\\n近藤さんの命に比べたら\\nなんてことない",
   "en": "",
   "op": "0x62",
   "msg": "0x3078"
  },
  {
   "id": "b_007001:0x35958",
   "off": 219480,
   "max": 28,
   "kind": "dialogue",
   "jp": "ほぉ……まだ　\\n動けるのか",
   "en": "",
   "op": "0x62",
   "msg": "0x3079"
  },
  {
   "id": "b_007001:0x36470",
   "off": 222320,
   "max": 20,
   "kind": "dialogue",
   "jp": "お前を……斬るっ",
   "en": "",
   "op": "0x62",
   "msg": "0x307a"
  },
  {
   "id": "b_007001:0x36e04",
   "off": 224772,
   "max": 52,
   "kind": "dialogue",
   "jp": "斬れるものなら斬ってみろ\\n奪えるものなら奪ってみろ",
   "en": "",
   "op": "0x62",
   "msg": "0x307b"
  },
  {
   "id": "b_007001:0x372b4",
   "off": 225972,
   "max": 56,
   "kind": "dialogue",
   "jp": "慶喜様への忠誠と\\nお前の近藤への想い\\nどちらが強いか",
   "en": "",
   "op": "0x62",
   "msg": "0x307c"
  },
  {
   "id": "b_007001:0x38234",
   "off": 229940,
   "max": 32,
   "kind": "dialogue",
   "jp": "もちろん\\n僕に決まってるっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x307d"
  },
  {
   "id": "b_007001:0x3876c",
   "off": 231276,
   "max": 28,
   "kind": "dialogue",
   "jp": "その言葉　万死に値する！",
   "en": "",
   "op": "0x62",
   "msg": "0x307e"
  },
  {
   "id": "b_007001:0x38ca0",
   "off": 232608,
   "max": 72,
   "kind": "dialogue",
   "jp": "しかし　毒を喰らい\\nまだ我に刃向かうとは……\\nその意気　惜しいものよ",
   "en": "",
   "op": "0x62",
   "msg": "0x307f"
  },
  {
   "id": "b_007001:0x39164",
   "off": 233828,
   "max": 60,
   "kind": "dialogue",
   "jp": "近藤さんのためなら\\n僕は修羅の道を行く\\n羅刹にだってなる",
   "en": "",
   "op": "0x62",
   "msg": "0x3080"
  },
  {
   "id": "b_007001:0x3961c",
   "off": 235036,
   "max": 16,
   "kind": "dialogue",
   "jp": "地獄だって……",
   "en": "",
   "op": "0x62",
   "msg": "0x3081"
  },
  {
   "id": "b_007001:0x39afc",
   "off": 236284,
   "max": 20,
   "kind": "dialogue",
   "jp": "喜んで落ちるさ",
   "en": "",
   "op": "0x62",
   "msg": "0x3082"
  },
  {
   "id": "b_007001:0x3aab8",
   "off": 240312,
   "max": 8,
   "kind": "dialogue",
   "jp": "んぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x3083"
  },
  {
   "id": "b_007001:0x3b500",
   "off": 242944,
   "max": 28,
   "kind": "dialogue",
   "jp": "うっ　うわぁぁぁぁぁっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x3084"
  },
  {
   "id": "b_007001:0x3bac4",
   "off": 244420,
   "max": 96,
   "kind": "dialogue",
   "jp": "沖田が渾身の一撃で鉄扇を\\n折った　その瞬間……\\n二人の間から放たれた光に\\n打たれ　沖田が倒れる",
   "en": "",
   "op": "0x62",
   "msg": "0x3085"
  },
  {
   "id": "b_007001:0x3bfcc",
   "off": 245708,
   "max": 60,
   "kind": "dialogue",
   "jp": "うぁぁぁ……\\n頭が……割れる\\nな　なにが……ぐぅぅ……",
   "en": "",
   "op": "0x62",
   "msg": "0x3086"
  },
  {
   "id": "b_007001:0x3c6b8",
   "off": 247480,
   "max": 12,
   "kind": "dialogue",
   "jp": "これは……",
   "en": "",
   "op": "0x62",
   "msg": "0x3087"
  },
  {
   "id": "b_007001:0x3cb54",
   "off": 248660,
   "max": 84,
   "kind": "dialogue",
   "jp": "吉田松陰から奪った\\n超魂の欠片のひとつが\\n懐で反応していることに\\n井伊は驚いていた",
   "en": "",
   "op": "0x62",
   "msg": "0x3088"
  },
  {
   "id": "b_007001:0x3cbb8",
   "off": 248760,
   "max": 116,
   "kind": "dialogue",
   "jp": "砕けて空に散っていった\\n超魂の欠片が二度と\\nひとつにならないように\\n手に入れた片魂をずっと\\n手元で封印していたのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3089"
  },
  {
   "id": "b_007001:0x3d070",
   "off": 249968,
   "max": 48,
   "kind": "dialogue",
   "jp": "なんと\\n封印し呪詛で包んだ\\n片魂が反応するとは",
   "en": "",
   "op": "0x62",
   "msg": "0x308a"
  },
  {
   "id": "b_007001:0x3d0b0",
   "off": 250032,
   "max": 40,
   "kind": "dialogue",
   "jp": "今まで　これが反応する\\nことはなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x308b"
  },
  {
   "id": "b_007001:0x3d0e8",
   "off": 250088,
   "max": 40,
   "kind": "dialogue",
   "jp": "こやつは片魂を宿せる\\n器だったのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x308c"
  },
  {
   "id": "b_007001:0x3d794",
   "off": 251796,
   "max": 60,
   "kind": "dialogue",
   "jp": "消すには惜しい命……\\nでは　存分に使ってやろう\\nふふふふ",
   "en": "",
   "op": "0x62",
   "msg": "0x308d"
  },
  {
   "id": "b_007001:0x3e000",
   "off": 253952,
   "max": 64,
   "kind": "dialogue",
   "jp": "うう……アイツを……\\n斬らなければ……\\n近藤……さん……が……",
   "en": "",
   "op": "0x62",
   "msg": "0x308e"
  },
  {
   "id": "b_007001:0x3e77c",
   "off": 255868,
   "max": 36,
   "kind": "dialogue",
   "jp": "お主　近藤を助けたくは\\nないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x308f"
  },
  {
   "id": "b_007001:0x3ede0",
   "off": 257504,
   "max": 36,
   "kind": "dialogue",
   "jp": "い　今さら……\\nどういう……こと？",
   "en": "",
   "op": "0x62",
   "msg": "0x3090"
  },
  {
   "id": "b_007001:0x3f328",
   "off": 258856,
   "max": 56,
   "kind": "dialogue",
   "jp": "……見目麗しく\\n玲瓏と囀る雛鳥よ\\nこれを授けてやろう",
   "en": "",
   "op": "0x62",
   "msg": "0x3091"
  },
  {
   "id": "b_007001:0x3f8e4",
   "off": 260324,
   "max": 68,
   "kind": "dialogue",
   "jp": "井伊の懐から\\nくすんだ光が飛び出し\\n沖田の鼻先でふわりと\\n止まる",
   "en": "",
   "op": "0x62",
   "msg": "0x3092"
  },
  {
   "id": "b_007001:0x3fddc",
   "off": 261596,
   "max": 56,
   "kind": "dialogue",
   "jp": "……うっ\\n頭が……ぐううっ……\\nうあ……がぁぁぁ……",
   "en": "",
   "op": "0x62",
   "msg": "0x3093"
  },
  {
   "id": "b_007001:0x402ac",
   "off": 262828,
   "max": 76,
   "kind": "dialogue",
   "jp": "くすんだ光の明滅に合わせ\\n沖田の足元がぐらぐらと揺れ\\n頭は割れるように痛む",
   "en": "",
   "op": "0x62",
   "msg": "0x3094"
  },
  {
   "id": "b_007001:0x40860",
   "off": 264288,
   "max": 56,
   "kind": "dialogue",
   "jp": "潔さも小賢しさも併せ持ち\\n清濁を共に抱く\\n玲瓏の雛鳥よ",
   "en": "",
   "op": "0x62",
   "msg": "0x3095"
  },
  {
   "id": "b_007001:0x408a8",
   "off": 264360,
   "max": 60,
   "kind": "dialogue",
   "jp": "呪魂（ダークソウル）を\\n受け容れ　お前の身体を\\n我に捧げよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3096"
  },
  {
   "id": "b_007001:0x40fec",
   "off": 266220,
   "max": 24,
   "kind": "dialogue",
   "jp": "ううっ……\\n誰が……",
   "en": "",
   "op": "0x62",
   "msg": "0x3097"
  },
  {
   "id": "b_007001:0x416a8",
   "off": 267944,
   "max": 56,
   "kind": "dialogue",
   "jp": "拒めば拒むほど\\n苦しくなるぞ？\\n片魂はお前を欲している",
   "en": "",
   "op": "0x62",
   "msg": "0x3098"
  },
  {
   "id": "b_007001:0x41bf0",
   "off": 269296,
   "max": 68,
   "kind": "dialogue",
   "jp": "井伊の言葉に呼応するように\\n光は瞬き　沖田の周りを\\nクルクルと回る",
   "en": "",
   "op": "0x62",
   "msg": "0x3099"
  },
  {
   "id": "b_007001:0x42074",
   "off": 270452,
   "max": 52,
   "kind": "dialogue",
   "jp": "い　嫌だ……\\n助けて……\\n土方さん　近藤さん……",
   "en": "",
   "op": "0x62",
   "msg": "0x309a"
  },
  {
   "id": "b_007001:0x42884",
   "off": 272516,
   "max": 72,
   "kind": "dialogue",
   "jp": "その近藤も土方も新選組も\\nお前が望むのならば\\nすべて生かすことが出来る",
   "en": "",
   "op": "0x62",
   "msg": "0x309b"
  },
  {
   "id": "b_007001:0x42de0",
   "off": 273888,
   "max": 16,
   "kind": "dialogue",
   "jp": "……本当に？",
   "en": "",
   "op": "0x62",
   "msg": "0x309c"
  },
  {
   "id": "b_007001:0x43308",
   "off": 275208,
   "max": 60,
   "kind": "dialogue",
   "jp": "ああ……本当だ\\nお前は歌えばいい\\nお前の望むまま歌えばいい",
   "en": "",
   "op": "0x62",
   "msg": "0x309d"
  },
  {
   "id": "b_007001:0x438d0",
   "off": 276688,
   "max": 36,
   "kind": "dialogue",
   "jp": "霞む意識の中\\n沖田の腕が光を掴む",
   "en": "",
   "op": "0x62",
   "msg": "0x309e"
  },
  {
   "id": "b_007001:0x43904",
   "off": 276740,
   "max": 76,
   "kind": "dialogue",
   "jp": "光は一瞬逃げるように\\n身じろいだ後\\n沖田の身体に雪のように\\n溶けていった",
   "en": "",
   "op": "0x62",
   "msg": "0x309f"
  },
  {
   "id": "b_007001:0x43e98",
   "off": 278168,
   "max": 84,
   "kind": "dialogue",
   "jp": "近藤が引退を発表したのは\\n沖田が最後にして\\n最大の遅刻をした\\nある夕闇の雷舞のこと",
   "en": "",
   "op": "0x62",
   "msg": "0x30a0"
  },
  {
   "id": "b_007001:0x43efc",
   "off": 278268,
   "max": 88,
   "kind": "dialogue",
   "jp": "『自分が表に出るよりも\\nもっと隊士達を育てたい』\\n近藤の引退公演は\\n沢山の集客を生み",
   "en": "",
   "op": "0x62",
   "msg": "0x30a1"
  },
  {
   "id": "b_007001:0x43f64",
   "off": 278372,
   "max": 64,
   "kind": "dialogue",
   "jp": "そこで　大々的に後釜に\\n推された沖田は\\n新選組一の人気者となる",
   "en": "",
   "op": "0x62",
   "msg": "0x30a2"
  },
  {
   "id": "b_007001:0x44418",
   "off": 279576,
   "max": 32,
   "kind": "dialogue",
   "jp": "……近藤さんは\\n僕が守ります",
   "en": "",
   "op": "0x62",
   "msg": "0x30a3"
  },
  {
   "id": "b_007001:0x448b8",
   "off": 280760,
   "max": 48,
   "kind": "dialogue",
   "jp": "この命にかけても……\\nこの心が闇に呑まれても",
   "en": "",
   "op": "0x62",
   "msg": "0x30a4"
  },
  {
   "id": "b_007001:0x451e4",
   "off": 283108,
   "max": 56,
   "kind": "dialogue",
   "jp": "な～んて　なにを\\nやっているんだろう\\n柄じゃないよね",
   "en": "",
   "op": "0x62",
   "msg": "0x30a5"
  },
  {
   "id": "b_007001:0x4522c",
   "off": 283180,
   "max": 44,
   "kind": "dialogue",
   "jp": "そう思わない？\\nそこに居る\\n……クズ達もさ",
   "en": "",
   "op": "0x62",
   "msg": "0x30a6"
  },
  {
   "id": "b_007001:0x458b8",
   "off": 284856,
   "max": 40,
   "kind": "dialogue",
   "jp": "ほう……\\nクズとは随分な\\n言いようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x30a7"
  },
  {
   "id": "b_007001:0x45df4",
   "off": 286196,
   "max": 44,
   "kind": "dialogue",
   "jp": "近藤さんが亡くなった\\nとたん　恩を忘れて",
   "en": "",
   "op": "0x62",
   "msg": "0x30a8"
  },
  {
   "id": "b_007001:0x45e30",
   "off": 286256,
   "max": 72,
   "kind": "dialogue",
   "jp": "井伊の走狗に成り下がった\\n元隊士を　クズ以外に\\nなんて呼べばいいの？",
   "en": "",
   "op": "0x62",
   "msg": "0x30a9"
  },
  {
   "id": "b_007001:0x46520",
   "off": 288032,
   "max": 68,
   "kind": "dialogue",
   "jp": "我々は　幕府直属の愛獲\\nとして正しい道を選んだ\\nただ　それだけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x30aa"
  },
  {
   "id": "b_007001:0x46a78",
   "off": 289400,
   "max": 20,
   "kind": "dialogue",
   "jp": "……で　何の用？",
   "en": "",
   "op": "0x62",
   "msg": "0x30ab"
  },
  {
   "id": "b_007001:0x47134",
   "off": 291124,
   "max": 40,
   "kind": "dialogue",
   "jp": "井伊様が　お前に\\n戻ってこいと仰せだ",
   "en": "",
   "op": "0x62",
   "msg": "0x30ac"
  },
  {
   "id": "b_007001:0x47804",
   "off": 292868,
   "max": 68,
   "kind": "dialogue",
   "jp": "今までの裏切り行為も\\n許し新選組も復活させて\\n下さるとも約束された",
   "en": "",
   "op": "0x62",
   "msg": "0x30ad"
  },
  {
   "id": "b_007001:0x47d5c",
   "off": 294236,
   "max": 52,
   "kind": "dialogue",
   "jp": "裏切り行為ってなんの事？\\n意味わかんないんだけど",
   "en": "",
   "op": "0x62",
   "msg": "0x30ae"
  },
  {
   "id": "b_007001:0x486d4",
   "off": 296660,
   "max": 56,
   "kind": "dialogue",
   "jp": "とぼけるな\\n井伊様に反逆し\\n坂本を助けるような行動だ",
   "en": "",
   "op": "0x62",
   "msg": "0x30af"
  },
  {
   "id": "b_007001:0x48e70",
   "off": 298608,
   "max": 68,
   "kind": "dialogue",
   "jp": "まあまあ……落ち着け\\n沖田　新選組一賢い\\nお前ならわかるだろう？",
   "en": "",
   "op": "0x62",
   "msg": "0x30b0"
  },
  {
   "id": "b_007001:0x48ec4",
   "off": 298692,
   "max": 68,
   "kind": "dialogue",
   "jp": "幕府御用達愛獲が一夜で\\nお尋ね者だ……我々が\\nどんな思いだったかを",
   "en": "",
   "op": "0x62",
   "msg": "0x30b1"
  },
  {
   "id": "b_007001:0x4968c",
   "off": 300684,
   "max": 32,
   "kind": "dialogue",
   "jp": "ごめん\\nさっぱり　わからないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x30b2"
  },
  {
   "id": "b_007001:0x49cf4",
   "off": 302324,
   "max": 76,
   "kind": "dialogue",
   "jp": "今まで　俺たちは新選組に\\n誠心誠意　尽くしてきた\\nなのに近藤は裏切った",
   "en": "",
   "op": "0x62",
   "msg": "0x30b3"
  },
  {
   "id": "b_007001:0x49d50",
   "off": 302416,
   "max": 76,
   "kind": "dialogue",
   "jp": "恩を仇で返すとは近藤の\\n事だ　井伊様はあんなに\\n良くして下さったのに……",
   "en": "",
   "op": "0x62",
   "msg": "0x30b4"
  },
  {
   "id": "b_007001:0x4a7a0",
   "off": 305056,
   "max": 36,
   "kind": "dialogue",
   "jp": "……なに　それ\\n本気で言ってる？",
   "en": "",
   "op": "0x62",
   "msg": "0x30b5"
  },
  {
   "id": "b_007001:0x4ac40",
   "off": 306240,
   "max": 12,
   "kind": "dialogue",
   "jp": "斬るよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x30b6"
  },
  {
   "id": "b_007001:0x4b408",
   "off": 308232,
   "max": 40,
   "kind": "dialogue",
   "jp": "おお　怖い……\\n綺麗な顔が台無しだぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x30b7"
  },
  {
   "id": "b_007001:0x4ba70",
   "off": 309872,
   "max": 48,
   "kind": "dialogue",
   "jp": "なあ……もう我慢出来ない\\nコイツ……殺そうぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x30b8"
  },
  {
   "id": "b_007001:0x4c60c",
   "off": 312844,
   "max": 64,
   "kind": "dialogue",
   "jp": "クズの腕で　僕をどうにか\\n出来るわけないじゃない？\\nバカなの？",
   "en": "",
   "op": "0x62",
   "msg": "0x30b9"
  },
  {
   "id": "b_007001:0x4cc8c",
   "off": 314508,
   "max": 48,
   "kind": "dialogue",
   "jp": "……クズ？\\n今の俺たちは\\n昔の俺たちじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x30ba"
  },
  {
   "id": "b_007001:0x4d3d8",
   "off": 316376,
   "max": 52,
   "kind": "dialogue",
   "jp": "月明かりの中\\n隊士達の影がゆらりと\\n大きく膨らむ",
   "en": "",
   "op": "0x62",
   "msg": "0x30bb"
  },
  {
   "id": "b_007001:0x4dc0c",
   "off": 318476,
   "max": 52,
   "kind": "dialogue",
   "jp": "お前に　負け続けた\\n隊士時代の俺たちじゃ\\nないんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x30bc"
  },
  {
   "id": "b_007001:0x4e504",
   "off": 320772,
   "max": 24,
   "kind": "dialogue",
   "jp": "その姿……まさか……",
   "en": "",
   "op": "0x62",
   "msg": "0x30bd"
  },
  {
   "id": "b_007001:0x4eeac",
   "off": 323244,
   "max": 80,
   "kind": "dialogue",
   "jp": "二人の顔がみるみる歪み\\n身体はねじくれ\\n四肢は地を這い\\n獣のような臭いが漂う",
   "en": "",
   "op": "0x62",
   "msg": "0x30be"
  },
  {
   "id": "b_007001:0x4f6ec",
   "off": 325356,
   "max": 44,
   "kind": "dialogue",
   "jp": "我々は　井伊様から\\n特別な力を頂いたのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x30bf"
  },
  {
   "id": "b_007001:0x4fac8",
   "off": 326344,
   "max": 116,
   "kind": "dialogue",
   "jp": "陰口を叩かれたこともある\\n喧嘩をふっかけられたことも\\n一度や二度ではない\\nしかし　それも上を目指すが\\n故のこと……",
   "en": "",
   "op": "0x62",
   "msg": "0x30c0"
  },
  {
   "id": "b_007001:0x4fb4c",
   "off": 326476,
   "max": 80,
   "kind": "dialogue",
   "jp": "近藤さんと一緒に歌いたい\\n近藤さんに認められたい\\n新選組として舞台に立ちたい",
   "en": "",
   "op": "0x62",
   "msg": "0x30c1"
  },
  {
   "id": "b_007001:0x4fbac",
   "off": 326572,
   "max": 68,
   "kind": "dialogue",
   "jp": "彼らは隊士として\\n同じ釜の飯を食い　共に\\n切磋琢磨した仲間だった",
   "en": "",
   "op": "0x62",
   "msg": "0x30c2"
  },
  {
   "id": "b_007001:0x50030",
   "off": 327728,
   "max": 72,
   "kind": "dialogue",
   "jp": "僕への嫉妬　近藤さんを\\n失った悲しみ……それを\\n井伊に歪められたんだね",
   "en": "",
   "op": "0x62",
   "msg": "0x30c3"
  },
  {
   "id": "b_007001:0x50424",
   "off": 328740,
   "max": 20,
   "kind": "dialogue",
   "jp": "沖田の頬を涙が伝う",
   "en": "",
   "op": "0x62",
   "msg": "0x30c4"
  },
  {
   "id": "b_007001:0x50670",
   "off": 329328,
   "max": 112,
   "kind": "dialogue",
   "jp": "彼らは　井伊の元に\\n走ったのではない\\nただ　少しだけ\\n他の隊士より闇が深かった\\nそれを利用されて\\nしまったのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x30c5"
  },
  {
   "id": "b_007001:0x509e8",
   "off": 330216,
   "max": 16,
   "kind": "dialogue",
   "jp": "僕と同じだね",
   "en": "",
   "op": "0x62",
   "msg": "0x30c6"
  },
  {
   "id": "b_007001:0x5159c",
   "off": 333212,
   "max": 32,
   "kind": "dialogue",
   "jp": "僕の歌で\\n今　楽にしてあげるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x30c7"
  },
  {
   "id": "b_007001:0x515cc",
   "off": 333260,
   "max": 40,
   "kind": "dialogue",
   "jp": "心に届くはず\\nいいや　必ず届かせるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x30c8"
  },
  {
   "id": "b_007001:0x51604",
   "off": 333316,
   "max": 36,
   "kind": "dialogue",
   "jp": "僕の歌が　君達を\\n解放する……！",
   "en": "",
   "op": "0x62",
   "msg": "0x30c9"
  }
 ]
}
