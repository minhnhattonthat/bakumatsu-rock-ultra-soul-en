{
 "source": "b_007002.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_007002:0x12f8",
   "off": 4856,
   "max": 12,
   "kind": "dialogue",
   "jp": "ううっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x30ca"
  },
  {
   "id": "b_007002:0x16b0",
   "off": 5808,
   "max": 124,
   "kind": "dialogue",
   "jp": "沖田に敗れた二人の身体は\\nぐずぐずと崩れてゆく……\\n井伊に力を与えられた時\\nすでに彼らは　人間では\\nなくなっていたのだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x30cb"
  },
  {
   "id": "b_007002:0x1c58",
   "off": 7256,
   "max": 16,
   "kind": "dialogue",
   "jp": "さようなら……",
   "en": "",
   "op": "0x62",
   "msg": "0x30cc"
  },
  {
   "id": "b_007002:0x20f8",
   "off": 8440,
   "max": 116,
   "kind": "dialogue",
   "jp": "今まで数え切れないほど\\n人を斬り命を奪ってきた\\nそこには迷いも憐れみも\\n無く　悼みの心など一度も\\n持ったことはない",
   "en": "",
   "op": "0x62",
   "msg": "0x30cd"
  },
  {
   "id": "b_007002:0x25b8",
   "off": 9656,
   "max": 28,
   "kind": "dialogue",
   "jp": "……けれど\\n君達には祈るよ",
   "en": "",
   "op": "0x62",
   "msg": "0x30ce"
  },
  {
   "id": "b_007002:0x25e4",
   "off": 9700,
   "max": 40,
   "kind": "dialogue",
   "jp": "近藤さんと同じとこに\\n行けるように……",
   "en": "",
   "op": "0x62",
   "msg": "0x30cf"
  },
  {
   "id": "b_007002:0x2a50",
   "off": 10832,
   "max": 64,
   "kind": "dialogue",
   "jp": "沖田の目から\\n幾筋も涙がこぼれ落ち\\n仲間の身体と共に消えていく",
   "en": "",
   "op": "0x62",
   "msg": "0x30d0"
  },
  {
   "id": "b_007002:0x2d98",
   "off": 11672,
   "max": 36,
   "kind": "dialogue",
   "jp": "そしたら　君達は\\n僕を出し抜けるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x30d1"
  },
  {
   "id": "b_007002:0x343c",
   "off": 13372,
   "max": 40,
   "kind": "dialogue",
   "jp": "近藤さんに一足早く\\n会えるんだから……",
   "en": "",
   "op": "0x62",
   "msg": "0x30d2"
  },
  {
   "id": "b_007002:0x3b6c",
   "off": 15212,
   "max": 12,
   "kind": "dialogue",
   "jp": "うわっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x30d3"
  },
  {
   "id": "b_007002:0x40b0",
   "off": 16560,
   "max": 84,
   "kind": "dialogue",
   "jp": "思わず目を閉じた沖田の涙を\\n隊士達の溶けた身体を\\n攫うように\\n大きな風が吹き抜けた",
   "en": "",
   "op": "0x62",
   "msg": "0x30d4"
  },
  {
   "id": "b_007002:0x4530",
   "off": 17712,
   "max": 24,
   "kind": "dialogue",
   "jp": "……よく　頑張ったな",
   "en": "",
   "op": "0x62",
   "msg": "0x30d5"
  },
  {
   "id": "b_007002:0x4bcc",
   "off": 19404,
   "max": 28,
   "kind": "dialogue",
   "jp": "いま　近藤さんの声が……",
   "en": "",
   "op": "0x62",
   "msg": "0x30d6"
  },
  {
   "id": "b_007002:0x5084",
   "off": 20612,
   "max": 104,
   "kind": "dialogue",
   "jp": "目を開けると　そこは\\n何もない街道だった\\n沖田の涙も　まるで\\n誰かが拭ってくれたように\\n吹き飛んでいた",
   "en": "",
   "op": "0x62",
   "msg": "0x30d7"
  },
  {
   "id": "b_007002:0x5698",
   "off": 22168,
   "max": 28,
   "kind": "dialogue",
   "jp": "近藤さん……\\nありがとう",
   "en": "",
   "op": "0x62",
   "msg": "0x30d8"
  },
  {
   "id": "b_007002:0x5d1c",
   "off": 23836,
   "max": 48,
   "kind": "dialogue",
   "jp": "沖田は空を見上げて\\nもう一度\\n月へと語りかける",
   "en": "",
   "op": "0x62",
   "msg": "0x30d9"
  },
  {
   "id": "b_007002:0x6054",
   "off": 24660,
   "max": 72,
   "kind": "dialogue",
   "jp": "どんなに闇が暗くても\\nどんなに道が険しくても\\nもう　見失うことはない",
   "en": "",
   "op": "0x62",
   "msg": "0x30da"
  },
  {
   "id": "b_007002:0x651c",
   "off": 25884,
   "max": 56,
   "kind": "dialogue",
   "jp": "僕の心に……闇の中にも\\n貴方という月は\\n輝き続けるから",
   "en": "",
   "op": "0x62",
   "msg": "0x30db"
  }
 ]
}
