{
 "source": "b_008001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_008001:0x10e8",
   "off": 4328,
   "max": 12,
   "kind": "dialogue",
   "jp": "桂の部屋",
   "en": "",
   "op": "0x62",
   "msg": "0x295e"
  },
  {
   "id": "b_008001:0x1538",
   "off": 5432,
   "max": 40,
   "kind": "dialogue",
   "jp": "ふふふ……　\\nようやく完成しましたね",
   "en": "",
   "op": "0x62",
   "msg": "0x295f"
  },
  {
   "id": "b_008001:0x160c",
   "off": 5644,
   "max": 64,
   "kind": "dialogue",
   "jp": "怪しい露店で手に入れた\\n源内先生秘伝という\\nからくり図鑑……",
   "en": "",
   "op": "0x62",
   "msg": "0x2960"
  },
  {
   "id": "b_008001:0x165c",
   "off": 5724,
   "max": 56,
   "kind": "dialogue",
   "jp": "ず～っと\\n研究していましたよ\\nこの中身入れ替え装置！",
   "en": "",
   "op": "0x62",
   "msg": "0x2961"
  },
  {
   "id": "b_008001:0x2178",
   "off": 8568,
   "max": 24,
   "kind": "dialogue",
   "jp": "名付けて　ちぇんじ君！",
   "en": "",
   "op": "0x62",
   "msg": "0x2962"
  },
  {
   "id": "b_008001:0x29d4",
   "off": 10708,
   "max": 76,
   "kind": "dialogue",
   "jp": "まあ　作りたかっただけで\\n何に使うかはぜ～んぜん\\n考えてないんですけどね",
   "en": "",
   "op": "0x62",
   "msg": "0x2963"
  },
  {
   "id": "b_008001:0x2a30",
   "off": 10800,
   "max": 56,
   "kind": "dialogue",
   "jp": "あ～あ～\\nそれにしてもずいぶん\\n散らかしてしまいました",
   "en": "",
   "op": "0x62",
   "msg": "0x2964"
  },
  {
   "id": "b_008001:0x3268",
   "off": 12904,
   "max": 48,
   "kind": "dialogue",
   "jp": "おい　桂さん　いるか……\\nってなんだこの惨状は",
   "en": "",
   "op": "0x62",
   "msg": "0x2965"
  },
  {
   "id": "b_008001:0x3714",
   "off": 14100,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああ　晋作ですか",
   "en": "",
   "op": "0x62",
   "msg": "0x2966"
  },
  {
   "id": "b_008001:0x3c40",
   "off": 15424,
   "max": 40,
   "kind": "dialogue",
   "jp": "どうせまた変な発明でも\\nしてたんだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2967"
  },
  {
   "id": "b_008001:0x3c78",
   "off": 15480,
   "max": 68,
   "kind": "dialogue",
   "jp": "ったく普段はきれい好きの\\nくせに　何か作り始めると\\n散らかしやがる",
   "en": "",
   "op": "0x62",
   "msg": "0x2968"
  },
  {
   "id": "b_008001:0x4314",
   "off": 17172,
   "max": 28,
   "kind": "dialogue",
   "jp": "変とはなんですか　変とは",
   "en": "",
   "op": "0x62",
   "msg": "0x2969"
  },
  {
   "id": "b_008001:0x4838",
   "off": 18488,
   "max": 56,
   "kind": "dialogue",
   "jp": "言葉通りだろ\\nったく　今度はいったい\\n何を作ったんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x296a"
  },
  {
   "id": "b_008001:0x5110",
   "off": 20752,
   "max": 40,
   "kind": "dialogue",
   "jp": "あっ　ちょっと不用意に\\n触らないで……",
   "en": "",
   "op": "0x62",
   "msg": "0x296b"
  },
  {
   "id": "b_008001:0x5b08",
   "off": 23304,
   "max": 12,
   "kind": "dialogue",
   "jp": "うおっっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x296c"
  },
  {
   "id": "b_008001:0x6160",
   "off": 24928,
   "max": 28,
   "kind": "dialogue",
   "jp": "おい桂\\n少し話がある……",
   "en": "",
   "op": "0x62",
   "msg": "0x296d"
  },
  {
   "id": "b_008001:0x69c0",
   "off": 27072,
   "max": 16,
   "kind": "dialogue",
   "jp": "な　なんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x296e"
  },
  {
   "id": "b_008001:0x7030",
   "off": 28720,
   "max": 24,
   "kind": "dialogue",
   "jp": "うわぁぁぁぁぁぁぁ！",
   "en": "",
   "op": "0x62",
   "msg": "0x296f"
  },
  {
   "id": "b_008001:0x7730",
   "off": 30512,
   "max": 48,
   "kind": "dialogue",
   "jp": "ふぅ……これは閃光弾か？\\nびっくりさせやがる",
   "en": "",
   "op": "0x62",
   "msg": "0x2970"
  },
  {
   "id": "b_008001:0x7e04",
   "off": 32260,
   "max": 20,
   "kind": "dialogue",
   "jp": "いや　違いますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2971"
  },
  {
   "id": "b_008001:0x84c4",
   "off": 33988,
   "max": 24,
   "kind": "dialogue",
   "jp": "じゃあ　なんだって……",
   "en": "",
   "op": "0x62",
   "msg": "0x2972"
  },
  {
   "id": "b_008001:0x8b38",
   "off": 35640,
   "max": 12,
   "kind": "dialogue",
   "jp": "む　う……",
   "en": "",
   "op": "0x62",
   "msg": "0x2973"
  },
  {
   "id": "b_008001:0x9210",
   "off": 37392,
   "max": 44,
   "kind": "dialogue",
   "jp": "うわっ　なんでオレ様が\\nもう一人いるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2974"
  },
  {
   "id": "b_008001:0x9908",
   "off": 39176,
   "max": 76,
   "kind": "dialogue",
   "jp": "そう言うお前こそ　俺と\\nうり二つじゃないか……\\nってなんだ　この恰好は！",
   "en": "",
   "op": "0x62",
   "msg": "0x2975"
  },
  {
   "id": "b_008001:0xa07c",
   "off": 41084,
   "max": 52,
   "kind": "dialogue",
   "jp": "ぎゃあああ！\\nなんでオレ様が新選組の\\n隊服なんか！",
   "en": "",
   "op": "0x62",
   "msg": "0x2976"
  },
  {
   "id": "b_008001:0xa870",
   "off": 43120,
   "max": 68,
   "kind": "dialogue",
   "jp": "やった！　発明は\\n成功のようですね！\\n素晴らしい！\\n万歳（ビバ）！",
   "en": "",
   "op": "0x62",
   "msg": "0x2977"
  },
  {
   "id": "b_008001:0xae7c",
   "off": 44668,
   "max": 44,
   "kind": "dialogue",
   "jp": "成功って……桂さん\\nあんた　何しやがった！",
   "en": "",
   "op": "0x62",
   "msg": "0x2978"
  },
  {
   "id": "b_008001:0xb3c0",
   "off": 46016,
   "max": 40,
   "kind": "dialogue",
   "jp": "さっきのアレは閃光弾じゃ\\nなくてですね",
   "en": "",
   "op": "0x62",
   "msg": "0x2979"
  },
  {
   "id": "b_008001:0xb3f8",
   "off": 46072,
   "max": 44,
   "kind": "dialogue",
   "jp": "人間の中身を入れ替える\\n装置だったんです",
   "en": "",
   "op": "0x62",
   "msg": "0x297a"
  },
  {
   "id": "b_008001:0xbac8",
   "off": 47816,
   "max": 60,
   "kind": "dialogue",
   "jp": "それで俺と高杉の中身が\\n入れ替わってしまったと\\nいうわけか",
   "en": "",
   "op": "0x62",
   "msg": "0x297b"
  },
  {
   "id": "b_008001:0xc3d8",
   "off": 50136,
   "max": 56,
   "kind": "dialogue",
   "jp": "何してくれてんだー！\\nこんな恰好\\nロックじゃねえだろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x297c"
  },
  {
   "id": "b_008001:0xc9ac",
   "off": 51628,
   "max": 64,
   "kind": "dialogue",
   "jp": "って言われても私の\\n発明品を勝手に弄ったのは\\n晋作ですよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x297d"
  },
  {
   "id": "b_008001:0xd044",
   "off": 53316,
   "max": 48,
   "kind": "dialogue",
   "jp": "ぐっ……\\nい　いいから早く元に\\n戻しやがれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x297e"
  },
  {
   "id": "b_008001:0xd618",
   "off": 54808,
   "max": 60,
   "kind": "dialogue",
   "jp": "はいはい\\nこのボタンをぽちっと……\\nあれ？　ぽちっと……",
   "en": "",
   "op": "0x62",
   "msg": "0x297f"
  },
  {
   "id": "b_008001:0xe098",
   "off": 57496,
   "max": 64,
   "kind": "dialogue",
   "jp": "ご　ごめんなさい\\n元に戻す機能が上手く\\n働いてないみたいです",
   "en": "",
   "op": "0x62",
   "msg": "0x2980"
  },
  {
   "id": "b_008001:0xe784",
   "off": 59268,
   "max": 24,
   "kind": "dialogue",
   "jp": "ごめんじゃねぇぇぇぇ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2981"
  },
  {
   "id": "b_008001:0xeebc",
   "off": 61116,
   "max": 64,
   "kind": "dialogue",
   "jp": "落ち着け　そう怒鳴るな\\n血管が切れるぞ\\n煮干しでも食べるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2982"
  },
  {
   "id": "b_008001:0xf380",
   "off": 62336,
   "max": 28,
   "kind": "dialogue",
   "jp": "テメェは何落ち着いてんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2983"
  },
  {
   "id": "b_008001:0xf8b4",
   "off": 63668,
   "max": 40,
   "kind": "dialogue",
   "jp": "騒いでも仕方なかろう\\nしかし　困った",
   "en": "",
   "op": "0x62",
   "msg": "0x2984"
  },
  {
   "id": "b_008001:0x10064",
   "off": 65636,
   "max": 40,
   "kind": "dialogue",
   "jp": "すみませんね　土方さん\\n晋作のせいで",
   "en": "",
   "op": "0x62",
   "msg": "0x2985"
  },
  {
   "id": "b_008001:0x109b4",
   "off": 68020,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレ様のせい\\nオレ様のせいなのか",
   "en": "",
   "op": "0x62",
   "msg": "0x2986"
  },
  {
   "id": "b_008001:0x10edc",
   "off": 69340,
   "max": 44,
   "kind": "dialogue",
   "jp": "誰のせいかはいい\\nただ昼から用事があって",
   "en": "",
   "op": "0x62",
   "msg": "0x2987"
  },
  {
   "id": "b_008001:0x11420",
   "off": 70688,
   "max": 64,
   "kind": "dialogue",
   "jp": "それで屋敷を留守にすると\\n伝えに来たのだが……\\nむう　困った",
   "en": "",
   "op": "0x62",
   "msg": "0x2988"
  },
  {
   "id": "b_008001:0x11470",
   "off": 70768,
   "max": 36,
   "kind": "dialogue",
   "jp": "この姿では人前に\\n出るわけにいかん",
   "en": "",
   "op": "0x62",
   "msg": "0x2989"
  },
  {
   "id": "b_008001:0x11aec",
   "off": 72428,
   "max": 56,
   "kind": "dialogue",
   "jp": "テメェ　オレ様の顔に\\nなんか文句でもあんのか\\n土方ぁ！",
   "en": "",
   "op": "0x62",
   "msg": "0x298a"
  },
  {
   "id": "b_008001:0x120c0",
   "off": 73920,
   "max": 56,
   "kind": "dialogue",
   "jp": "その顔で土方と\\n怒鳴られるとなんというか\\n不思議だな",
   "en": "",
   "op": "0x62",
   "msg": "0x298b"
  },
  {
   "id": "b_008001:0x12610",
   "off": 75280,
   "max": 52,
   "kind": "dialogue",
   "jp": "んなこたどうでも\\nいいんだ！\\nあー　しかし困ったぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x298c"
  },
  {
   "id": "b_008001:0x12654",
   "off": 75348,
   "max": 64,
   "kind": "dialogue",
   "jp": "オレ様も昼から龍馬と\\nテラーダの手伝いをする\\n約束があったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x298d"
  },
  {
   "id": "b_008001:0x12d38",
   "off": 77112,
   "max": 36,
   "kind": "dialogue",
   "jp": "へえ　晋作が\\nお手伝いをですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x298e"
  },
  {
   "id": "b_008001:0x13274",
   "off": 78452,
   "max": 56,
   "kind": "dialogue",
   "jp": "仕方ねえだろ\\nお登勢さんにはいつも\\n世話になってんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x298f"
  },
  {
   "id": "b_008001:0x132bc",
   "off": 78524,
   "max": 28,
   "kind": "dialogue",
   "jp": "でも　この恰好じゃな……",
   "en": "",
   "op": "0x62",
   "msg": "0x2990"
  },
  {
   "id": "b_008001:0x13754",
   "off": 79700,
   "max": 60,
   "kind": "dialogue",
   "jp": "どうしてです？\\n龍馬くんに事情を話せば\\nいいじゃないですか",
   "en": "",
   "op": "0x62",
   "msg": "0x2991"
  },
  {
   "id": "b_008001:0x13ca8",
   "off": 81064,
   "max": 52,
   "kind": "dialogue",
   "jp": "アホ！　こんなアホな失敗\\n龍馬に知られてたまるか！",
   "en": "",
   "op": "0x62",
   "msg": "0x2992"
  },
  {
   "id": "b_008001:0x14380",
   "off": 82816,
   "max": 64,
   "kind": "dialogue",
   "jp": "俺も総司に知られたら\\nここぞとばかりに\\nからかわれるだろうな",
   "en": "",
   "op": "0x62",
   "msg": "0x2993"
  },
  {
   "id": "b_008001:0x14984",
   "off": 84356,
   "max": 12,
   "kind": "dialogue",
   "jp": "う～ん……",
   "en": "",
   "op": "0x62",
   "msg": "0x2994"
  },
  {
   "id": "b_008001:0x1511c",
   "off": 86300,
   "max": 68,
   "kind": "dialogue",
   "jp": "じゃあ　それぞれ\\n入れ替わったまま行けば\\nいいんじゃないですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2995"
  },
  {
   "id": "b_008001:0x15170",
   "off": 86384,
   "max": 56,
   "kind": "dialogue",
   "jp": "晋作は土方さん\\n土方さんは晋作のふりを\\nするんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2996"
  },
  {
   "id": "b_008001:0x15990",
   "off": 88464,
   "max": 36,
   "kind": "dialogue",
   "jp": "オレ様がコイツに\\nなりすますだと？",
   "en": "",
   "op": "0x62",
   "msg": "0x2997"
  },
  {
   "id": "b_008001:0x1613c",
   "off": 90428,
   "max": 60,
   "kind": "dialogue",
   "jp": "ええ　それが出来るくらい\\n仲間のことが\\nわかってないとね",
   "en": "",
   "op": "0x62",
   "msg": "0x2998"
  },
  {
   "id": "b_008001:0x16960",
   "off": 92512,
   "max": 44,
   "kind": "dialogue",
   "jp": "……日頃の観察力が\\n問われるということか",
   "en": "",
   "op": "0x62",
   "msg": "0x2999"
  },
  {
   "id": "b_008001:0x16ea4",
   "off": 93860,
   "max": 20,
   "kind": "dialogue",
   "jp": "面白そうじゃねえか",
   "en": "",
   "op": "0x62",
   "msg": "0x299a"
  },
  {
   "id": "b_008001:0x17640",
   "off": 95808,
   "max": 68,
   "kind": "dialogue",
   "jp": "じゃ　私はその間に\\n装置を修理しておきます\\n頑張ってくださいね～",
   "en": "",
   "op": "0x62",
   "msg": "0x299b"
  },
  {
   "id": "b_008001:0x17b1c",
   "off": 97052,
   "max": 48,
   "kind": "dialogue",
   "jp": "こうして\\n中身の入れ替わった\\n高杉と土方は……",
   "en": "",
   "op": "0x62",
   "msg": "0x299c"
  },
  {
   "id": "b_008001:0x17b5c",
   "off": 97116,
   "max": 72,
   "kind": "dialogue",
   "jp": "それぞれの役目を\\nこなすため\\nお互いを演じることに\\nなったのであった",
   "en": "",
   "op": "0x62",
   "msg": "0x299d"
  },
  {
   "id": "b_008001:0x1831c",
   "off": 99100,
   "max": 40,
   "kind": "dialogue",
   "jp": "龍ちゃ～ん\\nこれ　三番卓に\\nお願いね～",
   "en": "",
   "op": "0x62",
   "msg": "0x299e"
  },
  {
   "id": "b_008001:0x189e4",
   "off": 100836,
   "max": 24,
   "kind": "dialogue",
   "jp": "ほーい　わかったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x299f"
  },
  {
   "id": "b_008001:0x191fc",
   "off": 102908,
   "max": 52,
   "kind": "dialogue",
   "jp": "いらっしゃいませー……\\nって　シンディ遅かったな",
   "en": "",
   "op": "0x62",
   "msg": "0x29a0"
  },
  {
   "id": "b_008001:0x196ac",
   "off": 104108,
   "max": 36,
   "kind": "dialogue",
   "jp": "すまない\\n少々準備に手間取っていた",
   "en": "",
   "op": "0x62",
   "msg": "0x29a1"
  },
  {
   "id": "b_008001:0x19be4",
   "off": 105444,
   "max": 48,
   "kind": "dialogue",
   "jp": "そーかそーか　そんじゃ\\nまずは腹ごしらえじゃな",
   "en": "",
   "op": "0x62",
   "msg": "0x29a2"
  },
  {
   "id": "b_008001:0x1a77c",
   "off": 108412,
   "max": 64,
   "kind": "dialogue",
   "jp": "お登勢やん\\n特製ぴっつぁに\\nたっぷりタバスコ\\nかけといたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x29a3"
  },
  {
   "id": "b_008001:0x1b2f4",
   "off": 111348,
   "max": 36,
   "kind": "dialogue",
   "jp": "これはっ……\\n人間の食べ物なのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x29a4"
  },
  {
   "id": "b_008001:0x1b940",
   "off": 112960,
   "max": 60,
   "kind": "dialogue",
   "jp": "何を言ってるんじゃ？\\nいつもコレを喜んで\\n食べてるくせにー",
   "en": "",
   "op": "0x62",
   "msg": "0x29a5"
  },
  {
   "id": "b_008001:0x1ba34",
   "off": 113204,
   "max": 76,
   "kind": "dialogue",
   "jp": "それとも腹でも痛いのか？\\nそういや今日のシンディ\\nなんか様子が変ぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x29a6"
  },
  {
   "id": "b_008001:0x1c0d8",
   "off": 114904,
   "max": 44,
   "kind": "dialogue",
   "jp": "い　いや食べる！\\n食べるぞ！\\n……ばくっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x29a7"
  },
  {
   "id": "b_008001:0x1c69c",
   "off": 116380,
   "max": 48,
   "kind": "dialogue",
   "jp": "おお　さっすがシンディ\\nいい食いっぷりぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x29a8"
  },
  {
   "id": "b_008001:0x1cdf4",
   "off": 118260,
   "max": 20,
   "kind": "dialogue",
   "jp": "～～～～～っっ",
   "en": "",
   "op": "0x62",
   "msg": "0x29a9"
  },
  {
   "id": "b_008001:0x1d284",
   "off": 119428,
   "max": 48,
   "kind": "dialogue",
   "jp": "……あ　あいつは普段\\n何を食べてるんだ　何を",
   "en": "",
   "op": "0x62",
   "msg": "0x29aa"
  },
  {
   "id": "b_008001:0x1d7c8",
   "off": 120776,
   "max": 60,
   "kind": "dialogue",
   "jp": "あ　そうじゃ\\nシンディ　食い終わったら\\n厨房を手伝ってくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x29ab"
  },
  {
   "id": "b_008001:0x1ded8",
   "off": 122584,
   "max": 48,
   "kind": "dialogue",
   "jp": "ちゅ　厨房を？\\nだが男子厨房に\\n入らずと……",
   "en": "",
   "op": "0x62",
   "msg": "0x29ac"
  },
  {
   "id": "b_008001:0x1e41c",
   "off": 123932,
   "max": 60,
   "kind": "dialogue",
   "jp": "またまたー　シンディは\\n厨房はロックだと\\n言ってるくせにー",
   "en": "",
   "op": "0x62",
   "msg": "0x29ad"
  },
  {
   "id": "b_008001:0x1e96c",
   "off": 125292,
   "max": 48,
   "kind": "dialogue",
   "jp": "冗談にしては\\n上手くないぜよ\\n熱でもあるんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x29ae"
  },
  {
   "id": "b_008001:0x1f018",
   "off": 127000,
   "max": 68,
   "kind": "dialogue",
   "jp": "ない！　ないから　そう\\n顔を近づけるな！\\nわかった！　料理だな！",
   "en": "",
   "op": "0x62",
   "msg": "0x29af"
  },
  {
   "id": "b_008001:0x1fa18",
   "off": 129560,
   "max": 60,
   "kind": "dialogue",
   "jp": "じゃあ　晋ちゃんは\\nこっちの玉ねぎと\\nトマトを切ってね～",
   "en": "",
   "op": "0x62",
   "msg": "0x29b0"
  },
  {
   "id": "b_008001:0x20084",
   "off": 131204,
   "max": 20,
   "kind": "dialogue",
   "jp": "む　むむむっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x29b1"
  },
  {
   "id": "b_008001:0x20514",
   "off": 132372,
   "max": 60,
   "kind": "dialogue",
   "jp": "あと粉を混ぜてよーく\\n練って　その上に切った\\n材料を……",
   "en": "",
   "op": "0x62",
   "msg": "0x29b2"
  },
  {
   "id": "b_008001:0x20b80",
   "off": 134016,
   "max": 36,
   "kind": "dialogue",
   "jp": "わかった！\\nだから一度に言うな！",
   "en": "",
   "op": "0x62",
   "msg": "0x29b3"
  },
  {
   "id": "b_008001:0x21120",
   "off": 135456,
   "max": 60,
   "kind": "dialogue",
   "jp": "四苦八苦しながらも\\nどうにか慣れぬ料理の\\n手伝いをする土方",
   "en": "",
   "op": "0x62",
   "msg": "0x29b4"
  },
  {
   "id": "b_008001:0x215a0",
   "off": 136608,
   "max": 40,
   "kind": "dialogue",
   "jp": "料理とは思ったより\\n大変なものだな……",
   "en": "",
   "op": "0x62",
   "msg": "0x29b5"
  },
  {
   "id": "b_008001:0x21ae0",
   "off": 137952,
   "max": 60,
   "kind": "dialogue",
   "jp": "そういえばいつも\\n高杉が出してくれるものは\\n手がこんでいる",
   "en": "",
   "op": "0x62",
   "msg": "0x29b6"
  },
  {
   "id": "b_008001:0x21b2c",
   "off": 138028,
   "max": 64,
   "kind": "dialogue",
   "jp": "がさつな男に見えるが\\n我らのために気遣いを\\nしてくれているのか",
   "en": "",
   "op": "0x62",
   "msg": "0x29b7"
  },
  {
   "id": "b_008001:0x2208c",
   "off": 139404,
   "max": 64,
   "kind": "dialogue",
   "jp": "あいつも龍馬と同じ\\n熱く優しい心を持った\\n男ということか……",
   "en": "",
   "op": "0x62",
   "msg": "0x29b8"
  },
  {
   "id": "b_008001:0x22820",
   "off": 141344,
   "max": 32,
   "kind": "dialogue",
   "jp": "何を笑ってるんじゃ？\\nシンディ",
   "en": "",
   "op": "0x62",
   "msg": "0x29b9"
  },
  {
   "id": "b_008001:0x22e08",
   "off": 142856,
   "max": 48,
   "kind": "dialogue",
   "jp": "笑ってなどいない\\nただ……\\n少し見直しただけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x29ba"
  },
  {
   "id": "b_008001:0x232bc",
   "off": 144060,
   "max": 8,
   "kind": "dialogue",
   "jp": "？？？",
   "en": "",
   "op": "0x62",
   "msg": "0x29bb"
  },
  {
   "id": "b_008001:0x23b74",
   "off": 146292,
   "max": 60,
   "kind": "dialogue",
   "jp": "一方　その頃　高杉は\\n沖田と共に新選組の\\n訓練に励んでいた",
   "en": "",
   "op": "0x62",
   "msg": "0x29bc"
  },
  {
   "id": "b_008001:0x24140",
   "off": 147776,
   "max": 64,
   "kind": "dialogue",
   "jp": "はいっ　そこ怠けない！\\n発声が腹式じゃ\\nなくなってるよぉ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x29bd"
  },
  {
   "id": "b_008001:0x24e7c",
   "off": 151164,
   "max": 28,
   "kind": "dialogue",
   "jp": "あふ～ん！\\nは　はいっっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x29be"
  },
  {
   "id": "b_008001:0x25828",
   "off": 153640,
   "max": 56,
   "kind": "dialogue",
   "jp": "走りながらでもしっかり\\nおなかから声が\\n出せないとね～",
   "en": "",
   "op": "0x62",
   "msg": "0x29bf"
  },
  {
   "id": "b_008001:0x25870",
   "off": 153712,
   "max": 36,
   "kind": "dialogue",
   "jp": "ほらっ　常に笑顔！\\n笑顔！　笑顔！",
   "en": "",
   "op": "0x62",
   "msg": "0x29c0"
  },
  {
   "id": "b_008001:0x26598",
   "off": 157080,
   "max": 40,
   "kind": "dialogue",
   "jp": "あふ～ん……\\nありがとうございます",
   "en": "",
   "op": "0x62",
   "msg": "0x29c1"
  },
  {
   "id": "b_008001:0x26d9c",
   "off": 159132,
   "max": 72,
   "kind": "dialogue",
   "jp": "誰がそんなへらへらした\\n笑顔にしろって言った？\\n女の子引くよ　それじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x29c2"
  },
  {
   "id": "b_008001:0x2771c",
   "off": 161564,
   "max": 20,
   "kind": "dialogue",
   "jp": "気を引き締めますっ",
   "en": "",
   "op": "0x62",
   "msg": "0x29c3"
  },
  {
   "id": "b_008001:0x280d4",
   "off": 164052,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x29c4"
  },
  {
   "id": "b_008001:0x280f0",
   "off": 164080,
   "max": 64,
   "kind": "dialogue",
   "jp": "こいつら　意外と\\n硬派（ハード）な練習を\\nしてやがるんだな……",
   "en": "",
   "op": "0x62",
   "msg": "0x29c5"
  },
  {
   "id": "b_008001:0x286c0",
   "off": 165568,
   "max": 36,
   "kind": "dialogue",
   "jp": "あれ？　どうしたんですか\\n土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x29c6"
  },
  {
   "id": "b_008001:0x28c18",
   "off": 166936,
   "max": 20,
   "kind": "dialogue",
   "jp": "いや　なんでもねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x29c7"
  },
  {
   "id": "b_008001:0x29148",
   "off": 168264,
   "max": 68,
   "kind": "dialogue",
   "jp": "あっれ～？　なんか\\n土方さんがスカシくん\\nみたいな話し方してる～",
   "en": "",
   "op": "0x62",
   "msg": "0x29c8"
  },
  {
   "id": "b_008001:0x29858",
   "off": 170072,
   "max": 28,
   "kind": "dialogue",
   "jp": "そんなことねえ……\\nないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x29c9"
  },
  {
   "id": "b_008001:0x29d88",
   "off": 171400,
   "max": 48,
   "kind": "dialogue",
   "jp": "ま　どうでもいいですけど\\nもっと速度上げます？",
   "en": "",
   "op": "0x62",
   "msg": "0x29ca"
  },
  {
   "id": "b_008001:0x2a2d0",
   "off": 172752,
   "max": 40,
   "kind": "dialogue",
   "jp": "速度を上げるだと？\\nこの上　さらにか？",
   "en": "",
   "op": "0x62",
   "msg": "0x29cb"
  },
  {
   "id": "b_008001:0x2a888",
   "off": 174216,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうですよ？\\nいつも土方さんから\\n言い出すんじゃないですか",
   "en": "",
   "op": "0x62",
   "msg": "0x29cc"
  },
  {
   "id": "b_008001:0x2ae8c",
   "off": 175756,
   "max": 20,
   "kind": "dialogue",
   "jp": "そ　そうだったな",
   "en": "",
   "op": "0x62",
   "msg": "0x29cd"
  },
  {
   "id": "b_008001:0x2b3b4",
   "off": 177076,
   "max": 28,
   "kind": "dialogue",
   "jp": "それとも　もう年ですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x29ce"
  },
  {
   "id": "b_008001:0x2ba7c",
   "off": 178812,
   "max": 48,
   "kind": "dialogue",
   "jp": "バッカ野郎！\\nオレ様はまだ\\nそんな年じゃねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x29cf"
  },
  {
   "id": "b_008001:0x2c04c",
   "off": 180300,
   "max": 16,
   "kind": "dialogue",
   "jp": "オレ様……？",
   "en": "",
   "op": "0x62",
   "msg": "0x29d0"
  },
  {
   "id": "b_008001:0x2c6bc",
   "off": 181948,
   "max": 16,
   "kind": "dialogue",
   "jp": "お　俺だ　俺",
   "en": "",
   "op": "0x62",
   "msg": "0x29d1"
  },
  {
   "id": "b_008001:0x2cbcc",
   "off": 183244,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x29d2"
  },
  {
   "id": "b_008001:0x2d4f8",
   "off": 185592,
   "max": 44,
   "kind": "dialogue",
   "jp": "そうですよね～　土方さん\\n若いですもんねー",
   "en": "",
   "op": "0x62",
   "msg": "0x29d3"
  },
  {
   "id": "b_008001:0x2d534",
   "off": 185652,
   "max": 56,
   "kind": "dialogue",
   "jp": "じゃあこの水桶しょって\\nあと十周頑張って\\nくださいね～",
   "en": "",
   "op": "0x62",
   "msg": "0x29d4"
  },
  {
   "id": "b_008001:0x2dc94",
   "off": 187540,
   "max": 16,
   "kind": "dialogue",
   "jp": "じゅっ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x29d5"
  },
  {
   "id": "b_008001:0x2e120",
   "off": 188704,
   "max": 40,
   "kind": "dialogue",
   "jp": "出来ないんですか？\\nやっぱりジジ……",
   "en": "",
   "op": "0x62",
   "msg": "0x29d6"
  },
  {
   "id": "b_008001:0x2e668",
   "off": 190056,
   "max": 48,
   "kind": "dialogue",
   "jp": "やればいいんだろ\\nやれば！\\nうおおおおおおお！",
   "en": "",
   "op": "0x62",
   "msg": "0x29d7"
  },
  {
   "id": "b_008001:0x2ee40",
   "off": 192064,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふふっ\\nま～たメガネくんの\\n新発明かな？",
   "en": "",
   "op": "0x62",
   "msg": "0x29d8"
  },
  {
   "id": "b_008001:0x2ee7c",
   "off": 192124,
   "max": 20,
   "kind": "dialogue",
   "jp": "後で聞いてみよっと",
   "en": "",
   "op": "0x62",
   "msg": "0x29d9"
  },
  {
   "id": "b_008001:0x2f6f8",
   "off": 194296,
   "max": 24,
   "kind": "dialogue",
   "jp": "ハァハァハァ……くそ！",
   "en": "",
   "op": "0x62",
   "msg": "0x29da"
  },
  {
   "id": "b_008001:0x2fb94",
   "off": 195476,
   "max": 64,
   "kind": "dialogue",
   "jp": "でも　あいつらの団結や\\n歌唱力はこうやって\\n鍛えられてたのか",
   "en": "",
   "op": "0x62",
   "msg": "0x29db"
  },
  {
   "id": "b_008001:0x2fbe4",
   "off": 195556,
   "max": 68,
   "kind": "dialogue",
   "jp": "ちょっとあいつらを\\n甘く見てたのかもな……\\nオレ様も負けられねえな",
   "en": "",
   "op": "0x62",
   "msg": "0x29dc"
  },
  {
   "id": "b_008001:0x30aa4",
   "off": 199332,
   "max": 20,
   "kind": "dialogue",
   "jp": "桂さん　今戻ったぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x29dd"
  },
  {
   "id": "b_008001:0x30f34",
   "off": 200500,
   "max": 48,
   "kind": "dialogue",
   "jp": "俺もだ\\nところで装置は無事に\\n動きそうなのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x29de"
  },
  {
   "id": "b_008001:0x3170c",
   "off": 202508,
   "max": 64,
   "kind": "dialogue",
   "jp": "ああ　うん　ネジが\\n一本抜けていたようです\\nいやー　うっかり♪",
   "en": "",
   "op": "0x62",
   "msg": "0x29df"
  },
  {
   "id": "b_008001:0x31f3c",
   "off": 204604,
   "max": 48,
   "kind": "dialogue",
   "jp": "あんたの頭じゃねえんだ\\nしっかり締めておけよな",
   "en": "",
   "op": "0x62",
   "msg": "0x29e0"
  },
  {
   "id": "b_008001:0x32834",
   "off": 206900,
   "max": 44,
   "kind": "dialogue",
   "jp": "そういうことを言うなら\\n元に戻しませんよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x29e1"
  },
  {
   "id": "b_008001:0x33204",
   "off": 209412,
   "max": 52,
   "kind": "dialogue",
   "jp": "うっ……悪かった\\n謝るから早く元に\\n戻してくれ……",
   "en": "",
   "op": "0x62",
   "msg": "0x29e2"
  },
  {
   "id": "b_008001:0x33738",
   "off": 210744,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああ　俺からも頼む",
   "en": "",
   "op": "0x62",
   "msg": "0x29e3"
  },
  {
   "id": "b_008001:0x33edc",
   "off": 212700,
   "max": 36,
   "kind": "dialogue",
   "jp": "はいはーい\\nそれじゃぽちっとな♪",
   "en": "",
   "op": "0x62",
   "msg": "0x29e4"
  },
  {
   "id": "b_008001:0x34c88",
   "off": 216200,
   "max": 48,
   "kind": "dialogue",
   "jp": "ふう　やっと元に戻ったか\\n面倒な一日だったぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x29e5"
  },
  {
   "id": "b_008001:0x351d0",
   "off": 217552,
   "max": 36,
   "kind": "dialogue",
   "jp": "だが……\\n有意義な一日\\nではあった",
   "en": "",
   "op": "0x62",
   "msg": "0x29e6"
  },
  {
   "id": "b_008001:0x3570c",
   "off": 218892,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうかぁ？\\n……ま　もうちっと体力を\\n鍛える気にはなったな",
   "en": "",
   "op": "0x62",
   "msg": "0x29e7"
  },
  {
   "id": "b_008001:0x35bc4",
   "off": 220100,
   "max": 48,
   "kind": "dialogue",
   "jp": "俺も料理を食べる時には\\nもっと感謝しようと思う",
   "en": "",
   "op": "0x62",
   "msg": "0x29e8"
  },
  {
   "id": "b_008001:0x3637c",
   "off": 222076,
   "max": 64,
   "kind": "dialogue",
   "jp": "あれあれ？\\nなんだか二人ともわかり\\nあったような空気ですね？",
   "en": "",
   "op": "0x62",
   "msg": "0x29e9"
  },
  {
   "id": "b_008001:0x36bac",
   "off": 224172,
   "max": 68,
   "kind": "dialogue",
   "jp": "そんなわけねえだろ！\\nもう二度とこいつと\\n入れ替わるなんざごめんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x29ea"
  },
  {
   "id": "b_008001:0x37528",
   "off": 226600,
   "max": 36,
   "kind": "dialogue",
   "jp": "ふぅん　\\nそういうことだったんだ～",
   "en": "",
   "op": "0x62",
   "msg": "0x29eb"
  },
  {
   "id": "b_008001:0x37bf8",
