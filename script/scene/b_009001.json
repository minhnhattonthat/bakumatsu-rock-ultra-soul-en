{
 "source": "b_009001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_009001:0x10e8",
   "off": 4328,
   "max": 12,
   "kind": "dialogue",
   "jp": "京都　某所",
   "en": "",
   "op": "0x62",
   "msg": "0x2a9e"
  },
  {
   "id": "b_009001:0x1104",
   "off": 4356,
   "max": 92,
   "kind": "dialogue",
   "jp": "数奇な運命により出会った\\nロックな魂を持つ男達は\\n数々の試練を乗り越え\\n強い絆で結ばれた",
   "en": "",
   "op": "0x62",
   "msg": "0x2a9f"
  },
  {
   "id": "b_009001:0x1170",
   "off": 4464,
   "max": 76,
   "kind": "dialogue",
   "jp": "そして今\\n彼らは互いに\\n切磋琢磨し合いながら\\n一つ屋根の下で\\n暮らしている",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa0"
  },
  {
   "id": "b_009001:0x11cc",
   "off": 4556,
   "max": 20,
   "kind": "dialogue",
   "jp": "主に経済的な……",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa1"
  },
  {
   "id": "b_009001:0x11f0",
   "off": 4592,
   "max": 36,
   "kind": "dialogue",
   "jp": "いや　熱き魂の\\n結びつきによって",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa2"
  },
  {
   "id": "b_009001:0x1760",
   "off": 5984,
   "max": 24,
   "kind": "dialogue",
   "jp": "ふぅ～\\nいい陽気ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa3"
  },
  {
   "id": "b_009001:0x1830",
   "off": 6192,
   "max": 68,
   "kind": "dialogue",
   "jp": "今日はテラーダの\\n仕事（バイト）も\\n終わったし\\nゆっくりするか～",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa4"
  },
  {
   "id": "b_009001:0x2190",
   "off": 8592,
   "max": 12,
   "kind": "dialogue",
   "jp": "おい　龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa5"
  },
  {
   "id": "b_009001:0x29b8",
   "off": 10680,
   "max": 28,
   "kind": "dialogue",
   "jp": "ん～　どうした？\\nシンディ",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa6"
  },
  {
   "id": "b_009001:0x33d4",
   "off": 13268,
   "max": 4,
   "kind": "dialogue",
   "jp": "",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa7"
  },
  {
   "id": "b_009001:0x3dc8",
   "off": 15816,
   "max": 24,
   "kind": "dialogue",
   "jp": "お　ま　え　ぇ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa8"
  },
  {
   "id": "b_009001:0x472c",
   "off": 18220,
   "max": 8,
   "kind": "dialogue",
   "jp": "ほえ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2aa9"
  },
  {
   "id": "b_009001:0x5014",
   "off": 20500,
   "max": 16,
   "kind": "dialogue",
   "jp": "ちょっと来い！",
   "en": "",
   "op": "0x62",
   "msg": "0x2aaa"
  },
  {
   "id": "b_009001:0x57dc",
   "off": 22492,
   "max": 20,
   "kind": "dialogue",
   "jp": "な　なんだぁ～～？",
   "en": "",
   "op": "0x62",
   "msg": "0x2aab"
  },
  {
   "id": "b_009001:0x62b8",
   "off": 25272,
   "max": 56,
   "kind": "dialogue",
   "jp": "なんでシンディの\\n部屋に連れてこられた\\nんじゃ……？",
   "en": "",
   "op": "0x62",
   "msg": "0x2aac"
  },
  {
   "id": "b_009001:0x6300",
   "off": 25344,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしゃ昼寝をするところ\\nだったぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2aad"
  },
  {
   "id": "b_009001:0x67a4",
   "off": 26532,
   "max": 28,
   "kind": "dialogue",
   "jp": "いいか　龍馬\\n隠さずに言え",
   "en": "",
   "op": "0x62",
   "msg": "0x2aae"
  },
  {
   "id": "b_009001:0x6c3c",
   "off": 27708,
   "max": 24,
   "kind": "dialogue",
   "jp": "だから　何ごとぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2aaf"
  },
  {
   "id": "b_009001:0x70d0",
   "off": 28880,
   "max": 52,
   "kind": "dialogue",
   "jp": "オレ様の机の上に\\nあったものを\\n触らなかったか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab0"
  },
  {
   "id": "b_009001:0x772c",
   "off": 30508,
   "max": 56,
   "kind": "dialogue",
   "jp": "シンディの机の上の\\nもの？　わしゃ\\nそんなん知らんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab1"
  },
  {
   "id": "b_009001:0x7c90",
   "off": 31888,
   "max": 12,
   "kind": "dialogue",
   "jp": "ほう……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab2"
  },
  {
   "id": "b_009001:0x869c",
   "off": 34460,
   "max": 56,
   "kind": "dialogue",
   "jp": "じゃあ　お前の口の端に\\nついてるその白い粉は\\nなんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab3"
  },
  {
   "id": "b_009001:0x90e8",
   "off": 37096,
   "max": 8,
   "kind": "dialogue",
   "jp": "ほえ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab4"
  },
  {
   "id": "b_009001:0x9ac4",
   "off": 39620,
   "max": 56,
   "kind": "dialogue",
   "jp": "お前　オレ様が\\n楽しみにしていた\\n大福を食っただろう！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab5"
  },
  {
   "id": "b_009001:0xa4f8",
   "off": 42232,
   "max": 36,
   "kind": "dialogue",
   "jp": "ええーっ\\n身に覚えがないぜよ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab6"
  },
  {
   "id": "b_009001:0xae40",
   "off": 44608,
   "max": 48,
   "kind": "dialogue",
   "jp": "じゃあ　なんで\\nオレ様の大福が\\n消えたんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab7"
  },
  {
   "id": "b_009001:0xb5f0",
   "off": 46576,
   "max": 40,
   "kind": "dialogue",
   "jp": "……もしや　大福が\\n散歩に行ったとか",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab8"
  },
  {
   "id": "b_009001:0xbc28",
   "off": 48168,
   "max": 20,
   "kind": "dialogue",
   "jp": "んなわけあるか！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ab9"
  },
  {
   "id": "b_009001:0xc1d8",
   "off": 49624,
   "max": 60,
   "kind": "dialogue",
   "jp": "オレ様もお前の顔を\\n見るまでは　疑っても\\nいなかったが……",
   "en": "",
   "op": "0x62",
   "msg": "0x2aba"
  },
  {
   "id": "b_009001:0xcd78",
   "off": 52600,
   "max": 60,
   "kind": "dialogue",
   "jp": "だが　お前の口の端に\\nついてる大福の粉が\\n動かぬ証拠だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2abb"
  },
  {
   "id": "b_009001:0xce6c",
   "off": 52844,
   "max": 20,
   "kind": "dialogue",
   "jp": "さぁ　素直に吐け！",
   "en": "",
   "op": "0x62",
   "msg": "0x2abc"
  },
  {
   "id": "b_009001:0xd754",
   "off": 55124,
   "max": 32,
   "kind": "dialogue",
   "jp": "よくわからんが\\n誤解ぜよ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x2abd"
  },
  {
   "id": "b_009001:0xe2f4",
   "off": 58100,
   "max": 36,
   "kind": "dialogue",
   "jp": "ちょっと二人とも\\nうるさいですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2abe"
  },
  {
   "id": "b_009001:0xebf4",
   "off": 60404,
   "max": 28,
   "kind": "dialogue",
   "jp": "センセー\\nいいところに！",
   "en": "",
   "op": "0x62",
   "msg": "0x2abf"
  },
  {
   "id": "b_009001:0xf23c",
   "off": 62012,
   "max": 8,
   "kind": "dialogue",
   "jp": "え？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac0"
  },
  {
   "id": "b_009001:0xfb70",
   "off": 64368,
   "max": 24,
   "kind": "dialogue",
   "jp": "ほうほう\\nなるほどね",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac1"
  },
  {
   "id": "b_009001:0x10034",
   "off": 65588,
   "max": 56,
   "kind": "dialogue",
   "jp": "高杉と龍馬が\\n事の次第を説明すると\\n桂は重苦しく頷いた",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac2"
  },
  {
   "id": "b_009001:0x1079c",
   "off": 67484,
   "max": 76,
   "kind": "dialogue",
   "jp": "よし　それではこの\\n名探偵☆カツラ君！\\nが　事件の謎を解いて\\nあげましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac3"
  },
  {
   "id": "b_009001:0x11744",
   "off": 71492,
   "max": 20,
   "kind": "dialogue",
   "jp": "名探偵☆カツラ君",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac4"
  },
  {
   "id": "b_009001:0x11fdc",
   "off": 73692,
   "max": 76,
   "kind": "dialogue",
   "jp": "私のこの優秀なる灰色の\\n頭脳を駆使すれば　難解な\\n事件もすぐに解決ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac5"
  },
  {
   "id": "b_009001:0x12920",
   "off": 76064,
   "max": 44,
   "kind": "dialogue",
   "jp": "……シンディ\\nセンセーは\\nどうしたんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac6"
  },
  {
   "id": "b_009001:0x1295c",
   "off": 76124,
   "max": 24,
   "kind": "dialogue",
   "jp": "名探偵って\\nなんぜよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac7"
  },
  {
   "id": "b_009001:0x12fc8",
   "off": 77768,
   "max": 72,
   "kind": "dialogue",
   "jp": "……おおかた　新しい\\nエゲレスの本でそういうの\\nを読んだんだろうよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac8"
  },
  {
   "id": "b_009001:0x13c04",
   "off": 80900,
   "max": 92,
   "kind": "dialogue",
   "jp": "ちょうどここにあるのが\\n先日発明したばかりの\\n『微理鼻裏ましん』です！\\n（びりびりましん）",
   "en": "",
   "op": "0x62",
   "msg": "0x2ac9"
  },
  {
   "id": "b_009001:0x14c38",
   "off": 85048,
   "max": 20,
   "kind": "dialogue",
   "jp": "微理鼻裏ましん",
   "en": "",
   "op": "0x62",
   "msg": "0x2aca"
  },
  {
   "id": "b_009001:0x154d0",
   "off": 87248,
   "max": 56,
   "kind": "dialogue",
   "jp": "中にはデンキウナ……\\nいや　中身の説明は\\nよしましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2acb"
  },
  {
   "id": "b_009001:0x15cf4",
   "off": 89332,
   "max": 20,
   "kind": "dialogue",
   "jp": "すっごい気になる！",
   "en": "",
   "op": "0x62",
   "msg": "0x2acc"
  },
  {
   "id": "b_009001:0x1649c",
   "off": 91292,
   "max": 44,
   "kind": "dialogue",
   "jp": "これはね　嘘をつけなく\\nなる機械なんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2acd"
  },
  {
   "id": "b_009001:0x164d8",
   "off": 91352,
   "max": 64,
   "kind": "dialogue",
   "jp": "さぁ　龍馬くん\\n安心してここにある穴に\\n腕を突っ込んで下さい♪",
   "en": "",
   "op": "0x62",
   "msg": "0x2ace"
  },
  {
   "id": "b_009001:0x17a68",
   "off": 96872,
   "max": 44,
   "kind": "dialogue",
   "jp": "いや……　なんか\\n怪しい音がしてるし……",
   "en": "",
   "op": "0x62",
   "msg": "0x2acf"
  },
  {
   "id": "b_009001:0x17f10",
   "off": 98064,
   "max": 48,
   "kind": "dialogue",
   "jp": "大丈夫ですよ　ちょっと\\nびりっとするだけだから",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad0"
  },
  {
   "id": "b_009001:0x1941c",
   "off": 103452,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや！　いまのは\\nちょっとじゃない\\nぜよーっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad1"
  },
  {
   "id": "b_009001:0x19be4",
   "off": 105444,
   "max": 60,
   "kind": "dialogue",
   "jp": "……桂さん\\nオレ様は　何も龍馬を\\n痛めつけろとは言ってない",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad2"
  },
  {
   "id": "b_009001:0x1a2bc",
   "off": 107196,
   "max": 24,
   "kind": "dialogue",
   "jp": "痛くない　痛くない♪",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad3"
  },
  {
   "id": "b_009001:0x1a2e4",
   "off": 107236,
   "max": 12,
   "kind": "dialogue",
   "jp": "……多分",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad4"
  },
  {
   "id": "b_009001:0x1b128",
   "off": 110888,
   "max": 24,
   "kind": "dialogue",
   "jp": "今　多分って言った！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad5"
  },
  {
   "id": "b_009001:0x1bd00",
   "off": 113920,
   "max": 56,
   "kind": "dialogue",
   "jp": "さあさあ\\n君はロックな男です\\n頑張れます　龍馬くん♪",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad6"
  },
  {
   "id": "b_009001:0x1c384",
   "off": 115588,
   "max": 28,
   "kind": "dialogue",
   "jp": "い……\\nいやじゃああ～～！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad7"
  },
  {
   "id": "b_009001:0x1ceac",
   "off": 118444,
   "max": 60,
   "kind": "dialogue",
   "jp": "『微理鼻裏ましん』が\\n試せなくて　本当に\\n残念ですよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad8"
  },
  {
   "id": "b_009001:0x1d584",
   "off": 120196,
   "max": 40,
   "kind": "dialogue",
   "jp": "ぜぇはぁ　なんとか\\n回避できたぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ad9"
  },
  {
   "id": "b_009001:0x1dc14",
   "off": 121876,
   "max": 76,
   "kind": "dialogue",
   "jp": "しかたがないから　知的に\\n推理をして　龍馬くんの\\n潔白を証明してみましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2ada"
  },
  {
   "id": "b_009001:0x1e174",
   "off": 123252,
   "max": 32,
   "kind": "dialogue",
   "jp": "そ　それが\\n平和的でいい……",
   "en": "",
   "op": "0x62",
   "msg": "0x2adb"
  },
  {
   "id": "b_009001:0x1e780",
   "off": 124800,
   "max": 72,
   "kind": "dialogue",
   "jp": "では　まず晋作が\\n龍馬くんを大福盗み食い犯\\nだと考えた物証ですが……",
   "en": "",
   "op": "0x62",
   "msg": "0x2adc"
  },
  {
   "id": "b_009001:0x1eec0",
   "off": 126656,
   "max": 68,
   "kind": "dialogue",
   "jp": "こいつの口の端に付いた\\n白い粉が証拠だ\\nこいつが犯人に違いない！",
   "en": "",
   "op": "0x62",
   "msg": "0x2add"
  },
  {
   "id": "b_009001:0x1f5a8",
   "off": 128424,
   "max": 16,
   "kind": "dialogue",
   "jp": "ふむふむ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2ade"
  },
  {
   "id": "b_009001:0x1f664",
   "off": 128612,
   "max": 64,
   "kind": "dialogue",
   "jp": "ではここで　私は\\n龍馬くんのお昼ごはんに\\nついて訊ねてみます",
   "en": "",
   "op": "0x62",
   "msg": "0x2adf"
  },
  {
   "id": "b_009001:0x1fcec",
   "off": 130284,
   "max": 60,
   "kind": "dialogue",
   "jp": "いつもどおりテラーダで\\n仕事をしたから\\nそこで食べたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae0"
  },
  {
   "id": "b_009001:0x201a4",
   "off": 131492,
   "max": 8,
   "kind": "dialogue",
   "jp": "何を？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae1"
  },
  {
   "id": "b_009001:0x20628",
   "off": 132648,
   "max": 16,
   "kind": "dialogue",
   "jp": "ぴっつぁぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae2"
  },
  {
   "id": "b_009001:0x20ab4",
   "off": 133812,
   "max": 20,
   "kind": "dialogue",
   "jp": "食べただけですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae3"
  },
  {
   "id": "b_009001:0x20fdc",
   "off": 135132,
   "max": 64,
   "kind": "dialogue",
   "jp": "今日はお登勢やんの\\n手伝いをして　わしも\\nぴっつぁを作ったなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae4"
  },
  {
   "id": "b_009001:0x216b4",
   "off": 136884,
   "max": 12,
   "kind": "dialogue",
   "jp": "ふむふむ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae5"
  },
  {
   "id": "b_009001:0x2176c",
   "off": 137068,
   "max": 60,
   "kind": "dialogue",
   "jp": "さて　晋作\\nピッツァの生地は何で\\n作られているでしょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae6"
  },
  {
   "id": "b_009001:0x21f60",
   "off": 139104,
   "max": 20,
   "kind": "dialogue",
   "jp": "知るわけないだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae7"
  },
  {
   "id": "b_009001:0x226c0",
   "off": 140992,
   "max": 16,
   "kind": "dialogue",
   "jp": "では　龍馬くん",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae8"
  },
  {
   "id": "b_009001:0x22d70",
   "off": 142704,
   "max": 12,
   "kind": "dialogue",
   "jp": "小麦粉ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2ae9"
  },
  {
   "id": "b_009001:0x23420",
   "off": 144416,
   "max": 28,
   "kind": "dialogue",
   "jp": "そして小麦粉は\\n白い粉です",
   "en": "",
   "op": "0x62",
   "msg": "0x2aea"
  },
  {
   "id": "b_009001:0x23a6c",
   "off": 146028,
   "max": 20,
   "kind": "dialogue",
   "jp": "私が推測するに……",
   "en": "",
   "op": "0x62",
   "msg": "0x2aeb"
  },
  {
   "id": "b_009001:0x24578",
   "off": 148856,
   "max": 68,
   "kind": "dialogue",
   "jp": "龍馬くんの口の端に\\n付着したのはピッツァを\\n作った時の小麦粉です",
   "en": "",
   "op": "0x62",
   "msg": "0x2aec"
  },
  {
   "id": "b_009001:0x250e4",
   "off": 151780,
   "max": 16,
   "kind": "dialogue",
   "jp": "な　なにぃっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2aed"
  },
  {
   "id": "b_009001:0x258bc",
   "off": 153788,
   "max": 40,
   "kind": "dialogue",
   "jp": "大福の周りについている\\nのは片栗粉です",
   "en": "",
   "op": "0x62",
   "msg": "0x2aee"
  },
  {
   "id": "b_009001:0x258f4",
   "off": 153844,
   "max": 40,
   "kind": "dialogue",
   "jp": "似ているけれど\\n小麦粉ではありません",
   "en": "",
   "op": "0x62",
   "msg": "0x2aef"
  },
  {
   "id": "b_009001:0x260f8",
   "off": 155896,
   "max": 12,
   "kind": "dialogue",
   "jp": "じゃあ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2af0"
  },
  {
   "id": "b_009001:0x26824",
   "off": 157732,
   "max": 60,
   "kind": "dialogue",
   "jp": "晋作の大福を盗ったのは\\n龍馬くんではない\\nということですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2af1"
  },
  {
   "id": "b_009001:0x27098",
   "off": 159896,
   "max": 12,
   "kind": "dialogue",
   "jp": "う……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2af2"
  },
  {
   "id": "b_009001:0x27814",
   "off": 161812,
   "max": 12,
   "kind": "dialogue",
   "jp": "おおー！",
   "en": "",
   "op": "0x62",
   "msg": "0x2af3"
  },
  {
   "id": "b_009001:0x27ecc",
   "off": 163532,
   "max": 56,
   "kind": "dialogue",
   "jp": "さて　龍馬くんを疑った\\n晋作は\\n何をすべきでしょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2af4"
  },
  {
   "id": "b_009001:0x28890",
   "off": 166032,
   "max": 12,
   "kind": "dialogue",
   "jp": "く……っ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2af5"
  },
  {
   "id": "b_009001:0x28930",
   "off": 166192,
   "max": 24,
   "kind": "dialogue",
   "jp": "疑って\\nわ……悪かった",
   "en": "",
   "op": "0x62",
   "msg": "0x2af6"
  },
  {
   "id": "b_009001:0x28e5c",
   "off": 167516,
   "max": 56,
   "kind": "dialogue",
   "jp": "かかか！　\\nかまわんぜよ～\\n勘違いは誰にでもあるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2af7"
  },
  {
   "id": "b_009001:0x29310",
   "off": 168720,
   "max": 52,
   "kind": "dialogue",
   "jp": "だけど　龍馬じゃないなら\\n一体誰がオレ様の大福を？",
   "en": "",
   "op": "0x62",
   "msg": "0x2af8"
  },
  {
   "id": "b_009001:0x29e04",
   "off": 171524,
   "max": 40,
   "kind": "dialogue",
   "jp": "うるさいなぁ\\nさっきから何騒いでるの？",
   "en": "",
   "op": "0x62",
   "msg": "0x2af9"
  },
  {
   "id": "b_009001:0x2a340",
   "off": 172864,
   "max": 80,
   "kind": "dialogue",
   "jp": "眉根を寄せて不機嫌そうに\\n登場したのは\\nこの家の住人の一人\\n沖田総司であった",
   "en": "",
   "op": "0x62",
   "msg": "0x2afa"
  },
  {
   "id": "b_009001:0x2a3a0",
   "off": 172960,
   "max": 24,
   "kind": "dialogue",
   "jp": "そして　その手には――",
   "en": "",
   "op": "0x62",
   "msg": "0x2afb"
  },
  {
   "id": "b_009001:0x2a9cc",
   "off": 174540,
   "max": 8,
   "kind": "dialogue",
   "jp": "大福",
   "en": "",
   "op": "0x62",
   "msg": "0x2afc"
  },
  {
   "id": "b_009001:0x2b2a8",
   "off": 176808,
   "max": 24,
   "kind": "dialogue",
   "jp": "はぁ？　何？\\n何なの？",
   "en": "",
   "op": "0x62",
   "msg": "0x2afd"
  },
  {
   "id": "b_009001:0x2ba98",
   "off": 178840,
   "max": 44,
   "kind": "dialogue",
   "jp": "お前かーっ！\\nオレ様の大福を盗った\\n奴は！",
   "en": "",
   "op": "0x62",
   "msg": "0x2afe"
  },
  {
   "id": "b_009001:0x2c05c",
   "off": 180316,
   "max": 32,
   "kind": "dialogue",
   "jp": "何言ってるの？\\nこの大福は……",
   "en": "",
   "op": "0x62",
   "msg": "0x2aff"
  },
  {
   "id": "b_009001:0x2c68c",
   "off": 181900,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレ様の机の上に\\n置いてあった\\nやつだろうが！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b00"
  },
  {
   "id": "b_009001:0x2d004",
   "off": 184324,
   "max": 8,
   "kind": "dialogue",
   "jp": "え……",
   "en": "",
   "op": "0x62",
   "msg": "0x2b01"
  },
  {
   "id": "b_009001:0x2d7d0",
   "off": 186320,
   "max": 20,
   "kind": "dialogue",
   "jp": "……ああ　そうか",
   "en": "",
   "op": "0x62",
   "msg": "0x2b02"
  },
  {
   "id": "b_009001:0x2e0e0",
   "off": 188640,
   "max": 44,
   "kind": "dialogue",
   "jp": "はいはい\\n僕が食べたよ\\nごめんなさいねー",
   "en": "",
   "op": "0x62",
   "msg": "0x2b03"
  },
  {
   "id": "b_009001:0x2e6c0",
   "off": 190144,
   "max": 16,
   "kind": "dialogue",
   "jp": "てめ……っ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b04"
  },
  {
   "id": "b_009001:0x2ec68",
   "off": 191592,
   "max": 32,
   "kind": "dialogue",
   "jp": "食べたものは仕方ない\\nじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x2b05"
  },
  {
   "id": "b_009001:0x2ec98",
   "off": 191640,
   "max": 32,
   "kind": "dialogue",
   "jp": "買い直してきたら\\nいいでしょ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b06"
  },
  {
   "id": "b_009001:0x2f2c8",
   "off": 193224,
   "max": 24,
   "kind": "dialogue",
   "jp": "そういう問題じゃねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b07"
  },
  {
   "id": "b_009001:0x2f878",
   "off": 194680,
   "max": 40,
   "kind": "dialogue",
   "jp": "いちいち　うるさいなー\\n謝ったじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x2b08"
  },
  {
   "id": "b_009001:0x2f8b8",
   "off": 194744,
   "max": 36,
   "kind": "dialogue",
   "jp": "それ以上\\n何をして欲しいわけ～？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b09"
  },
  {
   "id": "b_009001:0x2feec",
   "off": 196332,
   "max": 20,
   "kind": "dialogue",
   "jp": "て　てめえ～～っ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b0a"
  },
  {
   "id": "b_009001:0x30704",
   "off": 198404,
   "max": 8,
   "kind": "dialogue",
   "jp": "……",
   "en": "",
   "op": "0x62",
   "msg": "0x2b0b"
  },
  {
   "id": "b_009001:0x310e4",
   "off": 200932,
   "max": 32,
   "kind": "dialogue",
   "jp": "なにやら騒がしいな\\nどうした？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b0c"
  },
  {
   "id": "b_009001:0x31618",
   "off": 202264,
   "max": 44,
   "kind": "dialogue",
   "jp": "今度は土方が現れた\\nそして　その手にも――",
   "en": "",
   "op": "0x62",
   "msg": "0x2b0d"
  },
  {
   "id": "b_009001:0x31c58",
   "off": 203864,
   "max": 12,
   "kind": "dialogue",
   "jp": "大福っ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b0e"
  },
  {
   "id": "b_009001:0x32388",
   "off": 205704,
   "max": 8,
   "kind": "dialogue",
   "jp": "ああ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b0f"
  },
  {
   "id": "b_009001:0x323a0",
   "off": 205728,
   "max": 48,
   "kind": "dialogue",
   "jp": "誰かが俺の机の上に\\n差し入れを\\nしてくれてな",
   "en": "",
   "op": "0x62",
   "msg": "0x2b10"
  },
  {
   "id": "b_009001:0x323e0",
   "off": 205792,
   "max": 24,
   "kind": "dialogue",
   "jp": "ありがたくいただいた",
   "en": "",
   "op": "0x62",
   "msg": "0x2b11"
  },
  {
   "id": "b_009001:0x32a4c",
   "off": 207436,
   "max": 44,
   "kind": "dialogue",
   "jp": "はぁっ？\\n差し入れって\\nどういうことだっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b12"
  },
  {
   "id": "b_009001:0x330a4",
   "off": 209060,
   "max": 20,
   "kind": "dialogue",
   "jp": "どういうこととは？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b13"
  },
  {
   "id": "b_009001:0x33680",
   "off": 210560,
   "max": 44,
   "kind": "dialogue",
   "jp": "オレ様の大福が\\nどこかに\\n消えてるんだよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b14"
  },
  {
   "id": "b_009001:0x340b4",
   "off": 213172,
   "max": 8,
   "kind": "dialogue",
   "jp": "……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b15"
  },
  {
   "id": "b_009001:0x34674",
   "off": 214644,
   "max": 68,
   "kind": "dialogue",
   "jp": "土方は\\n大福を持つ己の手を\\nじっと見つめてから\\n高杉の部屋を見回す",
   "en": "",
   "op": "0x62",
   "msg": "0x2b16"
  },
  {
   "id": "b_009001:0x346c8",
   "off": 214728,
   "max": 44,
   "kind": "dialogue",
   "jp": "それから土方は\\n申し訳ないという\\n顔をする",
   "en": "",
   "op": "0x62",
   "msg": "0x2b17"
  },
  {
   "id": "b_009001:0x34b38",
   "off": 215864,
   "max": 52,
   "kind": "dialogue",
   "jp": "どうやら俺は部屋を\\n間違えてしまって\\nいたようだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b18"
  },
  {
   "id": "b_009001:0x34b7c",
   "off": 215932,
   "max": 60,
   "kind": "dialogue",
   "jp": "この大福は　差し入れ\\nではなく高杉のもので\\nあったのだな",
   "en": "",
   "op": "0x62",
   "msg": "0x2b19"
  },
  {
   "id": "b_009001:0x34bc8",
   "off": 216008,
   "max": 64,
   "kind": "dialogue",
   "jp": "俺としたことが\\n人様の甘味を　勝手に\\n食べてしまったとは……",
   "en": "",
   "op": "0x62",
   "msg": "0x2b1a"
  },
  {
   "id": "b_009001:0x35098",
   "off": 217240,
   "max": 60,
   "kind": "dialogue",
   "jp": "実直な男　土方は\\n今にも腹を切りそうな\\n雰囲気を醸し出す",
   "en": "",
   "op": "0x62",
   "msg": "0x2b1b"
  },
  {
   "id": "b_009001:0x35520",
   "off": 218400,
   "max": 72,
   "kind": "dialogue",
   "jp": "大福の盗み食いをしたなど\\n今は亡き近藤さんにも\\n顔向けが出来ん……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b1c"
  },
  {
   "id": "b_009001:0x35578",
   "off": 218488,
   "max": 36,
   "kind": "dialogue",
   "jp": "この非礼をどうやって\\n償えば……っ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b1d"
  },
  {
   "id": "b_009001:0x35bf0",
   "off": 220144,
   "max": 72,
   "kind": "dialogue",
   "jp": "土方の手が\\n無意識に腰の刀へ\\n伸びているのを見て\\n高杉は血相を変える",
   "en": "",
   "op": "0x62",
   "msg": "0x2b1e"
  },
  {
   "id": "b_009001:0x3628c",
   "off": 221836,
   "max": 44,
   "kind": "dialogue",
   "jp": "いい！\\n大福くらいで\\nどうもこうもない！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b1f"
  },
  {
   "id": "b_009001:0x3690c",
   "off": 223500,
   "max": 12,
   "kind": "dialogue",
   "jp": "だが……",
   "en": "",
   "op": "0x62",
   "msg": "0x2b20"
  },
  {
   "id": "b_009001:0x36f28",
   "off": 225064,
   "max": 36,
   "kind": "dialogue",
   "jp": "今度　買い直せ！\\nそれで十分だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b21"
  },
  {
   "id": "b_009001:0x37600",
   "off": 226816,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうか　すまないな",
   "en": "",
   "op": "0x62",
   "msg": "0x2b22"
  },
  {
   "id": "b_009001:0x37c6c",
   "off": 228460,
   "max": 16,
   "kind": "dialogue",
   "jp": "お　おぉ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2b23"
  },
  {
   "id": "b_009001:0x382ec",
   "off": 230124,
   "max": 56,
   "kind": "dialogue",
   "jp": "こいつ　いま切腹\\nしようとかして\\nなかったかぁーっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b24"
  },
  {
   "id": "b_009001:0x38c3c",
   "off": 232508,
   "max": 36,
   "kind": "dialogue",
   "jp": "さすがシンディじゃ\\n心が広いのぅ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b25"
  },
  {
   "id": "b_009001:0x39560",
   "off": 234848,
   "max": 44,
   "kind": "dialogue",
   "jp": "大福で死なれたら\\n寝覚めが悪すぎだからな！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b26"
  },
  {
   "id": "b_009001:0x39cf4",
   "off": 236788,
   "max": 8,
   "kind": "dialogue",
   "jp": "……",
   "en": "",
   "op": "0x62",
   "msg": "0x2b27"
  },
  {
   "id": "b_009001:0x3a2b0",
   "off": 238256,
   "max": 12,
   "kind": "dialogue",
   "jp": "なんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b28"
  },
  {
   "id": "b_009001:0x3ad3c",
   "off": 240956,
   "max": 72,
   "kind": "dialogue",
   "jp": "土方さんを謝らせた\\nからって　上になった気で\\nいたら……絞めるからね",
   "en": "",
   "op": "0x62",
   "msg": "0x2b29"
  },
  {
   "id": "b_009001:0x3b68c",
   "off": 243340,
   "max": 20,
   "kind": "dialogue",
   "jp": "なるか！\\n大福で！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b2a"
  },
  {
   "id": "b_009001:0x3bbb4",
   "off": 244660,
   "max": 28,
   "kind": "dialogue",
   "jp": "あっそ\\nだったら　いいよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b2b"
  },
  {
   "id": "b_009001:0x3c0f0",
   "off": 246000,
   "max": 48,
   "kind": "dialogue",
   "jp": "ていうか沖田！\\nお前も紛らわしいこと\\n言うな！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b2c"
  },
  {
   "id": "b_009001:0x3c138",
   "off": 246072,
   "max": 56,
   "kind": "dialogue",
   "jp": "あれじゃ　お前が\\n大福盗み食い犯みたい\\nだっただろうが",
   "en": "",
   "op": "0x62",
   "msg": "0x2b2d"
  },
  {
   "id": "b_009001:0x3c684",
   "off": 247428,
   "max": 48,
   "kind": "dialogue",
   "jp": "うるさいな\\n余計なこと言わないでよ\\nスカシくん",
   "en": "",
   "op": "0x62",
   "msg": "0x2b2e"
  },
  {
   "id": "b_009001:0x3ce44",
   "off": 249412,
   "max": 32,
   "kind": "dialogue",
   "jp": "ん？\\n総司がどうかしたのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b2f"
  },
  {
   "id": "b_009001:0x3d504",
   "off": 251140,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんでもないですよ\\n土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x2b30"
  },
  {
   "id": "b_009001:0x3d9bc",
   "off": 252348,
   "max": 68,
   "kind": "dialogue",
   "jp": "笑顔の総司を見て　土方は\\n彼も大福を手に持っている\\nことに気がつく",
   "en": "",
   "op": "0x62",
   "msg": "0x2b31"
  },
  {
   "id": "b_009001:0x3de44",
   "off": 253508,
   "max": 40,
   "kind": "dialogue",
   "jp": "……ああ　総司に大福を\\nわけたのは俺だ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b32"
  },
  {
   "id": "b_009001:0x3dfbc",
   "off": 253884,
   "max": 60,
   "kind": "dialogue",
   "jp": "総司が俺の代わりに\\n誤解を受けていたのか\\nすまなかったな",
   "en": "",
   "op": "0x62",
   "msg": "0x2b33"
  },
  {
   "id": "b_009001:0x3e70c",
   "off": 255756,
   "max": 24,
   "kind": "dialogue",
   "jp": "全然問題なかったですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b34"
  },
  {
   "id": "b_009001:0x3e734",
   "off": 255796,
   "max": 20,
   "kind": "dialogue",
   "jp": "ね　そうでしょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b35"
  },
  {
   "id": "b_009001:0x3f040",
   "off": 258112,
   "max": 64,
   "kind": "dialogue",
   "jp": "いいや～　ソウちんは\\n自分が盗ったみたいな\\nことを言ったぜよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b36"
  },
  {
   "id": "b_009001:0x3f5ac",
   "off": 259500,
   "max": 16,
   "kind": "dialogue",
   "jp": "ああ　そうだな",
   "en": "",
   "op": "0x62",
   "msg": "0x2b37"
  },
  {
   "id": "b_009001:0x3fe80",
   "off": 261760,
   "max": 60,
   "kind": "dialogue",
   "jp": "ちっ……　余計なことを\\nこの二人の口を\\n縫いつけてやろうか",
   "en": "",
   "op": "0x62",
   "msg": "0x2b38"
  },
  {
   "id": "b_009001:0x405dc",
   "off": 263644,
   "max": 28,
   "kind": "dialogue",
   "jp": "総司？\\nどういうことだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b39"
  },
  {
   "id": "b_009001:0x40f90",
   "off": 266128,
   "max": 56,
   "kind": "dialogue",
   "jp": "それは　この\\n名探偵☆カツラ君！\\nが推理しましょう！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b3a"
  },
  {
   "id": "b_009001:0x41940",
   "off": 268608,
   "max": 52,
   "kind": "dialogue",
   "jp": "おお　センセーは\\nまだ名探偵☆カツラ君！\\nなのか～",
   "en": "",
   "op": "0x62",
   "msg": "0x2b3b"
  },
  {
   "id": "b_009001:0x42290",
   "off": 270992,
   "max": 48,
   "kind": "dialogue",
   "jp": "余計なことしないで\\nくれないかなぁ\\nメガネくん",
   "en": "",
   "op": "0x62",
   "msg": "0x2b3c"
  },
  {
   "id": "b_009001:0x4285c",
   "off": 272476,
   "max": 56,
   "kind": "dialogue",
   "jp": "沖田クンは晋作との\\n会話で　大福の出所を\\n察したんです",
   "en": "",
   "op": "0x62",
   "msg": "0x2b3d"
  },
  {
   "id": "b_009001:0x42e50",
   "off": 274000,
   "max": 32,
   "kind": "dialogue",
   "jp": "ちょっと人の話\\n聞いてるわけ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2b3e"
  },
  {
   "id": "b_009001:0x43370",
   "off": 275312,
   "max": 68,
   "kind": "dialogue",
   "jp": "もちろん土方クンの\\n性格からして　盗った\\nわけがないとも思いました",
   "en": "",
   "op": "0x62",
   "msg": "0x2b3f"
  },
  {
   "id": "b_009001:0x43bd4",
   "off": 277460,
   "max": 24,
   "kind": "dialogue",
   "jp": "まじでうざい　こいつ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b40"
  },
  {
   "id": "b_009001:0x4430c",
   "off": 279308,
   "max": 64,
   "kind": "dialogue",
   "jp": "事実　土方クンは\\n勘違いをして晋作の\\n大福を食べてしまいました",
   "en": "",
   "op": "0x62",
   "msg": "0x2b41"
  },
  {
   "id": "b_009001:0x44b34",
   "off": 281396,
   "max": 24,
   "kind": "dialogue",
   "jp": "本当にすまなかったな",
   "en": "",
   "op": "0x62",
   "msg": "0x2b42"
  },
  {
   "id": "b_009001:0x44fc8",
   "off": 282568,
   "max": 44,
   "kind": "dialogue",
   "jp": "別にもう　かまわねえよ\\nそもそも勘違いだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b43"
  },
  {
   "id": "b_009001:0x45b24",
   "off": 285476,
   "max": 16,
   "kind": "dialogue",
   "jp": "そうなんです",
   "en": "",
   "op": "0x62",
   "msg": "0x2b44"
  },
  {
   "id": "b_009001:0x46584",
   "off": 288132,
   "max": 40,
   "kind": "dialogue",
   "jp": "声でかいよ　桂さん！\\nびっくりした！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b45"
  },
  {
   "id": "b_009001:0x46d68",
   "off": 290152,
   "max": 72,
   "kind": "dialogue",
   "jp": "沖田クンは　土方クンが\\n勘違いで盗み食いを\\nしてしまったと悟った……",
   "en": "",
   "op": "0x62",
   "msg": "0x2b46"
  },
  {
   "id": "b_009001:0x47854",
   "off": 292948,
   "max": 72,
   "kind": "dialogue",
   "jp": "だから彼を庇うために\\nわざと濡れ衣を着たのが\\nさっきの会話の真相です！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b47"
  },
  {
   "id": "b_009001:0x4836c",
   "off": 295788,
   "max": 56,
   "kind": "dialogue",
   "jp": "そういうことかー！\\n感動的な話ぜよー！\\n……ずずっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b48"
  },
  {
   "id": "b_009001:0x48b68",
   "off": 297832,
   "max": 52,
   "kind": "dialogue",
   "jp": "食べたのは事実だから\\nあながち\\n間違ってないでしょ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b49"
  },
  {
   "id": "b_009001:0x492fc",
   "off": 299772,
   "max": 40,
   "kind": "dialogue",
   "jp": "ていうか　メガネうざい\\n斬っていいかな",
   "en": "",
   "op": "0x62",
   "msg": "0x2b4a"
  },
  {
   "id": "b_009001:0x49c24",
   "off": 302116,
   "max": 12,
   "kind": "dialogue",
   "jp": "総司……",
   "en": "",
   "op": "0x62",
   "msg": "0x2b4b"
  },
  {
   "id": "b_009001:0x4a0ac",
   "off": 303276,
   "max": 72,
   "kind": "dialogue",
   "jp": "……土方さんの机の上に\\n突然差し入れがあるなんて\\nおかしかったんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b4c"
  },
  {
   "id": "b_009001:0x4a104",
   "off": 303364,
   "max": 68,
   "kind": "dialogue",
   "jp": "その不自然さに気づかず\\n一緒に食べてしまった\\n僕にも罪はあります",
   "en": "",
   "op": "0x62",
   "msg": "0x2b4d"
  },
  {
   "id": "b_009001:0x4aca8",
   "off": 306344,
   "max": 60,
   "kind": "dialogue",
   "jp": "だから濡れ衣じゃないです\\n僕が謝るのは\\n筋が通ってるんです",
   "en": "",
   "op": "0x62",
   "msg": "0x2b4e"
  },
  {
   "id": "b_009001:0x4b664",
   "off": 308836,
   "max": 48,
   "kind": "dialogue",
   "jp": "俺を庇おうと思った\\nお前の気持ちは\\nありがたい",
   "en": "",
   "op": "0x62",
   "msg": "0x2b4f"
  },
  {
   "id": "b_009001:0x4b6a4",
   "off": 308900,
   "max": 60,
   "kind": "dialogue",
   "jp": "だがそんな風に\\n自分を貶めてまで\\n俺をかばわなくていいぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b50"
  },
  {
   "id": "b_009001:0x4bbf4",
   "off": 310260,
   "max": 52,
   "kind": "dialogue",
   "jp": "……余計なことを\\nしてしまって……\\n……すみません",
   "en": "",
   "op": "0x62",
   "msg": "0x2b51"
  },
  {
   "id": "b_009001:0x4c150",
   "off": 311632,
   "max": 12,
   "kind": "dialogue",
   "jp": "謝るな総司",
   "en": "",
   "op": "0x62",
   "msg": "0x2b52"
  },
  {
   "id": "b_009001:0x4c77c",
   "off": 313212,
   "max": 48,
   "kind": "dialogue",
   "jp": "土方は不器用に微笑むと\\n沖田の頭を優しく撫でた",
   "en": "",
   "op": "0x62",
   "msg": "0x2b53"
  },
  {
   "id": "b_009001:0x4cdc4",
   "off": 314820,
   "max": 36,
   "kind": "dialogue",
   "jp": "お前の気持ちは嬉しい\\nありがとう",
   "en": "",
   "op": "0x62",
   "msg": "0x2b54"
  },
  {
   "id": "b_009001:0x4d378",
   "off": 316280,
   "max": 56,
   "kind": "dialogue",
   "jp": "……子供扱いしないで\\n下さいよ\\n怒りますよー　もうー",
   "en": "",
   "op": "0x62",
   "msg": "0x2b55"
  },
  {
   "id": "b_009001:0x4de5c",
   "off": 319068,
   "max": 36,
   "kind": "dialogue",
   "jp": "めちゃくちゃ\\n嬉しそうじゃないか",
   "en": "",
   "op": "0x62",
   "msg": "0x2b56"
  },
  {
   "id": "b_009001:0x4e380",
   "off": 320384,
   "max": 12,
   "kind": "dialogue",
   "jp": "ですねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b57"
  },
  {
   "id": "b_009001:0x4ecb8",
   "off": 322744,
   "max": 28,
   "kind": "dialogue",
   "jp": "うるさい\\nスカシとメガネ",
   "en": "",
   "op": "0x62",
   "msg": "0x2b58"
  },
  {
   "id": "b_009001:0x4f670",
   "off": 325232,
   "max": 52,
   "kind": "dialogue",
   "jp": "うううっ\\n麗しき先輩後輩愛！\\nわしゃ感動したぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b59"
  },
  {
   "id": "b_009001:0x4fffc",
   "off": 327676,
   "max": 24,
   "kind": "dialogue",
   "jp": "トサカくんもうるさい",
   "en": "",
   "op": "0x62",
   "msg": "0x2b5a"
  },
  {
   "id": "b_009001:0x50734",
   "off": 329524,
   "max": 56,
   "kind": "dialogue",
   "jp": "さぁ\\nこれにて大福盗難事件の\\n謎は解き明かされました",
   "en": "",
   "op": "0x62",
   "msg": "0x2b5b"
  },
  {
   "id": "b_009001:0x511e4",
   "off": 332260,
   "max": 24,
   "kind": "dialogue",
   "jp": "これにて一件落着ぅ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b5c"
  },
  {
   "id": "b_009001:0x51cb4",
   "off": 335028,
   "max": 40,
   "kind": "dialogue",
   "jp": "最後　名探偵じゃ\\nなくなってないか",
   "en": "",
   "op": "0x62",
   "msg": "0x2b5d"
  },
  {
   "id": "b_009001:0x521dc",
   "off": 336348,
   "max": 28,
   "kind": "dialogue",
   "jp": "解決したから\\nいいぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2b5e"
  },
  {
   "id": "b_009001:0x52764",
   "off": 337764,
   "max": 24,
   "kind": "dialogue",
   "jp": "いい加減だな　おい！",
   "en": "",
   "op": "0x62",
   "msg": "0x2b5f"
  },
  {
   "id": "b_009001:0x52d00",
   "off": 339200,
   "max": 24,
   "kind": "dialogue",
   "jp": "これは　とある日の午後",
   "en": "",
   "op": "0x62",
   "msg": "0x2b60"
  },
  {
   "id": "b_009001:0x52d28",
   "off": 339240,
   "max": 76,
   "kind": "dialogue",
   "jp": "大福がもたらした\\n事件により　仲間達の\\n友情が垣間見られた\\n一幕である――",
   "en": "",
   "op": "0x62",
   "msg": "0x2b61"
  }
 ]
}
