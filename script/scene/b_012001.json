{
 "source": "b_012001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_012001:0x10e8",
   "off": 4328,
   "max": 32,
   "kind": "dialogue",
   "jp": "アルベルゴ\\nディテラーダ",
   "en": "Albergo di Terada",
   "op": "0x62",
   "msg": "0x2f08"
  },
  {
   "id": "b_012001:0x1118",
   "off": 4376,
   "max": 64,
   "kind": "dialogue",
   "jp": "ここで働くようになった\\n三人娘は　客が途絶えると\\n休憩に入った",
   "en": "The three girls\\nwho had started\\nworking here took\\na break whenever\\nthe customers\\nstopped coming.",
   "op": "0x62",
   "msg": "0x2f09"
  },
  {
   "id": "b_012001:0x1950",
   "off": 6480,
   "max": 12,
   "kind": "dialogue",
   "jp": "はああ……",
   "en": "Haaah...",
   "op": "0x62",
   "msg": "0x2f0a"
  },
  {
   "id": "b_012001:0x22d4",
   "off": 8916,
   "max": 36,
   "kind": "dialogue",
   "jp": "姐さん…\\nどうしたんですかぁ…？",
   "en": "Sis... what's\\nwrong~?",
   "op": "0x62",
   "msg": "0x2f0b"
  },
  {
   "id": "b_012001:0x2774",
   "off": 10100,
   "max": 48,
   "kind": "dialogue",
   "jp": "ふと　龍馬に負けたことを\\n思い出しちまったのさ",
   "en": "I just\\nremembered\\nlosing to Ryoma,\\nthat's all.",
   "op": "0x62",
   "msg": "0x2f0c"
  },
  {
   "id": "b_012001:0x2e40",
   "off": 11840,
   "max": 64,
   "kind": "dialogue",
   "jp": "負けた悔しさっていうのは\\nなかなか消えないもの\\nですよね……",
   "en": "The sting of\\nlosing... doesn't\\nfade easily,\\ndoes it...",
   "op": "0x62",
   "msg": "0x2f0d"
  },
  {
   "id": "b_012001:0x32fc",
   "off": 13052,
   "max": 56,
   "kind": "dialogue",
   "jp": "そうなんだよ\\nなんとかやり返す機会が\\nないものかねぇ",
   "en": "That's right.\\nAin't there some\\nchance to get\\nback at him?",
   "op": "0x62",
   "msg": "0x2f0e"
  },
  {
   "id": "b_012001:0x37b0",
   "off": 14256,
   "max": 64,
   "kind": "dialogue",
   "jp": "でも……世話になってる\\nから……マズイことは\\nできませんよ……",
   "en": "But... we owe\\nhim... We can't do\\nanything nasty...",
   "op": "0x62",
   "msg": "0x2f0f"
  },
  {
   "id": "b_012001:0x429c",
   "off": 17052,
   "max": 72,
   "kind": "dialogue",
   "jp": "それならぁ色仕掛けで\\n迫ってぇ　龍馬を籠絡し\\nちゃうのはどうですかぁ？",
   "en": "Then how about\\nwe use our\\nfeminine wiles~\\nand get Ryoma\\nwrapped around\\nour fingers~?",
   "op": "0x62",
   "msg": "0x2f10"
  },
  {
   "id": "b_012001:0x4b44",
   "off": 19268,
   "max": 36,
   "kind": "dialogue",
   "jp": "それなら……\\n問題ないかな……？",
   "en": "That would be...\\nno problem... I\\nsuppose...?",
   "op": "0x62",
   "msg": "0x2f11"
  },
  {
   "id": "b_012001:0x5084",
   "off": 20612,
   "max": 36,
   "kind": "dialogue",
   "jp": "そうだね\\nおうの　アンタ冴えてるよ",
   "en": "Right. Ouno,\\nyou're sharp\\ntoday.",
   "op": "0x62",
   "msg": "0x2f12"
  },
  {
   "id": "b_012001:0x5748",
   "off": 22344,
   "max": 32,
   "kind": "dialogue",
   "jp": "ありがとう\\nございまぁーすぅ！",
   "en": "Thank youuu~!",
   "op": "0x62",
   "msg": "0x2f13"
  },
  {
   "id": "b_012001:0x5c7c",
   "off": 23676,
   "max": 72,
   "kind": "dialogue",
   "jp": "出前に出ている龍馬が\\n帰ってきたら　アタシ達の\\n魅力で龍馬を虜にするよ",
   "en": "When Ryoma\\ngets back from\\nhis delivery, we'll\\ncaptivate him\\nwith our charms.",
   "op": "0x62",
   "msg": "0x2f14"
  },
  {
   "id": "b_012001:0x6360",
   "off": 25440,
   "max": 20,
   "kind": "dialogue",
   "jp": "承知しました……",
   "en": "Understood...",
   "op": "0x62",
   "msg": "0x2f15"
  },
  {
   "id": "b_012001:0x6d38",
   "off": 27960,
   "max": 20,
   "kind": "dialogue",
   "jp": "帰ったぜよーーー！",
   "en": "I'm baaack!",
   "op": "0x62",
   "msg": "0x2f16"
  },
  {
   "id": "b_012001:0x7454",
   "off": 29780,
   "max": 24,
   "kind": "dialogue",
   "jp": "おや　早速帰ってきたよ",
   "en": "Well, he's\\nback already.",
   "op": "0x62",
   "msg": "0x2f17"
  },
  {
   "id": "b_012001:0x7b58",
   "off": 31576,
   "max": 36,
   "kind": "dialogue",
   "jp": "おや　お客さんがいない\\n珍しいな",
   "en": "Huh, no\\ncustomers?\\nThat's rare.",
   "op": "0x62",
   "msg": "0x2f18"
  },
  {
   "id": "b_012001:0x7ff8",
   "off": 32760,
   "max": 36,
   "kind": "dialogue",
   "jp": "お先に休憩させて\\nもらっているよ",
   "en": "We're taking\\nour break first.",
   "op": "0x62",
   "msg": "0x2f19"
  },
  {
   "id": "b_012001:0x86bc",
   "off": 34492,
   "max": 56,
   "kind": "dialogue",
   "jp": "龍馬ぁ……いえ　龍にぃ\\n出前に行ってぇ\\n疲れたでしょ～",
   "en": "Ryomaaa... I\\nmean, Big Bro\\nRyo~ You must\\nbe tired from\\nthe delivery~",
   "op": "0x62",
   "msg": "0x2f1a"
  },
  {
   "id": "b_012001:0x8704",
   "off": 34564,
   "max": 36,
   "kind": "dialogue",
   "jp": "飲み物を持ってきて\\nあげまぁす～",
   "en": "I'll bring you\\nsomething\\nto driiink~",
   "op": "0x62",
   "msg": "0x2f1b"
  },
  {
   "id": "b_012001:0x8c3c",
   "off": 35900,
   "max": 20,
   "kind": "dialogue",
   "jp": "そーか　悪いのう！",
   "en": "Oh yeah?\\nMuch obliged!",
   "op": "0x62",
   "msg": "0x2f1c"
  },
  {
   "id": "b_012001:0x9164",
   "off": 37220,
   "max": 24,
   "kind": "dialogue",
   "jp": "いいってことですよぅ～",
   "en": "Don't mention it~",
   "op": "0x62",
   "msg": "0x2f1d"
  },
  {
   "id": "b_012001:0x9818",
   "off": 38936,
   "max": 52,
   "kind": "dialogue",
   "jp": "それなら私は……\\n肩でも揉んで\\nあげましょう……",
   "en": "Then I'll...\\ngive you a\\nshoulder rub...",
   "op": "0x62",
   "msg": "0x2f1e"
  },
  {
   "id": "b_012001:0x9f14",
   "off": 40724,
   "max": 36,
   "kind": "dialogue",
   "jp": "まじで\\nどういう風の吹き回しじゃ",
   "en": "Seriously? What's\\ngot into you all?",
   "op": "0x62",
   "msg": "0x2f1f"
  },
  {
   "id": "b_012001:0xa5d0",
   "off": 42448,
   "max": 44,
   "kind": "dialogue",
   "jp": "同じ店で働く者同士\\n協力し合わないとねぇ",
   "en": "We work at the\\nsame place, so\\nwe gotta help\\neach other out.",
   "op": "0x62",
   "msg": "0x2f20"
  },
  {
   "id": "b_012001:0xab10",
   "off": 43792,
   "max": 36,
   "kind": "dialogue",
   "jp": "それはそうだが\\nなんか　驚きぜよ",
   "en": "Well, that's\\ntrue, but color\\nme surprised.",
   "op": "0x62",
   "msg": "0x2f21"
  },
  {
   "id": "b_012001:0xb048",
   "off": 45128,
   "max": 68,
   "kind": "dialogue",
   "jp": "せっかく親切にして\\nやろうっていうんだから\\n文句を言うんじゃないよ",
   "en": "We're goin' out\\nof our way to\\nbe nice, so don't\\nyou complain.",
   "op": "0x62",
   "msg": "0x2f22"
  },
  {
   "id": "b_012001:0xb5a0",
   "off": 46496,
   "max": 20,
   "kind": "dialogue",
   "jp": "おお　ありがとう！",
   "en": "Hey, thank\\nya kindly!",
   "op": "0x62",
   "msg": "0x2f23"
  },
  {
   "id": "b_012001:0xbf7c",
   "off": 49020,
   "max": 12,
   "kind": "dialogue",
   "jp": "こんにちは",
   "en": "Good afternoon.",
   "op": "0x62",
   "msg": "0x2f24"
  },
  {
   "id": "b_012001:0xc540",
   "off": 50496,
   "max": 28,
   "kind": "dialogue",
   "jp": "客はいないのか\\n休憩中か？",
   "en": "No customers?\\nYou on break?",
   "op": "0x62",
   "msg": "0x2f25"
  },
  {
   "id": "b_012001:0xcc30",
   "off": 52272,
   "max": 60,
   "kind": "dialogue",
   "jp": "センセーとシンディ！\\nちょうど休憩に入る\\nところだったぜよ",
   "en": "Sensei and\\nShindy! We\\nwere just about\\nto take a break!",
   "op": "0x62",
   "msg": "0x2f26"
  },
  {
   "id": "b_012001:0xd544",
   "off": 54596,
   "max": 36,
   "kind": "dialogue",
   "jp": "いらっしゃい\\nいいところに来たねぇ",
   "en": "Welcome.\\nYou came at\\na good time.",
   "op": "0x62",
   "msg": "0x2f27"
  },
  {
   "id": "b_012001:0xdbac",
   "off": 56236,
   "max": 40,
   "kind": "dialogue",
   "jp": "お龍姐さん…\\n二人はどうしますか…？",
   "en": "Sis Oryo... what\\nabout those two...?",
   "op": "0x62",
   "msg": "0x2f28"
  },
  {
   "id": "b_012001:0xe0f0",
   "off": 57584,
   "max": 28,
   "kind": "dialogue",
   "jp": "三人まとめて\\nやっちまうよ",
   "en": "We'll do all\\nthree at once.",
   "op": "0x62",
   "msg": "0x2f29"
  },
  {
   "id": "b_012001:0xe62c",
   "off": 58924,
   "max": 20,
   "kind": "dialogue",
   "jp": "承知しました……",
   "en": "Understood...",
   "op": "0x62",
   "msg": "0x2f2a"
  },
  {
   "id": "b_012001:0xece4",
   "off": 60644,
   "max": 28,
   "kind": "dialogue",
   "jp": "まとめて何をするんです？",
   "en": "Do what to all\\nthree at once?",
   "op": "0x62",
   "msg": "0x2f2b"
  },
  {
   "id": "b_012001:0xf2bc",
   "off": 62140,
   "max": 72,
   "kind": "dialogue",
   "jp": "大したことじゃないよ\\n龍馬も含めて三人の料理も\\n用意しようかって意味さ",
   "en": "Nothing much.\\nJust that we'll\\nmake food for\\nall three of you,\\nRyoma included.",
   "op": "0x62",
   "msg": "0x2f2c"
  },
  {
   "id": "b_012001:0xf3ac",
   "off": 62380,
   "max": 52,
   "kind": "dialogue",
   "jp": "アンタらは特別なお客様だ\\nなんでも注文しておくれ",
   "en": "You're special\\nguests. Order\\nanything you like.",
   "op": "0x62",
   "msg": "0x2f2d"
  },
  {
   "id": "b_012001:0xf900",
   "off": 63744,
   "max": 24,
   "kind": "dialogue",
   "jp": "ありがとうございます",
   "en": "Thank you\\nvery much.",
   "op": "0x62",
   "msg": "0x2f2e"
  },
  {
   "id": "b_012001:0xffb0",
   "off": 65456,
   "max": 32,
   "kind": "dialogue",
   "jp": "男前さん達ぃ～\\nお茶ですよぉ～",
   "en": "Handsome\\ngentlemeeen~\\nHere's your\\nteaaa~",
   "op": "0x62",
   "msg": "0x2f2f"
  },
  {
   "id": "b_012001:0x10668",
   "off": 67176,
   "max": 24,
   "kind": "dialogue",
   "jp": "おお！　感謝するぜよ",
   "en": "Ooh! Thank\\nya kindly!",
   "op": "0x62",
   "msg": "0x2f30"
  },
  {
   "id": "b_012001:0x10d1c",
   "off": 68892,
   "max": 56,
   "kind": "dialogue",
   "jp": "すぐに茶が出てくるとは\\n気味が悪いほど\\n愛想がいいな",
   "en": "Tea right\\naway? You're\\nfriendly to the\\npoint of creepy.",
   "op": "0x62",
   "msg": "0x2f31"
  },
  {
   "id": "b_012001:0x113ec",
   "off": 70636,
   "max": 28,
   "kind": "dialogue",
   "jp": "いつもこんなものだろう？",
   "en": "Ain't it always\\nlike this?",
   "op": "0x62",
   "msg": "0x2f32"
  },
  {
   "id": "b_012001:0x11928",
   "off": 71976,
   "max": 72,
   "kind": "dialogue",
   "jp": "他の客に比べて料理を運ぶ\\nときに仏頂面だったりして\\n対応が雑だろうが",
   "en": "Compared to the\\nother customers,\\nyou're always\\nsour-faced\\nbringing our\\nfood. You treat\\nus like dirt!",
   "op": "0x62",
   "msg": "0x2f33"
  },
  {
   "id": "b_012001:0x11fc4",
   "off": 73668,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうだったかねぇ",
   "en": "Was it like\\nthat, now?",
   "op": "0x62",
   "msg": "0x2f34"
  },
  {
   "id": "b_012001:0x126e4",
   "off": 75492,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうだったかのう？",
   "en": "Was it, now?",
   "op": "0x62",
   "msg": "0x2f35"
  },
  {
   "id": "b_012001:0x12c10",
   "off": 76816,
   "max": 12,
   "kind": "dialogue",
   "jp": "そうだろ",
   "en": "It was!",
   "op": "0x62",
   "msg": "0x2f36"
  },
  {
   "id": "b_012001:0x132b8",
   "off": 78520,
   "max": 60,
   "kind": "dialogue",
   "jp": "まあまあ　晋作\\n親切にされる分には\\nいいじゃありませんか",
   "en": "Now, now,\\nShinsaku.\\nThere's no harm\\nin being treated\\nkindly, is there?",
   "op": "0x62",
   "msg": "0x2f37"
  },
  {
   "id": "b_012001:0x13814",
   "off": 79892,
   "max": 56,
   "kind": "dialogue",
   "jp": "良くねえ　こいつらに\\n親切にされるなんて\\n気味が悪い",
   "en": "Yes there is.\\nBeing treated\\nnice by these\\nthree is creepy.",
   "op": "0x62",
   "msg": "0x2f38"
  },
  {
   "id": "b_012001:0x1385c",
   "off": 79964,
   "max": 48,
   "kind": "dialogue",
   "jp": "嫌な予感がするから\\nオレ様は茶を飲んで帰るぜ",
   "en": "I've got a bad\\nfeeling. I'm\\ndrinking my tea\\nand leaving.",
   "op": "0x62",
   "msg": "0x2f39"
  },
  {
   "id": "b_012001:0x13da4",
   "off": 81316,
   "max": 8,
   "kind": "dialogue",
   "jp": "ええ？",
   "en": "Eh?",
   "op": "0x62",
   "msg": "0x2f3a"
  },
  {
   "id": "b_012001:0x145d0",
   "off": 83408,
   "max": 40,
   "kind": "dialogue",
   "jp": "その動物的な勘は\\nどこから来るのやら",
   "en": "Where does that\\nanimal instinct\\nof yours come\\nfrom, I wonder.",
   "op": "0x62",
   "msg": "0x2f3b"
  },
  {
   "id": "b_012001:0x14c3c",
   "off": 85052,
   "max": 8,
   "kind": "dialogue",
   "jp": "何？",
   "en": "What'd you say?",
   "op": "0x62",
   "msg": "0x2f3c"
  },
  {
   "id": "b_012001:0x151c0",
   "off": 86464,
   "max": 92,
   "kind": "dialogue",
   "jp": "眉尻をあげた高杉の両脇に\\nお龍たちが座ると　高杉は\\n居心地が悪そうに\\nお茶を一気に飲み干す",
   "en": "As Oryo and the\\nothers sat down\\non either side of\\nthe scowling\\nTakasugi, he\\nuncomfortably\\ngulped down his\\ntea in one go.",
   "op": "0x62",
   "msg": "0x2f3d"
  },
  {
   "id": "b_012001:0x157c8",
   "off": 88008,
   "max": 20,
   "kind": "dialogue",
   "jp": "んぐっ　あちっ",
   "en": "Ngh! Hot!",
   "op": "0x62",
   "msg": "0x2f3e"
  },
  {
   "id": "b_012001:0x15f6c",
   "off": 89964,
   "max": 60,
   "kind": "dialogue",
   "jp": "胸元にお茶をこぼした\\nわよ……今…\\n拭いてあげるから……",
   "en": "You spilled\\ntea... down your\\nchest... I'll wipe\\nit for you...",
   "op": "0x62",
   "msg": "0x2f3f"
  },
  {
   "id": "b_012001:0x165f8",
   "off": 91640,
   "max": 44,
   "kind": "dialogue",
   "jp": "幾松は高杉の\\n濡れた胸元を\\n布で雑に抑えた",
   "en": "Ikumatsu\\nroughly pressed\\na cloth against\\nTakasugi's wet\\nchest.",
   "op": "0x62",
   "msg": "0x2f40"
  },
  {
   "id": "b_012001:0x16b00",
   "off": 92928,
   "max": 20,
   "kind": "dialogue",
   "jp": "はい…拭いたわ…",
   "en": "There... all\\nwiped...",
   "op": "0x62",
   "msg": "0x2f41"
  },
  {
   "id": "b_012001:0x1702c",
   "off": 94252,
   "max": 48,
   "kind": "dialogue",
   "jp": "親切にされた気もするが\\n拭き方が雑すぎる……",
   "en": "I guess that was\\nnice, but you\\nwiped it way\\ntoo roughly...",
   "op": "0x62",
   "msg": "0x2f42"
  },
  {
   "id": "b_012001:0x17c0c",
   "off": 97292,
   "max": 12,
   "kind": "dialogue",
   "jp": "普通よ……",
   "en": "It was normal...",
   "op": "0x62",
   "msg": "0x2f43"
  },
  {
   "id": "b_012001:0x18094",
   "off": 98452,
   "max": 20,
   "kind": "dialogue",
   "jp": "目を見て言いやがれ",
   "en": "Look me in\\nthe eye when\\nyou say that.",
   "op": "0x62",
   "msg": "0x2f44"
  },
  {
   "id": "b_012001:0x185c8",
   "off": 99784,
   "max": 28,
   "kind": "dialogue",
   "jp": "ふ　ふふ……\\n普通よ……",
   "en": "Fu... fufu... It\\nwas normal...",
   "op": "0x62",
   "msg": "0x2f45"
  },
  {
   "id": "b_012001:0x18b58",
   "off": 101208,
   "max": 20,
   "kind": "dialogue",
   "jp": "挙動不審じゃねえか",
   "en": "You're acting\\ntotally shifty!",
   "op": "0x62",
   "msg": "0x2f46"
  },
  {
   "id": "b_012001:0x191fc",
   "off": 102908,
   "max": 56,
   "kind": "dialogue",
   "jp": "それを見ていたお龍は\\n諦めたように　\\nため息をついた",
   "en": "Oryo, who had\\nbeen watching,\\nsighed in\\nresignation.",
   "op": "0x62",
   "msg": "0x2f47"
  },
  {
   "id": "b_012001:0x19688",
