{
 "source": "b_012001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_012001:0x10e8",
   "off": 4328,
   "max": 32,
   "kind": "dialogue",
   "jp": "アルベルゴ\\nディテラーダ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f08"
  },
  {
   "id": "b_012001:0x1118",
   "off": 4376,
   "max": 64,
   "kind": "dialogue",
   "jp": "ここで働くようになった\\n三人娘は　客が途絶えると\\n休憩に入った",
   "en": "",
   "op": "0x62",
   "msg": "0x2f09"
  },
  {
   "id": "b_012001:0x1950",
   "off": 6480,
   "max": 12,
   "kind": "dialogue",
   "jp": "はああ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f0a"
  },
  {
   "id": "b_012001:0x22d4",
   "off": 8916,
   "max": 36,
   "kind": "dialogue",
   "jp": "姐さん…\\nどうしたんですかぁ…？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f0b"
  },
  {
   "id": "b_012001:0x2774",
   "off": 10100,
   "max": 48,
   "kind": "dialogue",
   "jp": "ふと　龍馬に負けたことを\\n思い出しちまったのさ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f0c"
  },
  {
   "id": "b_012001:0x2e40",
   "off": 11840,
   "max": 64,
   "kind": "dialogue",
   "jp": "負けた悔しさっていうのは\\nなかなか消えないもの\\nですよね……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f0d"
  },
  {
   "id": "b_012001:0x32fc",
   "off": 13052,
   "max": 56,
   "kind": "dialogue",
   "jp": "そうなんだよ\\nなんとかやり返す機会が\\nないものかねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f0e"
  },
  {
   "id": "b_012001:0x37b0",
   "off": 14256,
   "max": 64,
   "kind": "dialogue",
   "jp": "でも……世話になってる\\nから……マズイことは\\nできませんよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f0f"
  },
  {
   "id": "b_012001:0x429c",
   "off": 17052,
   "max": 72,
   "kind": "dialogue",
   "jp": "それならぁ色仕掛けで\\n迫ってぇ　龍馬を籠絡し\\nちゃうのはどうですかぁ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f10"
  },
  {
   "id": "b_012001:0x4b44",
   "off": 19268,
   "max": 36,
   "kind": "dialogue",
   "jp": "それなら……\\n問題ないかな……？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f11"
  },
  {
   "id": "b_012001:0x5084",
   "off": 20612,
   "max": 36,
   "kind": "dialogue",
   "jp": "そうだね\\nおうの　アンタ冴えてるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f12"
  },
  {
   "id": "b_012001:0x5748",
   "off": 22344,
   "max": 32,
   "kind": "dialogue",
   "jp": "ありがとう\\nございまぁーすぅ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f13"
  },
  {
   "id": "b_012001:0x5c7c",
   "off": 23676,
   "max": 72,
   "kind": "dialogue",
   "jp": "出前に出ている龍馬が\\n帰ってきたら　アタシ達の\\n魅力で龍馬を虜にするよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f14"
  },
  {
   "id": "b_012001:0x6360",
   "off": 25440,
   "max": 20,
   "kind": "dialogue",
   "jp": "承知しました……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f15"
  },
  {
   "id": "b_012001:0x6d38",
   "off": 27960,
   "max": 20,
   "kind": "dialogue",
   "jp": "帰ったぜよーーー！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f16"
  },
  {
   "id": "b_012001:0x7454",
   "off": 29780,
   "max": 24,
   "kind": "dialogue",
   "jp": "おや　早速帰ってきたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f17"
  },
  {
   "id": "b_012001:0x7b58",
   "off": 31576,
   "max": 36,
   "kind": "dialogue",
   "jp": "おや　お客さんがいない\\n珍しいな",
   "en": "",
   "op": "0x62",
   "msg": "0x2f18"
  },
  {
   "id": "b_012001:0x7ff8",
   "off": 32760,
   "max": 36,
   "kind": "dialogue",
   "jp": "お先に休憩させて\\nもらっているよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f19"
  },
  {
   "id": "b_012001:0x86bc",
   "off": 34492,
   "max": 56,
   "kind": "dialogue",
   "jp": "龍馬ぁ……いえ　龍にぃ\\n出前に行ってぇ\\n疲れたでしょ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2f1a"
  },
  {
   "id": "b_012001:0x8704",
   "off": 34564,
   "max": 36,
   "kind": "dialogue",
   "jp": "飲み物を持ってきて\\nあげまぁす～",
   "en": "",
   "op": "0x62",
   "msg": "0x2f1b"
  },
  {
   "id": "b_012001:0x8c3c",
   "off": 35900,
   "max": 20,
   "kind": "dialogue",
   "jp": "そーか　悪いのう！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f1c"
  },
  {
   "id": "b_012001:0x9164",
   "off": 37220,
   "max": 24,
   "kind": "dialogue",
   "jp": "いいってことですよぅ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2f1d"
  },
  {
   "id": "b_012001:0x9818",
   "off": 38936,
   "max": 52,
   "kind": "dialogue",
   "jp": "それなら私は……\\n肩でも揉んで\\nあげましょう……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f1e"
  },
  {
   "id": "b_012001:0x9f14",
   "off": 40724,
   "max": 36,
   "kind": "dialogue",
   "jp": "まじで\\nどういう風の吹き回しじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f1f"
  },
  {
   "id": "b_012001:0xa5d0",
   "off": 42448,
   "max": 44,
   "kind": "dialogue",
   "jp": "同じ店で働く者同士\\n協力し合わないとねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f20"
  },
  {
   "id": "b_012001:0xab10",
   "off": 43792,
   "max": 36,
   "kind": "dialogue",
   "jp": "それはそうだが\\nなんか　驚きぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f21"
  },
  {
   "id": "b_012001:0xb048",
   "off": 45128,
   "max": 68,
   "kind": "dialogue",
   "jp": "せっかく親切にして\\nやろうっていうんだから\\n文句を言うんじゃないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f22"
  },
  {
   "id": "b_012001:0xb5a0",
   "off": 46496,
   "max": 20,
   "kind": "dialogue",
   "jp": "おお　ありがとう！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f23"
  },
  {
   "id": "b_012001:0xbf7c",
   "off": 49020,
   "max": 12,
   "kind": "dialogue",
   "jp": "こんにちは",
   "en": "",
   "op": "0x62",
   "msg": "0x2f24"
  },
  {
   "id": "b_012001:0xc540",
   "off": 50496,
   "max": 28,
   "kind": "dialogue",
   "jp": "客はいないのか\\n休憩中か？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f25"
  },
  {
   "id": "b_012001:0xcc30",
   "off": 52272,
   "max": 60,
   "kind": "dialogue",
   "jp": "センセーとシンディ！\\nちょうど休憩に入る\\nところだったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f26"
  },
  {
   "id": "b_012001:0xd544",
   "off": 54596,
   "max": 36,
   "kind": "dialogue",
   "jp": "いらっしゃい\\nいいところに来たねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f27"
  },
  {
   "id": "b_012001:0xdbac",
   "off": 56236,
   "max": 40,
   "kind": "dialogue",
   "jp": "お龍姐さん…\\n二人はどうしますか…？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f28"
  },
  {
   "id": "b_012001:0xe0f0",
   "off": 57584,
   "max": 28,
   "kind": "dialogue",
   "jp": "三人まとめて\\nやっちまうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f29"
  },
  {
   "id": "b_012001:0xe62c",
   "off": 58924,
   "max": 20,
   "kind": "dialogue",
   "jp": "承知しました……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f2a"
  },
  {
   "id": "b_012001:0xece4",
   "off": 60644,
   "max": 28,
   "kind": "dialogue",
   "jp": "まとめて何をするんです？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f2b"
  },
  {
   "id": "b_012001:0xf2bc",
   "off": 62140,
   "max": 72,
   "kind": "dialogue",
   "jp": "大したことじゃないよ\\n龍馬も含めて三人の料理も\\n用意しようかって意味さ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f2c"
  },
  {
   "id": "b_012001:0xf3ac",
   "off": 62380,
   "max": 52,
   "kind": "dialogue",
   "jp": "アンタらは特別なお客様だ\\nなんでも注文しておくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f2d"
  },
  {
   "id": "b_012001:0xf900",
   "off": 63744,
   "max": 24,
   "kind": "dialogue",
   "jp": "ありがとうございます",
   "en": "",
   "op": "0x62",
   "msg": "0x2f2e"
  },
  {
   "id": "b_012001:0xffb0",
   "off": 65456,
   "max": 32,
   "kind": "dialogue",
   "jp": "男前さん達ぃ～\\nお茶ですよぉ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2f2f"
  },
  {
   "id": "b_012001:0x10668",
   "off": 67176,
   "max": 24,
   "kind": "dialogue",
   "jp": "おお！　感謝するぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f30"
  },
  {
   "id": "b_012001:0x10d1c",
   "off": 68892,
   "max": 56,
   "kind": "dialogue",
   "jp": "すぐに茶が出てくるとは\\n気味が悪いほど\\n愛想がいいな",
   "en": "",
   "op": "0x62",
   "msg": "0x2f31"
  },
  {
   "id": "b_012001:0x113ec",
   "off": 70636,
   "max": 28,
   "kind": "dialogue",
   "jp": "いつもこんなものだろう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f32"
  },
  {
   "id": "b_012001:0x11928",
   "off": 71976,
   "max": 72,
   "kind": "dialogue",
   "jp": "他の客に比べて料理を運ぶ\\nときに仏頂面だったりして\\n対応が雑だろうが",
   "en": "",
   "op": "0x62",
   "msg": "0x2f33"
  },
  {
   "id": "b_012001:0x11fc4",
   "off": 73668,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうだったかねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f34"
  },
  {
   "id": "b_012001:0x126e4",
   "off": 75492,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうだったかのう？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f35"
  },
  {
   "id": "b_012001:0x12c10",
   "off": 76816,
   "max": 12,
   "kind": "dialogue",
   "jp": "そうだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f36"
  },
  {
   "id": "b_012001:0x132b8",
   "off": 78520,
   "max": 60,
   "kind": "dialogue",
   "jp": "まあまあ　晋作\\n親切にされる分には\\nいいじゃありませんか",
   "en": "",
   "op": "0x62",
   "msg": "0x2f37"
  },
  {
   "id": "b_012001:0x13814",
   "off": 79892,
   "max": 56,
   "kind": "dialogue",
   "jp": "良くねえ　こいつらに\\n親切にされるなんて\\n気味が悪い",
   "en": "",
   "op": "0x62",
   "msg": "0x2f38"
  },
  {
   "id": "b_012001:0x1385c",
   "off": 79964,
   "max": 48,
   "kind": "dialogue",
   "jp": "嫌な予感がするから\\nオレ様は茶を飲んで帰るぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f39"
  },
  {
   "id": "b_012001:0x13da4",
   "off": 81316,
   "max": 8,
   "kind": "dialogue",
   "jp": "ええ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f3a"
  },
  {
   "id": "b_012001:0x145d0",
   "off": 83408,
   "max": 40,
   "kind": "dialogue",
   "jp": "その動物的な勘は\\nどこから来るのやら",
   "en": "",
   "op": "0x62",
   "msg": "0x2f3b"
  },
  {
   "id": "b_012001:0x14c3c",
   "off": 85052,
   "max": 8,
   "kind": "dialogue",
   "jp": "何？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f3c"
  },
  {
   "id": "b_012001:0x151c0",
   "off": 86464,
   "max": 92,
   "kind": "dialogue",
   "jp": "眉尻をあげた高杉の両脇に\\nお龍たちが座ると　高杉は\\n居心地が悪そうに\\nお茶を一気に飲み干す",
   "en": "",
   "op": "0x62",
   "msg": "0x2f3d"
  },
  {
   "id": "b_012001:0x157c8",
   "off": 88008,
   "max": 20,
   "kind": "dialogue",
   "jp": "んぐっ　あちっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f3e"
  },
  {
   "id": "b_012001:0x15f6c",
   "off": 89964,
   "max": 60,
   "kind": "dialogue",
   "jp": "胸元にお茶をこぼした\\nわよ……今…\\n拭いてあげるから……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f3f"
  },
  {
   "id": "b_012001:0x165f8",
   "off": 91640,
   "max": 44,
   "kind": "dialogue",
   "jp": "幾松は高杉の\\n濡れた胸元を\\n布で雑に抑えた",
   "en": "",
   "op": "0x62",
   "msg": "0x2f40"
  },
  {
   "id": "b_012001:0x16b00",
   "off": 92928,
   "max": 20,
   "kind": "dialogue",
   "jp": "はい…拭いたわ…",
   "en": "",
   "op": "0x62",
   "msg": "0x2f41"
  },
  {
   "id": "b_012001:0x1702c",
   "off": 94252,
   "max": 48,
   "kind": "dialogue",
   "jp": "親切にされた気もするが\\n拭き方が雑すぎる……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f42"
  },
  {
   "id": "b_012001:0x17c0c",
   "off": 97292,
   "max": 12,
   "kind": "dialogue",
   "jp": "普通よ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f43"
  },
  {
   "id": "b_012001:0x18094",
   "off": 98452,
   "max": 20,
   "kind": "dialogue",
   "jp": "目を見て言いやがれ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f44"
  },
  {
   "id": "b_012001:0x185c8",
   "off": 99784,
   "max": 28,
   "kind": "dialogue",
   "jp": "ふ　ふふ……\\n普通よ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f45"
  },
  {
   "id": "b_012001:0x18b58",
   "off": 101208,
   "max": 20,
   "kind": "dialogue",
   "jp": "挙動不審じゃねえか",
   "en": "",
   "op": "0x62",
   "msg": "0x2f46"
  },
  {
   "id": "b_012001:0x191fc",
   "off": 102908,
   "max": 56,
   "kind": "dialogue",
   "jp": "それを見ていたお龍は\\n諦めたように　\\nため息をついた",
   "en": "",
   "op": "0x62",
   "msg": "0x2f47"
  },
  {
   "id": "b_012001:0x19688",
   "off": 104072,
   "max": 24,
   "kind": "dialogue",
   "jp": "幾松　どうしたんだい？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f48"
  },
  {
   "id": "b_012001:0x19ce4",
   "off": 105700,
   "max": 60,
   "kind": "dialogue",
   "jp": "お龍姐さん……\\n正直に申し上げても\\n宜しいでしょうか……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f49"
  },
  {
   "id": "b_012001:0x1a19c",
   "off": 106908,
   "max": 12,
   "kind": "dialogue",
   "jp": "なんだい？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f4a"
  },
  {
   "id": "b_012001:0x1a624",
   "off": 108068,
   "max": 60,
   "kind": "dialogue",
   "jp": "あまり興味のない男を\\n誘惑するのは無理がある\\nようです……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f4b"
  },
  {
   "id": "b_012001:0x1ab7c",
   "off": 109436,
   "max": 4,
   "kind": "dialogue",
   "jp": "",
   "en": "",
   "op": "0x62",
   "msg": "0x2f4c"
  },
  {
   "id": "b_012001:0x1b5f0",
   "off": 112112,
   "max": 12,
   "kind": "dialogue",
   "jp": "誘惑だと",
   "en": "",
   "op": "0x62",
   "msg": "0x2f4d"
  },
  {
   "id": "b_012001:0x1bef8",
   "off": 114424,
   "max": 40,
   "kind": "dialogue",
   "jp": "ありゃりゃ～\\nもうばらしちゃったぁ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2f4e"
  },
  {
   "id": "b_012001:0x1c78c",
   "off": 116620,
   "max": 68,
   "kind": "dialogue",
   "jp": "えっ　じゃあ今のって\\n誘惑だったんですか？\\nそっちの方が驚きました",
   "en": "",
   "op": "0x62",
   "msg": "0x2f4f"
  },
  {
   "id": "b_012001:0x1ce6c",
   "off": 118380,
   "max": 24,
   "kind": "dialogue",
   "jp": "稚拙なのは認めるわ……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f50"
  },
  {
   "id": "b_012001:0x1d608",
   "off": 120328,
   "max": 24,
   "kind": "dialogue",
   "jp": "しょうがない子だねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f51"
  },
  {
   "id": "b_012001:0x1d6c8",
   "off": 120520,
   "max": 72,
   "kind": "dialogue",
   "jp": "でも興味がない男の誘惑が\\n気乗りしないっていうのは\\n理解できるけどさ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f52"
  },
  {
   "id": "b_012001:0x1d720",
   "off": 120608,
   "max": 52,
   "kind": "dialogue",
   "jp": "そもそも龍馬達には\\n音楽の熱情は\\n感じるけど――",
   "en": "",
   "op": "0x62",
   "msg": "0x2f53"
  },
  {
   "id": "b_012001:0x1d7fc",
   "off": 120828,
   "max": 48,
   "kind": "dialogue",
   "jp": "誘惑したいと思うような\\n色男ではないものねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f54"
  },
  {
   "id": "b_012001:0x1e188",
   "off": 123272,
   "max": 16,
   "kind": "dialogue",
   "jp": "なんだって",
   "en": "",
   "op": "0x62",
   "msg": "0x2f55"
  },
  {
   "id": "b_012001:0x1ea1c",
   "off": 125468,
   "max": 64,
   "kind": "dialogue",
   "jp": "聞き捨てならねえ\\n勝手に誘惑しておいて\\nなんてこと言いやがる！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f56"
  },
  {
   "id": "b_012001:0x1f100",
   "off": 127232,
   "max": 32,
   "kind": "dialogue",
   "jp": "男の沽券に関わる\\n発言ですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x2f57"
  },
  {
   "id": "b_012001:0x1f59c",
   "off": 128412,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああ　まったくだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f58"
  },
  {
   "id": "b_012001:0x1fc48",
   "off": 130120,
   "max": 12,
   "kind": "dialogue",
   "jp": "うむうむ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f59"
  },
  {
   "id": "b_012001:0x20460",
   "off": 132192,
   "max": 44,
   "kind": "dialogue",
   "jp": "おや　じゃあ自分達が\\n色男とでもいうのかい",
   "en": "",
   "op": "0x62",
   "msg": "0x2f5a"
  },
  {
   "id": "b_012001:0x20acc",
   "off": 133836,
   "max": 44,
   "kind": "dialogue",
   "jp": "当然じゃ！\\nわしほどの色男は\\nいないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f5b"
  },
  {
   "id": "b_012001:0x2119c",
   "off": 135580,
   "max": 68,
   "kind": "dialogue",
   "jp": "龍馬　それは違うぜ\\nこの中で一番の色男と\\n言えば　オレ様だからな",
   "en": "",
   "op": "0x62",
   "msg": "0x2f5c"
  },
  {
   "id": "b_012001:0x216b8",
   "off": 136888,
   "max": 52,
   "kind": "dialogue",
   "jp": "はっはっはっ\\nシンディは面白いことを\\n言うなあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f5d"
  },
  {
   "id": "b_012001:0x21c14",
   "off": 138260,
   "max": 12,
   "kind": "dialogue",
   "jp": "なんだと？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f5e"
  },
  {
   "id": "b_012001:0x22134",
   "off": 139572,
   "max": 48,
   "kind": "dialogue",
   "jp": "シンディも\\nいい線行ってるが\\nわしが一番じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f5f"
  },
  {
   "id": "b_012001:0x227bc",
   "off": 141244,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんでオレ様が\\n龍馬の下なんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f60"
  },
  {
   "id": "b_012001:0x22848",
   "off": 141384,
   "max": 48,
   "kind": "dialogue",
   "jp": "あとその根拠のない\\n自信はどっから来るんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f61"
  },
  {
   "id": "b_012001:0x23074",
   "off": 143476,
   "max": 44,
   "kind": "dialogue",
   "jp": "男らしさを感じる部分は\\n人それぞれでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2f62"
  },
  {
   "id": "b_012001:0x230b0",
   "off": 143536,
   "max": 36,
   "kind": "dialogue",
   "jp": "だから順位は関係ないと\\n思いますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f63"
  },
  {
   "id": "b_012001:0x23770",
   "off": 145264,
   "max": 52,
   "kind": "dialogue",
   "jp": "いいや　ある！\\n少なくとも\\n龍馬には負けられねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f64"
  },
  {
   "id": "b_012001:0x23de4",
   "off": 146916,
   "max": 20,
   "kind": "dialogue",
   "jp": "わしは負けんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f65"
  },
  {
   "id": "b_012001:0x24274",
   "off": 148084,
   "max": 56,
   "kind": "dialogue",
   "jp": "だから　その自信は\\nどっから来るんだって\\n言ってるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f66"
  },
  {
   "id": "b_012001:0x24e64",
   "off": 151140,
   "max": 24,
   "kind": "dialogue",
   "jp": "流し目とか凄いからのう",
   "en": "",
   "op": "0x62",
   "msg": "0x2f67"
  },
  {
   "id": "b_012001:0x252f8",
   "off": 152312,
   "max": 20,
   "kind": "dialogue",
   "jp": "やったことねえだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f68"
  },
  {
   "id": "b_012001:0x25820",
   "off": 153632,
   "max": 24,
   "kind": "dialogue",
   "jp": "妄想の中では凄いんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f69"
  },
  {
   "id": "b_012001:0x25cb4",
   "off": 154804,
   "max": 28,
   "kind": "dialogue",
   "jp": "なんで自慢げに言うんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f6a"
  },
  {
   "id": "b_012001:0x268f0",
   "off": 157936,
   "max": 60,
   "kind": "dialogue",
   "jp": "そこまで言い争うなら\\nアタシ達が決着をつけて\\nやろうか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f6b"
  },
  {
   "id": "b_012001:0x272b0",
   "off": 160432,
   "max": 8,
   "kind": "dialogue",
   "jp": "ああ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f6c"
  },
  {
   "id": "b_012001:0x27734",
   "off": 161588,
   "max": 72,
   "kind": "dialogue",
   "jp": "三人の中で誰が一番の\\n色男かを張り合うなら\\nアタシ達が選んであげるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f6d"
  },
  {
   "id": "b_012001:0x27e14",
   "off": 163348,
   "max": 56,
   "kind": "dialogue",
   "jp": "そりゃあいい！\\nお龍達に誰が一番か\\n選んでもらうぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f6e"
  },
  {
   "id": "b_012001:0x282c8",
   "off": 164552,
   "max": 40,
   "kind": "dialogue",
   "jp": "お龍達にまともな評価が\\nできるのかよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f6f"
  },
  {
   "id": "b_012001:0x28aa4",
   "off": 166564,
   "max": 36,
   "kind": "dialogue",
   "jp": "なんかぁ\\n馬鹿にされた気がしますぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f70"
  },
  {
   "id": "b_012001:0x29200",
   "off": 168448,
   "max": 56,
   "kind": "dialogue",
   "jp": "桂ちゃんの言うとおり\\n好みを感じる部分は\\n人それぞれさ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f71"
  },
  {
   "id": "b_012001:0x292e0",
   "off": 168672,
   "max": 52,
   "kind": "dialogue",
   "jp": "けど　アタシ達の評価は\\n一定の指標になるはずだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f72"
  },
  {
   "id": "b_012001:0x299b0",
   "off": 170416,
   "max": 20,
   "kind": "dialogue",
   "jp": "それは言えてますね",
   "en": "",
   "op": "0x62",
   "msg": "0x2f73"
  },
  {
   "id": "b_012001:0x29e40",
   "off": 171584,
   "max": 52,
   "kind": "dialogue",
   "jp": "さあ　ひとりひとつずつ\\n恋愛について語ってごらん",
   "en": "",
   "op": "0x62",
   "msg": "0x2f74"
  },
  {
   "id": "b_012001:0x2a38c",
   "off": 172940,
   "max": 56,
   "kind": "dialogue",
   "jp": "そう言われても\\n語る範囲が広すぎて\\n困っちゃいますね",
   "en": "",
   "op": "0x62",
   "msg": "0x2f75"
  },
  {
   "id": "b_012001:0x2a470",
   "off": 173168,
   "max": 52,
   "kind": "dialogue",
   "jp": "お題とか出してくれるなら\\nまだ語りやすいでしょうが",
   "en": "",
   "op": "0x62",
   "msg": "0x2f76"
  },
  {
   "id": "b_012001:0x2acb0",
   "off": 175280,
   "max": 32,
   "kind": "dialogue",
   "jp": "おっ\\nセンセーもやる気じゃな",
   "en": "",
   "op": "0x62",
   "msg": "0x2f77"
  },
  {
   "id": "b_012001:0x2b4e0",
   "off": 177376,
   "max": 36,
   "kind": "dialogue",
   "jp": "私にだって\\n自尊心はありますからね",
   "en": "",
   "op": "0x62",
   "msg": "0x2f78"
  },
  {
   "id": "b_012001:0x2bd88",
   "off": 179592,
   "max": 52,
   "kind": "dialogue",
   "jp": "それならぁ\\n女の子と二人きりに\\nなったときぃ――",
   "en": "",
   "op": "0x62",
   "msg": "0x2f79"
  },
  {
   "id": "b_012001:0x2bdcc",
   "off": 179660,
   "max": 52,
   "kind": "dialogue",
   "jp": "どんな風に\\n過ごしたいのかぁ\\n聞いてみたいでぇす",
   "en": "",
   "op": "0x62",
   "msg": "0x2f7a"
  },
  {
   "id": "b_012001:0x2c440",
   "off": 181312,
   "max": 20,
   "kind": "dialogue",
   "jp": "それはいいねぇ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f7b"
  },
  {
   "id": "b_012001:0x2c970",
   "off": 182640,
   "max": 44,
   "kind": "dialogue",
   "jp": "きゅんきゅんする回答を\\nお願いしまぁすぅ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2f7c"
  },
  {
   "id": "b_012001:0x2d4bc",
   "off": 185532,
   "max": 24,
   "kind": "dialogue",
   "jp": "では　わしから行くかな",
   "en": "",
   "op": "0x62",
   "msg": "0x2f7d"
  },
  {
   "id": "b_012001:0x2de4c",
   "off": 187980,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬が考える過ごし方が\\nどんなものか聞いてやるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f7e"
  },
  {
   "id": "b_012001:0x2e3a4",
   "off": 189348,
   "max": 68,
   "kind": "dialogue",
   "jp": "わしが女の子と二人きりに\\nなったら　とにかく楽しい\\nことをする！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f7f"
  },
  {
   "id": "b_012001:0x2ea40",
   "off": 191040,
   "max": 68,
   "kind": "dialogue",
   "jp": "な　なんか随分大雑把だな\\n楽しいことって　具体的に\\nどんなことだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f80"
  },
  {
   "id": "b_012001:0x2f284",
   "off": 193156,
   "max": 60,
   "kind": "dialogue",
   "jp": "例えば　舟でも借りて\\nどこまでも遠く\\n大海原に行くぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f81"
  },
  {
   "id": "b_012001:0x2f73c",
   "off": 194364,
   "max": 72,
   "kind": "dialogue",
   "jp": "そうして無人島にでも\\n流れ着いて　楽しい休暇を\\n過ごすんじゃーーー！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f82"
  },
  {
   "id": "b_012001:0x30268",
   "off": 197224,
   "max": 24,
   "kind": "dialogue",
   "jp": "ピッツァカッター……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f83"
  },
  {
   "id": "b_012001:0x30eec",
   "off": 200428,
   "max": 12,
   "kind": "dialogue",
   "jp": "うわああ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f84"
  },
  {
   "id": "b_012001:0x31380",
   "off": 201600,
   "max": 52,
   "kind": "dialogue",
   "jp": "危ないぜよ\\n当たり所が悪かったら\\n刺さったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f85"
  },
  {
   "id": "b_012001:0x31a4c",
   "off": 203340,
   "max": 48,
   "kind": "dialogue",
   "jp": "そもそもアンタの舟は\\n遭難しそうで怖いんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f86"
  },
  {
   "id": "b_012001:0x320bc",
   "off": 204988,
   "max": 44,
   "kind": "dialogue",
   "jp": "無人島からぁ\\n戻って来れなさそう\\nですぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f87"
  },
  {
   "id": "b_012001:0x32784",
   "off": 206724,
   "max": 72,
   "kind": "dialogue",
   "jp": "それに長時間も船に\\n乗っていたら……日焼けを\\nしそうだし……論外ね……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f88"
  },
  {
   "id": "b_012001:0x33090",
   "off": 209040,
   "max": 60,
   "kind": "dialogue",
   "jp": "論外とか……！\\nこんなに楽しいことが\\n一刀両断されるとは",
   "en": "",
   "op": "0x62",
   "msg": "0x2f89"
  },
  {
   "id": "b_012001:0x33784",
   "off": 210820,
   "max": 28,
   "kind": "dialogue",
   "jp": "ま　龍馬はこんなもんだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f8a"
  },
  {
   "id": "b_012001:0x33cb4",
   "off": 212148,
   "max": 44,
   "kind": "dialogue",
   "jp": "だったらシンディは\\nどんな風に過ごすんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f8b"
  },
  {
   "id": "b_012001:0x347e8",
   "off": 215016,
   "max": 40,
   "kind": "dialogue",
   "jp": "こういうのは\\n男気を見せてやるんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f8c"
  },
  {
   "id": "b_012001:0x35188",
   "off": 217480,
   "max": 12,
   "kind": "dialogue",
   "jp": "例えば？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f8d"
  },
  {
   "id": "b_012001:0x3591c",
   "off": 219420,
   "max": 68,
   "kind": "dialogue",
   "jp": "飲み食いする店で\\n女の子の分だけじゃなく\\n店の客全員分を奢るとかな",
   "en": "",
   "op": "0x62",
   "msg": "0x2f8e"
  },
  {
   "id": "b_012001:0x35a0c",
   "off": 219660,
   "max": 44,
   "kind": "dialogue",
   "jp": "懐の広いところを見せると\\n女はメロメロだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f8f"
  },
  {
   "id": "b_012001:0x36524",
   "off": 222500,
   "max": 20,
   "kind": "dialogue",
   "jp": "バターナイフ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f90"
  },
  {
   "id": "b_012001:0x37240",
   "off": 225856,
   "max": 28,
   "kind": "dialogue",
   "jp": "うわっ\\n凶器を投げるな！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f91"
  },
  {
   "id": "b_012001:0x37904",
   "off": 227588,
   "max": 44,
   "kind": "dialogue",
   "jp": "確かに……\\nお金はある方が\\nいいけど……",
   "en": "",
   "op": "0x62",
   "msg": "0x2f92"
  },
  {
   "id": "b_012001:0x37f70",
   "off": 229232,
   "max": 28,
   "kind": "dialogue",
   "jp": "金がなくても\\n色男はモテる",
   "en": "",
   "op": "0x62",
   "msg": "0x2f93"
  },
  {
   "id": "b_012001:0x38624",
   "off": 230948,
   "max": 84,
   "kind": "dialogue",
   "jp": "それにぃ　いかにもお金に\\n釣られましたぁって\\n女の子は大した子じゃ\\nないですよぉ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2f94"
  },
  {
   "id": "b_012001:0x38d1c",
   "off": 232732,
   "max": 12,
   "kind": "dialogue",
   "jp": "うう……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f95"
  },
  {
   "id": "b_012001:0x39838",
   "off": 235576,
   "max": 64,
   "kind": "dialogue",
   "jp": "晋作も撃沈ですか\\nということは満を持して\\n私の登場でしょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x2f96"
  },
  {
   "id": "b_012001:0x3a0b0",
   "off": 237744,
   "max": 64,
   "kind": "dialogue",
   "jp": "桂さんならやれる……\\nこの女達をときめかせて\\n悶えさせてやれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f97"
  },
  {
   "id": "b_012001:0x3a738",
   "off": 239416,
   "max": 20,
   "kind": "dialogue",
   "jp": "期待してま～すぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f98"
  },
  {
   "id": "b_012001:0x3aed4",
   "off": 241364,
   "max": 48,
   "kind": "dialogue",
   "jp": "そうですね　女の子と\\n二人きりになったら――",
   "en": "",
   "op": "0x62",
   "msg": "0x2f99"
  },
  {
   "id": "b_012001:0x3afb0",
   "off": 241584,
   "max": 80,
   "kind": "dialogue",
   "jp": "時間を共有するだけでなく\\n一緒に何かをすると　より\\n親密になれると思うんです",
   "en": "",
   "op": "0x62",
   "msg": "0x2f9a"
  },
  {
   "id": "b_012001:0x3b640",
   "off": 243264,
   "max": 32,
   "kind": "dialogue",
   "jp": "わたしもぉ\\nそう思いますぅ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2f9b"
  },
  {
   "id": "b_012001:0x3badc",
   "off": 244444,
   "max": 48,
   "kind": "dialogue",
   "jp": "例えば私の屋敷に招いて\\n一緒に発明品を作るとか",
   "en": "",
   "op": "0x62",
   "msg": "0x2f9c"
  },
  {
   "id": "b_012001:0x3c1ac",
   "off": 246188,
   "max": 12,
   "kind": "dialogue",
   "jp": "発明品？",
   "en": "",
   "op": "0x62",
   "msg": "0x2f9d"
  },
  {
   "id": "b_012001:0x3c63c",
   "off": 247356,
   "max": 60,
   "kind": "dialogue",
   "jp": "発明の歴史から\\n道具の使い方まで\\n丁寧に説明してあげますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2f9e"
  },
  {
   "id": "b_012001:0x3d250",
   "off": 250448,
   "max": 20,
   "kind": "dialogue",
   "jp": "小皿手裏剣……！",
   "en": "",
   "op": "0x62",
   "msg": "0x2f9f"
  },
  {
   "id": "b_012001:0x3dee0",
   "off": 253664,
   "max": 16,
   "kind": "dialogue",
   "jp": "駄目ですか",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa0"
  },
  {
   "id": "b_012001:0x3e588",
   "off": 255368,
   "max": 24,
   "kind": "dialogue",
   "jp": "お話になりませぇ～ん",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa1"
  },
  {
   "id": "b_012001:0x3ebe4",
   "off": 256996,
   "max": 64,
   "kind": "dialogue",
   "jp": "興味のない話を\\n延々とされても……\\nこっちは退屈なだけだよ…",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa2"
  },
  {
   "id": "b_012001:0x3f3b4",
   "off": 258996,
   "max": 32,
   "kind": "dialogue",
   "jp": "そうですか……\\nわかりました",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa3"
  },
  {
   "id": "b_012001:0x3fa18",
   "off": 260632,
   "max": 44,
   "kind": "dialogue",
   "jp": "桂さん\\nそんなにあっさり引いて\\nいいのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa4"
  },
  {
   "id": "b_012001:0x3fec0",
   "off": 261824,
   "max": 12,
   "kind": "dialogue",
   "jp": "いいんです",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa5"
  },
  {
   "id": "b_012001:0x3ff78",
   "off": 262008,
   "max": 80,
   "kind": "dialogue",
   "jp": "この三人の中に私の趣味を\\n理解できる人はいなかった\\nただそれだけの話ですから",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa6"
  },
  {
   "id": "b_012001:0x40668",
   "off": 263784,
   "max": 28,
   "kind": "dialogue",
   "jp": "負け惜しみ\\nですかぁ～？",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa7"
  },
  {
   "id": "b_012001:0x40b9c",
   "off": 265116,
   "max": 12,
   "kind": "dialogue",
   "jp": "違います",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa8"
  },
  {
   "id": "b_012001:0x416e4",
   "off": 268004,
   "max": 60,
   "kind": "dialogue",
   "jp": "はああ……\\nどこかにアタシ達好みの\\n男がいないものかねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2fa9"
  },
  {
   "id": "b_012001:0x42198",
   "off": 270744,
   "max": 32,
   "kind": "dialogue",
   "jp": "みんなー\\n荷物運ぶの手伝ってー",
   "en": "",
   "op": "0x62",
   "msg": "0x2faa"
  },
  {
   "id": "b_012001:0x42564",
   "off": 271716,
   "max": 120,
   "kind": "dialogue",
   "jp": "店に入ってきたのは\\n食材の入った籠を肩に\\n抱えたお登勢だった\\n       \\n重い籠を軽々と抱えた姿は\\n男らしいの一言につきた",
   "en": "",
   "op": "0x62",
   "msg": "0x2fab"
  },
  {
   "id": "b_012001:0x42be4",
   "off": 273380,
   "max": 8,
   "kind": "dialogue",
   "jp": "まっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2fac"
  },
  {
   "id": "b_012001:0x43234",
   "off": 274996,
   "max": 32,
   "kind": "dialogue",
   "jp": "わぁ～～～！\\nかっこいいですぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x2fad"
  },
  {
   "id": "b_012001:0x43768",
   "off": 276328,
   "max": 72,
   "kind": "dialogue",
   "jp": "いいねえ　いいねえ！\\nアタシはこういう男らしい\\nのを待ってたんだよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2fae"
  },
  {
   "id": "b_012001:0x43c34",
   "off": 277556,
   "max": 16,
   "kind": "dialogue",
   "jp": "な　なんなの？",
   "en": "",
   "op": "0x62",
   "msg": "0x2faf"
  },
  {
   "id": "b_012001:0x440c0",
   "off": 278720,
   "max": 16,
   "kind": "dialogue",
   "jp": "すてきですぅ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb0"
  },
  {
   "id": "b_012001:0x44938",
   "off": 280888,
   "max": 60,
   "kind": "dialogue",
   "jp": "これはもう決まりだね\\n一番男らしいのは\\nお登勢さんだよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb1"
  },
  {
   "id": "b_012001:0x44fb8",
   "off": 282552,
   "max": 16,
   "kind": "dialogue",
   "jp": "同意します……",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb2"
  },
  {
   "id": "b_012001:0x45660",
   "off": 284256,
   "max": 32,
   "kind": "dialogue",
   "jp": "わたしも～\\nそう思いまぁすぅ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb3"
  },
  {
   "id": "b_012001:0x45d20",
   "off": 285984,
   "max": 12,
   "kind": "dialogue",
   "jp": "はああ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb4"
  },
  {
   "id": "b_012001:0x46240",
   "off": 287296,
   "max": 52,
   "kind": "dialogue",
   "jp": "ちょっとぉー\\n私が色男だって？\\n失礼しちゃうわー",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb5"
  },
  {
   "id": "b_012001:0x467f0",
   "off": 288752,
   "max": 64,
   "kind": "dialogue",
   "jp": "お龍達は頬を赤らめながら\\n荷を運ぶお登勢を熱く\\n見つめている",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb6"
  },
  {
   "id": "b_012001:0x46ef4",
   "off": 290548,
   "max": 64,
   "kind": "dialogue",
   "jp": "きゃあん　お登勢さん\\n待ってくださぁい\\nお手伝いしますぅ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb7"
  },
  {
   "id": "b_012001:0x473b0",
   "off": 291760,
   "max": 48,
   "kind": "dialogue",
   "jp": "私に……\\nなんなりと……\\nお申し付け下さい……",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb8"
  },
  {
   "id": "b_012001:0x4785c",
   "off": 292956,
   "max": 68,
   "kind": "dialogue",
   "jp": "はあ……まあいいわ\\nそれなら　外にある荷物を\\n厨房に運んじゃって",
   "en": "",
   "op": "0x62",
   "msg": "0x2fb9"
  },
  {
   "id": "b_012001:0x4802c",
   "off": 294956,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああ　任せておきな",
   "en": "",
   "op": "0x62",
   "msg": "0x2fba"
  },
  {
   "id": "b_012001:0x487c4",
   "off": 296900,
   "max": 36,
   "kind": "dialogue",
   "jp": "ちょ　ちょっと！\\nお龍ちゃ～ん！",
   "en": "",
   "op": "0x62",
   "msg": "0x2fbb"
  },
  {
   "id": "b_012001:0x49134",
   "off": 299316,
   "max": 36,
   "kind": "dialogue",
   "jp": "おいおい\\nこんなのってありかよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2fbc"
  },
  {
   "id": "b_012001:0x499a8",
   "off": 301480,
   "max": 40,
   "kind": "dialogue",
   "jp": "勝負って色男について\\nだったような……",
   "en": "",
   "op": "0x62",
   "msg": "0x2fbd"
  },
  {
   "id": "b_012001:0x49e4c",
   "off": 302668,
   "max": 48,
   "kind": "dialogue",
   "jp": "確かにお登勢やんは\\n気っ風も腕力も男前じゃけど",
   "en": "",
   "op": "0x62",
   "msg": "0x2fbe"
  },
  {
   "id": "b_012001:0x4a2f8",
   "off": 303864,
   "max": 44,
   "kind": "dialogue",
   "jp": "色男という言葉は\\nどこにいったんでしょうね",
   "en": "",
   "op": "0x62",
   "msg": "0x2fbf"
  },
  {
   "id": "b_012001:0x4a990",
   "off": 305552,
   "max": 92,
   "kind": "dialogue",
   "jp": "厨房から聞こえるお龍達の\\nはしゃいだ声に龍馬達\\n三人は顔を見合わせて\\n肩を落とすのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x2fc0"
  }
 ]
}
