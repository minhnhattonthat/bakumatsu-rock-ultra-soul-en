{
 "source": "b_013001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_013001:0x10f0",
   "off": 4336,
   "max": 64,
   "kind": "dialogue",
   "jp": "それは　龍馬達五人が\\n大江戸天歌祭に向けて\\n練習に励んでいた頃",
   "en": "",
   "op": "0x62",
   "msg": "0x2a12"
  },
  {
   "id": "b_013001:0x1140",
   "off": 4416,
   "max": 72,
   "kind": "dialogue",
   "jp": "お登勢は\\n龍馬達に呼び出され\\n彼らに指定された\\n場所へと向かっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2a13"
  },
  {
   "id": "b_013001:0x18c4",
   "off": 6340,
   "max": 68,
   "kind": "dialogue",
   "jp": "んもう　龍ちゃんってば\\n話したい事があるから\\n今すぐ来てくれって",
   "en": "",
   "op": "0x62",
   "msg": "0x2a14"
  },
  {
   "id": "b_013001:0x1918",
   "off": 6424,
   "max": 56,
   "kind": "dialogue",
   "jp": "急にどういう\\nつもりなのかしら\\n全く見当もつかないわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a15"
  },
  {
   "id": "b_013001:0x1960",
   "off": 6496,
   "max": 44,
   "kind": "dialogue",
   "jp": "とにかく　\\n悪い話じゃないと\\nいいけど……",
   "en": "",
   "op": "0x62",
   "msg": "0x2a16"
  },
  {
   "id": "b_013001:0x1ffc",
   "off": 8188,
   "max": 60,
   "kind": "dialogue",
   "jp": "お登勢は\\n不安そうに呟きつつ\\n古びた扉の前で\\n足を止めた",
   "en": "",
   "op": "0x62",
   "msg": "0x2a17"
  },
  {
   "id": "b_013001:0x258c",
   "off": 9612,
   "max": 40,
   "kind": "dialogue",
   "jp": "えーと　\\n指定された場所は\\nここよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a18"
  },
  {
   "id": "b_013001:0x266c",
   "off": 9836,
   "max": 44,
   "kind": "dialogue",
   "jp": "何が何だかわからないけど\\n入ってみましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2a19"
  },
  {
   "id": "b_013001:0x3058",
   "off": 12376,
   "max": 20,
   "kind": "dialogue",
   "jp": "ごめんくださーい",
   "en": "",
   "op": "0x62",
   "msg": "0x2a1a"
  },
  {
   "id": "b_013001:0x3598",
   "off": 13720,
   "max": 36,
   "kind": "dialogue",
   "jp": "はぁい　\\nいらっしゃいませぇー♪",
   "en": "",
   "op": "0x62",
   "msg": "0x2a1b"
  },
  {
   "id": "b_013001:0x3be8",
   "off": 15336,
   "max": 44,
   "kind": "dialogue",
   "jp": "…………ん？　\\n何かしら\\n今の妙な声色は",
   "en": "",
   "op": "0x62",
   "msg": "0x2a1c"
  },
  {
   "id": "b_013001:0x3c2c",
   "off": 15404,
   "max": 40,
   "kind": "dialogue",
   "jp": "誰かの声に似ている気も\\nするけど……",
   "en": "",
   "op": "0x62",
   "msg": "0x2a1d"
  },
  {
   "id": "b_013001:0x48c8",
   "off": 18632,
   "max": 68,
   "kind": "dialogue",
   "jp": "と言うか　ここの内装って\\nうちの店に瓜二つじゃない\\nどーいう事よ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a1e"
  },
  {
   "id": "b_013001:0x4e60",
   "off": 20064,
   "max": 48,
   "kind": "dialogue",
   "jp": "お登勢は\\n周囲を見渡して\\n怪訝そうに首を傾げる",
   "en": "",
   "op": "0x62",
   "msg": "0x2a1f"
  },
  {
   "id": "b_013001:0x4ea0",
   "off": 20128,
   "max": 48,
   "kind": "dialogue",
   "jp": "その時　室内の奥から\\n見覚えのある男達が現れ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a20"
  },
  {
   "id": "b_013001:0x4ee0",
   "off": 20192,
   "max": 36,
   "kind": "dialogue",
   "jp": "体をくねらせながら\\n駆け寄って来た",
   "en": "",
   "op": "0x62",
   "msg": "0x2a21"
  },
  {
   "id": "b_013001:0x54ac",
   "off": 21676,
   "max": 56,
   "kind": "dialogue",
   "jp": "わ～っ　お登勢やん\\n早速来てくれたんだ\\n嬉しい～～っ♪",
   "en": "",
   "op": "0x62",
   "msg": "0x2a22"
  },
  {
   "id": "b_013001:0x5970",
   "off": 22896,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a23"
  },
  {
   "id": "b_013001:0x5e04",
   "off": 24068,
   "max": 44,
   "kind": "dialogue",
   "jp": "あらまあ\\n誰かと思ったら\\nお登勢さんですか",
   "en": "",
   "op": "0x62",
   "msg": "0x2a24"
  },
  {
   "id": "b_013001:0x5e44",
   "off": 24132,
   "max": 28,
   "kind": "dialogue",
   "jp": "よくいらっしゃいましたわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a25"
  },
  {
   "id": "b_013001:0x62e0",
   "off": 25312,
   "max": 12,
   "kind": "dialogue",
   "jp": "……んん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a26"
  },
  {
   "id": "b_013001:0x676c",
   "off": 26476,
   "max": 56,
   "kind": "dialogue",
   "jp": "ほら　貴女方も\\nお客様に改めて\\nご挨拶をしてくださいな",
   "en": "",
   "op": "0x62",
   "msg": "0x2a27"
  },
  {
   "id": "b_013001:0x6c2c",
   "off": 27692,
   "max": 12,
   "kind": "dialogue",
   "jp": "はぁ～～い",
   "en": "",
   "op": "0x62",
   "msg": "0x2a28"
  },
  {
   "id": "b_013001:0x6c54",
   "off": 27732,
   "max": 52,
   "kind": "dialogue",
   "jp": "可愛い可愛い女将さん　\\nボク達のお店にようこそぉ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a29"
  },
  {
   "id": "b_013001:0x7110",
   "off": 28944,
   "max": 56,
   "kind": "dialogue",
   "jp": "ふん　よく来たわね\\n私を待たせるなんて\\nいい度胸だわっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a2a"
  },
  {
   "id": "b_013001:0x75d0",
   "off": 30160,
   "max": 48,
   "kind": "dialogue",
   "jp": "……い　いらっしゃいまし\\nお待ちしておりました",
   "en": "",
   "op": "0x62",
   "msg": "0x2a2b"
  },
  {
   "id": "b_013001:0x7eb8",
   "off": 32440,
   "max": 20,
   "kind": "dialogue",
   "jp": "……んんんんんん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a2c"
  },
  {
   "id": "b_013001:0x83e0",
   "off": 33760,
   "max": 40,
   "kind": "dialogue",
   "jp": "ちょっとアンタ達\\n何のつもりなのっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a2d"
  },
  {
   "id": "b_013001:0x8418",
   "off": 33816,
   "max": 60,
   "kind": "dialogue",
   "jp": "ワケがわからないわ\\nどこからどうツッコんだら\\nいいのっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a2e"
  },
  {
   "id": "b_013001:0x8464",
   "off": 33892,
   "max": 44,
   "kind": "dialogue",
   "jp": "アタシにわかるように\\n状況を説明して頂戴！",
   "en": "",
   "op": "0x62",
   "msg": "0x2a2f"
  },
  {
   "id": "b_013001:0x8c94",
   "off": 35988,
   "max": 44,
   "kind": "dialogue",
   "jp": "え～～　だから　今\\n言ったじゃないですか",
   "en": "",
   "op": "0x62",
   "msg": "0x2a30"
  },
  {
   "id": "b_013001:0x8cd4",
   "off": 36052,
   "max": 64,
   "kind": "dialogue",
   "jp": "ボク達　雷舞活動の傍ら\\n五人でお店を開く事に\\nしたんですよぉ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2a31"
  },
  {
   "id": "b_013001:0x8d30",
   "off": 36144,
   "max": 56,
   "kind": "dialogue",
   "jp": "その名も\\n『場亜　オカマちゃん』\\n可愛いでしょ　うふっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a32"
  },
  {
   "id": "b_013001:0x91e8",
   "off": 37352,
   "max": 36,
   "kind": "dialogue",
   "jp": "ば　ばあ……\\nおかまちゃん……？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a33"
  },
  {
   "id": "b_013001:0x9694",
   "off": 38548,
   "max": 20,
   "kind": "dialogue",
   "jp": "うん　そうだよぉ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a34"
  },
  {
   "id": "b_013001:0x9b28",
   "off": 39720,
   "max": 64,
   "kind": "dialogue",
   "jp": "お登勢やんに\\nいつまでも\\nおんぶにだっこじゃ\\nいけないと思って",
   "en": "",
   "op": "0x62",
   "msg": "0x2a35"
  },
  {
   "id": "b_013001:0x9b7c",
   "off": 39804,
   "max": 36,
   "kind": "dialogue",
   "jp": "あたい　もっと\\n働こうと思ったの",
   "en": "",
   "op": "0x62",
   "msg": "0x2a36"
  },
  {
   "id": "b_013001:0x9bb4",
   "off": 39860,
   "max": 40,
   "kind": "dialogue",
   "jp": "そしたら　みんなが\\n協力してくれたのお",
   "en": "",
   "op": "0x62",
   "msg": "0x2a37"
  },
  {
   "id": "b_013001:0x9bf0",
   "off": 39920,
   "max": 60,
   "kind": "dialogue",
   "jp": "お登勢やんを\\n吃驚させようと思って\\n開店当日まで黙ってたの",
   "en": "",
   "op": "0x62",
   "msg": "0x2a38"
  },
  {
   "id": "b_013001:0x9c48",
   "off": 40008,
   "max": 36,
   "kind": "dialogue",
   "jp": "お登勢やん\\nめんごっ♪　てへへ♪",
   "en": "",
   "op": "0x62",
   "msg": "0x2a39"
  },
  {
   "id": "b_013001:0xa51c",
   "off": 42268,
   "max": 20,
   "kind": "dialogue",
   "jp": "は　はあ　なるほど",
   "en": "",
   "op": "0x62",
   "msg": "0x2a3a"
  },
  {
   "id": "b_013001:0xa540",
   "off": 42304,
   "max": 52,
   "kind": "dialogue",
   "jp": "アンタ達の様子が\\nいつもと違う理由は\\nわかったわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a3b"
  },
  {
   "id": "b_013001:0xaa88",
   "off": 43656,
   "max": 64,
   "kind": "dialogue",
   "jp": "店名から察するに\\n龍ちゃん達はオカマバーを\\n始めるつもりなのね",
   "en": "",
   "op": "0x62",
   "msg": "0x2a3c"
  },
  {
   "id": "b_013001:0xaad8",
   "off": 43736,
   "max": 72,
   "kind": "dialogue",
   "jp": "色々と疑問はあるけど\\nめでたい開店日にあれこれ\\n問い詰めるのは野暮だわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a3d"
  },
  {
   "id": "b_013001:0xab38",
   "off": 43832,
   "max": 64,
   "kind": "dialogue",
   "jp": "ここは割り切って\\nこの子達の新たな第一歩を\\n祝福しましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2a3e"
  },
  {
   "id": "b_013001:0xb08c",
   "off": 45196,
   "max": 40,
   "kind": "dialogue",
   "jp": "こほん……\\nアナタ達\\n開店おめでとう",
   "en": "",
   "op": "0x62",
   "msg": "0x2a3f"
  },
  {
   "id": "b_013001:0xbaf0",
   "off": 47856,
   "max": 64,
   "kind": "dialogue",
   "jp": "お客様に愛される\\nオカマちゃん目指して\\n一生懸命頑張りなさいな",
   "en": "",
   "op": "0x62",
   "msg": "0x2a40"
  },
  {
   "id": "b_013001:0xc4dc",
   "off": 50396,
   "max": 60,
   "kind": "dialogue",
   "jp": "はいっ　頑張りますわ\\n今日からお客様に\\n精一杯ご奉仕します",
   "en": "",
   "op": "0x62",
   "msg": "0x2a41"
  },
  {
   "id": "b_013001:0xc9ac",
   "off": 51628,
   "max": 76,
   "kind": "dialogue",
   "jp": "フン　言われなくても\\nやるからには\\n一位（ナンバーワン）\\nを目指すわよっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a42"
  },
  {
   "id": "b_013001:0xce78",
   "off": 52856,
   "max": 64,
   "kind": "dialogue",
   "jp": "まあ　目指すだけなら\\n良いんじゃないのかな\\n目指すだけならね",
   "en": "",
   "op": "0x62",
   "msg": "0x2a43"
  },
  {
   "id": "b_013001:0xd340",
   "off": 54080,
   "max": 64,
   "kind": "dialogue",
   "jp": "何よ　その言い方\\n私に喧嘩売ってるの？\\nいつでも受けて立つわよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a44"
  },
  {
   "id": "b_013001:0xd808",
   "off": 55304,
   "max": 32,
   "kind": "dialogue",
   "jp": "こらこら二人とも\\n喧嘩しないの",
   "en": "",
   "op": "0x62",
   "msg": "0x2a45"
  },
  {
   "id": "b_013001:0xd83c",
   "off": 55356,
   "max": 72,
   "kind": "dialogue",
   "jp": "開店したばかりのお店\\nなんだし　皆で力を合わせ\\n盛り立てていかないと",
   "en": "",
   "op": "0x62",
   "msg": "0x2a46"
  },
  {
   "id": "b_013001:0xd898",
   "off": 55448,
   "max": 32,
   "kind": "dialogue",
   "jp": "ねえ\\n歳子（としこ）ちゃん？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a47"
  },
  {
   "id": "b_013001:0xdd40",
   "off": 56640,
   "max": 64,
   "kind": "dialogue",
   "jp": "う　うん……\\n桂子（けいこ）ちゃんの\\n言う通り　だと思う……わ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a48"
  },
  {
   "id": "b_013001:0xdd9c",
   "off": 56732,
   "max": 60,
   "kind": "dialogue",
   "jp": "それに　\\nお客さんの見ている前で\\n喧嘩は良くないと思うの",
   "en": "",
   "op": "0x62",
   "msg": "0x2a49"
  },
  {
   "id": "b_013001:0xddf4",
   "off": 56820,
   "max": 56,
   "kind": "dialogue",
   "jp": "総美（そうみ）\\n晋子（しんこ）　\\n出来るだけ仲良くね",
   "en": "",
   "op": "0x62",
   "msg": "0x2a4a"
  },
  {
   "id": "b_013001:0xe2ac",
   "off": 58028,
   "max": 68,
   "kind": "dialogue",
   "jp": "へぇ　アナタ達　\\n源氏名で呼び合ってるのね\\nきっちりしてるじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x2a4b"
  },
  {
   "id": "b_013001:0xe770",
   "off": 59248,
   "max": 24,
   "kind": "dialogue",
   "jp": "えへへ　そうでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2a4c"
  },
  {
   "id": "b_013001:0xe7a4",
   "off": 59300,
   "max": 76,
   "kind": "dialogue",
   "jp": "ちなみに　あたいは\\nこのお店では\\n龍子（りょうこ）って\\n呼ばれてるんだ～",
   "en": "",
   "op": "0x62",
   "msg": "0x2a4d"
  },
  {
   "id": "b_013001:0xec70",
   "off": 60528,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふぅん　龍子ちゃんか\\n可愛い名前じゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x2a4e"
  },
  {
   "id": "b_013001:0xf124",
   "off": 61732,
   "max": 40,
   "kind": "dialogue",
   "jp": "でしょでしょ\\nみんなに考えてもらったの",
   "en": "",
   "op": "0x62",
   "msg": "0x2a4f"
  },
  {
   "id": "b_013001:0xf160",
   "off": 61792,
   "max": 64,
   "kind": "dialogue",
   "jp": "うふふ　みんなありがとう\\nあたい　みんなのこと\\nだぁぃっすき",
   "en": "",
   "op": "0x62",
   "msg": "0x2a50"
  },
  {
   "id": "b_013001:0xf1bc",
   "off": 61884,
   "max": 56,
   "kind": "dialogue",
   "jp": "あたい　みんなを\\n愛してる　ちゅっちゅっ\\nぎゅ～～っ♪",
   "en": "",
   "op": "0x62",
   "msg": "0x2a51"
  },
  {
   "id": "b_013001:0xf674",
   "off": 63092,
   "max": 56,
   "kind": "dialogue",
   "jp": "龍子ちゃんったら\\nはしゃぎ過ぎよ？\\nくすくす　うふふっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a52"
  },
  {
   "id": "b_013001:0xfb2c",
   "off": 64300,
   "max": 56,
   "kind": "dialogue",
   "jp": "もう　龍子ってば\\nあんまり抱きつかないで\\n暑苦しいわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a53"
  },
  {
   "id": "b_013001:0xffec",
   "off": 65516,
   "max": 64,
   "kind": "dialogue",
   "jp": "龍子先輩　\\nまた髪の毛が跳ねてますよ\\n身嗜みを整えて下さいね",
   "en": "",
   "op": "0x62",
   "msg": "0x2a54"
  },
  {
   "id": "b_013001:0x104b4",
   "off": 66740,
   "max": 60,
   "kind": "dialogue",
   "jp": "んっ　龍子の手が\\n私の腰に当たって\\nくすぐったい……ふっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a55"
  },
  {
   "id": "b_013001:0x10970",
   "off": 67952,
   "max": 68,
   "kind": "dialogue",
   "jp": "わあ　歳子ちゃんの笑顔\\nすっごく可愛いっ\\nもっとあたいに見せて？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a56"
  },
  {
   "id": "b_013001:0x109d0",
   "off": 68048,
   "max": 20,
   "kind": "dialogue",
   "jp": "こちょこちょこちょ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a57"
  },
  {
   "id": "b_013001:0x10e6c",
   "off": 69228,
   "max": 60,
   "kind": "dialogue",
   "jp": "あぁん　もうっ\\n龍子　だめだってば\\nもう少し優しくしてぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a58"
  },
  {
   "id": "b_013001:0x11330",
   "off": 70448,
   "max": 20,
   "kind": "dialogue",
   "jp": "キャッキャウフフ",
   "en": "",
   "op": "0x62",
   "msg": "0x0000"
  },
  {
   "id": "b_013001:0x119ec",
   "off": 72172,
   "max": 56,
   "kind": "dialogue",
   "jp": "テラーダに瓜二つの店内に\\n龍子達の明るい笑い声が響く",
   "en": "",
   "op": "0x62",
   "msg": "0x2a59"
  },
  {
   "id": "b_013001:0x11a34",
   "off": 72244,
   "max": 84,
   "kind": "dialogue",
   "jp": "体をくねらせながら\\nはしゃぐ龍子達を見て\\nお登勢は　いつしか\\nときめきを感じていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2a5a"
  },
  {
   "id": "b_013001:0x11ed0",
   "off": 73424,
   "max": 24,
   "kind": "dialogue",
   "jp": "……いい\\n……いいわっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a5b"
  },
  {
   "id": "b_013001:0x11f00",
   "off": 73472,
   "max": 64,
   "kind": "dialogue",
   "jp": "この店に来た時は\\nわけがわからなくて\\n驚いてばかりだったけど",
   "en": "",
   "op": "0x62",
   "msg": "0x2a5c"
  },
  {
   "id": "b_013001:0x11f50",
   "off": 73552,
   "max": 64,
   "kind": "dialogue",
   "jp": "この子達　可愛いじゃない\\n意外とそっち方面の\\n素質があったのね",
   "en": "",
   "op": "0x62",
   "msg": "0x2a5d"
  },
  {
   "id": "b_013001:0x124ac",
   "off": 74924,
   "max": 76,
   "kind": "dialogue",
   "jp": "アンタ達　この際だから\\nオカマちゃん愛獲として\\n店で雷舞をやってみたら？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a5e"
  },
  {
   "id": "b_013001:0x1297c",
   "off": 76156,
   "max": 8,
   "kind": "dialogue",
   "jp": "ふぇ？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a5f"
  },
  {
   "id": "b_013001:0x13318",
   "off": 78616,
   "max": 72,
   "kind": "dialogue",
   "jp": "だから　アンタ達の曲を\\nオカマちゃんバージョンで\\nお客に披露するのよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2a60"
  },
  {
   "id": "b_013001:0x13d14",
   "off": 81172,
   "max": 32,
   "kind": "dialogue",
   "jp": "あっ　それ良い\\nすごく面白そう",
   "en": "",
   "op": "0x62",
   "msg": "0x2a61"
  },
  {
   "id": "b_013001:0x141bc",
   "off": 82364,
   "max": 48,
   "kind": "dialogue",
   "jp": "そうねっ\\n私もそう思う\\nみんなの前で歌いたいわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a62"
  },
  {
   "id": "b_013001:0x1466c",
   "off": 83564,
   "max": 32,
   "kind": "dialogue",
   "jp": "オカマバーと\\nロックの融合……",
   "en": "",
   "op": "0x62",
   "msg": "0x2a63"
  },
  {
   "id": "b_013001:0x146a8",
   "off": 83624,
   "max": 52,
   "kind": "dialogue",
   "jp": "きゃっ　\\n考えただけで素敵っ\\n良いと思いますわ！",
   "en": "",
   "op": "0x62",
   "msg": "0x2a64"
  },
  {
   "id": "b_013001:0x14b64",
   "off": 84836,
   "max": 60,
   "kind": "dialogue",
   "jp": "その話　乗ったわ\\nこの店の客も私の歌の\\n虜にしてあげる！",
   "en": "",
   "op": "0x62",
   "msg": "0x2a65"
  },
  {
   "id": "b_013001:0x15020",
   "off": 86048,
   "max": 36,
   "kind": "dialogue",
   "jp": "あたいも　あたいも\\n歌いたーい",
   "en": "",
   "op": "0x62",
   "msg": "0x2a66"
  },
  {
   "id": "b_013001:0x158f4",
   "off": 88308,
   "max": 72,
   "kind": "dialogue",
   "jp": "ふふふ　決まったわね！\\nそれじゃあ　今夜この店で\\n雷舞をやりましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x2a67"
  },
  {
   "id": "b_013001:0x1594c",
   "off": 88396,
   "max": 36,
   "kind": "dialogue",
   "jp": "雷舞の衣装は　\\nアタシに任せなさい",
   "en": "",
   "op": "0x62",
   "msg": "0x2a68"
  },
  {
   "id": "b_013001:0x16398",
   "off": 91032,
   "max": 68,
   "kind": "dialogue",
   "jp": "ヒラッヒラのフリッフリで\\n超可愛いものを\\n用意してあげるからッッ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a69"
  },
  {
   "id": "b_013001:0x16d7c",
   "off": 93564,
   "max": 52,
   "kind": "dialogue",
   "jp": "わあっ\\nお登勢やん頼もしい\\nありがとう　大好きっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a6a"
  },
  {
   "id": "b_013001:0x17230",
   "off": 94768,
   "max": 56,
   "kind": "dialogue",
   "jp": "期待してるわよ\\n私のために最高の衣装を\\n用意して頂戴ね",
   "en": "",
   "op": "0x62",
   "msg": "0x2a6b"
  },
  {
   "id": "b_013001:0x176e8",
   "off": 95976,
   "max": 68,
   "kind": "dialogue",
   "jp": "どんな衣装でも\\nボクは完璧に着こなせるよ\\nなんたって愛獲だからね♪",
   "en": "",
   "op": "0x62",
   "msg": "0x2a6c"
  },
  {
   "id": "b_013001:0x17bb4",
   "off": 97204,
   "max": 68,
   "kind": "dialogue",
   "jp": "ヒラッヒラでフリッフリの\\n衣装……楽しみだな\\n一度着てみたかったの",
   "en": "",
   "op": "0x62",
   "msg": "0x2a6d"
  },
  {
   "id": "b_013001:0x18080",
   "off": 98432,
   "max": 52,
   "kind": "dialogue",
   "jp": "えっ　\\n歳子さん　それ本当？\\n実は私もなんですの",
   "en": "",
   "op": "0x62",
   "msg": "0x2a6e"
  },
  {
   "id": "b_013001:0x188a8",
   "off": 100520,
   "max": 60,
   "kind": "dialogue",
   "jp": "お登勢の言葉を聞き\\n龍子達五人は\\n衣装の話に花を咲かせる",
   "en": "",
   "op": "0x62",
   "msg": "0x2a6f"
  },
  {
   "id": "b_013001:0x188f4",
   "off": 100596,
   "max": 60,
   "kind": "dialogue",
   "jp": "そんな彼女達を見て\\nお登勢は満面の笑みを\\n浮かべていた……",
   "en": "",
   "op": "0x62",
   "msg": "0x2a70"
  },
  {
   "id": "b_013001:0x19034",
   "off": 102452,
   "max": 24,
   "kind": "dialogue",
   "jp": "……ん\\n……やん……",
   "en": "",
   "op": "0x62",
   "msg": "0x2a71"
  },
  {
   "id": "b_013001:0x194cc",
   "off": 103628,
   "max": 8,
   "kind": "dialogue",
   "jp": "……ん",
   "en": "",
   "op": "0x62",
   "msg": "0x2a72"
  },
  {
   "id": "b_013001:0x19ef4",
   "off": 106228,
   "max": 40,
   "kind": "dialogue",
   "jp": "おぉぉーい\\nお登勢やーん\\n起きるぜよー",
   "en": "",
   "op": "0x62",
   "msg": "0x2a73"
  },
  {
   "id": "b_013001:0x1a398",
   "off": 107416,
   "max": 12,
   "kind": "dialogue",
   "jp": "……うーん",
   "en": "",
   "op": "0x62",
   "msg": "0x2a74"
  },
  {
   "id": "b_013001:0x1a820",
   "off": 108576,
   "max": 36,
   "kind": "dialogue",
   "jp": "居眠りしてたら\\n風邪を引くぜよー",
   "en": "",
   "op": "0x62",
   "msg": "0x2a75"
  },
  {
   "id": "b_013001:0x1b038",
   "off": 110648,
   "max": 16,
   "kind": "dialogue",
   "jp": "……はっ　",
   "en": "",
   "op": "0x62",
   "msg": "0x2a76"
  },
  {
   "id": "b_013001:0x1b66c",
   "off": 112236,
   "max": 44,
   "kind": "dialogue",
   "jp": "大きな手に肩を揺すられ\\nお登勢は顔を上げた",
   "en": "",
   "op": "0x62",
   "msg": "0x2a77"
  },
  {
   "id": "b_013001:0x1b6a8",
   "off": 112296,
   "max": 68,
   "kind": "dialogue",
   "jp": "慌てて辺りを見渡すと\\nお登勢の隣には\\n見慣れた人物が\\n立っていた",
   "en": "",
   "op": "0x62",
   "msg": "0x2a78"
  },
  {
   "id": "b_013001:0x1bc6c",
   "off": 113772,
   "max": 52,
   "kind": "dialogue",
   "jp": "あ……龍子ちゃん\\nごめんなさい\\nぼーっとしてたわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a79"
  },
  {
   "id": "b_013001:0x1c2c8",
   "off": 115400,
   "max": 32,
   "kind": "dialogue",
   "jp": "龍子ちゃん？\\n誰じゃ　それは",
   "en": "",
   "op": "0x62",
   "msg": "0x2a7a"
  },
  {
   "id": "b_013001:0x1c814",
   "off": 116756,
   "max": 56,
   "kind": "dialogue",
   "jp": "誰って　\\n龍ちゃんの源氏名でしょ\\nで　ここはオカマバー",
   "en": "",
   "op": "0x62",
   "msg": "0x2a7b"
  },
  {
   "id": "b_013001:0x1cddc",
   "off": 118236,
   "max": 44,
   "kind": "dialogue",
   "jp": "むむむ？　\\nさっぱり意味が\\nわからんなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a7c"
  },
  {
   "id": "b_013001:0x1d3cc",
   "off": 119756,
   "max": 32,
   "kind": "dialogue",
   "jp": "お登勢やん\\n寝ぼけてるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a7d"
  },
  {
   "id": "b_013001:0x1d3fc",
   "off": 119804,
   "max": 64,
   "kind": "dialogue",
   "jp": "お登勢やんは\\n今の今まで　テラーダで\\n居眠りをしてたんじゃけど",
   "en": "",
   "op": "0x62",
   "msg": "0x2a7e"
  },
  {
   "id": "b_013001:0x1da90",
   "off": 121488,
   "max": 8,
   "kind": "dialogue",
   "jp": "え……",
   "en": "",
   "op": "0x62",
   "msg": "0x2a7f"
  },
  {
   "id": "b_013001:0x1e090",
   "off": 123024,
   "max": 40,
   "kind": "dialogue",
   "jp": "龍馬の話を聞き\\nお登勢は目を丸くした",
   "en": "",
   "op": "0x62",
   "msg": "0x2a80"
  },
  {
   "id": "b_013001:0x1e638",
   "off": 124472,
   "max": 52,
   "kind": "dialogue",
   "jp": "も……もしかして\\nさっきのアレは\\n夢……だったの？",
   "en": "",
   "op": "0x62",
   "msg": "0x2a81"
  },
  {
   "id": "b_013001:0x1eae8",
   "off": 125672,
   "max": 48,
   "kind": "dialogue",
   "jp": "お登勢やん寝ぼけてたのか\\nどんな夢見てたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a82"
  },
  {
   "id": "b_013001:0x1f6a8",
   "off": 128680,
   "max": 20,
   "kind": "dialogue",
   "jp": "そ　そんなぁぁぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a83"
  },
  {
   "id": "b_013001:0x1f6d4",
   "off": 128724,
   "max": 64,
   "kind": "dialogue",
   "jp": "あともう少しで\\n最高の舞台が観れたのに\\nああもう　最悪だわっ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a84"
  },
  {
   "id": "b_013001:0x20238",
   "off": 131640,
   "max": 36,
   "kind": "dialogue",
   "jp": "えーと　お登勢やん　\\n元気出すぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a85"
  },
  {
   "id": "b_013001:0x20734",
   "off": 132916,
   "max": 56,
   "kind": "dialogue",
   "jp": "無理よぉぉっ\\nあの続きを見ないと\\n元気なんかでないわ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a86"
  },
  {
   "id": "b_013001:0x211cc",
   "off": 135628,
   "max": 36,
   "kind": "dialogue",
   "jp": "決めた\\nアタシ　二度寝するッッ",
   "en": "",
   "op": "0x62",
   "msg": "0x2a87"
  },
  {
   "id": "b_013001:0x21bb4",
   "off": 138164,
   "max": 20,
   "kind": "dialogue",
   "jp": "ちょ　お登勢やん",
   "en": "",
   "op": "0x62",
   "msg": "0x2a88"
  },
  {
   "id": "b_013001:0x22068",
   "off": 139368,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬の呼び掛けに応えず\\nお登勢はぎゅっと目を閉じる",
   "en": "",
   "op": "0x62",
   "msg": "0x2a89"
  },
  {
   "id": "b_013001:0x220ac",
   "off": 139436,
   "max": 80,
   "kind": "dialogue",
   "jp": "しかし　どんなに願っても\\n場亜オカマちゃんの扉は\\n二度と開く事はなかった――",
   "en": "",
   "op": "0x62",
   "msg": "0x2a8a"
  }
 ]
}
