{
 "source": "b_014001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_014001:0x11ac",
   "off": 4524,
   "max": 40,
   "kind": "dialogue",
   "jp": "これからは\\nヒジゾーさんも\\nソウちんも",
   "en": "",
   "op": "0x62",
   "msg": "0x30fc"
  },
  {
   "id": "b_014001:0x165c",
   "off": 5724,
   "max": 32,
   "kind": "dialogue",
   "jp": "二人とも　わしらの\\n仲間ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x30fd"
  },
  {
   "id": "b_014001:0x1a38",
   "off": 6712,
   "max": 84,
   "kind": "dialogue",
   "jp": "――それは　龍馬を中心に\\n超魂の持ち主達が\\n新たなる絆で結ばれた\\nそんな夜の話……",
   "en": "",
   "op": "0x62",
   "msg": "0x30fe"
  },
  {
   "id": "b_014001:0x21cc",
   "off": 8652,
   "max": 20,
   "kind": "dialogue",
   "jp": "それにしても……",
   "en": "",
   "op": "0x62",
   "msg": "0x30ff"
  },
  {
   "id": "b_014001:0x2818",
   "off": 10264,
   "max": 20,
   "kind": "dialogue",
   "jp": "あ……また　いた",
   "en": "",
   "op": "0x62",
   "msg": "0x3100"
  },
  {
   "id": "b_014001:0x3090",
   "off": 12432,
   "max": 28,
   "kind": "dialogue",
   "jp": "この家　本当に\\nボロいね",
   "en": "",
   "op": "0x62",
   "msg": "0x3101"
  },
  {
   "id": "b_014001:0x37e4",
   "off": 14308,
   "max": 68,
   "kind": "dialogue",
   "jp": "おかげで　皆から\\n幽霊屋敷と呼ばれていて\\n誰も近寄らないんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3102"
  },
  {
   "id": "b_014001:0x3838",
   "off": 14392,
   "max": 40,
   "kind": "dialogue",
   "jp": "隠れ家としては\\n好都合なんですけどね",
   "en": "",
   "op": "0x62",
   "msg": "0x3103"
  },
  {
   "id": "b_014001:0x4200",
   "off": 16896,
   "max": 48,
   "kind": "dialogue",
   "jp": "それにしても……\\nこの虫の数は……うっ\\n凄いな",
   "en": "",
   "op": "0x62",
   "msg": "0x3104"
  },
  {
   "id": "b_014001:0x4b14",
   "off": 19220,
   "max": 36,
   "kind": "dialogue",
   "jp": "天下無双の新選組も\\n虫は苦手か？",
   "en": "",
   "op": "0x62",
   "msg": "0x3105"
  },
  {
   "id": "b_014001:0x4fb4",
   "off": 20404,
   "max": 52,
   "kind": "dialogue",
   "jp": "ダメと言うことはないが\\n刺されるのは御免被りたい",
   "en": "",
   "op": "0x62",
   "msg": "0x3106"
  },
  {
   "id": "b_014001:0x5740",
   "off": 22336,
   "max": 12,
   "kind": "dialogue",
   "jp": "むっ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x3107"
  },
  {
   "id": "b_014001:0x6168",
   "off": 24936,
   "max": 32,
   "kind": "dialogue",
   "jp": "うおっ！\\nおい　いきなり殴るな",
   "en": "",
   "op": "0x62",
   "msg": "0x3108"
  },
  {
   "id": "b_014001:0x6604",
   "off": 26116,
   "max": 44,
   "kind": "dialogue",
   "jp": "すまんすまん\\n大きな虫がいたのだ\\nつい　な",
   "en": "",
   "op": "0x62",
   "msg": "0x3109"
  },
  {
   "id": "b_014001:0x6c88",
   "off": 27784,
   "max": 16,
   "kind": "dialogue",
   "jp": "次は気をつけろ",
   "en": "",
   "op": "0x62",
   "msg": "0x310a"
  },
  {
   "id": "b_014001:0x7798",
   "off": 30616,
   "max": 24,
   "kind": "dialogue",
   "jp": "あ　こんな所にも……",
   "en": "",
   "op": "0x62",
   "msg": "0x310b"
  },
  {
   "id": "b_014001:0x7fe4",
   "off": 32740,
   "max": 12,
   "kind": "dialogue",
   "jp": "いたっ",
   "en": "",
   "op": "0x62",
   "msg": "0x310c"
  },
  {
   "id": "b_014001:0x8514",
   "off": 34068,
   "max": 20,
   "kind": "dialogue",
   "jp": "あ～あ\\n逃げられた",
   "en": "",
   "op": "0x62",
   "msg": "0x310d"
  },
  {
   "id": "b_014001:0x8b80",
   "off": 35712,
   "max": 36,
   "kind": "dialogue",
   "jp": "沖田くん……\\n今のはわざとですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x310e"
  },
  {
   "id": "b_014001:0x90a4",
   "off": 37028,
   "max": 64,
   "kind": "dialogue",
   "jp": "わざとじゃないよ～\\n本当に　いたんだよ\\n子猫くらい大きな虫が",
   "en": "",
   "op": "0x62",
   "msg": "0x310f"
  },
  {
   "id": "b_014001:0x9a00",
   "off": 39424,
   "max": 28,
   "kind": "dialogue",
   "jp": "そんなでかい虫がいるか！",
   "en": "",
   "op": "0x62",
   "msg": "0x3110"
  },
  {
   "id": "b_014001:0xa200",
   "off": 41472,
   "max": 32,
   "kind": "dialogue",
   "jp": "おい　総司の言う事を\\n疑うのか",
   "en": "",
   "op": "0x62",
   "msg": "0x3111"
  },
  {
   "id": "b_014001:0xac14",
   "off": 44052,
   "max": 32,
   "kind": "dialogue",
   "jp": "おいおい\\n仲良くしてくれって",
   "en": "",
   "op": "0x62",
   "msg": "0x3112"
  },
  {
   "id": "b_014001:0xac44",
   "off": 44100,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしらは音楽を愛する\\n仲間なんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3113"
  },
  {
   "id": "b_014001:0xb450",
   "off": 46160,
   "max": 12,
   "kind": "dialogue",
   "jp": "フン……",
   "en": "",
   "op": "0x62",
   "msg": "0x3114"
  },
  {
   "id": "b_014001:0xb974",
   "off": 47476,
   "max": 56,
   "kind": "dialogue",
   "jp": "頭では分かっているんだが\\nどうも……\\nまだ馴れなくてな",
   "en": "",
   "op": "0x62",
   "msg": "0x3115"
  },
  {
   "id": "b_014001:0xc350",
   "off": 50000,
   "max": 56,
   "kind": "dialogue",
   "jp": "だよね～\\nついつい　ちょっかい\\n出したくなるっていうか",
   "en": "",
   "op": "0x62",
   "msg": "0x3116"
  },
  {
   "id": "b_014001:0xccb4",
   "off": 52404,
   "max": 44,
   "kind": "dialogue",
   "jp": "沖田\\nお前が一番の問題なんじゃ\\nないのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x3117"
  },
  {
   "id": "b_014001:0xd3bc",
   "off": 54204,
   "max": 20,
   "kind": "dialogue",
   "jp": "あ　また　いた！",
   "en": "",
   "op": "0x62",
   "msg": "0x3118"
  },
  {
   "id": "b_014001:0xdc18",
   "off": 56344,
   "max": 56,
   "kind": "dialogue",
   "jp": "……ったぁぁ\\nやっぱり　わざとじゃ\\nねぇかぁぁぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x3119"
  },
  {
   "id": "b_014001:0xe3dc",
   "off": 58332,
   "max": 16,
   "kind": "dialogue",
   "jp": "やれやれ……",
   "en": "",
   "op": "0x62",
   "msg": "0x311a"
  },
  {
   "id": "b_014001:0xe3fc",
   "off": 58364,
   "max": 56,
   "kind": "dialogue",
   "jp": "ケンカするほど\\n仲が良いとは言うが\\nこりゃ困ったなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x311b"
  },
  {
   "id": "b_014001:0xec48",
   "off": 60488,
   "max": 48,
   "kind": "dialogue",
   "jp": "一人はみんなのために\\nみんなは一人のために！",
   "en": "",
   "op": "0x62",
   "msg": "0x311c"
  },
  {
   "id": "b_014001:0xf3fc",
   "off": 62460,
   "max": 72,
   "kind": "dialogue",
   "jp": "力を合わせなければ\\n時代に新しい風を吹かせる\\nことなんてできないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x311d"
  },
  {
   "id": "b_014001:0xfd98",
   "off": 64920,
   "max": 40,
   "kind": "dialogue",
   "jp": "龍馬君が珍しく\\nいいこと言っていますね",
   "en": "",
   "op": "0x62",
   "msg": "0x311e"
  },
  {
   "id": "b_014001:0x10508",
   "off": 66824,
   "max": 52,
   "kind": "dialogue",
   "jp": "うん　すごいすごい\\nただのバカじゃ\\nなかったんだね",
   "en": "",
   "op": "0x62",
   "msg": "0x311f"
  },
  {
   "id": "b_014001:0x10d28",
   "off": 68904,
   "max": 60,
   "kind": "dialogue",
   "jp": "おい　コイツのことを\\nバカと言っていいのは\\nオレ様だけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3120"
  },
  {
   "id": "b_014001:0x11488",
   "off": 70792,
   "max": 28,
   "kind": "dialogue",
   "jp": "……ああもう\\n止めてくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x3121"
  },
  {
   "id": "b_014001:0x114b4",
   "off": 70836,
   "max": 52,
   "kind": "dialogue",
   "jp": "これから　みんなで\\n仲良く楽しく\\nロックが出来ると",
   "en": "",
   "op": "0x62",
   "msg": "0x3122"
  },
  {
   "id": "b_014001:0x11500",
   "off": 70912,
   "max": 64,
   "kind": "dialogue",
   "jp": "楽しみだったのに\\nわしはもう……腹が痛い\\nなんか泣けてきた……",
   "en": "",
   "op": "0x62",
   "msg": "0x3123"
  },
  {
   "id": "b_014001:0x11bec",
   "off": 72684,
   "max": 56,
   "kind": "dialogue",
   "jp": "すまん　坂本\\n皆　お前の気持ちは\\n分かっているつもりだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3124"
  },
  {
   "id": "b_014001:0x12490",
   "off": 74896,
   "max": 56,
   "kind": "dialogue",
   "jp": "オレ様だってそうだぞ\\n一応　努力はしようと\\nしてるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3125"
  },
  {
   "id": "b_014001:0x12de8",
   "off": 77288,
   "max": 28,
   "kind": "dialogue",
   "jp": "ヒジゾーさん\\nシンディ……",
   "en": "",
   "op": "0x62",
   "msg": "0x3126"
  },
  {
   "id": "b_014001:0x139e0",
   "off": 80352,
   "max": 40,
   "kind": "dialogue",
   "jp": "今のは　トサカくんの\\nお腹の虫の音？",
   "en": "",
   "op": "0x62",
   "msg": "0x3127"
  },
  {
   "id": "b_014001:0x140e8",
   "off": 82152,
   "max": 40,
   "kind": "dialogue",
   "jp": "わわっ……\\n違うぜよ！\\n違うぜよっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x3128"
  },
  {
   "id": "b_014001:0x148ec",
   "off": 84204,
   "max": 40,
   "kind": "dialogue",
   "jp": "せっかく　慰めて\\nやろうと思ったのに",
   "en": "",
   "op": "0x62",
   "msg": "0x3129"
  },
  {
   "id": "b_014001:0x15018",
   "off": 86040,
   "max": 32,
   "kind": "dialogue",
   "jp": "腹が減ってるだけ\\nじゃねえか！",
   "en": "",
   "op": "0x62",
   "msg": "0x312a"
  },
  {
   "id": "b_014001:0x15784",
   "off": 87940,
   "max": 52,
   "kind": "dialogue",
   "jp": "泣くほど　お腹が\\nすいていれば\\n胃も痛くなりますね",
   "en": "",
   "op": "0x62",
   "msg": "0x312b"
  },
  {
   "id": "b_014001:0x15f9c",
   "off": 90012,
   "max": 64,
   "kind": "dialogue",
   "jp": "こんな奴についてきて\\n本当に大丈夫だったのか？\\n俺は頭が痛い",
   "en": "",
   "op": "0x62",
   "msg": "0x312c"
  },
  {
   "id": "b_014001:0x167f8",
   "off": 92152,
   "max": 56,
   "kind": "dialogue",
   "jp": "し　仕方ないぜよ\\nずっと　何も食って\\nなかったんだし",
   "en": "",
   "op": "0x62",
   "msg": "0x312d"
  },
  {
   "id": "b_014001:0x16ed4",
   "off": 93908,
   "max": 68,
   "kind": "dialogue",
   "jp": "そういえば夕飯時ですね\\nどうりで　みんな\\nイライラしてるはずです",
   "en": "",
   "op": "0x62",
   "msg": "0x312e"
  },
  {
   "id": "b_014001:0x16f28",
   "off": 93992,
   "max": 44,
   "kind": "dialogue",
   "jp": "細かいことは明日にして\\n食事にしましょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x312f"
  },
  {
   "id": "b_014001:0x1759c",
   "off": 95644,
   "max": 52,
   "kind": "dialogue",
   "jp": "とは言っても\\n幕府が僕達のことを\\n捜し回ってるし",
   "en": "",
   "op": "0x62",
   "msg": "0x3130"
  },
  {
   "id": "b_014001:0x175e0",
   "off": 95712,
   "max": 68,
   "kind": "dialogue",
   "jp": "テラーダに行くにしても\\n今日ぐらいは　大人しく\\nしといた方がいいよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3131"
  },
  {
   "id": "b_014001:0x17c50",
   "off": 97360,
   "max": 48,
   "kind": "dialogue",
   "jp": "そこは大丈夫ですよ\\n晋作　用意をお願いします",
   "en": "",
   "op": "0x62",
   "msg": "0x3132"
  },
  {
   "id": "b_014001:0x184b0",
   "off": 99504,
   "max": 48,
   "kind": "dialogue",
   "jp": "わかった\\n人数も増えたし\\n有り物だが我慢しろよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3133"
  },
  {
   "id": "b_014001:0x18d8c",
   "off": 101772,
   "max": 32,
   "kind": "dialogue",
   "jp": "なっ……高杉\\nお前が作るのか",
   "en": "",
   "op": "0x62",
   "msg": "0x3134"
  },
  {
   "id": "b_014001:0x19568",
   "off": 103784,
   "max": 72,
   "kind": "dialogue",
   "jp": "こう見えてシンディは\\n料理は勿論　家事全般が\\n得意ぜよ！　えっへん！",
   "en": "",
   "op": "0x62",
   "msg": "0x3135"
  },
  {
   "id": "b_014001:0x19eb8",
   "off": 106168,
   "max": 60,
   "kind": "dialogue",
   "jp": "晋作が腹の虫の妙薬を\\n作ってる間に\\n虫取りでも炊きますか",
   "en": "",
   "op": "0x62",
   "msg": "0x3136"
  },
  {
   "id": "b_014001:0x1a898",
   "off": 108696,
   "max": 36,
   "kind": "dialogue",
   "jp": "ふ～　食った食った\\nごちそうさま！",
   "en": "",
   "op": "0x62",
   "msg": "0x3137"
  },
  {
   "id": "b_014001:0x1afb8",
   "off": 110520,
   "max": 68,
   "kind": "dialogue",
   "jp": "私もごちそうさまです\\nどうですか　龍馬くん\\n涙は止まりましたか？",
   "en": "",
   "op": "0x62",
   "msg": "0x3138"
  },
  {
   "id": "b_014001:0x1b478",
   "off": 111736,
   "max": 36,
   "kind": "dialogue",
   "jp": "おう　腹の虫も\\n大人しくなったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3139"
  },
  {
   "id": "b_014001:0x1bd3c",
   "off": 113980,
   "max": 52,
   "kind": "dialogue",
   "jp": "それは良かったね\\nスカシくん\\n僕もごちそうさま～",
   "en": "",
   "op": "0x62",
   "msg": "0x313a"
  },
  {
   "id": "b_014001:0x1c600",
   "off": 116224,
   "max": 56,
   "kind": "dialogue",
   "jp": "その呼び名は止めろ！\\n……ったく\\n五杯も食いやがって",
   "en": "",
   "op": "0x62",
   "msg": "0x313b"
  },
  {
   "id": "b_014001:0x1cd60",
   "off": 118112,
   "max": 40,
   "kind": "dialogue",
   "jp": "俺も……\\nご　ごちそう……\\nさま……だ",
   "en": "",
   "op": "0x62",
   "msg": "0x313c"
  },
  {
   "id": "b_014001:0x1d2a0",
   "off": 119456,
   "max": 44,
   "kind": "dialogue",
   "jp": "お……お……おう\\nお粗末じゃないさま……だ",
   "en": "",
   "op": "0x62",
   "msg": "0x313d"
  },
  {
   "id": "b_014001:0x1da64",
   "off": 121444,
   "max": 44,
   "kind": "dialogue",
   "jp": "あはは　土方さん\\nまだ　人見知りしてる～",
   "en": "",
   "op": "0x62",
   "msg": "0x313e"
  },
  {
   "id": "b_014001:0x1e138",
   "off": 123192,
   "max": 16,
   "kind": "dialogue",
   "jp": "こら　総司！",
   "en": "",
   "op": "0x62",
   "msg": "0x313f"
  },
  {
   "id": "b_014001:0x1e770",
   "off": 124784,
   "max": 48,
   "kind": "dialogue",
   "jp": "だって　土方さん\\nずっと無言で\\nご飯食べてるし",
   "en": "",
   "op": "0x62",
   "msg": "0x3140"
  },
  {
   "id": "b_014001:0x1eccc",
   "off": 126156,
   "max": 60,
   "kind": "dialogue",
   "jp": "お前は馴染み過ぎなんだ\\nそう簡単に切り替えなど\\n出来るか",
   "en": "",
   "op": "0x62",
   "msg": "0x3141"
  },
  {
   "id": "b_014001:0x1f4bc",
   "off": 128188,
   "max": 44,
   "kind": "dialogue",
   "jp": "人見知り？\\n何度も顔を合わせてる\\nのにか？",
   "en": "",
   "op": "0x62",
   "msg": "0x3142"
  },
  {
   "id": "b_014001:0x1faac",
   "off": 129708,
   "max": 68,
   "kind": "dialogue",
   "jp": "昨日の敵は今日の仲間！\\nとか言い切っちゃえる\\n単純な誰かとは違うよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3143"
  },
  {
   "id": "b_014001:0x20080",
   "off": 131200,
   "max": 44,
   "kind": "dialogue",
   "jp": "わしは二人とも\\n敵だとは思ってなかったぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x3144"
  },
  {
   "id": "b_014001:0x20670",
   "off": 132720,
   "max": 52,
   "kind": "dialogue",
   "jp": "いつか仲間になれたら\\n嬉しいと　ずっと\\n思ってた",
   "en": "",
   "op": "0x62",
   "msg": "0x3145"
  },
  {
   "id": "b_014001:0x20d70",
   "off": 134512,
   "max": 48,
   "kind": "dialogue",
   "jp": "嬉しい～\\nトサカくんの\\nそういうとこ大好き～",
   "en": "",
   "op": "0x62",
   "msg": "0x3146"
  },
  {
   "id": "b_014001:0x2156c",
   "off": 136556,
   "max": 36,
   "kind": "dialogue",
   "jp": "こ　こら……ソウちん\\n抱きつくな！",
   "en": "",
   "op": "0x62",
   "msg": "0x3147"
  },
  {
   "id": "b_014001:0x21e60",
   "off": 138848,
   "max": 48,
   "kind": "dialogue",
   "jp": "おい　沖田\\nあんまり龍馬に\\n馴れ馴れしくするな",
   "en": "",
   "op": "0x62",
   "msg": "0x3148"
  },
  {
   "id": "b_014001:0x227c4",
   "off": 141252,
   "max": 32,
   "kind": "dialogue",
   "jp": "あれ？　もしかして\\n嫉妬とか？",
   "en": "",
   "op": "0x62",
   "msg": "0x3149"
  },
  {
   "id": "b_014001:0x23184",
   "off": 143748,
   "max": 28,
   "kind": "dialogue",
   "jp": "ふん！\\nなんでオレ様が",
   "en": "",
   "op": "0x62",
   "msg": "0x314a"
  },
  {
   "id": "b_014001:0x237ec",
   "off": 145388,
   "max": 64,
   "kind": "dialogue",
   "jp": "はいはい　お腹も一杯に\\nなったことだし\\nケンカは止めてください",
   "en": "",
   "op": "0x62",
   "msg": "0x314b"
  },
  {
   "id": "b_014001:0x23e7c",
   "off": 147068,
   "max": 36,
   "kind": "dialogue",
   "jp": "……ちっ\\nコイツは新選組なんだぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x314c"
  },
  {
   "id": "b_014001:0x243a0",
   "off": 148384,
   "max": 52,
   "kind": "dialogue",
   "jp": "晋作　憎い敵ほど\\n味方になると\\n心強いものですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x314d"
  },
  {
   "id": "b_014001:0x24850",
   "off": 149584,
   "max": 52,
   "kind": "dialogue",
   "jp": "桂さんに言われるまでもない\\nそれくらいは分かってる",
   "en": "",
   "op": "0x62",
   "msg": "0x314e"
  },
  {
   "id": "b_014001:0x24df8",
   "off": 151032,
   "max": 48,
   "kind": "dialogue",
   "jp": "だが　オレ様は\\nコイツのことが\\n気に食わねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x314f"
  },
  {
   "id": "b_014001:0x25348",
   "off": 152392,
   "max": 48,
   "kind": "dialogue",
   "jp": "同じ目的を持つもの同士\\n仲良くしていきましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x3150"
  },
  {
   "id": "b_014001:0x25c08",
   "off": 154632,
   "max": 32,
   "kind": "dialogue",
   "jp": "そうそう\\n過去は水に流そうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3151"
  },
  {
   "id": "b_014001:0x25c40",
   "off": 154688,
   "max": 68,
   "kind": "dialogue",
   "jp": "今日からは心機一転\\n新選組とトサカくんの\\n愉快な仲間達ってことで",
   "en": "",
   "op": "0x62",
   "msg": "0x3152"
  },
  {
   "id": "b_014001:0x2648c",
   "off": 156812,
   "max": 24,
   "kind": "dialogue",
   "jp": "おい　ちょっと待て！",
   "en": "",
   "op": "0x62",
   "msg": "0x3153"
  },
  {
   "id": "b_014001:0x26668",
   "off": 157288,
   "max": 60,
   "kind": "dialogue",
   "jp": "何でオレ様達が\\n龍馬のついでみたいな\\n扱いになってんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x3154"
  },
  {
   "id": "b_014001:0x26efc",
   "off": 159484,
   "max": 68,
   "kind": "dialogue",
   "jp": "ん？　違ったのか？\\n近藤さんが　そう呼んで\\nいたからてっきり……",
   "en": "",
   "op": "0x62",
   "msg": "0x3155"
  },
  {
   "id": "b_014001:0x2769c",
   "off": 161436,
   "max": 56,
   "kind": "dialogue",
   "jp": "オレ様たちはそんな\\n隊名じゃねぇ\\n断固として違う",
   "en": "",
   "op": "0x62",
   "msg": "0x3156"
  },
  {
   "id": "b_014001:0x27c70",
   "off": 162928,
   "max": 76,
   "kind": "dialogue",
   "jp": "元々はオレ様と桂さんの\\n二人でやっていたところに\\n後からコイツが入ったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3157"
  },
  {
   "id": "b_014001:0x28470",
   "off": 164976,
   "max": 36,
   "kind": "dialogue",
   "jp": "じゃ　元々は\\nなんて隊名だったの？",
   "en": "",
   "op": "0x62",
   "msg": "0x3158"
  },
  {
   "id": "b_014001:0x289c0",
   "off": 166336,
   "max": 12,
   "kind": "dialogue",
   "jp": "隊名……",
   "en": "",
   "op": "0x62",
   "msg": "0x3159"
  },
  {
   "id": "b_014001:0x2947c",
   "off": 169084,
   "max": 28,
   "kind": "dialogue",
   "jp": "あ　あれだ　な？\\n桂さん",
   "en": "",
   "op": "0x62",
   "msg": "0x315a"
  },
  {
   "id": "b_014001:0x29b64",
   "off": 170852,
   "max": 32,
   "kind": "dialogue",
   "jp": "え　ええ……\\nあれですね　晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x315b"
  },
  {
   "id": "b_014001:0x2a324",
   "off": 172836,
   "max": 48,
   "kind": "dialogue",
   "jp": "その話　わしも\\n初めて聞くぜよ\\nわくわく……",
   "en": "",
   "op": "0x62",
   "msg": "0x315c"
  },
  {
   "id": "b_014001:0x2a374",
   "off": 172916,
   "max": 28,
   "kind": "dialogue",
   "jp": "なんて名だ？\\nどきどき……",
   "en": "",
   "op": "0x62",
   "msg": "0x315d"
  },
  {
   "id": "b_014001:0x2acac",
   "off": 175276,
   "max": 24,
   "kind": "dialogue",
   "jp": "オレ様と桂さん……？",
   "en": "",
   "op": "0x62",
   "msg": "0x315e"
  },
  {
   "id": "b_014001:0x2b8c0",
   "off": 178368,
   "max": 28,
   "kind": "dialogue",
   "jp": "よく言えば\\n分かりやすいな",
   "en": "",
   "op": "0x62",
   "msg": "0x315f"
  },
  {
   "id": "b_014001:0x2bff4",
   "off": 180212,
   "max": 20,
   "kind": "dialogue",
   "jp": "場末の流しみたい",
   "en": "",
   "op": "0x62",
   "msg": "0x3160"
  },
  {
   "id": "b_014001:0x2ccf8",
   "off": 183544,
   "max": 40,
   "kind": "dialogue",
   "jp": "ち　違います\\nこう……何といいますか",
   "en": "",
   "op": "0x62",
   "msg": "0x3161"
  },
  {
   "id": "b_014001:0x2ce80",
   "off": 183936,
   "max": 60,
   "kind": "dialogue",
   "jp": "突風雷舞は　私達の名を\\n広めることが目的では\\nないんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3162"
  },
  {
   "id": "b_014001:0x2cecc",
   "off": 184012,
   "max": 40,
   "kind": "dialogue",
   "jp": "ロックを広めることが\\n主な目的なんです",
   "en": "",
   "op": "0x62",
   "msg": "0x3163"
  },
  {
   "id": "b_014001:0x2cf04",
   "off": 184068,
   "max": 32,
   "kind": "dialogue",
   "jp": "だから　名乗る必要が\\n無かった",
   "en": "",
   "op": "0x62",
   "msg": "0x3164"
  },
  {
   "id": "b_014001:0x2d770",
   "off": 186224,
   "max": 60,
   "kind": "dialogue",
   "jp": "そ　それにだ\\n龍馬が入ってからは\\n色々と忙しかったし……",
   "en": "",
   "op": "0x62",
   "msg": "0x3165"
  },
  {
   "id": "b_014001:0x2df3c",
   "off": 188220,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前達　もしかして\\n隊名がないのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x3166"
  },
  {
   "id": "b_014001:0x2e608",
   "off": 189960,
   "max": 44,
   "kind": "dialogue",
   "jp": "はあ\\n考えたことも\\nなかったというか……",
   "en": "",
   "op": "0x62",
   "msg": "0x3167"
  },
  {
   "id": "b_014001:0x2ede0",
   "off": 191968,
   "max": 40,
   "kind": "dialogue",
   "jp": "僕がカッコイイのを\\nつけてあげようか？",
   "en": "",
   "op": "0x62",
   "msg": "0x3168"
  },
  {
   "id": "b_014001:0x2f75c",
   "off": 194396,
   "max": 60,
   "kind": "dialogue",
   "jp": "ちょ　ちょっと待て\\n今さら　隊名なんて\\n言われてもよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x3169"
  },
  {
   "id": "b_014001:0x2ff7c",
   "off": 196476,
   "max": 68,
   "kind": "dialogue",
   "jp": "やれやれ\\n隊名もないような連中に\\n我々は手を焼かされて\\nいたのか",
   "en": "",
   "op": "0x62",
   "msg": "0x316a"
  },
  {
   "id": "b_014001:0x309a8",
   "off": 199080,
   "max": 76,
   "kind": "dialogue",
   "jp": "そうだ　隊名ぜよ！\\nそれが決まれば　わしらの\\n心も一つにまとまるはずじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x316b"
  },
  {
   "id": "b_014001:0x311b8",
   "off": 201144,
   "max": 60,
   "kind": "dialogue",
   "jp": "今まで無かったのなら\\nこれからつければ\\nいいだけの話ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x316c"
  },
  {
   "id": "b_014001:0x31204",
   "off": 201220,
   "max": 48,
   "kind": "dialogue",
   "jp": "ヒジゾーさんとソウちんも\\n仲間になったことだし",
   "en": "",
   "op": "0x62",
   "msg": "0x316d"
  },
  {
   "id": "b_014001:0x31358",
   "off": 201560,
   "max": 44,
   "kind": "dialogue",
   "jp": "これから　みんなで\\n新しい隊名を考えるぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x316e"
  },
  {
   "id": "b_014001:0x31c08",
   "off": 203784,
   "max": 56,
   "kind": "dialogue",
   "jp": "坂本はどこまで\\n能天気なんだ？\\n俺たちは追われる身……",
   "en": "",
   "op": "0x62",
   "msg": "0x316f"
  },
  {
   "id": "b_014001:0x31c58",
   "off": 203864,
   "max": 32,
   "kind": "dialogue",
   "jp": "もっと考えることが\\nあるだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x3170"
  },
  {
   "id": "b_014001:0x32340",
   "off": 205632,
   "max": 72,
   "kind": "dialogue",
   "jp": "そうでしょうか？\\nただ　こうやっているより\\n余程前向きだと思いますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3171"
  },
  {
   "id": "b_014001:0x32398",
   "off": 205720,
   "max": 64,
   "kind": "dialogue",
   "jp": "話し合いをすれば\\n互いの考えている事を\\n知ることができますしね",
   "en": "",
   "op": "0x62",
   "msg": "0x3172"
  },
  {
   "id": "b_014001:0x32b60",
   "off": 207712,
   "max": 56,
   "kind": "dialogue",
   "jp": "まあ　角を突き合わせて\\nケンカをするよりは\\nマシだな",
   "en": "",
   "op": "0x62",
   "msg": "0x3173"
  },
  {
   "id": "b_014001:0x3334c",
   "off": 209740,
   "max": 32,
   "kind": "dialogue",
   "jp": "は～い\\n僕もメガネくんに賛成",
   "en": "",
   "op": "0x62",
   "msg": "0x3174"
  },
  {
   "id": "b_014001:0x33c64",
   "off": 212068,
   "max": 16,
   "kind": "dialogue",
   "jp": "おい\\n総司まで",
   "en": "",
   "op": "0x62",
   "msg": "0x3175"
  },
  {
   "id": "b_014001:0x342bc",
   "off": 213692,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方さん　\\nどうせ僕ら　すぐには\\n新選組に戻れないんです",
   "en": "",
   "op": "0x62",
   "msg": "0x3176"
  },
  {
   "id": "b_014001:0x34308",
   "off": 213768,
   "max": 44,
   "kind": "dialogue",
   "jp": "今は頭を切り換えて\\n肩の力を抜きましょうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x3177"
  },
  {
   "id": "b_014001:0x347b0",
   "off": 214960,
   "max": 16,
   "kind": "dialogue",
   "jp": "そうは言うがな",
   "en": "",
   "op": "0x62",
   "msg": "0x3178"
  },
  {
   "id": "b_014001:0x347d0",
   "off": 214992,
   "max": 48,
   "kind": "dialogue",
   "jp": "言われてすぐに\\nはい　そうですか\\nとは言えない",
   "en": "",
   "op": "0x62",
   "msg": "0x3179"
  },
  {
   "id": "b_014001:0x35098",
   "off": 217240,
   "max": 60,
   "kind": "dialogue",
   "jp": "だからですよ\\nこれからは　彼らと\\n一緒にやっていくんです",
   "en": "",
   "op": "0x62",
   "msg": "0x317a"
  },
  {
   "id": "b_014001:0x3518c",
   "off": 217484,
   "max": 56,
   "kind": "dialogue",
   "jp": "それなのに\\nずっと気を張ってちゃ\\n疲れちゃいますよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x317b"
  },
  {
   "id": "b_014001:0x359a8",
   "off": 219560,
   "max": 12,
   "kind": "dialogue",
   "jp": "総司……",
   "en": "",
   "op": "0x62",
   "msg": "0x317c"
  },
  {
   "id": "b_014001:0x35fd4",
   "off": 221140,
   "max": 40,
   "kind": "dialogue",
   "jp": "な～んて　僕達の\\n新しい隊名ですよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x317d"
  },
  {
   "id": "b_014001:0x360b4",
   "off": 221364,
   "max": 64,
   "kind": "dialogue",
   "jp": "ちゃんと考えないで\\n変なのに決まったら\\n困るじゃないですか～",
   "en": "",
   "op": "0x62",
   "msg": "0x317e"
  },
  {
   "id": "b_014001:0x3660c",
   "off": 222732,
   "max": 20,
   "kind": "dialogue",
   "jp": "それもそうだな……",
   "en": "",
   "op": "0x62",
   "msg": "0x317f"
  },
  {
   "id": "b_014001:0x36eec",
   "off": 225004,
   "max": 52,
   "kind": "dialogue",
   "jp": "晋作\\nお茶を淹れてください\\nあと　美味しいお菓子も",
   "en": "",
   "op": "0x62",
   "msg": "0x3180"
  },
  {
   "id": "b_014001:0x3739c",
   "off": 226204,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああ……わかった",
   "en": "",
   "op": "0x62",
   "msg": "0x3181"
  },
  {
   "id": "b_014001:0x37b34",
   "off": 228148,
   "max": 36,
   "kind": "dialogue",
   "jp": "あ　わしは茶よりも\\n酒がいいなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x3182"
  },
  {
   "id": "b_014001:0x38610",
   "off": 230928,
   "max": 52,
   "kind": "dialogue",
   "jp": "酒盛りをしようってんじゃ\\nねえんだ！　自重しろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x3183"
  },
  {
   "id": "b_014001:0x38c34",
   "off": 232500,
   "max": 76,
   "kind": "dialogue",
   "jp": "こうして　龍馬達は\\n自分たちの隊名を\\n考える話し合いを\\nすることになった",
   "en": "",
   "op": "0x62",
   "msg": "0x3184"
  },
  {
   "id": "b_014001:0x391fc",
   "off": 233980,
   "max": 40,
   "kind": "dialogue",
   "jp": "よーし\\nロックな名前を\\nつけるぜよっ",
   "en": "",
   "op": "0x62",
   "msg": "0x3185"
  },
  {
   "id": "b_014001:0x398b8",
   "off": 235704,
   "max": 80,
   "kind": "dialogue",
   "jp": "しかし　それが\\n新たなる火種を\\n生むことになるとは\\n誰も予想を\\nしていなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x3186"
  },
  {
   "id": "b_014001:0x39918",
   "off": 235800,
   "max": 100,
   "kind": "dialogue",
   "jp": "そう……\\n今まさに　このあばら屋で\\n各々のプライドをかけた\\n新たなる抗争が\\n勃発しようとしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x3187"
  },
  {
   "id": "b_014001:0x3a4d8",
   "off": 238808,
   "max": 8,
   "kind": "dialogue",
   "jp": "却下",
   "en": "",
   "op": "0x62",
   "msg": "0x3188"
  },
  {
   "id": "b_014001:0x3b220",
   "off": 242208,
   "max": 60,
   "kind": "dialogue",
   "jp": "なんでだ？\\n「高杉晋作と\\nバックバンド達」\\nで決まりだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x3189"
  },
  {
   "id": "b_014001:0x3b9e8",
   "off": 244200,
   "max": 40,
   "kind": "dialogue",
   "jp": "晋作　これは\\nみんなの隊名なんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x318a"
  },
  {
   "id": "b_014001:0x3ba28",
   "off": 244264,
   "max": 36,
   "kind": "dialogue",
   "jp": "自分だけ目立って\\nどうするんですか",
   "en": "",
   "op": "0x62",
   "msg": "0x318b"
  },
  {
   "id": "b_014001:0x3c298",
   "off": 246424,
   "max": 48,
   "kind": "dialogue",
   "jp": "何？\\n「高杉と」って\\nどれだけ自分大好きなのさ",
   "en": "",
   "op": "0x62",
   "msg": "0x318c"
  },
  {
   "id": "b_014001:0x3c954",
   "off": 248148,
   "max": 60,
   "kind": "dialogue",
   "jp": "自分大好きで何が悪い！\\n龍馬なんか\\nもっとひどいじゃねえか",
   "en": "",
   "op": "0x62",
   "msg": "0x318d"
  },
  {
   "id": "b_014001:0x3d56c",
   "off": 251244,
   "max": 64,
   "kind": "dialogue",
   "jp": "聞いた人間が　幸せな\\n気分になれるように\\n「Ｒ安堵Ｒ」ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x318e"
  },
  {
   "id": "b_014001:0x3e060",
   "off": 254048,
   "max": 32,
   "kind": "dialogue",
   "jp": "そのＲとＲは\\nどこから来たの？",
   "en": "",
   "op": "0x62",
   "msg": "0x318f"
  },
  {
   "id": "b_014001:0x3e580",
   "off": 255360,
   "max": 56,
   "kind": "dialogue",
   "jp": "英語じゃ！\\n龍馬のＲとロックのＲ！\\nだから　ＲとＲ！",
   "en": "",
   "op": "0x62",
   "msg": "0x3190"
  },
  {
   "id": "b_014001:0x3ed40",
   "off": 257344,
   "max": 16,
   "kind": "dialogue",
   "jp": "……話にならん",
   "en": "",
   "op": "0x62",
   "msg": "0x3191"
  },
  {
   "id": "b_014001:0x3f52c",
   "off": 259372,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬くん\\nもっと　真面目に\\n考えて下さい",
   "en": "",
   "op": "0x62",
   "msg": "0x3192"
  },
  {
   "id": "b_014001:0x3fdb8",
   "off": 261560,
   "max": 72,
   "kind": "dialogue",
   "jp": "幕府の名付けセンスを\\n少しは見習ったらどうなのさ\\n天歌に鳳舞合奏だよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x3193"
  },
  {
   "id": "b_014001:0x3fe10",
   "off": 261648,
   "max": 76,
   "kind": "dialogue",
   "jp": "それに負けないような\\n印象的でカッコイイ名前を\\nつけなきゃ負けちゃうよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x3194"
  },
  {
   "id": "b_014001:0x404b4",
   "off": 263348,
   "max": 32,
   "kind": "dialogue",
   "jp": "そこまではどうかと\\n思うが……",
   "en": "",
   "op": "0x62",
   "msg": "0x3195"
  },
  {
   "id": "b_014001:0x40a70",
   "off": 264816,
   "max": 64,
   "kind": "dialogue",
   "jp": "名は体を表すと言うだろう\\n我々にふさわしい名前を\\nつけるべきだ",
   "en": "",
   "op": "0x62",
   "msg": "0x3196"
  },
  {
   "id": "b_014001:0x4137c",
   "off": 267132,
   "max": 56,
   "kind": "dialogue",
   "jp": "一度聞いたら新しく\\nしかし　馴染みやすく\\n忘れられない",
   "en": "",
   "op": "0x62",
   "msg": "0x3197"
  },
  {
   "id": "b_014001:0x413c4",
   "off": 267204,
   "max": 76,
   "kind": "dialogue",
   "jp": "そして　我々の目指す音楽が\\n一度で分かるような\\nそんな名前が必要なんです",
   "en": "",
   "op": "0x62",
   "msg": "0x3198"
  },
  {
   "id": "b_014001:0x4188c",
   "off": 268428,
   "max": 44,
   "kind": "dialogue",
   "jp": "そういう桂さんは\\n何か　いい案はあるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x3199"
  },
  {
   "id": "b_014001:0x41dd0",
   "off": 269776,
   "max": 56,
   "kind": "dialogue",
   "jp": "そうですね\\n遠い異国の楽器名……\\nなどはどうでしょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x319a"
  },
  {
   "id": "b_014001:0x425bc",
   "off": 271804,
   "max": 32,
   "kind": "dialogue",
   "jp": "おっ　なんか\\n格好良さそうじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x319b"
  },
  {
   "id": "b_014001:0x42b08",
   "off": 273160,
   "max": 64,
   "kind": "dialogue",
   "jp": "優しい音色ながらも\\n誰よりも速く戦場を\\n駆け抜けるビートを刻む",
   "en": "",
   "op": "0x62",
   "msg": "0x319c"
  },
  {
   "id": "b_014001:0x436ac",
   "off": 276140,
   "max": 40,
   "kind": "dialogue",
   "jp": "その名も……\\n迅馬笛（ジンバブエ）！",
   "en": "",
   "op": "0x62",
   "msg": "0x319d"
  },
  {
   "id": "b_014001:0x44020",
   "off": 278560,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふむ……\\n含蓄のある\\nなかなか　いい名だ",
   "en": "",
   "op": "0x62",
   "msg": "0x319e"
  },
  {
   "id": "b_014001:0x44794",
   "off": 280468,
   "max": 68,
   "kind": "dialogue",
   "jp": "う～ん\\nオジサンっぽいっていうか\\nなんだか識者（マニア）\\n向け？",
   "en": "",
   "op": "0x62",
   "msg": "0x319f"
  },
  {
   "id": "b_014001:0x44e7c",
   "off": 282236,
   "max": 48,
   "kind": "dialogue",
   "jp": "品はあるが\\nその分　ガツンとは\\nこねぇな……",
   "en": "",
   "op": "0x62",
   "msg": "0x31a0"
  },
  {
   "id": "b_014001:0x45550",
   "off": 283984,
   "max": 48,
   "kind": "dialogue",
   "jp": "そうなんですよね\\nロックっぽくは\\nないんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31a1"
  },
  {
   "id": "b_014001:0x45d64",
   "off": 286052,
   "max": 56,
   "kind": "dialogue",
   "jp": "ヒジゾーさんも\\nなんかいいのが\\nあったら提案するぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31a2"
  },
  {
   "id": "b_014001:0x46470",
   "off": 287856,
   "max": 44,
   "kind": "dialogue",
   "jp": "あ～\\n俺はこういうのは\\n得意じゃないんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x31a3"
  },
  {
   "id": "b_014001:0x46918",
   "off": 289048,
   "max": 36,
   "kind": "dialogue",
   "jp": "言ってみなきゃ\\nわからんじゃろ？",
   "en": "",
   "op": "0x62",
   "msg": "0x31a4"
  },
  {
   "id": "b_014001:0x46db8",
   "off": 290232,
   "max": 32,
   "kind": "dialogue",
   "jp": "そ　そうか……\\nじゃ……コホン",
   "en": "",
   "op": "0x62",
   "msg": "0x31a5"
  },
  {
   "id": "b_014001:0x4793c",
   "off": 293180,
   "max": 52,
   "kind": "dialogue",
   "jp": "鼓舞鳥隊\\n（こぶとりたい）……\\nと言うのはどうだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x31a6"
  },
  {
   "id": "b_014001:0x48028",
   "off": 294952,
   "max": 8,
   "kind": "dialogue",
   "jp": "……",
   "en": "",
   "op": "0x62",
   "msg": "0x31a7"
  },
  {
   "id": "b_014001:0x48af0",
   "off": 297712,
   "max": 40,
   "kind": "dialogue",
   "jp": "……あ～\\nどうじゃろうか\\nセンセー？",
   "en": "",
   "op": "0x62",
   "msg": "0x31a8"
  },
  {
   "id": "b_014001:0x4910c",
   "off": 299276,
   "max": 40,
   "kind": "dialogue",
   "jp": "……悪くは\\nないと思います\\nええ……",
   "en": "",
   "op": "0x62",
   "msg": "0x31a9"
  },
  {
   "id": "b_014001:0x49900",
   "off": 301312,
   "max": 36,
   "kind": "dialogue",
   "jp": "気持ちを鼓舞し\\n世に羽ばたきたい",
   "en": "",
   "op": "0x62",
   "msg": "0x31aa"
  },
  {
   "id": "b_014001:0x49934",
   "off": 301364,
   "max": 32,
   "kind": "dialogue",
   "jp": "そんな想いを込めて\\nみたんだが",
   "en": "",
   "op": "0x62",
   "msg": "0x31ab"
  },
  {
   "id": "b_014001:0x4a1ac",
   "off": 303532,
   "max": 60,
   "kind": "dialogue",
   "jp": "わ　悪くはねえが\\n少しロックっぽくないかも？\\n……かな？",
   "en": "",
   "op": "0x62",
   "msg": "0x31ac"
  },
  {
   "id": "b_014001:0x4a888",
   "off": 305288,
   "max": 44,
   "kind": "dialogue",
   "jp": "あーあー　みんな\\n気を遣わなくても\\nいいよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31ad"
  },
  {
   "id": "b_014001:0x4b1d4",
   "off": 307668,
   "max": 36,
   "kind": "dialogue",
   "jp": "土方さん\\nそれ　すごくダサイです",
   "en": "",
   "op": "0x62",
   "msg": "0x31ae"
  },
  {
   "id": "b_014001:0x4bb28",
   "off": 310056,
   "max": 12,
   "kind": "dialogue",
   "jp": "……うっ",
   "en": "",
   "op": "0x62",
   "msg": "0x31af"
  },
  {
   "id": "b_014001:0x4c390",
   "off": 312208,
   "max": 72,
   "kind": "dialogue",
   "jp": "字を書くならともかく\\nこぶとりって何ですか\\n中年のオジサンみたいですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31b0"
  },
  {
   "id": "b_014001:0x4cdb0",
   "off": 314800,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ううっ",
   "en": "",
   "op": "0x62",
   "msg": "0x31b1"
  },
  {
   "id": "b_014001:0x4d750",
   "off": 317264,
   "max": 60,
   "kind": "dialogue",
   "jp": "ちょ　ソウちん！\\nそこまで言わなくても\\nいいんじゃないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x31b2"
  },
  {
   "id": "b_014001:0x4df68",
   "off": 319336,
   "max": 40,
   "kind": "dialogue",
   "jp": "沖田……\\n土方が\\n無言で泣いてるぞ？",
   "en": "",
   "op": "0x62",
   "msg": "0x31b3"
  },
  {
   "id": "b_014001:0x4e6ac",
   "off": 321196,
   "max": 44,
   "kind": "dialogue",
   "jp": "土方さんは真面目で\\nとってもいい人だけど",
   "en": "",
   "op": "0x62",
   "msg": "0x31b4"
  },
  {
   "id": "b_014001:0x4e6e8",
   "off": 321256,
   "max": 56,
   "kind": "dialogue",
   "jp": "こういうのは\\nちゃんと言ってあげた方が\\n本人のためだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31b5"
  },
  {
   "id": "b_014001:0x4eeec",
   "off": 323308,
   "max": 16,
   "kind": "dialogue",
   "jp": "……くぅぅぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x31b6"
  },
  {
   "id": "b_014001:0x4f7ac",
   "off": 325548,
   "max": 64,
   "kind": "dialogue",
   "jp": "私はいいと思うんです\\nでも　今時の若い子には\\nなかなか……ね？",
   "en": "",
   "op": "0x62",
   "msg": "0x31b7"
  },
  {
   "id": "b_014001:0x4fc68",
   "off": 326760,
   "max": 16,
   "kind": "dialogue",
   "jp": "あ……ああ……",
   "en": "",
   "op": "0x62",
   "msg": "0x31b8"
  },
  {
   "id": "b_014001:0x50534",
   "off": 329012,
   "max": 40,
   "kind": "dialogue",
   "jp": "ん～\\nなかなかいいのが\\n思いつかんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31b9"
  },
  {
   "id": "b_014001:0x50c84",
   "off": 330884,
   "max": 40,
   "kind": "dialogue",
   "jp": "『奇兵隊\\n（ストレンジロッカーズ）』",
   "en": "",
   "op": "0x62",
   "msg": "0x31ba"
  },
  {
   "id": "b_014001:0x51350",
   "off": 332624,
   "max": 48,
   "kind": "dialogue",
   "jp": "確かに格好はいいが\\nそれだけって\\n気がするな",
   "en": "",
   "op": "0x62",
   "msg": "0x31bb"
  },
  {
   "id": "b_014001:0x51a24",
   "off": 334372,
   "max": 64,
   "kind": "dialogue",
   "jp": "難しく考えるから\\n良くないんですね\\nもっと単純に行きましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x31bc"
  },
  {
   "id": "b_014001:0x521e4",
   "off": 336356,
   "max": 68,
   "kind": "dialogue",
   "jp": "皆の頭の文字を取って\\nサタカヒオ……というのは\\nどうでしょうか？",
   "en": "",
   "op": "0x62",
   "msg": "0x31bd"
  },
  {
   "id": "b_014001:0x529b4",
   "off": 338356,
   "max": 52,
   "kind": "dialogue",
   "jp": "桂さん……\\n眠くなってないか\\n意味が全然分からねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x31be"
  },
  {
   "id": "b_014001:0x531f0",
   "off": 340464,
   "max": 64,
   "kind": "dialogue",
   "jp": "それなら　名前にして\\nソコトリシのほうが\\n隊っぽい気がするな～",
   "en": "",
   "op": "0x62",
   "msg": "0x31bf"
  },
  {
   "id": "b_014001:0x538d0",
   "off": 342224,
   "max": 56,
   "kind": "dialogue",
   "jp": "おっと　それなら\\nわしとヒジゾーさんは\\n名前にすると",
   "en": "",
   "op": "0x62",
   "msg": "0x31c0"
  },
  {
   "id": "b_014001:0x54538",
   "off": 345400,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんと……\\nオトコタリ！\\nになるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31c1"
  },
  {
   "id": "b_014001:0x54da0",
   "off": 347552,
   "max": 40,
   "kind": "dialogue",
   "jp": "武士らしい気がするな\\nそれにするか？",
   "en": "",
   "op": "0x62",
   "msg": "0x31c2"
  },
  {
   "id": "b_014001:0x555ac",
   "off": 349612,
   "max": 36,
   "kind": "dialogue",
   "jp": "おい　お前達\\n適当すぎるだろうが！",
   "en": "",
   "op": "0x62",
   "msg": "0x31c3"
  },
  {
   "id": "b_014001:0x55d58",
   "off": 351576,
   "max": 64,
   "kind": "dialogue",
   "jp": "桂さんも　すぐに飽きない\\n投げ出さない！\\n真面目に考えてくれよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31c4"
  },
  {
   "id": "b_014001:0x563f0",
   "off": 353264,
   "max": 16,
   "kind": "dialogue",
   "jp": "……ですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x31c5"
  },
  {
   "id": "b_014001:0x56d44",
   "off": 355652,
   "max": 56,
   "kind": "dialogue",
   "jp": "……はぁ\\nこんな時　近藤さんなら\\nどうしたのだろうか",
   "en": "",
   "op": "0x62",
   "msg": "0x31c6"
  },
  {
   "id": "b_014001:0x5720c",
   "off": 356876,
   "max": 16,
   "kind": "dialogue",
   "jp": "……土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x31c7"
  },
  {
   "id": "b_014001:0x57698",
   "off": 358040,
   "max": 40,
   "kind": "dialogue",
   "jp": "感傷ではなくてな\\nただ　思っただけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x31c8"
  },
  {
   "id": "b_014001:0x576d0",
   "off": 358096,
   "max": 72,
   "kind": "dialogue",
   "jp": "新選組は一番隊　二番隊\\nなどと隊で呼ばれる\\n普段特別な名はなかったが",
   "en": "",
   "op": "0x62",
   "msg": "0x31c9"
  },
  {
   "id": "b_014001:0x57728",
   "off": 358184,
   "max": 76,
   "kind": "dialogue",
   "jp": "もし　そうではなかったら\\n近藤さんは　オレ達に\\nどんな隊名をつけただろうか",
   "en": "",
   "op": "0x62",
   "msg": "0x31ca"
  },
  {
   "id": "b_014001:0x58058",
   "off": 360536,
   "max": 60,
   "kind": "dialogue",
   "jp": "天歌は嫌いだったが\\n近藤のオッサンは\\n嫌いじゃなかったぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x31cb"
  },
  {
   "id": "b_014001:0x58510",
   "off": 361744,
   "max": 32,
   "kind": "dialogue",
   "jp": "晋作は知らないと\\n思いますが",
   "en": "",
   "op": "0x62",
   "msg": "0x31cc"
  },
  {
   "id": "b_014001:0x58540",
   "off": 361792,
   "max": 44,
   "kind": "dialogue",
   "jp": "天歌の名前も　歌詞も\\n素晴らしいものですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31cd"
  },
  {
   "id": "b_014001:0x58cf0",
   "off": 363760,
   "max": 44,
   "kind": "dialogue",
   "jp": "そりゃそうだよ\\n近藤さんはいつも考えてた",
   "en": "",
   "op": "0x62",
   "msg": "0x31ce"
  },
  {
   "id": "b_014001:0x58d2c",
   "off": 363820,
   "max": 64,
   "kind": "dialogue",
   "jp": "どうしたら　みんなに\\n喜んで貰えるか\\n笑顔になって貰えるかって",
   "en": "",
   "op": "0x62",
   "msg": "0x31cf"
  },
  {
   "id": "b_014001:0x5940c",
   "off": 365580,
   "max": 12,
   "kind": "dialogue",
   "jp": "笑顔か……",
   "en": "",
   "op": "0x62",
   "msg": "0x31d0"
  },
  {
   "id": "b_014001:0x5992c",
   "off": 366892,
   "max": 68,
   "kind": "dialogue",
   "jp": "なあ　わしらは\\nわしらの隊名ってことに\\n拘りすぎてたんじゃないか",
   "en": "",
   "op": "0x62",
   "msg": "0x31d1"
  },
  {
   "id": "b_014001:0x5a014",
   "off": 368660,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレ様たちの隊名だ\\n拘るのは当たり前だ",
   "en": "",
   "op": "0x62",
   "msg": "0x31d2"
  },
  {
   "id": "b_014001:0x5a6dc",
   "off": 370396,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうじゃなくてな",
   "en": "",
   "op": "0x62",
   "msg": "0x31d3"
  },
  {
   "id": "b_014001:0x5a700",
   "off": 370432,
   "max": 68,
   "kind": "dialogue",
   "jp": "どんなに良い曲を弾いても\\nそれが　わしらのためじゃ\\n意味がないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x31d4"
  },
  {
   "id": "b_014001:0x5ade8",
   "off": 372200,
   "max": 36,
   "kind": "dialogue",
   "jp": "確かに……\\nロックはみんなのために",
   "en": "",
   "op": "0x62",
   "msg": "0x31d5"
  },
  {
   "id": "b_014001:0x5b4b0",
   "off": 373936,
   "max": 28,
   "kind": "dialogue",
   "jp": "音楽は笑顔の為で\\nなければ",
   "en": "",
   "op": "0x62",
   "msg": "0x31d6"
  },
  {
   "id": "b_014001:0x5bb6c",
   "off": 375660,
   "max": 36,
   "kind": "dialogue",
   "jp": "なあ　もう一度\\n最初から始めんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x31d7"
  },
  {
   "id": "b_014001:0x5c5b8",
   "off": 378296,
   "max": 28,
   "kind": "dialogue",
   "jp": "今度は\\nみんなのためにな",
   "en": "",
   "op": "0x62",
   "msg": "0x31d8"
  },
  {
   "id": "b_014001:0x5cf14",
   "off": 380692,
   "max": 48,
   "kind": "dialogue",
   "jp": "その話し合いは\\n飲まず食わずで\\n一昼夜続き……",
   "en": "",
   "op": "0x62",
   "msg": "0x31d9"
  },
  {
   "id": "b_014001:0x5cf54",
   "off": 380756,
   "max": 40,
   "kind": "dialogue",
   "jp": "それが決まる頃には\\nもう夜が明けていた",
   "en": "",
   "op": "0x62",
   "msg": "0x31da"
  },
  {
   "id": "b_014001:0x5d6c4",
   "off": 382660,
   "max": 44,
   "kind": "dialogue",
   "jp": "……うう　眠い\\nけど　なんだか\\n嬉しいね",
   "en": "",
   "op": "0x62",
   "msg": "0x31db"
  },
  {
   "id": "b_014001:0x5dd94",
   "off": 384404,
   "max": 44,
   "kind": "dialogue",
   "jp": "だが　甲斐はあった\\nロックでクールで……",
   "en": "",
   "op": "0x62",
   "msg": "0x31dc"
  },
  {
   "id": "b_014001:0x5e464",
   "off": 386148,
   "max": 36,
   "kind": "dialogue",
   "jp": "皆を笑顔にできる\\n隊名に決まった",
   "en": "",
   "op": "0x62",
   "msg": "0x31dd"
  },
  {
   "id": "b_014001:0x5eb2c",
   "off": 387884,
   "max": 32,
   "kind": "dialogue",
   "jp": "では　龍馬くん\\n発表して下さい",
   "en": "",
   "op": "0x62",
   "msg": "0x31de"
  },
  {
   "id": "b_014001:0x5f670",
   "off": 390768,
   "max": 56,
   "kind": "dialogue",
   "jp": "よし！\\n隊名は『超魂團\\n（ウルトラソウルズ）』\\nぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x31df"
  },
  {
   "id": "b_014001:0x5fc44",
   "off": 392260,
   "max": 60,
   "kind": "dialogue",
   "jp": "龍馬が　皆の顔を見回し\\nその隊名を叫ぶと\\n拍手が巻き起こる",
   "en": "",
   "op": "0x62",
   "msg": "0x31e0"
  },
  {
   "id": "b_014001:0x5fc90",
   "off": 392336,
   "max": 68,
   "kind": "dialogue",
   "jp": "それは……\\nバラバラだった\\n仲間の心が一つになった\\n感動の瞬間……",
   "en": "",
   "op": "0x62",
   "msg": "0x31e1"
  },
  {
   "id": "b_014001:0x60414",
   "off": 394260,
   "max": 12,
   "kind": "dialogue",
   "jp": "あ　虫だ",
   "en": "",
   "op": "0x62",
   "msg": "0x31e2"
  },
  {
   "id": "b_014001:0x60c6c",
   "off": 396396,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぐわっ",
   "en": "",
   "op": "0x62",
   "msg": "0x31e3"
  },
  {
   "id": "b_014001:0x614fc",
   "off": 398588,
   "max": 44,
   "kind": "dialogue",
   "jp": "沖田くん\\nうちの晋作に\\n何をするんですか",
   "en": "",
   "op": "0x62",
   "msg": "0x31e4"
  },
  {
   "id": "b_014001:0x61bdc",
   "off": 400348,
   "max": 56,
   "kind": "dialogue",
   "jp": "今のは　いつもの\\n嫌がらせではなく\\n本当に不可抗力だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x31e5"
  },
  {
   "id": "b_014001:0x623f4",
   "off": 402420,
   "max": 12,
   "kind": "dialogue",
   "jp": "……はぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x31e6"
  },
  {
   "id": "b_014001:0x62914",
   "off": 403732,
   "max": 40,
   "kind": "dialogue",
   "jp": "……だったらいいな\\nと　龍馬は思った",
   "en": "",
   "op": "0x62",
   "msg": "0x31e7"
  }
 ]
}
