{
 "source": "b_017001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_017001:0x10e8",
   "off": 4328,
   "max": 36,
   "kind": "dialogue",
   "jp": "京都の夕空に\\n細長い煙が上ってゆく",
   "en": "",
   "op": "0x62",
   "msg": "0x5682"
  },
  {
   "id": "b_017001:0x111c",
   "off": 4380,
   "max": 72,
   "kind": "dialogue",
   "jp": "土方歳三と沖田総司は\\n近藤勇の墓前に線香を立て\\n静かに手を合わせていた",
   "en": "",
   "op": "0x62",
   "msg": "0x5683"
  },
  {
   "id": "b_017001:0x16cc",
   "off": 5836,
   "max": 28,
   "kind": "dialogue",
   "jp": "お久しぶりです\\n近藤さん",
   "en": "",
   "op": "0x62",
   "msg": "0x5684"
  },
  {
   "id": "b_017001:0x1710",
   "off": 5904,
   "max": 68,
   "kind": "dialogue",
   "jp": "近藤さんに代わって\\n新選組の局長になって\\nずいぶん経ちますが――",
   "en": "",
   "op": "0x62",
   "msg": "0x5685"
  },
  {
   "id": "b_017001:0x1764",
   "off": 5988,
   "max": 44,
   "kind": "dialogue",
   "jp": "局長としての責務に\\n忙殺されるばかりです",
   "en": "",
   "op": "0x62",
   "msg": "0x5686"
  },
  {
   "id": "b_017001:0x183c",
   "off": 6204,
   "max": 44,
   "kind": "dialogue",
   "jp": "しばらく顔を出せなくて\\nすみませんでした",
   "en": "",
   "op": "0x62",
   "msg": "0x5687"
  },
  {
   "id": "b_017001:0x1878",
   "off": 6264,
   "max": 24,
   "kind": "dialogue",
   "jp": "近藤さん\\nこの通りだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5688"
  },
  {
   "id": "b_017001:0x1d20",
   "off": 7456,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方は両手を合わせると\\n近藤の墓前に\\n深く頭を下げた",
   "en": "",
   "op": "0x62",
   "msg": "0x5689"
  },
  {
   "id": "b_017001:0x2198",
   "off": 8600,
   "max": 16,
   "kind": "dialogue",
   "jp": "………………",
   "en": "",
   "op": "0x62",
   "msg": "0x568a"
  },
  {
   "id": "b_017001:0x2638",
   "off": 9784,
   "max": 48,
   "kind": "dialogue",
   "jp": "沖田は土方の横顔を\\nただじっと\\n見つめていた",
   "en": "",
   "op": "0x62",
   "msg": "0x568b"
  },
  {
   "id": "b_017001:0x2678",
   "off": 9848,
   "max": 116,
   "kind": "dialogue",
   "jp": "いつものように軽口も\\n叩かず　土方が頭を上げる\\nまでの間　一言も喋らない\\nまま　ただじっと\\n彼を見つめ続けていた",
   "en": "",
   "op": "0x62",
   "msg": "0x568c"
  },
  {
   "id": "b_017001:0x2b30",
   "off": 11056,
   "max": 24,
   "kind": "dialogue",
   "jp": "総司\\nお前も挨拶しろ",
   "en": "",
   "op": "0x62",
   "msg": "0x568d"
  },
  {
   "id": "b_017001:0x319c",
   "off": 12700,
   "max": 32,
   "kind": "dialogue",
   "jp": "言われなくても\\n分かってますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x568e"
  },
  {
   "id": "b_017001:0x3738",
   "off": 14136,
   "max": 52,
   "kind": "dialogue",
   "jp": "土方に促されて\\n沖田は近藤の墓前に\\n軽く頭を下げた",
   "en": "",
   "op": "0x62",
   "msg": "0x568f"
  },
  {
   "id": "b_017001:0x3bac",
   "off": 15276,
   "max": 20,
   "kind": "dialogue",
   "jp": "どうも\\n近藤さん",
   "en": "",
   "op": "0x62",
   "msg": "0x5690"
  },
  {
   "id": "b_017001:0x3bd0",
   "off": 15312,
   "max": 44,
   "kind": "dialogue",
   "jp": "貴方は誰とでも上手く\\nやれる人だったから",
   "en": "",
   "op": "0x62",
   "msg": "0x5691"
  },
  {
   "id": "b_017001:0x3ca4",
   "off": 15524,
   "max": 48,
   "kind": "dialogue",
   "jp": "きっとあっちへ行っても\\n愉快にやってますよね",
   "en": "",
   "op": "0x62",
   "msg": "0x5692"
  },
  {
   "id": "b_017001:0x3d7c",
   "off": 15740,
   "max": 36,
   "kind": "dialogue",
   "jp": "僕らも　なんとか\\n元気にやってます",
   "en": "",
   "op": "0x62",
   "msg": "0x5693"
  },
  {
   "id": "b_017001:0x3db0",
   "off": 15792,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方さんは――\\nそうですね\\n少々お疲れのようですけど",
   "en": "",
   "op": "0x62",
   "msg": "0x5694"
  },
  {
   "id": "b_017001:0x442c",
   "off": 17452,
   "max": 28,
   "kind": "dialogue",
   "jp": "おい　総司\\n出鱈目を言うな",
   "en": "",
   "op": "0x62",
   "msg": "0x5695"
  },
  {
   "id": "b_017001:0x4458",
   "off": 17496,
   "max": 56,
   "kind": "dialogue",
   "jp": "俺は疲れてなどいない\\nこの通り気力に\\n満ち溢れている",
   "en": "",
   "op": "0x62",
   "msg": "0x5696"
  },
  {
   "id": "b_017001:0x49a4",
   "off": 18852,
   "max": 20,
   "kind": "dialogue",
   "jp": "へぇ\\nそうですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5697"
  },
  {
   "id": "b_017001:0x49c8",
   "off": 18888,
   "max": 52,
   "kind": "dialogue",
   "jp": "お偉方との折衝に\\n苦労してるみたい\\nじゃないですか",
   "en": "",
   "op": "0x62",
   "msg": "0x5698"
  },
  {
   "id": "b_017001:0x4aa4",
   "off": 19108,
   "max": 56,
   "kind": "dialogue",
   "jp": "最近はお酒の量も\\n増えてるみたいだし\\n僕は心配だなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x5699"
  },
  {
   "id": "b_017001:0x51a8",
   "off": 20904,
   "max": 8,
   "kind": "dialogue",
   "jp": "む……",
   "en": "",
   "op": "0x62",
   "msg": "0x569a"
  },
  {
   "id": "b_017001:0x56c4",
   "off": 22212,
   "max": 28,
   "kind": "dialogue",
   "jp": "僕の目は\\n誤魔化せませんよ",
   "en": "",
   "op": "0x62",
   "msg": "0x569b"
  },
  {
   "id": "b_017001:0x5788",
   "off": 22408,
   "max": 52,
   "kind": "dialogue",
   "jp": "それに近藤さんの目の前で\\n嘘はいけないと思います",
   "en": "",
   "op": "0x62",
   "msg": "0x569c"
  },
  {
   "id": "b_017001:0x5cd4",
   "off": 23764,
   "max": 12,
   "kind": "dialogue",
   "jp": "ふぅ……",
   "en": "",
   "op": "0x62",
   "msg": "0x569d"
  },
  {
   "id": "b_017001:0x5d8c",
   "off": 23948,
   "max": 56,
   "kind": "dialogue",
   "jp": "ああそうだ\\n最近確かに疲れている\\nだが仕方ないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x569e"
  },
  {
   "id": "b_017001:0x5ddc",
   "off": 24028,
   "max": 72,
   "kind": "dialogue",
   "jp": "近藤さんがいなくなった\\n穴は　簡単に塞がるような\\n小さなものではない",
   "en": "",
   "op": "0x62",
   "msg": "0x569f"
  },
  {
   "id": "b_017001:0x5ed0",
   "off": 24272,
   "max": 64,
   "kind": "dialogue",
   "jp": "血を吐くような思いで\\n責務に臨んで　まだ\\n足りないと思っている",
   "en": "",
   "op": "0x62",
   "msg": "0x56a0"
  },
  {
   "id": "b_017001:0x5fbc",
   "off": 24508,
   "max": 56,
   "kind": "dialogue",
   "jp": "それに酒だって\\n近藤さんの十分の一も\\n飲んでないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x56a1"
  },
  {
   "id": "b_017001:0x6570",
   "off": 25968,
   "max": 60,
   "kind": "dialogue",
   "jp": "近藤の墓前を見つめながら\\n土方は嘘偽りのない心境を\\n話した",
   "en": "",
   "op": "0x62",
   "msg": "0x56a2"
  },
  {
   "id": "b_017001:0x6938",
   "off": 26936,
   "max": 84,
   "kind": "dialogue",
   "jp": "すると　今まで顔を\\n見せていた夕陽が\\n大きな雲に隠れてしまい\\n突然辺りが暗くなった",
   "en": "",
   "op": "0x62",
   "msg": "0x56a3"
  },
  {
   "id": "b_017001:0x70d0",
   "off": 28880,
   "max": 16,
   "kind": "dialogue",
   "jp": "これは一体？",
   "en": "",
   "op": "0x62",
   "msg": "0x56a4"
  },
  {
   "id": "b_017001:0x797c",
   "off": 31100,
   "max": 56,
   "kind": "dialogue",
   "jp": "もしかしたら\\n近藤さんが心配してるん\\nじゃないですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x56a5"
  },
  {
   "id": "b_017001:0x8210",
   "off": 33296,
   "max": 40,
   "kind": "dialogue",
   "jp": "そんなバカなこと\\nあるわけがないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x56a6"
  },
  {
   "id": "b_017001:0x874c",
   "off": 34636,
   "max": 52,
   "kind": "dialogue",
   "jp": "そうですか？\\n近藤さんなら\\nあり得ると思いますね",
   "en": "",
   "op": "0x62",
   "msg": "0x56a7"
  },
  {
   "id": "b_017001:0x8828",
   "off": 34856,
   "max": 20,
   "kind": "dialogue",
   "jp": "試してみましょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x56a8"
  },
  {
   "id": "b_017001:0x8d54",
   "off": 36180,
   "max": 32,
   "kind": "dialogue",
   "jp": "試すといっても\\nどうするんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x56a9"
  },
  {
   "id": "b_017001:0x966c",
   "off": 38508,
   "max": 24,
   "kind": "dialogue",
   "jp": "近藤さんのアーホー！",
   "en": "",
   "op": "0x62",
   "msg": "0x56aa"
  },
  {
   "id": "b_017001:0x9734",
   "off": 38708,
   "max": 28,
   "kind": "dialogue",
   "jp": "近藤さんの\\nおたんちーん！",
   "en": "",
   "op": "0x62",
   "msg": "0x56ab"
  },
  {
   "id": "b_017001:0xa680",
   "off": 42624,
   "max": 20,
   "kind": "dialogue",
   "jp": "こ　これは……？",
   "en": "",
   "op": "0x62",
   "msg": "0x56ac"
  },
  {
   "id": "b_017001:0xaea0",
   "off": 44704,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんちゃって\\n今のは全部ウソ！",
   "en": "",
   "op": "0x62",
   "msg": "0x56ad"
  },
  {
   "id": "b_017001:0xaed8",
   "off": 44760,
   "max": 60,
   "kind": "dialogue",
   "jp": "近藤さんになら\\n抱かれてもいい！\\nいやむしろ抱いてほしい！",
   "en": "",
   "op": "0x62",
   "msg": "0x56ae"
  },
  {
   "id": "b_017001:0xbab4",
   "off": 47796,
   "max": 16,
   "kind": "dialogue",
   "jp": "お　おお……",
   "en": "",
   "op": "0x62",
   "msg": "0x56af"
  },
  {
   "id": "b_017001:0xbf48",
   "off": 48968,
   "max": 48,
   "kind": "dialogue",
   "jp": "ほらね\\nやっぱり近藤さんが\\n心配してるんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x56b0"
  },
  {
   "id": "b_017001:0xbf88",
   "off": 49032,
   "max": 48,
   "kind": "dialogue",
   "jp": "土方さんが血を吐くとか\\n物騒なこと言ったから",
   "en": "",
   "op": "0x62",
   "msg": "0x56b1"
  },
  {
   "id": "b_017001:0xc4d0",
   "off": 50384,
   "max": 56,
   "kind": "dialogue",
   "jp": "あ　いや　近藤さん\\n本当に血は吐いてない\\n物の例えだ",
   "en": "",
   "op": "0x62",
   "msg": "0x56b2"
  },
  {
   "id": "b_017001:0xcc04",
   "off": 52228,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方が否定したものの\\n再び雲行きは\\n怪しくなってしまった",
   "en": "",
   "op": "0x62",
   "msg": "0x56b3"
  },
  {
   "id": "b_017001:0xd1c4",
   "off": 53700,
   "max": 44,
   "kind": "dialogue",
   "jp": "あーあ\\n今にも泣き出しそうな\\n空模様ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x56b4"
  },
  {
   "id": "b_017001:0xd714",
   "off": 55060,
   "max": 12,
   "kind": "dialogue",
   "jp": "なっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x56b5"
  },
  {
   "id": "b_017001:0xdc9c",
   "off": 56476,
   "max": 40,
   "kind": "dialogue",
   "jp": "土方は真っ青になり\\n慌てて首を振った",
   "en": "",
   "op": "0x62",
   "msg": "0x56b6"
  },
  {
   "id": "b_017001:0xe108",
   "off": 57608,
   "max": 32,
   "kind": "dialogue",
   "jp": "そんなに心配するな\\n近藤さんっ",
   "en": "",
   "op": "0x62",
   "msg": "0x56b7"
  },
  {
   "id": "b_017001:0xe138",
   "off": 57656,
   "max": 36,
   "kind": "dialogue",
   "jp": "局長の仕事は\\n慣れない事ばかりだが",
   "en": "",
   "op": "0x62",
   "msg": "0x56b8"
  },
  {
   "id": "b_017001:0xe208",
   "off": 57864,
   "max": 60,
   "kind": "dialogue",
   "jp": "俺の隣には貴方が\\n引き合わせてくれた\\n同志が……総司がいる",
   "en": "",
   "op": "0x62",
   "msg": "0x56b9"
  },
  {
   "id": "b_017001:0xe75c",
   "off": 59228,
   "max": 48,
   "kind": "dialogue",
   "jp": "近藤さんも総司の優秀さは\\n知っているだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x56ba"
  },
  {
   "id": "b_017001:0xe79c",
   "off": 59292,
   "max": 72,
   "kind": "dialogue",
   "jp": "こいつと新選組の仲間が\\nいればきっと大丈夫だ！\\nだから安心してくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x56bb"
  },
  {
   "id": "b_017001:0xee24",
   "off": 60964,
   "max": 24,
   "kind": "dialogue",
   "jp": "近藤さん\\n聞きました？",
   "en": "",
   "op": "0x62",
   "msg": "0x56bc"
  },
  {
   "id": "b_017001:0xee4c",
   "off": 61004,
   "max": 48,
   "kind": "dialogue",
   "jp": "土方さんはこんな感じで\\n毎日必死にやってますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x56bd"
  },
  {
   "id": "b_017001:0xef24",
   "off": 61220,
   "max": 56,
   "kind": "dialogue",
   "jp": "まあ　部下としては\\n正直ウザいと思う時も\\nありますけど",
   "en": "",
   "op": "0x62",
   "msg": "0x56be"
  },
  {
   "id": "b_017001:0xf58c",
   "off": 62860,
   "max": 24,
   "kind": "dialogue",
   "jp": "えっ？\\nお　おい　総司",
   "en": "",
   "op": "0x62",
   "msg": "0x56bf"
  },
  {
   "id": "b_017001:0xfab8",
   "off": 64184,
   "max": 52,
   "kind": "dialogue",
   "jp": "土方さんが必死に\\nやってるのは\\nみんな分かってます",
   "en": "",
   "op": "0x62",
   "msg": "0x56c0"
  },
  {
   "id": "b_017001:0xfafc",
   "off": 64252,
   "max": 68,
   "kind": "dialogue",
   "jp": "土方さんの　新選組を\\n大切に思う気持ちは\\n近藤さんにも負けません",
   "en": "",
   "op": "0x62",
   "msg": "0x56c1"
  },
  {
   "id": "b_017001:0xffc4",
   "off": 65476,
   "max": 44,
   "kind": "dialogue",
   "jp": "そ　そうだ\\n総司の言う通りです\\n近藤さん",
   "en": "",
   "op": "0x62",
   "msg": "0x56c2"
  },
  {
   "id": "b_017001:0x10504",
   "off": 66820,
   "max": 16,
   "kind": "dialogue",
   "jp": "気持ちだけはね",
   "en": "",
   "op": "0x62",
   "msg": "0x56c3"
  },
  {
   "id": "b_017001:0x10ad0",
   "off": 68304,
   "max": 16,
   "kind": "dialogue",
   "jp": "お　おう……",
   "en": "",
   "op": "0x62",
   "msg": "0x56c4"
  },
  {
   "id": "b_017001:0x11068",
   "off": 69736,
   "max": 72,
   "kind": "dialogue",
   "jp": "だからさ　近藤さん\\n墓参りになかなか来られない\\n土方さんを許してあげて",
   "en": "",
   "op": "0x62",
   "msg": "0x56c5"
  },
  {
   "id": "b_017001:0x110c0",
   "off": 69824,
   "max": 52,
   "kind": "dialogue",
   "jp": "土方さんは近藤さんのこと\\n忘れたわけじゃないんです",
   "en": "",
   "op": "0x62",
   "msg": "0x56c6"
  },
  {
   "id": "b_017001:0x11104",
   "off": 69892,
   "max": 72,
   "kind": "dialogue",
   "jp": "近藤さんが遺したものを\\n守ろうと　馬鹿みたいに\\n必死になってるだけです",
   "en": "",
   "op": "0x62",
   "msg": "0x56c7"
  },
  {
   "id": "b_017001:0x11780",
   "off": 71552,
   "max": 24,
   "kind": "dialogue",
   "jp": "……ちょっと待て\\n総司",
   "en": "",
   "op": "0x62",
   "msg": "0x56c8"
  },
  {
   "id": "b_017001:0x11d4c",
   "off": 73036,
   "max": 20,
   "kind": "dialogue",
   "jp": "は？\\nなんですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x56c9"
  },
  {
   "id": "b_017001:0x121dc",
   "off": 74204,
   "max": 52,
   "kind": "dialogue",
   "jp": "お前は俺を貶してるのか　\\nそれとも褒めてるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x56ca"
  },
  {
   "id": "b_017001:0x1268c",
   "off": 75404,
   "max": 68,
   "kind": "dialogue",
   "jp": "単に僕は　近藤さんに\\nありのままの事実を\\n知ってもらいたいだけです",
   "en": "",
   "op": "0x62",
   "msg": "0x56cb"
  },
  {
   "id": "b_017001:0x126e0",
   "off": 75488,
   "max": 56,
   "kind": "dialogue",
   "jp": "墓前で格好をつけても\\n近藤さんは\\n全部お見通しですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x56cc"
  },
  {
   "id": "b_017001:0x12728",
   "off": 75560,
   "max": 64,
   "kind": "dialogue",
   "jp": "きっと近藤さんは\\n強がる土方さんを見て\\n不安に思ってるはずです",
   "en": "",
   "op": "0x62",
   "msg": "0x56cd"
  },
  {
   "id": "b_017001:0x13060",
   "off": 77920,
   "max": 56,
   "kind": "dialogue",
   "jp": "これ以上　近藤さんに\\n余計な心配をかけたく\\nありません",
   "en": "",
   "op": "0x62",
   "msg": "0x56ce"
  },
  {
   "id": "b_017001:0x137b8",
   "off": 79800,
   "max": 60,
   "kind": "dialogue",
   "jp": "近藤さんに\\n心配をかけたくない　か\\nそれは俺も同じ気持ちだ",
   "en": "",
   "op": "0x62",
   "msg": "0x56cf"
  },
  {
   "id": "b_017001:0x13c3c",
   "off": 80956,
   "max": 88,
   "kind": "dialogue",
   "jp": "だからこそ近藤の墓前で\\n格好つけようとしたのだが\\nと心の中で呟きつつ\\n土方は苦笑した",
   "en": "",
   "op": "0x62",
   "msg": "0x56d0"
  },
  {
   "id": "b_017001:0x141a4",
   "off": 82340,
   "max": 40,
   "kind": "dialogue",
   "jp": "本当に近藤さんには\\n色々と世話をかけた",
   "en": "",
   "op": "0x62",
   "msg": "0x56d1"
  },
  {
   "id": "b_017001:0x1480c",
   "off": 83980,
   "max": 16,
   "kind": "dialogue",
   "jp": "そうですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x56d2"
  },
  {
   "id": "b_017001:0x1482c",
   "off": 84012,
   "max": 52,
   "kind": "dialogue",
   "jp": "愛獲には派手な雷舞をこなす\\n体力が必要だって言って",
   "en": "",
   "op": "0x62",
   "msg": "0x56d3"
  },
  {
   "id": "b_017001:0x14908",
   "off": 84232,
   "max": 60,
   "kind": "dialogue",
   "jp": "自分の少ない給金を叩いて\\nいつもご飯をご馳走して\\nくれたり",
   "en": "",
   "op": "0x62",
   "msg": "0x56d4"
  },
  {
   "id": "b_017001:0x14954",
   "off": 84308,
   "max": 76,
   "kind": "dialogue",
   "jp": "僕の喉の調子が今一の時は\\n雷舞の曲数を減らすように\\n幕府の上役に交渉したり",
   "en": "",
   "op": "0x62",
   "msg": "0x56d5"
  },
  {
   "id": "b_017001:0x149b0",
   "off": 84400,
   "max": 48,
   "kind": "dialogue",
   "jp": "下らない話にも\\n気が済むまで\\n付き合ってくれた",
   "en": "",
   "op": "0x62",
   "msg": "0x56d6"
  },
  {
   "id": "b_017001:0x149f0",
   "off": 84464,
   "max": 68,
   "kind": "dialogue",
   "jp": "それに土方さんと\\n僕の意見が対立すると\\nいつも仲裁に入ってくれた",
   "en": "",
   "op": "0x62",
   "msg": "0x56d7"
  },
  {
   "id": "b_017001:0x14eb0",
   "off": 85680,
   "max": 16,
   "kind": "dialogue",
   "jp": "ああ　そうだな",
   "en": "",
   "op": "0x62",
   "msg": "0x56d8"
  },
  {
   "id": "b_017001:0x153d4",
   "off": 86996,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方さん覚えてます？\\n新選組の新曲に歌詞を\\n付けた時のこと",
   "en": "",
   "op": "0x62",
   "msg": "0x56d9"
  },
  {
   "id": "b_017001:0x15928",
   "off": 88360,
   "max": 60,
   "kind": "dialogue",
   "jp": "俺と総司の作った\\n歌詞の　どちらを使うか\\n揉めた時のことか",
   "en": "",
   "op": "0x62",
   "msg": "0x56da"
  },
  {
   "id": "b_017001:0x15de0",
   "off": 89568,
   "max": 64,
   "kind": "dialogue",
   "jp": "お互い一歩も引かず\\n剣まで抜いて一触即発の\\n事態になっちゃって",
   "en": "",
   "op": "0x62",
   "msg": "0x56db"
  },
  {
   "id": "b_017001:0x1629c",
   "off": 90780,
   "max": 64,
   "kind": "dialogue",
   "jp": "しかし　近藤さんは\\n俺と総司の歌詞から\\n言葉を拾い上げて――",
   "en": "",
   "op": "0x62",
   "msg": "0x56dc"
  },
  {
   "id": "b_017001:0x162ec",
   "off": 90860,
   "max": 40,
   "kind": "dialogue",
   "jp": "新曲に相応しい\\n最高の歌詞を作り上げた",
   "en": "",
   "op": "0x62",
   "msg": "0x56dd"
  },
  {
   "id": "b_017001:0x16790",
   "off": 92048,
   "max": 72,
   "kind": "dialogue",
   "jp": "あの神業には驚いたなぁ\\n土方さんと争ってたのが\\n馬鹿らしく思えるくらい",
   "en": "",
   "op": "0x62",
   "msg": "0x56de"
  },
  {
   "id": "b_017001:0x167e8",
   "off": 92136,
   "max": 64,
   "kind": "dialogue",
   "jp": "あんな事は　海のように\\n度量が広い近藤さんにしか\\nできませんよ",
   "en": "",
   "op": "0x62",
   "msg": "0x56df"
  },
  {
   "id": "b_017001:0x16d40",
   "off": 93504,
   "max": 16,
   "kind": "dialogue",
   "jp": "ああ\\nそうだな",
   "en": "",
   "op": "0x62",
   "msg": "0x56e0"
  },
  {
   "id": "b_017001:0x171cc",
   "off": 94668,
   "max": 52,
   "kind": "dialogue",
   "jp": "まったく\\n近藤さんは凄いことを\\nやってのけますよね",
   "en": "",
   "op": "0x62",
   "msg": "0x56e1"
  },
  {
   "id": "b_017001:0x17210",
   "off": 94736,
   "max": 52,
   "kind": "dialogue",
   "jp": "土方さんの歌詞は\\nセンスのかけらも\\nなかったのに",
   "en": "",
   "op": "0x62",
   "msg": "0x56e2"
  },
  {
   "id": "b_017001:0x17254",
   "off": 94804,
   "max": 68,
   "kind": "dialogue",
   "jp": "僕の歌詞を基礎（ベース）に\\n使えそうな部分を拾って\\n合わせるなんて",
   "en": "",
   "op": "0x62",
   "msg": "0x56e3"
  },
  {
   "id": "b_017001:0x17904",
   "off": 96516,
   "max": 20,
   "kind": "dialogue",
   "jp": "聞き捨てならんな",
   "en": "",
   "op": "0x62",
   "msg": "0x56e4"
  },
  {
   "id": "b_017001:0x17930",
   "off": 96560,
   "max": 40,
   "kind": "dialogue",
   "jp": "基礎になったのは\\n俺の歌詞だったろう",
   "en": "",
   "op": "0x62",
   "msg": "0x56e5"
  },
  {
   "id": "b_017001:0x1804c",
   "off": 98380,
   "max": 44,
   "kind": "dialogue",
   "jp": "はぁ？\\n違いますよ　僕です\\n僕の歌詞です",
   "en": "",
   "op": "0x62",
   "msg": "0x56e6"
  },
  {
   "id": "b_017001:0x18590",
   "off": 99728,
   "max": 24,
   "kind": "dialogue",
   "jp": "俺の歌詞だ\\n間違いない",
   "en": "",
   "op": "0x62",
   "msg": "0x56e7"
  },
  {
   "id": "b_017001:0x185c4",
   "off": 99780,
   "max": 56,
   "kind": "dialogue",
   "jp": "昔からそうだが\\nお前が書く詞は\\n地に足がついていない",
   "en": "",
   "op": "0x62",
   "msg": "0x56e8"
  },
  {
   "id": "b_017001:0x1860c",
   "off": 99852,
   "max": 56,
   "kind": "dialogue",
   "jp": "そんな歌詞を\\n近藤さんが基礎に\\nするわけがないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x56e9"
  },
  {
   "id": "b_017001:0x18654",
   "off": 99924,
   "max": 16,
   "kind": "dialogue",
   "jp": "なあ\\n近藤さん",
   "en": "",
   "op": "0x62",
   "msg": "0x56ea"
  },
  {
   "id": "b_017001:0x18de8",
   "off": 101864,
   "max": 56,
   "kind": "dialogue",
   "jp": "はぁ　これだから\\n鈍感の筋肉バカは\\nイヤになっちゃうな",
   "en": "",
   "op": "0x62",
   "msg": "0x56ee"
  },
  {
   "id": "b_017001:0x1973c",
   "off": 104252,
   "max": 16,
   "kind": "dialogue",
   "jp": "おい総司\\n貴様",
   "en": "",
   "op": "0x62",
   "msg": "0x56ec"
  },
  {
   "id": "b_017001:0x19efc",
   "off": 106236,
   "max": 68,
   "kind": "dialogue",
   "jp": "二人の間に　険悪な\\n空気が漂う中\\nいよいよ　雨足が\\n強くなり始める",
   "en": "",
   "op": "0x62",
   "msg": "0x56ed"
  },
  {
   "id": "b_017001:0x1a380",
   "off": 107392,
   "max": 40,
   "kind": "dialogue",
   "jp": "何かって言うと\\nすぐ脱ぎたがるし……",
   "en": "",
   "op": "0x62",
   "msg": "0x56ef"
  },
  {
   "id": "b_017001:0x1a9ec",
   "off": 109036,
   "max": 56,
   "kind": "dialogue",
   "jp": "何が悪い\\n誰かのために一肌脱ぐ\\nそれが近藤さんの教えだ",
   "en": "",
   "op": "0x62",
   "msg": "0x56f0"
  },
  {
   "id": "b_017001:0x1b0ec",
   "off": 110828,
   "max": 28,
   "kind": "dialogue",
   "jp": "脱ぐの意味が\\n違いますよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x56f1"
  },
  {
   "id": "b_017001:0x1b584",
   "off": 112004,
   "max": 60,
   "kind": "dialogue",
   "jp": "近藤さんを思い出せ\\nあの人は常日頃から\\n脱ぎまくっていた！",
   "en": "",
   "op": "0x62",
   "msg": "0x56f2"
  },
  {
   "id": "b_017001:0x1ba98",
   "off": 113304,
   "max": 24,
   "kind": "dialogue",
   "jp": "確かに\\nそうだけども！",
   "en": "",
   "op": "0x62",
   "msg": "0x56f3"
  },
  {
   "id": "b_017001:0x1c10c",
   "off": 114956,
   "max": 48,
   "kind": "dialogue",
   "jp": "ああ　僕\\n新選組に入ったの\\n早まったかな……",
   "en": "",
   "op": "0x62",
   "msg": "0x56f4"
  },
  {
   "id": "b_017001:0x1c6cc",
   "off": 116428,
   "max": 12,
   "kind": "dialogue",
   "jp": "とにかく",
   "en": "",
   "op": "0x62",
   "msg": "0x56f5"
  },
  {
   "id": "b_017001:0x1d284",
   "off": 119428,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方さんは\\n近藤さんの気持ちが\\n全然分かっちゃいない",
   "en": "",
   "op": "0x62",
   "msg": "0x56f6"
  },
  {
   "id": "b_017001:0x1d738",
   "off": 120632,
   "max": 72,
   "kind": "dialogue",
   "jp": "それはこっちの台詞だ\\nお前はその捻くれた根性を\\nそろそろ直した方がいい",
   "en": "",
   "op": "0x62",
   "msg": "0x56f7"
  },
  {
   "id": "b_017001:0x1d790",
   "off": 120720,
   "max": 56,
   "kind": "dialogue",
   "jp": "これも良い機会だ\\n近藤さんの目の前で\\n叩き直してやろう",
   "en": "",
   "op": "0x62",
   "msg": "0x56f8"
  },
  {
   "id": "b_017001:0x1dcdc",
   "off": 122076,
   "max": 40,
   "kind": "dialogue",
   "jp": "えっ　本当ですか？\\nそれは楽しみだなー",
   "en": "",
   "op": "0x62",
   "msg": "0x56f9"
  },
  {
   "id": "b_017001:0x1dd14",
   "off": 122132,
   "max": 24,
   "kind": "dialogue",
   "jp": "近藤さん\\n聞きました？",
   "en": "",
   "op": "0x62",
   "msg": "0x56fa"
  },
  {
   "id": "b_017001:0x1dd3c",
   "off": 122172,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方さんが　僕に\\n局長の肩書きを\\n譲ってくれるそうです",
   "en": "",
   "op": "0x62",
   "msg": "0x56fb"
  },
  {
   "id": "b_017001:0x1e3cc",
   "off": 123852,
   "max": 44,
   "kind": "dialogue",
   "jp": "言ったな？\\n軽口では済まさんぞ\\n総司……",
   "en": "",
   "op": "0x62",
   "msg": "0x56fc"
  },
  {
   "id": "b_017001:0x1eae0",
   "off": 125664,
   "max": 64,
   "kind": "dialogue",
   "jp": "土砂降りの雨に打たれつつ\\n土方と沖田は刀の鯉口に\\n手をかける",
   "en": "",
   "op": "0x62",
   "msg": "0x56fd"
  },
  {
   "id": "b_017001:0x1eb30",
   "off": 125744,
   "max": 28,
   "kind": "dialogue",
   "jp": "まさに一触即発の状況だった",
   "en": "",
   "op": "0x62",
   "msg": "0x56fe"
  },
  {
   "id": "b_017001:0x1eb5c",
   "off": 125788,
   "max": 68,
   "kind": "dialogue",
   "jp": "雨でぬかるんだ地面を\\n踏みしめ　互いの間合いを\\n詰める土方と沖田",
   "en": "",
   "op": "0x62",
   "msg": "0x56ff"
  },
  {
   "id": "b_017001:0x1ebb0",
   "off": 125872,
   "max": 76,
   "kind": "dialogue",
   "jp": "二人は近藤の墓前で刀を交え\\n殺気のこもった視線で相手を\\n睨みつける……",
   "en": "",
   "op": "0x62",
   "msg": "0x5700"
  },
  {
   "id": "b_017001:0x1ec0c",
   "off": 125964,
   "max": 12,
   "kind": "dialogue",
   "jp": "その時――",
   "en": "",
   "op": "0x62",
   "msg": "0x5701"
  },
  {
   "id": "b_017001:0x1f65c",
   "off": 128604,
   "max": 48,
   "kind": "dialogue",
   "jp": "突如として稲妻が走り\\n巨大な岩に雷が落ちた",
   "en": "",
   "op": "0x62",
   "msg": "0x5702"
  },
  {
   "id": "b_017001:0x1f6ac",
   "off": 128684,
   "max": 84,
   "kind": "dialogue",
   "jp": "落雷の衝撃で　岩は\\n真っ二つに割れ　それぞれ\\n土方と沖田の方へと\\n倒れ落ちてきた",
   "en": "",
   "op": "0x62",
   "msg": "0x5703"
  },
  {
   "id": "b_017001:0x20010",
   "off": 131088,
   "max": 20,
   "kind": "dialogue",
   "jp": "ぬおおおおおっ",
   "en": "",
   "op": "0x62",
   "msg": "0x5704"
  },
  {
   "id": "b_017001:0x206c4",
   "off": 132804,
   "max": 20,
   "kind": "dialogue",
   "jp": "やああぁぁぁっ",
   "en": "",
   "op": "0x62",
   "msg": "0x5705"
  },
  {
   "id": "b_017001:0x212ac",
   "off": 135852,
   "max": 32,
   "kind": "dialogue",
   "jp": "二人が同時に\\n刀を抜き払う！",
   "en": "",
   "op": "0x62",
   "msg": "0x5706"
  },
  {
   "id": "b_017001:0x212dc",
   "off": 135900,
   "max": 52,
   "kind": "dialogue",
   "jp": "二つに割れた岩は\\nガラガラと音を立てて\\n砕け散った",
   "en": "",
   "op": "0x62",
   "msg": "0x5707"
  },
  {
   "id": "b_017001:0x21320",
   "off": 135968,
   "max": 112,
   "kind": "dialogue",
   "jp": "突然襲った窮地を\\n脱した事を確認した二人は\\nお互いの顔から視線を\\n逸らさぬまま　どちらから\\nともなく歩み寄る",
   "en": "",
   "op": "0x62",
   "msg": "0x5708"
  },
  {
   "id": "b_017001:0x21914",
   "off": 137492,
   "max": 16,
   "kind": "dialogue",
   "jp": "総司\\nお前……",
   "en": "",
   "op": "0x62",
   "msg": "0x5709"
  },
  {
   "id": "b_017001:0x21da0",
   "off": 138656,
   "max": 44,
   "kind": "dialogue",
   "jp": "なぜ　俺の方に\\n倒れてきた岩を\\n斬った　",
   "en": "",
   "op": "0x62",
   "msg": "0x570a"
  },
  {
   "id": "b_017001:0x21ddc",
   "off": 138716,
   "max": 28,
   "kind": "dialogue",
   "jp": "まずは\\n自分の身を守れ！",
   "en": "",
   "op": "0x62",
   "msg": "0x570b"
  },
  {
   "id": "b_017001:0x2230c",
   "off": 140044,
   "max": 52,
   "kind": "dialogue",
   "jp": "その台詞　\\nそっくりそのまま\\n土方さんに返します",
   "en": "",
   "op": "0x62",
   "msg": "0x570c"
  },
  {
   "id": "b_017001:0x22350",
   "off": 140112,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方さんこそ\\n僕の方に倒れてきた\\n岩を斬ったでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x570d"
  },
  {
   "id": "b_017001:0x228a0",
   "off": 141472,
   "max": 40,
   "kind": "dialogue",
   "jp": "そ　それは……\\n咄嗟に体が動いたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x570e"
  },
  {
   "id": "b_017001:0x22ddc",
   "off": 142812,
   "max": 60,
   "kind": "dialogue",
   "jp": "……僕も同じですよ\\n頭で考える前に\\n勝手に体が動いたんです",
   "en": "",
   "op": "0x62",
   "msg": "0x570f"
  },
  {
   "id": "b_017001:0x231c4",
   "off": 143812,
   "max": 112,
   "kind": "dialogue",
   "jp": "巨大な岩が二人に\\n襲い掛かってきた時\\n土方は沖田の目前の岩に\\n沖田は土方の目前の岩に\\n咄嗟に斬りかかっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x5710"
  },
  {
   "id": "b_017001:0x235d8",
   "off": 144856,
   "max": 36,
   "kind": "dialogue",
   "jp": "……今の雷はきっと\\n近藤さんだな",
   "en": "",
   "op": "0x62",
   "msg": "0x5711"
  },
  {
   "id": "b_017001:0x2360c",
   "off": 144908,
   "max": 48,
   "kind": "dialogue",
   "jp": "仲違いを\\nしていた俺達を\\nいさめてくれたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5712"
  },
  {
   "id": "b_017001:0x23b50",
   "off": 146256,
   "max": 16,
   "kind": "dialogue",
   "jp": "……ですかね",
   "en": "",
   "op": "0x62",
   "msg": "0x5713"
  },
  {
   "id": "b_017001:0x23b70",
   "off": 146288,
   "max": 68,
   "kind": "dialogue",
   "jp": "二人ともいい加減にしろ\\nって　近藤さんの声が\\n聞こえた気がします",
   "en": "",
   "op": "0x62",
   "msg": "0x5714"
  },
  {
   "id": "b_017001:0x2403c",
   "off": 147516,
   "max": 12,
   "kind": "dialogue",
   "jp": "ああ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5715"
  },
  {
   "id": "b_017001:0x243f4",
   "off": 148468,
   "max": 88,
   "kind": "dialogue",
   "jp": "二人は会話を交わしながら\\n改めて近藤の墓前を見つめる\\nその口元には\\n笑みが浮かんでいた",
   "en": "",
   "op": "0x62",
   "msg": "0x5716"
  },
  {
   "id": "b_017001:0x247f0",
   "off": 149488,
   "max": 60,
   "kind": "dialogue",
   "jp": "近藤さん　すまなかった\\nこんなつまらない争いは\\nもうしない",
   "en": "",
   "op": "0x62",
   "msg": "0x5717"
  },
  {
   "id": "b_017001:0x24d40",
   "off": 150848,
   "max": 72,
   "kind": "dialogue",
   "jp": "近藤さん　ごめんなさい\\n土方さんとは出来るだけ\\n仲良くやっていきます",
   "en": "",
   "op": "0x62",
   "msg": "0x5718"
  },
  {
   "id": "b_017001:0x25134",
   "off": 151860,
   "max": 60,
   "kind": "dialogue",
   "jp": "近藤の墓前に\\n誓いを立てると\\n土方と沖田は\\n刀を鞘に収めた",
   "en": "",
   "op": "0x62",
   "msg": "0x5719"
  },
  {
   "id": "b_017001:0x25398",
   "off": 152472,
   "max": 48,
   "kind": "dialogue",
   "jp": "すると先程までの雨がやみ\\n再び夕日が顔を出した",
   "en": "",
   "op": "0x62",
   "msg": "0x571a"
  },
  {
   "id": "b_017001:0x253d8",
   "off": 152536,
   "max": 72,
   "kind": "dialogue",
   "jp": "まるで自分たちの仲直りを\\n近藤が喜んでいるようだと\\n二人は思った――",
   "en": "",
   "op": "0x62",
   "msg": "0x571b"
  },
  {
   "id": "b_017001:0x257c4",
   "off": 153540,
   "max": 24,
   "kind": "dialogue",
   "jp": "そろそろ\\n屯所に戻るか",
   "en": "",
   "op": "0x62",
   "msg": "0x571c"
  },
  {
   "id": "b_017001:0x25cf0",
   "off": 154864,
   "max": 8,
   "kind": "dialogue",
   "jp": "はい",
   "en": "",
   "op": "0x62",
   "msg": "0x571d"
  },
  {
   "id": "b_017001:0x26274",
   "off": 156276,
   "max": 48,
   "kind": "dialogue",
   "jp": "近藤の墓前に一礼して\\n二人はゆっくり歩きだす",
   "en": "",
   "op": "0x62",
   "msg": "0x571e"
  },
  {
   "id": "b_017001:0x26898",
   "off": 157848,
   "max": 24,
   "kind": "dialogue",
   "jp": "それにしても土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x571f"
  },
  {
   "id": "b_017001:0x268c0",
   "off": 157888,
   "max": 56,
   "kind": "dialogue",
   "jp": "岩に雷が落ちた時\\n腰が抜けそうなほど\\n驚いてましたね",
   "en": "",
   "op": "0x62",
   "msg": "0x5720"
  },
  {
   "id": "b_017001:0x26e10",
   "off": 159248,
   "max": 56,
   "kind": "dialogue",
   "jp": "当たり前だろう\\nあんな近くに落雷したんだ\\n誰だって驚く",
   "en": "",
   "op": "0x62",
   "msg": "0x5721"
  },
  {
   "id": "b_017001:0x272c4",
   "off": 160452,
   "max": 60,
   "kind": "dialogue",
   "jp": "鬼の土方も　雷の前では\\n泣いて逃げるしかない\\nって訳ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x5722"
  },
  {
   "id": "b_017001:0x27310",
   "off": 160528,
   "max": 60,
   "kind": "dialogue",
   "jp": "この話　スカシくんや\\nトサカくんが聞いたら\\n喜びそうだなー",
   "en": "",
   "op": "0x62",
   "msg": "0x5723"
  },
  {
   "id": "b_017001:0x277d0",
   "off": 161744,
   "max": 68,
   "kind": "dialogue",
   "jp": "おい　坂本はともかく\\n高杉に話すのはよせ\\nあとで面倒なことに――",
   "en": "",
   "op": "0x62",
   "msg": "0x5724"
  },
  {
   "id": "b_017001:0x2822c",
   "off": 164396,
   "max": 28,
   "kind": "dialogue",
   "jp": "さっそく\\n話さなくちゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5725"
  },
  {
   "id": "b_017001:0x2898c",
   "off": 166284,
   "max": 32,
   "kind": "dialogue",
   "jp": "あっ　おい\\nくそっ　あいつ",
   "en": "",
   "op": "0x62",
   "msg": "0x5726"
  },
  {
   "id": "b_017001:0x289bc",
   "off": 166332,
   "max": 48,
   "kind": "dialogue",
   "jp": "止まれ総司！\\n止まらなければ\\n斬って捨てる",
   "en": "",
   "op": "0x62",
   "msg": "0x5727"
  },
  {
   "id": "b_017001:0x29054",
   "off": 168020,
   "max": 84,
   "kind": "dialogue",
   "jp": "いつしか空は晴れ渡り\\n傾きかけた夕日を受けて\\n近藤の墓から落ちる滴が\\nきらりと光る",
   "en": "",
   "op": "0x62",
   "msg": "0x5728"
  },
  {
   "id": "b_017001:0x290b8",
   "off": 168120,
   "max": 64,
   "kind": "dialogue",
   "jp": "近藤勇の魂が\\n安らかに眠りにつける日は\\n当分　訪れなさそうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5729"
  }
 ]
}
