{
 "source": "b_018001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_018001:0x10e8",
   "off": 4328,
   "max": 88,
   "kind": "dialogue",
   "jp": "徳川家康が幕府を築き\\n世を平定してから\\n二百余年――\\n長きに渡る安寧の世が\\n続いている",
   "en": "",
   "op": "0x62",
   "msg": "0x575b"
  },
  {
   "id": "b_018001:0x1150",
   "off": 4432,
   "max": 100,
   "kind": "dialogue",
   "jp": "若くして彦根藩の家督を\\n継いだその男は　有り余る\\n才覚を以て頭角を現し\\n大志を抱いて江戸へと上った",
   "en": "",
   "op": "0x62",
   "msg": "0x575c"
  },
  {
   "id": "b_018001:0x11c4",
   "off": 4548,
   "max": 80,
   "kind": "dialogue",
   "jp": "江戸へと上り――\\nそして\\n僅か一年ばかりの間に\\n絶望の淵へと\\n追いやられていた",
   "en": "",
   "op": "0x62",
   "msg": "0x575d"
  },
  {
   "id": "b_018001:0x192c",
   "off": 6444,
   "max": 48,
   "kind": "dialogue",
   "jp": "どうして私の案が\\n取り入れられない\\nのですか！",
   "en": "",
   "op": "0x62",
   "msg": "0x575e"
  },
  {
   "id": "b_018001:0x1f18",
   "off": 7960,
   "max": 84,
   "kind": "dialogue",
   "jp": "江戸幕府の溜詰筆頭である侍\\n井伊直弼は　物怖じもせずに\\n目の前の老人たちへと迫った",
   "en": "",
   "op": "0x62",
   "msg": "0x575f"
  },
  {
   "id": "b_018001:0x23b0",
   "off": 9136,
   "max": 36,
   "kind": "dialogue",
   "jp": "井伊殿の案？\\nさて　何だったか……",
   "en": "",
   "op": "0x62",
   "msg": "0x5760"
  },
  {
   "id": "b_018001:0x2854",
   "off": 10324,
   "max": 36,
   "kind": "dialogue",
   "jp": "とぼけるのは\\nやめていただきたい",
   "en": "",
   "op": "0x62",
   "msg": "0x5761"
  },
  {
   "id": "b_018001:0x2888",
   "off": 10376,
   "max": 36,
   "kind": "dialogue",
   "jp": "先日提案した\\n治水工事の提案書です",
   "en": "",
   "op": "0x62",
   "msg": "0x5762"
  },
  {
   "id": "b_018001:0x2d28",
   "off": 11560,
   "max": 52,
   "kind": "dialogue",
   "jp": "おお　その件か\\nもちろん　老中の間で\\n検討したぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x5763"
  },
  {
   "id": "b_018001:0x2d70",
   "off": 11632,
   "max": 36,
   "kind": "dialogue",
   "jp": "さすがは天才と\\n呼ばれることはある",
   "en": "",
   "op": "0x62",
   "msg": "0x5764"
  },
  {
   "id": "b_018001:0x3214",
   "off": 12820,
   "max": 44,
   "kind": "dialogue",
   "jp": "まさに水も漏らさぬ\\n完璧な提案書であった",
   "en": "",
   "op": "0x62",
   "msg": "0x5765"
  },
  {
   "id": "b_018001:0x36c0",
   "off": 14016,
   "max": 40,
   "kind": "dialogue",
   "jp": "そうです\\nあの計画書は完璧\\nだったはず",
   "en": "",
   "op": "0x62",
   "msg": "0x5766"
  },
  {
   "id": "b_018001:0x36f8",
   "off": 14072,
   "max": 20,
   "kind": "dialogue",
   "jp": "ならばどうして――",
   "en": "",
   "op": "0x62",
   "msg": "0x5767"
  },
  {
   "id": "b_018001:0x3ba4",
   "off": 15268,
   "max": 76,
   "kind": "dialogue",
   "jp": "老中たちが　口元を隠して\\n漏らす笑いには　明らかな\\n嘲りの色が含まれている",
   "en": "",
   "op": "0x62",
   "msg": "0x5768"
  },
  {
   "id": "b_018001:0x3c00",
   "off": 15360,
   "max": 72,
   "kind": "dialogue",
   "jp": "笑い声が聞こえた方に\\n井伊が視線を向けると\\n老中たちはぴたりと黙った",
   "en": "",
   "op": "0x62",
   "msg": "0x5769"
  },
  {
   "id": "b_018001:0x408c",
   "off": 16524,
   "max": 8,
   "kind": "dialogue",
   "jp": "首座殿",
   "en": "",
   "op": "0x62",
   "msg": "0x576a"
  },
  {
   "id": "b_018001:0x4510",
   "off": 17680,
   "max": 56,
   "kind": "dialogue",
   "jp": "老中筆頭の貴殿から\\n納得のいく理由を\\nお聞かせ願いたい",
   "en": "",
   "op": "0x62",
   "msg": "0x576b"
  },
  {
   "id": "b_018001:0x49c4",
   "off": 18884,
   "max": 28,
   "kind": "dialogue",
   "jp": "やれやれ……\\n面倒なことだ",
   "en": "",
   "op": "0x62",
   "msg": "0x576c"
  },
  {
   "id": "b_018001:0x49f4",
   "off": 18932,
   "max": 28,
   "kind": "dialogue",
   "jp": "よく聞け\\n一度しか言わぬ",
   "en": "",
   "op": "0x62",
   "msg": "0x576d"
  },
  {
   "id": "b_018001:0x4a24",
   "off": 18980,
   "max": 32,
   "kind": "dialogue",
   "jp": "完璧だったから\\n却下されたのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x576e"
  },
  {
   "id": "b_018001:0x54c0",
   "off": 21696,
   "max": 36,
   "kind": "dialogue",
   "jp": "そんな説明では\\n納得できません！",
   "en": "",
   "op": "0x62",
   "msg": "0x576f"
  },
  {
   "id": "b_018001:0x5d24",
   "off": 23844,
   "max": 52,
   "kind": "dialogue",
   "jp": "井伊殿\\n徳川の世は安定しておる\\nわしらのおかげでな",
   "en": "",
   "op": "0x62",
   "msg": "0x5770"
  },
  {
   "id": "b_018001:0x5d6c",
   "off": 23916,
   "max": 64,
   "kind": "dialogue",
   "jp": "何も変える必要はない\\n何も変えてはいけない\\nそれがわからんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5771"
  },
  {
   "id": "b_018001:0x622c",
   "off": 25132,
   "max": 24,
   "kind": "dialogue",
   "jp": "それは違います\\nご老中",
   "en": "",
   "op": "0x62",
   "msg": "0x5772"
  },
  {
   "id": "b_018001:0x66c0",
   "off": 26304,
   "max": 44,
   "kind": "dialogue",
   "jp": "違わぬのだよ\\n分からぬのなら\\n仕方あるまい",
   "en": "",
   "op": "0x62",
   "msg": "0x5773"
  },
  {
   "id": "b_018001:0x6708",
   "off": 26376,
   "max": 28,
   "kind": "dialogue",
   "jp": "井伊直弼\\n貴殿の任を解く",
   "en": "",
   "op": "0x62",
   "msg": "0x5774"
  },
  {
   "id": "b_018001:0x6c40",
   "off": 27712,
   "max": 20,
   "kind": "dialogue",
   "jp": "……なんですと？",
   "en": "",
   "op": "0x62",
   "msg": "0x5775"
  },
  {
   "id": "b_018001:0x70d0",
   "off": 28880,
   "max": 52,
   "kind": "dialogue",
   "jp": "今後　幕府の政策に\\n口を挟むこと\\n一切　罷りならん",
   "en": "",
   "op": "0x62",
   "msg": "0x5776"
  },
  {
   "id": "b_018001:0x7118",
   "off": 28952,
   "max": 32,
   "kind": "dialogue",
   "jp": "しばらく登城する\\n必要もないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x5777"
  },
  {
   "id": "b_018001:0x714c",
   "off": 29004,
   "max": 16,
   "kind": "dialogue",
   "jp": "話はそれだけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5778"
  },
  {
   "id": "b_018001:0x76cc",
   "off": 30412,
   "max": 12,
   "kind": "dialogue",
   "jp": "ご老中！",
   "en": "",
   "op": "0x62",
   "msg": "0x5779"
  },
  {
   "id": "b_018001:0x7b78",
   "off": 31608,
   "max": 72,
   "kind": "dialogue",
   "jp": "老中たちが去っていった\\nふすまの向こうから\\n嘲笑の声が響いて聞こえた",
   "en": "",
   "op": "0x62",
   "msg": "0x577a"
  },
  {
   "id": "b_018001:0x81b0",
   "off": 33200,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x577b"
  },
  {
   "id": "b_018001:0x81cc",
   "off": 33228,
   "max": 44,
   "kind": "dialogue",
   "jp": "変化を恐れ　利権に\\nしがみつく老害どもめ",
   "en": "",
   "op": "0x62",
   "msg": "0x577c"
  },
  {
   "id": "b_018001:0x8208",
   "off": 33288,
   "max": 52,
   "kind": "dialogue",
   "jp": "進歩と改善の余地は\\nいくらでもあると\\n言うのに……",
   "en": "",
   "op": "0x62",
   "msg": "0x577d"
  },
  {
   "id": "b_018001:0x824c",
   "off": 33356,
   "max": 56,
   "kind": "dialogue",
   "jp": "いずれ正しいのは\\n私だということを\\n世の中が思い知る",
   "en": "",
   "op": "0x62",
   "msg": "0x577e"
  },
  {
   "id": "b_018001:0x8700",
   "off": 34560,
   "max": 12,
   "kind": "dialogue",
   "jp": "しかし――",
   "en": "",
   "op": "0x62",
   "msg": "0x577f"
  },
  {
   "id": "b_018001:0x8b9c",
   "off": 35740,
   "max": 92,
   "kind": "dialogue",
   "jp": "それは　あの老人たちが\\n死に絶えるまで　井伊に\\n順番が回ってこないという\\n意味でもあった",
   "en": "",
   "op": "0x62",
   "msg": "0x5780"
  },
  {
   "id": "b_018001:0x8c1c",
   "off": 35868,
   "max": 44,
   "kind": "dialogue",
   "jp": "胸中の想いを吐き出すと\\n井伊は空を見上げた",
   "en": "",
   "op": "0x62",
   "msg": "0x5781"
  },
  {
   "id": "b_018001:0x8c58",
   "off": 35928,
   "max": 48,
   "kind": "dialogue",
   "jp": "その瞬間　奇妙な光景が\\n視界に飛び込んできた",
   "en": "",
   "op": "0x62",
   "msg": "0x5782"
  },
  {
   "id": "b_018001:0x8f90",
   "off": 36752,
   "max": 12,
   "kind": "dialogue",
   "jp": "あわわっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5783"
  },
  {
   "id": "b_018001:0x9560",
   "off": 38240,
   "max": 12,
   "kind": "dialogue",
   "jp": "なにっ",
   "en": "",
   "op": "0x62",
   "msg": "0x5784"
  },
  {
   "id": "b_018001:0x9918",
   "off": 39192,
   "max": 80,
   "kind": "dialogue",
   "jp": "内郭の庭に建てられた御殿の\\n三階の窓縁から　今まさに\\n人影が落ちようとしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x5785"
  },
  {
   "id": "b_018001:0x9c98",
   "off": 40088,
   "max": 12,
   "kind": "dialogue",
   "jp": "いかんっ",
   "en": "",
   "op": "0x62",
   "msg": "0x5786"
  },
  {
   "id": "b_018001:0xa0e4",
   "off": 41188,
   "max": 40,
   "kind": "dialogue",
   "jp": "井伊が地を蹴って\\n落下地点へと走り込む",
   "en": "",
   "op": "0x62",
   "msg": "0x5787"
  },
  {
   "id": "b_018001:0xa414",
   "off": 42004,
   "max": 48,
   "kind": "dialogue",
   "jp": "あの高さからだ\\n受け止めきれるか？\\nいや――",
   "en": "",
   "op": "0x62",
   "msg": "0x5788"
  },
  {
   "id": "b_018001:0xa8d4",
   "off": 43220,
   "max": 40,
   "kind": "dialogue",
   "jp": "冷静な思考よりも\\n体が先に動いていた",
   "en": "",
   "op": "0x62",
   "msg": "0x5789"
  },
  {
   "id": "b_018001:0xa90c",
   "off": 43276,
   "max": 52,
   "kind": "dialogue",
   "jp": "井伊が衝撃に備えて\\n腰を落とし全身に力を\\n込める",
   "en": "",
   "op": "0x62",
   "msg": "0x578a"
  },
  {
   "id": "b_018001:0xad8c",
   "off": 44428,
   "max": 12,
   "kind": "dialogue",
   "jp": "むうっ",
   "en": "",
   "op": "0x62",
   "msg": "0x578b"
  },
  {
   "id": "b_018001:0xb144",
   "off": 45380,
   "max": 52,
   "kind": "dialogue",
   "jp": "しかし\\n予想していた\\n衝撃は伝わって\\nこなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x578c"
  },
  {
   "id": "b_018001:0xb494",
   "off": 46228,
   "max": 28,
   "kind": "dialogue",
   "jp": "な　なんだ\\nこれは……？",
   "en": "",
   "op": "0x62",
   "msg": "0x578d"
  },
  {
   "id": "b_018001:0xbc48",
   "off": 48200,
   "max": 80,
   "kind": "dialogue",
   "jp": "落ちてきた人物は\\n井伊の腕の中で\\n淡い光に包まれながら\\nふわふわと浮いている",
   "en": "",
   "op": "0x62",
   "msg": "0x578e"
  },
  {
   "id": "b_018001:0xc528",
   "off": 50472,
   "max": 36,
   "kind": "dialogue",
   "jp": "子供？\\n男の子……か？\\nおっと！",
   "en": "",
   "op": "0x62",
   "msg": "0x578f"
  },
  {
   "id": "b_018001:0xcae4",
   "off": 51940,
   "max": 84,
   "kind": "dialogue",
   "jp": "不意に少年の身体を\\n包んでいた淡い光が消え\\n井伊の腕にずしりと\\n重みが伝わってきた",
   "en": "",
   "op": "0x62",
   "msg": "0x5790"
  },
  {
   "id": "b_018001:0xd0cc",
   "off": 53452,
   "max": 12,
   "kind": "dialogue",
   "jp": "またか……",
   "en": "",
   "op": "0x62",
   "msg": "0x5791"
  },
  {
   "id": "b_018001:0xd554",
   "off": 54612,
   "max": 28,
   "kind": "dialogue",
   "jp": "大丈夫か？\\n怪我はないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5792"
  },
  {
   "id": "b_018001:0xda88",
   "off": 55944,
   "max": 44,
   "kind": "dialogue",
   "jp": "あ　うん\\n予は大丈夫だよ\\nどこも痛くない",
   "en": "",
   "op": "0x62",
   "msg": "0x5793"
  },
  {
   "id": "b_018001:0xdfcc",
   "off": 57292,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうか\\n良かった",
   "en": "",
   "op": "0x62",
   "msg": "0x5794"
  },
  {
   "id": "b_018001:0xe45c",
   "off": 58460,
   "max": 24,
   "kind": "dialogue",
   "jp": "お前が助けてくれたの？",
   "en": "",
   "op": "0x62",
   "msg": "0x5795"
  },
  {
   "id": "b_018001:0xe98c",
   "off": 59788,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうだ\\nいや　どうだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x5796"
  },
  {
   "id": "b_018001:0xf240",
   "off": 62016,
   "max": 60,
   "kind": "dialogue",
   "jp": "私が助けなくても\\n地面に激突することは\\nなかったかも――",
   "en": "",
   "op": "0x62",
   "msg": "0x5797"
  },
  {
   "id": "b_018001:0xf998",
   "off": 63896,
   "max": 24,
   "kind": "dialogue",
   "jp": "ねえ\\n名前を教えてよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5798"
  },
  {
   "id": "b_018001:0xfff4",
   "off": 65524,
   "max": 32,
   "kind": "dialogue",
   "jp": "私の名前か？\\n井伊直弼という",
   "en": "",
   "op": "0x62",
   "msg": "0x5799"
  },
  {
   "id": "b_018001:0x10a1c",
   "off": 68124,
   "max": 24,
   "kind": "dialogue",
   "jp": "そうか\\nありがとう直弼",
   "en": "",
   "op": "0x62",
   "msg": "0x579a"
  },
  {
   "id": "b_018001:0x111f4",
   "off": 70132,
   "max": 32,
   "kind": "dialogue",
   "jp": "う　いや　その\\n無事でよかった",
   "en": "",
   "op": "0x62",
   "msg": "0x579b"
  },
  {
   "id": "b_018001:0x116bc",
   "off": 71356,
   "max": 72,
   "kind": "dialogue",
   "jp": "少年が浮かべている\\n春の陽ざしのような笑顔に\\n井伊は目を細めて笑い返す",
   "en": "",
   "op": "0x62",
   "msg": "0x579c"
  },
  {
   "id": "b_018001:0x11714",
   "off": 71444,
   "max": 112,
   "kind": "dialogue",
   "jp": "張り詰めた江戸での生活の\\n中で　思い返せば\\n前に笑ったのがいつだった\\nのかすら　井伊は\\n思い出せなくなっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x579d"
  },
  {
   "id": "b_018001:0x11bc8",
   "off": 72648,
   "max": 60,
   "kind": "dialogue",
   "jp": "あっ　そうだ\\n人に名前を尋ねる時は\\n自分から名乗るんだった",
   "en": "",
   "op": "0x62",
   "msg": "0x579e"
  },
  {
   "id": "b_018001:0x12288",
   "off": 74376,
   "max": 40,
   "kind": "dialogue",
   "jp": "予は一橋慶喜という\\nよろしくね　直弼",
   "en": "",
   "op": "0x62",
   "msg": "0x579f"
  },
  {
   "id": "b_018001:0x127c4",
   "off": 75716,
   "max": 44,
   "kind": "dialogue",
   "jp": "井伊の腕の中で\\n少年がにっこりと微笑んだ",
   "en": "",
   "op": "0x62",
   "msg": "0x57a0"
  },
  {
   "id": "b_018001:0x12800",
   "off": 75776,
   "max": 20,
   "kind": "dialogue",
   "jp": "それが一橋慶喜――",
   "en": "",
   "op": "0x62",
   "msg": "0x57a1"
  },
  {
   "id": "b_018001:0x12824",
   "off": 75812,
   "max": 56,
   "kind": "dialogue",
   "jp": "後の第十五代将軍\\n徳川慶喜と井伊直弼の\\n出会いであった",
   "en": "",
   "op": "0x62",
   "msg": "0x57a2"
  },
  {
   "id": "b_018001:0x1286c",
   "off": 75884,
   "max": 64,
   "kind": "dialogue",
   "jp": "その日を境に　井伊は\\nたびたび慶喜の下へ\\n訪れるようになった",
   "en": "",
   "op": "0x62",
   "msg": "0x57a3"
  },
  {
   "id": "b_018001:0x12df4",
   "off": 77300,
   "max": 44,
   "kind": "dialogue",
   "jp": "それは　江戸城内にある\\n薄暗い一室だった",
   "en": "",
   "op": "0x62",
   "msg": "0x57a4"
  },
  {
   "id": "b_018001:0x133a8",
   "off": 78760,
   "max": 48,
   "kind": "dialogue",
   "jp": "ここにずっと\\nおられるのですか\\nおひとりで……",
   "en": "",
   "op": "0x62",
   "msg": "0x57a5"
  },
  {
   "id": "b_018001:0x13854",
   "off": 79956,
   "max": 36,
   "kind": "dialogue",
   "jp": "ごはんはきちんと\\nもらえるからね",
   "en": "",
   "op": "0x62",
   "msg": "0x57a6"
  },
  {
   "id": "b_018001:0x13888",
   "off": 80008,
   "max": 36,
   "kind": "dialogue",
   "jp": "不便はないよ\\n皆には感謝している",
   "en": "",
   "op": "0x62",
   "msg": "0x57a7"
  },
  {
   "id": "b_018001:0x13dc4",
   "off": 81348,
   "max": 56,
   "kind": "dialogue",
   "jp": "それに　最近は\\n直弼が来てくれるから\\n寂しくないんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x57a8"
  },
  {
   "id": "b_018001:0x14314",
   "off": 82708,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x57a9"
  },
  {
   "id": "b_018001:0x14330",
   "off": 82736,
   "max": 48,
   "kind": "dialogue",
   "jp": "慶喜様\\nひとつお聞きしても\\nよろしいですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x57aa"
  },
  {
   "id": "b_018001:0x14878",
   "off": 84088,
   "max": 8,
   "kind": "dialogue",
   "jp": "なに？",
   "en": "",
   "op": "0x62",
   "msg": "0x57ab"
  },
  {
   "id": "b_018001:0x14cfc",
   "off": 85244,
   "max": 68,
   "kind": "dialogue",
   "jp": "私が慶喜様を助けた時\\nまたか　と申されました\\nどういう意味でしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x57ac"
  },
  {
   "id": "b_018001:0x151bc",
   "off": 86460,
   "max": 48,
   "kind": "dialogue",
   "jp": "ああ\\n予はよくああいう目に\\n遭うんだ　だから",
   "en": "",
   "op": "0x62",
   "msg": "0x57ad"
  },
  {
   "id": "b_018001:0x15668",
   "off": 87656,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああいう目\\nとは？",
   "en": "",
   "op": "0x62",
   "msg": "0x57ae"
  },
  {
   "id": "b_018001:0x15f70",
   "off": 89968,
   "max": 68,
   "kind": "dialogue",
   "jp": "高いところから落ちたり\\n重いものが落ちてきたり\\n階段を踏み外したり",
   "en": "",
   "op": "0x62",
   "msg": "0x57af"
  },
  {
   "id": "b_018001:0x15fc4",
   "off": 90052,
   "max": 60,
   "kind": "dialogue",
   "jp": "この間は\\n露台（バルコニー）が\\nたまたま腐っていたみたい",
   "en": "",
   "op": "0x62",
   "msg": "0x57b0"
  },
  {
   "id": "b_018001:0x16838",
   "off": 92216,
   "max": 12,
   "kind": "dialogue",
   "jp": "たまたま？",
   "en": "",
   "op": "0x62",
   "msg": "0x57b1"
  },
  {
   "id": "b_018001:0x16f08",
   "off": 93960,
   "max": 44,
   "kind": "dialogue",
   "jp": "そう　たまたま\\n予は運が悪いのかな\\nあはは",
   "en": "",
   "op": "0x62",
   "msg": "0x57b2"
  },
  {
   "id": "b_018001:0x1744c",
   "off": 95308,
   "max": 36,
   "kind": "dialogue",
   "jp": "露台には　よく\\n行かれるのですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x57b3"
  },
  {
   "id": "b_018001:0x17988",
   "off": 96648,
   "max": 28,
   "kind": "dialogue",
   "jp": "うん\\n歌を歌おうと思って",
   "en": "",
   "op": "0x62",
   "msg": "0x57b4"
  },
  {
   "id": "b_018001:0x17e20",
   "off": 97824,
   "max": 12,
   "kind": "dialogue",
   "jp": "歌\\nですか",
   "en": "",
   "op": "0x62",
   "msg": "0x57b5"
  },
  {
   "id": "b_018001:0x18344",
   "off": 99140,
   "max": 44,
   "kind": "dialogue",
   "jp": "青空の下で歌うと\\nとても気持ちがいいんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x57b6"
  },
  {
   "id": "b_018001:0x18380",
   "off": 99200,
   "max": 36,
   "kind": "dialogue",
   "jp": "そうだ！\\n直弼にも聴かせてあげる！",
   "en": "",
   "op": "0x62",
   "msg": "0x57b7"
  },
  {
   "id": "b_018001:0x18928",
   "off": 100648,
   "max": 64,
   "kind": "dialogue",
   "jp": "慶喜はすっくと\\n立ち上がると\\n胸に手を当てて\\n静かに歌い始めた",
   "en": "",
   "op": "0x62",
   "msg": "0x57b8"
  },
  {
   "id": "b_018001:0x18978",
   "off": 100728,
   "max": 52,
   "kind": "dialogue",
   "jp": "慶喜の歌声が響き\\n仄暗い部屋の中を\\n満たしていく",
   "en": "",
   "op": "0x62",
   "msg": "0x57b9"
  },
  {
   "id": "b_018001:0x189bc",
   "off": 100796,
   "max": 72,
   "kind": "dialogue",
   "jp": "それは慶喜の笑顔と同じ\\nやわらかな陽の光のように\\n井伊を優しく包んだ",
   "en": "",
   "op": "0x62",
   "msg": "0x57ba"
  },
  {
   "id": "b_018001:0x18fb4",
   "off": 102324,
   "max": 28,
   "kind": "dialogue",
   "jp": "なんと……\\n素晴らしい……",
   "en": "",
   "op": "0x62",
   "msg": "0x57bb"
  },
  {
   "id": "b_018001:0x194fc",
   "off": 103676,
   "max": 52,
   "kind": "dialogue",
   "jp": "そう呟きながら\\n井伊は自分の頬に伝う\\n涙に気付く",
   "en": "",
   "op": "0x62",
   "msg": "0x57bc"
  },
  {
   "id": "b_018001:0x19838",
   "off": 104504,
   "max": 60,
   "kind": "dialogue",
   "jp": "私は　まだこのような\\n暖かい涙を流すことが\\nできたのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x57bd"
  },
  {
   "id": "b_018001:0x19c24",
   "off": 105508,
   "max": 36,
   "kind": "dialogue",
   "jp": "この時　井伊は\\nはっきりと自覚した",
   "en": "",
   "op": "0x62",
   "msg": "0x57be"
  },
  {
   "id": "b_018001:0x19c58",
   "off": 105560,
   "max": 72,
   "kind": "dialogue",
   "jp": "暇潰しや同情などではなく\\n自分は慶喜という存在に\\n惹かれているのだと",
   "en": "",
   "op": "0x62",
   "msg": "0x57bf"
  },
  {
   "id": "b_018001:0x1a228",
   "off": 107048,
   "max": 16,
   "kind": "dialogue",
   "jp": "どうだった？",
   "en": "",
   "op": "0x62",
   "msg": "0x57c0"
  },
  {
   "id": "b_018001:0x1a248",
   "off": 107080,
   "max": 60,
   "kind": "dialogue",
   "jp": "あんまり上手じゃないけど\\n直弼のことを思って\\n歌ったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x57c1"
  },
  {
   "id": "b_018001:0x1a79c",
   "off": 108444,
   "max": 52,
   "kind": "dialogue",
   "jp": "ありがとうございます\\nこの直弼\\n感服いたしました",
   "en": "",
   "op": "0x62",
   "msg": "0x57c2"
  },
  {
   "id": "b_018001:0x1ace8",
   "off": 109800,
   "max": 44,
   "kind": "dialogue",
   "jp": "えっ　そんな\\nほめ過ぎだよ\\n照れくさいな",
   "en": "",
   "op": "0x62",
   "msg": "0x57c3"
  },
  {
   "id": "b_018001:0x1b190",
   "off": 110992,
   "max": 52,
   "kind": "dialogue",
   "jp": "いえ\\nそんなことはありません\\n心に染み入りました",
   "en": "",
   "op": "0x62",
   "msg": "0x57c4"
  },
  {
   "id": "b_018001:0x1b740",
   "off": 112448,
   "max": 32,
   "kind": "dialogue",
   "jp": "それは本心からの\\n言葉だった",
   "en": "",
   "op": "0x62",
   "msg": "0x57c5"
  },
  {
   "id": "b_018001:0x1b770",
   "off": 112496,
   "max": 48,
   "kind": "dialogue",
   "jp": "井伊は見つけたのだ\\n己が信じられる存在を――",
   "en": "",
   "op": "0x62",
   "msg": "0x57c6"
  },
  {
   "id": "b_018001:0x1bce4",
   "off": 113892,
   "max": 40,
   "kind": "dialogue",
   "jp": "翌日　井伊は再び\\n老中たちの下を訪れた",
   "en": "",
   "op": "0x62",
   "msg": "0x57c7"
  },
  {
   "id": "b_018001:0x1c150",
   "off": 115024,
   "max": 40,
   "kind": "dialogue",
   "jp": "登城の必要はないと\\n申し付けたはずだが",
   "en": "",
   "op": "0x62",
   "msg": "0x57c8"
  },
  {
   "id": "b_018001:0x1c5f8",
   "off": 116216,
   "max": 40,
   "kind": "dialogue",
   "jp": "そのことでお願いがあり\\n参上仕りました",
   "en": "",
   "op": "0x62",
   "msg": "0x57c9"
  },
  {
   "id": "b_018001:0x1ca9c",
   "off": 117404,
   "max": 40,
   "kind": "dialogue",
   "jp": "願い？\\n溜詰への復職か？\\n話にもならん",
   "en": "",
   "op": "0x62",
   "msg": "0x57ca"
  },
  {
   "id": "b_018001:0x1cf44",
   "off": 118596,
   "max": 40,
   "kind": "dialogue",
   "jp": "いえ　一橋慶喜様の\\n世話役を賜りたく",
   "en": "",
   "op": "0x62",
   "msg": "0x57cb"
  },
  {
   "id": "b_018001:0x1d750",
   "off": 120656,
   "max": 16,
   "kind": "dialogue",
   "jp": "一橋慶喜だと？",
   "en": "",
   "op": "0x62",
   "msg": "0x57cc"
  },
  {
   "id": "b_018001:0x1dbf4",
   "off": 121844,
   "max": 68,
   "kind": "dialogue",
   "jp": "老中は　ねっとりとした\\n視線で　頭を垂れている\\n井伊を眺めまわす",
   "en": "",
   "op": "0x62",
   "msg": "0x57cd"
  },
  {
   "id": "b_018001:0x1dc48",
   "off": 121928,
   "max": 104,
   "kind": "dialogue",
   "jp": "しばらく\\n重い沈黙が続いたが\\n畳に頭を擦り付け続ける\\n井伊の姿に見飽きたのか\\nやがて首座が口を開いた",
   "en": "",
   "op": "0x62",
   "msg": "0x57ce"
  },
  {
   "id": "b_018001:0x1e0f4",
   "off": 123124,
   "max": 16,
   "kind": "dialogue",
   "jp": "……よかろう",
   "en": "",
   "op": "0x62",
   "msg": "0x57cf"
  },
  {
   "id": "b_018001:0x1e584",
   "off": 124292,
   "max": 24,
   "kind": "dialogue",
   "jp": "ありがとうございます",
   "en": "",
   "op": "0x62",
   "msg": "0x57d0"
  },
  {
   "id": "b_018001:0x1ea34",
   "off": 125492,
   "max": 60,
   "kind": "dialogue",
   "jp": "井伊は手短に\\nそう答えると\\n踵を返して\\n部屋を出ていった",
   "en": "",
   "op": "0x62",
   "msg": "0x57d1"
  },
  {
   "id": "b_018001:0x1ed78",
   "off": 126328,
   "max": 36,
   "kind": "dialogue",
   "jp": "あの若造\\n何を考えているのやら……",
   "en": "",
   "op": "0x62",
   "msg": "0x57d2"
  },
  {
   "id": "b_018001:0x1f21c",
   "off": 127516,
   "max": 44,
   "kind": "dialogue",
   "jp": "役目を取り上げられて\\n日和ったか　ほほほほ",
   "en": "",
   "op": "0x62",
   "msg": "0x57d3"
  },
  {
   "id": "b_018001:0x1f6c8",
   "off": 128712,
   "max": 68,
   "kind": "dialogue",
   "jp": "私は　正直安堵しておる\\n井伊が私たちを見る目は\\nぞっとしなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x57d4"
  },
  {
   "id": "b_018001:0x1fb8c",
   "off": 129932,
   "max": 68,
   "kind": "dialogue",
   "jp": "確かに慶喜は将軍家の\\n直系だが　あのガキに\\nついても得はあるまい",
   "en": "",
   "op": "0x62",
   "msg": "0x57d5"
  },
  {
   "id": "b_018001:0x1fbe4",
   "off": 130020,
   "max": 64,
   "kind": "dialogue",
   "jp": "すでに一橋派には何の\\n力もないのは　誰の目\\nにも明白であろうに",
   "en": "",
   "op": "0x62",
   "msg": "0x57d6"
  },
  {
   "id": "b_018001:0x200a4",
   "off": 131236,
   "max": 32,
   "kind": "dialogue",
   "jp": "首座殿の\\nおっしゃる通りです",
   "en": "",
   "op": "0x62",
   "msg": "0x57d7"
  },
  {
   "id": "b_018001:0x20544",
   "off": 132420,
   "max": 68,
   "kind": "dialogue",
   "jp": "何にせよ　慶喜に世話役が\\n必要なのも　あとわずかで\\nしかないがな",
   "en": "",
   "op": "0x62",
   "msg": "0x57d8"
  },
  {
   "id": "b_018001:0x2059c",
   "off": 132508,
   "max": 68,
   "kind": "dialogue",
   "jp": "それまで　落ちぶれた者\\n同士で　傷のなめ合いでも\\nしているがいいわ",
   "en": "",
   "op": "0x62",
   "msg": "0x57d9"
  },
  {
   "id": "b_018001:0x205fc",
   "off": 132604,
   "max": 20,
   "kind": "dialogue",
   "jp": "くっくっくっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x57da"
  },
  {
   "id": "b_018001:0x20cb8",
   "off": 134328,
   "max": 64,
   "kind": "dialogue",
   "jp": "慶喜の世話役に就いた\\n井伊は　日々その役目を\\n不足なくこなした",
   "en": "",
   "op": "0x62",
   "msg": "0x57db"
  },
  {
   "id": "b_018001:0x20d08",
   "off": 134408,
   "max": 108,
   "kind": "dialogue",
   "jp": "慶喜との穏やかな暮らしに\\nかつて抱いていた\\n野心は消え　いつしか\\n井伊も笑みを浮かべる\\nようになっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x57dc"
  },
  {
   "id": "b_018001:0x20d84",
   "off": 134532,
   "max": 60,
   "kind": "dialogue",
   "jp": "全ての権限を\\n取り上げられた慶喜に\\n浮かぶ目はないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x57dd"
  },
  {
   "id": "b_018001:0x20dd0",
   "off": 134608,
   "max": 52,
   "kind": "dialogue",
   "jp": "それでもいいと\\n井伊は思った\\n慶喜といられるのなら",
   "en": "",
   "op": "0x62",
   "msg": "0x57de"
  },
  {
   "id": "b_018001:0x20e14",
   "off": 134676,
   "max": 28,
   "kind": "dialogue",
   "jp": "そんな\\nある日のことだった",
   "en": "",
   "op": "0x62",
   "msg": "0x57df"
  },
  {
   "id": "b_018001:0x21274",
   "off": 135796,
   "max": 52,
   "kind": "dialogue",
   "jp": "おはよう　直弼\\nねえ　この箱\\n開けてもいいかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x57e0"
  },
  {
   "id": "b_018001:0x21a40",
   "off": 137792,
   "max": 88,
   "kind": "dialogue",
   "jp": "慶喜は　漆塗りの箱を\\n抱えながら　井伊の下へ\\n駆け寄ると　嬉しそうな\\n声で　そう訊いた",
   "en": "",
   "op": "0x62",
   "msg": "0x57e1"
  },
  {
   "id": "b_018001:0x22188",
   "off": 139656,
   "max": 28,
   "kind": "dialogue",
   "jp": "箱？\\nなんですか？\\nそれは",
   "en": "",
   "op": "0x62",
   "msg": "0x57e2"
  },
  {
   "id": "b_018001:0x226bc",
   "off": 140988,
   "max": 40,
   "kind": "dialogue",
   "jp": "えっ\\n直弼からの贈り物じゃ\\nないの？",
   "en": "",
   "op": "0x62",
   "msg": "0x57e3"
  },
  {
   "id": "b_018001:0x226f4",
   "off": 141044,
   "max": 44,
   "kind": "dialogue",
   "jp": "届けてくれた者が\\nそう言っていたけど……",
   "en": "",
   "op": "0x62",
   "msg": "0x57e4"
  },
  {
   "id": "b_018001:0x22b9c",
   "off": 142236,
   "max": 48,
   "kind": "dialogue",
   "jp": "いえ　私はそのような\\n物など　贈った覚えは――",
   "en": "",
   "op": "0x62",
   "msg": "0x57e5"
  },
  {
   "id": "b_018001:0x23148",
   "off": 143688,
   "max": 64,
   "kind": "dialogue",
   "jp": "井伊の言葉を待たずに\\n慶喜が箱に掛けられた\\n紐を解こうとした",
   "en": "",
   "op": "0x62",
   "msg": "0x57e6"
  },
  {
   "id": "b_018001:0x231a0",
   "off": 143776,
   "max": 44,
   "kind": "dialogue",
   "jp": "その瞬間　井伊の鼻を\\n焦げ臭い空気が掠めた",
   "en": "",
   "op": "0x62",
   "msg": "0x57e7"
  },
  {
   "id": "b_018001:0x23b38",
   "off": 146232,
   "max": 20,
   "kind": "dialogue",
   "jp": "慶喜様\\n離れて",
   "en": "",
   "op": "0x62",
   "msg": "0x57e8"
  },
  {
   "id": "b_018001:0x24140",
   "off": 147776,
   "max": 8,
   "kind": "dialogue",
   "jp": "あっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x57e9"
  },
  {
   "id": "b_018001:0x24754",
   "off": 149332,
   "max": 76,
   "kind": "dialogue",
   "jp": "井伊は\\n漆塗りの箱を奪うと\\n慶喜から距離を取るように\\n部屋の端へと走った",
   "en": "",
   "op": "0x62",
   "msg": "0x57ea"
  },
  {
   "id": "b_018001:0x247b0",
   "off": 149424,
   "max": 16,
   "kind": "dialogue",
   "jp": "その瞬間――",
   "en": "",
   "op": "0x62",
   "msg": "0x57eb"
  },
  {
   "id": "b_018001:0x24c54",
   "off": 150612,
   "max": 60,
   "kind": "dialogue",
   "jp": "強烈な衝撃と共に\\n箱がはじけ灼熱の炎が\\n井伊の全身を包む",
   "en": "",
   "op": "0x62",
   "msg": "0x57ec"
  },
  {
   "id": "b_018001:0x2513c",
   "off": 151868,
   "max": 20,
   "kind": "dialogue",
   "jp": "ぐぉぉおおおっ",
   "en": "",
   "op": "0x62",
   "msg": "0x57ed"
  },
  {
   "id": "b_018001:0x257f4",
   "off": 153588,
   "max": 8,
   "kind": "dialogue",
   "jp": "直弼",
   "en": "",
   "op": "0x62",
   "msg": "0x57ee"
  },
  {
   "id": "b_018001:0x25e98",
   "off": 155288,
   "max": 24,
   "kind": "dialogue",
   "jp": "近づいてはなりません",
   "en": "",
   "op": "0x62",
   "msg": "0x57ef"
  },
  {
   "id": "b_018001:0x2654c",
   "off": 157004,
   "max": 16,
   "kind": "dialogue",
   "jp": "でも\\nでも",
   "en": "",
   "op": "0x62",
   "msg": "0x57f0"
  },
  {
   "id": "b_018001:0x269f4",
   "off": 158196,
   "max": 48,
   "kind": "dialogue",
   "jp": "井伊は壁に体を叩きつけ\\n着物に移った炎を消す",
   "en": "",
   "op": "0x62",
   "msg": "0x57f1"
  },
  {
   "id": "b_018001:0x26e88",
   "off": 159368,
   "max": 56,
   "kind": "dialogue",
   "jp": "火は……消えました\\n直弼はこの通り\\n平気です……ぐうっ",
   "en": "",
   "op": "0x62",
   "msg": "0x57f2"
  },
  {
   "id": "b_018001:0x27350",
   "off": 160592,
   "max": 72,
   "kind": "dialogue",
   "jp": "焼け焦げた半身のまま\\n慶喜に向かって両手を広げ\\n井伊は微笑んで見せる",
   "en": "",
   "op": "0x62",
   "msg": "0x57f3"
  },
  {
   "id": "b_018001:0x27920",
   "off": 162080,
   "max": 64,
   "kind": "dialogue",
   "jp": "それより　ごふっ……\\n慶喜様にお怪我は\\nありませんでしたか？",
   "en": "",
   "op": "0x62",
   "msg": "0x57f4"
  },
  {
   "id": "b_018001:0x27ddc",
   "off": 163292,
   "max": 40,
   "kind": "dialogue",
   "jp": "予は平気だよ！\\nでも　直弼が　直弼が",
   "en": "",
   "op": "0x62",
   "msg": "0x57f5"
  },
  {
   "id": "b_018001:0x28280",
   "off": 164480,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうですか……\\nご無事でよかった\\n本当に……良かった……",
   "en": "",
   "op": "0x62",
   "msg": "0x57f6"
  },
  {
   "id": "b_018001:0x289d8",
   "off": 166360,
   "max": 12,
   "kind": "dialogue",
   "jp": "直弼ーっ",
   "en": "",
   "op": "0x62",
   "msg": "0x57f7"
  },
  {
   "id": "b_018001:0x28e7c",
   "off": 167548,
   "max": 64,
   "kind": "dialogue",
   "jp": "薄れ行く意識の中\\n悲痛な慶喜の声だけが\\nどこか遠くで響いていた",
   "en": "",
   "op": "0x62",
   "msg": "0x57f8"
  },
  {
   "id": "b_018001:0x29408",
   "off": 168968,
   "max": 48,
   "kind": "dialogue",
   "jp": "気が付けば　井伊は\\n見渡す限りの闇の中にいた",
   "en": "",
   "op": "0x62",
   "msg": "0x57f9"
  },
  {
   "id": "b_018001:0x2987c",
   "off": 170108,
   "max": 16,
   "kind": "dialogue",
   "jp": "ここはどこだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x57fa"
  },
  {
   "id": "b_018001:0x2989c",
   "off": 170140,
   "max": 48,
   "kind": "dialogue",
   "jp": "私は――そうだ\\n慶喜様をかばって\\n倒れたのか",
   "en": "",
   "op": "0x62",
   "msg": "0x57fb"
  },
  {
   "id": "b_018001:0x298dc",
   "off": 170204,
   "max": 20,
   "kind": "dialogue",
   "jp": "我は死んだのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x57fc"
  },
  {
   "id": "b_018001:0x29e50",
   "off": 171600,
   "max": 20,
   "kind": "dialogue",
   "jp": "……命が惜しいか？",
   "en": "",
   "op": "0x62",
   "msg": "0x57fd"
  },
  {
   "id": "b_018001:0x2a420",
   "off": 173088,
   "max": 8,
   "kind": "dialogue",
   "jp": "誰だ",
   "en": "",
   "op": "0x62",
   "msg": "0x57fe"
  },
  {
   "id": "b_018001:0x2a8a4",
   "off": 174244,
   "max": 16,
   "kind": "dialogue",
   "jp": "命が惜しいか？",
   "en": "",
   "op": "0x62",
   "msg": "0x57ff"
  },
  {
   "id": "b_018001:0x2ad34",
   "off": 175412,
   "max": 28,
   "kind": "dialogue",
   "jp": "己の命など\\n惜しくはない",
   "en": "",
   "op": "0x62",
   "msg": "0x5800"
  },
  {
   "id": "b_018001:0x2b1cc",
   "off": 176588,
   "max": 12,
   "kind": "dialogue",
   "jp": "ほう……",
   "en": "",
   "op": "0x62",
   "msg": "0x5801"
  },
  {
   "id": "b_018001:0x2b658",
   "off": 177752,
   "max": 48,
   "kind": "dialogue",
   "jp": "ただ　ひとつだけ\\n慶喜様のことが\\n気がかりだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5802"
  },
  {
   "id": "b_018001:0x2b698",
   "off": 177816,
   "max": 44,
   "kind": "dialogue",
   "jp": "あの方は　これまでも\\n命を狙われ続けてきた",
   "en": "",
   "op": "0x62",
   "msg": "0x5803"
  },
  {
   "id": "b_018001:0x2b6d4",
   "off": 177876,
   "max": 44,
   "kind": "dialogue",
   "jp": "ただ将軍家の血筋に\\n生まれたというだけで",
   "en": "",
   "op": "0x62",
   "msg": "0x5804"
  },
  {
   "id": "b_018001:0x2b710",
   "off": 177936,
   "max": 40,
   "kind": "dialogue",
   "jp": "そんなつまらない理由で\\n殺されるのか",
   "en": "",
   "op": "0x62",
   "msg": "0x5805"
  },
  {
   "id": "b_018001:0x2bbb4",
   "off": 179124,
   "max": 24,
   "kind": "dialogue",
   "jp": "それが　あの者の宿命よ",
   "en": "",
   "op": "0x62",
   "msg": "0x5806"
  },
  {
   "id": "b_018001:0x2bbe0",
   "off": 179168,
   "max": 48,
   "kind": "dialogue",
   "jp": "将軍に選ばれなければ\\n存在そのものが\\n世を乱す",
   "en": "",
   "op": "0x62",
   "msg": "0x5807"
  },
  {
   "id": "b_018001:0x2c49c",
   "off": 181404,
   "max": 20,
   "kind": "dialogue",
   "jp": "宿命など知るか！",
   "en": "",
   "op": "0x62",
   "msg": "0x5808"
  },
  {
   "id": "b_018001:0x2cc58",
   "off": 183384,
   "max": 68,
   "kind": "dialogue",
   "jp": "誰から疎まれようと\\nどんな仕打ちを受けても\\nあの方は微笑んでいた",
   "en": "",
   "op": "0x62",
   "msg": "0x5809"
  },
  {
   "id": "b_018001:0x2d1b4",
   "off": 184756,
   "max": 20,
   "kind": "dialogue",
   "jp": "ただ　それだけだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x580b"
  },
  {
   "id": "b_018001:0x2d1d8",
   "off": 184792,
   "max": 60,
   "kind": "dialogue",
   "jp": "誰も　誰一人として\\nあの方の想いを汚す\\n権利などないのに！",
   "en": "",
   "op": "0x62",
   "msg": "0x580c"
  },
  {
   "id": "b_018001:0x2d690",
   "off": 186000,
   "max": 44,
   "kind": "dialogue",
   "jp": "あの者が生きるには\\n将軍となる他\\n道はない",
   "en": "",
   "op": "0x62",
   "msg": "0x580d"
  },
  {
   "id": "b_018001:0x2d6d0",
   "off": 186064,
   "max": 40,
   "kind": "dialogue",
   "jp": "そして　あの者には\\nそれに適う力がない",
   "en": "",
   "op": "0x62",
   "msg": "0x580e"
  },
  {
   "id": "b_018001:0x2d70c",
   "off": 186124,
   "max": 20,
   "kind": "dialogue",
   "jp": "死すべきは宿命――",
   "en": "",
   "op": "0x62",
   "msg": "0x580f"
  },
  {
   "id": "b_018001:0x2dba8",
   "off": 187304,
   "max": 48,
   "kind": "dialogue",
   "jp": "黙れ\\nそれが天意であっても\\n我は認めない！",
   "en": "",
   "op": "0x62",
   "msg": "0x5810"
  },
  {
   "id": "b_018001:0x2dbe8",
   "off": 187368,
   "max": 16,
   "kind": "dialogue",
   "jp": "我だけはっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5811"
  },
  {
   "id": "b_018001:0x2e158",
   "off": 188760,
   "max": 36,
   "kind": "dialogue",
   "jp": "そうか　ならば\\n試させてもらおう",
   "en": "",
   "op": "0x62",
   "msg": "0x5812"
  },
  {
   "id": "b_018001:0x2e190",
   "off": 188816,
   "max": 28,
   "kind": "dialogue",
   "jp": "お前の信じる\\n想いとやらを",
   "en": "",
   "op": "0x62",
   "msg": "0x5813"
  },
  {
   "id": "b_018001:0x2e9f0",
   "off": 190960,
   "max": 28,
   "kind": "dialogue",
   "jp": "な　なんだ？\\nぬうっ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x5814"
  },
  {
   "id": "b_018001:0x2efd4",
   "off": 192468,
   "max": 56,
   "kind": "dialogue",
   "jp": "突然　体が重くなり\\n耐え切れずに井伊は\\n地に膝をつく",
   "en": "",
   "op": "0x62",
   "msg": "0x5815"
  },
  {
   "id": "b_018001:0x2f01c",
   "off": 192540,
   "max": 68,
   "kind": "dialogue",
   "jp": "視界を覆う闇が渦巻き\\n身体の端々から井伊の\\n中へと染み込んできた",
   "en": "",
   "op": "0x62",
   "msg": "0x5816"
  },
  {
   "id": "b_018001:0x2f6c8",
   "off": 194248,
   "max": 56,
   "kind": "dialogue",
   "jp": "やめろ……！\\n我は　まだ死ぬわけには\\nいかないのだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5817"
  },
  {
   "id": "b_018001:0x2f710",
   "off": 194320,
   "max": 44,
   "kind": "dialogue",
   "jp": "あの方を　慶喜様を\\nお護りしなければ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5818"
  },
  {
   "id": "b_018001:0x2fcf4",
   "off": 195828,
   "max": 64,
   "kind": "dialogue",
   "jp": "混濁する意識の中\\nどこからか　慶喜の\\n歌声が聴こえる気がした",
   "en": "",
   "op": "0x62",
   "msg": "0x5819"
  },
  {
   "id": "b_018001:0x30048",
   "off": 196680,
   "max": 12,
   "kind": "dialogue",
   "jp": "慶喜様……",
   "en": "",
   "op": "0x62",
   "msg": "0x581a"
  },
  {
   "id": "b_018001:0x30404",
   "off": 197636,
   "max": 40,
   "kind": "dialogue",
   "jp": "そうして井伊直弼は\\n闇に呑み込まれた",
   "en": "",
   "op": "0x62",
   "msg": "0x581b"
  },
  {
   "id": "b_018001:0x30a48",
   "off": 199240,
   "max": 24,
   "kind": "dialogue",
   "jp": "よしのぶ……さま……",
   "en": "",
   "op": "0x62",
   "msg": "0x581c"
  },
  {
   "id": "b_018001:0x31188",
   "off": 201096,
   "max": 32,
   "kind": "dialogue",
   "jp": "直弼\\n意識が戻ったんだね！",
   "en": "",
   "op": "0x62",
   "msg": "0x581d"
  },
  {
   "id": "b_018001:0x318c8",
   "off": 202952,
   "max": 36,
   "kind": "dialogue",
   "jp": "慶喜様……\\nここは？\\n私はどうして",
   "en": "",
   "op": "0x62",
   "msg": "0x581e"
  },
  {
   "id": "b_018001:0x31f30",
   "off": 204592,
   "max": 48,
   "kind": "dialogue",
   "jp": "直弼は　あれから三日も\\n眠ったままだったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x581f"
  },
  {
   "id": "b_018001:0x31f70",
   "off": 204656,
   "max": 60,
   "kind": "dialogue",
   "jp": "医者も　このまま意識が\\n戻らなければ\\n助からないだろうって",
   "en": "",
   "op": "0x62",
   "msg": "0x5820"
  },
  {
   "id": "b_018001:0x324c4",
   "off": 206020,
   "max": 52,
   "kind": "dialogue",
   "jp": "でも良かった\\n予の歌が天に届いたのかも\\n知れない",
   "en": "",
   "op": "0x62",
   "msg": "0x5821"
  },
  {
   "id": "b_018001:0x32974",
   "off": 207220,
   "max": 16,
   "kind": "dialogue",
   "jp": "慶喜様の歌……",
   "en": "",
   "op": "0x62",
   "msg": "0x5822"
  },
  {
   "id": "b_018001:0x32f0c",
   "off": 208652,
   "max": 48,
   "kind": "dialogue",
   "jp": "気付けば\\n井伊の身体が\\n淡い光に包まれていた",
   "en": "",
   "op": "0x62",
   "msg": "0x5823"
  },
  {
   "id": "b_018001:0x334d0",
   "off": 210128,
   "max": 64,
   "kind": "dialogue",
   "jp": "私のために　歌い続けて\\nくださったのですか……\\n三日三晩も……",
   "en": "",
   "op": "0x62",
   "msg": "0x5824"
  },
  {
   "id": "b_018001:0x3398c",
   "off": 211340,
   "max": 68,
   "kind": "dialogue",
   "jp": "直弼のためなら\\n一か月だって　一年だって\\n歌い続けるつもりだった",
   "en": "",
   "op": "0x62",
   "msg": "0x5825"
  },
  {
   "id": "b_018001:0x34158",
   "off": 213336,
   "max": 16,
   "kind": "dialogue",
   "jp": "でも　よかった",
   "en": "",
   "op": "0x62",
   "msg": "0x5826"
  },
  {
   "id": "b_018001:0x34900",
   "off": 215296,
   "max": 64,
   "kind": "dialogue",
   "jp": "予が生きていてもいいと\\n言ってくれるのは\\n直弼だけだもの……",
   "en": "",
   "op": "0x62",
   "msg": "0x5827"
  },
  {
   "id": "b_018001:0x34ef4",
   "off": 216820,
   "max": 36,
   "kind": "dialogue",
   "jp": "慶喜の目から\\n大粒の涙が零れ落ちる",
   "en": "",
   "op": "0x62",
   "msg": "0x5828"
  },
  {
   "id": "b_018001:0x35364",
   "off": 217956,
   "max": 8,
   "kind": "dialogue",
   "jp": "慶喜様",
   "en": "",
   "op": "0x62",
   "msg": "0x5829"
  },
  {
   "id": "b_018001:0x35910",
   "off": 219408,
   "max": 56,
   "kind": "dialogue",
   "jp": "井伊は　そんな慶喜を\\nそっと　しかし力強く\\n抱き締めた",
   "en": "",
   "op": "0x62",
   "msg": "0x582a"
  },
  {
   "id": "b_018001:0x35f98",
   "off": 221080,
   "max": 44,
   "kind": "dialogue",
   "jp": "直弼\\nずっと予のそばに\\nいてくれるよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x582b"
  },
  {
   "id": "b_018001:0x366e4",
   "off": 222948,
   "max": 64,
   "kind": "dialogue",
   "jp": "約束しましょう\\nこの命に代えて　直弼は\\n慶喜様をお護りします",
   "en": "",
   "op": "0x62",
   "msg": "0x582c"
  },
  {
   "id": "b_018001:0x37088",
   "off": 225416,
   "max": 56,
   "kind": "dialogue",
   "jp": "どんなことをしてでも\\nどんな代償を支払って\\nでも――",
   "en": "",
   "op": "0x62",
   "msg": "0x582d"
  },
  {
   "id": "b_018001:0x378f4",
   "off": 227572,
   "max": 40,
   "kind": "dialogue",
   "jp": "慶喜の暗殺未遂事件から\\n数週間後――",
   "en": "",
   "op": "0x62",
   "msg": "0x582e"
  },
  {
   "id": "b_018001:0x3792c",
   "off": 227628,
   "max": 44,
   "kind": "dialogue",
   "jp": "井伊は　老中たちを集め\\n会議の場を用意した",
   "en": "",
   "op": "0x62",
   "msg": "0x582f"
  },
  {
   "id": "b_018001:0x37d9c",
   "off": 228764,
   "max": 56,
   "kind": "dialogue",
   "jp": "一橋慶喜が継承権を\\n放棄するという話\\n真であろうな？",
   "en": "",
   "op": "0x62",
   "msg": "0x5830"
  },
  {
   "id": "b_018001:0x38254",
   "off": 229972,
   "max": 48,
   "kind": "dialogue",
   "jp": "そのために　皆様に\\nお集まりいただいたのです",
   "en": "",
   "op": "0x62",
   "msg": "0x5831"
  },
  {
   "id": "b_018001:0x38700",
   "off": 231168,
   "max": 12,
   "kind": "dialogue",
   "jp": "ふむ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5832"
  },
  {
   "id": "b_018001:0x38abc",
   "off": 232124,
   "max": 52,
   "kind": "dialogue",
   "jp": "老中首座は\\n片方の眉を歪めて\\n井伊の顔を仰ぎ見た",
   "en": "",
   "op": "0x62",
   "msg": "0x5833"
  },
  {
   "id": "b_018001:0x38df8",
   "off": 232952,
   "max": 60,
   "kind": "dialogue",
   "jp": "その眼帯はどうしたのだ\\n先の爆弾騒ぎの時に\\n傷を負ったか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5834"
  },
  {
   "id": "b_018001:0x392bc",
   "off": 234172,
   "max": 28,
   "kind": "dialogue",
   "jp": "代償……\\nでございますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5835"
  },
  {
   "id": "b_018001:0x39754",
   "off": 235348,
   "max": 28,
   "kind": "dialogue",
   "jp": "代償？\\nまったくその通り",
   "en": "",
   "op": "0x62",
   "msg": "0x5836"
  },
  {
   "id": "b_018001:0x3978c",
   "off": 235404,
   "max": 48,
   "kind": "dialogue",
   "jp": "若造めが\\nようやく身の程を\\n思い知ったようだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5837"
  },
  {
   "id": "b_018001:0x39b6c",
   "off": 236396,
   "max": 104,
   "kind": "dialogue",
   "jp": "老中たちが全員\\n集まったのを確認すると\\n井伊は立ち上がり\\n広間の端まで通る声で\\n儀式の開始を宣言した",
   "en": "",
   "op": "0x62",
   "msg": "0x5838"
  },
  {
   "id": "b_018001:0x39edc",
   "off": 237276,
   "max": 72,
   "kind": "dialogue",
   "jp": "まずは　慶喜様から皆様に\\nひとつ歌をご披露したいと\\n仰られております",
   "en": "",
   "op": "0x62",
   "msg": "0x5839"
  },
  {
   "id": "b_018001:0x3a3a0",
   "off": 238496,
   "max": 20,
   "kind": "dialogue",
   "jp": "歌？\\n歌などと……",
   "en": "",
   "op": "0x62",
   "msg": "0x583a"
  },
  {
   "id": "b_018001:0x3a834",
   "off": 239668,
   "max": 32,
   "kind": "dialogue",
   "jp": "何事にも段取りが\\nあるのですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x583b"
  },
  {
   "id": "b_018001:0x3a864",
   "off": 239716,
   "max": 40,
   "kind": "dialogue",
   "jp": "まずは慶喜様の歌を\\n聴いて頂かなければ",
   "en": "",
   "op": "0x62",
   "msg": "0x583c"
  },
  {
   "id": "b_018001:0x3ac38",
   "off": 240696,
   "max": 84,
   "kind": "dialogue",
   "jp": "有無を言わさぬ井伊の\\n圧力に　老中は歌くらい\\nならと浮かせかけた腰を\\n落ち着けた",
   "en": "",
   "op": "0x62",
   "msg": "0x583d"
  },
  {
   "id": "b_018001:0x3af94",
   "off": 241556,
   "max": 68,
   "kind": "dialogue",
   "jp": "命惜しさに　名目でしか\\nなかった継承権まで\\n差し出すとは　哀れな",
   "en": "",
   "op": "0x62",
   "msg": "0x583e"
  },
  {
   "id": "b_018001:0x3b388",
   "off": 242568,
   "max": 64,
   "kind": "dialogue",
   "jp": "形だけとはいえ継承権は\\n慶喜が生かされる唯一の\\n理由であった",
   "en": "",
   "op": "0x62",
   "msg": "0x583f"
  },
  {
   "id": "b_018001:0x3b8a0",
   "off": 243872,
   "max": 24,
   "kind": "dialogue",
   "jp": "あの　直弼\\n予は……",
   "en": "",
   "op": "0x62",
   "msg": "0x5840"
  },
  {
   "id": "b_018001:0x3be34",
   "off": 245300,
   "max": 64,
   "kind": "dialogue",
   "jp": "慶喜は　井伊の袴の裾を\\n掴んだまま　不安げに\\n広間を見渡した",
   "en": "",
   "op": "0x62",
   "msg": "0x5841"
  },
  {
   "id": "b_018001:0x3c3fc",
   "off": 246780,
   "max": 24,
   "kind": "dialogue",
   "jp": "何の心配も\\nいりません",
   "en": "",
   "op": "0x62",
   "msg": "0x5842"
  },
  {
   "id": "b_018001:0x3c424",
   "off": 246820,
   "max": 48,
   "kind": "dialogue",
   "jp": "私が教えた歌を\\nただ歌いさえすれば\\n良いのです",
   "en": "",
   "op": "0x62",
   "msg": "0x5843"
  },
  {
   "id": "b_018001:0x3c8d0",
   "off": 248016,
   "max": 16,
   "kind": "dialogue",
   "jp": "できますね？",
   "en": "",
   "op": "0x62",
   "msg": "0x5844"
  },
  {
   "id": "b_018001:0x3cd5c",
   "off": 249180,
   "max": 28,
   "kind": "dialogue",
   "jp": "う　うん……\\nじゃあ――",
   "en": "",
   "op": "0x62",
   "msg": "0x5845"
  },
  {
   "id": "b_018001:0x3d9f8",
   "off": 252408,
   "max": 20,
   "kind": "dialogue",
   "jp": "心して聴くがよい",
   "en": "",
   "op": "0x62",
   "msg": "0x5846"
  },
  {
   "id": "b_018001:0x3da1c",
   "off": 252444,
   "max": 36,
   "kind": "dialogue",
   "jp": "これこそが\\n神君より受け継ぎし力！",
   "en": "",
   "op": "0x62",
   "msg": "0x5847"
  },
  {
   "id": "b_018001:0x3da50",
   "off": 252496,
   "max": 32,
   "kind": "dialogue",
   "jp": "真の泰平へと導く歌！\\n天歌",
   "en": "",
   "op": "0x62",
   "msg": "0x5848"
  }
 ]
}
