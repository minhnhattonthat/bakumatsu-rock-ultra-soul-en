{
 "source": "b_018002.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "b_018002:0x10e8",
   "off": 4328,
   "max": 40,
   "kind": "dialogue",
   "jp": "老中たちの前に立って\\n慶喜が歌い始める",
   "en": "",
   "op": "0x62",
   "msg": "0x5849"
  },
  {
   "id": "b_018002:0x1120",
   "off": 4384,
   "max": 48,
   "kind": "dialogue",
   "jp": "それは\\n天使の歌声が奏でる\\n地獄の歌であった",
   "en": "",
   "op": "0x62",
   "msg": "0x584a"
  },
  {
   "id": "b_018002:0x1460",
   "off": 5216,
   "max": 60,
   "kind": "dialogue",
   "jp": "な　なんだ　この歌は\\nまるで魂が吸い寄せられる\\nようだ……",
   "en": "",
   "op": "0x62",
   "msg": "0x584b"
  },
  {
   "id": "b_018002:0x191c",
   "off": 6428,
   "max": 64,
   "kind": "dialogue",
   "jp": "はぁぁぁああ\\nこれぞまさに悦楽……\\n何という　何という……",
   "en": "",
   "op": "0x62",
   "msg": "0x584c"
  },
  {
   "id": "b_018002:0x1d0c",
   "off": 7436,
   "max": 68,
   "kind": "dialogue",
   "jp": "慶喜たちの歌が終わる頃には\\n老中たちは恍惚の表情を\\n浮かべていた",
   "en": "",
   "op": "0x62",
   "msg": "0x584d"
  },
  {
   "id": "b_018002:0x22d8",
   "off": 8920,
   "max": 24,
   "kind": "dialogue",
   "jp": "お見事でしたよ\\n慶喜様",
   "en": "",
   "op": "0x62",
   "msg": "0x584e"
  },
  {
   "id": "b_018002:0x2300",
   "off": 8960,
   "max": 44,
   "kind": "dialogue",
   "jp": "ご老中の方々も\\n皆　感服している\\nようです",
   "en": "",
   "op": "0x62",
   "msg": "0x584f"
  },
  {
   "id": "b_018002:0x2844",
   "off": 10308,
   "max": 28,
   "kind": "dialogue",
   "jp": "本当？\\nこれでよかったの？",
   "en": "",
   "op": "0x62",
   "msg": "0x5850"
  },
  {
   "id": "b_018002:0x2cdc",
   "off": 11484,
   "max": 60,
   "kind": "dialogue",
   "jp": "ええ　慶喜様の歌が\\nこの者たちの汚れた\\n魂を救ったのです",
   "en": "",
   "op": "0x62",
   "msg": "0x5851"
  },
  {
   "id": "b_018002:0x2d28",
   "off": 11560,
   "max": 16,
   "kind": "dialogue",
   "jp": "ごらんなさい",
   "en": "",
   "op": "0x62",
   "msg": "0x5852"
  },
  {
   "id": "b_018002:0x3384",
   "off": 13188,
   "max": 28,
   "kind": "dialogue",
   "jp": "慶喜様に\\n永遠の忠誠を……",
   "en": "",
   "op": "0x62",
   "msg": "0x5853"
  },
  {
   "id": "b_018002:0x3820",
   "off": 14368,
   "max": 56,
   "kind": "dialogue",
   "jp": "あの歌をもう一度\\n聴くためならば\\n何でもいたします……",
   "en": "",
   "op": "0x62",
   "msg": "0x5854"
  },
  {
   "id": "b_018002:0x3e2c",
   "off": 15916,
   "max": 40,
   "kind": "dialogue",
   "jp": "そうか\\n予の歌が人の役に\\n立ったんだね",
   "en": "",
   "op": "0x62",
   "msg": "0x5855"
  },
  {
   "id": "b_018002:0x42e4",
   "off": 17124,
   "max": 56,
   "kind": "dialogue",
   "jp": "広間に満ちている\\n異様な空気に\\n慶喜は気付いていない",
   "en": "",
   "op": "0x62",
   "msg": "0x5856"
  },
  {
   "id": "b_018002:0x432c",
   "off": 17196,
   "max": 60,
   "kind": "dialogue",
   "jp": "ただ　役割を果たし\\n安堵した顔を　井伊に\\n向けるだけだった",
   "en": "",
   "op": "0x62",
   "msg": "0x5857"
  },
  {
   "id": "b_018002:0x48f0",
   "off": 18672,
   "max": 40,
   "kind": "dialogue",
   "jp": "さあ　慶喜様は\\n下がってお休みください",
   "en": "",
   "op": "0x62",
   "msg": "0x5858"
  },
  {
   "id": "b_018002:0x4928",
   "off": 18728,
   "max": 24,
   "kind": "dialogue",
   "jp": "あとは直弼に\\nお任せを",
   "en": "",
   "op": "0x62",
   "msg": "0x5859"
  },
  {
   "id": "b_018002:0x4dbc",
   "off": 19900,
   "max": 16,
   "kind": "dialogue",
   "jp": "うん\\nわかった",
   "en": "",
   "op": "0x62",
   "msg": "0x585a"
  },
  {
   "id": "b_018002:0x525c",
   "off": 21084,
   "max": 64,
   "kind": "dialogue",
   "jp": "慶喜が控えの間に戻るのを\\n見届けた井伊が\\n老中たちを振り返った",
   "en": "",
   "op": "0x62",
   "msg": "0x585b"
  },
  {
   "id": "b_018002:0x5610",
   "off": 22032,
   "max": 88,
   "kind": "dialogue",
   "jp": "そこには慶喜に見せていた\\n柔和な笑顔はなく\\nただひたすらに冷たい表情が\\nはりついている",
   "en": "",
   "op": "0x62",
   "msg": "0x585c"
  },
  {
   "id": "b_018002:0x5970",
   "off": 22896,
   "max": 12,
   "kind": "dialogue",
   "jp": "さて……",
   "en": "",
   "op": "0x62",
   "msg": "0x585d"
  },
  {
   "id": "b_018002:0x5df8",
   "off": 24056,
   "max": 56,
   "kind": "dialogue",
   "jp": "ぐぐ……\\nな　なんだ　これは？\\nあの歌は　何なのだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x585e"
  },
  {
   "id": "b_018002:0x62b0",
   "off": 25264,
   "max": 40,
   "kind": "dialogue",
   "jp": "ほう\\nまだ正気を保って\\nいるのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x585f"
  },
  {
   "id": "b_018002:0x6754",
   "off": 26452,
   "max": 44,
   "kind": "dialogue",
   "jp": "はあっ　はあっ\\n……井伊！\\n貴様の仕業か",
   "en": "",
   "op": "0x62",
   "msg": "0x5860"
  },
  {
   "id": "b_018002:0x6c00",
   "off": 27648,
   "max": 56,
   "kind": "dialogue",
   "jp": "いかにもその通り\\n我が代償と引き換えに\\n手に入れた力だ",
   "en": "",
   "op": "0x62",
   "msg": "0x5861"
  },
  {
   "id": "b_018002:0x70b4",
   "off": 28852,
   "max": 12,
   "kind": "dialogue",
   "jp": "代償だと？",
   "en": "",
   "op": "0x62",
   "msg": "0x5862"
  },
  {
   "id": "b_018002:0x7540",
   "off": 30016,
   "max": 52,
   "kind": "dialogue",
   "jp": "気になるのなら\\n見せてやろう\\n我が支払った代償を",
   "en": "",
   "op": "0x62",
   "msg": "0x5863"
  },
  {
   "id": "b_018002:0x7d8c",
   "off": 32140,
   "max": 76,
   "kind": "dialogue",
   "jp": "井伊は老中首座の前に\\nしゃがみ込むと\\n片目を覆っていた眼帯を\\n取って見せた",
   "en": "",
   "op": "0x62",
   "msg": "0x5864"
  },
  {
   "id": "b_018002:0x8208",
   "off": 33288,
   "max": 24,
   "kind": "dialogue",
   "jp": "ひいっ\\nば　化け物",
   "en": "",
   "op": "0x62",
   "msg": "0x5865"
  },
  {
   "id": "b_018002:0x86a0",
   "off": 34464,
   "max": 68,
   "kind": "dialogue",
   "jp": "貴様　そのような\\n恐ろしい姿になってまで\\n権力を手に入れようと……",
   "en": "",
   "op": "0x62",
   "msg": "0x5866"
  },
  {
   "id": "b_018002:0x8d1c",
   "off": 36124,
   "max": 8,
   "kind": "dialogue",
   "jp": "権力？",
   "en": "",
   "op": "0x62",
   "msg": "0x5867"
  },
  {
   "id": "b_018002:0x91a0",
   "off": 37280,
   "max": 36,
   "kind": "dialogue",
   "jp": "ふん\\nそんな下らぬものに\\n用はない",
   "en": "",
   "op": "0x62",
   "msg": "0x5868"
  },
  {
   "id": "b_018002:0x9724",
   "off": 38692,
   "max": 24,
   "kind": "dialogue",
   "jp": "ではなぜ！\\nどうして！",
   "en": "",
   "op": "0x62",
   "msg": "0x5869"
  },
  {
   "id": "b_018002:0x9e10",
   "off": 40464,
   "max": 48,
   "kind": "dialogue",
   "jp": "決まっている\\nすべては慶喜様を\\nお護りするため",
   "en": "",
   "op": "0x62",
   "msg": "0x586a"
  },
  {
   "id": "b_018002:0x9e50",
   "off": 40528,
   "max": 44,
   "kind": "dialogue",
   "jp": "慶喜様が生きてゆける\\n世の中を作るためだ",
   "en": "",
   "op": "0x62",
   "msg": "0x586b"
  },
  {
   "id": "b_018002:0x9e8c",
   "off": 40588,
   "max": 56,
   "kind": "dialogue",
   "jp": "そのためであれば\\n片目どころか\\n我が命さえ惜しくはない",
   "en": "",
   "op": "0x62",
   "msg": "0x586c"
  },
  {
   "id": "b_018002:0xa754",
   "off": 42836,
   "max": 48,
   "kind": "dialogue",
   "jp": "喜んで代償として\\n捧げようではないか！\\nなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x586d"
  },
  {
   "id": "b_018002:0xaec4",
   "off": 44740,
   "max": 44,
   "kind": "dialogue",
   "jp": "それでよい\\nそれでよいのだ\\nふふふふ……",
   "en": "",
   "op": "0x62",
   "msg": "0x586e"
  },
  {
   "id": "b_018002:0xb600",
   "off": 46592,
   "max": 40,
   "kind": "dialogue",
   "jp": "く　狂っている……\\n貴様は狂っている！",
   "en": "",
   "op": "0x62",
   "msg": "0x586f"
  },
  {
   "id": "b_018002:0xbb44",
   "off": 47940,
   "max": 40,
   "kind": "dialogue",
   "jp": "狂っていようと\\n腐っているより\\nましだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5870"
  },
  {
   "id": "b_018002:0xbb7c",
   "off": 47996,
   "max": 64,
   "kind": "dialogue",
   "jp": "我が手に入れた天歌の\\n力によって　全てが\\n慶喜様にひれ伏すのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5871"
  },
  {
   "id": "b_018002:0xc0d4",
   "off": 49364,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああ\\n慶喜様……",
   "en": "",
   "op": "0x62",
   "msg": "0x5872"
  },
  {
   "id": "b_018002:0xc0f8",
   "off": 49400,
   "max": 64,
   "kind": "dialogue",
   "jp": "あなたのためなら\\nこの身に受けた呪いの\\n痛みすら愛おしい……",
   "en": "",
   "op": "0x62",
   "msg": "0x5873"
  },
  {
   "id": "b_018002:0xc148",
   "off": 49480,
   "max": 48,
   "kind": "dialogue",
   "jp": "慶喜様が望むのなら\\n天すら手に入れてみせよう",
   "en": "",
   "op": "0x62",
   "msg": "0x5874"
  },
  {
   "id": "b_018002:0xc188",
   "off": 49544,
   "max": 44,
   "kind": "dialogue",
   "jp": "慶喜様が喜ぶのなら\\n地も滅ぼしてみせよう",
   "en": "",
   "op": "0x62",
   "msg": "0x5875"
  },
  {
   "id": "b_018002:0xc6cc",
   "off": 50892,
   "max": 44,
   "kind": "dialogue",
   "jp": "そして\\n慶喜様の役に立たぬ者は\\n皆殺しだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5876"
  },
  {
   "id": "b_018002:0xcc10",
   "off": 52240,
   "max": 16,
   "kind": "dialogue",
   "jp": "なあ\\n首座殿？",
   "en": "",
   "op": "0x62",
   "msg": "0x5877"
  },
  {
   "id": "b_018002:0xd0a4",
   "off": 53412,
   "max": 12,
   "kind": "dialogue",
   "jp": "ひいっ",
   "en": "",
   "op": "0x62",
   "msg": "0x5878"
  },
  {
   "id": "b_018002:0xd530",
   "off": 54576,
   "max": 28,
   "kind": "dialogue",
   "jp": "お前はまだ\\n使い道がある",
   "en": "",
   "op": "0x62",
   "msg": "0x5879"
  },
  {
   "id": "b_018002:0xd55c",
   "off": 54620,
   "max": 32,
   "kind": "dialogue",
   "jp": "生かしておいて\\n差し上げよう",
   "en": "",
   "op": "0x62",
   "msg": "0x587a"
  },
  {
   "id": "b_018002:0xdc08",
   "off": 56328,
   "max": 36,
   "kind": "dialogue",
   "jp": "慶喜様のために死ぬ\\nその時までな",
   "en": "",
   "op": "0x62",
   "msg": "0x587b"
  },
  {
   "id": "b_018002:0xe210",
   "off": 57872,
   "max": 20,
   "kind": "dialogue",
   "jp": "あ……\\nうう……",
   "en": "",
   "op": "0x62",
   "msg": "0x587c"
  },
  {
   "id": "b_018002:0xece0",
   "off": 60640,
   "max": 32,
   "kind": "dialogue",
   "jp": "聞け\\nこれより粛清を始める！",
   "en": "",
   "op": "0x62",
   "msg": "0x587d"
  },
  {
   "id": "b_018002:0xed10",
   "off": 60688,
   "max": 48,
   "kind": "dialogue",
   "jp": "この世のあらゆる全てを\\n慶喜様へと捧げるのだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x587e"
  },
  {
   "id": "b_018002:0xed50",
   "off": 60752,
   "max": 44,
   "kind": "dialogue",
   "jp": "徳川の世は永遠に\\n続かなければならない！",
   "en": "",
   "op": "0x62",
   "msg": "0x587f"
  },
  {
   "id": "b_018002:0xed8c",
   "off": 60812,
   "max": 48,
   "kind": "dialogue",
   "jp": "慶喜様のために生きろ！\\n慶喜様のために死ね！",
   "en": "",
   "op": "0x62",
   "msg": "0x5880"
  },
  {
   "id": "b_018002:0xf2d4",
   "off": 62164,
   "max": 40,
   "kind": "dialogue",
   "jp": "くっくっくっ……\\nわーっはっはっはっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5881"
  },
  {
   "id": "b_018002:0xfaf8",
   "off": 64248,
   "max": 60,
   "kind": "dialogue",
   "jp": "この年　老中筆頭として\\n井伊直弼が異例の若さで\\n抜擢される",
   "en": "",
   "op": "0x62",
   "msg": "0x5882"
  },
  {
   "id": "b_018002:0xfb44",
   "off": 64324,
   "max": 104,
   "kind": "dialogue",
   "jp": "井伊は　揺らぎ始めていた\\n徳川幕府の改革を断行し\\n以前にも増して　強固な\\n権力構造を作り上げていった",
   "en": "",
   "op": "0x62",
   "msg": "0x5883"
  },
  {
   "id": "b_018002:0xfbbc",
   "off": 64444,
   "max": 40,
   "kind": "dialogue",
   "jp": "朽ちた目の痛みは\\nもはや喜びでしかない",
   "en": "",
   "op": "0x62",
   "msg": "0x5884"
  },
  {
   "id": "b_018002:0xfbf4",
   "off": 64500,
   "max": 64,
   "kind": "dialogue",
   "jp": "狂っていようとも\\n行く先が地獄であろうとも\\n全ては慶喜のため",
   "en": "",
   "op": "0x62",
   "msg": "0x5885"
  },
  {
   "id": "b_018002:0xfc44",
   "off": 64580,
   "max": 52,
   "kind": "dialogue",
   "jp": "井伊は闇を纏い　その\\n第一歩を踏み出したのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x5886"
  }
 ]
}
