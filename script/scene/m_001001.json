{
 "source": "m_001001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_001001:0x11d0",
   "off": 4560,
   "max": 16,
   "kind": "dialogue",
   "jp": "――京　錦市場",
   "en": "",
   "op": "0x62",
   "msg": "0x0082"
  },
  {
   "id": "m_001001:0x189c",
   "off": 6300,
   "max": 36,
   "kind": "dialogue",
   "jp": "さっすが\\n京の都は賑やかだなぁ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0083"
  },
  {
   "id": "m_001001:0x18d0",
   "off": 6352,
   "max": 40,
   "kind": "dialogue",
   "jp": "土佐とは違って\\n町全体に活気があるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0084"
  },
  {
   "id": "m_001001:0x1908",
   "off": 6408,
   "max": 36,
   "kind": "dialogue",
   "jp": "なにせ京は流行の\\n最先端を行く町",
   "en": "",
   "op": "0x62",
   "msg": "0x0085"
  },
  {
   "id": "m_001001:0x193c",
   "off": 6460,
   "max": 56,
   "kind": "dialogue",
   "jp": "土佐の連中には\\nわしの歌の良さは\\n理解できんかったが",
   "en": "",
   "op": "0x62",
   "msg": "0x0086"
  },
  {
   "id": "m_001001:0x1a1c",
   "off": 6684,
   "max": 40,
   "kind": "dialogue",
   "jp": "京の人らには受け入れ\\nられるはずぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0087"
  },
  {
   "id": "m_001001:0x217c",
   "off": 8572,
   "max": 48,
   "kind": "dialogue",
   "jp": "なんせ　土佐では\\nひどい目に遭った\\nからな……",
   "en": "",
   "op": "0x62",
   "msg": "0x0088"
  },
  {
   "id": "m_001001:0x28c0",
   "off": 10432,
   "max": 24,
   "kind": "dialogue",
   "jp": "だが\\n今日からは違う",
   "en": "",
   "op": "0x62",
   "msg": "0x0122"
  },
  {
   "id": "m_001001:0x2dec",
   "off": 11756,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしの歌を京に\\nいや日の本いっぱいに\\n轟かせるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0123"
  },
  {
   "id": "m_001001:0x2e34",
   "off": 11828,
   "max": 68,
   "kind": "dialogue",
   "jp": "そのためにもまず\\n大舞台（オーディション）\\nの会場に行ってみんとな",
   "en": "",
   "op": "0x62",
   "msg": "0x0124"
  },
  {
   "id": "m_001001:0x3510",
   "off": 13584,
   "max": 56,
   "kind": "dialogue",
   "jp": "しっかし　弥太郎のヤツ\\n任せておくぜよ！\\nとか言って",
   "en": "",
   "op": "0x62",
   "msg": "0x0125"
  },
  {
   "id": "m_001001:0x3558",
   "off": 13656,
   "max": 24,
   "kind": "dialogue",
   "jp": "どこへ行きよったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0126"
  },
  {
   "id": "m_001001:0x3c08",
   "off": 15368,
   "max": 36,
   "kind": "dialogue",
   "jp": "わし一人では\\n西も東もわからんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0127"
  },
  {
   "id": "m_001001:0x3c3c",
   "off": 15420,
   "max": 56,
   "kind": "dialogue",
   "jp": "大舞台の会場と\\nいうのはどっちへ\\n行けばいいのかのう",
   "en": "",
   "op": "0x62",
   "msg": "0x0128"
  },
  {
   "id": "m_001001:0x4418",
   "off": 17432,
   "max": 12,
   "kind": "dialogue",
   "jp": "大舞台会場",
   "en": "",
   "op": "0x62",
   "msg": "0x0129"
  },
  {
   "id": "m_001001:0x4864",
   "off": 18532,
   "max": 52,
   "kind": "dialogue",
   "jp": "おう　ここじゃここじゃ！\\nここが大舞台の会場じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x012a"
  },
  {
   "id": "m_001001:0x4dac",
   "off": 19884,
   "max": 12,
   "kind": "dialogue",
   "jp": "頼もーう！",
   "en": "",
   "op": "0x62",
   "msg": "0x012b"
  },
  {
   "id": "m_001001:0x5604",
   "off": 22020,
   "max": 16,
   "kind": "dialogue",
   "jp": "\\fnt1帰れ\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x012c"
  },
  {
   "id": "m_001001:0x5db4",
   "off": 23988,
   "max": 24,
   "kind": "dialogue",
   "jp": "まだ何も言っちょらん！",
   "en": "",
   "op": "0x62",
   "msg": "0x012d"
  },
  {
   "id": "m_001001:0x62e8",
   "off": 25320,
   "max": 64,
   "kind": "dialogue",
   "jp": "その成り　その言葉\\nどうせどこかの田舎から\\nやってきたんだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x012e"
  },
  {
   "id": "m_001001:0x6338",
   "off": 25400,
   "max": 40,
   "kind": "dialogue",
   "jp": "ここは栄誉ある幕府の\\n歌い手を決める場",
   "en": "",
   "op": "0x62",
   "msg": "0x012f"
  },
  {
   "id": "m_001001:0x6370",
   "off": 25456,
   "max": 52,
   "kind": "dialogue",
   "jp": "紹介状もない者を\\nおいそれと入れる訳には\\nいかぬ",
   "en": "",
   "op": "0x62",
   "msg": "0x0130"
  },
  {
   "id": "m_001001:0x68c0",
   "off": 26816,
   "max": 16,
   "kind": "dialogue",
   "jp": "しょ　紹介状",
   "en": "",
   "op": "0x62",
   "msg": "0x0131"
  },
  {
   "id": "m_001001:0x6d54",
   "off": 27988,
   "max": 68,
   "kind": "dialogue",
   "jp": "どこかの天歌師範なり\\n藩主なりから紹介状を\\nもらってくるんだな！",
   "en": "",
   "op": "0x62",
   "msg": "0x0132"
  },
  {
   "id": "m_001001:0x7214",
   "off": 29204,
   "max": 44,
   "kind": "dialogue",
   "jp": "そ　そんなこと言わずに\\n入れて欲しいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0133"
  },
  {
   "id": "m_001001:0x7754",
   "off": 30548,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうじゃ！\\nわしの歌をちょっとでも\\n聴けば　わかるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0134"
  },
  {
   "id": "m_001001:0x77a0",
   "off": 30624,
   "max": 24,
   "kind": "dialogue",
   "jp": "さあ　わしの歌を……",
   "en": "",
   "op": "0x62",
   "msg": "0x0135"
  },
  {
   "id": "m_001001:0x7e9c",
   "off": 32412,
   "max": 12,
   "kind": "dialogue",
   "jp": "殴られた",
   "en": "",
   "op": "0x62",
   "msg": "0x0136"
  },
  {
   "id": "m_001001:0x8914",
   "off": 35092,
   "max": 36,
   "kind": "dialogue",
   "jp": "いってぇぇぇ！\\n何をするんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0137"
  },
  {
   "id": "m_001001:0x9284",
   "off": 37508,
   "max": 60,
   "kind": "dialogue",
   "jp": "紹介状がなければ\\n審査は受けられぬ！\\nそう申しただろう！",
   "en": "",
   "op": "0x62",
   "msg": "0x0138"
  },
  {
   "id": "m_001001:0x92d0",
   "off": 37584,
   "max": 44,
   "kind": "dialogue",
   "jp": "第一　免状のない者が\\n勝手に歌うは重罪ぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0139"
  },
  {
   "id": "m_001001:0x9818",
   "off": 38936,
   "max": 16,
   "kind": "dialogue",
   "jp": "じゅ　重罪",
   "en": "",
   "op": "0x62",
   "msg": "0x013a"
  },
  {
   "id": "m_001001:0x9838",
   "off": 38968,
   "max": 36,
   "kind": "dialogue",
   "jp": "話が違う！\\nそれじゃ土佐と一緒だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x013b"
  },
  {
   "id": "m_001001:0x9cd8",
   "off": 40152,
   "max": 56,
   "kind": "dialogue",
   "jp": "何を言っておるか\\nわからんが……\\n決まりは決まりなのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x013c"
  },
  {
   "id": "m_001001:0xa18c",
   "off": 41356,
   "max": 24,
   "kind": "dialogue",
   "jp": "ほら　さっさと帰れ！",
   "en": "",
   "op": "0x62",
   "msg": "0x013d"
  },
  {
   "id": "m_001001:0xa538",
   "off": 42296,
   "max": 16,
   "kind": "choice",
   "jp": "もう一度歌う",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_001001:0xa554",
   "off": 42324,
   "max": 20,
   "kind": "choice",
   "jp": "武士にくってかかる",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_001001:0xa574",
   "off": 42356,
   "max": 16,
   "kind": "choice",
   "jp": "大人しく諦める",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_001001:0xaeb8",
   "off": 44728,
   "max": 52,
   "kind": "dialogue",
   "jp": "そう言わんと\\nちょっとだけでも\\n聴いてみるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x013e"
  },
  {
   "id": "m_001001:0xaefc",
   "off": 44796,
   "max": 48,
   "kind": "dialogue",
   "jp": "わしの歌の熱い思いを\\nわかってほしいんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x013f"
  },
  {
   "id": "m_001001:0xaf3c",
   "off": 44860,
   "max": 24,
   "kind": "dialogue",
   "jp": "さあ　行くぜよ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x0140"
  },
  {
   "id": "m_001001:0xb3d0",
   "off": 46032,
   "max": 44,
   "kind": "dialogue",
   "jp": "例外は認められぬ\\n早々に立ち去られよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0141"
  },
  {
   "id": "m_001001:0xc17c",
   "off": 49532,
   "max": 72,
   "kind": "dialogue",
   "jp": "ちゃんと聴きもせずに\\n認めんとはなんじゃ！\\n聴いてから判断するぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0142"
  },
  {
   "id": "m_001001:0xc640",
   "off": 50752,
   "max": 28,
   "kind": "dialogue",
   "jp": "私は門番だ\\nその役目にない",
   "en": "",
   "op": "0x62",
   "msg": "0x0143"
  },
  {
   "id": "m_001001:0xc66c",
   "off": 50796,
   "max": 52,
   "kind": "dialogue",
   "jp": "紹介状のあるものを通し\\nそれ以外を通さぬのが仕事",
   "en": "",
   "op": "0x62",
   "msg": "0x0144"
  },
  {
   "id": "m_001001:0xc6b0",
   "off": 50864,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前も腰に刀差す立場なら\\nわかるだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x0145"
  },
  {
   "id": "m_001001:0xcbf4",
   "off": 52212,
   "max": 32,
   "kind": "dialogue",
   "jp": "そこを何とか\\nしてくれんかのう",
   "en": "",
   "op": "0x62",
   "msg": "0x0146"
  },
  {
   "id": "m_001001:0xd090",
   "off": 53392,
   "max": 60,
   "kind": "dialogue",
   "jp": "例外はない\\n歌を審査して欲しくば\\n紹介状を持って出直されよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0147"
  },
  {
   "id": "m_001001:0xdbac",
   "off": 56236,
   "max": 44,
   "kind": "dialogue",
   "jp": "そこまで言われたら\\n大人しく引き下がるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0148"
  },
  {
   "id": "m_001001:0xe054",
   "off": 57428,
   "max": 16,
   "kind": "dialogue",
   "jp": "わかればよい",
   "en": "",
   "op": "0x62",
   "msg": "0x0149"
  },
  {
   "id": "m_001001:0xe904",
   "off": 59652,
   "max": 68,
   "kind": "dialogue",
   "jp": "結局　龍馬は大舞台の\\n会場からつまみ出されて\\nしまったのだった……",
   "en": "",
   "op": "0x62",
   "msg": "0x014a"
  },
  {
   "id": "m_001001:0xf140",
   "off": 61760,
   "max": 60,
   "kind": "dialogue",
   "jp": "なんだ　なんだ\\nわしの歌はここでも\\nダメだっていうのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x014b"
  },
  {
   "id": "m_001001:0xf18c",
   "off": 61836,
   "max": 20,
   "kind": "dialogue",
   "jp": "がっくりきたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x014c"
  },
  {
   "id": "m_001001:0xf84c",
   "off": 63564,
   "max": 40,
   "kind": "dialogue",
   "jp": "ふぉっふぉっふぉ\\nそうしょぼくれるな",
   "en": "",
   "op": "0x62",
   "msg": "0x014d"
  },
  {
   "id": "m_001001:0x10434",
   "off": 66612,
   "max": 32,
   "kind": "dialogue",
   "jp": "お前の歌\\n捨てたもんじゃないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x014e"
  },
  {
   "id": "m_001001:0x109ec",
   "off": 68076,
   "max": 52,
   "kind": "dialogue",
   "jp": "聴いてたんか\\nいや　わしは歌って\\nおらんが……",
   "en": "",
   "op": "0x62",
   "msg": "0x014f"
  },
  {
   "id": "m_001001:0x10e9c",
   "off": 69276,
   "max": 56,
   "kind": "dialogue",
   "jp": "ワシくらいになると\\n聴かんでも見ただけで\\nわかるのよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0150"
  },
  {
   "id": "m_001001:0x11350",
   "off": 70480,
   "max": 48,
   "kind": "dialogue",
   "jp": "そりゃすげえ！\\nお前は歌の先生か\\nなんかか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0151"
  },
  {
   "id": "m_001001:0x117fc",
   "off": 71676,
   "max": 68,
   "kind": "dialogue",
   "jp": "ま　そんなようなもんじゃ\\nワシは天狗……\\nテンちゃんと呼ぶがいいぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x0152"
  },
  {
   "id": "m_001001:0x11d54",
   "off": 73044,
   "max": 32,
   "kind": "dialogue",
   "jp": "なるほど！\\nわしは坂本龍馬！",
   "en": "",
   "op": "0x62",
   "msg": "0x0153"
  },
  {
   "id": "m_001001:0x12678",
   "off": 75384,
   "max": 36,
   "kind": "dialogue",
   "jp": "いずれは歌で\\n日本一になる男ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0154"
  },
  {
   "id": "m_001001:0x12e98",
   "off": 77464,
   "max": 32,
   "kind": "dialogue",
   "jp": "日本一と出たか\\nこりゃ大きいな",
   "en": "",
   "op": "0x62",
   "msg": "0x0155"
  },
  {
   "id": "m_001001:0x133cc",
   "off": 78796,
   "max": 44,
   "kind": "dialogue",
   "jp": "土佐では天歌以外の歌は\\n認められなかったが",
   "en": "",
   "op": "0x62",
   "msg": "0x0156"
  },
  {
   "id": "m_001001:0x13408",
   "off": 78856,
   "max": 68,
   "kind": "dialogue",
   "jp": "京ならきっとわしの\\n新しい歌も受け入れられる\\nそう思って来たんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0157"
  },
  {
   "id": "m_001001:0x134f4",
   "off": 79092,
   "max": 44,
   "kind": "dialogue",
   "jp": "だが　勝手に歌ったら\\n重罪だと言われて……",
   "en": "",
   "op": "0x62",
   "msg": "0x0158"
  },
  {
   "id": "m_001001:0x1399c",
   "off": 80284,
   "max": 48,
   "kind": "dialogue",
   "jp": "ふぉっふぉっふぉ\\nあいつらは\\n頭が固いからのう",
   "en": "",
   "op": "0x62",
   "msg": "0x0159"
  },
  {
   "id": "m_001001:0x139dc",
   "off": 80348,
   "max": 48,
   "kind": "dialogue",
   "jp": "ワシはぜひ\\nお前の新しい歌を\\n聴いてみたいぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x015a"
  },
  {
   "id": "m_001001:0x14304",
   "off": 82692,
   "max": 36,
   "kind": "dialogue",
   "jp": "本当か\\nそんなら\\nさっそく……",
   "en": "",
   "op": "0x62",
   "msg": "0x015b"
  },
  {
   "id": "m_001001:0x14c18",
   "off": 85016,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんじゃ\\n腹が減ってるのか\\nよしよし　",
   "en": "",
   "op": "0x62",
   "msg": "0x015c"
  },
  {
   "id": "m_001001:0x14c50",
   "off": 85072,
   "max": 52,
   "kind": "dialogue",
   "jp": "まずは腹ごしらえだな\\n腹が減っては\\nいい歌は出来ぬ",
   "en": "",
   "op": "0x62",
   "msg": "0x015d"
  },
  {
   "id": "m_001001:0x14c94",
   "off": 85140,
   "max": 36,
   "kind": "dialogue",
   "jp": "ワシが美味いメシを\\n馳走してやろう",
   "en": "",
   "op": "0x62",
   "msg": "0x015e"
  },
  {
   "id": "m_001001:0x1546c",
   "off": 87148,
   "max": 56,
   "kind": "dialogue",
   "jp": "美味いメシ！\\n京のメシは初めてじゃから\\n楽しみぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x015f"
  },
  {
   "id": "m_001001:0x15a3c",
   "off": 88636,
   "max": 60,
   "kind": "dialogue",
