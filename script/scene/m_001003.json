{
 "source": "m_001003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_001003:0x1548",
   "off": 5448,
   "max": 44,
   "kind": "dialogue",
   "jp": "すごい！　すごいよ！\\nお兄ちゃんたちの歌！",
   "en": "",
   "op": "0x62",
   "msg": "0x03aa"
  },
  {
   "id": "m_001003:0x19f0",
   "off": 6640,
   "max": 64,
   "kind": "dialogue",
   "jp": "なんかわかんないけど\\nすっごく胸が熱くなって\\nドキドキする！",
   "en": "",
   "op": "0x62",
   "msg": "0x03ab"
  },
  {
   "id": "m_001003:0x1eac",
   "off": 7852,
   "max": 24,
   "kind": "dialogue",
   "jp": "うん\\n元気が出てきた！",
   "en": "",
   "op": "0x62",
   "msg": "0x03ac"
  },
  {
   "id": "m_001003:0x293c",
   "off": 10556,
   "max": 24,
   "kind": "dialogue",
   "jp": "わしも最高の気分じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03ad"
  },
  {
   "id": "m_001003:0x2964",
   "off": 10596,
   "max": 72,
   "kind": "dialogue",
   "jp": "志を同じくするダチと\\n一緒に歌うのが　こんなに\\nいいモンだったとは",
   "en": "",
   "op": "0x62",
   "msg": "0x03ae"
  },
  {
   "id": "m_001003:0x314c",
   "off": 12620,
   "max": 52,
   "kind": "dialogue",
   "jp": "おい待て！\\nオレ様が　いつお前の\\nダチになった",
   "en": "",
   "op": "0x62",
   "msg": "0x03af"
  },
  {
   "id": "m_001003:0x37c0",
   "off": 14272,
   "max": 24,
   "kind": "dialogue",
   "jp": "じゃあ\\n手貸してくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x03b0"
  },
  {
   "id": "m_001003:0x3cf0",
   "off": 15600,
   "max": 8,
   "kind": "dialogue",
   "jp": "は？",
   "en": "",
   "op": "0x62",
   "msg": "0x03b1"
  },
  {
   "id": "m_001003:0x4320",
   "off": 17184,
   "max": 32,
   "kind": "dialogue",
   "jp": "ほい　握手！\\nこれでダチだな！",
   "en": "",
   "op": "0x62",
   "msg": "0x03b2"
  },
  {
   "id": "m_001003:0x48f8",
   "off": 18680,
   "max": 8,
   "kind": "dialogue",
   "jp": "違う",
   "en": "",
   "op": "0x62",
   "msg": "0x03b3"
  },
  {
   "id": "m_001003:0x5084",
   "off": 20612,
   "max": 64,
   "kind": "dialogue",
   "jp": "何を照れてるんだ？\\n一緒に歌った以上\\nわしらはもうダチだろ？",
   "en": "",
   "op": "0x62",
   "msg": "0x03b4"
  },
  {
   "id": "m_001003:0x50d4",
   "off": 20692,
   "max": 28,
   "kind": "dialogue",
   "jp": "なあ\\n\\fnt1シンディ！\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x03b5"
  },
  {
   "id": "m_001003:0x58a8",
   "off": 22696,
   "max": 12,
   "kind": "dialogue",
   "jp": "待て　貴様",
   "en": "",
   "op": "0x62",
   "msg": "0x03b6"
  },
  {
   "id": "m_001003:0x58c4",
   "off": 22724,
   "max": 64,
   "kind": "dialogue",
   "jp": "そのシンディってのは\\nまさかオレ様のことじゃ\\nないだろうな？",
   "en": "",
   "op": "0x62",
   "msg": "0x03b7"
  },
  {
   "id": "m_001003:0x6044",
   "off": 24644,
   "max": 48,
   "kind": "dialogue",
   "jp": "晋作って響きは\\nいまいち垢抜けないと\\n思うんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x03b8"
  },
  {
   "id": "m_001003:0x611c",
   "off": 24860,
   "max": 72,
   "kind": "dialogue",
   "jp": "それに　お前の演奏は\\nいかにも　\\fnt1シンディ\\fnt0\\nって感じじゃろ？",
   "en": "",
   "op": "0x62",
   "msg": "0x03b9"
  },
  {
   "id": "m_001003:0x6174",
   "off": 24948,
   "max": 40,
   "kind": "dialogue",
   "jp": "\\fnt1センセー\\fnt0も\\nそう思わんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x03ba"
  },
  {
   "id": "m_001003:0x6840",
   "off": 26688,
   "max": 32,
   "kind": "dialogue",
   "jp": "センセー？\\n私のことですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x03bb"
  },
  {
   "id": "m_001003:0x6ea0",
   "off": 28320,
   "max": 28,
   "kind": "dialogue",
   "jp": "そう！\\n物知りだからな！",
   "en": "",
   "op": "0x62",
   "msg": "0x03bc"
  },
  {
   "id": "m_001003:0x73d4",
   "off": 29652,
   "max": 36,
   "kind": "dialogue",
   "jp": "あ　そっちは\\n普通の理由なんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x03bd"
  },
  {
   "id": "m_001003:0x7874",
   "off": 30836,
   "max": 48,
   "kind": "dialogue",
   "jp": "とにかくシンディの歌も\\nセンセーの歌も最高だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03be"
  },
  {
   "id": "m_001003:0x78b4",
   "off": 30900,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんだか歌ってて\\n胸が熱くなったぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03bf"
  },
  {
   "id": "m_001003:0x7f78",
   "off": 32632,
   "max": 44,
   "kind": "dialogue",
   "jp": "けっ！　あんな最低の\\nセッションがあるか！",
   "en": "",
   "op": "0x62",
   "msg": "0x03c0"
  },
  {
   "id": "m_001003:0x84c0",
   "off": 33984,
   "max": 12,
   "kind": "dialogue",
   "jp": "ええっ",
   "en": "",
   "op": "0x62",
   "msg": "0x03c1"
  },
  {
   "id": "m_001003:0x8f24",
   "off": 36644,
   "max": 28,
   "kind": "dialogue",
   "jp": "テメェ\\n下手すぎんだよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03c2"
  },
  {
   "id": "m_001003:0x9a9c",
   "off": 39580,
   "max": 16,
   "kind": "dialogue",
   "jp": "へ　下手……",
   "en": "",
   "op": "0x62",
   "msg": "0x03c3"
  },
  {
   "id": "m_001003:0xa2e0",
   "off": 41696,
   "max": 44,
   "kind": "dialogue",
   "jp": "ダ　ダメですよ　晋作\\n本当のこと言っちゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x03c4"
  },
  {
   "id": "m_001003:0xa3b8",
   "off": 41912,
   "max": 44,
   "kind": "dialogue",
   "jp": "あ　いや　勢いだけは\\nあったと思いますよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x03c5"
  },
  {
   "id": "m_001003:0xaa2c",
   "off": 43564,
   "max": 24,
   "kind": "dialogue",
   "jp": "それ\\nフォローなんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x03c6"
  },
  {
   "id": "m_001003:0xaf5c",
   "off": 44892,
   "max": 32,
   "kind": "dialogue",
   "jp": "うんうん\\nかなりロックでした",
   "en": "",
   "op": "0x62",
   "msg": "0x03c7"
  },
  {
   "id": "m_001003:0xb618",
   "off": 46616,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや　あんなのは\\nロックじゃねえ！\\n認めねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03c8"
  },
  {
   "id": "m_001003:0xbb5c",
   "off": 47964,
   "max": 20,
   "kind": "dialogue",
   "jp": "わしのロックだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03c9"
  },
  {
   "id": "m_001003:0xc040",
   "off": 49216,
   "max": 24,
   "kind": "dialogue",
   "jp": "うるせえ\\nこのボケ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03ca"
  },
  {
   "id": "m_001003:0xc904",
   "off": 51460,
   "max": 48,
   "kind": "dialogue",
   "jp": "おや　見回りの武士達が\\n気が付いたみたいです",
   "en": "",
   "op": "0x62",
   "msg": "0x03cb"
  },
  {
   "id": "m_001003:0xd074",
   "off": 53364,
   "max": 64,
   "kind": "dialogue",
   "jp": "ぐ　ぐぐ……なんだ　この\\n頭を揺さぶられるような\\n感覚は……",
   "en": "",
   "op": "0x62",
   "msg": "0x03cc"
  },
  {
   "id": "m_001003:0xd6f4",
   "off": 55028,
   "max": 44,
   "kind": "dialogue",
   "jp": "これがロック……危険だ\\n上に報告せねば……",
   "en": "",
   "op": "0x62",
   "msg": "0x03cd"
  },
  {
   "id": "m_001003:0xdea4",
   "off": 56996,
   "max": 32,
   "kind": "dialogue",
   "jp": "むっ　お前ら\\nまだやる気か",
   "en": "",
   "op": "0x62",
   "msg": "0x03ce"
  },
  {
   "id": "m_001003:0xe69c",
   "off": 59036,
   "max": 36,
   "kind": "dialogue",
   "jp": "我々では歯が立たん\\n増援を呼ぶぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03cf"
  },
  {
   "id": "m_001003:0xeb58",
   "off": 60248,
   "max": 48,
   "kind": "dialogue",
   "jp": "\\fnt1出あえー！\\nここに反逆者が\\nいるぞ！\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x03d0"
  },
  {
   "id": "m_001003:0xf454",
   "off": 62548,
   "max": 8,
   "kind": "dialogue",
   "jp": "げっ",
   "en": "",
   "op": "0x62",
   "msg": "0x03d1"
  },
  {
   "id": "m_001003:0xfcb8",
   "off": 64696,
   "max": 24,
   "kind": "dialogue",
   "jp": "くそっ\\nこいつら……",
   "en": "",
   "op": "0x62",
   "msg": "0x03d2"
  },
  {
   "id": "m_001003:0x10154",
   "off": 65876,
   "max": 64,
   "kind": "dialogue",
   "jp": "ダメですよ　晋作\\nここでこれ以上彼らに\\nかまけていてはまずい",
   "en": "",
   "op": "0x62",
   "msg": "0x03d3"
  },
  {
   "id": "m_001003:0x10610",
   "off": 67088,
   "max": 16,
   "kind": "dialogue",
   "jp": "逃げましょう！",
   "en": "",
   "op": "0x62",
   "msg": "0x03d4"
  },
  {
   "id": "m_001003:0x10c0c",
   "off": 68620,
   "max": 52,
   "kind": "dialogue",
   "jp": "ちっ\\n今はそうするしかねえか\\nおい　龍馬　行くぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x03d5"
  },
  {
   "id": "m_001003:0x112d8",
   "off": 70360,
   "max": 40,
   "kind": "dialogue",
   "jp": "おうっ　シンディ！\\n子供らも行くぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03d6"
  },
  {
   "id": "m_001003:0x11a88",
   "off": 72328,
   "max": 12,
   "kind": "dialogue",
   "jp": "うんっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03d7"
  },
  {
   "id": "m_001003:0x1246c",
   "off": 74860,
   "max": 32,
   "kind": "dialogue",
   "jp": "だから\\nシンディって呼ぶな！",
   "en": "",
   "op": "0x62",
   "msg": "0x03d8"
  },
  {
   "id": "m_001003:0x12bb0",
   "off": 76720,
   "max": 60,
   "kind": "dialogue",
   "jp": "まあいいじゃないですか\\nけっこう似合ってますよ\\nシンディ",
   "en": "",
   "op": "0x62",
   "msg": "0x03d9"
  },
  {
   "id": "m_001003:0x13230",
   "off": 78384,
   "max": 60,
   "kind": "dialogue",
   "jp": "よしてくれ桂さん\\nくそっ　やっぱり\\nむかつく野郎だぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03da"
  },
  {
   "id": "m_001003:0x136e8",
   "off": 79592,
   "max": 68,
   "kind": "dialogue",
   "jp": "まあまあ　でもこれで\\n泥棒の疑いは晴らして\\nあげてもいいでしょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x03db"
  },
  {
   "id": "m_001003:0x13ba8",
   "off": 80808,
   "max": 24,
   "kind": "dialogue",
   "jp": "……ちっ\\nおい　龍馬！",
   "en": "",
   "op": "0x62",
   "msg": "0x03dc"
  },
  {
   "id": "m_001003:0x14344",
   "off": 82756,
   "max": 16,
   "kind": "dialogue",
   "jp": "なんだシンディ",
   "en": "",
   "op": "0x62",
   "msg": "0x03dd"
  },
  {
   "id": "m_001003:0x149f4",
   "off": 84468,
   "max": 28,
   "kind": "dialogue",
   "jp": "だから\\nシンディじゃねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03de"
  },
  {
   "id": "m_001003:0x14e94",
   "off": 85652,
   "max": 48,
   "kind": "dialogue",
   "jp": "まあいい\\n盗人呼ばわりしたことは\\n訂正してやる",
   "en": "",
   "op": "0x62",
   "msg": "0x03df"
  },
  {
   "id": "m_001003:0x15340",
   "off": 86848,
   "max": 12,
   "kind": "dialogue",
   "jp": "ホントか",
   "en": "",
   "op": "0x62",
   "msg": "0x03e0"
  },
  {
   "id": "m_001003:0x157c8",
   "off": 88008,
   "max": 72,
   "kind": "dialogue",
   "jp": "ああ　だがな　オレ様は\\nまだ貴様をロックだと\\n認めた訳じゃねえからな！",
   "en": "",
   "op": "0x62",
   "msg": "0x03e1"
  },
  {
   "id": "m_001003:0x15dfc",
   "off": 89596,
   "max": 12,
   "kind": "dialogue",
   "jp": "頑固だなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x03e2"
  },
  {
   "id": "m_001003:0x16828",
   "off": 92200,
   "max": 36,
   "kind": "dialogue",
   "jp": "どこだ！\\nお上に楯突く\\n不埒者は！",
   "en": "",
   "op": "0x62",
   "msg": "0x03e3"
  },
  {
   "id": "m_001003:0x17084",
   "off": 94340,
   "max": 48,
   "kind": "dialogue",
   "jp": "ってそんなことを\\n言ってる場合じゃ\\nないですね",
   "en": "",
   "op": "0x62",
   "msg": "0x03e4"
  },
  {
   "id": "m_001003:0x176f8",
   "off": 95992,
   "max": 48,
   "kind": "dialogue",
   "jp": "桂さん！\\nこういうときこそ\\nなんかねえのかよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03e5"
  },
  {
   "id": "m_001003:0x17c48",
   "off": 97352,
   "max": 12,
   "kind": "dialogue",
   "jp": "ええ～……",
   "en": "",
   "op": "0x62",
   "msg": "0x03e6"
  },
  {
   "id": "m_001003:0x17c6c",
   "off": 97388,
   "max": 20,
   "kind": "dialogue",
   "jp": "じゃあ\\nこれですね",
   "en": "",
   "op": "0x62",
   "msg": "0x03e7"
  },
  {
   "id": "m_001003:0x18ddc",
   "off": 101852,
   "max": 32,
   "kind": "dialogue",
   "jp": "うぷっ！\\nな　なんだこれは？",
   "en": "",
   "op": "0x62",
   "msg": "0x03e8"
  },
  {
   "id": "m_001003:0x19280",
   "off": 103040,
   "max": 48,
   "kind": "dialogue",
   "jp": "け　煙玉？\\nそれにしてはやけに\\n甘い匂いの……",
   "en": "",
   "op": "0x62",
   "msg": "0x03e9"
  },
  {
   "id": "m_001003:0x19a38",
   "off": 105016,
   "max": 52,
   "kind": "dialogue",
   "jp": "私の発明した\\nおはぎの匂いつき煙玉は\\nどうですか！",
   "en": "",
   "op": "0x62",
   "msg": "0x03ea"
  },
  {
   "id": "m_001003:0x1a0b0",
   "off": 106672,
   "max": 68,
   "kind": "dialogue",
   "jp": "匂いの意味がわからねえ！\\nしかも　ごほっ！\\nオレたちまでけむい！",
   "en": "",
   "op": "0x62",
   "msg": "0x03eb"
  },
  {
   "id": "m_001003:0x1a878",
   "off": 108664,
   "max": 64,
   "kind": "dialogue",
   "jp": "で　でもこの隙に\\n逃げられそうじゃ！　\\nシンディ！　センセー！",
   "en": "",
   "op": "0x62",
   "msg": "0x03ec"
  },
  {
   "id": "m_001003:0x1afa8",
   "off": 110504,
   "max": 28,
   "kind": "dialogue",
   "jp": "だからシンディじゃねぇ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03ed"
  },
  {
   "id": "m_001003:0x1b668",
   "off": 112232,
   "max": 28,
   "kind": "dialogue",
   "jp": "いいから\\n逃げますよ～っ！",
   "en": "",
   "op": "0x62",
   "msg": "0x03ee"
  },
  {
   "id": "m_001003:0x1bb1c",
   "off": 113436,
   "max": 56,
   "kind": "dialogue",
   "jp": "こうして京にて\\n高杉　桂と運命の\\n邂逅を果たした龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x03ef"
  },
  {
   "id": "m_001003:0x1bb64",
   "off": 113508,
   "max": 40,
   "kind": "dialogue",
   "jp": "この先\\n彼らに待ち受ける\\n運命とは……",
   "en": "",
   "op": "0x62",
   "msg": "0x03f0"
  }
 ]
}
