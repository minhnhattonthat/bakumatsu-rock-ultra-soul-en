{
 "source": "m_001003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_001003:0x1548",
   "off": 5448,
   "max": 44,
   "kind": "dialogue",
   "jp": "すごい！　すごいよ！\\nお兄ちゃんたちの歌！",
   "en": "Amazing! That\\nwas amazing!\\nYour song,\\nmisters!",
   "op": "0x62",
   "msg": "0x03aa"
  },
  {
   "id": "m_001003:0x19f0",
   "off": 6640,
   "max": 64,
   "kind": "dialogue",
   "jp": "なんかわかんないけど\\nすっごく胸が熱くなって\\nドキドキする！",
   "en": "I don't really get\\nit, but my chest\\nfeels all hot and\\nmy heart's\\npounding!",
   "op": "0x62",
   "msg": "0x03ab"
  },
  {
   "id": "m_001003:0x1eac",
   "off": 7852,
   "max": 24,
   "kind": "dialogue",
   "jp": "うん\\n元気が出てきた！",
   "en": "Yeah! I feel all\\ncheered up!",
   "op": "0x62",
   "msg": "0x03ac"
  },
  {
   "id": "m_001003:0x293c",
   "off": 10556,
   "max": 24,
   "kind": "dialogue",
   "jp": "わしも最高の気分じゃ！",
   "en": "I feel great too!",
   "op": "0x62",
   "msg": "0x03ad"
  },
  {
   "id": "m_001003:0x2964",
   "off": 10596,
   "max": 72,
   "kind": "dialogue",
   "jp": "志を同じくするダチと\\n一緒に歌うのが　こんなに\\nいいモンだったとは",
   "en": "Who knew singin'\\nwith buddies who\\nshare your dream\\ncould feel this\\ngood?",
   "op": "0x62",
   "msg": "0x03ae"
  },
  {
   "id": "m_001003:0x314c",
   "off": 12620,
   "max": 52,
   "kind": "dialogue",
   "jp": "おい待て！\\nオレ様が　いつお前の\\nダチになった",
   "en": "Hey, hold it! Since\\nwhen am I your\\nbuddy!?",
   "op": "0x62",
   "msg": "0x03af"
  },
  {
   "id": "m_001003:0x37c0",
   "off": 14272,
   "max": 24,
   "kind": "dialogue",
   "jp": "じゃあ\\n手貸してくれ",
   "en": "Then gimme your\\nhand.",
   "op": "0x62",
   "msg": "0x03b0"
  },
  {
   "id": "m_001003:0x3cf0",
   "off": 15600,
   "max": 8,
   "kind": "dialogue",
   "jp": "は？",
   "en": "Huh?",
   "op": "0x62",
   "msg": "0x03b1"
  },
  {
   "id": "m_001003:0x4320",
   "off": 17184,
   "max": 32,
   "kind": "dialogue",
   "jp": "ほい　握手！\\nこれでダチだな！",
   "en": "There, a\\nhandshake! Now\\nwe're buddies!",
   "op": "0x62",
   "msg": "0x03b2"
  },
  {
   "id": "m_001003:0x48f8",
   "off": 18680,
   "max": 8,
   "kind": "dialogue",
   "jp": "違う",
   "en": "No, we're not.",
   "op": "0x62",
   "msg": "0x03b3"
  },
  {
   "id": "m_001003:0x5084",
   "off": 20612,
   "max": 64,
   "kind": "dialogue",
   "jp": "何を照れてるんだ？\\n一緒に歌った以上\\nわしらはもうダチだろ？",
   "en": "What're you bein'\\nshy for? Once\\nwe've sung\\ntogether, we're\\nbuddies, right?",
   "op": "0x62",
   "msg": "0x03b4"
  },
  {
   "id": "m_001003:0x50d4",
   "off": 20692,
   "max": 28,
   "kind": "dialogue",
   "jp": "なあ\\n\\fnt1シンディ！\\fnt0",
   "en": "Ain't that right,\\n\\fnt1Shindy!\\fnt0",
   "op": "0x62",
   "msg": "0x03b5"
  },
  {
   "id": "m_001003:0x58a8",
   "off": 22696,
   "max": 12,
   "kind": "dialogue",
   "jp": "待て　貴様",
   "en": "Hold it, you.",
   "op": "0x62",
   "msg": "0x03b6"
  },
  {
   "id": "m_001003:0x58c4",
   "off": 22724,
   "max": 64,
   "kind": "dialogue",
   "jp": "そのシンディってのは\\nまさかオレ様のことじゃ\\nないだろうな？",
   "en": "This \"Shindy\"...\\nYou'd better not\\nmean yours truly.",
   "op": "0x62",
   "msg": "0x03b7"
  },
  {
   "id": "m_001003:0x6044",
   "off": 24644,
   "max": 48,
   "kind": "dialogue",
   "jp": "晋作って響きは\\nいまいち垢抜けないと\\n思うんだ",
   "en": "\"Shinsaku\" just\\nsounds kinda\\nunpolished to me,\\ny'know.",
   "op": "0x62",
   "msg": "0x03b8"
  },
  {
   "id": "m_001003:0x611c",
   "off": 24860,
   "max": 72,
   "kind": "dialogue",
   "jp": "それに　お前の演奏は\\nいかにも　\\fnt1シンディ\\fnt0\\nって感じじゃろ？",
   "en": "Besides, your\\nplayin's got a real\\n\\fnt1Shindy\\fnt0 feel to it,\\ndon't it?",
   "op": "0x62",
   "msg": "0x03b9"
  },
  {
   "id": "m_001003:0x6174",
   "off": 24948,
   "max": 40,
   "kind": "dialogue",
   "jp": "\\fnt1センセー\\fnt0も\\nそう思わんか？",
   "en": "Don't you think so\\ntoo, \\fnt1Sensei\\fnt0?",
   "op": "0x62",
   "msg": "0x03ba"
  },
  {
   "id": "m_001003:0x6840",
   "off": 26688,
   "max": 32,
   "kind": "dialogue",
   "jp": "センセー？\\n私のことですか？",
   "en": "Sensei? Do you\\nmean me?",
   "op": "0x62",
   "msg": "0x03bb"
  },
  {
   "id": "m_001003:0x6ea0",
   "off": 28320,
   "max": 28,
   "kind": "dialogue",
   "jp": "そう！\\n物知りだからな！",
   "en": "Yep! 'Cause you\\nknow so much\\nstuff!",
   "op": "0x62",
   "msg": "0x03bc"
  },
  {
   "id": "m_001003:0x73d4",
   "off": 29652,
   "max": 36,
   "kind": "dialogue",
   "jp": "あ　そっちは\\n普通の理由なんですね",
   "en": "Ah, so for me\\nthere's a perfectly\\nnormal reason.",
   "op": "0x62",
   "msg": "0x03bd"
  },
  {
   "id": "m_001003:0x7874",
   "off": 30836,
   "max": 48,
   "kind": "dialogue",
   "jp": "とにかくシンディの歌も\\nセンセーの歌も最高だ！",
   "en": "Anyway, Shindy's\\nsong and Sensei's\\nsong were both\\nthe best!",
   "op": "0x62",
   "msg": "0x03be"
  },
  {
   "id": "m_001003:0x78b4",
   "off": 30900,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんだか歌ってて\\n胸が熱くなったぜよ！",
   "en": "Singin' with you\\ngot my heart all\\nfired up, I tell ya!",
   "op": "0x62",
   "msg": "0x03bf"
  },
  {
   "id": "m_001003:0x7f78",
   "off": 32632,
   "max": 44,
   "kind": "dialogue",
   "jp": "けっ！　あんな最低の\\nセッションがあるか！",
   "en": "Tch! That was the\\nworst session\\never!",
   "op": "0x62",
   "msg": "0x03c0"
  },
  {
   "id": "m_001003:0x84c0",
   "off": 33984,
   "max": 12,
   "kind": "dialogue",
   "jp": "ええっ",
   "en": "Huh!?",
   "op": "0x62",
   "msg": "0x03c1"
  },
  {
   "id": "m_001003:0x8f24",
   "off": 36644,
   "max": 28,
   "kind": "dialogue",
   "jp": "テメェ\\n下手すぎんだよ！",
   "en": "You're way too\\nawful!",
   "op": "0x62",
   "msg": "0x03c2"
  },
  {
   "id": "m_001003:0x9a9c",
   "off": 39580,
   "max": 16,
   "kind": "dialogue",
   "jp": "へ　下手……",
   "en": "A-awful...",
   "op": "0x62",
   "msg": "0x03c3"
  },
  {
   "id": "m_001003:0xa2e0",
   "off": 41696,
   "max": 44,
   "kind": "dialogue",
   "jp": "ダ　ダメですよ　晋作\\n本当のこと言っちゃ",
   "en": "Sh-Shinsaku, you\\nmustn't tell him\\nthe truth.",
   "op": "0x62",
   "msg": "0x03c4"
  },
  {
   "id": "m_001003:0xa3b8",
   "off": 41912,
   "max": 44,
   "kind": "dialogue",
   "jp": "あ　いや　勢いだけは\\nあったと思いますよ？",
   "en": "Ah, er, I think\\nyou certainly had\\nenergy, at least?",
   "op": "0x62",
   "msg": "0x03c5"
  },
  {
   "id": "m_001003:0xaa2c",
   "off": 43564,
   "max": 24,
   "kind": "dialogue",
   "jp": "それ\\nフォローなんか？",
   "en": "Is that supposed\\nto make me feel\\nbetter?",
   "op": "0x62",
   "msg": "0x03c6"
  },
  {
   "id": "m_001003:0xaf5c",
   "off": 44892,
   "max": 32,
   "kind": "dialogue",
   "jp": "うんうん\\nかなりロックでした",
   "en": "Yes, yes. It was\\nquite rock.",
   "op": "0x62",
   "msg": "0x03c7"
  },
  {
   "id": "m_001003:0xb618",
   "off": 46616,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや　あんなのは\\nロックじゃねえ！\\n認めねえ！",
   "en": "No, that wasn't\\nrock! I don't\\naccept it!",
   "op": "0x62",
   "msg": "0x03c8"
  },
  {
   "id": "m_001003:0xbb5c",
   "off": 47964,
   "max": 20,
   "kind": "dialogue",
   "jp": "わしのロックだ！",
   "en": "It's MY rock!",
   "op": "0x62",
   "msg": "0x03c9"
  },
  {
   "id": "m_001003:0xc040",
   "off": 49216,
   "max": 24,
   "kind": "dialogue",
   "jp": "うるせえ\\nこのボケ！",
   "en": "Shut up, you\\ndope!",
   "op": "0x62",
   "msg": "0x03ca"
  },
  {
   "id": "m_001003:0xc904",
   "off": 51460,
   "max": 48,
   "kind": "dialogue",
   "jp": "おや　見回りの武士達が\\n気が付いたみたいです",
   "en": "Oh my, it seems\\nthe patrolling\\nsamurai have\\ncome to.",
   "op": "0x62",
   "msg": "0x03cb"
  },
  {
   "id": "m_001003:0xd074",
   "off": 53364,
   "max": 64,
   "kind": "dialogue",
   "jp": "ぐ　ぐぐ……なんだ　この\\n頭を揺さぶられるような\\n感覚は……",
   "en": "Ngh, nggh... What\\nis this feeling,\\nlike my head's\\nbeing shaken...",
   "op": "0x62",
   "msg": "0x03cc"
  },
  {
   "id": "m_001003:0xd6f4",
   "off": 55028,
   "max": 44,
   "kind": "dialogue",
   "jp": "これがロック……危険だ\\n上に報告せねば……",
   "en": "So this is rock...\\nIt's dangerous. I\\nmust report this\\nto my superiors...",
   "op": "0x62",
   "msg": "0x03cd"
  },
  {
   "id": "m_001003:0xdea4",
   "off": 56996,
   "max": 32,
   "kind": "dialogue",
   "jp": "むっ　お前ら\\nまだやる気か",
   "en": "Hm! You guys still\\nwanna go?",
   "op": "0x62",
   "msg": "0x03ce"
  },
  {
   "id": "m_001003:0xe69c",
   "off": 59036,
   "max": 36,
   "kind": "dialogue",
   "jp": "我々では歯が立たん\\n増援を呼ぶぞ！",
   "en": "We're no match\\nfor them. Call for\\nbackup!",
   "op": "0x62",
   "msg": "0x03cf"
  },
  {
   "id": "m_001003:0xeb58",
   "off": 60248,
   "max": 48,
   "kind": "dialogue",
   "jp": "\\fnt1出あえー！\\nここに反逆者が\\nいるぞ！\\fnt0",
   "en": "\\fnt1To arms! There\\nare rebels here!\\fnt0",
   "op": "0x62",
   "msg": "0x03d0"
  },
  {
   "id": "m_001003:0xf454",
   "off": 62548,
   "max": 8,
   "kind": "dialogue",
   "jp": "げっ",
   "en": "Uh-oh.",
   "op": "0x62",
   "msg": "0x03d1"
  },
  {
   "id": "m_001003:0xfcb8",
   "off": 64696,
   "max": 24,
   "kind": "dialogue",
   "jp": "くそっ\\nこいつら……",
   "en": "Dammit, these\\nguys...",
   "op": "0x62",
   "msg": "0x03d2"
  },
  {
   "id": "m_001003:0x10154",
   "off": 65876,
   "max": 64,
   "kind": "dialogue",
   "jp": "ダメですよ　晋作\\nここでこれ以上彼らに\\nかまけていてはまずい",
   "en": "No, Shinsaku. We\\ncan't afford to\\nwaste any more\\ntime on them\\nhere.",
   "op": "0x62",
   "msg": "0x03d3"
  },
  {
   "id": "m_001003:0x10610",
   "off": 67088,
   "max": 16,
   "kind": "dialogue",
   "jp": "逃げましょう！",
   "en": "Let's run!",
   "op": "0x62",
   "msg": "0x03d4"
  },
  {
   "id": "m_001003:0x10c0c",
   "off": 68620,
   "max": 52,
   "kind": "dialogue",
   "jp": "ちっ\\n今はそうするしかねえか\\nおい　龍馬　行くぞ",
   "en": "Tch. Guess there's\\nno choice right\\nnow. Hey, Ryoma,\\nlet's go.",
   "op": "0x62",
   "msg": "0x03d5"
  },
  {
   "id": "m_001003:0x112d8",
   "off": 70360,
   "max": 40,
   "kind": "dialogue",
   "jp": "おうっ　シンディ！\\n子供らも行くぜよ！",
   "en": "Right, Shindy!\\nYou kids come\\ntoo!",
   "op": "0x62",
   "msg": "0x03d6"
  },
  {
   "id": "m_001003:0x11a88",
   "off": 72328,
   "max": 12,
   "kind": "dialogue",
   "jp": "うんっ！",
   "en": "Okay!",
   "op": "0x62",
   "msg": "0x03d7"
  },
  {
   "id": "m_001003:0x1246c",
   "off": 74860,
   "max": 32,
   "kind": "dialogue",
   "jp": "だから\\nシンディって呼ぶな！",
   "en": "I said, don't call\\nme Shindy!",
   "op": "0x62",
   "msg": "0x03d8"
  },
  {
   "id": "m_001003:0x12bb0",
   "off": 76720,
   "max": 60,
   "kind": "dialogue",
   "jp": "まあいいじゃないですか\\nけっこう似合ってますよ\\nシンディ",
   "en": "Oh, what's the\\nharm? It suits you\\nrather well,\\nShindy.",
   "op": "0x62",
   "msg": "0x03d9"
  },
  {
   "id": "m_001003:0x13230",
   "off": 78384,
   "max": 60,
   "kind": "dialogue",
   "jp": "よしてくれ桂さん\\nくそっ　やっぱり\\nむかつく野郎だぜ！",
   "en": "Cut it out,\\nKatsura-san.\\nDammit, this guy\\nreally gets on my\\nnerves!",
   "op": "0x62",
   "msg": "0x03da"
  },
  {
   "id": "m_001003:0x136e8",
   "off": 79592,
   "max": 68,
   "kind": "dialogue",
   "jp": "まあまあ　でもこれで\\n泥棒の疑いは晴らして\\nあげてもいいでしょう？",
   "en": "Now, now. But\\nafter all this,\\nsurely you can\\nclear him of being\\na thief?",
   "op": "0x62",
   "msg": "0x03db"
  },
  {
   "id": "m_001003:0x13ba8",
   "off": 80808,
   "max": 24,
   "kind": "dialogue",
   "jp": "……ちっ\\nおい　龍馬！",
   "en": "...Tch. Hey,\\nRyoma!",
   "op": "0x62",
   "msg": "0x03dc"
  },
  {
   "id": "m_001003:0x14344",
   "off": 82756,
   "max": 16,
   "kind": "dialogue",
   "jp": "なんだシンディ",
   "en": "What is it,\\nShindy?",
   "op": "0x62",
   "msg": "0x03dd"
  },
  {
   "id": "m_001003:0x149f4",
   "off": 84468,
   "max": 28,
   "kind": "dialogue",
   "jp": "だから\\nシンディじゃねえ！",
   "en": "I said, I'm not\\nShindy!",
   "op": "0x62",
   "msg": "0x03de"
  },
  {
   "id": "m_001003:0x14e94",
   "off": 85652,
   "max": 48,
   "kind": "dialogue",
   "jp": "まあいい\\n盗人呼ばわりしたことは\\n訂正してやる",
   "en": "Whatever. I'll take\\nback calling you a\\nthief.",
   "op": "0x62",
   "msg": "0x03df"
  },
  {
   "id": "m_001003:0x15340",
   "off": 86848,
   "max": 12,
   "kind": "dialogue",
   "jp": "ホントか",
   "en": "Really?",
   "op": "0x62",
   "msg": "0x03e0"
  },
  {
   "id": "m_001003:0x157c8",
   "off": 88008,
   "max": 72,
   "kind": "dialogue",
   "jp": "ああ　だがな　オレ様は\\nまだ貴様をロックだと\\n認めた訳じゃねえからな！",
   "en": "Yeah. But get\\nthis: yours truly\\nstill hasn't\\naccepted that\\nyou're rock!",
   "op": "0x62",
   "msg": "0x03e1"
  },
  {
   "id": "m_001003:0x15dfc",
   "off": 89596,
   "max": 12,
   "kind": "dialogue",
   "jp": "頑固だなあ",
   "en": "Stubborn, ain't ya.",
   "op": "0x62",
   "msg": "0x03e2"
  },
  {
   "id": "m_001003:0x16828",
   "off": 92200,
   "max": 36,
   "kind": "dialogue",
   "jp": "どこだ！\\nお上に楯突く\\n不埒者は！",
   "en": "Where are you!\\nShow yourselves,\\nyou scoundrels\\ndefying the\\nauthorities!",
   "op": "0x62",
   "msg": "0x03e3"
  },
  {
   "id": "m_001003:0x17084",
   "off": 94340,
   "max": 48,
   "kind": "dialogue",
   "jp": "ってそんなことを\\n言ってる場合じゃ\\nないですね",
   "en": "Ah, this is hardly\\nthe time for that,\\nis it?",
   "op": "0x62",
   "msg": "0x03e4"
  },
  {
   "id": "m_001003:0x176f8",
   "off": 95992,
   "max": 48,
   "kind": "dialogue",
   "jp": "桂さん！\\nこういうときこそ\\nなんかねえのかよ！",
   "en": "Katsura-san!\\nSurely you've got\\nsomething for a\\ntime like this!",
   "op": "0x62",
   "msg": "0x03e5"
  },
  {
   "id": "m_001003:0x17c48",
   "off": 97352,
   "max": 12,
   "kind": "dialogue",
   "jp": "ええ～……",
   "en": "Weeell...",
   "op": "0x62",
   "msg": "0x03e6"
  },
  {
   "id": "m_001003:0x17c6c",
   "off": 97388,
   "max": 20,
   "kind": "dialogue",
   "jp": "じゃあ\\nこれですね",
   "en": "Then, this should\\ndo.",
   "op": "0x62",
   "msg": "0x03e7"
  },
  {
   "id": "m_001003:0x18ddc",
   "off": 101852,
   "max": 32,
   "kind": "dialogue",
   "jp": "うぷっ！\\nな　なんだこれは？",
   "en": "Bwuh! Wh-what is\\nthis?",
   "op": "0x62",
   "msg": "0x03e8"
  },
  {
   "id": "m_001003:0x19280",
   "off": 103040,
   "max": 48,
   "kind": "dialogue",
   "jp": "け　煙玉？\\nそれにしてはやけに\\n甘い匂いの……",
   "en": "A-a smoke bomb?\\nBut it smells\\nawfully sweet for\\none...",
   "op": "0x62",
   "msg": "0x03e9"
  },
  {
   "id": "m_001003:0x19a38",
