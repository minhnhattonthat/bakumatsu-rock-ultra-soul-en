{
 "source": "m_002001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_002001:0x11d0",
   "off": 4560,
   "max": 52,
   "kind": "dialogue",
   "jp": "徳川家が\\n江戸幕府を開き\\n二百余年の時が過ぎた――",
   "en": "",
   "op": "0x62",
   "msg": "0x0424"
  },
  {
   "id": "m_002001:0x1214",
   "off": 4628,
   "max": 72,
   "kind": "dialogue",
   "jp": "いく度ものうつり世を\\n重ねてきた日の本は　今\\n暗い病に冒されつつあった",
   "en": "",
   "op": "0x62",
   "msg": "0x0425"
  },
  {
   "id": "m_002001:0x126c",
   "off": 4716,
   "max": 56,
   "kind": "dialogue",
   "jp": "幕府の進める泰平化\\nそしてその政策をめぐる\\n様々な攻防",
   "en": "",
   "op": "0x62",
   "msg": "0x0426"
  },
  {
   "id": "m_002001:0x12b4",
   "off": 4788,
   "max": 76,
   "kind": "dialogue",
   "jp": "誰もが　漠然とした\\n不安をかかえながら\\n見えない明日を\\n模索していた……",
   "en": "",
   "op": "0x62",
   "msg": "0x0427"
  },
  {
   "id": "m_002001:0x1bb8",
   "off": 7096,
   "max": 24,
   "kind": "dialogue",
   "jp": "こちらでしたか\\n慶喜様",
   "en": "",
   "op": "0x62",
   "msg": "0x0428"
  },
  {
   "id": "m_002001:0x245c",
   "off": 9308,
   "max": 12,
   "kind": "dialogue",
   "jp": "直弼か……",
   "en": "",
   "op": "0x62",
   "msg": "0x0429"
  },
  {
   "id": "m_002001:0x2b48",
   "off": 11080,
   "max": 52,
   "kind": "dialogue",
   "jp": "今夜の三日月は\\nとりわけ美しいと\\n思わないかい？",
   "en": "",
   "op": "0x62",
   "msg": "0x042a"
  },
  {
   "id": "m_002001:0x2ffc",
   "off": 12284,
   "max": 8,
   "kind": "dialogue",
   "jp": "はい",
   "en": "",
   "op": "0x62",
   "msg": "0x042b"
  },
  {
   "id": "m_002001:0x3484",
   "off": 13444,
   "max": 64,
   "kind": "dialogue",
   "jp": "ゆらめく月の光が\\nまるで　ちっぽけな予を\\nあざけているようだ",
   "en": "",
   "op": "0x62",
   "msg": "0x042c"
  },
  {
   "id": "m_002001:0x3944",
   "off": 14660,
   "max": 24,
   "kind": "dialogue",
   "jp": "滅相も\\nござりません",
   "en": "",
   "op": "0x62",
   "msg": "0x042d"
  },
  {
   "id": "m_002001:0x3ddc",
   "off": 15836,
   "max": 40,
   "kind": "dialogue",
   "jp": "で　どうしたんだい？\\nこんな夜更けに",
   "en": "",
   "op": "0x62",
   "msg": "0x042e"
  },
  {
   "id": "m_002001:0x4694",
   "off": 18068,
   "max": 36,
   "kind": "dialogue",
   "jp": "例のモノの\\n行方につきまして……",
   "en": "",
   "op": "0x62",
   "msg": "0x042f"
  },
  {
   "id": "m_002001:0x4f1c",
   "off": 20252,
   "max": 28,
   "kind": "dialogue",
   "jp": "例のモノ……\\nああ　うん",
   "en": "",
   "op": "0x62",
   "msg": "0x0430"
  },
  {
   "id": "m_002001:0x53b4",
   "off": 21428,
   "max": 44,
   "kind": "dialogue",
   "jp": "比叡山の僧たちに方位を\\n占わせましたところ",
   "en": "",
   "op": "0x62",
   "msg": "0x0431"
  },
  {
   "id": "m_002001:0x53f0",
   "off": 21488,
   "max": 60,
   "kind": "dialogue",
   "jp": "大宇陀に散った\\n五つの片魂\\n（ピースソウル）\\nそのすべてが",
   "en": "",
   "op": "0x62",
   "msg": "0x0432"
  },
  {
   "id": "m_002001:0x543c",
   "off": 21564,
   "max": 52,
   "kind": "dialogue",
   "jp": "この京に集まりつつある\\nとの結果が\\n出てございます",
   "en": "",
   "op": "0x62",
   "msg": "0x0433"
  },
  {
   "id": "m_002001:0x5bf8",
   "off": 23544,
   "max": 8,
   "kind": "dialogue",
   "jp": "へえ",
   "en": "",
   "op": "0x62",
   "msg": "0x0434"
  },
  {
   "id": "m_002001:0x607c",
   "off": 24700,
   "max": 32,
   "kind": "dialogue",
   "jp": "あんまり興味が\\nなかったけど",
   "en": "",
   "op": "0x62",
   "msg": "0x0435"
  },
  {
   "id": "m_002001:0x6720",
   "off": 26400,
   "max": 40,
   "kind": "dialogue",
   "jp": "それは　ちょっと\\n面白いかもしれないね",
   "en": "",
   "op": "0x62",
   "msg": "0x0436"
  },
  {
   "id": "m_002001:0x6e68",
   "off": 28264,
   "max": 40,
   "kind": "dialogue",
   "jp": "慶喜様！\\n面白いなどと\\nそのような――",
   "en": "",
   "op": "0x62",
   "msg": "0x0437"
  },
  {
   "id": "m_002001:0x74d4",
   "off": 29908,
   "max": 16,
   "kind": "dialogue",
   "jp": "いいじゃないか",
   "en": "",
   "op": "0x62",
   "msg": "0x0438"
  },
  {
   "id": "m_002001:0x79fc",
   "off": 31228,
   "max": 56,
   "kind": "dialogue",
   "jp": "太古より存在し\\nその強大な力故に\\n封じられし超魂……",
   "en": "",
   "op": "0x62",
   "msg": "0x0439"
  },
  {
   "id": "m_002001:0x7a44",
   "off": 31300,
   "max": 48,
   "kind": "dialogue",
   "jp": "それが　五つに砕け\\nこの日本に\\n散らばった……",
   "en": "",
   "op": "0x62",
   "msg": "0x043a"
  },
  {
   "id": "m_002001:0x7ef0",
   "off": 32496,
   "max": 16,
   "kind": "dialogue",
   "jp": "預言によれば",
   "en": "",
   "op": "0x62",
   "msg": "0x043b"
  },
  {
   "id": "m_002001:0x87f4",
   "off": 34804,
   "max": 60,
   "kind": "dialogue",
   "jp": "超魂を持つ者が\\n立ち上がったとき\\n時代が大きく変わる……",
   "en": "",
   "op": "0x62",
   "msg": "0x043c"
  },
  {
   "id": "m_002001:0x8dcc",
   "off": 36300,
   "max": 48,
   "kind": "dialogue",
   "jp": "つまり　徳川の世が終わる\\nそうだったね？　直弼",
   "en": "",
   "op": "0x62",
   "msg": "0x043d"
  },
  {
   "id": "m_002001:0x9440",
   "off": 37952,
   "max": 44,
   "kind": "dialogue",
   "jp": "はい\\nしかしご安心下さい\\nすでに男は死に",
   "en": "",
   "op": "0x62",
   "msg": "0x043e"
  },
  {
   "id": "m_002001:0x947c",
   "off": 38012,
   "max": 48,
   "kind": "dialogue",
   "jp": "片魂も　二度と\\n超魂に戻ることは\\nございません",
   "en": "",
   "op": "0x62",
   "msg": "0x043f"
  },
  {
   "id": "m_002001:0x9da0",
   "off": 40352,
   "max": 12,
   "kind": "dialogue",
   "jp": "この　直弼",
   "en": "",
   "op": "0x62",
   "msg": "0x0440"
  },
  {
   "id": "m_002001:0xa2c4",
   "off": 41668,
   "max": 44,
   "kind": "dialogue",
   "jp": "片魂のひとつに\\n呪いをかけて\\nおりまする",
   "en": "",
   "op": "0x62",
   "msg": "0x0441"
  },
  {
   "id": "m_002001:0xaa10",
   "off": 43536,
   "max": 8,
   "kind": "dialogue",
   "jp": "呪い？",
   "en": "",
   "op": "0x62",
   "msg": "0x0442"
  },
  {
   "id": "m_002001:0xb0b4",
   "off": 45236,
   "max": 36,
   "kind": "dialogue",
   "jp": "徳川を守護する我らに\\n伝わる秘術",
   "en": "",
   "op": "0x62",
   "msg": "0x0443"
  },
  {
   "id": "m_002001:0xb8e8",
   "off": 47336,
   "max": 44,
   "kind": "dialogue",
   "jp": "千塵万華\\n（オルターソウル）\\nでござります",
   "en": "",
   "op": "0x62",
   "msg": "0x0444"
  },
  {
   "id": "m_002001:0xc178",
   "off": 49528,
   "max": 12,
   "kind": "dialogue",
   "jp": "千塵万華？",
   "en": "",
   "op": "0x62",
   "msg": "0x0445"
  },
  {
   "id": "m_002001:0xc600",
   "off": 50688,
   "max": 56,
   "kind": "dialogue",
   "jp": "御神祖様が\\n戦国の世を平定するおり\\n使われた秘術――",
   "en": "",
   "op": "0x62",
   "msg": "0x0446"
  },
  {
   "id": "m_002001:0xc648",
   "off": 50760,
   "max": 56,
   "kind": "dialogue",
   "jp": "その秘術に　私めが\\n独自の改良を施した術で\\nございます",
   "en": "",
   "op": "0x62",
   "msg": "0x0447"
  },
  {
   "id": "m_002001:0xc690",
   "off": 50832,
   "max": 60,
   "kind": "dialogue",
   "jp": "千塵万華を受けた者は\\n歌の才能を強制的に\\n引き出され――",
   "en": "",
   "op": "0x62",
   "msg": "0x0448"
  },
  {
   "id": "m_002001:0xcfc0",
   "off": 53184,
   "max": 52,
   "kind": "dialogue",
   "jp": "そして　得た力と\\n引き替えに\\n魂が朽ち果てるのです",
   "en": "",
   "op": "0x62",
   "msg": "0x0449"
  },
  {
   "id": "m_002001:0xd714",
   "off": 55060,
   "max": 48,
   "kind": "dialogue",
   "jp": "身体に宿した片魂ごと\\n腐り果てるというのかい",
   "en": "",
   "op": "0x62",
   "msg": "0x044a"
  },
  {
   "id": "m_002001:0xdde0",
   "off": 56800,
   "max": 8,
   "kind": "dialogue",
   "jp": "御意",
   "en": "",
   "op": "0x62",
   "msg": "0x044b"
  },
  {
   "id": "m_002001:0xe5c8",
   "off": 58824,
   "max": 60,
   "kind": "dialogue",
   "jp": "それまでの間\\nその者の呪われた歌は\\n幕府の力となりましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x044c"
  },
  {
   "id": "m_002001:0xe614",
   "off": 58900,
   "max": 40,
   "kind": "dialogue",
   "jp": "他の片魂の持ち主を\\n引き寄せるのです",
   "en": "",
   "op": "0x62",
   "msg": "0x044d"
  },
  {
   "id": "m_002001:0xeab8",
   "off": 60088,
   "max": 20,
   "kind": "dialogue",
   "jp": "そういうものなのか",
   "en": "",
   "op": "0x62",
   "msg": "0x044e"
  },
  {
   "id": "m_002001:0xeadc",
   "off": 60124,
   "max": 48,
   "kind": "dialogue",
   "jp": "あとは　この掌中へと\\n集うて来るのを待つのみ",
   "en": "",
   "op": "0x62",
   "msg": "0x044f"
  },
  {
   "id": "m_002001:0xef88",
   "off": 61320,
   "max": 12,
   "kind": "dialogue",
   "jp": "それと……",
   "en": "",
   "op": "0x62",
   "msg": "0x0450"
  },
  {
   "id": "m_002001:0xf410",
   "off": 62480,
   "max": 24,
   "kind": "dialogue",
   "jp": "まだ\\n何かあるのかい？",
   "en": "",
   "op": "0x62",
   "msg": "0x0451"
  },
  {
   "id": "m_002001:0xfd1c",
   "off": 64796,
   "max": 60,
   "kind": "dialogue",
   "jp": "正体不明の三人組が\\n街中でロックの雷舞を\\n行ったようです",
   "en": "",
   "op": "0x62",
   "msg": "0x0452"
  },
  {
   "id": "m_002001:0x1062c",
   "off": 67116,
   "max": 28,
   "kind": "dialogue",
   "jp": "本当に\\nそれはまことか！",
   "en": "",
   "op": "0x62",
   "msg": "0x0453"
  },
  {
   "id": "m_002001:0x10c8c",
   "off": 68748,
   "max": 40,
   "kind": "dialogue",
   "jp": "慶喜様\\nそのようなお顔を\\nなさいますな",
   "en": "",
   "op": "0x62",
   "msg": "0x0454"
  },
  {
   "id": "m_002001:0x111cc",
   "off": 70092,
   "max": 40,
   "kind": "dialogue",
   "jp": "ああ　ごめん\\nでもね　直弼\\n予は……",
   "en": "",
   "op": "0x62",
   "msg": "0x0455"
  },
  {
   "id": "m_002001:0x11670",
   "off": 71280,
   "max": 24,
   "kind": "dialogue",
   "jp": "それ以上は\\n仰いますな",
   "en": "",
   "op": "0x62",
   "msg": "0x0456"
  },
  {
   "id": "m_002001:0x11b04",
   "off": 72452,
   "max": 12,
   "kind": "dialogue",
   "jp": "……うん",
   "en": "",
   "op": "0x62",
   "msg": "0x0457"
  },
  {
   "id": "m_002001:0x12028",
   "off": 73768,
   "max": 20,
   "kind": "dialogue",
   "jp": "心配には及びません",
   "en": "",
   "op": "0x62",
   "msg": "0x0458"
  },
  {
   "id": "m_002001:0x124b8",
   "off": 74936,
   "max": 48,
   "kind": "dialogue",
   "jp": "その三人が仮に片魂の\\n持ち主であったとしても",
   "en": "",
   "op": "0x62",
   "msg": "0x0459"
  },
  {
   "id": "m_002001:0x12594",
   "off": 75156,
   "max": 36,
   "kind": "dialogue",
   "jp": "ひとつは我が幕府側に\\nあるのです",
   "en": "",
   "op": "0x62",
   "msg": "0x045a"
  },
  {
   "id": "m_002001:0x12a34",
   "off": 76340,
   "max": 52,
   "kind": "dialogue",
   "jp": "そうか……そうだね\\n予は心配なんて\\nしていないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x045b"
  },
  {
   "id": "m_002001:0x131f0",
   "off": 78320,
   "max": 20,
   "kind": "dialogue",
   "jp": "ただね\\n予は……",
   "en": "",
   "op": "0x62",
   "msg": "0x045c"
  },
  {
   "id": "m_002001:0x132b0",
   "off": 78512,
   "max": 20,
   "kind": "dialogue",
   "jp": "いや\\nなんでもない",
   "en": "",
   "op": "0x62",
   "msg": "0x045d"
  },
  {
   "id": "m_002001:0x13aa4",
   "off": 80548,
   "max": 52,
   "kind": "dialogue",
   "jp": "ただ　心配ないとはいえ\\n野放しにもしておけませぬ",
   "en": "",
   "op": "0x62",
   "msg": "0x045e"
  },
  {
   "id": "m_002001:0x13ff0",
   "off": 81904,
   "max": 8,
   "kind": "dialogue",
   "jp": "えっ",
   "en": "",
   "op": "0x62",
   "msg": "0x045f"
  },
  {
   "id": "m_002001:0x14474",
   "off": 83060,
   "max": 44,
   "kind": "dialogue",
   "jp": "既に　三人に追っ手を\\n差し向けております",
   "en": "",
   "op": "0x62",
   "msg": "0x0460"
  },
  {
   "id": "m_002001:0x149b8",
   "off": 84408,
   "max": 8,
   "kind": "dialogue",
   "jp": "そうか",
   "en": "",
   "op": "0x62",
   "msg": "0x0461"
  },
  {
   "id": "m_002001:0x14a6c",
   "off": 84588,
   "max": 20,
   "kind": "dialogue",
   "jp": "わかった\\n任せる",
   "en": "",
   "op": "0x62",
   "msg": "0x0462"
  },
  {
   "id": "m_002001:0x1537c",
   "off": 86908,
   "max": 24,
   "kind": "dialogue",
   "jp": "全ては\\n世の泰平のため",
   "en": "",
   "op": "0x62",
   "msg": "0x0463"
  },
  {
   "id": "m_002001:0x153b4",
   "off": 86964,
   "max": 32,
   "kind": "dialogue",
   "jp": "そして\\n我が慶喜様の御為に――",
   "en": "",
   "op": "0x62",
   "msg": "0x0464"
  },
  {
   "id": "m_002001:0x15e0c",
   "off": 89612,
   "max": 28,
   "kind": "dialogue",
   "jp": "龍ちゃーん\\n出前おねがーい",
   "en": "",
   "op": "0x62",
   "msg": "0x0465"
  },
  {
   "id": "m_002001:0x16468",
   "off": 91240,
   "max": 16,
   "kind": "dialogue",
   "jp": "はいはーい！",
   "en": "",
   "op": "0x62",
   "msg": "0x0466"
  },
  {
   "id": "m_002001:0x168f4",
   "off": 92404,
   "max": 36,
   "kind": "dialogue",
   "jp": "場所は　さっき伝えた\\nところだから",
   "en": "",
   "op": "0x62",
   "msg": "0x0467"
  },
  {
   "id": "m_002001:0x16e2c",
   "off": 93740,
   "max": 44,
   "kind": "dialogue",
   "jp": "最初の大通りを\\n右に曲がってそれから……",
   "en": "",
   "op": "0x62",
   "msg": "0x0468"
  },
  {
   "id": "m_002001:0x1779c",
   "off": 96156,
   "max": 64,
   "kind": "dialogue",
   "jp": "もたもたしないのよ\\nこないだみたいに\\n迷子なんてもってのほか！",
   "en": "",
   "op": "0x62",
   "msg": "0x0469"
  },
  {
   "id": "m_002001:0x17cb4",
   "off": 97460,
   "max": 52,
   "kind": "dialogue",
   "jp": "でないと\\n儲けはパアだからね！\\n借金減らないわよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x046a"
  },
  {
   "id": "m_002001:0x186b0",
   "off": 100016,
   "max": 60,
   "kind": "dialogue",
   "jp": "おう　わかってる！\\n場所は大丈夫じゃ\\nドーンと任せてくれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x046b"
  },
  {
   "id": "m_002001:0x18fdc",
   "off": 102364,
   "max": 28,
   "kind": "dialogue",
   "jp": "それじゃ\\nいってくるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x046c"
  },
  {
   "id": "m_002001:0x1972c",
   "off": 104236,
   "max": 12,
   "kind": "dialogue",
   "jp": "はや……",
   "en": "",
   "op": "0x62",
   "msg": "0x046d"
  },
  {
   "id": "m_002001:0x19e20",
   "off": 106016,
   "max": 48,
   "kind": "dialogue",
   "jp": "もう行っちゃった\\n龍馬くんって\\n面白い人ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x046e"
  },
  {
   "id": "m_002001:0x1a2cc",
   "off": 107212,
   "max": 36,
   "kind": "dialogue",
   "jp": "あのバカのことなんて\\nどうでもいい",
   "en": "",
   "op": "0x62",
   "msg": "0x046f"
  },
  {
   "id": "m_002001:0x1a808",
   "off": 108552,
   "max": 28,
   "kind": "dialogue",
   "jp": "そう言わないで下さい\\n晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x0470"
  },
  {
   "id": "m_002001:0x1a834",
   "off": 108596,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬くんを\\n仲間（メンバー）に\\nするんでしょう？",
   "en": "",
   "op": "0x62",
   "msg": "0x0471"
  },
  {
   "id": "m_002001:0x1b2f0",
   "off": 111344,
   "max": 40,
   "kind": "dialogue",
   "jp": "仲間？　仲間だって？\\n冗談にも程がある",
   "en": "",
   "op": "0x62",
   "msg": "0x0472"
  },
  {
   "id": "m_002001:0x1b330",
   "off": 111408,
   "max": 44,
   "kind": "dialogue",
   "jp": "あいつは\\nただ歌いたい\\nそれだけの大バカだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0473"
  },
  {
   "id": "m_002001:0x1b36c",
   "off": 111468,
   "max": 60,
   "kind": "dialogue",
   "jp": "志がないヤツを\\n志士（ロッカー）と\\n認めるわけにはいかん",
   "en": "",
   "op": "0x62",
   "msg": "0x0474"
  },
  {
   "id": "m_002001:0x1bb3c",
   "off": 113468,
   "max": 52,
   "kind": "dialogue",
   "jp": "じゃあどうして\\nこの店に入り浸って\\nいるんですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0475"
  },
  {
   "id": "m_002001:0x1c1b4",
   "off": 115124,
   "max": 12,
   "kind": "dialogue",
   "jp": "それは……",
   "en": "",
   "op": "0x62",
   "msg": "0x0476"
  },
  {
   "id": "m_002001:0x1c6d8",
   "off": 116440,
   "max": 56,
   "kind": "dialogue",
   "jp": "オレ様はただ\\n松陰先生の形見の\\nギターが心配なだけで",
   "en": "",
   "op": "0x62",
   "msg": "0x0477"
  },
  {
   "id": "m_002001:0x1cd9c",
   "off": 118172,
   "max": 12,
   "kind": "dialogue",
   "jp": "それだけ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0478"
  },
  {
   "id": "m_002001:0x1d42c",
   "off": 119852,
   "max": 28,
   "kind": "dialogue",
   "jp": "……桂さん\\n何が言いたい？",
   "en": "",
   "op": "0x62",
   "msg": "0x0479"
  },
  {
   "id": "m_002001:0x1d960",
   "off": 121184,
   "max": 36,
   "kind": "dialogue",
   "jp": "彼のロックは\\n凄かったですからね",
   "en": "",
   "op": "0x62",
   "msg": "0x047a"
  },
  {
   "id": "m_002001:0x1de9c",
   "off": 122524,
   "max": 72,
   "kind": "dialogue",
   "jp": "晋作も　龍馬くんの歌に\\n魂を揺さぶる熱情を\\n感じたんじゃないかなって\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x047b"
  },
  {
   "id": "m_002001:0x1e3fc",
   "off": 123900,
   "max": 12,
   "kind": "dialogue",
   "jp": "ふん……",
   "en": "",
   "op": "0x62",
   "msg": "0x047c"
  },
  {
   "id": "m_002001:0x1eabc",
   "off": 125628,
   "max": 48,
   "kind": "dialogue",
   "jp": "言い返さないところを\\nみると当たりでしょうか？",
   "en": "",
   "op": "0x62",
   "msg": "0x047d"
  },
  {
   "id": "m_002001:0x1f14c",
   "off": 127308,
   "max": 20,
   "kind": "dialogue",
   "jp": "当たり？\\nまさか！",
   "en": "",
   "op": "0x62",
   "msg": "0x047e"
  },
  {
   "id": "m_002001:0x1f800",
   "off": 129024,
   "max": 24,
   "kind": "dialogue",
   "jp": "でも\\n顔が赤いですよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x047f"
  },
  {
   "id": "m_002001:0x1fe2c",
   "off": 130604,
   "max": 24,
   "kind": "dialogue",
   "jp": "そ　そんなことはねぇ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0480"
  },
  {
   "id": "m_002001:0x20364",
   "off": 131940,
   "max": 24,
   "kind": "dialogue",
   "jp": "そうでしょうか\\nふふっ",
   "en": "",
   "op": "0x62",
   "msg": "0x0481"
  },
  {
   "id": "m_002001:0x20db0",
   "off": 134576,
   "max": 72,
   "kind": "dialogue",
   "jp": "まともに和音（コード）も\\n押さえられないバカ野郎の\\n何がロックなものか",
   "en": "",
   "op": "0x62",
   "msg": "0x0482"
  },
  {
   "id": "m_002001:0x2158c",
   "off": 136588,
   "max": 72,
   "kind": "dialogue",
   "jp": "演奏の上手い下手っていう\\n問題じゃないのは晋作も\\nわかってるはずです",
   "en": "",
   "op": "0x62",
   "msg": "0x0483"
  },
  {
   "id": "m_002001:0x215e4",
   "off": 136676,
   "max": 76,
   "kind": "dialogue",
   "jp": "確かに技術的な観点から\\n言えば　龍馬くんの演奏は\\n若干いただけないけれど",
   "en": "",
   "op": "0x62",
   "msg": "0x0484"
  },
  {
   "id": "m_002001:0x21c74",
   "off": 138356,
   "max": 44,
   "kind": "dialogue",
   "jp": "それみろ\\n桂さんだって\\nそう思っただろう",
   "en": "",
   "op": "0x62",
   "msg": "0x0485"
  },
  {
   "id": "m_002001:0x21cb0",
   "off": 138416,
   "max": 52,
   "kind": "dialogue",
   "jp": "技術ならオレ様の足下にも\\n及ばん　ど素人じゃねえか",
   "en": "",
   "op": "0x62",
   "msg": "0x0486"
  },
  {
   "id": "m_002001:0x221fc",
   "off": 139772,
   "max": 72,
   "kind": "dialogue",
   "jp": "……ということは\\nやっぱりそれ以外の部分は\\n認めているじゃないですか",
   "en": "",
   "op": "0x62",
   "msg": "0x0487"
  },
  {
   "id": "m_002001:0x2289c",
   "off": 141468,
   "max": 8,
   "kind": "dialogue",
   "jp": "ううっ",
   "en": "",
   "op": "0x62",
   "msg": "0x0488"
  },
  {
   "id": "m_002001:0x2320c",
   "off": 143884,
   "max": 12,
   "kind": "dialogue",
   "jp": "そうだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0489"
  },
  {
   "id": "m_002001:0x23694",
   "off": 145044,
   "max": 64,
   "kind": "dialogue",
   "jp": "龍馬くんの休憩時間に\\n私達が訓練をして\\nあげるのはどうでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x048a"
  },
  {
   "id": "m_002001:0x23d70",
   "off": 146800,
   "max": 52,
   "kind": "dialogue",
   "jp": "はあ？　オレ様はやらん\\nやるなら勝手にやってくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x048b"
  },
  {
   "id": "m_002001:0x244c4",
   "off": 148676,
   "max": 32,
   "kind": "dialogue",
   "jp": "それはできない\\n相談ですねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x048c"
  },
  {
   "id": "m_002001:0x244f4",
   "off": 148724,
   "max": 36,
   "kind": "dialogue",
   "jp": "晋作のロックを\\nより高めるために",
   "en": "",
   "op": "0x62",
   "msg": "0x048d"
  },
  {
   "id": "m_002001:0x245c4",
   "off": 148932,
   "max": 44,
   "kind": "dialogue",
   "jp": "ひいては松陰先生の\\n理想を実現するために",
   "en": "",
   "op": "0x62",
   "msg": "0x048e"
  },
  {
   "id": "m_002001:0x24600",
   "off": 148992,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬くんを仲間に\\n引き入れようって\\n話なんですから",
   "en": "",
   "op": "0x62",
   "msg": "0x048f"
  },
  {
   "id": "m_002001:0x246e0",
   "off": 149216,
   "max": 32,
   "kind": "dialogue",
   "jp": "晋作がいなくちゃ\\n意味がない",
   "en": "",
   "op": "0x62",
   "msg": "0x0490"
  },
  {
   "id": "m_002001:0x24b7c",
   "off": 150396,
   "max": 48,
   "kind": "dialogue",
   "jp": "それに私の音楽活動に\\n晋作は必要不可欠ですし",
   "en": "",
   "op": "0x62",
   "msg": "0x0491"
  },
  {
   "id": "m_002001:0x2538c",
   "off": 152460,
   "max": 28,
   "kind": "dialogue",
   "jp": "ちっ……\\nしょうがねえなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x0492"
  },
  {
   "id": "m_002001:0x258c0",
   "off": 153792,
   "max": 48,
   "kind": "dialogue",
   "jp": "野郎の墓碑が建つまで\\nロックを叩き込んでやる！",
   "en": "",
   "op": "0x62",
   "msg": "0x0493"
  },
  {
   "id": "m_002001:0x25f48",
   "off": 155464,
   "max": 40,
   "kind": "dialogue",
   "jp": "墓碑って……それ\\n死んじゃってますよね",
   "en": "",
   "op": "0x62",
   "msg": "0x0494"
  },
  {
   "id": "m_002001:0x268f8",
   "off": 157944,
   "max": 24,
   "kind": "dialogue",
   "jp": "ただいま\\n戻ったぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0495"
  },
  {
   "id": "m_002001:0x26f6c",
   "off": 159596,
   "max": 48,
   "kind": "dialogue",
   "jp": "早かったわねぇ\\nお疲れ様\\n休憩にしましょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x0496"
  },
  {
   "id": "m_002001:0x27638",
   "off": 161336,
   "max": 40,
   "kind": "dialogue",
   "jp": "ああ　龍馬くん\\nちょっといいですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0497"
  },
  {
   "id": "m_002001:0x27de4",
   "off": 163300,
   "max": 48,
   "kind": "dialogue",
   "jp": "なんじゃ\\nシンディにセンセーも\\n来ていたのか",
   "en": "",
   "op": "0x62",
   "msg": "0x0498"
  },
  {
   "id": "m_002001:0x28454",
   "off": 164948,
   "max": 48,
   "kind": "dialogue",
   "jp": "晋ちゃんも五郎ちゃんも\\nとってもいいお客なのよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0499"
  },
  {
   "id": "m_002001:0x285b0",
   "off": 165296,
   "max": 48,
   "kind": "dialogue",
   "jp": "素敵なお友達を連れてきて\\nくれて　助かるわぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x049a"
  },
  {
   "id": "m_002001:0x29080",
   "off": 168064,
   "max": 64,
   "kind": "dialogue",
   "jp": "そうかそうか\\nお登勢やんのぴっつぁは\\n本当にうまいからなあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x049b"
  },
  {
   "id": "m_002001:0x290d0",
   "off": 168144,
   "max": 56,
   "kind": "dialogue",
   "jp": "どんどん食ってくれ！\\nん？　シンディ\\nお代わりいるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x049c"
  },
  {
   "id": "m_002001:0x299e0",
   "off": 170464,
   "max": 44,
   "kind": "dialogue",
   "jp": "いいから話を聞け！\\nあとお代わりはよこせ",
   "en": "",
   "op": "0x62",
   "msg": "0x049d"
  },
  {
   "id": "m_002001:0x29f7c",
   "off": 171900,
   "max": 60,
   "kind": "dialogue",
   "jp": "おう！　お登勢やん！\\nシンディにぴっつぁの\\nお代わりじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x049e"
  },
  {
   "id": "m_002001:0x2a5e8",
   "off": 173544,
   "max": 24,
   "kind": "dialogue",
   "jp": "で　話ってなんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x049f"
  },
  {
   "id": "m_002001:0x2ad3c",
   "off": 175420,
   "max": 64,
   "kind": "dialogue",
   "jp": "龍馬くんさえ良ければ\\nこれから私達の訓練を\\n受けてみませんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x04a0"
  },
  {
   "id": "m_002001:0x2b290",
   "off": 176784,
   "max": 20,
   "kind": "dialogue",
   "jp": "訓練？\\nなんの？",
   "en": "",
   "op": "0x62",
   "msg": "0x04a1"
  },
  {
   "id": "m_002001:0x2b7bc",
   "off": 178108,
   "max": 24,
   "kind": "dialogue",
   "jp": "音楽の\\n基礎技術ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x04a2"
  },
  {
   "id": "m_002001:0x2bce8",
   "off": 179432,
   "max": 36,
   "kind": "dialogue",
   "jp": "いいのか？\\nぜひ　お願いするぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04a3"
  },
  {
   "id": "m_002001:0x2bd1c",
   "off": 179484,
   "max": 64,
   "kind": "dialogue",
   "jp": "ギターの弾き方なんぞ\\n土佐じゃ誰も教えて\\nくれなかったからなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x04a4"
  },
  {
   "id": "m_002001:0x2c400",
   "off": 181248,
   "max": 8,
   "kind": "dialogue",
   "jp": "なに？",
   "en": "",
   "op": "0x62",
   "msg": "0x04a5"
  },
  {
   "id": "m_002001:0x2c884",
   "off": 182404,
   "max": 52,
   "kind": "dialogue",
   "jp": "お前　一度も　誰にも\\n教わったことが\\nないのか",
   "en": "",
   "op": "0x62",
   "msg": "0x04a6"
  },
  {
   "id": "m_002001:0x2cdcc",
   "off": 183756,
   "max": 44,
   "kind": "dialogue",
   "jp": "前にも　そう言ったぜよ\\n独学というヤツだな",
   "en": "",
   "op": "0x62",
   "msg": "0x04a7"
  },
  {
   "id": "m_002001:0x2d458",
   "off": 185432,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x04a8"
  },
  {
   "id": "m_002001:0x2d9ec",
   "off": 186860,
   "max": 48,
   "kind": "dialogue",
   "jp": "ずうっと\\n誰かに教わりたいとは\\n思ってたんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x04a9"
  },
  {
   "id": "m_002001:0x2e1a4",
   "off": 188836,
   "max": 16,
   "kind": "dialogue",
   "jp": "決まりですね",
   "en": "",
   "op": "0x62",
   "msg": "0x04aa"
  },
  {
   "id": "m_002001:0x2e630",
   "off": 190000,
   "max": 76,
   "kind": "dialogue",
   "jp": "じゃあテラーダの仕事が\\n終わったら……いや休み\\n時間にも練習しましょう！",
   "en": "",
   "op": "0x62",
   "msg": "0x04ab"
  },
  {
   "id": "m_002001:0x2e68c",
   "off": 190092,
   "max": 40,
   "kind": "dialogue",
   "jp": "夜は私の屋敷で\\n練習すればいいですしね",
   "en": "",
   "op": "0x62",
   "msg": "0x04ac"
  },
  {
   "id": "m_002001:0x2ed4c",
   "off": 191820,
   "max": 28,
   "kind": "dialogue",
   "jp": "よろしく\\nお願いするぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04ad"
  },
  {
   "id": "m_002001:0x2f404",
   "off": 193540,
   "max": 24,
   "kind": "dialogue",
   "jp": "ちっ\\nやれやれだ……",
   "en": "",
   "op": "0x62",
   "msg": "0x04ae"
  },
  {
   "id": "m_002001:0x2fbcc",
   "off": 195532,
   "max": 76,
   "kind": "dialogue",
   "jp": "テラーダの休み時間に\\nなると三人は勢い込んで\\n近場の路地で特訓を\\n開始した",
   "en": "",
   "op": "0x62",
   "msg": "0x04af"
  },
  {
   "id": "m_002001:0x302e0",
   "off": 197344,
   "max": 20,
   "kind": "dialogue",
   "jp": "さあ　特訓じゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x04b0"
  },
  {
   "id": "m_002001:0x30944",
   "off": 198980,
   "max": 28,
   "kind": "dialogue",
   "jp": "……と\\n意気込んだものの",
   "en": "",
   "op": "0x62",
   "msg": "0x04b1"
  },
  {
   "id": "m_002001:0x30fb4",
   "off": 200628,
   "max": 52,
   "kind": "dialogue",
   "jp": "ちまちまと　弦を\\n弾くばっかりで\\n飽きてきたぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x04b2"
  },
  {
   "id": "m_002001:0x31864",
   "off": 202852,
   "max": 48,
   "kind": "dialogue",
   "jp": "上下交互弾き奏法\\n（オルタネイトピッキング）",
   "en": "",
   "op": "0x62",
   "msg": "0x04b3"
  },
  {
   "id": "m_002001:0x318a4",
   "off": 202916,
   "max": 48,
   "kind": "dialogue",
   "jp": "基礎技術がなっていない\\nバカには　重要な練習だ",
   "en": "",
   "op": "0x62",
   "msg": "0x04b4"
  },
  {
   "id": "m_002001:0x32134",
   "off": 205108,
   "max": 64,
   "kind": "dialogue",
   "jp": "こういう地味なのは\\nわしには合わんき\\nもっと派手なのを頼むぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x04b5"
  },
  {
   "id": "m_002001:0x32810",
   "off": 206864,
   "max": 60,
   "kind": "dialogue",
   "jp": "仕方ないですよ\\nここじゃ大がかりな\\nアンプも使えませんし",
   "en": "",
   "op": "0x62",
   "msg": "0x04b6"
  },
  {
   "id": "m_002001:0x328f8",
   "off": 207096,
   "max": 64,
   "kind": "dialogue",
   "jp": "それに　これができないと\\nリズムをしっかり\\n掴めませんからね",
   "en": "",
   "op": "0x62",
   "msg": "0x04b7"
  },
  {
   "id": "m_002001:0x32f60",
   "off": 208736,
   "max": 32,
   "kind": "dialogue",
   "jp": "りずむ……\\nって　なんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x04b8"
  },
  {
   "id": "m_002001:0x33a7c",
   "off": 211580,
   "max": 24,
   "kind": "dialogue",
   "jp": "てめぇ！\\nそこからか",
   "en": "",
   "op": "0x62",
   "msg": "0x04b9"
  },
  {
   "id": "m_002001:0x34418",
   "off": 214040,
   "max": 16,
   "kind": "dialogue",
   "jp": "まぁまぁ　晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x04ba"
  },
  {
   "id": "m_002001:0x34940",
   "off": 215360,
   "max": 24,
   "kind": "dialogue",
   "jp": "いいですか　龍馬くん",
   "en": "",
   "op": "0x62",
   "msg": "0x04bb"
  },
  {
   "id": "m_002001:0x34968",
   "off": 215400,
   "max": 56,
   "kind": "dialogue",
   "jp": "これができると\\n今までより演奏が\\nずっと安定するんです",
   "en": "",
   "op": "0x62",
   "msg": "0x04bc"
  },
  {
   "id": "m_002001:0x35040",
   "off": 217152,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしの演奏は\\n安定してないのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x04bd"
  },
  {
   "id": "m_002001:0x356b0",
   "off": 218800,
   "max": 56,
   "kind": "dialogue",
   "jp": "まず　運指が雑すぎる\\n一音一音ちゃんと音が\\n出ていない",
   "en": "",
   "op": "0x62",
   "msg": "0x04be"
  },
  {
   "id": "m_002001:0x35bfc",
   "off": 220156,
   "max": 24,
   "kind": "dialogue",
   "jp": "お　おう\\nそれから？",
   "en": "",
   "op": "0x62",
   "msg": "0x04bf"
  },
  {
   "id": "m_002001:0x36098",
   "off": 221336,
   "max": 52,
   "kind": "dialogue",
   "jp": "頭がモジャモジャだ\\nしかも中身が空っぽと\\nきている",
   "en": "",
   "op": "0x62",
   "msg": "0x04c0"
  },
  {
   "id": "m_002001:0x36b20",
   "off": 224032,
   "max": 48,
   "kind": "dialogue",
   "jp": "おい　シンディ！\\nそれは関係ない\\nだろうが！",
   "en": "",
   "op": "0x62",
   "msg": "0x04c1"
  },
  {
   "id": "m_002001:0x37390",
   "off": 226192,
   "max": 44,
   "kind": "dialogue",
   "jp": "オレ様は\\nシンディじゃねえ\\n高杉晋作だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04c2"
  },
  {
   "id": "m_002001:0x37d98",
   "off": 228760,
   "max": 52,
   "kind": "dialogue",
   "jp": "もう　二人とも\\nケンカはしないで\\n下さいってば！",
   "en": "",
   "op": "0x62",
   "msg": "0x04c3"
  },
  {
   "id": "m_002001:0x384f0",
   "off": 230640,
   "max": 24,
   "kind": "dialogue",
   "jp": "三人とも\\nいるかしら？",
   "en": "",
   "op": "0x62",
   "msg": "0x04c4"
  },
  {
   "id": "m_002001:0x38abc",
   "off": 232124,
   "max": 36,
   "kind": "dialogue",
   "jp": "ありゃ　お登勢やん\\n何ぞ用事か？",
   "en": "",
   "op": "0x62",
   "msg": "0x04c5"
  },
  {
   "id": "m_002001:0x38f5c",
   "off": 233308,
   "max": 36,
   "kind": "dialogue",
   "jp": "あら\\n何の用か　だなんて\\nご挨拶ね",
   "en": "",
   "op": "0x62",
   "msg": "0x04c6"
  },
  {
   "id": "m_002001:0x38f90",
   "off": 233360,
   "max": 60,
   "kind": "dialogue",
   "jp": "三人ともがんばってると\\n思って　差し入れを\\n持ってきたのよ",
   "en": "",
   "op": "0x62",
   "msg": "0x04c7"
  },
  {
   "id": "m_002001:0x39534",
   "off": 234804,
   "max": 36,
   "kind": "dialogue",
   "jp": "差し入れ\\nそりゃ　ありがたい！",
   "en": "",
   "op": "0x62",
   "msg": "0x04c8"
  },
  {
   "id": "m_002001:0x39c30",
   "off": 236592,
   "max": 28,
   "kind": "dialogue",
   "jp": "って\\nもの凄い量じゃな！",
   "en": "",
   "op": "0x62",
   "msg": "0x04c9"
  },
  {
   "id": "m_002001:0x3a2e8",
   "off": 238312,
   "max": 16,
   "kind": "dialogue",
   "jp": "特盛りですね",
   "en": "",
   "op": "0x62",
   "msg": "0x04ca"
  },
  {
   "id": "m_002001:0x3a774",
   "off": 239476,
   "max": 48,
   "kind": "dialogue",
   "jp": "これは　あんたたちを\\n応援するアタシの気持ちよ",
   "en": "",
   "op": "0x62",
   "msg": "0x04cb"
  },
  {
   "id": "m_002001:0x3ab38",
   "off": 240440,
   "max": 16,
   "kind": "choice",
   "jp": "感謝するぜよ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_002001:0x3ab54",
   "off": 240468,
   "max": 24,
   "kind": "choice",
   "jp": "こんなに食べられんぜよ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_002001:0x3ab78",
   "off": 240504,
   "max": 24,
   "kind": "choice",
   "jp": "丁度腹が減ってたんじゃ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_002001:0x3b4c4",
   "off": 242884,
   "max": 32,
   "kind": "dialogue",
   "jp": "お登勢やん\\n本当に感謝するぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x04cc"
  },
  {
   "id": "m_002001:0x3bce8",
   "off": 244968,
   "max": 28,
   "kind": "dialogue",
   "jp": "龍ちゃんの分は\\n超特盛りよ",
   "en": "",
   "op": "0x62",
   "msg": "0x04cd"
  },
  {
   "id": "m_002001:0x3c50c",
   "off": 247052,
   "max": 32,
   "kind": "dialogue",
   "jp": "龍馬くんへの愛情を\\n感じますね",
   "en": "",
   "op": "0x62",
   "msg": "0x04ce"
  },
  {
   "id": "m_002001:0x3cbc4",
   "off": 248772,
   "max": 24,
   "kind": "dialogue",
   "jp": "わしも愛してるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04cf"
  },
  {
   "id": "m_002001:0x3d0bc",
   "off": 250044,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああん　龍ちゃんったら\\n恥ずかしいわぁ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04d0"
  },
  {
   "id": "m_002001:0x3e034",
   "off": 254004,
   "max": 24,
   "kind": "dialogue",
   "jp": "こんなに食べられんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x04d1"
  },
  {
   "id": "m_002001:0x3e4c8",
   "off": 255176,
   "max": 72,
   "kind": "dialogue",
   "jp": "これからやるべきことが\\nたくさん待ってるんだから\\nこれくらい食べないと",
   "en": "",
   "op": "0x62",
   "msg": "0x04d2"
  },
  {
   "id": "m_002001:0x3ebac",
   "off": 256940,
   "max": 64,
   "kind": "dialogue",
   "jp": "お登勢さんは　女将さん\\nというより　お母さん\\nって感じですね",
   "en": "",
   "op": "0x62",
   "msg": "0x04d3"
  },
  {
   "id": "m_002001:0x3f068",
   "off": 258152,
   "max": 40,
   "kind": "dialogue",
   "jp": "あらまぁ\\nまだそんな\\n歳じゃないわよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04d4"
  },
  {
   "id": "m_002001:0x3fd38",
   "off": 261432,
   "max": 24,
   "kind": "dialogue",
   "jp": "丁度腹が減ってたんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x04d5"
  },
  {
   "id": "m_002001:0x401cc",
   "off": 262604,
   "max": 28,
   "kind": "dialogue",
   "jp": "じゃんじゃん\\n召し上がれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04d6"
  },
  {
   "id": "m_002001:0x40290",
   "off": 262800,
   "max": 32,
   "kind": "dialogue",
   "jp": "でも　お残しは\\n許さないからね",
   "en": "",
   "op": "0x62",
   "msg": "0x04d7"
  },
  {
   "id": "m_002001:0x407c4",
   "off": 264132,
   "max": 52,
   "kind": "dialogue",
   "jp": "お登勢やんの飯はうまい\\nから　その心配はないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x04d8"
  },
  {
   "id": "m_002001:0x40c74",
   "off": 265332,
   "max": 40,
   "kind": "dialogue",
   "jp": "あら\\nうれしいこと\\n言ってくれるわあ",
   "en": "",
   "op": "0x62",
   "msg": "0x04d9"
  },
  {
   "id": "m_002001:0x41428",
   "off": 267304,
   "max": 56,
   "kind": "dialogue",
   "jp": "お皿は　龍ちゃんが\\n持って帰ってきてくれれば\\nいいわね",
   "en": "",
   "op": "0x62",
   "msg": "0x04da"
  },
  {
   "id": "m_002001:0x41470",
   "off": 267376,
   "max": 60,
   "kind": "dialogue",
   "jp": "アタシは店に戻るわ\\n冷めない内に　ごゆっくり\\n召し上がれ",
   "en": "",
   "op": "0x62",
   "msg": "0x04db"
  },
  {
   "id": "m_002001:0x41c88",
   "off": 269448,
   "max": 20,
   "kind": "dialogue",
   "jp": "龍馬くん　龍馬くん",
   "en": "",
   "op": "0x62",
   "msg": "0x04dc"
  },
  {
   "id": "m_002001:0x42118",
   "off": 270616,
   "max": 68,
   "kind": "dialogue",
   "jp": "ピッツァに乗ってる\\nオリーブをあげますね\\n遠慮なく受け取って下さい",
   "en": "",
   "op": "0x62",
   "msg": "0x04dd"
  },
  {
   "id": "m_002001:0x425d8",
   "off": 271832,
   "max": 60,
   "kind": "dialogue",
   "jp": "お　おう　ありがとう\\nもしかしてセンセー\\nこれ苦手なのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x04de"
  },
  {
   "id": "m_002001:0x42b2c",
   "off": 273196,
   "max": 24,
   "kind": "dialogue",
   "jp": "そんなことないですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x04df"
  },
  {
   "id": "m_002001:0x431e8",
   "off": 274920,
   "max": 44,
   "kind": "dialogue",
   "jp": "ウソだぞ　桂さんは\\nかなりの偏食だからな",
   "en": "",
   "op": "0x62",
   "msg": "0x04e0"
  },
  {
   "id": "m_002001:0x43730",
   "off": 276272,
   "max": 36,
   "kind": "dialogue",
   "jp": "まっ　わしは好きだから\\n問題なし！",
   "en": "",
   "op": "0x62",
   "msg": "0x04e1"
  },
  {
   "id": "m_002001:0x43c68",
   "off": 277608,
   "max": 8,
   "kind": "dialogue",
   "jp": "あむっ",
   "en": "",
   "op": "0x62",
   "msg": "0x04e2"
  },
  {
   "id": "m_002001:0x446c4",
   "off": 280260,
   "max": 40,
   "kind": "dialogue",
   "jp": "うまいぜよっ！\\nお登勢やんは最高じゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x04e3"
  },
  {
   "id": "m_002001:0x44fcc",
   "off": 282572,
   "max": 48,
   "kind": "dialogue",
   "jp": "ちっ\\nこんなメシくらいで\\n飼い慣らされやがって",
   "en": "",
   "op": "0x62",
   "msg": "0x04e4"
  },
  {
   "id": "m_002001:0x45510",
   "off": 283920,
   "max": 20,
   "kind": "dialogue",
   "jp": "む\\nうまくないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x04e5"
  },
  {
   "id": "m_002001:0x45a3c",
   "off": 285244,
   "max": 52,
   "kind": "dialogue",
   "jp": "いや　確かにうまいが\\nもっとうまくする方法が\\nある",
   "en": "",
   "op": "0x62",
   "msg": "0x04e6"
  },
  {
   "id": "m_002001:0x45a80",
   "off": 285312,
   "max": 24,
   "kind": "dialogue",
   "jp": "桂さん　唐辛子をくれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04e7"
  },
  {
   "id": "m_002001:0x461d4",
   "off": 287188,
   "max": 12,
   "kind": "dialogue",
   "jp": "はい　はい",
   "en": "",
   "op": "0x62",
   "msg": "0x04e8"
  },
  {
   "id": "m_002001:0x4687c",
   "off": 288892,
   "max": 44,
   "kind": "dialogue",
   "jp": "こいつをな　こうして\\n料理に振りかけるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x04e9"
  },
  {
   "id": "m_002001:0x470ec",
   "off": 291052,
   "max": 44,
   "kind": "dialogue",
   "jp": "うおお　シンディの\\n料理が真っ赤っかじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04ea"
  },
  {
   "id": "m_002001:0x47bec",
   "off": 293868,
   "max": 28,
   "kind": "dialogue",
   "jp": "辛い！\\nそして　うまい！",
   "en": "",
   "op": "0x62",
   "msg": "0x04eb"
  },
  {
   "id": "m_002001:0x484ec",
   "off": 296172,
   "max": 40,
   "kind": "dialogue",
   "jp": "晋作は　ほんと\\n辛い物が好きですねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x04ec"
  },
  {
   "id": "m_002001:0x48a34",
   "off": 297524,
   "max": 52,
   "kind": "dialogue",
   "jp": "辛いを通り越して\\nもはや熱い！\\n熱いのがロックだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04ed"
  },
  {
   "id": "m_002001:0x4919c",
   "off": 299420,
   "max": 68,
   "kind": "dialogue",
   "jp": "覚えておけ　龍馬\\n志士ってのは　食い物も\\nロックじゃなきゃいけねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x04ee"
  },
  {
   "id": "m_002001:0x496b0",
   "off": 300720,
   "max": 32,
   "kind": "dialogue",
   "jp": "おおぉ\\nさすがシンディじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x04ef"
  }
 ]
}
