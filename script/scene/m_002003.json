{
 "source": "m_002003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_002003:0x12f8",
   "off": 4856,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしらのロックを聴いて\\n顔色もよくなったようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x0650"
  },
  {
   "id": "m_002003:0x19c4",
   "off": 6596,
   "max": 56,
   "kind": "dialogue",
   "jp": "お　おおお……\\nこの頬を伝わる熱いものは\\nなんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0651"
  },
  {
   "id": "m_002003:0x2040",
   "off": 8256,
   "max": 56,
   "kind": "dialogue",
   "jp": "涙だよ\\nお前\\n自分が泣いているのに\\n気付かないのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0652"
  },
  {
   "id": "m_002003:0x27fc",
   "off": 10236,
   "max": 16,
   "kind": "dialogue",
   "jp": "涙……涙だと？",
   "en": "",
   "op": "0x62",
   "msg": "0x0653"
  },
  {
   "id": "m_002003:0x2c88",
   "off": 11400,
   "max": 48,
   "kind": "dialogue",
   "jp": "……思えば　こうして\\n涙を流すのは久しぶりだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0654"
  },
  {
   "id": "m_002003:0x2cc8",
   "off": 11464,
   "max": 44,
   "kind": "dialogue",
   "jp": "最初は天歌を聴くこと\\nそれが喜びだった……",
   "en": "",
   "op": "0x62",
   "msg": "0x0655"
  },
  {
   "id": "m_002003:0x3374",
   "off": 13172,
   "max": 20,
   "kind": "dialogue",
   "jp": "だが　いつからだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0656"
  },
  {
   "id": "m_002003:0x3804",
   "off": 14340,
   "max": 60,
   "kind": "dialogue",
   "jp": "いつしか　天歌さえあれば\\nそれでいいと思うように\\nなった",
   "en": "",
   "op": "0x62",
   "msg": "0x0657"
  },
  {
   "id": "m_002003:0x3850",
   "off": 14416,
   "max": 48,
   "kind": "dialogue",
   "jp": "嬉しさも悲しさも　全てを\\n忘れ去っていた……",
   "en": "",
   "op": "0x62",
   "msg": "0x0658"
  },
  {
   "id": "m_002003:0x3890",
   "off": 14480,
   "max": 72,
   "kind": "dialogue",
   "jp": "天歌が与えてくれる安らぎ\\nそれが天歌泰平の道と\\n信じ込んでいたが――",
   "en": "",
   "op": "0x62",
   "msg": "0x0659"
  },
  {
   "id": "m_002003:0x4148",
   "off": 16712,
   "max": 32,
   "kind": "dialogue",
   "jp": "そんな泰平は\\n嘘っぱちぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x065a"
  },
  {
   "id": "m_002003:0x45e4",
   "off": 17892,
   "max": 52,
   "kind": "dialogue",
   "jp": "人は泣くんじゃ！\\n感激すれば\\n心が揺さぶられれば！",
   "en": "",
   "op": "0x62",
   "msg": "0x065b"
  },
  {
   "id": "m_002003:0x46c0",
   "off": 18112,
   "max": 36,
   "kind": "dialogue",
   "jp": "涙を流すのが\\n人っちゅうもんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x065c"
  },
  {
   "id": "m_002003:0x4b60",
   "off": 19296,
   "max": 52,
   "kind": "dialogue",
   "jp": "そうだ\\nお前の言うとおりだ\\n今は　それがわかる！",
   "en": "",
   "op": "0x62",
   "msg": "0x065d"
  },
  {
   "id": "m_002003:0x4ba4",
   "off": 19364,
   "max": 64,
   "kind": "dialogue",
   "jp": "私は　どうして　そんな\\n大切なことを　忘れて\\nしまっていたのか",
   "en": "",
   "op": "0x62",
   "msg": "0x065e"
  },
  {
   "id": "m_002003:0x5288",
   "off": 21128,
   "max": 32,
   "kind": "dialogue",
   "jp": "泰平化されていた\\nせいですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x065f"
  },
  {
   "id": "m_002003:0x5724",
   "off": 22308,
   "max": 8,
   "kind": "dialogue",
   "jp": "なに？",
   "en": "",
   "op": "0x62",
   "msg": "0x0660"
  },
  {
   "id": "m_002003:0x5c44",
   "off": 23620,
   "max": 60,
   "kind": "dialogue",
   "jp": "今　あなたに涙を\\n流させている衝動こそ\\n人が本来持つ魂の力",
   "en": "",
   "op": "0x62",
   "msg": "0x0661"
  },
  {
   "id": "m_002003:0x5d2c",
   "off": 23852,
   "max": 64,
   "kind": "dialogue",
   "jp": "ロックによって泰平化が\\n解かれたんです\\n魂が解放された証ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0662"
  },
  {
   "id": "m_002003:0x64f0",
   "off": 25840,
   "max": 48,
   "kind": "dialogue",
   "jp": "確かに！\\n胸の奥に沸き上がる\\nこの衝動……！",
   "en": "",
   "op": "0x62",
   "msg": "0x0663"
  },
  {
   "id": "m_002003:0x699c",
   "off": 27036,
   "max": 36,
   "kind": "dialogue",
   "jp": "この……この……\\nこの熱い想いは",
   "en": "",
   "op": "0x62",
   "msg": "0x0664"
  },
  {
   "id": "m_002003:0x71a4",
   "off": 29092,
   "max": 24,
   "kind": "dialogue",
   "jp": "これが青春なのかーー",
   "en": "",
   "op": "0x62",
   "msg": "0x0665"
  },
  {
   "id": "m_002003:0x7ac4",
   "off": 31428,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうじゃ\\nこれが青春じゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x0666"
  },
  {
   "id": "m_002003:0x8178",
   "off": 33144,
   "max": 40,
   "kind": "dialogue",
   "jp": "うおおおおお\\nこの熱い想いを止められん",
   "en": "",
   "op": "0x62",
   "msg": "0x0667"
  },
  {
   "id": "m_002003:0x81b0",
   "off": 33200,
   "max": 36,
   "kind": "dialogue",
   "jp": "これが……\\nこれがロックの力か",
   "en": "",
   "op": "0x62",
   "msg": "0x0668"
  },
  {
   "id": "m_002003:0x8a30",
   "off": 35376,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしらのロックが\\n気に入ったようだな\\nもう一曲いくか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0669"
  },
  {
   "id": "m_002003:0x9098",
   "off": 37016,
   "max": 68,
   "kind": "dialogue",
   "jp": "ま　待て　待ってくれ！\\nお前達のロックは本物だ\\nそれはわかった！",
   "en": "",
   "op": "0x62",
   "msg": "0x066a"
  },
  {
   "id": "m_002003:0x90ec",
   "off": 37100,
   "max": 48,
   "kind": "dialogue",
   "jp": "だが\\n私が今まで教えられ\\n信じ込んできたもの",
   "en": "",
   "op": "0x62",
   "msg": "0x066b"
  },
  {
   "id": "m_002003:0x912c",
   "off": 37164,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや　私自身について\\nもう一度考え直したい……",
   "en": "",
   "op": "0x62",
   "msg": "0x066c"
  },
  {
   "id": "m_002003:0x916c",
   "off": 37228,
   "max": 68,
   "kind": "dialogue",
   "jp": "そうしてから　もう一度\\nお前らのロックとやらを\\n聴かせてもらえぬか",
   "en": "",
   "op": "0x62",
   "msg": "0x066d"
  },
  {
   "id": "m_002003:0x9854",
   "off": 38996,
   "max": 24,
   "kind": "dialogue",
   "jp": "ちっ\\n頭の固いヤロウだ",
   "en": "",
   "op": "0x62",
   "msg": "0x066e"
  },
  {
   "id": "m_002003:0x9d84",
   "off": 40324,
   "max": 72,
   "kind": "dialogue",
   "jp": "だが　屋敷に押し入って\\n来た時よりは　ずいぶんと\\nマシなツラになった",
   "en": "",
   "op": "0x62",
   "msg": "0x066f"
  },
  {
   "id": "m_002003:0xa564",
   "off": 42340,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしらの雷舞\\n絶対に観に来いよ！\\nいつでも大歓迎じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0670"
  },
  {
   "id": "m_002003:0xac34",
   "off": 44084,
   "max": 24,
   "kind": "dialogue",
   "jp": "かたじけない\\nさらば！",
   "en": "",
   "op": "0x62",
   "msg": "0x0671"
  },
  {
   "id": "m_002003:0xb2f0",
   "off": 45808,
   "max": 32,
   "kind": "dialogue",
   "jp": "桂さんも　龍馬も\\n甘すぎるぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x0672"
  },
  {
   "id": "m_002003:0xb78c",
   "off": 46988,
   "max": 44,
   "kind": "dialogue",
   "jp": "あいつが自分とやらに\\nついて考え直した結果",
   "en": "",
   "op": "0x62",
   "msg": "0x0673"
  },
  {
   "id": "m_002003:0xb864",
   "off": 47204,
   "max": 64,
   "kind": "dialogue",
   "jp": "やはりロックは危険だ\\n幕府の総力を挙げて\\n叩きつぶさなければ",
   "en": "",
   "op": "0x62",
   "msg": "0x0674"
  },
  {
   "id": "m_002003:0xbdbc",
   "off": 48572,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんてことに\\nならなきゃいいが",
   "en": "",
   "op": "0x62",
   "msg": "0x0675"
  },
  {
   "id": "m_002003:0xc424",
   "off": 50212,
   "max": 72,
   "kind": "dialogue",
   "jp": "その時は　押し寄せた\\n武士達にも　わしらの\\nロックを聴かせてやるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0676"
  },
  {
   "id": "m_002003:0xc8e8",
   "off": 51432,
   "max": 20,
   "kind": "dialogue",
   "jp": "違うか？\\nシンディ",
   "en": "",
   "op": "0x62",
   "msg": "0x0677"
  },
  {
   "id": "m_002003:0xce14",
   "off": 52756,
   "max": 12,
   "kind": "dialogue",
   "jp": "まあな……",
   "en": "",
   "op": "0x62",
   "msg": "0x0678"
  },
  {
   "id": "m_002003:0xd5a8",
   "off": 54696,
   "max": 72,
   "kind": "dialogue",
   "jp": "しかし幕府に忠心を誓った\\n武士の泰平化が解ける\\nとは思いませんでした",
   "en": "",
   "op": "0x62",
   "msg": "0x0679"
  },
  {
   "id": "m_002003:0xd69c",
   "off": 54940,
   "max": 48,
   "kind": "dialogue",
   "jp": "これが\\n松陰先生が求めていた\\nロックの力……",
   "en": "",
   "op": "0x62",
   "msg": "0x067a"
  },
  {
   "id": "m_002003:0xdfe0",
   "off": 57312,
   "max": 24,
   "kind": "dialogue",
   "jp": "ロックは\\n偉大ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x067b"
  },
  {
   "id": "m_002003:0xe7e4",
   "off": 59364,
   "max": 68,
   "kind": "dialogue",
   "jp": "そうか　この力こそが\\n松陰先生がロックを求めた\\n理由だったんです！",
   "en": "",
   "op": "0x62",
   "msg": "0x067c"
  },
  {
   "id": "m_002003:0xee74",
   "off": 61044,
   "max": 16,
   "kind": "dialogue",
   "jp": "ロックの力？",
   "en": "",
   "op": "0x62",
   "msg": "0x067d"
  },
  {
   "id": "m_002003:0xf778",
   "off": 63352,
   "max": 64,
   "kind": "dialogue",
   "jp": "ロックを聴いた者は　\\n魂の束縛から　解き放たれ\\n真の自由を得る",
   "en": "",
   "op": "0x62",
   "msg": "0x067e"
  },
  {
   "id": "m_002003:0xf864",
   "off": 63588,
   "max": 72,
   "kind": "dialogue",
   "jp": "ロックには　泰平化を\\n解く力があるからこそ\\n松陰先生はロックを教えた",
   "en": "",
   "op": "0x62",
   "msg": "0x067f"
  },
  {
   "id": "m_002003:0x10114",
   "off": 65812,
   "max": 12,
   "kind": "dialogue",
   "jp": "ええっ",
   "en": "",
   "op": "0x62",
   "msg": "0x0680"
  },
  {
   "id": "m_002003:0x108c0",
   "off": 67776,
   "max": 44,
   "kind": "dialogue",
   "jp": "先ほどの幕府の侍が\\n何よりの証拠ですよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0681"
  },
  {
   "id": "m_002003:0x10f34",
   "off": 69428,
   "max": 72,
   "kind": "dialogue",
   "jp": "つまり　わしらが歌うと\\nみんなのココロが自由に\\nなるっていうことか",
   "en": "",
   "op": "0x62",
   "msg": "0x0682"
  },
  {
   "id": "m_002003:0x11024",
   "off": 69668,
   "max": 52,
   "kind": "dialogue",
   "jp": "強制された考え方を\\n自由にすることが\\nできるのか",
   "en": "",
   "op": "0x62",
   "msg": "0x0683"
  },
  {
   "id": "m_002003:0x11570",
   "off": 71024,
   "max": 64,
   "kind": "dialogue",
   "jp": "そうです　龍馬くん！\\nその通りです！\\nこれはすごいことですよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0684"
  },
  {
   "id": "m_002003:0x11cec",
   "off": 72940,
   "max": 64,
   "kind": "dialogue",
   "jp": "さすが松陰先生だぜ！\\nこれが先生のやろうと\\nしていたこと……",
   "en": "",
   "op": "0x62",
   "msg": "0x0685"
  },
  {
   "id": "m_002003:0x121b0",
   "off": 74160,
   "max": 24,
   "kind": "dialogue",
   "jp": "デカイぜ\\n松陰先生",
   "en": "",
   "op": "0x62",
   "msg": "0x0686"
  },
  {
   "id": "m_002003:0x12c30",
   "off": 76848,
   "max": 68,
   "kind": "dialogue",
   "jp": "センセー！　シンディ！\\nわしと一緒に　もっと\\nセッションするぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0687"
  },
  {
   "id": "m_002003:0x12c8c",
   "off": 76940,
   "max": 76,
   "kind": "dialogue",
   "jp": "もっともっとうまくなって\\nみ～んなに　わしらの\\nロックを聴かせてやろう！",
   "en": "",
   "op": "0x62",
   "msg": "0x0688"
  },
  {
   "id": "m_002003:0x13630",
   "off": 79408,
   "max": 12,
   "kind": "dialogue",
   "jp": "賛成です！",
   "en": "",
   "op": "0x62",
   "msg": "0x0689"
  },
  {
   "id": "m_002003:0x13654",
   "off": 79444,
   "max": 24,
   "kind": "dialogue",
   "jp": "晋作も\\nいいですね？",
   "en": "",
   "op": "0x62",
   "msg": "0x068a"
  },
  {
   "id": "m_002003:0x13d08",
   "off": 81160,
   "max": 20,
   "kind": "dialogue",
   "jp": "ちっ\\nしょうがねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x068b"
  },
  {
   "id": "m_002003:0x13dc8",
   "off": 81352,
   "max": 68,
   "kind": "dialogue",
   "jp": "このド下手クソと一緒に\\nやるなら練習を積まなきゃ\\nどうにもならん",
   "en": "",
   "op": "0x62",
   "msg": "0x068c"
  },
  {
   "id": "m_002003:0x14528",
   "off": 83240,
   "max": 56,
   "kind": "dialogue",
   "jp": "シンディは厳しいのう\\nもっと優しくしてほしい\\nぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x068d"
  },
  {
   "id": "m_002003:0x14ba4",
   "off": 84900,
   "max": 20,
   "kind": "dialogue",
   "jp": "では\\n決まりですね",
   "en": "",
   "op": "0x62",
   "msg": "0x068e"
  },
  {
   "id": "m_002003:0x15254",
   "off": 86612,
   "max": 12,
   "kind": "dialogue",
   "jp": "何がだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x068f"
  },
  {
   "id": "m_002003:0x156dc",
   "off": 87772,
   "max": 52,
   "kind": "dialogue",
   "jp": "今　この時から\\n私達は志を同じくする\\n仲間です\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0690"
  },
  {
   "id": "m_002003:0x15ee8",
   "off": 89832,
   "max": 28,
   "kind": "dialogue",
   "jp": "仲間か！\\nいい響きじゃな",
   "en": "",
   "op": "0x62",
   "msg": "0x0691"
  },
  {
   "id": "m_002003:0x15f1c",
   "off": 89884,
   "max": 32,
   "kind": "dialogue",
   "jp": "これからも\\nよろしく頼むぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0692"
  },
  {
   "id": "m_002003:0x163cc",
   "off": 91084,
   "max": 24,
   "kind": "dialogue",
   "jp": "手を重ね合う龍馬たち",
   "en": "",
   "op": "0x62",
   "msg": "0x0693"
  },
  {
   "id": "m_002003:0x163f4",
   "off": 91124,
   "max": 64,
   "kind": "dialogue",
   "jp": "三人は　お互い強い\\n結びつきを感じずには\\nいられないのであった",
   "en": "",
   "op": "0x62",
   "msg": "0x0694"
  }
 ]
}
