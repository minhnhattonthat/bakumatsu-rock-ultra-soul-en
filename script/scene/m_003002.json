   "id": "m_003002:0x37c74",
   "off": 228468,
   "max": 48,
   "kind": "dialogue",
   "jp": "ゴミはさぁ　ゴミらしく\\n丸めてポイしちゃってよ",
   "en": "",
   "op": "0x62",
   "msg": "0x08bd"
  },
  {
