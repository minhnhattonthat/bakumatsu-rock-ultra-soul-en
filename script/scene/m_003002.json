   "en": "",
   "op": "0x62",
   "msg": "0x08ac"
  },
  {
   "id": "m_003002:0x30ef0",
   "off": 200432,
   "max": 64,
   "kind": "dialogue",
   "jp": "ったく　あのバカは\\nこれっぽっちも\\n後先のことを考えてねえ！",
