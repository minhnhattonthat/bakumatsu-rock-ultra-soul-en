   "id": "m_003002:0x45b2c",
   "off": 285484,
   "max": 68,
   "kind": "dialogue",
   "jp": "よぉぉぉぉしゃああ！\\n燃えてきた燃えてきた\\n燃えてきたぜよぉぉぉ",
