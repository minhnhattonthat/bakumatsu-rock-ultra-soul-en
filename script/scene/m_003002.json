   "id": "m_003002:0x47144",
   "off": 291140,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍馬に呼ばれた二人は\\n雷舞舞台に駆け上がった",
   "en": "",
   "op": "0x62",
   "msg": "0x08e9"
  },
  {
   "id": "m_003002:0x47184",
   "off": 291204,
   "max": 24,
   "kind": "dialogue",
   "jp": "高杉はベースを構えた",
   "en": "",
   "op": "0x62",
   "msg": "0x08ea"
  },
