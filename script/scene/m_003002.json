   "max": 44,
   "kind": "dialogue",
   "jp": "嗚呼……！\\nわしの中で\\n何かが迸る……",
   "en": "",
   "op": "0x62",
   "msg": "0x08ef"
  },
  {
   "id": "m_003002:0x49820",
   "off": 301088,
