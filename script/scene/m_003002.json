   "op": "0x62",
   "msg": "0x08b7"
  },
  {
   "id": "m_003002:0x35ec4",
   "off": 220868,
   "max": 68,
   "kind": "dialogue",
   "jp": "……と言いつつ\\n先頭切って走っているのは\\nどこのどなたでしょう？",
