   "op": "0x62",
   "msg": "0x08b8"
  },
  {
   "id": "m_003002:0x365a4",
   "off": 222628,
   "max": 40,
   "kind": "dialogue",
   "jp": "うるせえ！\\nつべこべ言わずに\\n走るぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x08b9"
  },
  {
   "id": "m_003002:0x36d74",
   "off": 224628,
   "max": 76,
   "kind": "dialogue",
   "jp": "龍馬を追って\\n最前列まで移動してた\\n高杉と桂は龍馬の元へと\\n向かおうとする",
