   "id": "m_003002:0x36dd0",
   "off": 224720,
   "max": 48,
   "kind": "dialogue",
   "jp": "だがその横を\\n大きな人影が\\n器用にすり抜けた",
   "en": "",
   "op": "0x62",
   "msg": "0x08bb"
  },
  {
   "id": "m_003002:0x374bc",
   "off": 226492,
   "max": 36,
   "kind": "dialogue",
   "jp": "ぬおおおお　離せ！\\n離せ～～っ！",
