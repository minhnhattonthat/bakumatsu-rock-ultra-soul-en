{
 "source": "m_003002.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_003002:0x12c0",
   "off": 4800,
   "max": 56,
   "kind": "dialogue",
   "jp": "龍馬達が騒がしく\\n練習をしていた頃\\n京の嵐山では……",
   "en": "",
   "op": "0x62",
   "msg": "0x0819"
  },
  {
   "id": "m_003002:0x194c",
   "off": 6476,
   "max": 64,
   "kind": "dialogue",
   "jp": "おやおや　今日も満員だ\\nみんな　他にすることが\\nないんだね～",
   "en": "",
   "op": "0x62",
   "msg": "0x081a"
  },
  {
   "id": "m_003002:0x199c",
   "off": 6556,
   "max": 40,
   "kind": "dialogue",
   "jp": "ホント\\nうるさいなぁ……\\n耳障りな声だ",
   "en": "",
   "op": "0x62",
   "msg": "0x081b"
  },
  {
   "id": "m_003002:0x19d4",
   "off": 6612,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふん……\\n見渡す限りのクズって\\nところかな",
   "en": "",
   "op": "0x62",
   "msg": "0x081c"
  },
  {
   "id": "m_003002:0x1a10",
   "off": 6672,
   "max": 68,
   "kind": "dialogue",
   "jp": "クズがさえずるための\\n口なんて削いでしまった\\n方がいいと思うけど",
   "en": "",
   "op": "0x62",
   "msg": "0x081d"
  },
  {
   "id": "m_003002:0x23fc",
   "off": 9212,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x081e"
  },
  {
   "id": "m_003002:0x2c68",
   "off": 11368,
   "max": 16,
   "kind": "dialogue",
   "jp": "あ　土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x081f"
  },
  {
   "id": "m_003002:0x2c88",
   "off": 11400,
   "max": 48,
   "kind": "dialogue",
   "jp": "楽屋で休んでると\\n思ったのに\\nどうしたんです？",
   "en": "",
   "op": "0x62",
   "msg": "0x0820"
  },
  {
   "id": "m_003002:0x3134",
   "off": 12596,
   "max": 24,
   "kind": "dialogue",
   "jp": "お前こそ\\n何をしている",
   "en": "",
   "op": "0x62",
   "msg": "0x0821"
  },
  {
   "id": "m_003002:0x35c8",
   "off": 13768,
   "max": 52,
   "kind": "dialogue",
   "jp": "煌（ファン）の\\n興奮を　少しでも\\n肌で感じたくて？",
   "en": "",
   "op": "0x62",
   "msg": "0x0822"
  },
  {
   "id": "m_003002:0x360c",
   "off": 13836,
   "max": 24,
   "kind": "dialogue",
   "jp": "なーんてね\\nふふ……",
   "en": "",
   "op": "0x62",
   "msg": "0x0823"
  },
  {
   "id": "m_003002:0x3aa0",
   "off": 15008,
   "max": 24,
   "kind": "dialogue",
   "jp": "お前はあいかわらずだな",
   "en": "",
   "op": "0x62",
   "msg": "0x0824"
  },
  {
   "id": "m_003002:0x3f34",
   "off": 16180,
   "max": 12,
   "kind": "dialogue",
   "jp": "うふふ……",
   "en": "",
   "op": "0x62",
   "msg": "0x0825"
  },
  {
   "id": "m_003002:0x4834",
   "off": 18484,
   "max": 48,
   "kind": "dialogue",
   "jp": "ここで何を言っても許す\\nだが雷舞は真剣にやれ",
   "en": "",
   "op": "0x62",
   "msg": "0x0826"
  },
  {
   "id": "m_003002:0x4874",
   "off": 18548,
   "max": 36,
   "kind": "dialogue",
   "jp": "新選組の恥は\\n近藤さんの恥となる",
   "en": "",
   "op": "0x62",
   "msg": "0x0827"
  },
  {
   "id": "m_003002:0x4fb4",
   "off": 20404,
   "max": 24,
   "kind": "dialogue",
   "jp": "もちろんわかってますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0828"
  },
  {
   "id": "m_003002:0x4fdc",
   "off": 20444,
   "max": 48,
   "kind": "dialogue",
   "jp": "僕が舞台の上で醜態を\\n晒すわけがないでしょ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0829"
  },
  {
   "id": "m_003002:0x501c",
   "off": 20508,
   "max": 56,
   "kind": "dialogue",
   "jp": "それ以上に\\n近藤さんや土方さんに\\n恥をかかせるなんて",
   "en": "",
   "op": "0x62",
   "msg": "0x082a"
  },
  {
   "id": "m_003002:0x56d4",
   "off": 22228,
   "max": 20,
   "kind": "dialogue",
   "jp": "ありえないですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x082b"
  },
  {
   "id": "m_003002:0x5f48",
   "off": 24392,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああ　そうだな\\nお前のことは信用している",
   "en": "",
   "op": "0x62",
   "msg": "0x082c"
  },
  {
   "id": "m_003002:0x6488",
   "off": 25736,
   "max": 8,
   "kind": "dialogue",
   "jp": "はい",
   "en": "",
   "op": "0x62",
   "msg": "0x082d"
  },
  {
   "id": "m_003002:0x690c",
   "off": 26892,
   "max": 44,
   "kind": "dialogue",
   "jp": "この分だと　今日も\\n客の入りは良いようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x082e"
  },
  {
   "id": "m_003002:0x6954",
   "off": 26964,
   "max": 40,
   "kind": "dialogue",
   "jp": "この泰平の世を守れるのは\\n徳川幕府のみ",
   "en": "",
   "op": "0x62",
   "msg": "0x082f"
  },
  {
   "id": "m_003002:0x7104",
   "off": 28932,
   "max": 56,
   "kind": "dialogue",
   "jp": "俺達の歌で\\n幕府への忠義の心を\\n奴らに　叩き込んでやれ",
   "en": "",
   "op": "0x62",
   "msg": "0x0830"
  },
  {
   "id": "m_003002:0x77d4",
   "off": 30676,
   "max": 20,
   "kind": "dialogue",
   "jp": "はい\\nもちろんです",
   "en": "",
   "op": "0x62",
   "msg": "0x0831"
  },
  {
   "id": "m_003002:0x7ee0",
   "off": 32480,
   "max": 72,
   "kind": "dialogue",
   "jp": "俺達の天歌は　幕府の……\\n近藤さんの夢を叶える\\nためにあるのだからな\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0832"
  },
  {
   "id": "m_003002:0x83a4",
   "off": 33700,
   "max": 40,
   "kind": "dialogue",
   "jp": "ええ　土方さん\\n今日も頑張りましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x0833"
  },
  {
   "id": "m_003002:0x8848",
   "off": 34888,
   "max": 8,
   "kind": "dialogue",
   "jp": "ああ",
   "en": "",
   "op": "0x62",
   "msg": "0x0834"
  },
  {
   "id": "m_003002:0x9008",
   "off": 36872,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方さんと近藤さんが\\n望むものが\\n泰平の世　ならば……",
   "en": "",
   "op": "0x62",
   "msg": "0x0835"
  },
  {
   "id": "m_003002:0x9050",
   "off": 36944,
   "max": 56,
   "kind": "dialogue",
   "jp": "どんなことをしても\\nそれをこの世に実現して\\nみせるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0836"
  },
  {
   "id": "m_003002:0x9708",
   "off": 38664,
   "max": 24,
   "kind": "dialogue",
   "jp": "それが僕の生きている証",
   "en": "",
   "op": "0x62",
   "msg": "0x0837"
  },
  {
   "id": "m_003002:0x9744",
   "off": 38724,
   "max": 52,
   "kind": "dialogue",
   "jp": "くだらない\\n生き物を相手に\\nすることだとしてもね",
   "en": "",
   "op": "0x62",
   "msg": "0x0838"
  },
  {
   "id": "m_003002:0xa35c",
   "off": 41820,
   "max": 24,
   "kind": "dialogue",
   "jp": "すごい歓声ぜよ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x0839"
  },
  {
   "id": "m_003002:0xa9b8",
   "off": 43448,
   "max": 36,
   "kind": "dialogue",
   "jp": "ちっ　こんなのに\\n呑まれんな　バカ",
   "en": "",
   "op": "0x62",
   "msg": "0x083a"
  },
  {
   "id": "m_003002:0xb078",
   "off": 45176,
   "max": 56,
   "kind": "dialogue",
   "jp": "予想外ですね\\n女の子だけではなくて\\n男性客も多いですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x083b"
  },
  {
   "id": "m_003002:0xbdbc",
   "off": 48572,
   "max": 32,
   "kind": "dialogue",
   "jp": "きゃーーっ！\\n土方様ーーーっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x083c"
  },
  {
   "id": "m_003002:0xc258",
   "off": 49752,
   "max": 44,
   "kind": "dialogue",
   "jp": "おおおおおーーー！\\n総司くぅぅぅーーん！\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x083d"
  },
  {
   "id": "m_003002:0xc998",
   "off": 51608,
   "max": 40,
   "kind": "dialogue",
   "jp": "会場は老若男女で\\n埋め尽くされていた",
   "en": "",
   "op": "0x62",
   "msg": "0x083e"
  },
  {
   "id": "m_003002:0xcfb8",
   "off": 53176,
   "max": 72,
   "kind": "dialogue",
   "jp": "各世代に支持されていると\\nいう話は　眉唾かと思って\\nいましたけれど……",
   "en": "",
   "op": "0x62",
   "msg": "0x083f"
  },
  {
   "id": "m_003002:0xd010",
   "off": 53264,
   "max": 40,
   "kind": "dialogue",
   "jp": "予想に反して\\n噂は事実だったようですね",
   "en": "",
   "op": "0x62",
   "msg": "0x0840"
  },
  {
   "id": "m_003002:0xd4b4",
   "off": 54452,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ちっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0841"
  },
  {
   "id": "m_003002:0xdc44",
   "off": 56388,
   "max": 48,
   "kind": "dialogue",
   "jp": "おおー！\\n歓声にも　熱気が\\nこもってるなぁ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0842"
  },
  {
   "id": "m_003002:0xdc84",
   "off": 56452,
   "max": 24,
   "kind": "dialogue",
   "jp": "うう～～\\n楽しみぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0843"
  },
  {
   "id": "m_003002:0xdcac",
   "off": 56492,
   "max": 76,
   "kind": "dialogue",
   "jp": "これだけの人間を虜にする\\n新選組の歌には　熱い魂が\\nあるに　違いないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0844"
  },
  {
   "id": "m_003002:0xe33c",
   "off": 58172,
   "max": 40,
   "kind": "dialogue",
   "jp": "……だといいがな\\nいや　よくはねえが",
   "en": "",
   "op": "0x62",
   "msg": "0x0845"
  },
  {
   "id": "m_003002:0xea00",
   "off": 59904,
   "max": 36,
   "kind": "dialogue",
   "jp": "それを　これから\\n確かめるんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0846"
  },
  {
   "id": "m_003002:0xf018",
   "off": 61464,
   "max": 28,
   "kind": "dialogue",
   "jp": "おお！\\n始まるぜよ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x0847"
  },
  {
   "id": "m_003002:0xf4c4",
   "off": 62660,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬が期待に胸膨らます中\\n新選組の雷舞は幕を開けた",
   "en": "",
   "op": "0x62",
   "msg": "0x0848"
  },
  {
   "id": "m_003002:0xf508",
   "off": 62728,
   "max": 68,
   "kind": "dialogue",
   "jp": "煙幕がかかる中\\n舞台の上に新選組の\\n隊士らしき人影が\\n走り出て行く",
   "en": "",
   "op": "0x62",
   "msg": "0x0849"
  },
  {
   "id": "m_003002:0xff20",
   "off": 65312,
   "max": 16,
   "kind": "dialogue",
   "jp": "きゃーーーー！",
   "en": "",
   "op": "0x62",
   "msg": "0x084a"
  },
  {
   "id": "m_003002:0x103ac",
   "off": 66476,
   "max": 24,
   "kind": "dialogue",
   "jp": "新選組よーーーっ！\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x084b"
  },
  {
   "id": "m_003002:0x10d50",
   "off": 68944,
   "max": 48,
   "kind": "dialogue",
   "jp": "まだ姿を現さんのに\\nこんなに盛り上がるとは……",
   "en": "",
   "op": "0x62",
   "msg": "0x084c"
  },
  {
   "id": "m_003002:0x10d90",
   "off": 69008,
   "max": 36,
   "kind": "dialogue",
   "jp": "新選組は　本当に\\nすごいもんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x084d"
  },
  {
   "id": "m_003002:0x11400",
   "off": 70656,
   "max": 20,
   "kind": "dialogue",
   "jp": "感心してる場合か！",
   "en": "",
   "op": "0x62",
   "msg": "0x084e"
  },
  {
   "id": "m_003002:0x11ab0",
   "off": 72368,
   "max": 44,
   "kind": "dialogue",
   "jp": "まぁ　感心したくも\\nなりますよ　これじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x084f"
  },
  {
   "id": "m_003002:0x12058",
   "off": 73816,
   "max": 24,
   "kind": "dialogue",
   "jp": "桂がそう呟くのも道理",
   "en": "",
   "op": "0x62",
   "msg": "0x0850"
  },
  {
   "id": "m_003002:0x12080",
   "off": 73856,
   "max": 92,
   "kind": "dialogue",
   "jp": "大きな建物いっぱいに\\n渦巻く熱気は\\n開始直後であるにも\\nかかわらず\\n最高潮まで達していた",
   "en": "",
   "op": "0x62",
   "msg": "0x0851"
  },
  {
   "id": "m_003002:0x12660",
   "off": 75360,
   "max": 36,
   "kind": "dialogue",
   "jp": "どんな演奏をするのか\\n楽しみぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x0852"
  },
  {
   "id": "m_003002:0x12b00",
   "off": 76544,
   "max": 48,
   "kind": "dialogue",
   "jp": "おい　龍馬\\nオレ様達は敵情視察に\\n来てるだけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0853"
  },
  {
   "id": "m_003002:0x12b40",
   "off": 76608,
   "max": 44,
   "kind": "dialogue",
   "jp": "楽しみにきたんじゃねえ\\nそれを忘れるなよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0854"
  },
  {
   "id": "m_003002:0x130e8",
   "off": 78056,
   "max": 44,
   "kind": "dialogue",
   "jp": "その時\\n龍馬達に近づく\\n一つの人影があった",
   "en": "",
   "op": "0x62",
   "msg": "0x0855"
  },
  {
   "id": "m_003002:0x1392c",
   "off": 80172,
   "max": 44,
   "kind": "dialogue",
   "jp": "おや？　おまえさんたち\\n初めて見る顔だな",
   "en": "",
   "op": "0x62",
   "msg": "0x0856"
  },
  {
   "id": "m_003002:0x140b8",
   "off": 82104,
   "max": 24,
   "kind": "dialogue",
   "jp": "誰ぜよ\\nお前さんは？",
   "en": "",
   "op": "0x62",
   "msg": "0x0857"
  },
  {
   "id": "m_003002:0x145e8",
   "off": 83432,
   "max": 52,
   "kind": "dialogue",
   "jp": "ははは\\n俺は新選組　一番の\\n煌を自認している男だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0858"
  },
  {
   "id": "m_003002:0x14da4",
   "off": 85412,
   "max": 36,
   "kind": "dialogue",
   "jp": "……けっ\\n趣味が悪いオッサンだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x0859"
  },
  {
   "id": "m_003002:0x15464",
   "off": 87140,
   "max": 20,
   "kind": "dialogue",
   "jp": "晋作\\n失礼ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x085a"
  },
  {
   "id": "m_003002:0x15c58",
   "off": 89176,
   "max": 48,
   "kind": "dialogue",
   "jp": "そっちの兄さんは\\n気乗りしない様子の\\nようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x085b"
  },
  {
   "id": "m_003002:0x161a0",
   "off": 90528,
   "max": 20,
   "kind": "dialogue",
   "jp": "あぁ？\\n悪いか",
   "en": "",
   "op": "0x62",
   "msg": "0x085c"
  },
  {
   "id": "m_003002:0x16630",
   "off": 91696,
   "max": 68,
   "kind": "dialogue",
   "jp": "だがその割には　一番\\n真剣に雷舞を観ようと\\nしている風にも見える",
   "en": "",
   "op": "0x62",
   "msg": "0x085d"
  },
  {
   "id": "m_003002:0x16b94",
   "off": 93076,
   "max": 12,
   "kind": "dialogue",
   "jp": "……なっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x085e"
  },
  {
   "id": "m_003002:0x1733c",
   "off": 95036,
   "max": 20,
   "kind": "dialogue",
   "jp": "おお\\n始まるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x085f"
  },
  {
   "id": "m_003002:0x179ec",
   "off": 96748,
   "max": 40,
   "kind": "dialogue",
   "jp": "おっと　いかん\\n俺も席に戻らねば……",
   "en": "",
   "op": "0x62",
   "msg": "0x0860"
  },
  {
   "id": "m_003002:0x17a24",
   "off": 96804,
   "max": 52,
   "kind": "dialogue",
   "jp": "じゃあな　兄さん達\\n新選組を応援して\\nやってくれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0861"
  },
  {
   "id": "m_003002:0x180f4",
   "off": 98548,
   "max": 36,
   "kind": "dialogue",
   "jp": "なんだ　あのむかつく\\nオッサンは！",
   "en": "",
   "op": "0x62",
   "msg": "0x0862"
  },
  {
   "id": "m_003002:0x1875c",
   "off": 100188,
   "max": 60,
   "kind": "dialogue",
   "jp": "どこかで見たような\\n気がするんですが……\\n誰だったかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x0863"
  },
  {
   "id": "m_003002:0x18f8c",
   "off": 102284,
   "max": 52,
   "kind": "dialogue",
   "jp": "こらー！　お前ら\\nなにをしてるー！\\n始まるぜよー！",
   "en": "",
   "op": "0x62",
   "msg": "0x0864"
  },
  {
   "id": "m_003002:0x19810",
   "off": 104464,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ええ",
   "en": "",
   "op": "0x62",
   "msg": "0x0865"
  },
  {
   "id": "m_003002:0x19d38",
   "off": 105784,
   "max": 92,
   "kind": "dialogue",
   "jp": "観客の波の中に男は消えた\\nその姿を求め\\n桂は目をこらしたが\\n多数の観客が\\nそれを許さない",
   "en": "",
   "op": "0x62",
   "msg": "0x0866"
  },
  {
   "id": "m_003002:0x19da4",
   "off": 105892,
   "max": 76,
   "kind": "dialogue",
   "jp": "舞台の上で　新選組が\\n歌い始めると　桂の興味は\\nそちらに向けられていった",
   "en": "",
   "op": "0x62",
   "msg": "0x0867"
  },
  {
   "id": "m_003002:0x1aa6c",
   "off": 109164,
   "max": 40,
   "kind": "dialogue",
   "jp": "……すごいのう\\nあいつら　すごいぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0868"
  },
  {
   "id": "m_003002:0x1b274",
   "off": 111220,
   "max": 48,
   "kind": "dialogue",
   "jp": "……ちっ！\\n最低限の実力は\\n備えているようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x0869"
  },
  {
   "id": "m_003002:0x1b720",
   "off": 112416,
   "max": 36,
   "kind": "dialogue",
   "jp": "最低限というのは\\n過小評価でしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x086a"
  },
  {
   "id": "m_003002:0x1b754",
   "off": 112468,
   "max": 76,
   "kind": "dialogue",
   "jp": "音階　音程にブレがない\\nそして　この\\n喩似尊（ユニゾン）の\\n力強さ……！\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x086b"
  },
  {
   "id": "m_003002:0x1c094",
   "off": 114836,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ぐっ",
   "en": "",
   "op": "0x62",
   "msg": "0x086c"
  },
  {
   "id": "m_003002:0x1c0b0",
   "off": 114864,
   "max": 16,
   "kind": "dialogue",
   "jp": "た……たしかに",
   "en": "",
   "op": "0x62",
   "msg": "0x086d"
  },
  {
   "id": "m_003002:0x1c6b8",
   "off": 116408,
   "max": 72,
   "kind": "dialogue",
   "jp": "当初はあんなに\\n嫌悪していた高杉さえ\\n新選組の実力を\\n認めるしかない",
   "en": "",
   "op": "0x62",
   "msg": "0x086e"
  },
  {
   "id": "m_003002:0x1c710",
   "off": 116496,
   "max": 48,
   "kind": "dialogue",
   "jp": "だがその横で\\n龍馬は微妙な\\n違和感を覚えていた",
   "en": "",
   "op": "0x62",
   "msg": "0x086f"
  },
  {
   "id": "m_003002:0x1ccc8",
   "off": 117960,
   "max": 40,
   "kind": "dialogue",
   "jp": "確かにすごいぜよ……\\nだけど……なぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x0870"
  },
  {
   "id": "m_003002:0x1d400",
   "off": 119808,
   "max": 56,
   "kind": "dialogue",
   "jp": "ぐるりと\\n周囲を見回すと\\n興奮に沸き立つ\\n観客達がいる",
   "en": "",
   "op": "0x62",
   "msg": "0x0871"
  },
  {
   "id": "m_003002:0x1d740",
   "off": 120640,
   "max": 28,
   "kind": "dialogue",
   "jp": "なんか……\\nおかしいぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0872"
  },
  {
   "id": "m_003002:0x1db14",
   "off": 121620,
   "max": 76,
   "kind": "dialogue",
   "jp": "リズムに合わせ\\n体を揺らす\\n観客達の目は\\nどこかうつろに\\n見えるのだ……",
   "en": "",
   "op": "0x62",
   "msg": "0x0873"
  },
  {
   "id": "m_003002:0x1e170",
   "off": 123248,
   "max": 28,
   "kind": "dialogue",
   "jp": "これは……\\n違うぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x0874"
  },
  {
   "id": "m_003002:0x1e6a0",
   "off": 124576,
   "max": 44,
   "kind": "dialogue",
   "jp": "おい\\nシンディ　センセー！\\n気づかないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0875"
  },
  {
   "id": "m_003002:0x1ed10",
   "off": 126224,
   "max": 16,
   "kind": "dialogue",
   "jp": "わかってるさ",
   "en": "",
   "op": "0x62",
   "msg": "0x0876"
  },
  {
   "id": "m_003002:0x1ed30",
   "off": 126256,
   "max": 64,
   "kind": "dialogue",
   "jp": "連中の舞台は素晴らしい\\nオレ様達とは段違いの\\n完成度だ……っ",
   "en": "",
   "op": "0x62",
   "msg": "0x0877"
  },
  {
   "id": "m_003002:0x1ed80",
   "off": 126336,
   "max": 68,
   "kind": "dialogue",
   "jp": "くそ……っ\\n連中の歌が\\n旋律（メロディ）が\\n心に直接訴えかけてくる",
   "en": "",
   "op": "0x62",
   "msg": "0x0878"
  },
  {
   "id": "m_003002:0x1f6b8",
   "off": 128696,
   "max": 12,
   "kind": "dialogue",
   "jp": "……だが",
   "en": "",
   "op": "0x62",
   "msg": "0x0879"
  },
  {
   "id": "m_003002:0x1fb48",
   "off": 129864,
   "max": 60,
   "kind": "dialogue",
   "jp": "だが　何なんだ？\\nオレ様の心は　魂は\\nちっとも躍らねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x087a"
  },
  {
   "id": "m_003002:0x202a4",
   "off": 131748,
   "max": 52,
   "kind": "dialogue",
   "jp": "確かに……\\n技巧は申し分ないのに\\n何かが違います",
   "en": "",
   "op": "0x62",
   "msg": "0x087b"
  },
  {
   "id": "m_003002:0x20970",
   "off": 133488,
   "max": 12,
   "kind": "dialogue",
   "jp": "うう……っ",
   "en": "",
   "op": "0x62",
   "msg": "0x087c"
  },
  {
   "id": "m_003002:0x2098c",
   "off": 133516,
   "max": 44,
   "kind": "dialogue",
   "jp": "こいつらの　音楽は\\n間違ってるぜよ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x087d"
  },
  {
   "id": "m_003002:0x21148",
   "off": 135496,
   "max": 60,
   "kind": "dialogue",
   "jp": "それは　こいつらが\\n本気の魂を込めて\\n歌ってないからだっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x087e"
  },
  {
   "id": "m_003002:0x2191c",
   "off": 137500,
   "max": 16,
   "kind": "dialogue",
   "jp": "龍馬くんっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0880"
  },
  {
   "id": "m_003002:0x21fc4",
   "off": 139204,
   "max": 52,
   "kind": "dialogue",
   "jp": "こんなの放って置けるか！\\nわしは我慢できんぜよー！",
   "en": "",
   "op": "0x62",
   "msg": "0x0881"
  },
  {
   "id": "m_003002:0x22694",
   "off": 140948,
   "max": 24,
   "kind": "dialogue",
   "jp": "おい\\n落ち着けバカ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0882"
  },
  {
   "id": "m_003002:0x22b3c",
   "off": 142140,
   "max": 52,
   "kind": "dialogue",
   "jp": "興奮した龍馬を\\n高杉と桂は\\n落ち着かせようとする",
   "en": "",
   "op": "0x62",
   "msg": "0x0883"
  },
  {
   "id": "m_003002:0x22b80",
   "off": 142208,
   "max": 76,
   "kind": "dialogue",
   "jp": "だがその腕を振り切り\\n龍馬は観客達をかき分け\\n前列へと駆け出して\\nしまった",
   "en": "",
   "op": "0x62",
   "msg": "0x0884"
  },
  {
   "id": "m_003002:0x23018",
   "off": 143384,
   "max": 24,
   "kind": "dialogue",
   "jp": "ちょっ……\\n龍馬くん",
   "en": "",
   "op": "0x62",
   "msg": "0x0885"
  },
  {
   "id": "m_003002:0x23674",
   "off": 145012,
   "max": 44,
   "kind": "dialogue",
   "jp": "はぁ？\\nなにしてんだ\\nあのバカ野郎はっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0886"
  },
  {
   "id": "m_003002:0x24134",
   "off": 147764,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ん？",
   "en": "",
   "op": "0x62",
   "msg": "0x0887"
  },
  {
   "id": "m_003002:0x245bc",
   "off": 148924,
   "max": 24,
   "kind": "dialogue",
   "jp": "客が騒いでいる……？",
   "en": "",
   "op": "0x62",
   "msg": "0x0888"
  },
  {
   "id": "m_003002:0x24c18",
   "off": 150552,
   "max": 20,
   "kind": "dialogue",
   "jp": "総司\\n気を散らすな",
   "en": "",
   "op": "0x62",
   "msg": "0x0889"
  },
  {
   "id": "m_003002:0x250a8",
   "off": 151720,
   "max": 40,
   "kind": "dialogue",
   "jp": "でも土方さん\\nなんだか\\n様子が変ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x088a"
  },
  {
   "id": "m_003002:0x25ad4",
   "off": 154324,
   "max": 60,
   "kind": "dialogue",
   "jp": "かーーーっ！\\nやっぱり　違うぜよ！\\nお前たちの音楽は違う！",
   "en": "",
   "op": "0x62",
   "msg": "0x088b"
  },
  {
   "id": "m_003002:0x262cc",
   "off": 156364,
   "max": 12,
   "kind": "dialogue",
   "jp": "なっ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x088c"
  },
  {
   "id": "m_003002:0x26778",
   "off": 157560,
   "max": 48,
   "kind": "dialogue",
   "jp": "舞台に男が飛び込み\\n新選組の演奏は中断された",
   "en": "",
   "op": "0x62",
   "msg": "0x088d"
  },
  {
   "id": "m_003002:0x26bf8",
   "off": 158712,
   "max": 24,
   "kind": "dialogue",
   "jp": "……貴様！\\n何者だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x088e"
  },
  {
   "id": "m_003002:0x27250",
   "off": 160336,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしは　坂本龍馬！\\n熱い魂で　ロックを\\n愛する男ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x088f"
  },
  {
   "id": "m_003002:0x27920",
   "off": 162080,
   "max": 16,
   "kind": "dialogue",
   "jp": "坂本……龍馬？",
   "en": "",
   "op": "0x62",
   "msg": "0x0890"
  },
  {
   "id": "m_003002:0x27940",
   "off": 162112,
   "max": 72,
   "kind": "dialogue",
   "jp": "その坂本さんが　一体\\n何の権利があって　僕達の\\n舞台を邪魔するワケ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0891"
  },
  {
   "id": "m_003002:0x27e04",
   "off": 163332,
   "max": 32,
   "kind": "dialogue",
   "jp": "お前たちの音楽は\\n歪んでる！",
   "en": "",
   "op": "0x62",
   "msg": "0x0892"
  },
  {
   "id": "m_003002:0x27e34",
   "off": 163380,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしは　それを教えて\\nやりにきた！",
   "en": "",
   "op": "0x62",
   "msg": "0x0893"
  },
  {
   "id": "m_003002:0x282d4",
   "off": 164564,
   "max": 52,
   "kind": "dialogue",
   "jp": "歪んでいる？\\n僕たちの音楽が？\\n聞き捨てならないな",
   "en": "",
   "op": "0x62",
   "msg": "0x0894"
  },
  {
   "id": "m_003002:0x28a8c",
   "off": 166540,
   "max": 32,
   "kind": "dialogue",
   "jp": "下手という意味じゃ\\nないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0895"
  },
  {
   "id": "m_003002:0x28abc",
   "off": 166588,
   "max": 72,
   "kind": "dialogue",
   "jp": "それにお前たちの音楽は\\n熱い！　わしの胸は　\\nお前らの魂を感じる！\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0896"
  },
  {
   "id": "m_003002:0x28b14",
   "off": 166676,
   "max": 48,
   "kind": "dialogue",
   "jp": "それなのに　お前たちは\\n何かを間違ってるっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0897"
  },
  {
   "id": "m_003002:0x28b54",
   "off": 166740,
   "max": 44,
   "kind": "dialogue",
   "jp": "だから音楽が死んでる！\\nもったいないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0898"
  },
  {
   "id": "m_003002:0x2921c",
   "off": 168476,
   "max": 64,
   "kind": "dialogue",
   "jp": "俺達の歌が死んでいる？\\n新選組を　愚弄する気か\\n坂本龍馬とやら",
   "en": "",
   "op": "0x62",
   "msg": "0x0899"
  },
  {
   "id": "m_003002:0x2989c",
   "off": 170140,
   "max": 32,
   "kind": "dialogue",
   "jp": "間違ってるものは\\n間違ってる",
   "en": "",
   "op": "0x62",
   "msg": "0x089a"
  },
  {
   "id": "m_003002:0x29f54",
   "off": 171860,
   "max": 48,
   "kind": "dialogue",
   "jp": "うるさいよ\\n何様のつもりか\\n知らないけどさあ",
   "en": "",
   "op": "0x62",
   "msg": "0x089b"
  },
  {
   "id": "m_003002:0x29f94",
   "off": 171924,
   "max": 48,
   "kind": "dialogue",
   "jp": "僕達の歌に　文句を\\n付けるなんて\\n生意気だね",
   "en": "",
   "op": "0x62",
   "msg": "0x089c"
  },
  {
   "id": "m_003002:0x29fd4",
   "off": 171988,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方さん　こいつを\\nたたき出しちゃっても\\nいいですよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x089d"
  },
  {
   "id": "m_003002:0x2aa14",
   "off": 174612,
   "max": 44,
   "kind": "dialogue",
   "jp": "……ああ\\nこの不埒者を会場から\\n叩き出せ",
   "en": "",
   "op": "0x62",
   "msg": "0x097d"
  },
  {
   "id": "m_003002:0x2afcc",
   "off": 176076,
   "max": 52,
   "kind": "dialogue",
   "jp": "土方の合図で\\n舞台袖から\\n警備役の武士達が\\n現れた",
   "en": "",
   "op": "0x62",
   "msg": "0x08a0"
  },
  {
   "id": "m_003002:0x2b6c0",
   "off": 177856,
   "max": 20,
   "kind": "dialogue",
   "jp": "神妙に縛につけ",
   "en": "",
   "op": "0x62",
   "msg": "0x08a1"
  },
  {
   "id": "m_003002:0x2bb50",
   "off": 179024,
   "max": 24,
   "kind": "dialogue",
   "jp": "ちょっ……\\n待て待て！",
   "en": "",
   "op": "0x62",
   "msg": "0x08a2"
  },
  {
   "id": "m_003002:0x2c2ec",
   "off": 180972,
   "max": 36,
   "kind": "dialogue",
   "jp": "待つわけないし\\nバカじゃないの？",
   "en": "",
   "op": "0x62",
   "msg": "0x08a3"
  },
  {
   "id": "m_003002:0x2c824",
   "off": 182308,
   "max": 60,
   "kind": "dialogue",
   "jp": "いいや！　わしが\\n真の音楽を　お前らに\\n聴かせてやるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x08a4"
  },
  {
   "id": "m_003002:0x2ccdc",
   "off": 183516,
   "max": 36,
   "kind": "dialogue",
   "jp": "いや　いらないし\\n余計なお世話だし",
   "en": "",
   "op": "0x62",
   "msg": "0x08a5"
  },
  {
   "id": "m_003002:0x2d214",
   "off": 184852,
   "max": 52,
   "kind": "dialogue",
   "jp": "そんなこと言うな！\\nお前らは真の音楽を\\n取り戻せ",
   "en": "",
   "op": "0x62",
   "msg": "0x08a6"
  },
  {
   "id": "m_003002:0x2d6c4",
   "off": 186052,
   "max": 24,
   "kind": "dialogue",
   "jp": "話を聞かない人だなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x08a7"
  },
  {
   "id": "m_003002:0x2de64",
   "off": 188004,
   "max": 24,
   "kind": "dialogue",
   "jp": "戯れ言を聞く気はない",
   "en": "",
   "op": "0x62",
   "msg": "0x08a8"
  },
  {
   "id": "m_003002:0x2e688",
   "off": 190088,
   "max": 20,
   "kind": "dialogue",
   "jp": "わしは本気ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x08a9"
  },
  {
   "id": "m_003002:0x2e7bc",
   "off": 190396,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしが　お前らに\\n本気のロックを\\n見せてやるぜよー！",
   "en": "",
   "op": "0x62",
   "msg": "0x08aa"
  },
  {
   "id": "m_003002:0x2f208",
   "off": 193032,
   "max": 52,
   "kind": "dialogue",
   "jp": "これ以上の話は\\n無駄だ 警備！\\n奴を取り押さえろ！",
