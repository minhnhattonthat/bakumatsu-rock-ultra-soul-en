   "msg": "0x08dc"
  },
  {
   "id": "m_003002:0x43458",
   "off": 275544,
   "max": 60,
   "kind": "dialogue",
   "jp": "近藤さんと新選組を\\nバカにしたこと……\\n後悔するといいよ！",
