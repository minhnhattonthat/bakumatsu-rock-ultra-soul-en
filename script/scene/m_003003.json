{
 "source": "m_003003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_003003:0x1a84",
   "off": 6788,
   "max": 20,
   "kind": "dialogue",
   "jp": "うおおおおぉぉっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x08f3"
  },
  {
   "id": "m_003003:0x24fc",
   "off": 9468,
   "max": 32,
   "kind": "dialogue",
   "jp": "ああ……！\\n気持ちいいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x08f4"
  },
  {
   "id": "m_003003:0x252c",
   "off": 9516,
   "max": 52,
   "kind": "dialogue",
   "jp": "これぞ\\n入魂（ソウルフル）\\nこれこそロックぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x08f5"
  },
  {
   "id": "m_003003:0x2d20",
   "off": 11552,
   "max": 44,
   "kind": "dialogue",
   "jp": "……これは　この歌は　\\n一体なんなのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x08f6"
  },
  {
   "id": "m_003003:0x33e4",
   "off": 13284,
   "max": 40,
   "kind": "dialogue",
   "jp": "僕の歌……？\\nこれは僕の歌なのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x08f7"
  },
  {
   "id": "m_003003:0x389c",
   "off": 14492,
   "max": 52,
   "kind": "dialogue",
   "jp": "舞台の上で\\n龍馬　沖田　土方の\\n三名は見つめあった",
   "en": "",
   "op": "0x62",
   "msg": "0x08f8"
  },
  {
   "id": "m_003003:0x38e0",
   "off": 14560,
   "max": 44,
   "kind": "dialogue",
   "jp": "迸る力で\\nそれぞれ胸の奥が\\n熱く滾っている",
   "en": "",
   "op": "0x62",
   "msg": "0x08f9"
  },
  {
   "id": "m_003003:0x3e94",
   "off": 16020,
   "max": 48,
   "kind": "dialogue",
   "jp": "……すごかったあ……\\n今のって……なんか……",
   "en": "",
   "op": "0x62",
   "msg": "0x08fa"
  },
  {
   "id": "m_003003:0x4340",
   "off": 17216,
   "max": 44,
   "kind": "dialogue",
   "jp": "私も……魂が\\n抜かれたみたいで\\n……あ……",
   "en": "",
   "op": "0x62",
   "msg": "0x08fb"
  },
  {
   "id": "m_003003:0x4c40",
   "off": 19520,
   "max": 76,
   "kind": "dialogue",
   "jp": "会場の中では\\n幾人もの観客が\\n今し方のバトルの熱気に\\n当てられ倒れていく",
   "en": "",
   "op": "0x62",
   "msg": "0x08fc"
  },
  {
   "id": "m_003003:0x5280",
   "off": 21120,
   "max": 32,
   "kind": "dialogue",
   "jp": "うわわ！\\nみんな　大丈夫か！",
   "en": "",
   "op": "0x62",
   "msg": "0x08fd"
  },
  {
   "id": "m_003003:0x593c",
   "off": 22844,
   "max": 24,
   "kind": "dialogue",
   "jp": "……気持ち　いい……",
   "en": "",
   "op": "0x62",
   "msg": "0x08fe"
  },
  {
   "id": "m_003003:0x5de4",
   "off": 24036,
   "max": 108,
   "kind": "dialogue",
   "jp": "倒れた者も\\nそうでない者も\\nうつろだった瞳に\\n光が戻り　興奮に頬を\\n染めた観客達は生気に\\n満ちあふれていた",
   "en": "",
   "op": "0x62",
   "msg": "0x08ff"
  },
  {
   "id": "m_003003:0x665c",
   "off": 26204,
   "max": 8,
   "kind": "dialogue",
   "jp": "ん？",
   "en": "",
   "op": "0x62",
   "msg": "0x0900"
  },
  {
   "id": "m_003003:0x6e04",
   "off": 28164,
   "max": 56,
   "kind": "dialogue",
   "jp": "幕府主催の新選組雷舞を\\n荒らす不届き者は\\nどいつだっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0901"
  },
  {
   "id": "m_003003:0x6e4c",
   "off": 28236,
   "max": 40,
   "kind": "dialogue",
   "jp": "しかも天歌以外の\\n歌を歌うとは……！",
   "en": "",
   "op": "0x62",
   "msg": "0x0982"
  },
  {
   "id": "m_003003:0x7388",
   "off": 29576,
   "max": 32,
   "kind": "dialogue",
   "jp": "何を言う！\\n音楽は自由ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0903"
  },
  {
   "id": "m_003003:0x7824",
   "off": 30756,
   "max": 24,
   "kind": "dialogue",
   "jp": "さては\\n貴様か……！",
   "en": "",
   "op": "0x62",
   "msg": "0x0904"
  },
  {
   "id": "m_003003:0x7cb8",
   "off": 31928,
   "max": 64,
   "kind": "dialogue",
   "jp": "歌は　音楽は\\n魂（たましい）ぜよ！\\nそしてソウルぜよーっ！\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0906"
  },
  {
   "id": "m_003003:0x81d0",
   "off": 33232,
   "max": 32,
   "kind": "dialogue",
   "jp": "やかましい！\\n神妙に縛につけ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0907"
  },
  {
   "id": "m_003003:0x8768",
   "off": 34664,
   "max": 16,
   "kind": "dialogue",
   "jp": "ちょちょっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0908"
  },
  {
   "id": "m_003003:0x8790",
   "off": 34704,
   "max": 60,
   "kind": "dialogue",
   "jp": "わしは当たり前のことを\\n言ってるだけだ\\nなんで　怒るぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0909"
  },
  {
   "id": "m_003003:0x8f50",
   "off": 36688,
   "max": 56,
   "kind": "dialogue",
   "jp": "そりゃ怒るに決まってる\\nでしょ\\n黙って逃げればいいのに",
   "en": "",
   "op": "0x62",
   "msg": "0x090a"
  },
  {
   "id": "m_003003:0x9404",
   "off": 37892,
   "max": 40,
   "kind": "dialogue",
   "jp": "ねえ　土方さん\\nこの人　バカなのかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x090b"
  },
  {
   "id": "m_003003:0x9ac8",
   "off": 39624,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x090c"
  },
  {
   "id": "m_003003:0xa174",
   "off": 41332,
   "max": 24,
   "kind": "dialogue",
   "jp": "や　や\\nやばいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x090d"
  },
  {
   "id": "m_003003:0xa7cc",
   "off": 42956,
   "max": 64,
   "kind": "dialogue",
   "jp": "僕達は知らないよ？\\n君に手を貸す義理は\\nさすがにないもんねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x090e"
  },
  {
   "id": "m_003003:0xac88",
   "off": 44168,
   "max": 28,
   "kind": "dialogue",
   "jp": "おい　シンディ\\nセンセー！",
   "en": "",
   "op": "0x62",
   "msg": "0x090f"
  },
  {
   "id": "m_003003:0xb198",
   "off": 45464,
   "max": 56,
   "kind": "dialogue",
   "jp": "……あれ？\\nシンディとセンセーは\\nどこに行った？　　",
   "en": "",
   "op": "0x62",
   "msg": "0x0910"
  },
  {
   "id": "m_003003:0xb57c",
   "off": 46460,
   "max": 80,
   "kind": "dialogue",
   "jp": "龍馬は辺りを見回すが\\nさっきまで共に演奏\\nしていた二人の姿は\\n忽然と消えている",
   "en": "",
   "op": "0x62",
   "msg": "0x0911"
  },
  {
   "id": "m_003003:0xb8dc",
   "off": 47324,
   "max": 16,
   "kind": "dialogue",
   "jp": "えええええー",
   "en": "",
   "op": "0x62",
   "msg": "0x0912"
  },
  {
   "id": "m_003003:0xbdd8",
   "off": 48600,
   "max": 32,
   "kind": "dialogue",
   "jp": "あれ？\\n仲間に見捨てられたの？",
   "en": "",
   "op": "0x62",
   "msg": "0x0913"
  },
  {
   "id": "m_003003:0xc314",
   "off": 49940,
   "max": 44,
   "kind": "dialogue",
   "jp": "違う！\\nあの二人はそんな\\nことはしない！",
   "en": "",
   "op": "0x62",
   "msg": "0x0914"
  },
  {
   "id": "m_003003:0xc7bc",
   "off": 51132,
   "max": 24,
   "kind": "dialogue",
   "jp": "でも\\n実際いないし？",
   "en": "",
   "op": "0x62",
   "msg": "0x0915"
  },
  {
   "id": "m_003003:0xccf0",
   "off": 52464,
   "max": 56,
   "kind": "dialogue",
   "jp": "えっと……逃げ道は\\nどっちぜよ？\\n教えてもらえるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0916"
  },
  {
   "id": "m_003003:0xd1a4",
   "off": 53668,
   "max": 20,
   "kind": "dialogue",
   "jp": "教えるわけないしー",
   "en": "",
   "op": "0x62",
   "msg": "0x0917"
  },
  {
   "id": "m_003003:0xdc5c",
   "off": 56412,
   "max": 28,
   "kind": "dialogue",
   "jp": "今捕まるのは\\n困るぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0918"
  },
  {
   "id": "m_003003:0xe4d4",
   "off": 58580,
   "max": 64,
   "kind": "dialogue",
   "jp": "そんなこと言ってるうちに\\nもう逃げ場が\\nなくなっちゃったよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0919"
  },
  {
   "id": "m_003003:0xea08",
   "off": 59912,
   "max": 36,
   "kind": "dialogue",
   "jp": "御用だ！\\n不埒者を引っ捕らえろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x091a"
  },
  {
   "id": "m_003003:0xef1c",
   "off": 61212,
   "max": 16,
   "kind": "dialogue",
   "jp": "あわわわわ……",
   "en": "",
   "op": "0x62",
   "msg": "0x091b"
  },
  {
   "id": "m_003003:0xf8c8",
   "off": 63688,
   "max": 28,
   "kind": "dialogue",
   "jp": "うわっ\\n今のは何の爆発？",
   "en": "",
   "op": "0x62",
   "msg": "0x091c"
  },
  {
   "id": "m_003003:0xff14",
   "off": 65300,
   "max": 32,
   "kind": "dialogue",
   "jp": "あー\\n会場の壁に\\n大きな穴が",
   "en": "",
   "op": "0x62",
   "msg": "0x091d"
  },
  {
   "id": "m_003003:0x10504",
   "off": 66820,
   "max": 56,
   "kind": "dialogue",
   "jp": "おいバカ！\\nバカを助けに来たぞ！\\nどこにいるんだバカ！",
   "en": "",
   "op": "0x62",
   "msg": "0x091e"
  },
  {
   "id": "m_003003:0x10af4",
   "off": 68340,
   "max": 28,
   "kind": "dialogue",
   "jp": "そ　その声は\\nシンディか！",
   "en": "",
   "op": "0x62",
   "msg": "0x091f"
  },
  {
   "id": "m_003003:0x110c8",
   "off": 69832,
   "max": 44,
   "kind": "dialogue",
   "jp": "驚いてる暇があったら\\n逃げるぞ　このバカ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0920"
  },
  {
   "id": "m_003003:0x116f4",
   "off": 71412,
   "max": 36,
   "kind": "dialogue",
   "jp": "あ　あんまりバカバカ\\n言うなよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x0921"
  },
  {
   "id": "m_003003:0x11b50",
   "off": 72528,
   "max": 76,
   "kind": "dialogue",
   "jp": "呼ばれた方へと\\n駆け出した龍馬だが\\nすぐにその足を止め\\n後ろを振り返った",
   "en": "",
   "op": "0x62",
   "msg": "0x0922"
  },
  {
   "id": "m_003003:0x11f3c",
   "off": 73532,
   "max": 40,
   "kind": "dialogue",
   "jp": "あっ！\\nお前らの名前は\\nなんて言う",
   "en": "",
   "op": "0x62",
   "msg": "0x0923"
  },
  {
   "id": "m_003003:0x12588",
   "off": 75144,
   "max": 36,
   "kind": "dialogue",
   "jp": "新選組　一番隊組長\\n沖田総司だよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0924"
  },
  {
   "id": "m_003003:0x12c48",
   "off": 76872,
   "max": 28,
   "kind": "dialogue",
   "jp": "……新選組　副長\\n土方歳三",
   "en": "",
   "op": "0x62",
   "msg": "0x0925"
  },
  {
   "id": "m_003003:0x13234",
   "off": 78388,
   "max": 52,
   "kind": "dialogue",
   "jp": "ソウちんと\\nヒジゾーさんか！\\nよっし　覚えたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0926"
  },
  {
   "id": "m_003003:0x13990",
   "off": 80272,
   "max": 12,
   "kind": "dialogue",
   "jp": "ソウちん",
   "en": "",
   "op": "0x62",
   "msg": "0x0927"
  },
  {
   "id": "m_003003:0x14040",
   "off": 81984,
   "max": 24,
   "kind": "dialogue",
   "jp": "ヒジゾー……\\nだと？",
   "en": "",
   "op": "0x62",
   "msg": "0x0928"
  },
  {
   "id": "m_003003:0x146c8",
   "off": 83656,
   "max": 52,
   "kind": "dialogue",
   "jp": "天歌を歌う　お前らに\\nわしは　納得いかなかった\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0929"
  },
  {
   "id": "m_003003:0x14c10",
   "off": 85008,
   "max": 64,
   "kind": "dialogue",
   "jp": "だけど　さっきの\\n演奏（うた）には　\\nわしもほれぼれしたぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x092a"
  },
  {
   "id": "m_003003:0x14c60",
   "off": 85088,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしは　さっきの\\nお前らは好きぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x092b"
  },
  {
   "id": "m_003003:0x15310",
   "off": 86800,
   "max": 64,
   "kind": "dialogue",
   "jp": "ソウちん　ヒジゾーさん！\\nまたいつか　わしと一緒に\\n演るぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x092c"
  },
  {
   "id": "m_003003:0x15a24",
   "off": 88612,
   "max": 44,
   "kind": "dialogue",
   "jp": "くだんねーこと言って\\nないで　行くぞっ",
   "en": "",
   "op": "0x62",
   "msg": "0x092d"
  },
  {
   "id": "m_003003:0x16220",
   "off": 90656,
   "max": 60,
   "kind": "dialogue",
   "jp": "高杉に首根っこを\\n引っ張られ\\n龍馬は会場を\\n走り去っていく",
   "en": "",
   "op": "0x62",
   "msg": "0x092e"
  },
  {
   "id": "m_003003:0x1626c",
   "off": 90732,
   "max": 44,
   "kind": "dialogue",
   "jp": "それは\\nあっという間の\\n出来事であった――",
   "en": "",
   "op": "0x62",
   "msg": "0x092f"
  },
  {
   "id": "m_003003:0x16cc8",
   "off": 93384,
   "max": 32,
   "kind": "dialogue",
   "jp": "おまえは\\n正真正銘のバカだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0930"
  },
  {
   "id": "m_003003:0x17484",
   "off": 95364,
   "max": 16,
   "kind": "dialogue",
   "jp": "そう怒るなよー",
   "en": "",
   "op": "0x62",
   "msg": "0x0931"
  },
  {
   "id": "m_003003:0x17b30",
   "off": 97072,
   "max": 36,
   "kind": "dialogue",
   "jp": "でも　さすがにあれは\\n無茶でしたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0932"
  },
  {
   "id": "m_003003:0x17c00",
   "off": 97280,
   "max": 60,
   "kind": "dialogue",
   "jp": "たまたま　爆弾を\\n持ち歩いていたから\\n逃げ出せたんですから",
   "en": "",
   "op": "0x62",
   "msg": "0x0933"
  },
  {
   "id": "m_003003:0x18284",
   "off": 98948,
   "max": 60,
   "kind": "dialogue",
   "jp": "……センセー\\nそんな恐ろしいモンを\\n普段持ち歩いてるのか",
   "en": "",
   "op": "0x62",
   "msg": "0x0934"
  },
  {
   "id": "m_003003:0x187e0",
   "off": 100320,
   "max": 12,
   "kind": "dialogue",
   "jp": "龍馬くん？",
   "en": "",
   "op": "0x62",
   "msg": "0x0935"
  },
  {
   "id": "m_003003:0x18ebc",
   "off": 102076,
   "max": 44,
   "kind": "dialogue",
   "jp": "は　反省してる！\\n反省はしてるが\\nでも……",
   "en": "",
   "op": "0x62",
   "msg": "0x0936"
  },
  {
   "id": "m_003003:0x18f90",
   "off": 102288,
   "max": 72,
   "kind": "dialogue",
   "jp": "なんか　あいつらの音楽を\\n聴いてたら　ガマン\\nできなくなってなぁ……",
   "en": "",
   "op": "0x62",
   "msg": "0x0937"
  },
  {
   "id": "m_003003:0x1967c",
   "off": 104060,
   "max": 68,
   "kind": "dialogue",
   "jp": "だからって　乗り込んで\\n雷舞潰しをするバカが\\nどこの世界にいる！",
   "en": "",
   "op": "0x62",
   "msg": "0x0938"
  },
  {
   "id": "m_003003:0x19b3c",
   "off": 105276,
   "max": 44,
   "kind": "dialogue",
   "jp": "だけど\\nいい合奏\\n（セッション）だった！\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0939"
  },
  {
   "id": "m_003003:0x1a080",
   "off": 106624,
   "max": 56,
   "kind": "dialogue",
   "jp": "確かにあれは\\n聴く者の魂を揺さぶる\\n演奏だったが……",
   "en": "",
   "op": "0x62",
   "msg": "0x093a"
  },
  {
   "id": "m_003003:0x1ab40",
   "off": 109376,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや　いいとか悪いとか\\nそういう話はしてねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x093b"
  },
  {
   "id": "m_003003:0x1ab80",
   "off": 109440,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前のバカさ加減の話を\\nしてるんだっ",
   "en": "",
   "op": "0x62",
   "msg": "0x093c"
  },
  {
   "id": "m_003003:0x1b340",
   "off": 111424,
   "max": 24,
   "kind": "dialogue",
   "jp": "うう\\n悪かった……\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x093d"
  },
  {
   "id": "m_003003:0x1b400",
   "off": 111616,
   "max": 64,
   "kind": "dialogue",
   "jp": "でも　いつかきっと\\nシンディとセンセーも\\nわかってくれるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x093e"
  },
  {
   "id": "m_003003:0x1ba84",
   "off": 113284,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前がバカなのは\\nもう十分わかってる",
   "en": "",
   "op": "0x62",
   "msg": "0x093f"
  },
  {
   "id": "m_003003:0x1c148",
   "off": 115016,
   "max": 56,
   "kind": "dialogue",
   "jp": "私も龍馬くんが\\nバカだってことは\\n否定できませんねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x0940"
  },
  {
   "id": "m_003003:0x1c69c",
   "off": 116380,
   "max": 40,
   "kind": "dialogue",
   "jp": "新選組　土方歳三と\\n沖田総司……かぁー",
   "en": "",
   "op": "0x62",
   "msg": "0x0941"
  },
  {
   "id": "m_003003:0x1cef4",
   "off": 118516,
   "max": 20,
   "kind": "dialogue",
   "jp": "聞けよ\\n人の話を！",
   "en": "",
   "op": "0x62",
   "msg": "0x0942"
  },
  {
   "id": "m_003003:0x1d498",
   "off": 119960,
   "max": 68,
   "kind": "dialogue",
   "jp": "ああ……　あいつらとの\\n演奏を思い出すと\\nわしの魂が震えるぜよっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0943"
  },
  {
   "id": "m_003003:0x1d9f4",
   "off": 121332,
   "max": 12,
   "kind": "dialogue",
   "jp": "……うっ",
   "en": "",
   "op": "0x62",
   "msg": "0x0944"
  },
  {
   "id": "m_003003:0x1de7c",
   "off": 122492,
   "max": 28,
   "kind": "dialogue",
   "jp": "シンディも\\nそう思うか",
   "en": "",
   "op": "0x62",
   "msg": "0x0945"
  },
  {
   "id": "m_003003:0x1e314",
   "off": 123668,
   "max": 16,
   "kind": "dialogue",
   "jp": "う　うっせえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0946"
  },
  {
   "id": "m_003003:0x1eaa8",
   "off": 125608,
   "max": 48,
   "kind": "dialogue",
   "jp": "あいつらも\\n熱い魂を持つ男に\\n違いないぜよ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x0947"
  },
  {
   "id": "m_003003:0x1eae8",
   "off": 125672,
   "max": 44,
   "kind": "dialogue",
   "jp": "また一緒に演れる時が\\nくるといいなあっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0948"
  },
  {
   "id": "m_003003:0x1efa4",
   "off": 126884,
   "max": 60,
   "kind": "dialogue",
   "jp": "興奮冷めやらぬ龍馬は\\n握り拳を　天に向かって\\n突き上げる",
   "en": "",
   "op": "0x62",
   "msg": "0x0949"
  },
  {
   "id": "m_003003:0x1eff0",
   "off": 126960,
   "max": 56,
   "kind": "dialogue",
   "jp": "そして\\nそんな彼を見ながら\\n桂小五郎は秘かに\\n予感した",
   "en": "",
   "op": "0x62",
   "msg": "0x094a"
  },
  {
   "id": "m_003003:0x1f5a4",
   "off": 128420,
   "max": 56,
   "kind": "dialogue",
   "jp": "舞台の上で\\n名乗ったのは失敗だった\\nかもしれませんね",
   "en": "",
   "op": "0x62",
   "msg": "0x094b"
  },
  {
   "id": "m_003003:0x1f5ec",
   "off": 128492,
   "max": 60,
   "kind": "dialogue",
   "jp": "これで龍馬くんの名は\\n幕府側に　記録されて\\nしまった……",
   "en": "",
   "op": "0x62",
   "msg": "0x094c"
  },
  {
   "id": "m_003003:0x1f6d4",
   "off": 128724,
   "max": 68,
   "kind": "dialogue",
   "jp": "けれど　それと同時に\\nその名も　この京に\\n知れ渡るに違いない……",
   "en": "",
   "op": "0x62",
   "msg": "0x094d"
  },
  {
   "id": "m_003003:0x1f728",
   "off": 128808,
   "max": 48,
   "kind": "dialogue",
   "jp": "これが良いことなのか\\nそれとも悪いことなのか",
   "en": "",
   "op": "0x62",
   "msg": "0x094e"
  },
  {
   "id": "m_003003:0x1f768",
   "off": 128872,
   "max": 52,
   "kind": "dialogue",
   "jp": "どちらに天秤が傾くのかは\\n私にもまだわかりません",
   "en": "",
   "op": "0x62",
   "msg": "0x094f"
  },
  {
   "id": "m_003003:0x1fcc0",
   "off": 130240,
   "max": 24,
   "kind": "dialogue",
   "jp": "風が吹こうとしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0950"
  },
  {
   "id": "m_003003:0x1fce8",
   "off": 130280,
   "max": 56,
   "kind": "dialogue",
   "jp": "それは\\n誰にも止められない\\n新しい時代の\\n風である――",
   "en": "",
   "op": "0x62",
   "msg": "0x0951"
  },
  {
   "id": "m_003003:0x2047c",
   "off": 132220,
   "max": 48,
   "kind": "dialogue",
   "jp": "あーあ　今日の雷舞は\\nメチャクチャだったなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x0952"
  },
  {
   "id": "m_003003:0x20af0",
   "off": 133872,
   "max": 56,
   "kind": "dialogue",
   "jp": "文句を言う割に\\n機嫌はさほど悪くない\\nようだな　総司",
   "en": "",
   "op": "0x62",
   "msg": "0x0953"
  },
  {
   "id": "m_003003:0x20fa4",
   "off": 135076,
   "max": 64,
   "kind": "dialogue",
   "jp": "決まり切ったお仕着せの\\n雷舞よりは　いくらか\\n楽しかったですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0954"
  },
  {
   "id": "m_003003:0x20ff4",
   "off": 135156,
   "max": 44,
   "kind": "dialogue",
   "jp": "あのおバカさんも\\nバカすぎて面白かったし",
   "en": "",
   "op": "0x62",
   "msg": "0x0955"
  },
  {
   "id": "m_003003:0x21538",
   "off": 136504,
   "max": 8,
   "kind": "dialogue",
   "jp": "総司！",
   "en": "",
   "op": "0x62",
   "msg": "0x0956"
  },
  {
   "id": "m_003003:0x21a54",
   "off": 137812,
   "max": 16,
   "kind": "dialogue",
   "jp": "……なんですか",
   "en": "",
   "op": "0x62",
   "msg": "0x0957"
  },
  {
   "id": "m_003003:0x221ec",
   "off": 139756,
   "max": 44,
   "kind": "dialogue",
   "jp": "俺達は　楽しむために\\n歌っているんじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x0958"
  },
  {
   "id": "m_003003:0x22228",
   "off": 139816,
   "max": 64,
   "kind": "dialogue",
   "jp": "幕府を……この世を泰平に\\nするために　天歌を\\n歌っているんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0984"
  },
  {
   "id": "m_003003:0x22278",
   "off": 139896,
   "max": 16,
   "kind": "dialogue",
   "jp": "それを忘れるな",
   "en": "",
   "op": "0x62",
   "msg": "0x095a"
  },
  {
   "id": "m_003003:0x22920",
   "off": 141600,
   "max": 24,
   "kind": "dialogue",
   "jp": "……はい\\nすみません",
   "en": "",
   "op": "0x62",
   "msg": "0x095b"
  },
  {
   "id": "m_003003:0x22fd4",
   "off": 143316,
   "max": 20,
   "kind": "dialogue",
   "jp": "トシ\\nそう怒るな",
   "en": "",
   "op": "0x62",
   "msg": "0x095c"
  },
  {
   "id": "m_003003:0x2362c",
   "off": 144940,
   "max": 16,
   "kind": "dialogue",
   "jp": "近藤さん……！",
   "en": "",
   "op": "0x62",
   "msg": "0x095d"
  },
  {
   "id": "m_003003:0x23ab8",
   "off": 146104,
   "max": 52,
   "kind": "dialogue",
   "jp": "そもそも　坂本龍馬との\\n合奏を許可したのは俺だ\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x095e"
  },
  {
   "id": "m_003003:0x23afc",
   "off": 146172,
   "max": 68,
   "kind": "dialogue",
   "jp": "今夜の雷舞……トシが\\n失敗だったと思うのなら\\n責任は全て俺にある",
   "en": "",
   "op": "0x62",
   "msg": "0x095f"
  },
  {
   "id": "m_003003:0x23b50",
   "off": 146256,
   "max": 16,
   "kind": "dialogue",
   "jp": "すまなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x0960"
  },
  {
   "id": "m_003003:0x24078",
   "off": 147576,
   "max": 72,
   "kind": "dialogue",
   "jp": "いえ　あいつに乗せられた\\n俺と総司が甘かったのです\\n申し訳ありません",
   "en": "",
   "op": "0x62",
   "msg": "0x0961"
  },
  {
   "id": "m_003003:0x24960",
   "off": 149856,
   "max": 24,
   "kind": "dialogue",
   "jp": "……おまえはカタいなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x0962"
  },
  {
   "id": "m_003003:0x24ac4",
   "off": 150212,
   "max": 68,
   "kind": "dialogue",
   "jp": "だがな　おまえが天歌の\\n大切さをわかって\\nくれていて　俺は嬉しい\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0963"
  },
  {
   "id": "m_003003:0x2518c",
   "off": 151948,
   "max": 48,
   "kind": "dialogue",
   "jp": "天歌は　この世に平和を\\n幸せをもたらすものだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0964"
  },
  {
   "id": "m_003003:0x251cc",
   "off": 152012,
   "max": 76,
   "kind": "dialogue",
   "jp": "そのために　我ら新選組は\\n天歌の普及に　命を賭して\\n取りかからねばならん",
   "en": "",
   "op": "0x62",
   "msg": "0x0965"
  },
  {
   "id": "m_003003:0x25a78",
   "off": 154232,
   "max": 8,
   "kind": "dialogue",
   "jp": "はい！",
   "en": "",
   "op": "0x62",
   "msg": "0x0966"
  },
  {
   "id": "m_003003:0x2620c",
   "off": 156172,
   "max": 20,
   "kind": "dialogue",
   "jp": "頼りにしているぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x0967"
  },
  {
   "id": "m_003003:0x26864",
   "off": 157796,
   "max": 12,
   "kind": "dialogue",
   "jp": "はい……！",
   "en": "",
   "op": "0x62",
   "msg": "0x0968"
  },
  {
   "id": "m_003003:0x26fac",
   "off": 159660,
   "max": 52,
   "kind": "dialogue",
   "jp": "……あれっ\\n今もしかして\\n土方さんが笑った……？",
   "en": "",
   "op": "0x62",
   "msg": "0x0969"
  },
  {
   "id": "m_003003:0x27638",
   "off": 161336,
   "max": 20,
   "kind": "dialogue",
   "jp": "うるさいぞ　総司",
   "en": "",
   "op": "0x62",
   "msg": "0x096a"
  },
  {
   "id": "m_003003:0x27e44",
   "off": 163396,
   "max": 12,
   "kind": "dialogue",
   "jp": "痛ーっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x096b"
  },
  {
   "id": "m_003003:0x27e60",
   "off": 163424,
   "max": 24,
   "kind": "dialogue",
   "jp": "ぶつことないでしょー！",
   "en": "",
   "op": "0x62",
   "msg": "0x096c"
  },
  {
   "id": "m_003003:0x282f4",
   "off": 164596,
   "max": 28,
   "kind": "dialogue",
   "jp": "お前はいつも\\n一言多いんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x096d"
  },
  {
   "id": "m_003003:0x28b0c",
   "off": 166668,
   "max": 12,
   "kind": "dialogue",
   "jp": "ははは！",
   "en": "",
   "op": "0x62",
   "msg": "0x096e"
  },
  {
   "id": "m_003003:0x291b0",
   "off": 168368,
   "max": 64,
   "kind": "dialogue",
   "jp": "ていうか　近藤さん！\\n今日もまた　観客席に\\n紛れてたでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x096f"
  },
  {
   "id": "m_003003:0x29834",
   "off": 170036,
   "max": 64,
   "kind": "dialogue",
   "jp": "舞台袖からだと　おまえ\\n達の活躍が　ちゃんと\\n見られないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x0970"
  },
  {
   "id": "m_003003:0x29920",
   "off": 170272,
   "max": 32,
   "kind": "dialogue",
   "jp": "やっぱり　観るなら\\n観客席だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0971"
  },
  {
   "id": "m_003003:0x29dbc",
   "off": 171452,
   "max": 24,
   "kind": "dialogue",
   "jp": "近藤さんは局長なのにぃ",
   "en": "",
   "op": "0x62",
   "msg": "0x0972"
  },
  {
   "id": "m_003003:0x2a55c",
   "off": 173404,
   "max": 72,
   "kind": "dialogue",
   "jp": "一線を退いたとはいえ\\n俺も新選組の隊士である\\nことを忘れてはいないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x0973"
  },
  {
   "id": "m_003003:0x2a5b4",
   "off": 173492,
   "max": 64,
   "kind": "dialogue",
   "jp": "だが　この俺は\\nおまえたち新選組　一番の\\n煌でもあるからな！",
   "en": "",
   "op": "0x62",
   "msg": "0x0974"
  },
  {
   "id": "m_003003:0x2ac8c",
   "off": 175244,
   "max": 12,
   "kind": "dialogue",
   "jp": "んもうー",
   "en": "",
   "op": "0x62",
   "msg": "0x0975"
  },
  {
   "id": "m_003003:0x2b334",
   "off": 176948,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ふっ",
   "en": "",
   "op": "0x62",
   "msg": "0x0976"
  },
  {
   "id": "m_003003:0x2ba24",
   "off": 178724,
   "max": 24,
   "kind": "dialogue",
   "jp": "あっ　やっぱり笑……",
   "en": "",
   "op": "0x62",
   "msg": "0x0977"
  },
  {
   "id": "m_003003:0x2c7bc",
   "off": 182204,
   "max": 64,
   "kind": "dialogue",
   "jp": "痛ーっ！　またぶった！\\nいいかげん泣きますよ？\\nいいんですか",
   "en": "",
   "op": "0x62",
   "msg": "0x0978"
  },
  {
   "id": "m_003003:0x2cd10",
   "off": 183568,
   "max": 52,
   "kind": "dialogue",
   "jp": "沖田の涙の訴えに\\n近藤が笑い\\n土方は無表情を返す",
   "en": "",
   "op": "0x62",
   "msg": "0x0979"
  },
  {
   "id": "m_003003:0x2cd54",
   "off": 183636,
   "max": 48,
   "kind": "dialogue",
   "jp": "それは　新選組で\\nよく見られる\\n一幕であった",
   "en": "",
   "op": "0x62",
   "msg": "0x097a"
  },
  {
   "id": "m_003003:0x2cd94",
   "off": 183700,
   "max": 64,
   "kind": "dialogue",
   "jp": "そんな彼らの背後で\\nひそかに　運命の歯車が\\n回り始めたことを",
   "en": "",
   "op": "0x62",
   "msg": "0x097b"
  },
  {
   "id": "m_003003:0x2cde4",
   "off": 183780,
   "max": 24,
   "kind": "dialogue",
   "jp": "まだ\\n誰も知らない――",
   "en": "",
   "op": "0x62",
   "msg": "0x097c"
  }
 ]
}
