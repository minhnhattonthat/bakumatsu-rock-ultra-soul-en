{
 "source": "m_003003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_003003:0x1a84",
   "off": 6788,
   "max": 20,
   "kind": "dialogue",
   "jp": "うおおおおぉぉっ！",
   "en": "Wooooaaah!",
   "op": "0x62",
   "msg": "0x08f3"
  },
  {
   "id": "m_003003:0x24fc",
   "off": 9468,
   "max": 32,
   "kind": "dialogue",
   "jp": "ああ……！\\n気持ちいいぜよ！",
   "en": "Ahh...! That feels\\ngreat!",
   "op": "0x62",
   "msg": "0x08f4"
  },
  {
   "id": "m_003003:0x252c",
   "off": 9516,
   "max": 52,
   "kind": "dialogue",
   "jp": "これぞ\\n入魂（ソウルフル）\\nこれこそロックぜよ！",
   "en": "THIS is soulful!\\nTHIS is rock!",
   "op": "0x62",
   "msg": "0x08f5"
  },
  {
   "id": "m_003003:0x2d20",
   "off": 11552,
   "max": 44,
   "kind": "dialogue",
   "jp": "……これは　この歌は　\\n一体なんなのだ",
   "en": "...This... What on\\nearth is this\\nsong?",
   "op": "0x62",
   "msg": "0x08f6"
  },
  {
   "id": "m_003003:0x33e4",
   "off": 13284,
   "max": 40,
   "kind": "dialogue",
   "jp": "僕の歌……？\\nこれは僕の歌なのか……",
   "en": "My song...? Is this\\nmy song...?",
   "op": "0x62",
   "msg": "0x08f7"
  },
  {
   "id": "m_003003:0x389c",
   "off": 14492,
   "max": 52,
   "kind": "dialogue",
   "jp": "舞台の上で\\n龍馬　沖田　土方の\\n三名は見つめあった",
   "en": "On the stage,\\nRyoma, Okita and\\nHijikata looked at\\none another.",
   "op": "0x62",
   "msg": "0x08f8"
  },
  {
   "id": "m_003003:0x38e0",
   "off": 14560,
   "max": 44,
   "kind": "dialogue",
   "jp": "迸る力で\\nそれぞれ胸の奥が\\n熱く滾っている",
   "en": "Deep in each\\none's chest, a\\nsurging power\\nburned hot.",
   "op": "0x62",
   "msg": "0x08f9"
  },
  {
   "id": "m_003003:0x3e94",
   "off": 16020,
   "max": 48,
   "kind": "dialogue",
   "jp": "……すごかったあ……\\n今のって……なんか……",
   "en": "...That was\\namazing... What\\nwas that just\\nnow... somehow...",
   "op": "0x62",
   "msg": "0x08fa"
  },
  {
   "id": "m_003003:0x4340",
   "off": 17216,
   "max": 44,
   "kind": "dialogue",
   "jp": "私も……魂が\\n抜かれたみたいで\\n……あ……",
   "en": "Me too... It's like\\nmy soul got\\npulled right out...\\nAh...",
   "op": "0x62",
   "msg": "0x08fb"
  },
  {
   "id": "m_003003:0x4c40",
   "off": 19520,
   "max": 76,
   "kind": "dialogue",
   "jp": "会場の中では\\n幾人もの観客が\\n今し方のバトルの熱気に\\n当てられ倒れていく",
   "en": "All through the\\nvenue, one\\nspectator after\\nanother\\ncollapsed,\\novercome by the\\nheat of the battle\\njust now.",
   "op": "0x62",
   "msg": "0x08fc"
  },
  {
   "id": "m_003003:0x5280",
   "off": 21120,
   "max": 32,
   "kind": "dialogue",
   "jp": "うわわ！\\nみんな　大丈夫か！",
   "en": "Whoa! Everybody\\nall right!",
   "op": "0x62",
   "msg": "0x08fd"
  },
  {
   "id": "m_003003:0x593c",
   "off": 22844,
   "max": 24,
   "kind": "dialogue",
   "jp": "……気持ち　いい……",
   "en": "...Feels... so good...",
   "op": "0x62",
   "msg": "0x08fe"
  },
  {
   "id": "m_003003:0x5de4",
   "off": 24036,
   "max": 108,
   "kind": "dialogue",
   "jp": "倒れた者も\\nそうでない者も\\nうつろだった瞳に\\n光が戻り　興奮に頬を\\n染めた観客達は生気に\\n満ちあふれていた",
   "en": "Fallen or not,\\nlight returned to\\nthe spectators'\\nempty eyes.\\nCheeks flushed\\nwith excitement,\\nthey brimmed\\nwith life.",
   "op": "0x62",
   "msg": "0x08ff"
  },
  {
   "id": "m_003003:0x665c",
   "off": 26204,
   "max": 8,
   "kind": "dialogue",
   "jp": "ん？",
   "en": "Hm?",
   "op": "0x62",
   "msg": "0x0900"
  },
  {
   "id": "m_003003:0x6e04",
   "off": 28164,
   "max": 56,
   "kind": "dialogue",
   "jp": "幕府主催の新選組雷舞を\\n荒らす不届き者は\\nどいつだっ！",
   "en": "Who's the\\nscoundrel\\nwrecking the\\nShinsengumi live\\nhosted by the\\nshogunate!",
   "op": "0x62",
   "msg": "0x0901"
  },
  {
   "id": "m_003003:0x6e4c",
   "off": 28236,
   "max": 40,
   "kind": "dialogue",
   "jp": "しかも天歌以外の\\n歌を歌うとは……！",
   "en": "And singing\\nsomething other\\nthan the Heaven's\\nSong...!",
   "op": "0x62",
   "msg": "0x0982"
  },
  {
   "id": "m_003003:0x7388",
   "off": 29576,
   "max": 32,
   "kind": "dialogue",
   "jp": "何を言う！\\n音楽は自由ぜよ！",
   "en": "What're ya talkin'\\nabout!? Music is\\nfree!",
   "op": "0x62",
   "msg": "0x0903"
  },
  {
   "id": "m_003003:0x7824",
   "off": 30756,
   "max": 24,
   "kind": "dialogue",
   "jp": "さては\\n貴様か……！",
   "en": "So it was you...!",
   "op": "0x62",
   "msg": "0x0904"
  },
  {
   "id": "m_003003:0x7cb8",
   "off": 31928,
   "max": 64,
   "kind": "dialogue",
   "jp": "歌は　音楽は\\n魂（たましい）ぜよ！\\nそしてソウルぜよーっ！\\n",
   "en": "Songs,\\nmusic--they're\\nsoul! And that's\\nSOOOUL!",
   "op": "0x62",
   "msg": "0x0906"
  },
  {
   "id": "m_003003:0x81d0",
   "off": 33232,
   "max": 32,
   "kind": "dialogue",
   "jp": "やかましい！\\n神妙に縛につけ！",
   "en": "Silence! Come\\nquietly!",
   "op": "0x62",
   "msg": "0x0907"
  },
  {
   "id": "m_003003:0x8768",
   "off": 34664,
   "max": 16,
   "kind": "dialogue",
   "jp": "ちょちょっ！",
   "en": "Wh-whoa, whoa!",
   "op": "0x62",
   "msg": "0x0908"
  },
  {
   "id": "m_003003:0x8790",
   "off": 34704,
   "max": 60,
   "kind": "dialogue",
   "jp": "わしは当たり前のことを\\n言ってるだけだ\\nなんで　怒るぜよ！",
   "en": "I'm only sayin'\\nwhat's obvious!\\nWhat's there to\\nget mad about!",
   "op": "0x62",
   "msg": "0x0909"
  },
  {
   "id": "m_003003:0x8f50",
   "off": 36688,
   "max": 56,
   "kind": "dialogue",
   "jp": "そりゃ怒るに決まってる\\nでしょ\\n黙って逃げればいいのに",
   "en": "Of course they're\\ngoing to get mad.\\nYou should've just\\nkept quiet and\\nrun.",
   "op": "0x62",
   "msg": "0x090a"
  },
  {
   "id": "m_003003:0x9404",
   "off": 37892,
   "max": 40,
   "kind": "dialogue",
   "jp": "ねえ　土方さん\\nこの人　バカなのかな？",
   "en": "Hey, Hijikata-san,\\nis this guy an\\nidiot?",
   "op": "0x62",
   "msg": "0x090b"
  },
  {
   "id": "m_003003:0x9ac8",
   "off": 39624,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………\\n",
   "en": "......",
   "op": "0x62",
   "msg": "0x090c"
  },
  {
   "id": "m_003003:0xa174",
   "off": 41332,
   "max": 24,
   "kind": "dialogue",
   "jp": "や　や\\nやばいぜよ！",
   "en": "Uh-oh, th-this is\\nbad!",
   "op": "0x62",
   "msg": "0x090d"
  },
  {
   "id": "m_003003:0xa7cc",
   "off": 42956,
   "max": 64,
   "kind": "dialogue",
   "jp": "僕達は知らないよ？\\n君に手を貸す義理は\\nさすがにないもんねぇ",
   "en": "Don't look at us.\\nWe're hardly\\nobliged to lend\\nyou a hand, are\\nwe?",
   "op": "0x62",
   "msg": "0x090e"
  },
  {
   "id": "m_003003:0xac88",
   "off": 44168,
   "max": 28,
   "kind": "dialogue",
   "jp": "おい　シンディ\\nセンセー！",
   "en": "Hey, Shindy!\\nSensei!",
   "op": "0x62",
   "msg": "0x090f"
  },
  {
   "id": "m_003003:0xb198",
   "off": 45464,
   "max": 56,
   "kind": "dialogue",
   "jp": "……あれ？\\nシンディとセンセーは\\nどこに行った？　　",
   "en": "...Huh? Where'd\\nShindy and Sensei\\ngo?",
   "op": "0x62",
   "msg": "0x0910"
  },
  {
   "id": "m_003003:0xb57c",
   "off": 46460,
   "max": 80,
   "kind": "dialogue",
   "jp": "龍馬は辺りを見回すが\\nさっきまで共に演奏\\nしていた二人の姿は\\n忽然と消えている",
   "en": "Ryoma looked\\naround, but the\\ntwo who had been\\nplaying with him\\nmoments ago had\\nvanished without\\na trace.",
   "op": "0x62",
   "msg": "0x0911"
  },
  {
   "id": "m_003003:0xb8dc",
   "off": 47324,
   "max": 16,
   "kind": "dialogue",
   "jp": "えええええー",
   "en": "Whaaaaat!?",
   "op": "0x62",
   "msg": "0x0912"
  },
  {
   "id": "m_003003:0xbdd8",
   "off": 48600,
   "max": 32,
   "kind": "dialogue",
   "jp": "あれ？\\n仲間に見捨てられたの？",
   "en": "Oh? Did your\\ncomrades ditch\\nyou?",
   "op": "0x62",
   "msg": "0x0913"
  },
  {
   "id": "m_003003:0xc314",
   "off": 49940,
   "max": 44,
   "kind": "dialogue",
   "jp": "違う！\\nあの二人はそんな\\nことはしない！",
   "en": "No! Those two\\nwould never do\\nthat!",
   "op": "0x62",
   "msg": "0x0914"
  },
  {
   "id": "m_003003:0xc7bc",
   "off": 51132,
   "max": 24,
   "kind": "dialogue",
   "jp": "でも\\n実際いないし？",
   "en": "But they're not\\nhere, are they?",
   "op": "0x62",
   "msg": "0x0915"
  },
  {
   "id": "m_003003:0xccf0",
   "off": 52464,
   "max": 56,
   "kind": "dialogue",
   "jp": "えっと……逃げ道は\\nどっちぜよ？\\n教えてもらえるか？",
   "en": "Uh... which way's\\nthe exit? Mind\\ntellin' me?",
   "op": "0x62",
   "msg": "0x0916"
  },
  {
   "id": "m_003003:0xd1a4",
   "off": 53668,
   "max": 20,
   "kind": "dialogue",
   "jp": "教えるわけないしー",
   "en": "Like I'd tell\\nyouuu.",
   "op": "0x62",
   "msg": "0x0917"
  },
  {
   "id": "m_003003:0xdc5c",
   "off": 56412,
   "max": 28,
   "kind": "dialogue",
   "jp": "今捕まるのは\\n困るぜよ",
   "en": "Gettin' caught\\nright now'd be a\\nreal problem.",
   "op": "0x62",
   "msg": "0x0918"
  },
  {
   "id": "m_003003:0xe4d4",
   "off": 58580,
   "max": 64,
   "kind": "dialogue",
   "jp": "そんなこと言ってるうちに\\nもう逃げ場が\\nなくなっちゃったよ？",
   "en": "While you were\\nsaying all that,\\nyou ran out of\\nplaces to run, you\\nknow?",
   "op": "0x62",
   "msg": "0x0919"
  },
  {
   "id": "m_003003:0xea08",
   "off": 59912,
   "max": 36,
   "kind": "dialogue",
   "jp": "御用だ！\\n不埒者を引っ捕らえろ！",
   "en": "You're under\\narrest! Seize the\\nscoundrel!",
   "op": "0x62",
   "msg": "0x091a"
  },
  {
   "id": "m_003003:0xef1c",
   "off": 61212,
   "max": 16,
   "kind": "dialogue",
   "jp": "あわわわわ……",
   "en": "Wawawawa...",
   "op": "0x62",
   "msg": "0x091b"
  },
  {
   "id": "m_003003:0xf8c8",
   "off": 63688,
   "max": 28,
   "kind": "dialogue",
   "jp": "うわっ\\n今のは何の爆発？",
   "en": "Whoa, what was\\nthat explosion?",
   "op": "0x62",
   "msg": "0x091c"
  },
  {
   "id": "m_003003:0xff14",
   "off": 65300,
   "max": 32,
   "kind": "dialogue",
   "jp": "あー\\n会場の壁に\\n大きな穴が",
   "en": "Huh. There's a big\\nhole in the venue\\nwall.",
   "op": "0x62",
   "msg": "0x091d"
  },
  {
   "id": "m_003003:0x10504",
   "off": 66820,
   "max": 56,
   "kind": "dialogue",
   "jp": "おいバカ！\\nバカを助けに来たぞ！\\nどこにいるんだバカ！",
   "en": "Hey, idiot! I came\\nto rescue the\\nidiot! Where are\\nyou, idiot!",
   "op": "0x62",
   "msg": "0x091e"
  },
  {
   "id": "m_003003:0x10af4",
   "off": 68340,
   "max": 28,
   "kind": "dialogue",
   "jp": "そ　その声は\\nシンディか！",
   "en": "Th-that voice... it's\\nShindy!",
   "op": "0x62",
   "msg": "0x091f"
  },
  {
   "id": "m_003003:0x110c8",
   "off": 69832,
   "max": 44,
   "kind": "dialogue",
   "jp": "驚いてる暇があったら\\n逃げるぞ　このバカ！",
   "en": "If you've got time\\nto be surprised,\\nthen run, you\\nidiot!",
   "op": "0x62",
   "msg": "0x0920"
  },
  {
   "id": "m_003003:0x116f4",
   "off": 71412,
   "max": 36,
   "kind": "dialogue",
   "jp": "あ　あんまりバカバカ\\n言うなよ……",
   "en": "D-don't call me an\\nidiot so much...",
   "op": "0x62",
   "msg": "0x0921"
  },
  {
   "id": "m_003003:0x11b50",
   "off": 72528,
   "max": 76,
   "kind": "dialogue",
   "jp": "呼ばれた方へと\\n駆け出した龍馬だが\\nすぐにその足を止め\\n後ろを振り返った",
   "en": "Ryoma started to\\nrun toward the\\nvoice, but soon\\nstopped and\\nlooked back.",
   "op": "0x62",
   "msg": "0x0922"
  },
  {
   "id": "m_003003:0x11f3c",
   "off": 73532,
   "max": 40,
   "kind": "dialogue",
   "jp": "あっ！\\nお前らの名前は\\nなんて言う",
   "en": "Oh! What're your\\nnames?",
   "op": "0x62",
   "msg": "0x0923"
  },
  {
   "id": "m_003003:0x12588",
   "off": 75144,
   "max": 36,
   "kind": "dialogue",
   "jp": "新選組　一番隊組長\\n沖田総司だよ",
   "en": "Captain of the\\nShinsengumi's\\nFirst Unit, Soji\\nOkita.",
   "op": "0x62",
   "msg": "0x0924"
  },
  {
   "id": "m_003003:0x12c48",
   "off": 76872,
   "max": 28,
   "kind": "dialogue",
   "jp": "……新選組　副長\\n土方歳三",
   "en": "...Shinsengumi\\nVice-Commander,\\nToshizo Hijikata.",
   "op": "0x62",
   "msg": "0x0925"
  },
  {
   "id": "m_003003:0x13234",
   "off": 78388,
   "max": 52,
   "kind": "dialogue",
   "jp": "ソウちんと\\nヒジゾーさんか！\\nよっし　覚えたぜよ",
   "en": "So-chin and\\nHijizo-san! All\\nright, I got it\\nmemorized!",
   "op": "0x62",
   "msg": "0x0926"
  },
  {
   "id": "m_003003:0x13990",
   "off": 80272,
   "max": 12,
   "kind": "dialogue",
   "jp": "ソウちん",
   "en": "So-chin...",
   "op": "0x62",
   "msg": "0x0927"
  },
  {
   "id": "m_003003:0x14040",
   "off": 81984,
   "max": 24,
   "kind": "dialogue",
   "jp": "ヒジゾー……\\nだと？",
   "en": "\"Hijizo\"...?",
   "op": "0x62",
   "msg": "0x0928"
  },
  {
   "id": "m_003003:0x146c8",
   "off": 83656,
   "max": 52,
   "kind": "dialogue",
   "jp": "天歌を歌う　お前らに\\nわしは　納得いかなかった\\n",
   "en": "I couldn't get\\nbehind you guys\\nsingin' the\\nHeaven's Song...",
   "op": "0x62",
   "msg": "0x0929"
  },
  {
   "id": "m_003003:0x14c10",
   "off": 85008,
   "max": 64,
   "kind": "dialogue",
   "jp": "だけど　さっきの\\n演奏（うた）には　\\nわしもほれぼれしたぜよ！",
   "en": "But that\\nperformance just\\nnow had even me\\nstarstruck!",
   "op": "0x62",
   "msg": "0x092a"
  },
  {
   "id": "m_003003:0x14c60",
   "off": 85088,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしは　さっきの\\nお前らは好きぜよ",
   "en": "I liked you guys\\nback there.",
   "op": "0x62",
   "msg": "0x092b"
  },
  {
   "id": "m_003003:0x15310",
   "off": 86800,
   "max": 64,
   "kind": "dialogue",
   "jp": "ソウちん　ヒジゾーさん！\\nまたいつか　わしと一緒に\\n演るぜよ",
   "en": "So-chin,\\nHijizo-san! Let's\\nplay together\\nagain someday!",
   "op": "0x62",
   "msg": "0x092c"
  },
  {
   "id": "m_003003:0x15a24",
   "off": 88612,
   "max": 44,
   "kind": "dialogue",
   "jp": "くだんねーこと言って\\nないで　行くぞっ",
   "en": "Quit talking\\nnonsense and let's\\ngo!",
   "op": "0x62",
   "msg": "0x092d"
  },
  {
   "id": "m_003003:0x16220",
   "off": 90656,
   "max": 60,
   "kind": "dialogue",
   "jp": "高杉に首根っこを\\n引っ張られ\\n龍馬は会場を\\n走り去っていく",
   "en": "Dragged off by\\nthe scruff of his\\nneck by Takasugi,\\nRyoma ran from\\nthe venue.",
   "op": "0x62",
   "msg": "0x092e"
  },
  {
   "id": "m_003003:0x1626c",
   "off": 90732,
   "max": 44,
   "kind": "dialogue",
   "jp": "それは\\nあっという間の\\n出来事であった――",
   "en": "It all happened in\\nthe blink of an\\neye--",
   "op": "0x62",
   "msg": "0x092f"
  },
  {
   "id": "m_003003:0x16cc8",
   "off": 93384,
   "max": 32,
   "kind": "dialogue",
   "jp": "おまえは\\n正真正銘のバカだ",
   "en": "You are a\\ngenuine, certified\\nidiot.",
   "op": "0x62",
   "msg": "0x0930"
  },
  {
   "id": "m_003003:0x17484",
   "off": 95364,
   "max": 16,
   "kind": "dialogue",
   "jp": "そう怒るなよー",
   "en": "Aw, don't be so\\nmad.",
   "op": "0x62",
   "msg": "0x0931"
  },
  {
   "id": "m_003003:0x17b30",
   "off": 97072,
   "max": 36,
   "kind": "dialogue",
   "jp": "でも　さすがにあれは\\n無茶でしたよ",
   "en": "But that really\\nwas reckless.",
