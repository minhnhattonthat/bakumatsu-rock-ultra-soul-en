{
 "source": "m_004001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_004001:0x1280",
   "off": 4736,
   "max": 36,
   "kind": "dialogue",
   "jp": "嵐山の公開雷舞から\\n一週間が経った",
   "en": "",
   "op": "0x62",
   "msg": "0x09b0"
  },
  {
   "id": "m_004001:0x12b4",
   "off": 4788,
   "max": 64,
   "kind": "dialogue",
   "jp": "龍馬と土方達の合奏の後\\n強制的に打ち切られた\\n雷舞だったが\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x09b1"
  },
  {
   "id": "m_004001:0x1304",
   "off": 4868,
   "max": 68,
   "kind": "dialogue",
   "jp": "京の町には　あの日\\n新選組とやりあった\\n闖入者の噂が\\n広まっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x09b2"
  },
  {
   "id": "m_004001:0x1358",
   "off": 4952,
   "max": 56,
   "kind": "dialogue",
   "jp": "新選組と\\n互角の歌唱力を持つ\\nあの男は一体何者なのか",
   "en": "",
   "op": "0x62",
   "msg": "0x09b3"
  },
  {
   "id": "m_004001:0x13a0",
   "off": 5024,
   "max": 32,
   "kind": "dialogue",
   "jp": "もう一度\\nあの熱い歌を聴きたい",
   "en": "",
   "op": "0x62",
   "msg": "0x09b4"
  },
  {
   "id": "m_004001:0x13d0",
   "off": 5072,
   "max": 88,
   "kind": "dialogue",
   "jp": "噂の闖入者と仲間達は\\nそんな民衆の想いに\\n応えるかのように\\n新たな行動を起こしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x09b5"
  },
  {
   "id": "m_004001:0x184c",
   "off": 6220,
   "max": 60,
   "kind": "dialogue",
   "jp": "薄暗い雷舞屋\\n（ライブハウス）に\\n熱いシャウトが木霊する",
   "en": "",
   "op": "0x62",
   "msg": "0x09b6"
  },
  {
   "id": "m_004001:0x1898",
   "off": 6296,
   "max": 68,
   "kind": "dialogue",
   "jp": "その歌声とギターの音は\\n黒山の人だかりを\\n興奮の渦に巻き込んでいた",
   "en": "",
   "op": "0x62",
   "msg": "0x09b7"
  },
  {
   "id": "m_004001:0x1d1c",
   "off": 7452,
   "max": 28,
   "kind": "dialogue",
   "jp": "みんな\\nよく来てくれたな！",
   "en": "",
   "op": "0x62",
   "msg": "0x09b8"
  },
  {
   "id": "m_004001:0x1de0",
   "off": 7648,
   "max": 64,
   "kind": "dialogue",
   "jp": "わしらの歌を聴くために\\nこんなに人が集まって\\nくれて感激ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x09b9"
  },
  {
   "id": "m_004001:0x2788",
   "off": 10120,
   "max": 48,
   "kind": "dialogue",
   "jp": "みんなー\\nありがとうー\\n愛してるぜよォォォ",
   "en": "",
   "op": "0x62",
   "msg": "0x09ba"
  },
  {
   "id": "m_004001:0x2f58",
   "off": 12120,
   "max": 68,
   "kind": "dialogue",
   "jp": "みんな　私達の雷舞に\\n来てくれてありがとう\\nみんなと会えて嬉しいよ",
   "en": "",
   "op": "0x62",
   "msg": "0x09bb"
  },
  {
   "id": "m_004001:0x2fac",
   "off": 12204,
   "max": 60,
   "kind": "dialogue",
   "jp": "この感動は　そう\\nエレキテルと出会った時の\\nそれと同じもの",
   "en": "",
   "op": "0x62",
   "msg": "0x09bc"
  },
  {
   "id": "m_004001:0x3954",
   "off": 14676,
   "max": 40,
   "kind": "dialogue",
   "jp": "明日は未来来る！\\nだから　付いてきて",
   "en": "",
   "op": "0x62",
   "msg": "0x09bd"
  },
  {
   "id": "m_004001:0x3994",
   "off": 14740,
   "max": 56,
   "kind": "dialogue",
   "jp": "ハイスピードで\\n駆け抜けるよ\\n烈ロックンロール",
   "en": "",
   "op": "0x62",
   "msg": "0x09be"
  },
  {
   "id": "m_004001:0x4180",
   "off": 16768,
   "max": 80,
   "kind": "dialogue",
   "jp": "センセーの挨拶（ＭＣ）を\\n聞いて女の子達が\\n飛び跳ねとる\\nセンセーもやるなあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x09bf"
  },
  {
   "id": "m_004001:0x4814",
   "off": 18452,
   "max": 44,
   "kind": "dialogue",
   "jp": "どうもありがとう\\n決めゼリフは大切ですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x09c0"
  },
  {
   "id": "m_004001:0x4d54",
   "off": 19796,
   "max": 24,
   "kind": "dialogue",
   "jp": "うんうん\\n大切ぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x09c1"
  },
  {
   "id": "m_004001:0x54f4",
   "off": 21748,
   "max": 60,
   "kind": "dialogue",
   "jp": "おい　龍馬　桂さん\\n余計なこと言ってねェで\\n雷舞を続けるぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x09c2"
  },
  {
   "id": "m_004001:0x5b78",
   "off": 23416,
   "max": 76,
   "kind": "dialogue",
   "jp": "シンディは短気だなぁ\\n雷舞は始まったばかりぜよ\\nそんなに急がなくても……",
   "en": "",
   "op": "0x62",
   "msg": "0x09c3"
  },
  {
   "id": "m_004001:0x6278",
   "off": 25208,
   "max": 48,
   "kind": "dialogue",
   "jp": "黙れ　バカ\\n無駄口叩かずに\\nさっさと準備をしろ",
   "en": "",
   "op": "0x62",
   "msg": "0x09c4"
  },
  {
   "id": "m_004001:0x62c0",
   "off": 25280,
   "max": 56,
   "kind": "dialogue",
   "jp": "でなけりゃ\\nお前ら二人纏めて\\n舞台から蹴り落としてやる",
   "en": "",
   "op": "0x62",
   "msg": "0x09c5"
  },
  {
   "id": "m_004001:0x67f0",
   "off": 26608,
   "max": 52,
   "kind": "dialogue",
   "jp": "ぬぅ……わかったぜよ\\nそれで\\n次の曲は何だったか",
   "en": "",
   "op": "0x62",
   "msg": "0x09c6"
  },
  {
   "id": "m_004001:0x7388",
   "off": 29576,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレ様だ\\nオレ様の歌で\\nてめーらを昇天せてやる",
   "en": "",
   "op": "0x62",
   "msg": "0x09c7"
  },
  {
   "id": "m_004001:0x78dc",
   "off": 30940,
   "max": 64,
   "kind": "dialogue",
   "jp": "てめーら　オレ様の音を\\n一音たりとも聴き逃すなよ\\nわかったな？",
   "en": "",
   "op": "0x62",
   "msg": "0x09c8"
  },
  {
   "id": "m_004001:0x7934",
   "off": 31028,
   "max": 52,
   "kind": "dialogue",
   "jp": "伸るか反るかの\\nこの感覚ッ！\\nクールにエンジョイ",
   "en": "",
   "op": "0x62",
   "msg": "0x09c9"
  },
  {
   "id": "m_004001:0x80d4",
   "off": 32980,
   "max": 24,
   "kind": "dialogue",
   "jp": "エンジョーーーーーイ！",
   "en": "",
   "op": "0x62",
   "msg": "0x09ca"
  },
  {
   "id": "m_004001:0x872c",
   "off": 34604,
   "max": 44,
   "kind": "dialogue",
   "jp": "センセー\\nシンディは超超\\nノリノリだなあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x09cb"
  },
  {
   "id": "m_004001:0x8d9c",
   "off": 36252,
   "max": 12,
   "kind": "dialogue",
   "jp": "ですねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x09cc"
  },
  {
   "id": "m_004001:0x9224",
   "off": 37412,
   "max": 60,
   "kind": "dialogue",
   "jp": "シンディの\\n歌いたくてたまらない\\n気持ちはよくわかるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x09cd"
  },
  {
   "id": "m_004001:0x9778",
   "off": 38776,
   "max": 56,
   "kind": "dialogue",
   "jp": "ふふっ　そうですね\\nだけど\\nそれだけじゃないと思うよ",
   "en": "",
   "op": "0x62",
   "msg": "0x09ce"
  },
  {
   "id": "m_004001:0x9ccc",
   "off": 40140,
   "max": 8,
   "kind": "dialogue",
   "jp": "ほえ？",
   "en": "",
   "op": "0x62",
   "msg": "0x09cf"
  },
  {
   "id": "m_004001:0xa5d0",
   "off": 42448,
   "max": 76,
   "kind": "dialogue",
   "jp": "今までの統計から察するに\\nもうすぐ邪魔が入る頃だし\\n急いでるんじゃないかな",
   "en": "",
   "op": "0x62",
   "msg": "0x09d0"
  },
  {
   "id": "m_004001:0xab44",
   "off": 43844,
   "max": 60,
   "kind": "dialogue",
   "jp": "すっと目を細めて\\n桂が雷舞屋の扉を見つめる\\nその瞬間……",
   "en": "",
   "op": "0x62",
   "msg": "0x09d1"
  },
  {
   "id": "m_004001:0xab90",
   "off": 43920,
   "max": 68,
   "kind": "dialogue",
   "jp": "閉ざされていた扉が開き\\n新選組の隊士が\\n勢いよく雪崩れ込んできた",
   "en": "",
   "op": "0x62",
   "msg": "0x09d2"
  },
  {
   "id": "m_004001:0xb64c",
   "off": 46668,
   "max": 28,
   "kind": "dialogue",
   "jp": "動くな！\\n我らは新選組だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x09d3"
  },
  {
   "id": "m_004001:0xbaec",
   "off": 47852,
   "max": 72,
   "kind": "dialogue",
   "jp": "そこのトサカくん達は\\n僕達の目を盗んで　また\\nいけない事をしてたね？",
   "en": "",
   "op": "0x62",
   "msg": "0x09d4"
  },
  {
   "id": "m_004001:0xc0a8",
   "off": 49320,
   "max": 56,
   "kind": "dialogue",
   "jp": "幕府に楯突く不届き者め\\n今度こそ逃がさん！\\n覚悟しろ",
   "en": "",
   "op": "0x62",
   "msg": "0x09d5"
  },
  {
   "id": "m_004001:0xc764",
   "off": 51044,
   "max": 64,
   "kind": "dialogue",
   "jp": "土方と沖田の号令の下\\n新選組の隊士が\\n舞台へ一斉に押し寄せる！",
   "en": "",
   "op": "0x62",
   "msg": "0x09d6"
  },
  {
   "id": "m_004001:0xcbe8",
   "off": 52200,
   "max": 60,
   "kind": "dialogue",
   "jp": "予感的中\\n今日も邪魔が入りましたね\\n龍馬くん　どうします？",
   "en": "",
   "op": "0x62",
   "msg": "0x09d7"
  },
  {
   "id": "m_004001:0xd264",
   "off": 53860,
   "max": 40,
   "kind": "dialogue",
   "jp": "新選組にも聴いて\\nもらいたいけどなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x09d8"
  },
  {
   "id": "m_004001:0xd928",
   "off": 55592,
   "max": 72,
   "kind": "dialogue",
   "jp": "けっ　オレ様の番になると\\n邪魔しに来るとは\\nそうとう意識してやがるな",
   "en": "",
   "op": "0x62",
   "msg": "0x09d9"
  },
  {
   "id": "m_004001:0xde84",
   "off": 56964,
   "max": 36,
   "kind": "dialogue",
   "jp": "シンディ　センセー\\nここは逃げよう",
   "en": "",
   "op": "0x62",
   "msg": "0x09da"
  },
  {
   "id": "m_004001:0xdeb8",
   "off": 57016,
   "max": 44,
   "kind": "dialogue",
   "jp": "客を危険な目に巻き込む\\nのはいかんからなっ",
   "en": "",
   "op": "0x62",
   "msg": "0x09db"
  },
  {
   "id": "m_004001:0xe580",
   "off": 58752,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうですね\\n敵を撹乱するために\\n三手に別れて逃げましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x09dc"
  },
  {
   "id": "m_004001:0xe5cc",
   "off": 58828,
   "max": 76,
   "kind": "dialogue",
   "jp": "追っ手から逃げ切った後は\\n例の場所で落ち合いましょう\\n異論はないですね？",
   "en": "",
   "op": "0x62",
   "msg": "0x09dd"
  },
  {
   "id": "m_004001:0xeb2c",
   "off": 60204,
   "max": 8,
   "kind": "dialogue",
   "jp": "おう！",
   "en": "",
   "op": "0x62",
   "msg": "0x09de"
  },
  {
   "id": "m_004001:0xf1d0",
   "off": 61904,
   "max": 20,
   "kind": "dialogue",
   "jp": "ちッ\\n仕方ねェな",
   "en": "",
   "op": "0x62",
   "msg": "0x09df"
  },
  {
   "id": "m_004001:0xfbe4",
   "off": 64484,
   "max": 76,
   "kind": "dialogue",
   "jp": "それじゃみんな　元気でな\\nわしらの歌を　また聴きに\\n来るぜよォォォオオ",
   "en": "",
   "op": "0x62",
   "msg": "0x09e0"
  },
  {
   "id": "m_004001:0x101bc",
   "off": 65980,
   "max": 52,
   "kind": "dialogue",
   "jp": "三人は速やかに結論を出すと\\n舞台の裏口へ駆け出した",
   "en": "",
   "op": "0x62",
   "msg": "0x09e1"
  },
  {
   "id": "m_004001:0x10768",
   "off": 67432,
   "max": 72,
   "kind": "dialogue",
   "jp": "それから暫くして……\\n龍馬は追っ手を振り切ると\\nテラーダに駆け込んだ",
   "en": "",
   "op": "0x62",
   "msg": "0x09e2"
  },
  {
   "id": "m_004001:0x10dac",
   "off": 69036,
   "max": 60,
   "kind": "dialogue",
   "jp": "今日の合流場所は\\nここだったよな？\\nさて　あの二人は……と",
   "en": "",
   "op": "0x62",
   "msg": "0x09e3"
  },
  {
   "id": "m_004001:0x114f4",
   "off": 70900,
   "max": 24,
   "kind": "dialogue",
   "jp": "龍馬くん\\nこっちですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x09e4"
  },
  {
   "id": "m_004001:0x11b50",
   "off": 72528,
   "max": 20,
   "kind": "dialogue",
   "jp": "フン\\nやっと来たか",
   "en": "",
   "op": "0x62",
   "msg": "0x09e5"
  },
  {
   "id": "m_004001:0x12358",
   "off": 74584,
   "max": 28,
   "kind": "dialogue",
   "jp": "おお\\nセンセーにシンディ",
   "en": "",
   "op": "0x62",
   "msg": "0x09e6"
  },
  {
   "id": "m_004001:0x12880",
   "off": 75904,
   "max": 52,
   "kind": "dialogue",
   "jp": "テラーダの奥座敷で寛ぐ\\n桂と高杉に\\n龍馬が駆け寄る",
   "en": "",
   "op": "0x62",
   "msg": "0x09e7"
  },
  {
   "id": "m_004001:0x12ec8",
   "off": 77512,
   "max": 44,
   "kind": "dialogue",
   "jp": "二人とも無事だったか！\\n良かったぜよ～～",
   "en": "",
   "op": "0x62",
   "msg": "0x09e8"
  },
  {
   "id": "m_004001:0x13dcc",
   "off": 81356,
   "max": 60,
   "kind": "dialogue",
   "jp": "おいバカ　オレ様に\\n馴れ馴れしく抱きつくな\\n暑苦しいだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x09e9"
  },
  {
   "id": "m_004001:0x14520",
   "off": 83232,
   "max": 72,
   "kind": "dialogue",
   "jp": "晋作はいけずですねぇ\\n龍馬くんが私達との再会を\\n喜んでくれているのに",
   "en": "",
   "op": "0x62",
   "msg": "0x09ea"
  },
  {
   "id": "m_004001:0x14c60",
   "off": 85088,
   "max": 32,
   "kind": "dialogue",
   "jp": "オレ様は\\nちっとも嬉しくない",
   "en": "",
   "op": "0x62",
   "msg": "0x09eb"
  },
  {
   "id": "m_004001:0x15158",
   "off": 86360,
   "max": 72,
   "kind": "dialogue",
   "jp": "わしは大好きな二人と\\n無事会えて嬉しいぜよ！\\nセンセーの言った通りだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x09ec"
  },
  {
   "id": "m_004001:0x15830",
   "off": 88112,
   "max": 64,
   "kind": "dialogue",
   "jp": "龍馬はそう言うと\\n高杉と桂を抱き締める腕に\\nぎゅっと力を込める",
   "en": "",
   "op": "0x62",
   "msg": "0x09ed"
  },
  {
   "id": "m_004001:0x15880",
   "off": 88192,
   "max": 72,
   "kind": "dialogue",
   "jp": "そうして\\n再会を喜び合った後\\n話題は　ごく自然に\\n先ほどの雷舞に移った",
   "en": "",
   "op": "0x62",
   "msg": "0x09ee"
  },
  {
   "id": "m_004001:0x15d08",
   "off": 89352,
   "max": 32,
   "kind": "dialogue",
   "jp": "今日の雷舞も\\n盛り上がったなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x09ef"
  },
  {
   "id": "m_004001:0x15d38",
   "off": 89400,
   "max": 44,
   "kind": "dialogue",
   "jp": "この前よりも　大勢の\\nお客さんが来てたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x09f0"
  },
  {
   "id": "m_004001:0x163a8",
   "off": 91048,
   "max": 64,
   "kind": "dialogue",
   "jp": "本物の音楽を欲する心は\\nどんな法を作っても\\n縛れませんからね",
   "en": "",
   "op": "0x62",
   "msg": "0x09f1"
  },
  {
   "id": "m_004001:0x16494",
   "off": 91284,
   "max": 72,
   "kind": "dialogue",
   "jp": "私達が更に力を磨けば\\nより多くの民衆にロックを\\n届ける事ができるはず",
   "en": "",
   "op": "0x62",
   "msg": "0x09f2"
  },
  {
   "id": "m_004001:0x16a4c",
   "off": 92748,
   "max": 36,
   "kind": "dialogue",
   "jp": "くぅぅぅ～～っ\\n燃えてきた～～",
   "en": "",
   "op": "0x62",
   "msg": "0x09f3"
  },
  {
   "id": "m_004001:0x17200",
   "off": 94720,
   "max": 28,
   "kind": "dialogue",
   "jp": "フン\\n能天気に騒ぎやがって",
   "en": "",
   "op": "0x62",
   "msg": "0x09f4"
  },
  {
   "id": "m_004001:0x179f8",
   "off": 96760,
   "max": 12,
   "kind": "dialogue",
   "jp": "シンディ？",
   "en": "",
   "op": "0x62",
   "msg": "0x09f5"
  },
  {
   "id": "m_004001:0x17f1c",
   "off": 98076,
   "max": 48,
   "kind": "dialogue",
   "jp": "晋作は\\nさっきからずっと\\n難しい顔をしてますね",
   "en": "",
   "op": "0x62",
   "msg": "0x09f6"
  },
  {
   "id": "m_004001:0x17ff8",
   "off": 98296,
   "max": 44,
   "kind": "dialogue",
   "jp": "どうしたんですか\\n何か問題でもありますか？",
   "en": "",
   "op": "0x62",
   "msg": "0x09f7"
  },
  {
   "id": "m_004001:0x18918",
   "off": 100632,
   "max": 28,
   "kind": "dialogue",
   "jp": "どうしたもこうしたもない",
   "en": "",
   "op": "0x62",
   "msg": "0x09f8"
  },
  {
   "id": "m_004001:0x189e0",
   "off": 100832,
   "max": 48,
   "kind": "dialogue",
   "jp": "おい　龍馬　桂さん\\n今日の雷舞の段取りは何だ",
   "en": "",
   "op": "0x62",
   "msg": "0x09f9"
  },
  {
   "id": "m_004001:0x19134",
   "off": 102708,
   "max": 8,
   "kind": "dialogue",
   "jp": "ん？",
   "en": "",
   "op": "0x62",
   "msg": "0x09fa"
  },
  {
   "id": "m_004001:0x197d8",
   "off": 104408,
   "max": 64,
   "kind": "dialogue",
   "jp": "次の曲目に移る前に\\n何故　客に挨拶を入れた？\\n理由を聞かせろ\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x09fb"
  },
  {
   "id": "m_004001:0x19ff4",
   "off": 106484,
   "max": 76,
   "kind": "dialogue",
   "jp": "そりゃ　みんなに楽しんで\\n欲しいからに決まってる\\nセンセーもそう思うだろ？",
   "en": "",
   "op": "0x62",
   "msg": "0x09fc"
  },
  {
   "id": "m_004001:0x1a4bc",
   "off": 107708,
   "max": 12,
   "kind": "dialogue",
   "jp": "そうですね",
   "en": "",
   "op": "0x62",
   "msg": "0x09fd"
  },
  {
   "id": "m_004001:0x1a9e0",
   "off": 109024,
   "max": 56,
   "kind": "dialogue",
   "jp": "私達が声をかけると\\nみんな盛り上がって\\nくれますから",
   "en": "",
   "op": "0x62",
   "msg": "0x09fe"
  },
  {
   "id": "m_004001:0x1b1fc",
   "off": 111100,
   "max": 64,
   "kind": "dialogue",
   "jp": "オレ達は噺家じゃねぇ\\nロックをやってるんだ\\n挨拶なんて無用だ",
   "en": "",
   "op": "0x62",
   "msg": "0x09ff"
  },
  {
   "id": "m_004001:0x1b254",
   "off": 111188,
   "max": 64,
   "kind": "dialogue",
   "jp": "喋る暇があるなら\\n一曲でも多く歌うべきだ\\nそうすべきだったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a00"
  },
  {
   "id": "m_004001:0x1b8d8",
   "off": 112856,
   "max": 60,
   "kind": "dialogue",
   "jp": "晋作は\\nあの時に歌えなかったのを\\n余程悔やんでるようですね",
   "en": "",
   "op": "0x62",
   "msg": "0x0a01"
  },
  {
   "id": "m_004001:0x1bf24",
   "off": 114468,
   "max": 16,
   "kind": "dialogue",
   "jp": "ったりめーだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0a02"
  },
  {
   "id": "m_004001:0x1c3b8",
   "off": 115640,
   "max": 68,
   "kind": "dialogue",
   "jp": "今まで温めていた\\nとっておきの曲が　昨日\\nついに完成したんだからな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a03"
  },
  {
   "id": "m_004001:0x1c990",
   "off": 117136,
   "max": 56,
   "kind": "dialogue",
   "jp": "新曲が完成したとは\\nめでたいですね\\n晋作　おめでとう",
   "en": "",
   "op": "0x62",
   "msg": "0x0a04"
  },
  {
   "id": "m_004001:0x1cee0",
   "off": 118496,
   "max": 52,
   "kind": "dialogue",
   "jp": "フン\\n余計な挨拶さえ無きゃ\\n歌えてたのに腹立つぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a05"
  },
  {
   "id": "m_004001:0x1d5ac",
   "off": 120236,
   "max": 48,
   "kind": "dialogue",
   "jp": "ぬぅ……\\nシンディの気持ちは\\nよくわかる　でも",
   "en": "",
   "op": "0x62",
   "msg": "0x0a06"
  },
  {
   "id": "m_004001:0x1d684",
   "off": 120452,
   "max": 40,
   "kind": "dialogue",
   "jp": "あのタイミングで\\n挨拶を入れたのは……",
   "en": "",
   "op": "0x62",
   "msg": "0x0a07"
  },
  {
   "id": "m_004001:0x1d6bc",
   "off": 120508,
   "max": 56,
   "kind": "dialogue",
   "jp": "シンディの\\n息が上がってたっていう\\n理由もあるから……",
   "en": "",
   "op": "0x62",
   "msg": "0x0a08"
  },
  {
   "id": "m_004001:0x1dee4",
   "off": 122596,
   "max": 64,
   "kind": "dialogue",
   "jp": "てめーの見間違えだろう\\nオレ様が雷舞中に\\nへこたれるわけがねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a09"
  },
  {
   "id": "m_004001:0x1df3c",
   "off": 122684,
   "max": 52,
   "kind": "dialogue",
   "jp": "バカのくせに\\nオレ様の心配をするなんざ\\n百万年早い",
   "en": "",
   "op": "0x62",
   "msg": "0x0a0a"
  },
  {
   "id": "m_004001:0x1e608",
   "off": 124424,
   "max": 48,
   "kind": "dialogue",
   "jp": "わしとシンディは同志\\n同じ舞台に立つ仲間ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a0b"
  },
  {
   "id": "m_004001:0x1e648",
   "off": 124488,
   "max": 52,
   "kind": "dialogue",
   "jp": "大切な\\n仲間の心配をするのは\\n当たり前のことじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a0c"
  },
  {
   "id": "m_004001:0x1e724",
   "off": 124708,
   "max": 40,
   "kind": "dialogue",
   "jp": "それに\\nわしらは三人で雷舞を\\nやってる",
   "en": "",
   "op": "0x62",
   "msg": "0x0a0d"
  },
  {
   "id": "m_004001:0x1e75c",
   "off": 124764,
   "max": 64,
   "kind": "dialogue",
   "jp": "最高の雷舞にするために\\nお互いに力を合わせないと\\nいかんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a0e"
  },
  {
   "id": "m_004001:0x1f304",
   "off": 127748,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレは一人でもやれる\\nバカの心配も助けも無用だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a0f"
  },
  {
   "id": "m_004001:0x1f7b8",
   "off": 128952,
   "max": 24,
   "kind": "dialogue",
   "jp": "シンディ\\nそれは違う",
   "en": "",
   "op": "0x62",
   "msg": "0x0a10"
  },
  {
   "id": "m_004001:0x1fca8",
   "off": 130216,
   "max": 36,
   "kind": "dialogue",
   "jp": "バカの分際で\\nオレ様に意見する気か",
   "en": "",
   "op": "0x62",
   "msg": "0x0a11"
  },
  {
   "id": "m_004001:0x2035c",
   "off": 131932,
   "max": 56,
   "kind": "dialogue",
   "jp": "龍馬と高杉は\\n眼光鋭く睨み合い\\n互いの意見をぶつける",
   "en": "",
   "op": "0x62",
   "msg": "0x0a12"
  },
  {
   "id": "m_004001:0x203a4",
   "off": 132004,
   "max": 64,
   "kind": "dialogue",
   "jp": "そんな二人を見守る\\n桂のもとへ　どこからか\\n天狗がやって来た",
   "en": "",
   "op": "0x62",
   "msg": "0x0a13"
  },
  {
   "id": "m_004001:0x2083c",
   "off": 133180,
   "max": 12,
   "kind": "dialogue",
   "jp": "賑やかだな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a14"
  },
  {
   "id": "m_004001:0x20eec",
   "off": 134892,
   "max": 80,
   "kind": "dialogue",
   "jp": "三人が集まってるって事は\\n今日も突風雷舞\\n（ゲリラライブ）を\\nやってきたのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0a15"
  },
  {
   "id": "m_004001:0x20f4c",
   "off": 134988,
   "max": 60,
   "kind": "dialogue",
   "jp": "まったく　嵐山の一件で\\nお尋ね者になったのに\\nようやるわ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a16"
  },
  {
   "id": "m_004001:0x215cc",
   "off": 136652,
   "max": 36,
   "kind": "dialogue",
   "jp": "おかげで有名にも\\nなれましたしねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a17"
  },
  {
   "id": "m_004001:0x21c8c",
   "off": 138380,
   "max": 32,
   "kind": "dialogue",
   "jp": "幕府に目を\\nつけられたけどな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a18"
  },
  {
   "id": "m_004001:0x22348",
   "off": 140104,
   "max": 40,
   "kind": "dialogue",
   "jp": "音楽の自由を禁じる\\n幕府が許せませんし",
   "en": "",
   "op": "0x62",
   "msg": "0x0a19"
  },
  {
   "id": "m_004001:0x22380",
   "off": 140160,
   "max": 52,
   "kind": "dialogue",
   "jp": "私達の歌を\\n聴いてもらえるように\\nなったんですから",
   "en": "",
   "op": "0x62",
   "msg": "0x0a1a"
  },
  {
   "id": "m_004001:0x22ca8",
   "off": 142504,
   "max": 40,
   "kind": "dialogue",
   "jp": "歌いたいと思うのは\\n当然の事ですよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0a1b"
  },
  {
   "id": "m_004001:0x23530",
   "off": 144688,
   "max": 48,
   "kind": "dialogue",
   "jp": "いやいやいや\\nそりゃあ\\nとんでもない決意だろう",
   "en": "",
   "op": "0x62",
   "msg": "0x0a1c"
  },
  {
   "id": "m_004001:0x23570",
   "off": 144752,
   "max": 60,
   "kind": "dialogue",
   "jp": "このまま雷舞を続け\\nもしも幕府に捕まれば\\n命の保証はないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a1d"
  },
  {
   "id": "m_004001:0x23a28",
   "off": 145960,
   "max": 16,
   "kind": "dialogue",
   "jp": "怖くはないのか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a1e"
  },
  {
   "id": "m_004001:0x241c0",
   "off": 147904,
   "max": 64,
   "kind": "dialogue",
   "jp": "そうですね……\\n確かに　自分の身に不安を\\n感じる事はあります",
   "en": "",
   "op": "0x62",
   "msg": "0x0a1f"
  },
  {
   "id": "m_004001:0x24a10",
   "off": 150032,
   "max": 60,
   "kind": "dialogue",
   "jp": "ですがそんなものは\\n突風雷舞で味わう興奮と\\n喜びに比べたら",
   "en": "",
   "op": "0x62",
   "msg": "0x0a20"
  },
  {
   "id": "m_004001:0x24a5c",
   "off": 150108,
   "max": 20,
   "kind": "dialogue",
   "jp": "ちっぽけなものです",
   "en": "",
   "op": "0x62",
   "msg": "0x0a21"
  },
  {
   "id": "m_004001:0x25108",
   "off": 151816,
   "max": 56,
   "kind": "dialogue",
   "jp": "ロックを奏でる喜びは\\n死の恐怖に勝るという事か\\n面白い",
   "en": "",
   "op": "0x62",
   "msg": "0x0a22"
  },
  {
   "id": "m_004001:0x25150",
   "off": 151888,
   "max": 72,
   "kind": "dialogue",
   "jp": "龍馬や高杉に比べると\\n常識人だと思っていたが\\n桂も相当ぶっ飛んでいるな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a23"
  },
  {
   "id": "m_004001:0x251a8",
   "off": 151976,
   "max": 48,
   "kind": "dialogue",
   "jp": "おぬしらを見ていると\\n退屈しない　実に愉快だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a24"
  },
  {
   "id": "m_004001:0x258f4",
   "off": 153844,
   "max": 68,
   "kind": "dialogue",
   "jp": "これからも精進するといい\\nさすれば必ず道は開く\\nワシも手を貸そう",
   "en": "",
   "op": "0x62",
   "msg": "0x0a25"
  },
  {
   "id": "m_004001:0x25db4",
   "off": 155060,
   "max": 8,
   "kind": "dialogue",
   "jp": "ではな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a26"
  },
  {
   "id": "m_004001:0x2625c",
   "off": 156252,
   "max": 40,
   "kind": "dialogue",
   "jp": "ひらひらと手を振って\\n天狗が去ってゆく",
   "en": "",
   "op": "0x62",
   "msg": "0x0a27"
  },
  {
   "id": "m_004001:0x267e4",
   "off": 157668,
   "max": 60,
   "kind": "dialogue",
   "jp": "また会いましょう\\n……って　あの人\\n何しに来たんでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x0a28"
  },
  {
   "id": "m_004001:0x26dd8",
   "off": 159192,
   "max": 16,
   "kind": "dialogue",
   "jp": "まあ　良いか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a29"
  },
  {
   "id": "m_004001:0x27278",
   "off": 160376,
   "max": 44,
   "kind": "dialogue",
   "jp": "桂は彼を見送ると\\n龍馬と高杉に向き直った",
   "en": "",
   "op": "0x62",
   "msg": "0x0a2a"
  },
  {
   "id": "m_004001:0x276e8",
   "off": 161512,
   "max": 60,
   "kind": "dialogue",
   "jp": "さて……そろそろ\\n龍馬くんと晋作の仲裁に\\n入らないと……",
   "en": "",
   "op": "0x62",
   "msg": "0x0a2b"
  },
  {
   "id": "m_004001:0x277d8",
   "off": 161752,
   "max": 16,
   "kind": "dialogue",
   "jp": "……おやおや",
   "en": "",
   "op": "0x62",
   "msg": "0x0a2c"
  },
  {
   "id": "m_004001:0x277f8",
   "off": 161784,
   "max": 68,
   "kind": "dialogue",
   "jp": "私が少し目を離した隙に\\nまたずいぶん賑やかに\\nなってしまいましたね",
   "en": "",
   "op": "0x62",
   "msg": "0x0a2d"
  },
  {
   "id": "m_004001:0x278e8",
   "off": 162024,
   "max": 64,
   "kind": "dialogue",
   "jp": "この騒ぎを収めるには\\n骨が折れそうです\\nさあ　どうしましょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a2e"
  },
  {
   "id": "m_004001:0x27bd0",
   "off": 162768,
   "max": 20,
   "kind": "choice",
   "jp": "見なかった事にする",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_004001:0x27bf0",
   "off": 162800,
   "max": 20,
   "kind": "choice",
   "jp": "発明品で興味を引く",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_004001:0x27c10",
   "off": 162832,
   "max": 28,
   "kind": "choice",
   "jp": "歌をうたって場を和ませる",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_004001:0x28424",
   "off": 164900,
   "max": 48,
   "kind": "dialogue",
   "jp": "今仲裁に入っても\\n二人は私の言葉を\\n聞きません",
   "en": "",
   "op": "0x62",
   "msg": "0x0a2f"
  },
  {
   "id": "m_004001:0x28464",
   "off": 164964,
   "max": 32,
   "kind": "dialogue",
   "jp": "ここは諦めて\\n様子を見ましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x0a30"
  },
  {
   "id": "m_004001:0x28914",
   "off": 166164,
   "max": 44,
   "kind": "dialogue",
   "jp": "桂はしばらくの間\\n事態を静観することにした",
   "en": "",
   "op": "0x62",
   "msg": "0x0a31"
  },
  {
   "id": "m_004001:0x29144",
   "off": 168260,
   "max": 68,
   "kind": "dialogue",
   "jp": "閃きました　私の\\n素晴らしい発明品で二人の\\n興味を引きましょう！",
   "en": "",
   "op": "0x62",
   "msg": "0x0a32"
  },
  {
   "id": "m_004001:0x29618",
   "off": 169496,
   "max": 44,
   "kind": "dialogue",
   "jp": "桂は懐から手の平大の\\n金属片を取り出した",
   "en": "",
   "op": "0x62",
   "msg": "0x0a33"
  },
  {
   "id": "m_004001:0x29ae4",
   "off": 170724,
   "max": 36,
   "kind": "dialogue",
   "jp": "これは私が発明した\\n超スベールＸ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a34"
  },
  {
   "id": "m_004001:0x29bbc",
   "off": 170940,
   "max": 68,
   "kind": "dialogue",
   "jp": "これを使って鍋を作れば\\n油を引かなくても肉や魚が\\nくっつきませんっ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a35"
  },
  {
   "id": "m_004001:0x29c10",
   "off": 171024,
   "max": 52,
   "kind": "dialogue",
   "jp": "調理後のお手入れも超簡単\\n水だけで汚れが落ちます！",
   "en": "",
   "op": "0x62",
   "msg": "0x0a36"
  },
  {
   "id": "m_004001:0x2a0d4",
   "off": 172244,
   "max": 36,
   "kind": "dialogue",
   "jp": "桂は熱心に発明品の\\n説明をした",
   "en": "",
   "op": "0x62",
   "msg": "0x0a37"
  },
  {
   "id": "m_004001:0x2ab30",
   "off": 174896,
   "max": 56,
   "kind": "dialogue",
   "jp": "私の歌で　二人の心を\\n和ませましょう\\n烈　シンギング！",
   "en": "",
   "op": "0x62",
   "msg": "0x0a38"
  },
  {
   "id": "m_004001:0x2b31c",
   "off": 176924,
   "max": 56,
   "kind": "dialogue",
   "jp": "桂の癒声\\n（ヒーリングボイス）が\\nテラーダに響く\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0a39"
  },
  {
   "id": "m_004001:0x2b36c",
   "off": 177004,
   "max": 52,
   "kind": "dialogue",
   "jp": "しかし\\n龍馬と高杉の口喧嘩は\\n一向に収まらない！",
   "en": "",
   "op": "0x62",
   "msg": "0x0a3a"
  },
  {
   "id": "m_004001:0x2b7ec",
   "off": 178156,
   "max": 56,
   "kind": "dialogue",
   "jp": "はぁ　困りましたね\\n他に良い案は\\nないものでしょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a3b"
  },
  {
   "id": "m_004001:0x2bcb4",
   "off": 179380,
   "max": 56,
   "kind": "dialogue",
   "jp": "二人を見て考え込む桂\\nそんな彼のもとに\\nお登勢が現れた",
   "en": "",
   "op": "0x62",
   "msg": "0x0a3c"
  },
  {
   "id": "m_004001:0x2c3ac",
   "off": 181164,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍ちゃんも晋ちゃんも\\nギャーギャー五月蠅いよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a3d"
  },
  {
   "id": "m_004001:0x2c524",
   "off": 181540,
   "max": 48,
   "kind": "dialogue",
   "jp": "喧嘩はその辺にして\\n仲良くピッツァでも食べな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a3e"
  },
  {
   "id": "m_004001:0x2ca7c",
   "off": 182908,
   "max": 52,
   "kind": "dialogue",
   "jp": "お登勢は満面の笑みを浮かべ\\n超特大の皿を机に置いた",
   "en": "",
   "op": "0x62",
   "msg": "0x0a3f"
  },
  {
   "id": "m_004001:0x2d62c",
   "off": 185900,
   "max": 72,
   "kind": "dialogue",
   "jp": "こ　これは超特大ぴっつぁ！\\n出来立てのアツアツだっ\\n良い匂いがするぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a40"
  },
  {
   "id": "m_004001:0x2ddb0",
   "off": 187824,
   "max": 32,
   "kind": "dialogue",
   "jp": "……ゴクッ\\n美味そうじゃねーか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a41"
  },
  {
   "id": "m_004001:0x2e2ec",
   "off": 189164,
   "max": 52,
   "kind": "dialogue",
   "jp": "シンディ\\n雷舞の話は後回しだ\\n今はぴっつぁぜよ ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a42"
  },
  {
   "id": "m_004001:0x2e838",
   "off": 190520,
   "max": 60,
   "kind": "dialogue",
   "jp": "チッ　仕方ねェな\\nバカと話すより\\n黙って飯を食った方がいい",
   "en": "",
   "op": "0x62",
   "msg": "0x0a43"
  },
  {
   "id": "m_004001:0x2e8d8",
   "off": 190680,
   "max": 24,
   "kind": "dialogue",
   "jp": "はぐはぐはぐ\\nもぐもぐ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a44"
  },
  {
   "id": "m_004001:0x2ee58",
   "off": 192088,
   "max": 60,
   "kind": "dialogue",
   "jp": "はぐはぐはぐ\\nくぅーっ　雷舞の後の飯は\\nまた一段と美味い",
   "en": "",
   "op": "0x62",
   "msg": "0x0a45"
  },
  {
   "id": "m_004001:0x2f71c",
   "off": 194332,
   "max": 60,
   "kind": "dialogue",
   "jp": "……ほっ\\nあんなに騒がしかった\\n二人が　静かになりました",
   "en": "",
   "op": "0x62",
   "msg": "0x0a46"
  },
  {
   "id": "m_004001:0x2f768",
   "off": 194408,
   "max": 56,
   "kind": "dialogue",
   "jp": "お登勢さん\\nありがとうございます\\nおかげで助かりました",
   "en": "",
   "op": "0x62",
   "msg": "0x0a47"
  },
  {
   "id": "m_004001:0x2fde0",
   "off": 196064,
   "max": 40,
   "kind": "dialogue",
   "jp": "礼は要らないよ\\nこのくらいお安い御用さ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a48"
  },
  {
   "id": "m_004001:0x30320",
   "off": 197408,
   "max": 44,
   "kind": "dialogue",
   "jp": "それにしても二人とも\\n凄まじい食欲ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x0a49"
  },
  {
   "id": "m_004001:0x30510",
   "off": 197904,
   "max": 56,
   "kind": "dialogue",
   "jp": "超特大のピッツァが\\n恐ろしい勢いで\\n消えてゆきます……",
   "en": "",
   "op": "0x62",
   "msg": "0x0a4a"
  },
  {
   "id": "m_004001:0x30cd0",
   "off": 199888,
   "max": 68,
   "kind": "dialogue",
   "jp": "……あの　お登勢さん　\\nつかぬことを伺いますが\\nよろしいでしょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a4b"
  },
  {
   "id": "m_004001:0x311a4",
   "off": 201124,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬達がピッツァを頬張る中\\n桂はお登勢に耳打ちした",
   "en": "",
   "op": "0x62",
   "msg": "0x0a4c"
  },
  {
   "id": "m_004001:0x31618",
   "off": 202264,
   "max": 12,
   "kind": "dialogue",
   "jp": "何だい？",
   "en": "",
   "op": "0x62",
   "msg": "0x0a4d"
  },
  {
   "id": "m_004001:0x31c68",
   "off": 203880,
   "max": 60,
   "kind": "dialogue",
   "jp": "大食漢の龍馬くんを\\n住み込みで雇って\\n儲けは出るのですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0a4e"
  },
  {
   "id": "m_004001:0x32120",
   "off": 205088,
   "max": 56,
   "kind": "dialogue",
   "jp": "正直な話\\n龍ちゃんの食い扶持だけで\\n大赤字の大散財さ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a4f"
  },
  {
   "id": "m_004001:0x32168",
   "off": 205160,
   "max": 40,
   "kind": "dialogue",
   "jp": "だけどね　あの子は\\nいいや　あんた達は",
   "en": "",
   "op": "0x62",
   "msg": "0x0a50"
  },
  {
   "id": "m_004001:0x321a0",
   "off": 205216,
   "max": 36,
   "kind": "dialogue",
   "jp": "いずれでかい事を\\n成し遂げる男さ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a51"
  },
  {
   "id": "m_004001:0x32abc",
   "off": 207548,
   "max": 56,
   "kind": "dialogue",
   "jp": "それを支えるのが\\nアタシの役目かなって\\n思えてきたのさ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a52"
  },
  {
   "id": "m_004001:0x3321c",
   "off": 209436,
   "max": 52,
   "kind": "dialogue",
   "jp": "お登勢さん……\\n何から何まで\\nありがとうございます",
   "en": "",
   "op": "0x62",
   "msg": "0x0a53"
  },
  {
   "id": "m_004001:0x33260",
   "off": 209504,
   "max": 48,
   "kind": "dialogue",
   "jp": "その温かいお気持ちに\\nいつか報いたいものです",
   "en": "",
   "op": "0x62",
   "msg": "0x0a54"
  },
  {
   "id": "m_004001:0x338d0",
   "off": 211152,
   "max": 48,
   "kind": "dialogue",
   "jp": "じゃあ\\n龍ちゃんの代わりに\\nお代払ってくれる？",
   "en": "",
   "op": "0x62",
   "msg": "0x0a55"
  },
  {
   "id": "m_004001:0x33fac",
   "off": 212908,
   "max": 56,
   "kind": "dialogue",
   "jp": "さて　冷めないうちに\\n私もピッツァを\\n頂きましょうか！",
   "en": "",
   "op": "0x62",
   "msg": "0x0a56"
  },
  {
   "id": "m_004001:0x3478c",
   "off": 214924,
   "max": 36,
   "kind": "dialogue",
   "jp": "ああん　五郎ちゃん～\\nつれないわぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a57"
  },
  {
   "id": "m_004001:0x34fb8",
   "off": 217016,
   "max": 44,
   "kind": "dialogue",
   "jp": "テラーダの奥座敷に明るい\\n笑い声が響き渡る",
   "en": "",
   "op": "0x62",
   "msg": "0x0a58"
  },
  {
   "id": "m_004001:0x34ff4",
   "off": 217076,
   "max": 100,
   "kind": "dialogue",
   "jp": "龍馬　高杉　桂は\\n幕府に追われながらも\\n民衆の声援を受け\\n京の町にロックの輪を\\n広げてゆくのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x0a59"
  },
  {
   "id": "m_004001:0x355a0",
   "off": 218528,
   "max": 72,
   "kind": "dialogue",
   "jp": "……そして数日後\\n龍馬達の命懸けの行動は\\nついに\\n実を結ぼうとしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0a5a"
  },
  {
   "id": "m_004001:0x35b28",
   "off": 219944,
   "max": 8,
   "kind": "dialogue",
   "jp": "雷舞屋",
   "en": "",
   "op": "0x62",
   "msg": "0x0a5b"
  },
  {
   "id": "m_004001:0x36138",
   "off": 221496,
   "max": 80,
   "kind": "dialogue",
   "jp": "最高雷舞屋\\n（メジャーライブハウス）\\nで雷舞……だと？\\nテンちゃん　本当か？\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0a5c"
  },
  {
   "id": "m_004001:0x366a4",
   "off": 222884,
   "max": 52,
   "kind": "dialogue",
   "jp": "閑散とした雷舞屋で\\n龍馬　高杉　桂は\\n目を見開く",
   "en": "",
   "op": "0x62",
   "msg": "0x0a5d"
  },
  {
   "id": "m_004001:0x366e8",
   "off": 222952,
   "max": 44,
   "kind": "dialogue",
   "jp": "彼等の視線の先には\\n静かに頷く天狗がいた",
   "en": "",
   "op": "0x62",
   "msg": "0x0a5e"
  },
  {
   "id": "m_004001:0x36b54",
   "off": 224084,
   "max": 60,
   "kind": "dialogue",
   "jp": "本当も　本当だ\\n信じられないのなら\\nイチから説明してやろう",
   "en": "",
   "op": "0x62",
   "msg": "0x0a5f"
  },
  {
   "id": "m_004001:0x36ba0",
   "off": 224160,
   "max": 76,
   "kind": "dialogue",
   "jp": "おぬしらの人気は鰻登り\\nもはや小さな雷舞屋では\\n大勢の贔屓を収めきれない\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0a60"
  },
  {
   "id": "m_004001:0x37288",
   "off": 225928,
   "max": 64,
   "kind": "dialogue",
   "jp": "え　ええ　仰る通りです\\n最近の突風雷舞は常に\\n満員御礼の大盛況",
   "en": "",
   "op": "0x62",
   "msg": "0x0a61"
  },
  {
   "id": "m_004001:0x372d8",
   "off": 226008,
   "max": 56,
   "kind": "dialogue",
   "jp": "私達の歌声に\\n気づくのが遅れた聴衆は\\n箱に入れません",
   "en": "",
   "op": "0x62",
   "msg": "0x0a62"
  },
  {
   "id": "m_004001:0x37954",
   "off": 227668,
   "max": 76,
   "kind": "dialogue",
   "jp": "いや　入れないどころか\\n人だかりのせいで　箱にすら\\n簡単に近づけないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x0a63"
  },
  {
   "id": "m_004001:0x379b0",
   "off": 227760,
   "max": 52,
   "kind": "dialogue",
   "jp": "箱に入る事が出来た奴らも\\n押すな押すなの鮨詰め状態",
   "en": "",
   "op": "0x62",
   "msg": "0x0a64"
  },
  {
   "id": "m_004001:0x379f4",
   "off": 227828,
   "max": 60,
   "kind": "dialogue",
   "jp": "もっと大きな箱で雷舞をと\\n贔屓の奴らに\\n何度も言われている",
   "en": "",
   "op": "0x62",
   "msg": "0x0a65"
  },
  {
   "id": "m_004001:0x381b4",
   "off": 229812,
   "max": 72,
   "kind": "dialogue",
   "jp": "その話はワシの耳にも\\n入っている　……しかし\\nおぬしらは幕府のお尋ね者",
   "en": "",
   "op": "0x62",
   "msg": "0x0a66"
  },
  {
   "id": "m_004001:0x3820c",
   "off": 229900,
   "max": 52,
   "kind": "dialogue",
   "jp": "最高雷舞屋に出ようとしても\\n箱を使えるとは思えない",
   "en": "",
   "op": "0x62",
   "msg": "0x0a67"
  },
  {
   "id": "m_004001:0x38258",
   "off": 229976,
   "max": 68,
   "kind": "dialogue",
   "jp": "だから　ワシが押さえた\\nどうだ　でかい箱で\\n思う存分暴れてみないか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a68"
  },
  {
   "id": "m_004001:0x38c08",
   "off": 232456,
   "max": 36,
   "kind": "dialogue",
   "jp": "みるみるみる\\nやるやるやるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a69"
  },
  {
   "id": "m_004001:0x395bc",
   "off": 234940,
   "max": 88,
   "kind": "dialogue",
   "jp": "最高雷舞屋か　上等だ\\n天歌でガチガチに固まった\\n民衆の心（ハート）を\\nぶち壊してやる",
   "en": "",
   "op": "0x62",
   "msg": "0x0a6a"
  },
  {
   "id": "m_004001:0x39d24",
   "off": 236836,
   "max": 68,
   "kind": "dialogue",
   "jp": "私も二人と同じ気持ちです\\n天狗さんの提案に\\n二つ返事で乗りますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a6b"
  },
  {
   "id": "m_004001:0x3a284",
   "off": 238212,
   "max": 72,
   "kind": "dialogue",
   "jp": "三人は天狗の誘いに即答した\\n音楽性の違いから頻繁に\\n衝突していようとも",
   "en": "",
   "op": "0x62",
   "msg": "0x0a6c"
  },
  {
   "id": "m_004001:0x3a2dc",
   "off": 238300,
   "max": 60,
   "kind": "dialogue",
   "jp": "ここぞという場面では\\n彼等の意見はぴったりと\\n一致するのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0d08"
  },
  {
   "id": "m_004001:0x3a75c",
   "off": 239452,
   "max": 56,
   "kind": "dialogue",
   "jp": "それにしても　天狗さん\\nどういう風の吹き回し\\nですか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a6d"
  },
  {
   "id": "m_004001:0x3a7a4",
   "off": 239524,
   "max": 72,
   "kind": "dialogue",
   "jp": "貴方はいつも　私達を\\n傍観してるだけだったのに\\n雷舞屋を手配するなんて",
   "en": "",
   "op": "0x62",
   "msg": "0x0a6e"
  },
  {
   "id": "m_004001:0x3ae2c",
   "off": 241196,
   "max": 60,
   "kind": "dialogue",
   "jp": "本物のロックは\\n人の心だけではなく\\n天狗の重い腰をも動かす",
   "en": "",
   "op": "0x62",
   "msg": "0x0a6f"
  },
  {
   "id": "m_004001:0x3ae78",
   "off": 241272,
   "max": 20,
   "kind": "dialogue",
   "jp": "ただそれだけの事だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a70"
  },
  {
   "id": "m_004001:0x3b3a4",
   "off": 242596,
   "max": 44,
   "kind": "dialogue",
   "jp": "はぁ……\\nわかるような\\nわからないような",
   "en": "",
   "op": "0x62",
   "msg": "0x0a71"
  },
  {
   "id": "m_004001:0x3bb58",
   "off": 244568,
   "max": 64,
   "kind": "dialogue",
   "jp": "オレ様の歌の素晴らしさに\\nようやく天狗も\\n気づいたって事だろう",
   "en": "",
   "op": "0x62",
   "msg": "0x0a72"
  },
  {
   "id": "m_004001:0x3c1d8",
   "off": 246232,
   "max": 48,
   "kind": "dialogue",
   "jp": "シンディ　そこは\\nオレ様達って言う\\nところぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a73"
  },
  {
   "id": "m_004001:0x3c684",
   "off": 247428,
   "max": 12,
   "kind": "dialogue",
   "jp": "うるせぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a74"
  },
  {
   "id": "m_004001:0x3cc7c",
   "off": 248956,
   "max": 56,
   "kind": "dialogue",
   "jp": "それで　テンちゃん\\nもっと詳しい話が\\n聞きたいぜよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x0a75"
  },
  {
   "id": "m_004001:0x3ccc4",
   "off": 249028,
   "max": 52,
   "kind": "dialogue",
   "jp": "テンちゃんが\\n押さえたっていう\\n雷舞屋はどこじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0a76"
  },
  {
   "id": "m_004001:0x3d390",
   "off": 250768,
   "max": 48,
   "kind": "dialogue",
   "jp": "この店を出た先にある\\n雷舞屋の名は\\nイケダヤン",
   "en": "",
   "op": "0x62",
   "msg": "0x0a77"
  },
  {
   "id": "m_004001:0x3e080",
   "off": 254080,
   "max": 44,
   "kind": "dialogue",
   "jp": "なっ\\nイケダヤンですか？\\nそれはまた……",
   "en": "",
   "op": "0x62",
   "msg": "0x0a78"
  },
  {
   "id": "m_004001:0x3e530",
   "off": 255280,
   "max": 12,
   "kind": "dialogue",
   "jp": "マジかよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a79"
  },
  {
   "id": "m_004001:0x3edb8",
   "off": 257464,
   "max": 72,
   "kind": "dialogue",
   "jp": "ふむ　流石におぬしらも\\nイケダヤンの名を聞いて\\n怖気づいているようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a7a"
  },
  {
   "id": "m_004001:0x3f794",
   "off": 259988,
   "max": 24,
   "kind": "dialogue",
   "jp": "いえ\\nそんな事は……",
   "en": "",
   "op": "0x62",
   "msg": "0x0a7b"
  },
  {
   "id": "m_004001:0x3fddc",
   "off": 261596,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレ様が\\n怖じ気づくなんぞ\\nありえねぇが……",
   "en": "",
   "op": "0x62",
   "msg": "0x0a7c"
  },
  {
   "id": "m_004001:0x406a4",
   "off": 263844,
   "max": 40,
   "kind": "dialogue",
   "jp": "センセー　シンディ\\nどうしたんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0a7d"
  },
  {
   "id": "m_004001:0x40db0",
   "off": 265648,
   "max": 76,
   "kind": "dialogue",
   "jp": "お前こそ何で首傾げてんだ\\nまさかお前　知らないのか\\nあの『イケダヤン』を",
   "en": "",
   "op": "0x62",
   "msg": "0x0a7e"
  },
  {
   "id": "m_004001:0x414c4",
   "off": 267460,
   "max": 40,
   "kind": "dialogue",
   "jp": "え～と……センセーは\\n知ってるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0a7f"
  },
  {
   "id": "m_004001:0x41898",
   "off": 268440,
   "max": 28,
   "kind": "dialogue",
   "jp": "龍馬は桂に\\n助けを求める",
   "en": "",
   "op": "0x62",
   "msg": "0x0a80"
  },
  {
   "id": "m_004001:0x41de8",
   "off": 269800,
   "max": 52,
   "kind": "dialogue",
   "jp": "イケダヤンは　京の中で\\n人気のある雷舞屋のひとつ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a81"
  },
  {
   "id": "m_004001:0x41e2c",
   "off": 269868,
   "max": 64,
   "kind": "dialogue",
   "jp": "とても大きな施設で\\n嵐山の雷舞屋と同等の\\n聴衆を収容できます",
   "en": "",
   "op": "0x62",
   "msg": "0x0a82"
  },
  {
   "id": "m_004001:0x42590",
   "off": 271760,
   "max": 68,
   "kind": "dialogue",
   "jp": "何だとぉぉ　という事は\\n新選組の公開雷舞くらい\\n人を呼べるのか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a83"
  },
  {
   "id": "m_004001:0x42aec",
   "off": 273132,
   "max": 24,
   "kind": "dialogue",
   "jp": "ええ\\nそうなりますね",
   "en": "",
   "op": "0x62",
   "msg": "0x0a84"
  },
  {
   "id": "m_004001:0x43018",
   "off": 274456,
   "max": 44,
   "kind": "dialogue",
   "jp": "はぁぁ～～　驚いた\\n息が一瞬止まったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a85"
  },
  {
   "id": "m_004001:0x436e0",
   "off": 276192,
   "max": 56,
   "kind": "dialogue",
   "jp": "イケダヤンを\\n知らなかったとは\\nやっぱりバカはバカだな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a86"
  },
  {
   "id": "m_004001:0x43c34",
   "off": 277556,
   "max": 44,
   "kind": "dialogue",
   "jp": "うっ　と　とにかく\\nテンちゃんに感謝ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0a87"
  },
  {
   "id": "m_004001:0x43d08",
   "off": 277768,
   "max": 48,
   "kind": "dialogue",
   "jp": "すごいとこ押さえてくれて\\n本当にありがとう！",
   "en": "",
   "op": "0x62",
   "msg": "0x0a88"
  },
  {
   "id": "m_004001:0x443d4",
   "off": 279508,
   "max": 44,
   "kind": "dialogue",
   "jp": "私も改めて感謝します\\nありがとうございます",
   "en": "",
   "op": "0x62",
   "msg": "0x0a89"
  },
  {
   "id": "m_004001:0x44918",
   "off": 280856,
   "max": 52,
   "kind": "dialogue",
   "jp": "雷舞屋イケダヤン\\nオレ様に相応しい舞台だ\\n悪くない",
   "en": "",
   "op": "0x62",
   "msg": "0x0a8a"
  },
  {
   "id": "m_004001:0x4512c",
   "off": 282924,
   "max": 36,
   "kind": "dialogue",
   "jp": "おぬしらの舞台\\n期待しているぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a8b"
  },
  {
   "id": "m_004001:0x455f8",
   "off": 284152,
   "max": 48,
   "kind": "dialogue",
   "jp": "天狗は龍馬達としばらく\\n話をした後　姿を消した",
   "en": "",
   "op": "0x62",
   "msg": "0x0a8c"
  },
  {
   "id": "m_004001:0x45ce4",
   "off": 285924,
   "max": 56,
   "kind": "dialogue",
   "jp": "うぉぉぉぉ\\nついに最高雷舞屋か\\n燃えてきたぁあああ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a8d"
  },
  {
   "id": "m_004001:0x45dc4",
   "off": 286148,
   "max": 84,
   "kind": "dialogue",
   "jp": "シンディ　センセー\\n早速イケダヤンの雷舞に\\n向けて稽古（リハーサル）を\\nするぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0a8e"
  },
  {
   "id": "m_004001:0x46888",
   "off": 288904,
   "max": 64,
   "kind": "dialogue",
   "jp": "言われなくてもわかってる\\n二人とも　今日は夜通し\\n付き合えよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a8f"
  },
  {
   "id": "m_004001:0x46f6c",
   "off": 290668,
   "max": 60,
   "kind": "dialogue",
   "jp": "望むところです\\n二人が例え音を上げても\\n私は止めませんよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a90"
  },
  {
   "id": "m_004001:0x47538",
   "off": 292152,
   "max": 68,
   "kind": "dialogue",
   "jp": "龍馬達は大きく頷き合い\\n稽古場（スタジオ）へと\\n大股で歩いてゆく",
   "en": "",
   "op": "0x62",
   "msg": "0x0a91"
  },
  {
   "id": "m_004001:0x4758c",
   "off": 292236,
   "max": 68,
   "kind": "dialogue",
   "jp": "こうして三人は\\n来るイケダヤン雷舞に向けて\\n猛練習を始めたのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x0bdd"
  }
 ]
}
