   "id": "m_004002:0x335c0",
   "off": 210368,
   "max": 20,
   "kind": "choice",
   "jp": "新選組と戦うため",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_004002:0x335e0",
   "off": 210400,
   "max": 20,
   "kind": "choice",
   "jp": "龍馬を助けるため",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_004002:0x33f2c",
   "off": 212780,
   "max": 36,
   "kind": "dialogue",
   "jp": "単なる気まぐれだ\\n理由なんてねぇよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b1f"
  },
