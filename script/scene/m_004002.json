   "op": "0x62",
   "msg": "0x0b20"
  },
  {
   "id": "m_004002:0x34980",
   "off": 215424,
   "max": 44,
   "kind": "dialogue",
   "jp": "……で　その後は\\nバカを囮にして逃げろと？",
   "en": "",
   "op": "0x62",
   "msg": "0x0b21"
