   "id": "m_004002:0x359fc",
   "off": 219644,
   "max": 48,
   "kind": "dialogue",
   "jp": "シンディはセンセーと\\n一緒に舞台へ戻るぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b24"
  },
  {
   "id": "m_004002:0x35ea8",
