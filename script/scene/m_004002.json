{
 "source": "m_004002.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_004002:0x12b8",
   "off": 4792,
   "max": 60,
   "kind": "dialogue",
   "jp": "数日後\\n二条城の天守閣には\\n重苦しいため息が\\n響いていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0a92"
  },
  {
   "id": "m_004002:0x1b98",
   "off": 7064,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0a93"
  },
  {
   "id": "m_004002:0x22c4",
   "off": 8900,
   "max": 52,
   "kind": "dialogue",
   "jp": "慶喜様　いかがなさいました\\n具合でも悪いのですか",
   "en": "",
   "op": "0x62",
   "msg": "0x0a94"
  },
  {
   "id": "m_004002:0x293c",
   "off": 10556,
   "max": 44,
   "kind": "dialogue",
   "jp": "身体の調子は問題ない\\n気分が良くないだけ",
   "en": "",
   "op": "0x62",
   "msg": "0x0a95"
  },
  {
   "id": "m_004002:0x2978",
   "off": 10616,
   "max": 44,
   "kind": "dialogue",
   "jp": "今日の昼　直弼も家臣から\\n報告を受けたよね",
   "en": "",
   "op": "0x62",
   "msg": "0x0a96"
  },
  {
   "id": "m_004002:0x33fc",
   "off": 13308,
   "max": 60,
   "kind": "dialogue",
   "jp": "坂本龍馬と\\nその仲間達の傍若無人な\\n振る舞いについて……",
   "en": "",
   "op": "0x62",
   "msg": "0x0a97"
  },
  {
   "id": "m_004002:0x3d18",
   "off": 15640,
   "max": 76,
   "kind": "dialogue",
   "jp": "ええ　存じていますよ\\n奴らが突風雷舞を繰り返し　\\n民衆を惑わせている事は",
   "en": "",
   "op": "0x62",
   "msg": "0x0a98"
  },
  {
   "id": "m_004002:0x41e0",
   "off": 16864,
   "max": 48,
   "kind": "dialogue",
   "jp": "坂本達の贔屓は\\n日に日に増えている\\nそうだね",
   "en": "",
   "op": "0x62",
   "msg": "0x0a99"
  },
  {
   "id": "m_004002:0x4220",
   "off": 16928,
   "max": 72,
   "kind": "dialogue",
   "jp": "このまま奴らのロックが\\n民の間で流行り病のように\\n広まったりしないかな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a9a"
  },
  {
   "id": "m_004002:0x4cc0",
   "off": 19648,
   "max": 72,
   "kind": "dialogue",
   "jp": "大丈夫です　慶喜様の\\n天下が揺らぐなどあり得ない\\n決して　絶対にです",
   "en": "",
   "op": "0x62",
   "msg": "0x0a9b"
  },
  {
   "id": "m_004002:0x55e8",
   "off": 21992,
   "max": 12,
   "kind": "dialogue",
   "jp": "そうかな",
   "en": "",
   "op": "0x62",
   "msg": "0x0a9c"
  },
  {
   "id": "m_004002:0x5604",
   "off": 22020,
   "max": 52,
   "kind": "dialogue",
   "jp": "噂によると　奴らは明日　\\nイケダヤンで歌うらしいね",
   "en": "",
   "op": "0x62",
   "msg": "0x0a9d"
  },
  {
   "id": "m_004002:0x5648",
   "off": 22088,
   "max": 40,
   "kind": "dialogue",
   "jp": "あの広い会場で歌う\\nということは……",
   "en": "",
   "op": "0x62",
   "msg": "0x0a9e"
  },
  {
   "id": "m_004002:0x5680",
   "off": 22144,
   "max": 60,
   "kind": "dialogue",
   "jp": "奴らに　それなりの数の\\n贔屓がついてる証拠だと\\n思うけど？",
   "en": "",
   "op": "0x62",
   "msg": "0x0a9f"
  },
  {
   "id": "m_004002:0x5b38",
   "off": 23352,
   "max": 52,
   "kind": "dialogue",
   "jp": "慶喜様は\\nそのような事を\\n考える必要はありません",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa0"
  },
  {
   "id": "m_004002:0x5fe8",
   "off": 24552,
   "max": 20,
   "kind": "dialogue",
   "jp": "でも　気になるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa1"
  },
  {
   "id": "m_004002:0x68f0",
   "off": 26864,
   "max": 40,
   "kind": "dialogue",
   "jp": "ならば　慶喜様の\\n御心痛を和らげるため",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa2"
  },
  {
   "id": "m_004002:0x69c4",
   "off": 27076,
   "max": 44,
   "kind": "dialogue",
   "jp": "明日　沖田をイケダヤンに\\n差し向けましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa3"
  },
  {
   "id": "m_004002:0x6a9c",
   "off": 27292,
   "max": 68,
   "kind": "dialogue",
   "jp": "噂話が真実だった場合\\n反幕府の者達を新選組の\\n歌で引き戻すのです",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa4"
  },
  {
   "id": "m_004002:0x6b8c",
   "off": 27532,
   "max": 52,
   "kind": "dialogue",
   "jp": "嵐山の逆となりましょうぞ\\n慶喜様　いかがでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa5"
  },
  {
   "id": "m_004002:0x72e0",
   "off": 29408,
   "max": 52,
   "kind": "dialogue",
   "jp": "うん　それが良い\\n直弼　頼んだよ\\n期待してるからね",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa6"
  },
  {
   "id": "m_004002:0x7958",
   "off": 31064,
   "max": 36,
   "kind": "dialogue",
   "jp": "勿体ない御言葉　\\n有り難く存じます",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa7"
  },
  {
   "id": "m_004002:0x798c",
   "off": 31116,
   "max": 68,
   "kind": "dialogue",
   "jp": "私は慶喜様を一人になど\\n断じてしませんよ\\n例えどんな手を使っても",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa8"
  },
  {
   "id": "m_004002:0x7f4c",
   "off": 32588,
   "max": 72,
   "kind": "dialogue",
   "jp": "慶喜を優しくなだめ\\n井伊は\\n龍馬達とは関係のない\\n他愛無い話を始める",
   "en": "",
   "op": "0x62",
   "msg": "0x0aa9"
  },
  {
   "id": "m_004002:0x7fa4",
   "off": 32676,
   "max": 64,
   "kind": "dialogue",
   "jp": "蝋燭に照らし出された\\n怜悧な顔には　\\n冷たい微笑が浮かんでいた",
   "en": "",
   "op": "0x62",
   "msg": "0x0aaa"
  },
  {
   "id": "m_004002:0x8550",
   "off": 34128,
   "max": 72,
   "kind": "dialogue",
   "jp": "……その頃\\n静まり返った\\n舞台（ステージ）の上を\\n龍馬は一人歩いていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0aab"
  },
  {
   "id": "m_004002:0x89d8",
   "off": 35288,
   "max": 68,
   "kind": "dialogue",
   "jp": "ここがイケダヤンの舞台か\\n稽古の時に上がったが\\nやっぱり広いなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x0aac"
  },
  {
   "id": "m_004002:0x8a2c",
   "off": 35372,
   "max": 40,
   "kind": "dialogue",
   "jp": "今は真夜中\\nここには\\nわししか居ない",
   "en": "",
   "op": "0x62",
   "msg": "0x0aad"
  },
  {
   "id": "m_004002:0x90ec",
   "off": 37100,
   "max": 64,
   "kind": "dialogue",
   "jp": "だけど明日になれば\\n数え切れないくらい\\n大勢の人が来てくれる",
   "en": "",
   "op": "0x62",
   "msg": "0x0aae"
  },
  {
   "id": "m_004002:0x913c",
   "off": 37180,
   "max": 60,
   "kind": "dialogue",
   "jp": "今は何も聞こえないけど\\n明日にはわしらのロックが\\n聞こえる",
   "en": "",
   "op": "0x62",
   "msg": "0x0aaf"
  },
  {
   "id": "m_004002:0x9188",
   "off": 37256,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしらのロックに合わせて\\nみんなが叫ぶ声が聞こえる",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab0"
  },
  {
   "id": "m_004002:0x9a1c",
   "off": 39452,
   "max": 48,
   "kind": "dialogue",
   "jp": "くぅぅぅ　考えただけで\\n熱くなってきたぜよ ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab1"
  },
  {
   "id": "m_004002:0x9a5c",
   "off": 39516,
   "max": 64,
   "kind": "dialogue",
   "jp": "身体中がジンジンして\\n眠れないっ 早く明日に\\nならないかなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab2"
  },
  {
   "id": "m_004002:0x9fb0",
   "off": 40880,
   "max": 40,
   "kind": "dialogue",
   "jp": "龍馬は長いため息を吐き\\n遠くを見つめる",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab3"
  },
  {
   "id": "m_004002:0x9fe8",
   "off": 40936,
   "max": 12,
   "kind": "dialogue",
   "jp": "そんな中",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab4"
  },
  {
   "id": "m_004002:0xa00c",
   "off": 40972,
   "max": 48,
   "kind": "dialogue",
   "jp": "入口の扉がゆっくり開き\\n長身の人影が入ってきた",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab5"
  },
  {
   "id": "m_004002:0xa480",
   "off": 42112,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab6"
  },
  {
   "id": "m_004002:0xab24",
   "off": 43812,
   "max": 36,
   "kind": "dialogue",
   "jp": "おお　シンディ\\nおんしも来たのか",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab7"
  },
  {
   "id": "m_004002:0xb1e4",
   "off": 45540,
   "max": 12,
   "kind": "dialogue",
   "jp": "……龍馬？",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab8"
  },
  {
   "id": "m_004002:0xb680",
   "off": 46720,
   "max": 72,
   "kind": "dialogue",
   "jp": "龍馬が舞台の上で手を振ると\\n高杉は彼を睨みつけながら\\n同じ場所に立った",
   "en": "",
   "op": "0x62",
   "msg": "0x0ab9"
  },
  {
   "id": "m_004002:0xbb0c",
   "off": 47884,
   "max": 48,
   "kind": "dialogue",
   "jp": "そこをどけ\\n舞台のド真ん中は\\nオレ様の場所だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0aba"
  },
  {
   "id": "m_004002:0xc17c",
   "off": 49532,
   "max": 48,
   "kind": "dialogue",
   "jp": "おっ　シンディ\\n今から何か歌ってくれる\\nのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0abb"
  },
  {
   "id": "m_004002:0xc6c4",
   "off": 50884,
   "max": 64,
   "kind": "dialogue",
   "jp": "はっ　大一番の前日に\\nバカ一人のためだけに\\n歌うわけないだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x0abc"
  },
  {
   "id": "m_004002:0xcc18",
   "off": 52248,
   "max": 40,
   "kind": "dialogue",
   "jp": "それならシンディは　\\n何しに来たんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0abd"
  },
  {
   "id": "m_004002:0xd158",
   "off": 53592,
   "max": 16,
   "kind": "dialogue",
   "jp": "明日の下見だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0abe"
  },
  {
   "id": "m_004002:0xd67c",
   "off": 54908,
   "max": 36,
   "kind": "dialogue",
   "jp": "おお　という事は\\nわしと同じか！",
   "en": "",
   "op": "0x62",
   "msg": "0x0abf"
  },
  {
   "id": "m_004002:0xdcac",
   "off": 56492,
   "max": 68,
   "kind": "dialogue",
   "jp": "バカと一緒にするな\\nお前はただ舞台の上に\\n突っ立ってただけだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac0"
  },
  {
   "id": "m_004002:0xe174",
   "off": 57716,
   "max": 20,
   "kind": "dialogue",
   "jp": "ほら　そこを退け",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac1"
  },
  {
   "id": "m_004002:0xe704",
   "off": 59140,
   "max": 72,
   "kind": "dialogue",
   "jp": "高杉は龍馬を押しのけると\\n舞台の中央に色付きの\\nテープを貼りはじめた",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac2"
  },
  {
   "id": "m_004002:0xeb94",
   "off": 60308,
   "max": 60,
   "kind": "dialogue",
   "jp": "ほー　立ち位置に\\n印をつけているのか\\n流石シンディだなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac3"
  },
  {
   "id": "m_004002:0xec78",
   "off": 60536,
   "max": 48,
   "kind": "dialogue",
   "jp": "……あ　そう言えば\\nシンディに話が\\nあったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac4"
  },
  {
   "id": "m_004002:0xecb8",
   "off": 60600,
   "max": 48,
   "kind": "dialogue",
   "jp": "明日の雷舞の曲順を\\n決めておかなくちゃ\\nならん",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac5"
  },
  {
   "id": "m_004002:0xf32c",
   "off": 62252,
   "max": 56,
   "kind": "dialogue",
   "jp": "オレ様に聞くな\\nそういうのは　全て\\n桂さんに任せてある",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac6"
  },
  {
   "id": "m_004002:0xf878",
   "off": 63608,
   "max": 36,
   "kind": "dialogue",
   "jp": "もう　センセーとも\\n話し合ったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac7"
  },
  {
   "id": "m_004002:0xf8ac",
   "off": 63660,
   "max": 28,
   "kind": "dialogue",
   "jp": "大体の曲順も\\n決まってる",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac8"
  },
  {
   "id": "m_004002:0xf970",
   "off": 63856,
   "max": 32,
   "kind": "dialogue",
   "jp": "そこで\\n相談があるんだが――",
   "en": "",
   "op": "0x62",
   "msg": "0x0ac9"
  },
  {
   "id": "m_004002:0xfea8",
   "off": 65192,
   "max": 28,
   "kind": "dialogue",
   "jp": "相談？\\n言うだけ言ってみろ",
   "en": "",
   "op": "0x62",
   "msg": "0x0aca"
  },
  {
   "id": "m_004002:0x107bc",
   "off": 67516,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしが　一番手で\\n歌いたいぜよ ",
   "en": "",
   "op": "0x62",
   "msg": "0x0acb"
  },
  {
   "id": "m_004002:0x11040",
   "off": 69696,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x0acc"
  },
  {
   "id": "m_004002:0x11560",
   "off": 71008,
   "max": 68,
   "kind": "dialogue",
   "jp": "いや　シンディが\\n一番手を　譲りたくない\\n気持ちも　よくわかる！",
   "en": "",
   "op": "0x62",
   "msg": "0x0acd"
  },
  {
   "id": "m_004002:0x1164c",
   "off": 71244,
   "max": 44,
   "kind": "dialogue",
   "jp": "けど　この舞台を見たら\\nもうガマンできん！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ace"
  },
  {
   "id": "m_004002:0x11688",
   "off": 71304,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしは　一秒でも早く\\nみんなの前で\\n歌いたいんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0acf"
  },
  {
   "id": "m_004002:0x12008",
   "off": 73736,
   "max": 48,
   "kind": "dialogue",
   "jp": "頼む！　どうか\\nわしに一番手を\\n譲ってくれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad0"
  },
  {
   "id": "m_004002:0x128a0",
   "off": 75936,
   "max": 8,
   "kind": "dialogue",
   "jp": "いいぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad1"
  },
  {
   "id": "m_004002:0x12efc",
   "off": 77564,
   "max": 32,
   "kind": "dialogue",
   "jp": "そうか\\nやっぱり　ダメか……",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad2"
  },
  {
   "id": "m_004002:0x13798",
   "off": 79768,
   "max": 56,
   "kind": "dialogue",
   "jp": "話を聞け！\\nお前が一番手でいいと\\nオレ様は言ったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc4"
  },
  {
   "id": "m_004002:0x13fd4",
   "off": 81876,
   "max": 60,
   "kind": "dialogue",
   "jp": "へ？　いいのか\\nわしが一番最初に\\n歌っても　いいのか",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc5"
  },
  {
   "id": "m_004002:0x149d0",
   "off": 84432,
   "max": 36,
   "kind": "dialogue",
   "jp": "しつこいな！\\nいいと言ってるだろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc6"
  },
  {
   "id": "m_004002:0x15144",
   "off": 86340,
   "max": 60,
   "kind": "dialogue",
   "jp": "ありがとう　シンディ！\\nお前さんは　本当に\\nイイヤツだ ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc7"
  },
  {
   "id": "m_004002:0x1577c",
   "off": 87932,
   "max": 40,
   "kind": "dialogue",
   "jp": "おいっ！　よせ！\\n抱きつくんじゃねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc8"
  },
  {
   "id": "m_004002:0x160ac",
   "off": 90284,
   "max": 60,
   "kind": "dialogue",
   "jp": "ただし　代わりに最後の\\n曲は　オレ様に決めさせて\\nもらうぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc9"
  },
  {
   "id": "m_004002:0x160f8",
   "off": 90360,
   "max": 12,
   "kind": "dialogue",
   "jp": "いいな？",
   "en": "",
   "op": "0x62",
   "msg": "0x0bca"
  },
  {
   "id": "m_004002:0x16964",
   "off": 92516,
   "max": 12,
   "kind": "dialogue",
   "jp": "最後の曲？",
   "en": "",
   "op": "0x62",
   "msg": "0x0bcb"
  },
  {
   "id": "m_004002:0x16dec",
   "off": 93676,
   "max": 16,
   "kind": "dialogue",
   "jp": "ああ\\nそうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bcc"
  },
  {
   "id": "m_004002:0x176f0",
   "off": 95984,
   "max": 36,
   "kind": "dialogue",
   "jp": "まず　龍馬の歌で\\n会場を盛り上げる",
   "en": "",
   "op": "0x62",
   "msg": "0x0bcd"
  },
  {
   "id": "m_004002:0x17724",
   "off": 96036,
   "max": 60,
   "kind": "dialogue",
   "jp": "客が温まったところで\\nトリをオレ様の新曲で\\nクールに締める",
   "en": "",
   "op": "0x62",
   "msg": "0x0bce"
  },
  {
   "id": "m_004002:0x17fc0",
   "off": 98240,
   "max": 20,
   "kind": "dialogue",
   "jp": "悪くねえ段取りだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bcf"
  },
  {
   "id": "m_004002:0x185fc",
   "off": 99836,
   "max": 56,
   "kind": "dialogue",
   "jp": "トリでシメる？\\n舞台の上で　料理でも\\n披露するのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd0"
  },
  {
   "id": "m_004002:0x18c50",
   "off": 101456,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうじゃねえよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd1"
  },
  {
   "id": "m_004002:0x19180",
   "off": 102784,
   "max": 52,
   "kind": "dialogue",
   "jp": "よくわからんが\\nわしは　シンディの\\n意見に賛成 ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd2"
  },
  {
   "id": "m_004002:0x1980c",
   "off": 104460,
   "max": 56,
   "kind": "dialogue",
   "jp": "お前なあ……\\nよくわからん　で\\n決めちまっていいのかよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd3"
  },
  {
   "id": "m_004002:0x19d3c",
   "off": 105788,
   "max": 80,
   "kind": "dialogue",
   "jp": "シンディの言うとおりに\\nすれば雷舞が盛り上がると\\n言うなら　それでよかろう？",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd4"
  },
  {
   "id": "m_004002:0x1a67c",
   "off": 108156,
   "max": 48,
   "kind": "dialogue",
   "jp": "わしは　シンディのことを\\n信じているからな！",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd5"
  },
  {
   "id": "m_004002:0x1af0c",
   "off": 110348,
   "max": 36,
   "kind": "dialogue",
   "jp": "……どこまでも\\nおめでたいヤロウだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd6"
  },
  {
   "id": "m_004002:0x1af40",
   "off": 110400,
   "max": 36,
   "kind": "dialogue",
   "jp": "なあ　龍馬\\nひとつだけ聞かせてくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd7"
  },
  {
   "id": "m_004002:0x1b478",
   "off": 111736,
   "max": 44,
   "kind": "dialogue",
   "jp": "む？\\nわしで良ければ\\nいくらでも答えるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd8"
  },
  {
   "id": "m_004002:0x1bd98",
   "off": 114072,
   "max": 52,
   "kind": "dialogue",
   "jp": "どうして　そこまで\\n他人を信じる事が\\nできるんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0bd9"
  },
  {
   "id": "m_004002:0x1c62c",
   "off": 116268,
   "max": 48,
   "kind": "dialogue",
   "jp": "うーん　そうだなあ\\nわしが人を信じるのは……",
   "en": "",
   "op": "0x62",
   "msg": "0x0bda"
  },
  {
   "id": "m_004002:0x1c9f0",
   "off": 117232,
   "max": 16,
   "kind": "choice",
   "jp": "何でだろう？",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_004002:0x1ca0c",
   "off": 117260,
   "max": 20,
   "kind": "choice",
   "jp": "生まれつきだから",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_004002:0x1ca2c",
   "off": 117292,
   "max": 16,
   "kind": "choice",
   "jp": "バカだから？",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_004002:0x1d374",
   "off": 119668,
   "max": 36,
   "kind": "dialogue",
   "jp": "何でだろう？\\n考えたこともないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad3"
  },
  {
   "id": "m_004002:0x1d814",
   "off": 120852,
   "max": 56,
   "kind": "dialogue",
   "jp": "フン　そうか\\n真面目に聞いた俺が\\nバカだったようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad4"
  },
  {
   "id": "m_004002:0x1dcc8",
   "off": 122056,
   "max": 56,
   "kind": "dialogue",
   "jp": "そう言われても……\\nわしは昔から\\nずっとこんな感じだし",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad5"
  },
  {
   "id": "m_004002:0x1dd10",
   "off": 122128,
   "max": 52,
   "kind": "dialogue",
   "jp": "人を信じるのに\\n小難しい理由なんて\\n必要ないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad6"
  },
  {
   "id": "m_004002:0x1e820",
   "off": 124960,
   "max": 48,
   "kind": "dialogue",
   "jp": "わしは物心ついた頃から\\nずっとこんな感じじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad7"
  },
  {
   "id": "m_004002:0x1e860",
   "off": 125024,
   "max": 52,
   "kind": "dialogue",
   "jp": "人を信じるのに\\n小難しい理由なんて\\n必要ないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad8"
  },
  {
   "id": "m_004002:0x1f378",
   "off": 127864,
   "max": 20,
   "kind": "dialogue",
   "jp": "……バカだから？",
   "en": "",
   "op": "0x62",
   "msg": "0x0ad9"
  },
  {
   "id": "m_004002:0x1f8ac",
   "off": 129196,
   "max": 48,
   "kind": "dialogue",
   "jp": "自分で認めるか\\nバカじゃないのか\\nこの天然が！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ada"
  },
  {
   "id": "m_004002:0x1fdf0",
   "off": 130544,
   "max": 52,
   "kind": "dialogue",
   "jp": "おお　そうか\\nバカじゃなくて\\nわしは天然なのかー",
   "en": "",
   "op": "0x62",
   "msg": "0x0adb"
  },
  {
   "id": "m_004002:0x20344",
   "off": 131908,
   "max": 44,
   "kind": "dialogue",
   "jp": "……もういい\\n聞いたオレ様が\\nバカだった",
   "en": "",
   "op": "0x62",
   "msg": "0x0adc"
  },
  {
   "id": "m_004002:0x207f4",
   "off": 133108,
   "max": 36,
   "kind": "dialogue",
   "jp": "それにシンディは\\n赤の他人とは違う",
   "en": "",
   "op": "0x62",
   "msg": "0x0add"
  },
  {
   "id": "m_004002:0x208c0",
   "off": 133312,
   "max": 64,
   "kind": "dialogue",
   "jp": "前にも言ったけど\\nわしとシンディは同志\\n同じ舞台に立つ仲間ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ade"
  },
  {
   "id": "m_004002:0x211f8",
   "off": 135672,
   "max": 32,
   "kind": "dialogue",
   "jp": "わしとシンディ\\nそれにセンセー",
   "en": "",
   "op": "0x62",
   "msg": "0x0adf"
  },
  {
   "id": "m_004002:0x212c0",
   "off": 135872,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしらは\\n一人じゃなくて\\n三人でロックをやってる",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae0"
  },
  {
   "id": "m_004002:0x21304",
   "off": 135940,
   "max": 32,
   "kind": "dialogue",
   "jp": "だからどこまでも\\n信じられる",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae1"
  },
  {
   "id": "m_004002:0x21b84",
   "off": 138116,
   "max": 48,
   "kind": "dialogue",
   "jp": "相変わらず生温い野郎だ\\nオレ様には理解出来ない",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae2"
  },
  {
   "id": "m_004002:0x220c8",
   "off": 139464,
   "max": 64,
   "kind": "dialogue",
   "jp": "今はそうかもしれない\\nだけど　シンディも\\nきっとわかる日が来る",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae3"
  },
  {
   "id": "m_004002:0x22624",
   "off": 140836,
   "max": 68,
   "kind": "dialogue",
   "jp": "ちゅーわけで　明日は\\nシンディの新曲で締める！\\nわしは信じてる！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae4"
  },
  {
   "id": "m_004002:0x22ae4",
   "off": 142052,
   "max": 20,
   "kind": "dialogue",
   "jp": "フン\\n一生夢見てろ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae5"
  },
  {
   "id": "m_004002:0x23074",
   "off": 143476,
   "max": 48,
   "kind": "dialogue",
   "jp": "高杉は龍馬の言葉を鼻で笑い\\n舞台の下見を続けた",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae6"
  },
  {
   "id": "m_004002:0x23600",
   "off": 144896,
   "max": 56,
   "kind": "dialogue",
   "jp": "次の日\\nイケダヤンの観覧席は\\n熱気で溢れかえっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae7"
  },
  {
   "id": "m_004002:0x23be4",
   "off": 146404,
   "max": 68,
   "kind": "dialogue",
   "jp": "おぉ～～　シンディ\\nセンセー　見てくれ\\n見渡す限りの人人人ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae8"
  },
  {
   "id": "m_004002:0x24348",
   "off": 148296,
   "max": 40,
   "kind": "dialogue",
   "jp": "これは圧巻ですね\\n席が全部埋まってます",
   "en": "",
   "op": "0x62",
   "msg": "0x0ae9"
  },
  {
   "id": "m_004002:0x249b4",
   "off": 149940,
   "max": 68,
   "kind": "dialogue",
   "jp": "民衆はオレ様の歌を\\n待ち侘びてるようだな\\nフン　良い顔してやがる",
   "en": "",
   "op": "0x62",
   "msg": "0x0aea"
  },
  {
   "id": "m_004002:0x24f74",
   "off": 151412,
   "max": 52,
   "kind": "dialogue",
   "jp": "舞台袖から観客席を覗き\\n龍馬達は短い言葉を交わす",
   "en": "",
   "op": "0x62",
   "msg": "0x0aeb"
  },
  {
   "id": "m_004002:0x24fb8",
   "off": 151480,
   "max": 72,
   "kind": "dialogue",
   "jp": "すぐそこに迫った雷舞本番に\\n三人は晴れ晴れとした表情を\\n浮かべていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0aec"
  },
  {
   "id": "m_004002:0x255ac",
   "off": 153004,
   "max": 64,
   "kind": "dialogue",
   "jp": "この日のために\\n積み重ねてきた音を\\nやっとみんなに届けられる",
   "en": "",
   "op": "0x62",
   "msg": "0x0aed"
  },
  {
   "id": "m_004002:0x255fc",
   "off": 153084,
   "max": 36,
   "kind": "dialogue",
   "jp": "シンディ　センセー\\n準備はいいか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0aee"
  },
  {
   "id": "m_004002:0x26010",
   "off": 155664,
   "max": 24,
   "kind": "dialogue",
   "jp": "ああ\\nいつだって完璧だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0aef"
  },
  {
   "id": "m_004002:0x266c4",
   "off": 157380,
   "max": 28,
   "kind": "dialogue",
   "jp": "私も\\n覚悟は出来ています",
   "en": "",
   "op": "0x62",
   "msg": "0x0af0"
  },
  {
   "id": "m_004002:0x26c70",
   "off": 158832,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍馬の問いかけに\\n高杉と桂が頷く",
   "en": "",
   "op": "0x62",
   "msg": "0x0af1"
  },
  {
   "id": "m_004002:0x26cac",
   "off": 158892,
   "max": 52,
   "kind": "dialogue",
   "jp": "それを見計らったかのように\\n観客が手を叩き始めた",
   "en": "",
   "op": "0x62",
   "msg": "0x0af2"
  },
  {
   "id": "m_004002:0x27124",
   "off": 160036,
   "max": 68,
   "kind": "dialogue",
   "jp": "ふふ　観客が\\n『早く出てくるように』と\\n私達を急かし始めましたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0af3"
  },
  {
   "id": "m_004002:0x277ac",
   "off": 161708,
   "max": 28,
   "kind": "dialogue",
   "jp": "上等じゃねーか\\nやってやる",
   "en": "",
   "op": "0x62",
   "msg": "0x0af4"
  },
  {
   "id": "m_004002:0x281cc",
   "off": 164300,
   "max": 44,
   "kind": "dialogue",
   "jp": "よぉぉぉし \\nそれじゃあ\\nいくぜよォ ",
   "en": "",
   "op": "0x62",
   "msg": "0x0af5"
  },
  {
   "id": "m_004002:0x287ac",
   "off": 165804,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬が拳を振り上げ\\n舞台へ向かって走り出す",
   "en": "",
   "op": "0x62",
   "msg": "0x0af6"
  },
  {
   "id": "m_004002:0x28d24",
   "off": 167204,
   "max": 56,
   "kind": "dialogue",
   "jp": "高杉と桂も後に続き\\n三人の姿が眩い光に\\n照らし出される",
   "en": "",
   "op": "0x62",
   "msg": "0x0af7"
  },
  {
   "id": "m_004002:0x29410",
   "off": 168976,
   "max": 52,
   "kind": "dialogue",
   "jp": "うぉぉぉぉぉ\\nみんなー\\nよく来てくれたぜよーー！",
   "en": "",
   "op": "0x62",
   "msg": "0x0af8"
  },
  {
   "id": "m_004002:0x29454",
   "off": 169044,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしらは　お前らを\\n愛してるぜよーー ",
   "en": "",
   "op": "0x62",
   "msg": "0x0af9"
  },
  {
   "id": "m_004002:0x298f8",
   "off": 170232,
   "max": 72,
   "kind": "dialogue",
   "jp": "今日はわしらの熱い愛を\\nその耳その目で　その心で\\n感じてくれーーーっ ",
   "en": "",
   "op": "0x62",
   "msg": "0x0afa"
  },
  {
   "id": "m_004002:0x29fd8",
   "off": 171992,
   "max": 60,
   "kind": "dialogue",
   "jp": "龍馬の叫びと\\n観客の熱い声援が響く中\\nついに雷舞が始まった",
   "en": "",
   "op": "0x62",
   "msg": "0x0afb"
  },
  {
   "id": "m_004002:0x2a568",
   "off": 173416,
   "max": 68,
   "kind": "dialogue",
   "jp": "龍馬達のロックに\\n観客は酔いしれ\\nイケダヤンは\\n興奮のるつぼと化す",
   "en": "",
   "op": "0x62",
   "msg": "0x0afc"
  },
  {
   "id": "m_004002:0x2aae8",
   "off": 174824,
   "max": 72,
   "kind": "dialogue",
   "jp": "そして\\n最高潮の盛り上がりの中\\n最後の一曲を\\n披露する時がやって来た",
   "en": "",
   "op": "0x62",
   "msg": "0x0afd"
  },
  {
   "id": "m_004002:0x2ab40",
   "off": 174912,
   "max": 44,
   "kind": "dialogue",
   "jp": "だがその瞬間\\n招かれざる客が\\n一斉に現れた",
   "en": "",
   "op": "0x62",
   "msg": "0x0bde"
  },
  {
   "id": "m_004002:0x2b298",
   "off": 176792,
   "max": 36,
   "kind": "dialogue",
   "jp": "全員動くな！\\n我らは新選組である！",
   "en": "",
   "op": "0x62",
   "msg": "0x0afe"
  },
  {
   "id": "m_004002:0x2b2d4",
   "off": 176852,
   "max": 48,
   "kind": "dialogue",
   "jp": "上様の命を受け\\nこれより雷舞の\\n調査を行う！",
   "en": "",
   "op": "0x62",
   "msg": "0x0aff"
  },
  {
   "id": "m_004002:0x2bac4",
   "off": 178884,
   "max": 28,
   "kind": "dialogue",
   "jp": "やはり\\n坂本達だったか　",
   "en": "",
   "op": "0x62",
   "msg": "0x0b00"
  },
  {
   "id": "m_004002:0x2c124",
   "off": 180516,
   "max": 56,
   "kind": "dialogue",
   "jp": "奴らがここで雷舞をする\\nという噂は\\n本当だったのだな",
   "en": "",
   "op": "0x62",
   "msg": "0x0b01"
  },
  {
   "id": "m_004002:0x2c16c",
   "off": 180588,
   "max": 36,
   "kind": "dialogue",
   "jp": "総司　出番だ\\n手筈通りに頼んだぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b02"
  },
  {
   "id": "m_004002:0x2c828",
   "off": 182312,
   "max": 40,
   "kind": "dialogue",
   "jp": "はい　了解でーす　\\n任せてくださいね～",
   "en": "",
   "op": "0x62",
   "msg": "0x0b03"
  },
  {
   "id": "m_004002:0x2cf20",
   "off": 184096,
   "max": 76,
   "kind": "dialogue",
   "jp": "ざわめく観客を押し退けて\\n近藤を先頭に新選組の隊士が\\n舞台へと歩を進める",
   "en": "",
   "op": "0x62",
   "msg": "0x0b04"
  },
  {
   "id": "m_004002:0x2cf84",
   "off": 184196,
   "max": 40,
   "kind": "dialogue",
   "jp": "龍馬達はその様子を見て\\n咄嗟に身構えた",
   "en": "",
   "op": "0x62",
   "msg": "0x0b05"
  },
  {
   "id": "m_004002:0x2d3ec",
   "off": 185324,
   "max": 44,
   "kind": "dialogue",
   "jp": "うぬ～\\nここぞっちゅー時に\\nまた新選組か！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b06"
  },
  {
   "id": "m_004002:0x2da5c",
   "off": 186972,
   "max": 52,
   "kind": "dialogue",
   "jp": "警戒はしていたが\\nやっぱり\\n嗅ぎつけてきやがったか",
   "en": "",
   "op": "0x62",
   "msg": "0x0b07"
  },
  {
   "id": "m_004002:0x2e12c",
   "off": 188716,
   "max": 44,
   "kind": "dialogue",
   "jp": "今日はいつにも増して\\n隊士の数が多いですね",
   "en": "",
   "op": "0x62",
   "msg": "0x0b08"
  },
  {
   "id": "m_004002:0x2e168",
   "off": 188776,
   "max": 64,
   "kind": "dialogue",
   "jp": "このままだと\\n彼らが舞台に辿り着くのは\\n時間の問題だと思います",
   "en": "",
   "op": "0x62",
   "msg": "0x0b09"
  },
  {
   "id": "m_004002:0x2e934",
   "off": 190772,
   "max": 64,
   "kind": "dialogue",
   "jp": "おし　わかった\\nだったら　わしが奴らの\\n囮になって時間を稼ぐ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b0a"
  },
  {
   "id": "m_004002:0x2e984",
   "off": 190852,
   "max": 64,
   "kind": "dialogue",
   "jp": "シンディとセンセーは\\nその間に舞台で\\n最後の一曲をやってくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b0b"
  },
  {
   "id": "m_004002:0x2e9d4",
   "off": 190932,
   "max": 36,
   "kind": "dialogue",
   "jp": "雷舞が終わるまで\\n今日は逃げん！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b0c"
  },
  {
   "id": "m_004002:0x2f120",
   "off": 192800,
   "max": 48,
   "kind": "dialogue",
   "jp": "新選組にも\\nわしらのロックを\\n聴かせてやる ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b0d"
  },
  {
   "id": "m_004002:0x2f86c",
   "off": 194668,
   "max": 40,
   "kind": "dialogue",
   "jp": "それじゃ\\n二人とも\\n後は頼んだぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b0e"
  },
  {
   "id": "m_004002:0x2f8a4",
   "off": 194724,
   "max": 32,
   "kind": "dialogue",
   "jp": "シンディ\\n新曲楽しみにしてる！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b0f"
  },
  {
   "id": "m_004002:0x3011c",
   "off": 196892,
   "max": 20,
   "kind": "dialogue",
   "jp": "あっ\\n龍馬くん！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b10"
  },
  {
   "id": "m_004002:0x305c0",
   "off": 198080,
   "max": 76,
   "kind": "dialogue",
   "jp": "龍馬は笑顔で舞台を降りると\\n二人に手を振って\\n新選組の中に突っ込んでゆく",
   "en": "",
   "op": "0x62",
   "msg": "0x0b11"
  },
  {
   "id": "m_004002:0x3061c",
   "off": 198172,
   "max": 60,
   "kind": "dialogue",
   "jp": "そんな龍馬を捕まえようと\\n隊士達は躍起になって\\n追いかけた",
   "en": "",
   "op": "0x62",
   "msg": "0x0b12"
  },
  {
   "id": "m_004002:0x30a9c",
   "off": 199324,
   "max": 28,
   "kind": "dialogue",
   "jp": "龍馬くん\\n大丈夫でしょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x0b13"
  },
  {
   "id": "m_004002:0x30ac8",
   "off": 199368,
   "max": 64,
   "kind": "dialogue",
   "jp": "このままだと龍馬くんは\\n隊士に取り押さえられそう\\nだけども……",
   "en": "",
   "op": "0x62",
   "msg": "0x0b14"
  },
  {
   "id": "m_004002:0x311e8",
   "off": 201192,
   "max": 20,
   "kind": "dialogue",
   "jp": "晋作　どうします？",
   "en": "",
   "op": "0x62",
   "msg": "0x0b15"
  },
  {
   "id": "m_004002:0x3120c",
   "off": 201228,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍馬くんの\\n言う通りにしますか\\nそれとも……",
   "en": "",
   "op": "0x62",
   "msg": "0x0b16"
  },
  {
   "id": "m_004002:0x31754",
   "off": 202580,
   "max": 36,
   "kind": "dialogue",
   "jp": "ちッ……\\nそんなの決まってるだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b17"
  },
  {
   "id": "m_004002:0x31cf4",
   "off": 204020,
   "max": 76,
   "kind": "dialogue",
   "jp": "高杉は己の迷いを\\n振り切るように\\n一歩前へ踏み出し\\n龍馬のもとへ走り出した",
   "en": "",
   "op": "0x62",
   "msg": "0x0b18"
  },
  {
   "id": "m_004002:0x32134",
   "off": 205108,
   "max": 12,
   "kind": "dialogue",
   "jp": "うぉぉぉ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b19"
  },
  {
   "id": "m_004002:0x324f0",
   "off": 206064,
   "max": 60,
   "kind": "dialogue",
   "jp": "高杉は叫びながら\\n龍馬を追いかける敵を\\n蹴散らしてゆく！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b1a"
  },
  {
   "id": "m_004002:0x32834",
   "off": 206900,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふっ\\nそれでこそ晋作です\\n私も加勢しますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b1b"
  },
  {
   "id": "m_004002:0x32c18",
   "off": 207896,
   "max": 60,
   "kind": "dialogue",
   "jp": "高杉に続き\\n桂も発明品を使って\\n新選組を薙ぎ倒し\\nはじめた",
   "en": "",
   "op": "0x62",
   "msg": "0x0b1c"
  },
  {
   "id": "m_004002:0x331f4",
   "off": 209396,
   "max": 32,
   "kind": "dialogue",
   "jp": "シンディ\\nそれにセンセーも",
   "en": "",
   "op": "0x62",
   "msg": "0x0b1d"
  },
  {
   "id": "m_004002:0x332bc",
   "off": 209596,
   "max": 64,
   "kind": "dialogue",
   "jp": "なんでじゃ？\\nなんで舞台から降りた \\n答えてくれ　シンディ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b1e"
  },
  {
   "id": "m_004002:0x335a4",
   "off": 210340,
   "max": 16,
   "kind": "choice",
   "jp": "単なる気まぐれ",
   "en": "",
   "op": "0x51"
  },
