{
 "source": "m_004003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_004003:0x12f8",
   "off": 4856,
   "max": 40,
   "kind": "dialogue",
   "jp": "くぅ……っ\\nこの僕が歌で負けるなんて",
   "en": "",
   "op": "0x62",
   "msg": "0x0b6d"
  },
  {
   "id": "m_004003:0x1c98",
   "off": 7320,
   "max": 44,
   "kind": "dialogue",
   "jp": "どうだっ！　これが\\nオレ様のロックだっ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b6e"
  },
  {
   "id": "m_004003:0x23d8",
   "off": 9176,
   "max": 76,
   "kind": "dialogue",
   "jp": "高杉のロックに\\n沖田の天歌はかき消され\\n観客は高杉の歌に\\n酔いしれていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0b6f"
  },
  {
   "id": "m_004003:0x2434",
   "off": 9268,
   "max": 48,
   "kind": "dialogue",
   "jp": "新選組でさえ\\n動くことも\\nできなくなっている",
   "en": "",
   "op": "0x62",
   "msg": "0x0be0"
  },
  {
   "id": "m_004003:0x29ec",
   "off": 10732,
   "max": 32,
   "kind": "dialogue",
   "jp": "……これは\\nこの歌はなんだ……",
   "en": "",
   "op": "0x62",
   "msg": "0x0b70"
  },
  {
   "id": "m_004003:0x2e88",
   "off": 11912,
   "max": 28,
   "kind": "dialogue",
   "jp": "……嵐山の\\nあの時と同じ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b71"
  },
  {
   "id": "m_004003:0x344c",
   "off": 13388,
   "max": 44,
   "kind": "dialogue",
   "jp": "土方や近藤でさえ　\\n高杉に圧倒されていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0b72"
  },
  {
   "id": "m_004003:0x3488",
   "off": 13448,
   "max": 68,
   "kind": "dialogue",
   "jp": "水を打ったように\\n静まり返っていた雷舞屋に\\n観衆の大歓声が上がる",
   "en": "",
   "op": "0x62",
   "msg": "0x0b73"
  },
  {
   "id": "m_004003:0x34dc",
   "off": 13532,
   "max": 88,
   "kind": "dialogue",
   "jp": "その熱い声を聞き\\n龍馬達は高杉の歌によって\\n観衆が天歌の泰平化を\\n免れたことを悟った",
   "en": "",
   "op": "0x62",
   "msg": "0x0b74"
  },
  {
   "id": "m_004003:0x3c0c",
   "off": 15372,
   "max": 56,
   "kind": "dialogue",
   "jp": "……へー\\n僕の歌を押しのけちゃった\\nすごーい　吃驚だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b75"
  },
  {
   "id": "m_004003:0x3cec",
   "off": 15596,
   "max": 64,
   "kind": "dialogue",
   "jp": "僕も負けてられないね\\nもっともっと練習しなくちゃ\\n……ふふふ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b76"
  },
  {
   "id": "m_004003:0x424c",
   "off": 16972,
   "max": 32,
   "kind": "dialogue",
   "jp": "……何だ\\nその薄気味悪い笑いは",
   "en": "",
   "op": "0x62",
   "msg": "0x0b77"
  },
  {
   "id": "m_004003:0x4b64",
   "off": 19300,
   "max": 72,
   "kind": "dialogue",
   "jp": "何言ってるの？\\nこれはとびきりの\\n愛獲笑顔（アイドルスマイル）\\nだよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0b78"
  },
  {
   "id": "m_004003:0x50c0",
   "off": 20672,
   "max": 64,
   "kind": "dialogue",
   "jp": "白い歯を見せて微笑む沖田に\\n高杉は凄まじい狂気を\\n感じていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0bdb"
  },
  {
   "id": "m_004003:0x57bc",
   "off": 22460,
   "max": 56,
   "kind": "dialogue",
   "jp": "よしっ\\n締めの曲も終わったし\\n雷舞はこれでお開きだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b79"
  },
  {
   "id": "m_004003:0x589c",
   "off": 22684,
   "max": 52,
   "kind": "dialogue",
   "jp": "シンディ　センセー\\nとっとと\\nオサラバするぜよ ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b7a"
  },
  {
   "id": "m_004003:0x61c0",
   "off": 25024,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうですね\\n行きましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x0b7b"
  },
  {
   "id": "m_004003:0x6658",
   "off": 26200,
   "max": 60,
   "kind": "dialogue",
   "jp": "お前達\\nオレ様についてこい！\\n捕まるなんてドジするなよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b7c"
  },
  {
   "id": "m_004003:0x70ec",
   "off": 28908,
   "max": 20,
   "kind": "dialogue",
   "jp": "奴らを逃がすな！",
   "en": "",
   "op": "0x62",
   "msg": "0x0b7d"
  },
  {
   "id": "m_004003:0x77f4",
   "off": 30708,
   "max": 72,
   "kind": "dialogue",
   "jp": "龍馬の雷舞終了宣言によって\\n黒山の人だかりが\\n出口へと大移動を始める",
   "en": "",
   "op": "0x62",
   "msg": "0x0b7e"
  },
  {
   "id": "m_004003:0x784c",
   "off": 30796,
   "max": 72,
   "kind": "dialogue",
   "jp": "龍馬達は大勢の観客に紛れ\\n新選組の目を欺いて\\n脱出することに成功した",
   "en": "",
   "op": "0x62",
   "msg": "0x0b7f"
  },
  {
   "id": "m_004003:0x7cec",
   "off": 31980,
   "max": 16,
   "kind": "dialogue",
   "jp": "逃げられたか",
   "en": "",
   "op": "0x62",
   "msg": "0x0b80"
  },
  {
   "id": "m_004003:0x833c",
   "off": 33596,
   "max": 48,
   "kind": "dialogue",
   "jp": "相変わらず\\nすばしっこい奴らですね\\n残念だな",
   "en": "",
   "op": "0x62",
   "msg": "0x0b81"
  },
  {
   "id": "m_004003:0x8c60",
   "off": 35936,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x0b82"
  },
  {
   "id": "m_004003:0x94d4",
   "off": 38100,
   "max": 32,
   "kind": "dialogue",
   "jp": "近藤さん？\\nどうかしましたか",
   "en": "",
   "op": "0x62",
   "msg": "0x0b83"
  },
  {
   "id": "m_004003:0x9a0c",
   "off": 39436,
   "max": 56,
   "kind": "dialogue",
   "jp": "いや……\\nどうしてだか　奴らの歌が\\n耳から離れなくてな",
   "en": "",
   "op": "0x62",
   "msg": "0x0b84"
  },
  {
   "id": "m_004003:0x9a54",
   "off": 39508,
   "max": 40,
   "kind": "dialogue",
   "jp": "それに胸が熱くて\\n何だかぼうっとする",
   "en": "",
   "op": "0x62",
   "msg": "0x0b85"
  },
  {
   "id": "m_004003:0x9a8c",
   "off": 39564,
   "max": 36,
   "kind": "dialogue",
   "jp": "今の雷舞を観て\\n悪い気はしなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x0b86"
  },
  {
   "id": "m_004003:0x9b5c",
   "off": 39772,
   "max": 48,
   "kind": "dialogue",
   "jp": "それどころか　奴らの歌に\\n心地良ささえ感じた",
   "en": "",
   "op": "0x62",
   "msg": "0x0b87"
  },
  {
   "id": "m_004003:0xa480",
   "off": 42112,
   "max": 64,
   "kind": "dialogue",
   "jp": "なぁ……奴らの歌は\\n果たして取り締まるべき\\nものなのだろうか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0b88"
  },
  {
   "id": "m_004003:0xad20",
   "off": 44320,
   "max": 60,
   "kind": "dialogue",
   "jp": "何を言い出すかと思えば\\nしっかりしてくださいよ\\n近藤局長",
   "en": "",
   "op": "0x62",
   "msg": "0x0b89"
  },
  {
   "id": "m_004003:0xae04",
   "off": 44548,
   "max": 52,
   "kind": "dialogue",
   "jp": "あれは人をまどわす\\n騒音（ノイズ）に\\n過ぎませんよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b8a"
  },
  {
   "id": "m_004003:0xb2b4",
   "off": 45748,
   "max": 36,
   "kind": "dialogue",
   "jp": "俺の言っている事は\\nおかしいか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0b8b"
  },
  {
   "id": "m_004003:0xbbc8",
   "off": 48072,
   "max": 68,
   "kind": "dialogue",
   "jp": "ええ　おかしいですよ\\n近藤さんは変なことを\\n気にしなくていいんです",
   "en": "",
   "op": "0x62",
   "msg": "0x0b8c"
  },
  {
   "id": "m_004003:0xbc1c",
   "off": 48156,
   "max": 40,
   "kind": "dialogue",
   "jp": "僕の歌があれば\\n何の心配もないですから",
   "en": "",
   "op": "0x62",
   "msg": "0x0b8d"
  },
  {
   "id": "m_004003:0xbc54",
   "off": 48212,
   "max": 52,
   "kind": "dialogue",
   "jp": "近藤さんは\\nどっしり構えてて\\nくれればいいんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b8e"
  },
  {
   "id": "m_004003:0xc4e8",
   "off": 50408,
   "max": 28,
   "kind": "dialogue",
   "jp": "副長も\\nそう思うでしょ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0b8f"
  },
  {
   "id": "m_004003:0xcba0",
   "off": 52128,
   "max": 24,
   "kind": "dialogue",
   "jp": "ああ\\n総司の言う通りだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b90"
  },
  {
   "id": "m_004003:0xd034",
   "off": 53300,
   "max": 52,
   "kind": "dialogue",
   "jp": "トシ……総司……\\n……俺達の歌は\\nあんなだったか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0b91"
  },
  {
   "id": "m_004003:0xd078",
   "off": 53368,
   "max": 64,
   "kind": "dialogue",
   "jp": "あいつらのように\\n人々を明るく照らして\\n活力を与えているか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0b92"
  },
  {
   "id": "m_004003:0xd750",
   "off": 55120,
   "max": 60,
   "kind": "dialogue",
   "jp": "ええ　もちろん\\nむしろ僕達の歌の方が\\nずっと優れていますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b93"
  },
  {
   "id": "m_004003:0xde28",
   "off": 56872,
   "max": 20,
   "kind": "dialogue",
   "jp": "俺も\\nそう思います",
   "en": "",
   "op": "0x62",
   "msg": "0x0b94"
  },
  {
   "id": "m_004003:0xe730",
   "off": 59184,
   "max": 12,
   "kind": "dialogue",
   "jp": "そうか……",
   "en": "",
   "op": "0x62",
   "msg": "0x0b95"
  },
  {
   "id": "m_004003:0xebb8",
   "off": 60344,
   "max": 60,
   "kind": "dialogue",
   "jp": "人を惑わす歌を取り締まり\\n泰平の世を守るのが\\n俺たちだよな",
   "en": "",
   "op": "0x62",
   "msg": "0x0b96"
  },
  {
   "id": "m_004003:0xf314",
   "off": 62228,
   "max": 16,
   "kind": "dialogue",
   "jp": "ええ　近藤さん",
   "en": "",
   "op": "0x62",
   "msg": "0x0b97"
  },
  {
   "id": "m_004003:0xf964",
   "off": 63844,
   "max": 36,
   "kind": "dialogue",
   "jp": "近藤さんには\\n僕達がついてるんです",
   "en": "",
   "op": "0x62",
   "msg": "0x0b98"
  },
  {
   "id": "m_004003:0xfa30",
   "off": 64048,
   "max": 40,
   "kind": "dialogue",
   "jp": "悩む必要なんか\\nありませんよ　ねっ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0b99"
  },
  {
   "id": "m_004003:0x101e0",
   "off": 66016,
   "max": 48,
   "kind": "dialogue",
   "jp": "ああ　そうだな\\n妙なことを言って\\nすまなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x0b9a"
  },
  {
   "id": "m_004003:0x106a0",
   "off": 67232,
   "max": 56,
   "kind": "dialogue",
   "jp": "近藤は沖田の冷笑に\\n違和感を抱きつつも\\n悩むのを止めた",
   "en": "",
   "op": "0x62",
   "msg": "0x0b9b"
  },
  {
   "id": "m_004003:0x10c34",
   "off": 68660,
   "max": 60,
   "kind": "dialogue",
   "jp": "その頃\\n龍馬達はテラーダで\\n雷舞成功の祝杯を\\nあげていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0b9c"
  },
  {
   "id": "m_004003:0x11380",
   "off": 70528,
   "max": 48,
   "kind": "dialogue",
   "jp": "くぅ～～っ　今日の雷舞は\\n最高の出来だったなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b9d"
  },
  {
   "id": "m_004003:0x113c0",
   "off": 70592,
   "max": 60,
   "kind": "dialogue",
   "jp": "特にシンディの新曲は\\nすごかった！\\nわしは感動したぜよっ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b9e"
  },
  {
   "id": "m_004003:0x11b94",
   "off": 72596,
   "max": 36,
   "kind": "dialogue",
   "jp": "私も晋作の歌には\\n心が震えましたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0b9f"
  },
  {
   "id": "m_004003:0x121fc",
   "off": 74236,
   "max": 36,
   "kind": "dialogue",
   "jp": "オレ様の歌が\\n素晴らしいのは当然だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba0"
  },
  {
   "id": "m_004003:0x12230",
   "off": 74288,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前らの批評を\\n一々聞かなくてもわかる",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba1"
  },
  {
   "id": "m_004003:0x12b4c",
   "off": 76620,
   "max": 36,
   "kind": "dialogue",
   "jp": "だが……\\nあれは一体どういう事だ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba2"
  },
  {
   "id": "m_004003:0x133d4",
   "off": 78804,
   "max": 28,
   "kind": "dialogue",
   "jp": "晋作？\\nどうかしましたか",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba3"
  },
  {
   "id": "m_004003:0x13908",
   "off": 80136,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああ……\\n少し気になる事が\\nあってな……",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba4"
  },
  {
   "id": "m_004003:0x13e4c",
   "off": 81484,
   "max": 16,
   "kind": "dialogue",
   "jp": "気になる事？",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba5"
  },
  {
   "id": "m_004003:0x142d8",
   "off": 82648,
   "max": 8,
   "kind": "dialogue",
   "jp": "そうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba6"
  },
  {
   "id": "m_004003:0x147f8",
   "off": 83960,
   "max": 64,
   "kind": "dialogue",
   "jp": "……実は舞台で歌う沖田に\\n近づいたとき\\nなんだか同じ魂を感じた",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba7"
  },
  {
   "id": "m_004003:0x14d50",
   "off": 85328,
   "max": 12,
   "kind": "dialogue",
   "jp": "同じ魂って",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba8"
  },
  {
   "id": "m_004003:0x153f4",
   "off": 87028,
   "max": 68,
   "kind": "dialogue",
   "jp": "わかるぜよ　シンディ\\nわしも一緒に歌ったとき\\nそんな気がしたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ba9"
  },
  {
   "id": "m_004003:0x154e0",
   "off": 87264,
   "max": 44,
   "kind": "dialogue",
   "jp": "シンディやセンセーと\\n歌う時と似てるような",
   "en": "",
   "op": "0x62",
   "msg": "0x0baa"
  },
  {
   "id": "m_004003:0x15e00",
   "off": 89600,
   "max": 36,
   "kind": "dialogue",
   "jp": "あれは超魂の欠片\\n片魂かもしれん",
   "en": "",
   "op": "0x62",
   "msg": "0x0bab"
  },
  {
   "id": "m_004003:0x16688",
   "off": 91784,
   "max": 64,
   "kind": "dialogue",
   "jp": "超魂がよりによって\\n新選組の沖田にですか？\\n思い過ごしでは？",
   "en": "",
   "op": "0x62",
   "msg": "0x0bac"
  },
  {
   "id": "m_004003:0x16b44",
   "off": 92996,
   "max": 68,
   "kind": "dialogue",
   "jp": "勘違いではないと思うが\\nだが……片魂というには\\n何かが違っていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0bad"
  },
  {
   "id": "m_004003:0x1747c",
   "off": 95356,
   "max": 64,
   "kind": "dialogue",
   "jp": "魂の共鳴を感じたと同時に\\nとてつもなく濁ったものも\\n感じたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bae"
  },
  {
   "id": "m_004003:0x174cc",
   "off": 95436,
   "max": 20,
   "kind": "dialogue",
   "jp": "嫌な感じだったぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x0baf"
  },
  {
   "id": "m_004003:0x1758c",
   "off": 95628,
   "max": 60,
   "kind": "dialogue",
   "jp": "あいつの異常な歌は\\nその濁りから\\n来ているのかもしれない",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb0"
  },
  {
   "id": "m_004003:0x17674",
   "off": 95860,
   "max": 76,
   "kind": "dialogue",
   "jp": "松陰先生が追い求めた\\n超魂がもしも新選組に悪用\\nされてたら　許せねえ……",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb1"
  },
  {
   "id": "m_004003:0x17f20",
   "off": 98080,
   "max": 68,
   "kind": "dialogue",
   "jp": "ああ　わしも同じ気持ちだ\\nこのままじゃいかんぜよ\\n絶対に良くない",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb2"
  },
  {
   "id": "m_004003:0x17f74",
   "off": 98164,
   "max": 44,
   "kind": "dialogue",
   "jp": "あのままじゃ　ソウちんも\\nまずいと思うぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb3"
  },
  {
   "id": "m_004003:0x189fc",
   "off": 100860,
   "max": 64,
   "kind": "dialogue",
   "jp": "いつまでも　幕府の思い\\n通りにさせてたまるか！\\nやってやるぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb4"
  },
  {
   "id": "m_004003:0x193a0",
   "off": 103328,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしらがロックで\\nみんなを救うんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb5"
  },
  {
   "id": "m_004003:0x198a8",
   "off": 104616,
   "max": 52,
   "kind": "dialogue",
   "jp": "オレ様のロックで　みんなの\\n目を覚まさせてやるぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb6"
  },
  {
   "id": "m_004003:0x19df8",
   "off": 105976,
   "max": 44,
   "kind": "dialogue",
   "jp": "おおー　シンディは\\n今日もノリノリだなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb7"
  },
  {
   "id": "m_004003:0x1a33c",
   "off": 107324,
   "max": 8,
   "kind": "dialogue",
   "jp": "当然だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb8"
  },
  {
   "id": "m_004003:0x1a85c",
   "off": 108636,
   "max": 48,
   "kind": "dialogue",
   "jp": "おい　バカ\\nお前は俺の背中を\\n見失わないように",
   "en": "",
   "op": "0x62",
   "msg": "0x0bb9"
  },
  {
   "id": "m_004003:0x1a89c",
   "off": 108700,
   "max": 36,
   "kind": "dialogue",
   "jp": "せいぜい必死になって\\n稽古しろよな",
   "en": "",
   "op": "0x62",
   "msg": "0x0bba"
  },
  {
   "id": "m_004003:0x1ae30",
   "off": 110128,
   "max": 36,
   "kind": "dialogue",
   "jp": "おう！\\nもちろん　そのつもりだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0bbb"
  },
  {
   "id": "m_004003:0x1b3d8",
   "off": 111576,
   "max": 56,
   "kind": "dialogue",
   "jp": "高杉の挑発的な微笑を\\n龍馬は満面の笑みで\\n受け止める",
   "en": "",
   "op": "0x62",
   "msg": "0x0bbc"
  },
  {
   "id": "m_004003:0x1b56c",
   "off": 111980,
   "max": 48,
   "kind": "dialogue",
   "jp": "そんな二人を\\n桂は複雑な表情で\\n見つめていた",
   "en": "",
   "op": "0x62",
   "msg": "0x0bbd"
  },
  {
   "id": "m_004003:0x1b8b0",
   "off": 112816,
   "max": 60,
   "kind": "dialogue",
   "jp": "今日の件で晋作も\\n龍馬くんも一段と大きく\\nなったようですね",
   "en": "",
   "op": "0x62",
   "msg": "0x0bbe"
  },
  {
   "id": "m_004003:0x1b8fc",
   "off": 112892,
   "max": 56,
   "kind": "dialogue",
   "jp": "二人だけじゃない\\n沖田くんだって\\n恐ろしく成長していた",
   "en": "",
   "op": "0x62",
   "msg": "0x0bbf"
  },
  {
   "id": "m_004003:0x1b9e0",
   "off": 113120,
   "max": 76,
   "kind": "dialogue",
   "jp": "たとえ歪んだ歌だとしても\\n恐ろしく力強い……\\nあれが片魂の力（パワー）か",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc0"
  },
  {
   "id": "m_004003:0x1c234",
   "off": 115252,
   "max": 40,
   "kind": "dialogue",
   "jp": "……それに比べて　\\n私はどうでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc1"
  },
  {
   "id": "m_004003:0x1c26c",
   "off": 115308,
   "max": 76,
   "kind": "dialogue",
   "jp": "流れ星は　晋作にも私にも\\n落ちてきたというのに……\\n私だけが　覚醒できない",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc2"
  },
  {
   "id": "m_004003:0x1c7cc",
   "off": 116684,
   "max": 116,
   "kind": "dialogue",
   "jp": "龍馬と高杉を見つめたまま\\n桂は眉間に皺を寄せる\\n桂は心のどこかで\\nひとりだけ取り残されていく\\n自分を感じていた……",
   "en": "",
   "op": "0x62",
   "msg": "0x0bc3"
  }
 ]
}
