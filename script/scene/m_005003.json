{
 "source": "m_005003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_005003:0x13b8",
   "off": 5048,
   "max": 40,
   "kind": "dialogue",
   "jp": "こ　これはいったい\\n何が起こったんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0ea5"
  },
  {
   "id": "m_005003:0x1a7c",
   "off": 6780,
   "max": 52,
   "kind": "dialogue",
   "jp": "ああ　胸がドキドキする\\n身体が震えて止まらない！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ea7"
  },
  {
   "id": "m_005003:0x2148",
   "off": 8520,
   "max": 48,
   "kind": "dialogue",
   "jp": "ありがとう\\nなんだか心も体も自由に\\nなれたぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ea8"
  },
  {
   "id": "m_005003:0x2810",
   "off": 10256,
   "max": 52,
   "kind": "dialogue",
   "jp": "……うわ\\nなんだかつまんないことに\\nなったね……",
   "en": "",
   "op": "0x62",
   "msg": "0x0ea9"
  },
  {
   "id": "m_005003:0x2e84",
   "off": 11908,
   "max": 44,
   "kind": "dialogue",
   "jp": "これ以上やるなら\\nわしも相手になるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0eaa"
  },
  {
   "id": "m_005003:0x33c4",
   "off": 13252,
   "max": 48,
   "kind": "dialogue",
   "jp": "う～ん　今日は止めとく\\nなんだか興が冷めたし",
   "en": "",
   "op": "0x62",
   "msg": "0x0eab"
  },
  {
   "id": "m_005003:0x3404",
   "off": 13316,
   "max": 52,
   "kind": "dialogue",
   "jp": "……それに　もう十分\\n鳳舞合奏の力を\\n試せたからね",
   "en": "",
   "op": "0x62",
   "msg": "0x0eac"
  },
  {
   "id": "m_005003:0x3ad4",
   "off": 15060,
   "max": 64,
   "kind": "dialogue",
   "jp": "それはどういう意味です？\\n鳳舞合奏の実験は\\n失敗したのでは……",
   "en": "",
   "op": "0x62",
   "msg": "0x0ead"
  },
  {
   "id": "m_005003:0x4198",
   "off": 16792,
   "max": 16,
   "kind": "dialogue",
   "jp": "それは　秘密",
   "en": "",
   "op": "0x62",
   "msg": "0x0eae"
  },
  {
   "id": "m_005003:0x46bc",
   "off": 18108,
   "max": 56,
   "kind": "dialogue",
   "jp": "じゃ　またね～\\nトサカくんとメガネくんと\\nスカシくん",
   "en": "",
   "op": "0x62",
   "msg": "0x0eaf"
  },
  {
   "id": "m_005003:0x4d8c",
   "off": 19852,
   "max": 32,
   "kind": "dialogue",
   "jp": "こら　待たんか\\nソウちん",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb0"
  },
  {
   "id": "m_005003:0x53f0",
   "off": 21488,
   "max": 64,
   "kind": "dialogue",
   "jp": "龍馬くん　今は新選組より\\n倒れてる人たちを助け出す\\n方が先です",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb1"
  },
  {
   "id": "m_005003:0x59ac",
   "off": 22956,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬たちは\\n倒れた者達を助け出し\\n廃寺を後にした",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb2"
  },
  {
   "id": "m_005003:0x59f0",
   "off": 23024,
   "max": 88,
   "kind": "dialogue",
   "jp": "ロックによって\\n正気を取り戻した\\n民衆達もそれに\\n手を貸してくれたのは\\n言うまでもない",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb3"
  },
  {
   "id": "m_005003:0x61ac",
   "off": 25004,
   "max": 16,
   "kind": "dialogue",
   "jp": "心配をかけたな",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb4"
  },
  {
   "id": "m_005003:0x67fc",
   "off": 26620,
   "max": 56,
   "kind": "dialogue",
   "jp": "ほんに　シンディは\\n見かけによらず\\n敏感な男じゃのう",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb5"
  },
  {
   "id": "m_005003:0x6da8",
   "off": 28072,
   "max": 56,
   "kind": "dialogue",
   "jp": "び　びんかん\\nオレ様はクールな男だ\\nそんなんじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb6"
  },
  {
   "id": "m_005003:0x6df8",
   "off": 28152,
   "max": 56,
   "kind": "dialogue",
   "jp": "たまたま……\\nたまたま調子が悪かった\\nただ　それだけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb7"
  },
  {
   "id": "m_005003:0x74cc",
   "off": 29900,
   "max": 72,
   "kind": "dialogue",
   "jp": "感受性豊かで敏感な方が\\nいい音楽を奏でられる\\n先生はそう言ってましたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb8"
  },
  {
   "id": "m_005003:0x7a34",
   "off": 31284,
   "max": 20,
   "kind": "dialogue",
   "jp": "……そう\\nだったな",
   "en": "",
   "op": "0x62",
   "msg": "0x0eb9"
  },
  {
   "id": "m_005003:0x7ec4",
   "off": 32452,
   "max": 32,
   "kind": "dialogue",
   "jp": "一つの音を聴いて\\n十を感じる",
   "en": "",
   "op": "0x62",
   "msg": "0x0eba"
  },
  {
   "id": "m_005003:0x7ef4",
   "off": 32500,
   "max": 64,
   "kind": "dialogue",
   "jp": "本当に　晋作みたいに\\nなれたらいいなと\\n私は思っていました……",
   "en": "",
   "op": "0x62",
   "msg": "0x0ebb"
  },
  {
   "id": "m_005003:0x8454",
   "off": 33876,
   "max": 48,
   "kind": "dialogue",
   "jp": "な　何を言い出すんだ急に\\nオレ様なら当然だ\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0ebc"
  },
  {
   "id": "m_005003:0x8b1c",
   "off": 35612,
   "max": 16,
   "kind": "dialogue",
   "jp": "お　照れちょる",
   "en": "",
   "op": "0x62",
   "msg": "0x0ebd"
  },
  {
   "id": "m_005003:0x90a0",
   "off": 37024,
   "max": 52,
   "kind": "dialogue",
   "jp": "う　うるさい\\nオレ様とは逆に\\nお前は鈍感バカだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ebe"
  },
  {
   "id": "m_005003:0x9864",
   "off": 39012,
   "max": 68,
   "kind": "dialogue",
   "jp": "龍馬くんは　鈍感ですが\\nええ　鈍感バカですが\\nその分　純粋ですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x0ebf"
  },
  {
   "id": "m_005003:0x98b8",
   "off": 39096,
   "max": 72,
   "kind": "dialogue",
   "jp": "揺るぎない強い意志を\\n持っていて　仲間を想う\\n熱いロック魂を持っている",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec0"
  },
  {
   "id": "m_005003:0x9f54",
   "off": 40788,
   "max": 48,
   "kind": "dialogue",
   "jp": "センセーにはセンセーの\\nいいところがあるじゃろ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec1"
  },
  {
   "id": "m_005003:0x9f94",
   "off": 40852,
   "max": 76,
   "kind": "dialogue",
   "jp": "一を聞いて五分もわからん\\nもんに　わかりやすく一を\\n教える方法を知っちょる",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec2"
  },
  {
   "id": "m_005003:0x9ff0",
   "off": 40944,
   "max": 60,
   "kind": "dialogue",
   "jp": "一を聞いた奴に二が\\nあることを教えてくれる\\n違うかのう？",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec3"
  },
  {
   "id": "m_005003:0xa7b4",
   "off": 42932,
   "max": 76,
   "kind": "dialogue",
   "jp": "確かに　オレは一を聞いて\\n十どころか百は感じるが\\nそれを人には伝えられない",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec4"
  },
  {
   "id": "m_005003:0xa810",
   "off": 43024,
   "max": 72,
   "kind": "dialogue",
   "jp": "桂さんは一は一と確実に\\n伝える方法を知っている\\nそれは二へと繋がる道だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec5"
  },
  {
   "id": "m_005003:0xaef4",
   "off": 44788,
   "max": 24,
   "kind": "dialogue",
   "jp": "二人とも……ありがとう",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec6"
  },
  {
   "id": "m_005003:0xafb8",
   "off": 44984,
   "max": 64,
   "kind": "dialogue",
   "jp": "私は　二人みたいな\\n才能なんてないし\\n片魂も覚醒しなかった……",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec7"
  },
  {
   "id": "m_005003:0xb008",
   "off": 45064,
   "max": 60,
   "kind": "dialogue",
   "jp": "そんな人間が\\n二人と一緒にいても\\nいいのか　悩んでいました",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec8"
  },
  {
   "id": "m_005003:0xb054",
   "off": 45140,
   "max": 52,
   "kind": "dialogue",
   "jp": "いつ　志士をやめようか\\nそればかり考えていました\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0ec9"
  },
  {
   "id": "m_005003:0xb8e8",
   "off": 47336,
   "max": 24,
   "kind": "dialogue",
   "jp": "な　何言うとるんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x0eca"
  },
  {
   "id": "m_005003:0xc028",
   "off": 49192,
   "max": 44,
   "kind": "dialogue",
   "jp": "そうだ　桂さんの力が\\n無ければオレたちは",
   "en": "",
   "op": "0x62",
   "msg": "0x0ecb"
  },
  {
   "id": "m_005003:0xc6f0",
   "off": 50928,
   "max": 68,
   "kind": "dialogue",
   "jp": "今さらだけど……私を\\n二人の仲間に入れて\\n貰ってもいい……かな？",
   "en": "",
   "op": "0x62",
   "msg": "0x0ecc"
  },
  {
   "id": "m_005003:0xcdb8",
   "off": 52664,
   "max": 56,
   "kind": "dialogue",
   "jp": "片魂も……\\n覚醒してくれたみたいだし\\n力になれると思う",
   "en": "",
   "op": "0x62",
   "msg": "0x0ecd"
  },
  {
   "id": "m_005003:0xd50c",
   "off": 54540,
   "max": 60,
   "kind": "dialogue",
   "jp": "わしより\\nセンセーの方がバカじゃ\\nもう　とっくに仲間ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ece"
  },
  {
   "id": "m_005003:0xdbe4",
   "off": 56292,
   "max": 56,
   "kind": "dialogue",
   "jp": "片魂なんか無くても\\n変わらなかったぜ\\n桂さんは桂さんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ecf"
  },
  {
   "id": "m_005003:0xe2c0",
   "off": 58048,
   "max": 24,
   "kind": "dialogue",
   "jp": "ありがとう\\n……ぐすっ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed0"
  },
  {
   "id": "m_005003:0xe754",
   "off": 59220,
   "max": 40,
   "kind": "dialogue",
   "jp": "今思えば　片魂は――\\nいや　松陰先生は",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed1"
  },
  {
   "id": "m_005003:0xee00",
   "off": 60928,
   "max": 36,
   "kind": "dialogue",
   "jp": "私の弱い心を\\n試していたんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed2"
  },
  {
   "id": "m_005003:0xee34",
   "off": 60980,
   "max": 64,
   "kind": "dialogue",
   "jp": "どんな逆境でも\\n負けず折れず　仲間を想い\\nロックを貫けるかって",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed3"
  },
  {
   "id": "m_005003:0xf590",
   "off": 62864,
   "max": 48,
   "kind": "dialogue",
   "jp": "今はまだ三人じゃ\\nわしらの手は\\nまだまだ小さい",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed4"
  },
  {
   "id": "m_005003:0xfd50",
   "off": 64848,
   "max": 64,
   "kind": "dialogue",
   "jp": "だがのう　この手にゃ\\nロックっちゅう\\nすごい団扇を握っちょる",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed5"
  },
  {
   "id": "m_005003:0xfda0",
   "off": 64928,
   "max": 64,
   "kind": "dialogue",
   "jp": "天狗の団扇みたいに\\n日本を扇いで\\nロックの\\n嵐を巻き起こすぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed6"
  },
  {
   "id": "m_005003:0x106b4",
   "off": 67252,
   "max": 28,
   "kind": "dialogue",
   "jp": "世話になったの\\nお発勢やん",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed7"
  },
  {
   "id": "m_005003:0x10b4c",
   "off": 68428,
   "max": 32,
   "kind": "dialogue",
   "jp": "短い間だったけど\\n楽しかったわ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed8"
  },
  {
   "id": "m_005003:0x10b7c",
   "off": 68476,
   "max": 40,
   "kind": "dialogue",
   "jp": "向こうに戻ったら\\nお登勢によろしくね",
   "en": "",
   "op": "0x62",
   "msg": "0x0ed9"
  },
  {
   "id": "m_005003:0x11240",
   "off": 70208,
   "max": 68,
   "kind": "dialogue",
   "jp": "はい　お登勢さんと\\n同じくらい綺麗な人に\\n会ったって伝えておきます",
   "en": "",
   "op": "0x62",
   "msg": "0x0eda"
  },
  {
   "id": "m_005003:0x11700",
   "off": 71424,
   "max": 60,
   "kind": "dialogue",
   "jp": "まあ　五郎ちゃんたら\\nもう　嬉しすぎて\\nちゅーしちゃうわよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0edb"
  },
  {
   "id": "m_005003:0x11bb8",
   "off": 72632,
   "max": 44,
   "kind": "dialogue",
   "jp": "それなら　逆に\\nこっちから……\\nね　晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x0edc"
  },
  {
   "id": "m_005003:0x123c8",
   "off": 74696,
   "max": 32,
   "kind": "dialogue",
   "jp": "な　なに？\\nなんでオレ様が……",
   "en": "",
   "op": "0x62",
   "msg": "0x0edd"
  },
  {
   "id": "m_005003:0x12a30",
   "off": 76336,
   "max": 68,
   "kind": "dialogue",
   "jp": "お発勢やんに　いっぱい\\n看病してもろおたし\\nそんくらいは恩返しぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ede"
  },
  {
   "id": "m_005003:0x12fe8",
   "off": 77800,
   "max": 40,
   "kind": "dialogue",
   "jp": "断る\\nオレ様はクールで\\n硬派なんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0edf"
  },
  {
   "id": "m_005003:0x1379c",
   "off": 79772,
   "max": 40,
   "kind": "dialogue",
   "jp": "じゃ　やっぱり\\nこっちからしちゃう？",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee0"
  },
  {
   "id": "m_005003:0x13e68",
   "off": 81512,
   "max": 36,
   "kind": "dialogue",
   "jp": "いや……\\nオレ様がして\\nやるぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee1"
  },
  {
   "id": "m_005003:0x14518",
   "off": 83224,
   "max": 32,
   "kind": "dialogue",
   "jp": "世話になった！\\nありがとうっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee2"
  },
  {
   "id": "m_005003:0x14e10",
   "off": 85520,
   "max": 44,
   "kind": "dialogue",
   "jp": "うわー　シンディが\\n真っ赤になってるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee3"
  },
  {
   "id": "m_005003:0x1547c",
   "off": 87164,
   "max": 64,
   "kind": "dialogue",
   "jp": "やぁぁぁぁんっ♪\\n龍ちゃんもいいけど　\\n晋ちゃんもステキ～～！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee4"
  },
  {
   "id": "m_005003:0x15b58",
   "off": 88920,
   "max": 52,
   "kind": "dialogue",
   "jp": "おや　私だけモテませんね\\n寂しいです　お発勢さん\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee5"
  },
  {
   "id": "m_005003:0x16008",
   "off": 90120,
   "max": 32,
   "kind": "dialogue",
   "jp": "五郎ちゃんも\\nイカス～っ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee6"
  },
  {
   "id": "m_005003:0x16acc",
   "off": 92876,
   "max": 28,
   "kind": "dialogue",
   "jp": "ああ\\nやっと京に戻れるか",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee7"
  },
  {
   "id": "m_005003:0x17184",
   "off": 94596,
   "max": 32,
   "kind": "dialogue",
   "jp": "京はどうなって\\nいるでしょうね",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee8"
  },
  {
   "id": "m_005003:0x177ec",
   "off": 96236,
   "max": 44,
   "kind": "dialogue",
   "jp": "お登勢やんの\\nぴっつぁが\\n食べたいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ee9"
  },
  {
   "id": "m_005003:0x17ebc",
   "off": 97980,
   "max": 48,
   "kind": "dialogue",
   "jp": "食い物かよ……\\nくそっ\\nまだ頭がくらくらする",
   "en": "",
   "op": "0x62",
   "msg": "0x0eea"
  },
  {
   "id": "m_005003:0x18368",
   "off": 99176,
   "max": 52,
   "kind": "dialogue",
   "jp": "なんじゃ？\\n鳳舞合奏の影響が\\nまだ残ってるんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0eeb"
  },
  {
   "id": "m_005003:0x18818",
   "off": 100376,
   "max": 60,
   "kind": "dialogue",
   "jp": "オレ様は　繊細だからな\\nそういう　お前は\\nピンピンしてるな",
   "en": "",
   "op": "0x62",
   "msg": "0x0eec"
  },
  {
   "id": "m_005003:0x18fdc",
   "off": 102364,
   "max": 76,
   "kind": "dialogue",
   "jp": "龍馬くん　沖田くんの天歌\\nちゃんと聴いてなかった\\nようですが　何故ですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x0eed"
  },
  {
   "id": "m_005003:0x196c0",
   "off": 104128,
   "max": 40,
   "kind": "dialogue",
   "jp": "ソウちんの様子が変\\nじゃったから……",
   "en": "",
   "op": "0x62",
   "msg": "0x0eee"
  },
  {
   "id": "m_005003:0x196f8",
   "off": 104184,
   "max": 44,
   "kind": "dialogue",
   "jp": "それにあれはわしの\\n好きな音楽と違うとった",
   "en": "",
   "op": "0x62",
   "msg": "0x0eef"
  },
  {
   "id": "m_005003:0x19d68",
   "off": 105832,
   "max": 64,
   "kind": "dialogue",
   "jp": "このバカ　ロックにしか\\n興味が無いってのは\\n本当だったんだな",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef0"
  },
  {
   "id": "m_005003:0x1a318",
   "off": 107288,
   "max": 32,
   "kind": "dialogue",
   "jp": "おうっ\\nロックは最高ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef1"
  },
  {
   "id": "m_005003:0x1a858",
   "off": 108632,
   "max": 64,
   "kind": "dialogue",
   "jp": "ああ……頭が痛い\\n元はといえば　新選組の\\nあの野郎のせいだ……",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef2"
  },
  {
   "id": "m_005003:0x1a8a8",
   "off": 108712,
   "max": 60,
   "kind": "dialogue",
   "jp": "人のことを変な呼び方\\nしやがって\\n本当にムカつく野郎だった",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef3"
  },
  {
   "id": "m_005003:0x1b068",
   "off": 110696,
   "max": 64,
   "kind": "dialogue",
   "jp": "ソウちんも今は\\nおかしゅうなっちょるが\\n根はいいヤツじゃと思う",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef4"
  },
  {
   "id": "m_005003:0x1b744",
   "off": 112452,
   "max": 56,
   "kind": "dialogue",
   "jp": "龍馬くんはすごいですね\\n彼に殺されかけたって\\nいうのに",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef5"
  },
  {
   "id": "m_005003:0x1be14",
   "off": 114196,
   "max": 72,
   "kind": "dialogue",
   "jp": "ソウちんは踊りも達者だし\\n何より　いい歌を……\\nロックを歌ったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef6"
  },
  {
   "id": "m_005003:0x1be6c",
   "off": 114284,
   "max": 40,
   "kind": "dialogue",
   "jp": "そんなヤツが\\n悪いヤツなわけがないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef7"
  },
  {
   "id": "m_005003:0x1c67c",
   "off": 116348,
   "max": 8,
   "kind": "dialogue",
   "jp": "は？",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef8"
  },
  {
   "id": "m_005003:0x1ce0c",
   "off": 118284,
   "max": 40,
   "kind": "dialogue",
   "jp": "ソウちんも　根は\\n音楽を愛しとるんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x0ef9"
  },
  {
   "id": "m_005003:0x1ce44",
   "off": 118340,
   "max": 44,
   "kind": "dialogue",
   "jp": "だったら　きっと\\nわかり合えるはずぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x0efa"
  },
  {
   "id": "m_005003:0x1d50c",
   "off": 120076,
   "max": 40,
   "kind": "dialogue",
   "jp": "こいつ　バカだな\\nああ　すごい大バカだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0efb"
  },
  {
   "id": "m_005003:0x1de48",
   "off": 122440,
   "max": 68,
   "kind": "dialogue",
   "jp": "……いくら何でも無理が\\n幕府直属の愛獲　新選組\\n一番隊組長ですよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0efc"
  },
  {
   "id": "m_005003:0x1e37c",
   "off": 123772,
   "max": 36,
   "kind": "dialogue",
   "jp": "新選組も何もあるかよ\\n同じ人間じゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x0efd"
  },
  {
   "id": "m_005003:0x1e8b8",
   "off": 125112,
   "max": 68,
   "kind": "dialogue",
   "jp": "沖田くんとわかり合う　か\\n天地がひっくり返っても\\n難しそうですね",
   "en": "",
   "op": "0x62",
   "msg": "0x0efe"
  },
  {
   "id": "m_005003:0x1f1f4",
   "off": 127476,
   "max": 60,
   "kind": "dialogue",
   "jp": "じゃ　わしが天地を\\nひっくり返してやるぜよ！\\nロックで！",
   "en": "",
   "op": "0x62",
   "msg": "0x0eff"
  },
  {
   "id": "m_005003:0x1f95c",
   "off": 129372,
   "max": 24,
   "kind": "dialogue",
   "jp": "龍馬くんは\\n大物ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x0f00"
  },
  {
   "id": "m_005003:0x20010",
   "off": 131088,
   "max": 68,
   "kind": "dialogue",
   "jp": "違う　大バカなだけだ\\n行くぞ桂さん　こんな奴\\n相手にしてられるか",
   "en": "",
   "op": "0x62",
   "msg": "0x0f01"
  },
  {
   "id": "m_005003:0x20698",
   "off": 132760,
   "max": 48,
   "kind": "dialogue",
   "jp": "だが……\\n沖田が持つ片魂が悪用\\nされているなら",
   "en": "",
   "op": "0x62",
   "msg": "0x0f02"
  },
  {
   "id": "m_005003:0x206d8",
   "off": 132824,
   "max": 24,
   "kind": "dialogue",
   "jp": "なんとか　止めないと！",
   "en": "",
   "op": "0x62",
   "msg": "0x0f03"
  },
  {
   "id": "m_005003:0x21120",
   "off": 135456,
   "max": 44,
   "kind": "dialogue",
   "jp": "ね　ね　土方さん\\n彦根で面白い奴に会ったよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f04"
  },
  {
   "id": "m_005003:0x2115c",
   "off": 135516,
   "max": 56,
   "kind": "dialogue",
   "jp": "なんとね　近藤さんの\\nお気に入り\\n坂本龍馬さま御一行～",
   "en": "",
   "op": "0x62",
   "msg": "0x0f05"
  },
  {
   "id": "m_005003:0x2194c",
   "off": 137548,
   "max": 44,
   "kind": "dialogue",
   "jp": "お尋ね者の坂本達か\\nなぜ捕まえなかった？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f06"
  },
  {
   "id": "m_005003:0x21a28",
   "off": 137768,
   "max": 32,
   "kind": "dialogue",
   "jp": "見逃したのでは\\nないだろうな",
   "en": "",
   "op": "0x62",
   "msg": "0x0f07"
  },
  {
   "id": "m_005003:0x22224",
   "off": 139812,
   "max": 56,
   "kind": "dialogue",
   "jp": "僕の今回の仕事は\\n井伊様の極秘計画の\\n総仕上げだよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f08"
  },
  {
   "id": "m_005003:0x2226c",
   "off": 139884,
   "max": 48,
   "kind": "dialogue",
   "jp": "だいたい\\nお尋ね者の捕縛は\\n僕の仕事じゃないし",
   "en": "",
   "op": "0x62",
   "msg": "0x0f09"
  },
  {
   "id": "m_005003:0x22344",
   "off": 140100,
   "max": 36,
   "kind": "dialogue",
   "jp": "なんてね\\nロックで\\nやられちゃった",
   "en": "",
   "op": "0x62",
   "msg": "0x0f0a"
  },
  {
   "id": "m_005003:0x227e4",
   "off": 141284,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前　本気で\\n立ち向かったのか？\\n総司",
   "en": "",
   "op": "0x62",
   "msg": "0x0f0b"
  },
  {
   "id": "m_005003:0x22f90",
   "off": 143248,
   "max": 64,
   "kind": "dialogue",
   "jp": "あ～あ　土方さん怒ってる\\nやっぱり斬ってくれば\\n良かったかも～",
   "en": "",
   "op": "0x62",
   "msg": "0x0f0c"
  },
  {
   "id": "m_005003:0x2366c",
   "off": 145004,
   "max": 32,
   "kind": "dialogue",
   "jp": "それも止めろと\\n言ったはずだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f0d"
  },
  {
   "id": "m_005003:0x23d24",
   "off": 146724,
   "max": 68,
   "kind": "dialogue",
   "jp": "はいはいわかってます\\n近藤さんが　そういうの\\n好きじゃないもんね～",
   "en": "",
   "op": "0x62",
   "msg": "0x0f0e"
  },
  {
   "id": "m_005003:0x243ac",
   "off": 148396,
   "max": 80,
   "kind": "dialogue",
   "jp": "土方さんも　誰も斬ったり\\n斬られたりしない　平和な\\n世の中がいいんですよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f0f"
  },
  {
   "id": "m_005003:0x24878",
   "off": 149624,
   "max": 32,
   "kind": "dialogue",
   "jp": "俺は近藤さんほど\\n優しくはない",
   "en": "",
   "op": "0x62",
   "msg": "0x0f10"
  },
  {
   "id": "m_005003:0x248a8",
   "off": 149672,
   "max": 56,
   "kind": "dialogue",
   "jp": "必要があるから斬る\\n必要が無いから斬らない\\nそれだけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f11"
  },
  {
   "id": "m_005003:0x251d0",
   "off": 152016,
   "max": 48,
   "kind": "dialogue",
   "jp": "でも必要があれば隊士でも\\n斬っちゃうんですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x0f12"
  },
  {
   "id": "m_005003:0x25ba0",
   "off": 154528,
   "max": 44,
   "kind": "dialogue",
   "jp": "お前も\\nその隊士の一人だった\\nはずだが？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f13"
  },
  {
   "id": "m_005003:0x26388",
   "off": 156552,
   "max": 48,
   "kind": "dialogue",
   "jp": "土方さん\\n顔が怖いですって\\nイライラしてます？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f14"
  },
  {
   "id": "m_005003:0x26460",
   "off": 156768,
   "max": 40,
   "kind": "dialogue",
   "jp": "僕の歌　聴きます？\\n心が落ち着きますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f15"
  },
  {
   "id": "m_005003:0x26acc",
   "off": 158412,
   "max": 8,
   "kind": "dialogue",
   "jp": "いらん",
   "en": "",
   "op": "0x62",
   "msg": "0x0f16"
  },
  {
   "id": "m_005003:0x26f50",
   "off": 159568,
   "max": 68,
   "kind": "dialogue",
   "jp": "誰かを殺したいとか\\n傷つけたいとか　乱暴な\\n気持ちは吹き飛びますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f17"
  },
  {
   "id": "m_005003:0x27418",
   "off": 160792,
   "max": 32,
   "kind": "dialogue",
   "jp": "……そんな歌\\nあるものか……",
   "en": "",
   "op": "0x62",
   "msg": "0x0f18"
  },
  {
   "id": "m_005003:0x27bc8",
   "off": 162760,
   "max": 64,
   "kind": "dialogue",
   "jp": "もし　あるのなら\\n誰かが殺され　俺も誰かを\\n殺したいなどと……",
   "en": "",
   "op": "0x62",
   "msg": "0x0f19"
  },
  {
   "id": "m_005003:0x27c18",
   "off": 162840,
   "max": 40,
   "kind": "dialogue",
   "jp": "そんなものに\\n取り憑かれはしなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x0f1a"
  },
  {
   "id": "m_005003:0x288b4",
   "off": 166068,
   "max": 40,
   "kind": "dialogue",
   "jp": "た　助けてくれ\\n金でも宝でも何でもやる",
   "en": "",
   "op": "0x62",
   "msg": "0x0f1b"
  },
  {
   "id": "m_005003:0x28d5c",
   "off": 167260,
   "max": 52,
   "kind": "dialogue",
   "jp": "そんなものいらん\\nオレが欲しいのは\\n下衆の悲鳴だ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f1c"
  },
  {
   "id": "m_005003:0x29618",
   "off": 169496,
   "max": 44,
   "kind": "dialogue",
   "jp": "……この一撃は母の痛み\\nこれは父の痛みだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f1d"
  },
  {
   "id": "m_005003:0x29ecc",
   "off": 171724,
   "max": 72,
   "kind": "dialogue",
   "jp": "すぐには殺してやらん\\n一撃喰らわされるごとに\\n思い知れ……お前の罪を",
   "en": "",
   "op": "0x62",
   "msg": "0x0f1e"
  },
  {
   "id": "m_005003:0x2a9b4",
   "off": 174516,
   "max": 24,
   "kind": "dialogue",
   "jp": "……ふん\\nもう死んだか",
   "en": "",
   "op": "0x62",
   "msg": "0x0f1f"
  },
  {
   "id": "m_005003:0x2ae4c",
   "off": 175692,
   "max": 72,
   "kind": "dialogue",
   "jp": "まだだ……まだ足りない\\nこの程度の悲鳴の数では\\n父も母も癒されない……",
   "en": "",
   "op": "0x62",
   "msg": "0x0f20"
  },
  {
   "id": "m_005003:0x2aea8",
   "off": 175784,
   "max": 48,
   "kind": "dialogue",
   "jp": "もっと……\\nもっとだ！\\nもっと　殺してやる",
   "en": "",
   "op": "0x62",
   "msg": "0x0f21"
  },
  {
   "id": "m_005003:0x2aeec",
   "off": 175852,
   "max": 44,
   "kind": "dialogue",
   "jp": "……ふふふ　はははは\\nはーっはっはっは",
   "en": "",
   "op": "0x62",
   "msg": "0x0f22"
  },
  {
   "id": "m_005003:0x2b890",
   "off": 178320,
   "max": 20,
   "kind": "dialogue",
   "jp": "……さん\\n土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x0f23"
  },
  {
   "id": "m_005003:0x2c09c",
   "off": 180380,
   "max": 12,
   "kind": "dialogue",
   "jp": "なんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f24"
  },
  {
   "id": "m_005003:0x2c524",
   "off": 181540,
   "max": 52,
   "kind": "dialogue",
   "jp": "なんだか急に\\n黙っちゃったから\\n心配しちゃいました",
   "en": "",
   "op": "0x62",
   "msg": "0x0f25"
  },
  {
   "id": "m_005003:0x2ca7c",
   "off": 182908,
   "max": 60,
   "kind": "dialogue",
   "jp": "近藤さんの願う世が\\n早く来ればいい……\\nそう思っただけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f26"
  },
  {
   "id": "m_005003:0x2cf34",
   "off": 184116,
   "max": 20,
   "kind": "dialogue",
   "jp": "僕もそう思います",
   "en": "",
   "op": "0x62",
   "msg": "0x0f27"
  },
  {
   "id": "m_005003:0x2d6d0",
   "off": 186064,
   "max": 64,
   "kind": "dialogue",
   "jp": "で　何人斬ったんだ？\\n表向きは飢饉と流行病と\\nなっているが？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f28"
  },
  {
   "id": "m_005003:0x2dda8",
   "off": 187816,
   "max": 64,
   "kind": "dialogue",
   "jp": "酷いな土方さん\\n僕　抜刀こそしたけど\\n一人も斬ってないですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f29"
  },
  {
   "id": "m_005003:0x2ddf8",
   "off": 187896,
   "max": 44,
   "kind": "dialogue",
   "jp": "誰か死んだらいつも\\n僕のせいってひどいなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f2a"
  },
  {
   "id": "m_005003:0x2e468",
   "off": 189544,
   "max": 32,
   "kind": "dialogue",
   "jp": "報告では尋常な\\n数じゃないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f2b"
  },
  {
   "id": "m_005003:0x2e99c",
   "off": 190876,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方さんってかんだ\\n鼻紙の数をかぞえる\\n人でしたっけ？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f2c"
  },
  {
   "id": "m_005003:0x2e9e4",
   "off": 190948,
   "max": 76,
   "kind": "dialogue",
   "jp": "ゴミはゴミ　クズはクズ\\n土方さんが一番そういうの\\n知ってるはずだけどな～",
   "en": "",
   "op": "0x62",
   "msg": "0x0f2d"
  },
  {
   "id": "m_005003:0x2f438",
   "off": 193592,
   "max": 56,
   "kind": "dialogue",
   "jp": "俺はゴミもクズも\\nゴミ箱に捨てる\\n……お前と違ってな！",
   "en": "",
   "op": "0x62",
   "msg": "0x0f2e"
  },
  {
   "id": "m_005003:0x2fd70",
   "off": 195952,
   "max": 60,
   "kind": "dialogue",
   "jp": "あれれ？　顔が怖いですよ\\n怒ってます？\\n怒ってますよね！\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x0f2f"
  },
  {
   "id": "m_005003:0x2fdbc",
   "off": 196028,
   "max": 80,
   "kind": "dialogue",
   "jp": "あれは　鳳舞合奏が気持ち\\nよすぎてそうなっただけで\\n僕のせいじゃないですよ～",
   "en": "",
   "op": "0x62",
   "msg": "0x0f30"
  },
  {
   "id": "m_005003:0x30324",
   "off": 197412,
   "max": 56,
   "kind": "dialogue",
   "jp": "歌がどうやって人を殺すと\\n言うんだ\\n馬鹿も休み休み言え",
   "en": "",
   "op": "0x62",
   "msg": "0x0f31"
  },
  {
   "id": "m_005003:0x30870",
   "off": 198768,
   "max": 64,
   "kind": "dialogue",
   "jp": "鳳舞合奏はただの天歌じゃ\\nないんです\\nすっごく気持ちいいんです",
   "en": "",
   "op": "0x62",
   "msg": "0x0f32"
  },
  {
   "id": "m_005003:0x312b4",
   "off": 201396,
   "max": 44,
   "kind": "dialogue",
   "jp": "すっごく……\\nよくなれるんですよ\\n土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x0f33"
  },
  {
   "id": "m_005003:0x318a8",
   "off": 202920,
   "max": 44,
   "kind": "dialogue",
   "jp": "沖田の蠱惑的な笑みに\\n土方は一瞬たじろぐ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f34"
  },
  {
   "id": "m_005003:0x318e4",
   "off": 202980,
   "max": 68,
   "kind": "dialogue",
   "jp": "修羅の道　羅刹の街道を\\n歩んできた土方の\\n背筋を冷たい物が伝った",
   "en": "",
   "op": "0x62",
   "msg": "0x0f35"
  },
  {
   "id": "m_005003:0x31ee0",
   "off": 204512,
   "max": 64,
   "kind": "dialogue",
   "jp": "総司……お前が井伊様から\\n託された密命とは\\n一体どういうものだ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f36"
  },
  {
   "id": "m_005003:0x32780",
   "off": 206720,
   "max": 24,
   "kind": "dialogue",
   "jp": "知ってどうするんです？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f37"
  },
  {
   "id": "m_005003:0x32c14",
   "off": 207892,
   "max": 16,
   "kind": "dialogue",
   "jp": "あ　でも……",
   "en": "",
   "op": "0x62",
   "msg": "0x0f38"
  },
  {
   "id": "m_005003:0x33138",
   "off": 209208,
   "max": 52,
   "kind": "dialogue",
   "jp": "すっごい\\nお仕置してくれたら\\n思わず言っちゃうかも",
   "en": "",
   "op": "0x62",
   "msg": "0x0f39"
  },
  {
   "id": "m_005003:0x33518",
   "off": 210200,
   "max": 40,
   "kind": "dialogue",
   "jp": "沖田の無邪気な笑顔に\\n土方は嘆息する",
   "en": "",
   "op": "0x62",
   "msg": "0x0f3a"
  },
  {
   "id": "m_005003:0x338e4",
   "off": 211172,
   "max": 24,
   "kind": "dialogue",
   "jp": "…………\\n俺の杞憂か",
   "en": "",
   "op": "0x62",
   "msg": "0x0f3b"
  },
  {
   "id": "m_005003:0x34084",
   "off": 213124,
   "max": 40,
   "kind": "dialogue",
   "jp": "それは　近藤さんの\\n望むものなんだな？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f3c"
  },
  {
   "id": "m_005003:0x340bc",
   "off": 213180,
   "max": 56,
   "kind": "dialogue",
   "jp": "やり方はどうあれ\\n新選組の理念には\\n反していないな？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f3d"
  },
  {
   "id": "m_005003:0x3478c",
   "off": 214924,
   "max": 16,
   "kind": "dialogue",
   "jp": "もちろんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f3e"
  },
  {
   "id": "m_005003:0x34f78",
   "off": 216952,
   "max": 68,
   "kind": "dialogue",
   "jp": "オレたちはあの日誓った\\n近藤さんのために\\n生きて　そのために死ぬと",
   "en": "",
   "op": "0x62",
   "msg": "0x0f3f"
  },
  {
   "id": "m_005003:0x35438",
   "off": 218168,
   "max": 44,
   "kind": "dialogue",
   "jp": "土方さんが拾って\\n近藤さんが救ってくれた",
   "en": "",
   "op": "0x62",
   "msg": "0x0f40"
  },
  {
   "id": "m_005003:0x35474",
   "off": 218228,
   "max": 32,
   "kind": "dialogue",
   "jp": "あの日のことを\\n僕は忘れません",
   "en": "",
   "op": "0x62",
   "msg": "0x0f41"
  },
  {
   "id": "m_005003:0x35910",
   "off": 219408,
   "max": 60,
   "kind": "dialogue",
   "jp": "……ならばいい\\n一応　近藤さんには\\n密命のことは黙っておけ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f42"
  },
  {
   "id": "m_005003:0x359f8",
   "off": 219640,
   "max": 32,
   "kind": "dialogue",
   "jp": "流石に　人死にが\\n出すぎている",
   "en": "",
   "op": "0x62",
   "msg": "0x0f43"
  },
  {
   "id": "m_005003:0x3619c",
   "off": 221596,
   "max": 72,
   "kind": "dialogue",
   "jp": "ええ……わかっています\\n近藤さんの悲しむ顔は\\n僕は見たくないですから",
   "en": "",
   "op": "0x62",
   "msg": "0x0f44"
  },
  {
   "id": "m_005003:0x36880",
   "off": 223360,
   "max": 64,
   "kind": "dialogue",
   "jp": "新選組の仕事は綺麗なもの\\nばかりじゃないと\\n知って欲しくない",
   "en": "",
   "op": "0x62",
   "msg": "0x0f45"
  },
  {
   "id": "m_005003:0x3709c",
   "off": 225436,
   "max": 68,
   "kind": "dialogue",
   "jp": "あ　でも……トサカくん\\n坂本龍馬に会ったことは\\n話して良いですよね",
   "en": "",
   "op": "0x62",
   "msg": "0x0f46"
  },
  {
   "id": "m_005003:0x375f8",
   "off": 226808,
   "max": 44,
   "kind": "dialogue",
   "jp": "やれやれ……あいつらは\\nお尋ね者なんだがな",
   "en": "",
   "op": "0x62",
   "msg": "0x0f47"
  },
  {
   "id": "m_005003:0x37634",
   "off": 226868,
   "max": 40,
   "kind": "dialogue",
   "jp": "また雷舞に乱入された\\nとでも言っておけ",
   "en": "",
   "op": "0x62",
   "msg": "0x0f48"
  },
  {
   "id": "m_005003:0x37b70",
   "off": 228208,
   "max": 40,
   "kind": "dialogue",
   "jp": "ふふっ　近藤さん\\n喜んでくれますよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x0f49"
  },
  {
   "id": "m_005003:0x380b0",
   "off": 229552,
   "max": 52,
   "kind": "dialogue",
   "jp": "きっと　自分も見たかった\\nそう　言い出すだろうな",
   "en": "",
   "op": "0x62",
   "msg": "0x0f4a"
  },
  {
   "id": "m_005003:0x38490",
   "off": 230544,
   "max": 76,
   "kind": "dialogue",
   "jp": "鬼の副長の顔がふっと緩む\\n近藤と沖田にしか見せない\\n本当の土方の笑顔……",
   "en": "",
   "op": "0x62",
   "msg": "0x0f4b"
  },
  {
   "id": "m_005003:0x387e4",
   "off": 231396,
   "max": 60,
   "kind": "dialogue",
   "jp": "さっそく土産を\\n届けがてら　ついでに\\n報告してきますね！",
   "en": "",
   "op": "0x62",
   "msg": "0x0f4c"
  },
  {
   "id": "m_005003:0x38ea8",
   "off": 233128,
   "max": 56,
   "kind": "dialogue",
   "jp": "……ったく\\nしょうがない奴だな\\n土産がついでだろうに",
   "en": "",
   "op": "0x62",
   "msg": "0x0f4d"
  },
  {
   "id": "m_005003:0x38ef0",
   "off": 233200,
   "max": 68,
   "kind": "dialogue",
   "jp": "例え何があろうと\\n近藤さんがオレたちの光\\n総司はオレの守るべき弟",
   "en": "",
   "op": "0x62",
   "msg": "0x0f4e"
  },
  {
   "id": "m_005003:0x38f44",
   "off": 233284,
   "max": 24,
   "kind": "dialogue",
   "jp": "それだけは変わらない",
   "en": "",
   "op": "0x62",
   "msg": "0x0f4f"
  },
  {
   "id": "m_005003:0x39484",
   "off": 234628,
   "max": 68,
   "kind": "dialogue",
   "jp": "……本当はオレが汚れを\\nすべて引き受けられたら\\nいいんだがな……",
   "en": "",
   "op": "0x62",
   "msg": "0x0f50"
  }
 ]
}
