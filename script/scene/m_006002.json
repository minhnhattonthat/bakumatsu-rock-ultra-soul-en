{
 "source": "m_006002.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_006002:0x1630",
   "off": 5680,
   "max": 36,
   "kind": "dialogue",
   "jp": "坂本龍馬殿\\n高杉晋作殿\\n桂小五郎殿",
   "en": "",
   "op": "0x62",
   "msg": "0x1059"
  },
  {
   "id": "m_006002:0x1664",
   "off": 5732,
   "max": 28,
   "kind": "dialogue",
   "jp": "我が御前試合に\\nようこそ",
   "en": "",
   "op": "0x62",
   "msg": "0x105a"
  },
  {
   "id": "m_006002:0x1d9c",
   "off": 7580,
   "max": 52,
   "kind": "dialogue",
   "jp": "うん？\\nあんたがわしらを招待\\nしてくれたお人か？",
   "en": "",
   "op": "0x62",
   "msg": "0x105b"
  },
  {
   "id": "m_006002:0x2414",
   "off": 9236,
   "max": 24,
   "kind": "dialogue",
   "jp": "そうです\\n私は井伊直弼",
   "en": "",
   "op": "0x62",
   "msg": "0x105c"
  },
  {
   "id": "m_006002:0x243c",
   "off": 9276,
   "max": 56,
   "kind": "dialogue",
   "jp": "徳川慶喜様の命により\\nこの御前試合を仕切って\\nおります",
   "en": "",
   "op": "0x62",
   "msg": "0x105d"
  },
  {
   "id": "m_006002:0x2988",
   "off": 10632,
   "max": 32,
   "kind": "dialogue",
   "jp": "う……\\n徳川家大老\\n井伊直弼か",
   "en": "",
   "op": "0x62",
   "msg": "0x105e"
  },
  {
   "id": "m_006002:0x2e24",
   "off": 11812,
   "max": 8,
   "kind": "dialogue",
   "jp": "はい",
   "en": "",
   "op": "0x62",
   "msg": "0x105f"
  },
  {
   "id": "m_006002:0x37e8",
   "off": 14312,
   "max": 56,
   "kind": "dialogue",
   "jp": "こいつはなんじゃ？\\n底知れない力を\\nビシビシ感じる……",
   "en": "",
   "op": "0x62",
   "msg": "0x1060"
  },
  {
   "id": "m_006002:0x3830",
   "off": 14384,
   "max": 40,
   "kind": "dialogue",
   "jp": "背筋が寒くなって\\n尻がビリビリしてきた",
   "en": "",
   "op": "0x62",
   "msg": "0x1061"
  },
  {
   "id": "m_006002:0x3870",
   "off": 14448,
   "max": 36,
   "kind": "dialogue",
   "jp": "テラーダで感じたのと\\n同じ感じ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1062"
  },
  {
   "id": "m_006002:0x41a4",
   "off": 16804,
   "max": 12,
   "kind": "dialogue",
   "jp": "なにか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1063"
  },
  {
   "id": "m_006002:0x4634",
   "off": 17972,
   "max": 28,
   "kind": "dialogue",
   "jp": "あ　いやあ\\nなんでもない",
   "en": "",
   "op": "0x62",
   "msg": "0x1064"
  },
  {
   "id": "m_006002:0x4b68",
   "off": 19304,
   "max": 56,
   "kind": "dialogue",
   "jp": "怖じ気付いたのなら\\nここで引き返す道も\\nありましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x1065"
  },
  {
   "id": "m_006002:0x4bb0",
   "off": 19376,
   "max": 64,
   "kind": "dialogue",
   "jp": "あなた方が尻尾を巻いて\\n逃げたところで\\n恥ではありませんよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1066"
  },
  {
   "id": "m_006002:0x53d4",
   "off": 21460,
   "max": 52,
   "kind": "dialogue",
   "jp": "なんだと！\\nここまで来て\\n逃げるわけがねぇだろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1067"
  },
  {
   "id": "m_006002:0x5ab0",
   "off": 23216,
   "max": 24,
   "kind": "dialogue",
   "jp": "そうじゃ\\nそうじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1068"
  },
  {
   "id": "m_006002:0x6164",
   "off": 24932,
   "max": 48,
   "kind": "dialogue",
   "jp": "二人とも　落ち着いて\\n声を荒げたら失礼ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1069"
  },
  {
   "id": "m_006002:0x6874",
   "off": 26740,
   "max": 44,
   "kind": "dialogue",
   "jp": "御大老様\\nご招待ありがとう\\nございました",
   "en": "",
   "op": "0x62",
   "msg": "0x106a"
  },
  {
   "id": "m_006002:0x68b0",
   "off": 26800,
   "max": 76,
   "kind": "dialogue",
   "jp": "お心遣い痛み入りますが\\n心配には及びませんので\\n精一杯演じさせて頂きます",
   "en": "",
   "op": "0x62",
   "msg": "0x106b"
  },
  {
   "id": "m_006002:0x6e14",
   "off": 28180,
   "max": 28,
   "kind": "dialogue",
   "jp": "はははは\\nそれは頼もしい",
   "en": "",
   "op": "0x62",
   "msg": "0x106c"
  },
  {
   "id": "m_006002:0x6e40",
   "off": 28224,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうそう　坂本殿",
   "en": "",
   "op": "0x62",
   "msg": "0x106d"
  },
  {
   "id": "m_006002:0x7634",
   "off": 30260,
   "max": 16,
   "kind": "dialogue",
   "jp": "な　なんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x106e"
  },
  {
   "id": "m_006002:0x7c90",
   "off": 31888,
   "max": 48,
   "kind": "dialogue",
   "jp": "慶喜様もあなた方を\\nたいそう気にして\\nおいでだ",
   "en": "",
   "op": "0x62",
   "msg": "0x106f"
  },
  {
   "id": "m_006002:0x8560",
   "off": 34144,
   "max": 44,
   "kind": "dialogue",
   "jp": "今日の御前試合は\\n精一杯力を尽くすように",
   "en": "",
   "op": "0x62",
   "msg": "0x1070"
  },
  {
   "id": "m_006002:0x859c",
   "off": 34204,
   "max": 24,
   "kind": "dialogue",
   "jp": "楽しみにしていますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1071"
  },
  {
   "id": "m_006002:0x8eac",
   "off": 36524,
   "max": 48,
   "kind": "dialogue",
   "jp": "なあ　シンディ\\nセンセー\\nあいつは何者じゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1072"
  },
  {
   "id": "m_006002:0x8eec",
   "off": 36588,
   "max": 40,
   "kind": "dialogue",
   "jp": "ただならぬ気配を\\nまとってて気味が悪い",
   "en": "",
   "op": "0x62",
   "msg": "0x1073"
  },
  {
   "id": "m_006002:0x9558",
   "off": 38232,
   "max": 52,
   "kind": "dialogue",
   "jp": "井伊直弼といやあ\\n徳川慶喜直下の\\n切れ者って噂だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1074"
  },
  {
   "id": "m_006002:0x959c",
   "off": 38300,
   "max": 52,
   "kind": "dialogue",
   "jp": "あの若さで大老だぜ\\nただ者じゃねえのは\\n間違いねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x1075"
  },
  {
   "id": "m_006002:0x9a4c",
   "off": 39500,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしが言いたいのは\\nそんな事じゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x1076"
  },
  {
   "id": "m_006002:0x9a84",
   "off": 39556,
   "max": 60,
   "kind": "dialogue",
   "jp": "ドロドロとした\\nこう　なんちゅうか\\n黒い力を感じたんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1077"
  },
  {
   "id": "m_006002:0x9ad0",
   "off": 39632,
   "max": 40,
   "kind": "dialogue",
   "jp": "背筋は寒くなるし\\n胸が疼くんじゃ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1078"
  },
  {
   "id": "m_006002:0x9f74",
   "off": 40820,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんだ龍馬\\n今さら\\n怖じ気付いたのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1079"
  },
  {
   "id": "m_006002:0xa724",
   "off": 42788,
   "max": 52,
   "kind": "dialogue",
   "jp": "だからこれは罠だって\\n最初に言ったじゃない\\nですか",
   "en": "",
   "op": "0x62",
   "msg": "0x107a"
  },
  {
   "id": "m_006002:0xadf0",
   "off": 44528,
   "max": 56,
   "kind": "dialogue",
   "jp": "違うんじゃ\\nシンディ　センセー\\n怖じ気付いてはおらん",
   "en": "",
   "op": "0x62",
   "msg": "0x107b"
  },
  {
   "id": "m_006002:0xae38",
   "off": 44600,
   "max": 60,
   "kind": "dialogue",
   "jp": "あいつは人と違う\\n得体の知れん力が\\n秘められているんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x107c"
  },
  {
   "id": "m_006002:0xb654",
   "off": 46676,
   "max": 48,
   "kind": "dialogue",
   "jp": "ほらみろ　やっぱり\\n怖じ気付いてんじゃねえか",
   "en": "",
   "op": "0x62",
   "msg": "0x107d"
  },
  {
   "id": "m_006002:0xbb00",
   "off": 47872,
   "max": 52,
   "kind": "dialogue",
   "jp": "井伊にはなんらかの\\n思惑があっての\\n招待ですからね",
   "en": "",
   "op": "0x62",
   "msg": "0x107e"
  },
  {
   "id": "m_006002:0xbb44",
   "off": 47940,
   "max": 52,
   "kind": "dialogue",
   "jp": "なんであれ\\n警戒しておくに\\nこしたことはないですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x107f"
  },
  {
   "id": "m_006002:0xc304",
   "off": 49924,
   "max": 28,
   "kind": "dialogue",
   "jp": "ううう\\nわかってもらえんな",
   "en": "",
   "op": "0x62",
   "msg": "0x1080"
  },
  {
   "id": "m_006002:0xc338",
   "off": 49976,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんじゃろうな\\nこの気色悪さは",
   "en": "",
   "op": "0x62",
   "msg": "0x1081"
  },
  {
   "id": "m_006002:0xc368",
   "off": 50024,
   "max": 40,
   "kind": "dialogue",
   "jp": "気合いをいれんと\\n呑まれてしまうぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1082"
  },
  {
   "id": "m_006002:0xc9dc",
   "off": 51676,
   "max": 36,
   "kind": "dialogue",
   "jp": "よし　オレ様が\\n気合いを入れてやる",
   "en": "",
   "op": "0x62",
   "msg": "0x1083"
  },
  {
   "id": "m_006002:0xce7c",
   "off": 52860,
   "max": 12,
   "kind": "dialogue",
   "jp": "うりゃっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1084"
  },
  {
   "id": "m_006002:0xd5ac",
   "off": 54700,
   "max": 28,
   "kind": "dialogue",
   "jp": "ふぎゃっ！\\nし……心臓が",
   "en": "",
   "op": "0x62",
   "msg": "0x1085"
  },
  {
   "id": "m_006002:0xda44",
   "off": 55876,
   "max": 44,
   "kind": "dialogue",
   "jp": "気合い入れだ\\n胸のモゾモゾは\\n治ったか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1086"
  },
  {
   "id": "m_006002:0xdf8c",
   "off": 57228,
   "max": 40,
   "kind": "dialogue",
   "jp": "おっ？\\n言われて見れば\\nなおったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1087"
  },
  {
   "id": "m_006002:0xe9b4",
   "off": 59828,
   "max": 64,
   "kind": "dialogue",
   "jp": "おっしゃああ！\\nガンガンシャウトして\\n嫌な気分を振り切るぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1088"
  },
  {
   "id": "m_006002:0xf1cc",
   "off": 61900,
   "max": 36,
   "kind": "dialogue",
   "jp": "センセー\\nわしらの出番はいつじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1089"
  },
  {
   "id": "m_006002:0xf200",
   "off": 61952,
   "max": 44,
   "kind": "dialogue",
   "jp": "天気が悪くなりそうで\\nはよ終わらせたいぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x108a"
  },
  {
   "id": "m_006002:0xf6a8",
   "off": 63144,
   "max": 60,
   "kind": "dialogue",
   "jp": "私達は後になりますね\\n招待されると客扱いに\\nなりますから",
   "en": "",
   "op": "0x62",
   "msg": "0x108b"
  },
  {
   "id": "m_006002:0xfb60",
   "off": 64352,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうか　後組か\\nシンディもセンセーも\\nよろしく頼むぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x108c"
  },
  {
   "id": "m_006002:0x10238",
   "off": 66104,
   "max": 72,
   "kind": "dialogue",
   "jp": "偉そうに言うんじゃねえ\\nお前こそオレ様のロックに\\nついてこれるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x108d"
  },
  {
   "id": "m_006002:0x106fc",
   "off": 67324,
   "max": 48,
   "kind": "dialogue",
   "jp": "そ　その前に\\nわしは　ちいと\\n厠へ行ってくる",
   "en": "",
   "op": "0x62",
   "msg": "0x108e"
  },
  {
   "id": "m_006002:0x10ca0",
   "off": 68768,
   "max": 40,
   "kind": "dialogue",
   "jp": "悪寒はそのせいか\\nさっさと行ってこい！",
   "en": "",
   "op": "0x62",
   "msg": "0x108f"
  },
  {
   "id": "m_006002:0x111e4",
   "off": 70116,
   "max": 28,
   "kind": "dialogue",
   "jp": "それとは\\nまったく違うぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1090"
  },
  {
   "id": "m_006002:0x11684",
   "off": 71300,
   "max": 64,
   "kind": "dialogue",
   "jp": "もう　いいから\\n今すぐ黙って厠へ行くか\\n死ぬまでガマンしてろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1091"
  },
  {
   "id": "m_006002:0x11e48",
   "off": 73288,
   "max": 52,
   "kind": "dialogue",
   "jp": "おう　二人とも\\nここで待っててくれ\\nすぐ戻ってくる",
   "en": "",
   "op": "0x62",
   "msg": "0x1092"
  },
  {
   "id": "m_006002:0x12520",
   "off": 75040,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍馬くん\\nちょっと\\n無理してますね",
   "en": "",
   "op": "0x62",
   "msg": "0x1093"
  },
  {
   "id": "m_006002:0x12be0",
   "off": 76768,
   "max": 44,
   "kind": "dialogue",
   "jp": "あれで誤魔化している\\nつもりなんだろうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1094"
  },
  {
   "id": "m_006002:0x132a8",
   "off": 78504,
   "max": 48,
   "kind": "dialogue",
   "jp": "私はね\\n龍馬くんの直感を\\n信じているんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1095"
  },
  {
   "id": "m_006002:0x132e8",
   "off": 78568,
   "max": 48,
   "kind": "dialogue",
   "jp": "この御前試合は最初から\\n我々を陥れる罠ですから",
   "en": "",
   "op": "0x62",
   "msg": "0x1096"
  },
  {
   "id": "m_006002:0x133c4",
   "off": 78788,
   "max": 60,
   "kind": "dialogue",
   "jp": "井伊は何かを仕組んで\\nいるはず……\\nそう思うでしょ　晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x1097"
  },
  {
   "id": "m_006002:0x13be0",
   "off": 80864,
   "max": 20,
   "kind": "dialogue",
   "jp": "当然そうだろうな",
   "en": "",
   "op": "0x62",
   "msg": "0x1098"
  },
  {
   "id": "m_006002:0x14070",
   "off": 82032,
   "max": 44,
   "kind": "dialogue",
   "jp": "晋作も\\n感じているでしょう？\\nこの感じ……",
   "en": "",
   "op": "0x62",
   "msg": "0x12bb"
  },
  {
   "id": "m_006002:0x145b4",
   "off": 83380,
   "max": 76,
   "kind": "dialogue",
   "jp": "だな　どこか禍々しい……\\nオレ様の片魂がどこか\\nざわついてる様な感じだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x12bc"
  },
  {
   "id": "m_006002:0x14a7c",
   "off": 84604,
   "max": 76,
   "kind": "dialogue",
   "jp": "私もです　龍馬くんの\\n様子を見ても偶然とは思わ\\nないほうがよさそうですね",
   "en": "",
   "op": "0x62",
   "msg": "0x12bd"
  },
  {
   "id": "m_006002:0x14fe0",
   "off": 85984,
   "max": 64,
   "kind": "dialogue",
   "jp": "オレ様達の雷舞が終わる\\nまでは気を抜かないよう\\n警戒しておこう",
   "en": "",
   "op": "0x62",
   "msg": "0x109c"
  },
  {
   "id": "m_006002:0x1549c",
   "off": 87196,
   "max": 68,
   "kind": "dialogue",
   "jp": "一番気を付けなければ\\nならないのは　恐らく\\n新選組の雷舞でしょうね",
   "en": "",
   "op": "0x62",
   "msg": "0x109d"
  },
  {
   "id": "m_006002:0x154f0",
   "off": 87280,
   "max": 68,
   "kind": "dialogue",
   "jp": "龍馬くんの歌を人々に\\n聴かせる前に　なにかを\\n仕掛けてくるはずです",
   "en": "",
   "op": "0x62",
   "msg": "0x109e"
  },
  {
   "id": "m_006002:0x15cb8",
   "off": 89272,
   "max": 52,
   "kind": "dialogue",
   "jp": "お待たせしたな！\\nわしが戻ったから\\nもう大丈夫！",
   "en": "",
   "op": "0x62",
   "msg": "0x109f"
  },
  {
   "id": "m_006002:0x16388",
   "off": 91016,
   "max": 56,
   "kind": "dialogue",
   "jp": "はあ……\\n最高に大丈夫じゃねえ\\nやつが戻って来やがった",
   "en": "",
   "op": "0x62",
   "msg": "0x10a0"
  },
  {
   "id": "m_006002:0x16a58",
   "off": 92760,
   "max": 28,
   "kind": "dialogue",
   "jp": "うん？\\nなんの話をしてた？",
   "en": "",
   "op": "0x62",
   "msg": "0x10a1"
  },
  {
   "id": "m_006002:0x17110",
   "off": 94480,
   "max": 52,
   "kind": "dialogue",
   "jp": "気を引き締めようって\\nそういう話ですよ\\nね　晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x10a2"
  },
  {
   "id": "m_006002:0x17788",
   "off": 96136,
   "max": 56,
   "kind": "dialogue",
   "jp": "そうだな\\nそろそろあちらさんの\\n雷舞が始まるみたいだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x10a3"
  },
  {
   "id": "m_006002:0x177d0",
   "off": 96208,
   "max": 36,
   "kind": "dialogue",
   "jp": "まずは敵の出方を\\n見ようじゃねぇか",
   "en": "",
   "op": "0x62",
   "msg": "0x10a4"
  },
  {
   "id": "m_006002:0x17fcc",
   "off": 98252,
   "max": 40,
   "kind": "dialogue",
   "jp": "おお！\\nそりゃ大変じゃ\\n早く行かんと",
   "en": "",
   "op": "0x62",
   "msg": "0x10a5"
  },
  {
   "id": "m_006002:0x1848c",
   "off": 99468,
   "max": 84,
   "kind": "dialogue",
   "jp": "三人は頷きあうと\\n会場へ向かった\\n空には暗雲が立ちこめ\\n徐々に青空が消えていった",
   "en": "",
   "op": "0x62",
   "msg": "0x10a6"
  },
  {
   "id": "m_006002:0x18e0c",
   "off": 101900,
   "max": 52,
   "kind": "dialogue",
   "jp": "御前試合の会場には\\n徐々に観客が\\nやってきていた",
   "en": "",
   "op": "0x62",
   "msg": "0x10a7"
  },
  {
   "id": "m_006002:0x18e50",
   "off": 101968,
   "max": 76,
   "kind": "dialogue",
   "jp": "観客達は\\n老若男女を問わず\\n入り交じり雷舞を楽しみに\\nしている様子であった",
   "en": "",
   "op": "0x62",
   "msg": "0x10a8"
  },
  {
   "id": "m_006002:0x18eac",
   "off": 102060,
   "max": 28,
   "kind": "dialogue",
   "jp": "しかし\\n何か様子がおかしい",
   "en": "",
   "op": "0x62",
   "msg": "0x10a9"
  },
  {
   "id": "m_006002:0x1955c",
   "off": 103772,
   "max": 52,
   "kind": "dialogue",
   "jp": "ううう\\nみな生気を抜かれた\\nような目をしているぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x10aa"
  },
  {
   "id": "m_006002:0x19bd4",
   "off": 105428,
   "max": 64,
   "kind": "dialogue",
   "jp": "天歌に浸り切っていれば\\n誰だってやがては\\nああなってしまいます",
   "en": "",
   "op": "0x62",
   "msg": "0x10ab"
  },
  {
   "id": "m_006002:0x1a2b0",
   "off": 107184,
   "max": 16,
   "kind": "dialogue",
   "jp": "気味が悪いな",
   "en": "",
   "op": "0x62",
   "msg": "0x10ac"
  },
  {
   "id": "m_006002:0x1ac0c",
   "off": 109580,
   "max": 52,
   "kind": "dialogue",
   "jp": "よっしゃ！\\nわしの歌で元気を\\n取り戻させるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10ad"
  },
  {
   "id": "m_006002:0x1b368",
   "off": 111464,
   "max": 60,
   "kind": "dialogue",
   "jp": "いくら龍馬くんでも\\nそう簡単にはいかないと\\n思うんですけど",
   "en": "",
   "op": "0x62",
   "msg": "0x10ae"
  },
  {
   "id": "m_006002:0x1b9e8",
   "off": 113128,
   "max": 60,
   "kind": "dialogue",
   "jp": "桂さんは龍馬を\\n信じてるのか心配するのか\\nどっちなんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x10af"
  },
  {
   "id": "m_006002:0x1bea0",
   "off": 114336,
   "max": 44,
   "kind": "dialogue",
   "jp": "信じているのと\\n心配するのは\\n別物でしょ",
   "en": "",
   "op": "0x62",
   "msg": "0x10b0"
  },
  {
   "id": "m_006002:0x1c3e4",
   "off": 115684,
   "max": 60,
   "kind": "dialogue",
   "jp": "よくわからねえが……\\nおい　そろそろ\\n先行の雷舞が始まるぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x10b1"
  },
  {
   "id": "m_006002:0x1cba4",
   "off": 117668,
   "max": 40,
   "kind": "dialogue",
   "jp": "ありゃあ新選組の\\nソウちんたちじゃな",
   "en": "",
   "op": "0x62",
   "msg": "0x10b2"
  },
  {
   "id": "m_006002:0x1d268",
   "off": 119400,
   "max": 36,
   "kind": "dialogue",
   "jp": "新選組は幕府の\\n最高愛獲ですからね",
   "en": "",
   "op": "0x62",
   "msg": "0x10b3"
  },
  {
   "id": "m_006002:0x1d734",
   "off": 120628,
   "max": 64,
   "kind": "dialogue",
   "jp": "生気が抜けたような\\n観客達は彼らの姿を\\n見るなり歓声をあげた",
   "en": "",
   "op": "0x62",
   "msg": "0x10b4"
  },
  {
   "id": "m_006002:0x1e8dc",
   "off": 125148,
   "max": 36,
   "kind": "dialogue",
   "jp": "なんじゃっ\\n観客の周りが変じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10b5"
  },
  {
   "id": "m_006002:0x1f208",
   "off": 127496,
   "max": 28,
   "kind": "dialogue",
   "jp": "急に生気を\\n取り戻した？",
   "en": "",
   "op": "0x62",
   "msg": "0x10b6"
  },
  {
   "id": "m_006002:0x1f6a0",
   "off": 128672,
   "max": 8,
   "kind": "dialogue",
   "jp": "違う！",
   "en": "",
   "op": "0x62",
   "msg": "0x10b7"
  },
  {
   "id": "m_006002:0x1fb24",
   "off": 129828,
   "max": 60,
   "kind": "dialogue",
   "jp": "もやみたいなのが見える\\n観客の歓声と混じり\\nあってるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10b8"
  },
  {
   "id": "m_006002:0x200dc",
   "off": 131292,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬は\\n舞台袖に座っている\\n井伊直弼を見た",
   "en": "",
   "op": "0x62",
   "msg": "0x10b9"
  },
  {
   "id": "m_006002:0x20118",
   "off": 131352,
   "max": 60,
   "kind": "dialogue",
   "jp": "直弼は口元に\\n扇子を宛がい\\n何か呟いている\\nように見える",
   "en": "",
   "op": "0x62",
   "msg": "0x10ba"
  },
  {
   "id": "m_006002:0x20c08",
   "off": 134152,
   "max": 40,
   "kind": "dialogue",
   "jp": "オン\\nキリキリバサラ\\nウンハッタ……",
   "en": "",
   "op": "0x62",
   "msg": "0x10bb"
  },
  {
   "id": "m_006002:0x21938",
   "off": 137528,
   "max": 40,
   "kind": "dialogue",
   "jp": "うう……\\nうあああ……\\nうがああああ",
   "en": "",
   "op": "0x62",
   "msg": "0x10bc"
  },
  {
   "id": "m_006002:0x21fbc",
   "off": 139196,
   "max": 56,
   "kind": "dialogue",
   "jp": "舞台の中央に立つ\\n沖田が急に苦しみだし\\n獣のように叫ぶ",
   "en": "",
   "op": "0x62",
   "msg": "0x10bd"
  },
  {
   "id": "m_006002:0x2259c",
   "off": 140700,
   "max": 60,
   "kind": "dialogue",
   "jp": "なんじゃ　なんじゃ！\\nソウちんの様子が\\nおかしくなったぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10be"
  },
  {
   "id": "m_006002:0x22c74",
   "off": 142452,
   "max": 56,
   "kind": "dialogue",
   "jp": "なんでしょう……\\nいきなり盛り上がったと\\n思ったら……",
   "en": "",
   "op": "0x62",
   "msg": "0x10bf"
  },
  {
   "id": "m_006002:0x22cbc",
   "off": 142524,
   "max": 36,
   "kind": "dialogue",
   "jp": "急に会場の空気が\\n澱んだような……",
   "en": "",
   "op": "0x62",
   "msg": "0x10c0"
  },
  {
   "id": "m_006002:0x235ec",
   "off": 144876,
   "max": 52,
   "kind": "dialogue",
   "jp": "真っ黒じゃ！\\n井伊の気配みたいに\\n真っ黒な気じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10c1"
  },
  {
   "id": "m_006002:0x2363c",
   "off": 144956,
   "max": 72,
   "kind": "dialogue",
   "jp": "会場中に黒い気が\\nとぐろを巻いているっ！\\nソウちんに集まって行くぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x10c2"
  },
  {
   "id": "m_006002:0x23694",
   "off": 145044,
   "max": 36,
   "kind": "dialogue",
   "jp": "こんままじゃソウちんが\\n危ないっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10c3"
  },
  {
   "id": "m_006002:0x23c4c",
   "off": 146508,
   "max": 52,
   "kind": "dialogue",
   "jp": "沖田を救おうと\\n龍馬は舞台へと\\n飛び出していった",
   "en": "",
   "op": "0x62",
   "msg": "0x10c4"
  },
  {
   "id": "m_006002:0x240c4",
   "off": 147652,
   "max": 40,
   "kind": "dialogue",
   "jp": "あのバカ！\\n一人でなに\\nしようってんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x10c5"
  },
  {
   "id": "m_006002:0x24788",
   "off": 149384,
   "max": 16,
   "kind": "dialogue",
   "jp": "私も行きます！",
   "en": "",
   "op": "0x62",
   "msg": "0x10c6"
  },
  {
   "id": "m_006002:0x24c30",
   "off": 150576,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬に続いて\\n高杉と桂も\\n舞台へと\\n飛びだしてゆく",
   "en": "",
   "op": "0x62",
   "msg": "0x10c7"
  },
  {
   "id": "m_006002:0x25380",
   "off": 152448,
   "max": 52,
   "kind": "dialogue",
   "jp": "ソウちん　大丈夫か　\\nしっかりしろ　ソウちん！",
   "en": "",
   "op": "0x62",
   "msg": "0x10c8"
  },
  {
   "id": "m_006002:0x258d4",
   "off": 153812,
   "max": 108,
   "kind": "dialogue",
   "jp": "舞台中央で叫び崩れ\\n落ちた沖田がゆっくり\\n立ちあがる　そして\\n龍馬を見て微笑んだ\\nそれは邪悪な笑みだった",
   "en": "",
   "op": "0x62",
   "msg": "0x10c9"
  },
  {
   "id": "m_006002:0x2604c",
   "off": 155724,
   "max": 60,
   "kind": "dialogue",
   "jp": "トサカくん……\\n来てくれたんだね\\n僕の歌を聴きに……ふふ",
   "en": "",
   "op": "0x62",
   "msg": "0x10ca"
  },
  {
   "id": "m_006002:0x26844",
   "off": 157764,
   "max": 16,
   "kind": "dialogue",
   "jp": "ソウちん……？",
   "en": "",
   "op": "0x62",
   "msg": "0x10cb"
  },
  {
   "id": "m_006002:0x26ffc",
   "off": 159740,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふふふ\\nねぇトサカくん\\n僕の仲間になってよ",
   "en": "",
   "op": "0x62",
   "msg": "0x10cc"
  },
  {
   "id": "m_006002:0x27038",
   "off": 159800,
   "max": 64,
   "kind": "dialogue",
   "jp": "近藤さんはトサカくんが\\n好きなんだよ？\\n喜ぶから仲間になろうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x10cd"
  },
  {
   "id": "m_006002:0x2758c",
   "off": 161164,
   "max": 64,
   "kind": "dialogue",
   "jp": "わし……わしにはもう\\n仲間はいるんじゃ\\n彦根でもそう言ったろう",
   "en": "",
   "op": "0x62",
   "msg": "0x10ce"
  },
  {
   "id": "m_006002:0x27a48",
   "off": 162376,
   "max": 60,
   "kind": "dialogue",
   "jp": "もう遅い……よ\\nトサカくんは僕のもの\\nいつも……一緒だよ",
   "en": "",
   "op": "0x62",
   "msg": "0x10cf"
  },
  {
   "id": "m_006002:0x28354",
   "off": 164692,
   "max": 44,
   "kind": "dialogue",
   "jp": "狂気に縁取られた笑顔で\\n沖田は歌い出した",
   "en": "",
   "op": "0x62",
   "msg": "0x10d0"
  },
  {
   "id": "m_006002:0x28390",
   "off": 164752,
   "max": 96,
   "kind": "dialogue",
   "jp": "その歌に\\n舞台に広がっていた\\n黒い気が蠢く\\nまるで操るように\\n黒い気を沖田が\\n引きつけていく",
   "en": "",
   "op": "0x62",
   "msg": "0x10d1"
  },
  {
   "id": "m_006002:0x287b4",
   "off": 165812,
   "max": 56,
   "kind": "dialogue",
   "jp": "沖田の歌声が\\nどす黒い気をまとって\\n龍馬に襲い掛かった",
   "en": "",
   "op": "0x62",
   "msg": "0x10d2"
  },
  {
   "id": "m_006002:0x292e4",
   "off": 168676,
   "max": 28,
   "kind": "dialogue",
   "jp": "\\fnt1うおおおおおっ\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x10d3"
  },
  {
   "id": "m_006002:0x29e08",
   "off": 171528,
   "max": 16,
   "kind": "dialogue",
   "jp": "龍馬くんっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10d4"
  },
  {
   "id": "m_006002:0x2a2f0",
   "off": 172784,
   "max": 8,
   "kind": "dialogue",
   "jp": "龍馬！",
   "en": "",
   "op": "0x62",
   "msg": "0x10d5"
  },
  {
   "id": "m_006002:0x2a87c",
   "off": 174204,
   "max": 56,
   "kind": "dialogue",
   "jp": "龍馬を助けようと\\n近づいた高杉と桂を\\n龍馬は拒絶する",
   "en": "",
   "op": "0x62",
   "msg": "0x10d6"
  },
  {
   "id": "m_006002:0x2b448",
   "off": 177224,
   "max": 56,
   "kind": "dialogue",
   "jp": "ダメじゃ！　近寄るなっ\\nソウちんの力はっ……\\nぐううっ",
   "en": "",
   "op": "0x62",
   "msg": "0x10d7"
  },
  {
   "id": "m_006002:0x2b498",
   "off": 177304,
   "max": 40,
   "kind": "dialogue",
   "jp": "あん時と段違いに強い\\n負の波動じゃ……",
   "en": "",
   "op": "0x62",
   "msg": "0x10d8"
  },
  {
   "id": "m_006002:0x2b4d0",
   "off": 177360,
   "max": 40,
   "kind": "dialogue",
   "jp": "これを浴びたら\\nひとたまりもないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10d9"
  },
  {
   "id": "m_006002:0x2bc54",
   "off": 179284,
   "max": 60,
   "kind": "dialogue",
   "jp": "沖田の歌と\\n黒い気に囚われ\\n龍馬は身動きも\\nできなくなる",
   "en": "",
   "op": "0x62",
   "msg": "0x10da"
  },
  {
   "id": "m_006002:0x2bca0",
   "off": 179360,
   "max": 56,
   "kind": "dialogue",
   "jp": "黒い気の影響で\\n会場にいた観客達が\\n次々と倒れていた",
   "en": "",
   "op": "0x62",
   "msg": "0x10db"
  },
  {
   "id": "m_006002:0x2c230",
   "off": 180784,
   "max": 44,
   "kind": "dialogue",
   "jp": "やべえな\\n観客も影響受けて\\n失神してやがる",
   "en": "",
   "op": "0x62",
   "msg": "0x10dc"
  },
  {
   "id": "m_006002:0x2c26c",
   "off": 180844,
   "max": 56,
   "kind": "dialogue",
   "jp": "こりゃやべぇぞ！\\nハンパねえ力で\\n圧して来やがるっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10dd"
  },
  {
   "id": "m_006002:0x2c948",
   "off": 182600,
   "max": 40,
   "kind": "dialogue",
   "jp": "まさかこんなに強い\\n負の力を放つとはっ",
   "en": "",
   "op": "0x62",
   "msg": "0x10de"
  },
  {
   "id": "m_006002:0x2c980",
   "off": 182656,
   "max": 36,
   "kind": "dialogue",
   "jp": "ぐうっ……\\n押し潰されそうですっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10df"
  },
  {
   "id": "m_006002:0x2d184",
   "off": 184708,
   "max": 12,
   "kind": "dialogue",
   "jp": "うう……",
   "en": "",
   "op": "0x62",
   "msg": "0x10e0"
  },
  {
   "id": "m_006002:0x2d60c",
   "off": 185868,
   "max": 56,
   "kind": "dialogue",
   "jp": "立っていられないっ\\n晋作っ　龍馬くんっ\\nうあああっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10e1"
  },
  {
   "id": "m_006002:0x2e048",
   "off": 188488,
   "max": 48,
   "kind": "dialogue",
   "jp": "くそっ　このオレ様を\\n地面に伏せさせるとはっ",
   "en": "",
   "op": "0x62",
   "msg": "0x10e2"
  },
  {
   "id": "m_006002:0x2e594",
   "off": 189844,
   "max": 108,
   "kind": "dialogue",
   "jp": "倒れ伏す桂と高杉\\nそして　観客達も次々と\\n倒れていく　だが\\n身動きも取れない龍馬は\\nいまだ舞台に立っていた",
   "en": "",
   "op": "0x62",
   "msg": "0x10e3"
  },
  {
   "id": "m_006002:0x2ee48",
   "off": 192072,
   "max": 32,
   "kind": "dialogue",
   "jp": "ふふふ\\nまだ立っていられるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x10e4"
  },
  {
   "id": "m_006002:0x2ee78",
   "off": 192120,
   "max": 32,
   "kind": "dialogue",
   "jp": "すごいねトサカくん\\nさすがだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x10e5"
  },
  {
   "id": "m_006002:0x2f400",
   "off": 193536,
   "max": 64,
   "kind": "dialogue",
   "jp": "やめじゃ　ソウちん！\\nお客さんが倒れとるぞ\\nそれはやめるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10e6"
  },
  {
   "id": "m_006002:0x2f458",
   "off": 193624,
   "max": 64,
   "kind": "dialogue",
   "jp": "ソウちんにも良くない\\n感じがするんじゃ\\nその歌はやめるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10e7"
  },
  {
   "id": "m_006002:0x2f914",
   "off": 194836,
   "max": 44,
   "kind": "dialogue",
   "jp": "僕はやめないよ……\\nトサカくんが倒れるまで",
   "en": "",
   "op": "0x62",
   "msg": "0x10e8"
  },
  {
   "id": "m_006002:0x2f950",
   "off": 194896,
   "max": 56,
   "kind": "dialogue",
   "jp": "いや……違うかな\\n歌いたくてたまらない\\nだから歌うんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x10e9"
  },
  {
   "id": "m_006002:0x2fea4",
   "off": 196260,
   "max": 32,
   "kind": "dialogue",
   "jp": "ぐ……\\nやめるんじゃ\\nソウちん",
   "en": "",
   "op": "0x62",
   "msg": "0x10ea"
  },
  {
   "id": "m_006002:0x308f0",
   "off": 198896,
   "max": 40,
   "kind": "dialogue",
   "jp": "でも……これは\\n僕が歌ってるのかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x10eb"
  },
  {
   "id": "m_006002:0x30ea0",
   "off": 200352,
   "max": 36,
   "kind": "dialogue",
   "jp": "土方さん……\\n近藤さんはどこ……？",
   "en": "",
   "op": "0x62",
   "msg": "0x10ec"
  },
  {
   "id": "m_006002:0x31310",
   "off": 201488,
   "max": 44,
   "kind": "dialogue",
   "jp": "沖田は\\n頭を振って周りを見る　\\nしかし――",
   "en": "",
   "op": "0x62",
   "msg": "0x10ed"
  },
  {
   "id": "m_006002:0x31a80",
   "off": 203392,
   "max": 16,
   "kind": "dialogue",
   "jp": "続けろ　沖田",
   "en": "",
   "op": "0x62",
   "msg": "0x10ee"
  },
  {
   "id": "m_006002:0x31e3c",
   "off": 204348,
   "max": 68,
   "kind": "dialogue",
   "jp": "舞台袖に直弼の姿が見えた\\n直弼は両手で印を結んで\\n何かを呟いている",
   "en": "",
   "op": "0x62",
   "msg": "0x10ef"
  },
  {
   "id": "m_006002:0x32590",
   "off": 206224,
   "max": 44,
   "kind": "dialogue",
   "jp": "井伊大老も\\nああ言ってるし……\\n僕は歌うよ",
   "en": "",
   "op": "0x62",
   "msg": "0x10f0"
  },
  {
   "id": "m_006002:0x3323c",
   "off": 209468,
   "max": 40,
   "kind": "dialogue",
   "jp": "くうっ　井伊！\\nソウちんになにをした！",
   "en": "",
   "op": "0x62",
   "msg": "0x10f1"
  },
  {
   "id": "m_006002:0x33274",
   "off": 209524,
   "max": 20,
   "kind": "dialogue",
   "jp": "もうやめろ　井伊！",
   "en": "",
   "op": "0x62",
   "msg": "0x10f2"
  },
  {
   "id": "m_006002:0x33e9c",
   "off": 212636,
   "max": 32,
   "kind": "dialogue",
   "jp": "なにか？\\n我がなにをしたと？",
   "en": "",
   "op": "0x62",
   "msg": "0x10f3"
  },
  {
   "id": "m_006002:0x34ca8",
   "off": 216232,
   "max": 32,
   "kind": "dialogue",
   "jp": "貴様……\\nわしは誤魔化されん",
   "en": "",
   "op": "0x62",
   "msg": "0x10f4"
  },
  {
   "id": "m_006002:0x34ce0",
   "off": 216288,
   "max": 40,
   "kind": "dialogue",
   "jp": "なにか怪しい術を使って\\nソウちんを……",
   "en": "",
   "op": "0x62",
   "msg": "0x10f5"
  },
  {
   "id": "m_006002:0x34d18",
   "off": 216344,
   "max": 32,
   "kind": "dialogue",
   "jp": "いますぐ術を解くんじゃ\\n井伊！",
   "en": "",
   "op": "0x62",
   "msg": "0x10f6"
  },
  {
   "id": "m_006002:0x351b4",
   "off": 217524,
   "max": 48,
   "kind": "dialogue",
   "jp": "何を言っているのだ？\\n言い掛かりも程々にしろ",
   "en": "",
   "op": "0x62",
   "msg": "0x10f7"
  },
  {
   "id": "m_006002:0x356b4",
   "off": 218804,
   "max": 36,
   "kind": "dialogue",
   "jp": "とぼけるな井伊！\\nわしは見たぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10f8"
  },
  {
   "id": "m_006002:0x356f0",
   "off": 218864,
   "max": 36,
   "kind": "dialogue",
   "jp": "黒い気は井伊の\\n気配と同じじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10f9"
  },
  {
   "id": "m_006002:0x35724",
   "off": 218916,
   "max": 28,
   "kind": "dialogue",
   "jp": "ソウちん！\\n目を覚ませ！",
   "en": "",
   "op": "0x62",
   "msg": "0x10fa"
  },
  {
   "id": "m_006002:0x3633c",
   "off": 222012,
   "max": 40,
   "kind": "dialogue",
   "jp": "目を覚ます？\\nそれは僕のほうじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x10fb"
  },
  {
   "id": "m_006002:0x36374",
   "off": 222068,
   "max": 48,
   "kind": "dialogue",
   "jp": "トサカくんが目を覚ます\\n……その時が来たんだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x10fc"
  },
  {
   "id": "m_006002:0x363b4",
   "off": 222132,
   "max": 28,
   "kind": "dialogue",
   "jp": "僕が目を覚まさせてあげる",
   "en": "",
   "op": "0x62",
   "msg": "0x10fd"
  },
  {
   "id": "m_006002:0x36e4c",
   "off": 224844,
   "max": 48,
   "kind": "dialogue",
   "jp": "沖田から暗澹とした\\n負の波動が龍馬に\\n降り注ぐ",
   "en": "",
   "op": "0x62",
   "msg": "0x10fe"
  },
  {
   "id": "m_006002:0x36e8c",
   "off": 224908,
   "max": 80,
   "kind": "dialogue",
   "jp": "龍馬は全力を振り絞って\\n立ち上がり\\n沖田が放った負の波動を\\n我が身に受け止めた",
   "en": "",
   "op": "0x62",
   "msg": "0x10ff"
  },
  {
   "id": "m_006002:0x37960",
   "off": 227680,
   "max": 32,
   "kind": "dialogue",
   "jp": "ぐあああっ\\nなんなんじゃあっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1100"
  },
  {
   "id": "m_006002:0x37a30",
   "off": 227888,
   "max": 32,
   "kind": "dialogue",
   "jp": "目を……覚ませ\\nソウちん……",
   "en": "",
   "op": "0x62",
   "msg": "0x1101"
  },
  {
   "id": "m_006002:0x38684",
   "off": 231044,
   "max": 36,
   "kind": "dialogue",
   "jp": "トサカくん\\n頑張りすぎると死ぬよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1102"
  },
  {
   "id": "m_006002:0x386b8",
   "off": 231096,
   "max": 56,
   "kind": "dialogue",
   "jp": "あ……違うね……\\n頑張らなくても\\n死んじゃうんだよね",
   "en": "",
   "op": "0x62",
   "msg": "0x1103"
  },
  {
   "id": "m_006002:0x3911c",
   "off": 233756,
   "max": 56,
   "kind": "dialogue",
   "jp": "なんじゃ？\\n負の波動がわしの片魂を\\n黒くしていく……",
   "en": "",
   "op": "0x62",
   "msg": "0x1104"
  },
  {
   "id": "m_006002:0x39170",
   "off": 233840,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんじゃろう？\\n怒りや憎しみじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x1105"
  },
  {
   "id": "m_006002:0x391a8",
   "off": 233896,
   "max": 28,
   "kind": "dialogue",
   "jp": "切ない負の力を\\n感じる……",
   "en": "",
   "op": "0x62",
   "msg": "0x1106"
  },
  {
   "id": "m_006002:0x39b84",
   "off": 236420,
   "max": 64,
   "kind": "dialogue",
   "jp": "おい　龍馬！\\nしっかりしろ　てめぇが\\n呑み込まれてどうする！",
   "en": "",
   "op": "0x62",
   "msg": "0x1107"
  },
  {
   "id": "m_006002:0x3a260",
   "off": 238176,
   "max": 36,
   "kind": "dialogue",
   "jp": "気をしっかり持って\\n龍馬くんっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1108"
  },
  {
   "id": "m_006002:0x3aab0",
   "off": 240304,
   "max": 92,
   "kind": "dialogue",
   "jp": "龍馬は強く目を瞑り\\n歯を噛み締め\\n血が滲むほど\\n握り拳を固め　強い力を\\nはね除けようとする",
   "en": "",
   "op": "0x62",
   "msg": "0x1109"
  },
  {
   "id": "m_006002:0x3ab1c",
   "off": 240412,
   "max": 80,
   "kind": "dialogue",
   "jp": "しかし\\nその抵抗も虚しく\\n沖田の黒い力に\\n呑み込まれ龍馬は\\n意識を失っていった",
   "en": "",
   "op": "0x62",
   "msg": "0x110a"
  },
  {
   "id": "m_006002:0x3b3a0",
   "off": 242592,
   "max": 76,
   "kind": "dialogue",
   "jp": "意識を失った\\n龍馬の脳裏に\\n不思議な光景が\\n浮かんだのは\\n次の瞬間だった",
   "en": "",
   "op": "0x62",
   "msg": "0x110b"
  },
  {
   "id": "m_006002:0x3b9e8",
   "off": 244200,
   "max": 56,
   "kind": "dialogue",
   "jp": "なんじゃ……\\nちっちゃい子供が\\n火の中で泣いちょる……",
   "en": "",
   "op": "0x62",
   "msg": "0x110c"
  },
  {
   "id": "m_006002:0x3bf84",
   "off": 245636,
   "max": 24,
   "kind": "dialogue",
   "jp": "……なにか見えるの？",
   "en": "",
   "op": "0x62",
   "msg": "0x110d"
  },
  {
   "id": "m_006002:0x3c554",
   "off": 247124,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああ……\\n盗人が……\\n子供を手下にしちょる",
   "en": "",
   "op": "0x62",
   "msg": "0x110e"
  },
  {
   "id": "m_006002:0x3c59c",
   "off": 247196,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああっ\\n盗みに入った家に\\n火を放ちよった！",
   "en": "",
   "op": "0x62",
   "msg": "0x110f"
  },
  {
   "id": "m_006002:0x3c5dc",
   "off": 247260,
   "max": 28,
   "kind": "dialogue",
   "jp": "くそぅ\\nなんちゅうことを！",
   "en": "",
   "op": "0x62",
   "msg": "0x1110"
  },
  {
   "id": "m_006002:0x3cb5c",
   "off": 248668,
   "max": 40,
   "kind": "dialogue",
   "jp": "火事の中へ子供を放って\\n逃げだしたっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1111"
  },
  {
   "id": "m_006002:0x3cb98",
   "off": 248728,
   "max": 36,
   "kind": "dialogue",
   "jp": "なんて酷いことをする！\\n許せん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1112"
  },
  {
   "id": "m_006002:0x3d03c",
   "off": 249916,
   "max": 32,
   "kind": "dialogue",
   "jp": "なぜ……\\nどうして見えるの？",
   "en": "",
   "op": "0x62",
   "msg": "0x1113"
  },
  {
   "id": "m_006002:0x3d4dc",
   "off": 251100,
   "max": 44,
   "kind": "dialogue",
   "jp": "わしにはわからんが\\n勝手に見えてくるんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1114"
  },
  {
   "id": "m_006002:0x3d988",
   "off": 252296,
   "max": 24,
   "kind": "dialogue",
   "jp": "見えるはずが\\nない……",
   "en": "",
   "op": "0x62",
   "msg": "0x1115"
  },
  {
   "id": "m_006002:0x3df58",
   "off": 253784,
   "max": 28,
   "kind": "dialogue",
   "jp": "あれは……\\nソウちん……？",
   "en": "",
   "op": "0x62",
   "msg": "0x1116"
  },
  {
   "id": "m_006002:0x3e4d8",
   "off": 255192,
   "max": 28,
   "kind": "dialogue",
   "jp": "僕は歌う……\\n歌う　歌う",
   "en": "",
   "op": "0x62",
   "msg": "0x1117"
  },
  {
   "id": "m_006002:0x3e974",
   "off": 256372,
   "max": 28,
   "kind": "dialogue",
   "jp": "ソウちん！\\nやめるんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1118"
  },
  {
   "id": "m_006002:0x3f51c",
   "off": 259356,
   "max": 52,
   "kind": "dialogue",
   "jp": "意識を取り戻した龍馬は\\n黒い気を押して立ち上がる",
   "en": "",
   "op": "0x62",
   "msg": "0x1119"
  },
  {
   "id": "m_006002:0x3fe64",
   "off": 261732,
   "max": 52,
   "kind": "dialogue",
   "jp": "見るなよ……\\n僕の歌に呑み込まれて\\nしまえよっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x111a"
  },
  {
   "id": "m_006002:0x40900",
   "off": 264448,
   "max": 56,
   "kind": "dialogue",
   "jp": "叫ぶように言った\\n沖田から\\n一際黒い気が\\n放たれた！",
   "en": "",
   "op": "0x62",
   "msg": "0x111b"
  },
  {
   "id": "m_006002:0x40948",
   "off": 264520,
   "max": 60,
   "kind": "dialogue",
   "jp": "漆黒の気は\\n龍馬を包み込み\\nその姿が\\n隠れてしまうほどだ",
   "en": "",
   "op": "0x62",
   "msg": "0x111c"
  },
  {
   "id": "m_006002:0x410ec",
   "off": 266476,
   "max": 28,
   "kind": "dialogue",
   "jp": "晋作っ！\\n龍馬くんがっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x111d"
  },
  {
   "id": "m_006002:0x417a4",
   "off": 268196,
   "max": 36,
   "kind": "dialogue",
   "jp": "くそっ！\\n体が言うことをきかねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x111e"
  },
  {
   "id": "m_006002:0x41e64",
   "off": 269924,
   "max": 48,
   "kind": "dialogue",
   "jp": "ぐうっ……私もだ……\\nこれは想定出来なかったよ",
   "en": "",
   "op": "0x62",
   "msg": "0x111f"
  },
  {
   "id": "m_006002:0x42858",
   "off": 272472,
   "max": 76,
   "kind": "dialogue",
   "jp": "這うようにして龍馬の元へ\\n向かう高杉と桂だったが\\n漆黒の気が二人を襲った！",
   "en": "",
   "op": "0x62",
   "msg": "0x1120"
  },
  {
   "id": "m_006002:0x431b8",
   "off": 274872,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぐわあっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1121"
  },
  {
   "id": "m_006002:0x438bc",
   "off": 276668,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぐうっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1122"
  },
  {
   "id": "m_006002:0x441cc",
   "off": 278988,
   "max": 28,
   "kind": "dialogue",
   "jp": "二人とも\\n邪魔しないでよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1123"
  },
  {
   "id": "m_006002:0x44a90",
   "off": 281232,
   "max": 44,
   "kind": "dialogue",
   "jp": "さっきのがソウちんの\\n過去の記憶なら……",
   "en": "",
   "op": "0x62",
   "msg": "0x1124"
  },
  {
   "id": "m_006002:0x44acc",
   "off": 281292,
   "max": 48,
   "kind": "dialogue",
   "jp": "激しい怒りや憎しみで\\n満たされているはず……",
   "en": "",
   "op": "0x62",
   "msg": "0x1125"
  },
  {
   "id": "m_006002:0x4517c",
   "off": 283004,
   "max": 48,
   "kind": "dialogue",
   "jp": "なのにどうしてこんなに\\n切ない気持ちになる？",
   "en": "",
   "op": "0x62",
   "msg": "0x1126"
  },
  {
   "id": "m_006002:0x451bc",
   "off": 283068,
   "max": 28,
   "kind": "dialogue",
   "jp": "胸が締め付けられて\\n苦しい",
   "en": "",
   "op": "0x62",
   "msg": "0x1127"
  },
  {
   "id": "m_006002:0x451e8",
   "off": 283112,
   "max": 36,
   "kind": "dialogue",
   "jp": "泣き叫びたくなるほど\\n悲しい……",
   "en": "",
   "op": "0x62",
   "msg": "0x1128"
  },
  {
   "id": "m_006002:0x45c94",
   "off": 285844,
   "max": 40,
   "kind": "dialogue",
   "jp": "歌えば\\n二度と起こらない\\nあんなこと",
   "en": "",
   "op": "0x62",
   "msg": "0x1129"
  },
  {
   "id": "m_006002:0x46248",
   "off": 287304,
   "max": 52,
   "kind": "dialogue",
   "jp": "僕は歌う！\\n歌う！　歌う！\\nだから　歌うんだっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x112a"
  },
  {
   "id": "m_006002:0x46c18",
   "off": 289816,
   "max": 56,
   "kind": "dialogue",
   "jp": "その負の気は\\n過去の記憶から……\\n過去の悲しみから……",
   "en": "",
   "op": "0x62",
   "msg": "0x112b"
  },
  {
   "id": "m_006002:0x472d0",
   "off": 291536,
   "max": 48,
   "kind": "dialogue",
   "jp": "その悲しみの心を\\n井伊に\\n利用されとるんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x112c"
  },
  {
   "id": "m_006002:0x47c24",
   "off": 293924,
   "max": 16,
   "kind": "dialogue",
   "jp": "悲しみの心……",
   "en": "",
   "op": "0x62",
   "msg": "0x112d"
  },
  {
   "id": "m_006002:0x48780",
   "off": 296832,
   "max": 52,
   "kind": "dialogue",
   "jp": "なあソウちん\\n人間ちゅうのは弱い\\n生き物じゃと思う",
   "en": "",
   "op": "0x62",
   "msg": "0x112e"
  },
  {
   "id": "m_006002:0x487c4",
   "off": 296900,
   "max": 68,
   "kind": "dialogue",
   "jp": "悪は許されん事じゃ\\nじゃけど悪人にも悪事を\\n働く事情があると思う",
   "en": "",
   "op": "0x62",
   "msg": "0x112f"
  },
  {
   "id": "m_006002:0x48c84",
   "off": 298116,
   "max": 28,
   "kind": "dialogue",
   "jp": "……悪者の\\n味方をするの？",
   "en": "",
   "op": "0x62",
   "msg": "0x1130"
  },
  {
   "id": "m_006002:0x4911c",
   "off": 299292,
   "max": 36,
   "kind": "dialogue",
   "jp": "そうじゃない\\n違うんじゃ　ソウちん",
   "en": "",
   "op": "0x62",
   "msg": "0x1131"
  },
  {
   "id": "m_006002:0x49150",
   "off": 299344,
   "max": 52,
   "kind": "dialogue",
   "jp": "悪人の哀しみも\\n善人の苦しみも\\n受け入れにゃならん",
   "en": "",
   "op": "0x62",
   "msg": "0x1132"
  },
  {
   "id": "m_006002:0x49600",
   "off": 300544,
   "max": 60,
   "kind": "dialogue",
   "jp": "悪も……受け入れる？\\nはは　キレイゴトを\\n言ってくれるね",
   "en": "",
   "op": "0x62",
   "msg": "0x1133"
  },
  {
   "id": "m_006002:0x49ab8",
   "off": 301752,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしの言うことが\\nソウちんには\\nきれい事に聞こえるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1134"
  },
  {
   "id": "m_006002:0x4a7b4",
   "off": 305076,
   "max": 44,
   "kind": "dialogue",
   "jp": "泰平を乱す歌を歌う\\nトサカくんは悪だよね",
   "en": "",
   "op": "0x62",
   "msg": "0x1135"
  },
  {
   "id": "m_006002:0x4ac5c",
   "off": 306268,
   "max": 56,
   "kind": "dialogue",
   "jp": "天歌がまことの正義なら\\nわしのロックは悪かも\\nしれん",
   "en": "",
   "op": "0x62",
   "msg": "0x1136"
  },
  {
   "id": "m_006002:0x4aca4",
   "off": 306340,
   "max": 36,
   "kind": "dialogue",
   "jp": "じゃけど　天歌は本当に\\n正義か？",
   "en": "",
   "op": "0x62",
   "msg": "0x1137"
  },
  {
   "id": "m_006002:0x4b144",
   "off": 307524,
   "max": 24,
   "kind": "dialogue",
   "jp": "正義だと……\\n思うよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1138"
  },
  {
   "id": "m_006002:0x4b5d8",
   "off": 308696,
   "max": 64,
   "kind": "dialogue",
   "jp": "ソウちん　思い出せ\\nまことの歌は人を縛る\\nものじゃないはずじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1139"
  },
  {
   "id": "m_006002:0x4ba94",
   "off": 309908,
   "max": 40,
   "kind": "dialogue",
   "jp": "トサカくんの\\n思い違いじゃ\\nないのかな",
   "en": "",
   "op": "0x62",
   "msg": "0x113a"
  },
  {
   "id": "m_006002:0x4bf38",
   "off": 311096,
   "max": 60,
   "kind": "dialogue",
   "jp": "まことの歌は人の心を\\n豊かにするものじゃ\\n違うか　ソウちん",
   "en": "",
   "op": "0x62",
   "msg": "0x113b"
  },
  {
   "id": "m_006002:0x4c9a0",
   "off": 313760,
   "max": 36,
   "kind": "dialogue",
   "jp": "人の心を……\\n豊かにするもの……",
   "en": "",
   "op": "0x62",
   "msg": "0x113c"
  },
  {
   "id": "m_006002:0x4d26c",
   "off": 316012,
   "max": 64,
   "kind": "dialogue",
   "jp": "わしはロックを歌うて\\nすっかりお尋ね者じゃ\\nでも　それでええ",
   "en": "",
   "op": "0x62",
   "msg": "0x113d"
  },
  {
   "id": "m_006002:0x4d2bc",
   "off": 316092,
   "max": 64,
   "kind": "dialogue",
   "jp": "人々にまことの歌を\\n聴いてもらいたい\\n目を覚ましてもらいたい",
   "en": "",
   "op": "0x62",
   "msg": "0x113e"
  },
  {
   "id": "m_006002:0x4d30c",
   "off": 316172,
   "max": 44,
   "kind": "dialogue",
   "jp": "その気持ちがわしの\\n魂を揺さぶったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x113f"
  },
  {
   "id": "m_006002:0x4dbe0",
   "off": 318432,
   "max": 56,
   "kind": "dialogue",
   "jp": "でもさ　トサカくん\\n僕の歌でみんなは\\n熱狂してるよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1140"
  },
  {
   "id": "m_006002:0x4dc28",
   "off": 318504,
   "max": 40,
   "kind": "dialogue",
   "jp": "楽しくなったじゃない\\n倒れるほどにさ",
   "en": "",
   "op": "0x62",
   "msg": "0x1141"
  },
  {
   "id": "m_006002:0x4e7e4",
   "off": 321508,
   "max": 40,
   "kind": "dialogue",
   "jp": "それはまやかしじゃ\\nまやかしの喜びぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1142"
  },
  {
   "id": "m_006002:0x4ec90",
   "off": 322704,
   "max": 56,
   "kind": "dialogue",
   "jp": "まやかし？\\n僕の歌がまやかしだって\\nひどいこと言うね",
   "en": "",
   "op": "0x62",
   "msg": "0x1143"
  },
  {
   "id": "m_006002:0x4f144",
   "off": 323908,
   "max": 48,
   "kind": "dialogue",
   "jp": "なぁ\\n彦根で見た人たちは\\n確かに笑顔じゃった",
   "en": "",
   "op": "0x62",
   "msg": "0x1144"
  },
  {
   "id": "m_006002:0x4f184",
   "off": 323972,
   "max": 36,
   "kind": "dialogue",
   "jp": "けど　わしには\\n死人みたいに見えた",
   "en": "",
   "op": "0x62",
   "msg": "0x1145"
  },
  {
   "id": "m_006002:0x4f1b8",
   "off": 324024,
   "max": 68,
   "kind": "dialogue",
   "jp": "あれは本当の喜びか？\\n楽しいっていうのは\\n操られるのとは違うぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1146"
  },
  {
   "id": "m_006002:0x4f20c",
   "off": 324108,
   "max": 36,
   "kind": "dialogue",
   "jp": "ソウちんも\\nわかっている\\nはずじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1147"
  },
  {
   "id": "m_006002:0x4f6ac",
   "off": 325292,
   "max": 56,
   "kind": "dialogue",
   "jp": "……それでも　いい\\n天歌を聴いていれば\\n争いはないんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1148"
  },
  {
   "id": "m_006002:0x4f6f4",
   "off": 325364,
   "max": 52,
   "kind": "dialogue",
   "jp": "殺される子供もいないんだ\\nそうだろ　トサカくん？",
   "en": "",
   "op": "0x62",
   "msg": "0x1149"
  },
  {
   "id": "m_006002:0x4fc3c",
   "off": 326716,
   "max": 28,
   "kind": "dialogue",
   "jp": "可哀相になぁ……\\nソウちん",
   "en": "",
   "op": "0x62",
   "msg": "0x114a"
  },
  {
   "id": "m_006002:0x508f8",
   "off": 329976,
   "max": 20,
   "kind": "dialogue",
   "jp": "僕を哀れむなっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x114b"
  },
  {
   "id": "m_006002:0x512a8",
   "off": 332456,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしは　幼いお前に\\n歌ってやりたいぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x114c"
  },
  {
   "id": "m_006002:0x512e0",
   "off": 332512,
   "max": 64,
   "kind": "dialogue",
   "jp": "楽しくて　元気が出て\\n笑顔になる　歌……\\n心が自由になる歌を",
   "en": "",
   "op": "0x62",
   "msg": "0x114d"
  },
  {
   "id": "m_006002:0x51bc8",
   "off": 334792,
   "max": 24,
   "kind": "dialogue",
   "jp": "心が自由になる……歌",
   "en": "",
   "op": "0x62",
   "msg": "0x114e"
  },
  {
   "id": "m_006002:0x526fc",
   "off": 337660,
   "max": 32,
   "kind": "dialogue",
   "jp": "それがロックの魂\\nなんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x114f"
  },
  {
   "id": "m_006002:0x530b8",
   "off": 340152,
   "max": 16,
   "kind": "dialogue",
   "jp": "ロックの魂……",
   "en": "",
   "op": "0x62",
   "msg": "0x1150"
  },
  {
   "id": "m_006002:0x53f40",
   "off": 343872,
   "max": 44,
   "kind": "dialogue",
   "jp": "わしゃあ\\nソウちんの悲しみが\\n切ないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1151"
  },
  {
   "id": "m_006002:0x53f7c",
   "off": 343932,
   "max": 60,
   "kind": "dialogue",
   "jp": "ソウちんは\\n争いを無くしたかった\\nだから天歌を歌った……",
   "en": "",
   "op": "0x62",
   "msg": "0x1152"
  },
  {
   "id": "m_006002:0x53fc8",
   "off": 344008,
   "max": 64,
   "kind": "dialogue",
   "jp": "その気持ちはようわかる\\nただ天歌は――\\n人を幸福にはしないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1153"
  },
  {
   "id": "m_006002:0x54018",
   "off": 344088,
   "max": 36,
   "kind": "dialogue",
   "jp": "あれは自由な心を\\n抑え込む歌じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1154"
  },
  {
   "id": "m_006002:0x5404c",
   "off": 344140,
   "max": 52,
   "kind": "dialogue",
   "jp": "争いが無くなることもない\\n知っているか　ソウちん",
   "en": "",
   "op": "0x62",
   "msg": "0x1155"
  },
  {
   "id": "m_006002:0x54090",
   "off": 344208,
   "max": 64,
   "kind": "dialogue",
   "jp": "天歌に洗脳された人々が\\nまた天歌を聴くために\\n争っているのを",
   "en": "",
   "op": "0x62",
   "msg": "0x1156"
  },
  {
   "id": "m_006002:0x5454c",
   "off": 345420,
   "max": 44,
   "kind": "dialogue",
   "jp": "……あはは　やっぱり\\nトサカくんはすごいや",
   "en": "",
   "op": "0x62",
   "msg": "0x1157"
  },
  {
   "id": "m_006002:0x54588",
   "off": 345480,
   "max": 32,
   "kind": "dialogue",
   "jp": "ただのバカじゃ\\nなかったんだね",
   "en": "",
   "op": "0x62",
   "msg": "0x1158"
  },
  {
   "id": "m_006002:0x545b8",
   "off": 345528,
   "max": 64,
   "kind": "dialogue",
   "jp": "もっと――\\nもっと早く気付いていれば\\nもっと早く出会っていれば",
   "en": "",
   "op": "0x62",
   "msg": "0x1159"
  },
  {
   "id": "m_006002:0x54608",
   "off": 345608,
   "max": 48,
   "kind": "dialogue",
   "jp": "トサカくんを死なせずに\\n済んだかもしれなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x115a"
  },
  {
   "id": "m_006002:0x54b08",
   "off": 346888,
   "max": 48,
   "kind": "dialogue",
   "jp": "まだ遅くない\\nわしらはわかりあえる\\nんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x115b"
  },
  {
   "id": "m_006002:0x54fbc",
   "off": 348092,
   "max": 12,
   "kind": "dialogue",
   "jp": "……遅いよ",
   "en": "",
   "op": "0x62",
   "msg": "0x115c"
  },
  {
   "id": "m_006002:0x55498",
   "off": 349336,
   "max": 32,
   "kind": "dialogue",
   "jp": "ただやり方が\\n違っただけじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x115d"
  },
  {
   "id": "m_006002:0x5593c",
   "off": 350524,
   "max": 48,
   "kind": "dialogue",
   "jp": "もう遅いんだよ\\n全て　手遅れなんだ\\nトサカくん",
   "en": "",
   "op": "0x62",
   "msg": "0x115e"
  },
  {
   "id": "m_006002:0x5597c",
   "off": 350588,
   "max": 32,
   "kind": "dialogue",
   "jp": "もう僕には……\\n止められない",
   "en": "",
   "op": "0x62",
   "msg": "0x115f"
  },
  {
   "id": "m_006002:0x55e74",
   "off": 351860,
   "max": 52,
   "kind": "dialogue",
   "jp": "いかん！\\n天歌はやめろ！\\nソウちんの身が持たない！",
   "en": "",
   "op": "0x62",
   "msg": "0x1160"
  },
  {
   "id": "m_006002:0x56b5c",
   "off": 355164,
   "max": 52,
   "kind": "dialogue",
   "jp": "どう……したら\\n止まるか……\\nもう……わから……",
   "en": "",
   "op": "0x62",
   "msg": "0x1161"
  },
  {
   "id": "m_006002:0x5788c",
   "off": 358540,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしが救ってみせるっ\\nソウちん",
   "en": "",
   "op": "0x62",
   "msg": "0x1162"
  },
  {
   "id": "m_006002:0x578c0",
   "off": 358592,
   "max": 28,
   "kind": "dialogue",
   "jp": "うおおおおおおおおおお！",
   "en": "",
   "op": "0x62",
   "msg": "0x1163"
  },
  {
   "id": "m_006002:0x5858c",
   "off": 361868,
   "max": 20,
   "kind": "dialogue",
   "jp": "トサカ……くん？",
   "en": "",
   "op": "0x62",
   "msg": "0x1164"
  },
  {
   "id": "m_006002:0x58f3c",
   "off": 364348,
   "max": 20,
   "kind": "dialogue",
   "jp": "天歌が止まった！",
   "en": "",
   "op": "0x62",
   "msg": "0x1165"
  },
  {
   "id": "m_006002:0x59468",
   "off": 365672,
   "max": 16,
   "kind": "dialogue",
   "jp": "よし　今だっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1166"
  },
  {
   "id": "m_006002:0x59c08",
   "off": 367624,
   "max": 36,
   "kind": "dialogue",
   "jp": "ソウちんを\\n悲しみから救うぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1167"
  },
  {
   "id": "m_006002:0x5a570",
   "off": 370032,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしのロックを聴いて\\n自由を取り戻すんじゃ\\nソウちん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1168"
  },
  {
   "id": "m_006002:0x5a5b8",
   "off": 370104,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしのロックで\\n自由になれ！\\n笑顔になってくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1169"
  },
  {
   "id": "m_006002:0x5a5fc",
   "off": 370172,
   "max": 40,
   "kind": "dialogue",
   "jp": "本当のソウちんの歌を\\n歌えるように",
   "en": "",
   "op": "0x62",
   "msg": "0x116a"
  },
  {
   "id": "m_006002:0x5adb8",
   "off": 372152,
   "max": 16,
   "kind": "dialogue",
   "jp": "トサカくん……",
   "en": "",
   "op": "0x62",
   "msg": "0x116b"
  },
  {
   "id": "m_006002:0x5b9b4",
   "off": 375220,
   "max": 48,
   "kind": "dialogue",
   "jp": "聴け！　ソウちん\\nわしの歌で魂を震わせろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x116c"
  },
  {
   "id": "m_006002:0x5b9fc",
   "off": 375292,
   "max": 56,
   "kind": "dialogue",
   "jp": "心の底から痺れて\\n熱く！　熱く！\\n熱く！　魂を燃やせ",
   "en": "",
   "op": "0x62",
   "msg": "0x116d"
  },
  {
   "id": "m_006002:0x5ba44",
   "off": 375364,
   "max": 40,
   "kind": "dialogue",
   "jp": "悲しみの氷を\\n溶かすんじゃああああ",
   "en": "",
   "op": "0x62",
   "msg": "0x116e"
  }
 ]
}
