{
 "source": "m_006004.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_006004:0x13b0",
   "off": 5040,
   "max": 56,
   "kind": "dialogue",
   "jp": "はっ……私\\n眠ってたのかしら\\n総司さんが歌ってるのに",
   "en": "Oh... Did I fall\\nasleep? While\\nSoji-san was\\nsinging?",
   "op": "0x62",
   "msg": "0x129d"
  },
  {
   "id": "m_006004:0x1bc0",
   "off": 7104,
   "max": 44,
   "kind": "dialogue",
   "jp": "おおっ？\\n俺達はいつの間に\\n倒れてたんだ？",
   "en": "Huh? When did\\nwe all collapse?",
   "op": "0x62",
   "msg": "0x129e"
  },
  {
   "id": "m_006004:0x2068",
   "off": 8296,
   "max": 28,
   "kind": "dialogue",
   "jp": "何が\\nどうなってるんだ！　",
   "en": "What on earth\\nis going on!?",
   "op": "0x62",
   "msg": "0x129f"
  },
  {
   "id": "m_006004:0x294c",
   "off": 10572,
   "max": 36,
   "kind": "dialogue",
   "jp": "きゃあーっ\\n総司さん\\nステキー！",
   "en": "Kyaaah! Soji-san,\\nyou're wonderful!",
   "op": "0x62",
   "msg": "0x12a0"
  },
  {
   "id": "m_006004:0x2dec",
   "off": 11756,
   "max": 36,
   "kind": "dialogue",
   "jp": "うおおおっ！\\n魂にずんと来るな！",
   "en": "Whoaaa! That\\nhits me right\\nin the soul!",
   "op": "0x62",
   "msg": "0x12a1"
  },
  {
   "id": "m_006004:0x3594",
   "off": 13716,
   "max": 20,
   "kind": "dialogue",
   "jp": "ええぞ　ソウちん！",
   "en": "Way to go,\\nSo-chin!",
   "op": "0x62",
   "msg": "0x12a2"
  },
  {
   "id": "m_006004:0x3c40",
   "off": 15424,
   "max": 28,
   "kind": "dialogue",
   "jp": "うん\\nみんな正気に戻ったね",
   "en": "Yeah.\\nEveryone's back\\nto their senses.",
   "op": "0x62",
   "msg": "0x12a3"
  },
  {
   "id": "m_006004:0x42dc",
   "off": 17116,
   "max": 36,
   "kind": "dialogue",
   "jp": "聴いてくれましたか？\\n近藤さん……",
   "en": "Did you hear me,\\nKondo-san...?",
   "op": "0x62",
   "msg": "0x12a4"
  },
  {
   "id": "m_006004:0x4b60",
   "off": 19296,
   "max": 32,
   "kind": "dialogue",
   "jp": "よくやった　総司\\n井伊を追うぞ",
   "en": "Well done,\\nSoji. We're\\ngoing after Ii.",
   "op": "0x62",
   "msg": "0x12a5"
  },
  {
   "id": "m_006004:0x4ffc",
   "off": 20476,
   "max": 12,
   "kind": "dialogue",
   "jp": "土方さん",
   "en": "Hijikata-san...",
   "op": "0x62",
   "msg": "0x12be"
  },
  {
   "id": "m_006004:0x59b8",
   "off": 22968,
   "max": 72,
   "kind": "dialogue",
   "jp": "井伊を追おうとする\\n土方だったが\\n傷ついた桂たちを見て\\n思いとどまった",
   "en": "Hijikata moved\\nto pursue Ii, but\\nwhen he saw\\nKatsura and the\\nothers wounded,\\nhe held back.",
   "op": "0x62",
   "msg": "0x12c4"
  },
  {
   "id": "m_006004:0x6014",
   "off": 24596,
   "max": 32,
   "kind": "dialogue",
   "jp": "……\\n一度　態勢を立て直す！",
   "en": "...We regroup!",
   "op": "0x62",
   "msg": "0x12bf"
  },
  {
   "id": "m_006004:0x6044",
   "off": 24644,
   "max": 52,
   "kind": "dialogue",
   "jp": "井伊が戻ってくると厄介だ\\nすぐにこの場を去るぞ！",
   "en": "If Ii comes back,\\nwe're in trouble.\\nWe leave this\\nplace now!",
   "op": "0x62",
   "msg": "0x12a6"
  },
  {
   "id": "m_006004:0x6724",
   "off": 26404,
   "max": 24,
   "kind": "dialogue",
   "jp": "おう　皆で逃げよう！",
   "en": "Right, let's all\\nget outta here!",
   "op": "0x62",
   "msg": "0x12a7"
  },
  {
   "id": "m_006004:0x6dd8",
   "off": 28120,
   "max": 12,
   "kind": "dialogue",
   "jp": "うう……",
   "en": "Ugh...",
   "op": "0x62",
   "msg": "0x12a8"
  },
  {
   "id": "m_006004:0x7424",
   "off": 29732,
   "max": 28,
   "kind": "dialogue",
   "jp": "メガネくん\\n僕につかまって",
   "en": "Glasses-kun,\\nhold on to me.",
   "op": "0x62",
   "msg": "0x12a9"
  },
  {
   "id": "m_006004:0x7adc",
   "off": 31452,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレ様は助けなんぞ\\nいらねぇからなっ",
   "en": "Yours truly\\ndoesn't need\\nanybody's\\nhelp, got it!?",
   "op": "0x62",
   "msg": "0x12aa"
  },
  {
   "id": "m_006004:0x7f80",
   "off": 32640,
   "max": 48,
   "kind": "dialogue",
   "jp": "スカシくんは　最初から\\n手助けする気はないよー",
   "en": "Don't worry, Mr.\\nPoser, I never\\nplanned on\\nhelping you in\\nthe first place~",
   "op": "0x62",
   "msg": "0x12ab"
  },
  {
   "id": "m_006004:0x8488",
   "off": 33928,
   "max": 60,
   "kind": "dialogue",
   "jp": "なんだとっ！　ちっ\\nいつもの調子に戻り\\nやがったな……フン",
   "en": "What was that!?\\nTch... He's back to\\nhis old self, damn\\nhim... Hmph.",
   "op": "0x62",
   "msg": "0x12ac"
  },
  {
   "id": "m_006004:0x8c50",
   "off": 35920,
   "max": 40,
   "kind": "dialogue",
   "jp": "シンディ\\nこっからさっさと\\n逃げるぞ！",
   "en": "Shindy! Let's\\nhightail it\\noutta here!",
   "op": "0x62",
   "msg": "0x12ad"
  },
  {
   "id": "m_006004:0x92bc",
   "off": 37564,
   "max": 24,
   "kind": "dialogue",
   "jp": "おう！\\nほら　手を貸せ",
   "en": "Right! Here, give\\nme your arm.",
   "op": "0x62",
   "msg": "0x12ae"
  },
  {
   "id": "m_006004:0x9b58",
   "off": 39768,
   "max": 40,
   "kind": "dialogue",
   "jp": "うおっ？\\nシンディ\\nなにをするんじゃ？",
   "en": "Whoa!? Shindy,\\nwhat're ya doin'?",
   "op": "0x62",
   "msg": "0x12af"
  },
  {
   "id": "m_006004:0xa098",
   "off": 41112,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレ様がお前を支えて\\nやるっつってんだ",
   "en": "I'm saying the\\ngreat Takasugi\\nis gonna hold\\nyou up!",
   "op": "0x62",
   "msg": "0x12b0"
  },
  {
   "id": "m_006004:0xa5d4",
   "off": 42452,
   "max": 36,
   "kind": "dialogue",
   "jp": "動けなくなってたのに\\n平気なのか？",
   "en": "You couldn't\\neven move a\\nminute ago. You\\nsure you're okay?",
   "op": "0x62",
   "msg": "0x12b1"
  },
  {
   "id": "m_006004:0xaf48",
   "off": 44872,
   "max": 52,
   "kind": "dialogue",
   "jp": "だから\\nオレ様は大丈夫だって\\n言ってるだろうが！",
   "en": "I told you,\\nyours truly is\\nfine, dammit!",
   "op": "0x62",
   "msg": "0x12b2"
  },
  {
   "id": "m_006004:0xb80c",
   "off": 47116,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうか\\nすまんな\\nシンディ",
   "en": "Oh, right. Sorry\\n'bout that, Shindy.",
   "op": "0x62",
   "msg": "0x12b3"
  },
  {
   "id": "m_006004:0xbec4",
   "off": 48836,
   "max": 28,
   "kind": "dialogue",
   "jp": "……お互い様\\nなんだよっ！",
   "en": "...We're even,\\nthat's all!",
   "op": "0x62",
   "msg": "0x12b4"
  },
  {
   "id": "m_006004:0xc6f0",
   "off": 50928,
   "max": 44,
   "kind": "dialogue",
   "jp": "近藤を抱えた土方に\\n桂を支えた沖田が続く",
   "en": "Hijikata, carrying\\nKondo, was\\nfollowed by Okita,\\nwho supported\\nKatsura.",
   "op": "0x62",
   "msg": "0x12b5"
  },
  {
   "id": "m_006004:0xc72c",
   "off": 50988,
   "max": 44,
   "kind": "dialogue",
   "jp": "高杉に肩を借りた龍馬が\\nその後に続き――",
   "en": "Behind them\\ncame Ryoma,\\nleaning on\\nTakasugi's\\nshoulder--",
   "op": "0x62",
   "msg": "0x12b6"
  },
  {
   "id": "m_006004:0xc768",
   "off": 51048,
   "max": 56,
   "kind": "dialogue",
   "jp": "まだ幾人か倒れている\\n観客を縫うようにして\\n走り去った",
   "en": "and weaving\\nbetween the\\nspectators who\\nstill lay collapsed\\nhere and there,\\nthey ran off.",
   "op": "0x62",
   "msg": "0x12b7"
  },
  {
   "id": "m_006004:0xc7b0",
   "off": 51120,
   "max": 96,
   "kind": "dialogue",
   "jp": "暗く澱んでいた会場上空の\\n雲間からは薄く光が差し\\n天へと続く梯子のように\\n光を煌めかせていた",
   "en": "Above the venue,\\nthrough the dark,\\nstagnant clouds,\\npale light broke\\nthrough,\\nglittering like a\\nladder that led up\\nto the heavens.",
   "op": "0x62",
   "msg": "0x12b8"
  }
 ]
}
