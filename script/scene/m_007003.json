   "op": "0x62",
   "msg": "0x166f"
  },
  {
   "id": "m_007003:0x1e360",
   "off": 123744,
   "max": 24,
   "kind": "dialogue",
   "jp": "くっ……\\nわかりました",
   "en": "Ngh... Very well.",
   "op": "0x62",
   "msg": "0x1670"
  },
  {
   "id": "m_007003:0x1ea1c",
   "off": 125468,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍馬……\\n必ず助けてやるからな！",
   "en": "Ryoma... I swear\\nI'll save you!",
   "op": "0x62",
   "msg": "0x1671"
  },
  {
   "id": "m_007003:0x1f138",
   "off": 127288,
   "max": 28,
   "kind": "dialogue",
   "jp": "行くぞ！\\n俺が道を開く！",
   "en": "Let's go! I'll clear\\na path!",
   "op": "0x62",
   "msg": "0x1672"
  },
  {
   "id": "m_007003:0x1f604",
   "off": 128516,
   "max": 104,
   "kind": "dialogue",
   "jp": "松陰を取り戻したものの\\n龍馬を捕らえられた四人は\\n助ける決意を胸に秘めながら\\n会場を離れるのだった――",
   "en": "They had won\\nShoin back, but\\nRyoma had been\\ncaptured. Vowing\\nin their hearts to\\nrescue him, the\\nfour left the\\nhall--",
