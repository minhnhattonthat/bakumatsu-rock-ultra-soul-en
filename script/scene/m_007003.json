   "op": "0x62",
   "msg": "0x166b"
  },
  {
   "id": "m_007003:0x1c540",
   "off": 116032,
   "max": 28,
   "kind": "dialogue",
   "jp": "いったん\\nここを離れるぞ",
   "en": "We're pulling out\\nof here for now.",
   "op": "0x62",
   "msg": "0x166c"
  },
  {
   "id": "m_007003:0x1cee4",
   "off": 118500,
   "max": 24,
   "kind": "dialogue",
   "jp": "で　でも龍馬くんが！",
   "en": "B-but Ryoma-kun\\nis...!",
   "op": "0x62",
   "msg": "0x166d"
  },
  {
   "id": "m_007003:0x1d6e8",
   "off": 120552,
   "max": 68,
   "kind": "dialogue",
   "jp": "引き際を見誤るな\\nここで俺達まで捕まったら\\n誰が坂本を助けるんだ！",
   "en": "Know when to\\nretreat. If they\\ncatch us too,\\nwho's going to\\nsave Sakamoto?",
   "op": "0x62",
   "msg": "0x166e"
  },
  {
   "id": "m_007003:0x1dba8",
   "off": 121768,
   "max": 48,
   "kind": "dialogue",
   "jp": "土方さんの言うとおりだよ\\nここは退いた方がいい",
