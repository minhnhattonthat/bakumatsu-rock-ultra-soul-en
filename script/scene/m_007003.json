{
 "source": "m_007003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_007003:0x10f8",
   "off": 4344,
   "max": 40,
   "kind": "dialogue",
   "jp": "高杉の歌に吉田松陰は\\n舞台に崩れ落ちた",
   "en": "At Takasugi's\\nsong, Shoin\\nYoshida crumpled\\nonto the stage.",
   "op": "0x62",
   "msg": "0x161d"
  },
  {
   "id": "m_007003:0x1130",
   "off": 4400,
   "max": 48,
   "kind": "dialogue",
   "jp": "うつろに譫言を繰り返す\\n松陰をみんなが見守る",
   "en": "Everyone watched\\nover Shoin as he\\nmumbled again\\nand again in a\\ndaze.",
   "op": "0x62",
   "msg": "0x1674"
  },
  {
   "id": "m_007003:0x1170",
   "off": 4464,
   "max": 76,
   "kind": "dialogue",
   "jp": "松陰が再び元にもどって\\n自分達の所へ\\n帰ってくることを\\nひたすらに願って",
   "en": "They prayed with\\nall their hearts\\nthat Shoin would\\nreturn to himself\\nand come back to\\nthem.",
   "op": "0x62",
   "msg": "0x1675"
  },
  {
   "id": "m_007003:0x1600",
   "off": 5632,
   "max": 20,
   "kind": "dialogue",
   "jp": "わしの……歌……",
   "en": "My... song...",
   "op": "0x62",
   "msg": "0x161e"
  },
  {
   "id": "m_007003:0x1624",
   "off": 5668,
   "max": 28,
   "kind": "dialogue",
   "jp": "違う……\\nこれではない……",
   "en": "No... This isn't it...",
   "op": "0x62",
   "msg": "0x161f"
  },
  {
   "id": "m_007003:0x1d34",
   "off": 7476,
   "max": 24,
   "kind": "dialogue",
   "jp": "来てるっ　来ておるぞっ",
   "en": "It's coming! It's\\ncoming, I tell you!",
   "op": "0x62",
   "msg": "0x1620"
  },
  {
   "id": "m_007003:0x239c",
   "off": 9116,
   "max": 28,
   "kind": "dialogue",
   "jp": "テンちゃん\\n大丈夫なのか？",
   "en": "Ten-chan, you\\nsure you're okay?",
   "op": "0x62",
   "msg": "0x1621"
  },
  {
   "id": "m_007003:0x2834",
   "off": 10292,
   "max": 28,
   "kind": "dialogue",
   "jp": "あとはワシに\\n任せておけ！",
   "en": "Leave the rest to\\nme, lad!",
   "op": "0x62",
   "msg": "0x1622"
  },
  {
   "id": "m_007003:0x2fe0",
   "off": 12256,
   "max": 32,
   "kind": "dialogue",
   "jp": "わしの歌……には\\nない……もの",
   "en": "What my song...\\nwas missing...",
   "op": "0x62",
   "msg": "0x1623"
  },
  {
   "id": "m_007003:0x3010",
   "off": 12304,
   "max": 32,
   "kind": "dialogue",
   "jp": "晋作の歌には\\nそれがあった……",
   "en": "Shinsaku's song...\\nhad it...",
   "op": "0x62",
   "msg": "0x1624"
  },
  {
   "id": "m_007003:0x3040",
   "off": 12352,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしの歌に……\\n足りないものは……",
   "en": "What my song...\\nlacked...",
   "op": "0x62",
   "msg": "0x1625"
  },
  {
   "id": "m_007003:0x39dc",
   "off": 14812,
   "max": 16,
   "kind": "dialogue",
   "jp": "ロックです！",
   "en": "It's rock!",
   "op": "0x62",
   "msg": "0x1626"
  },
  {
   "id": "m_007003:0x443c",
   "off": 17468,
   "max": 12,
   "kind": "dialogue",
   "jp": "ロック！",
   "en": "Rock!",
   "op": "0x62",
   "msg": "0x1627"
  },
  {
   "id": "m_007003:0x446c",
   "off": 17516,
   "max": 32,
   "kind": "dialogue",
   "jp": "そうか……\\nそうじゃった……！",
   "en": "Ah... of course.\\nThat was it...!",
   "op": "0x62",
   "msg": "0x1628"
  },
  {
   "id": "m_007003:0x4bb0",
   "off": 19376,
   "max": 32,
   "kind": "dialogue",
   "jp": "足りないものは……\\nロック",
   "en": "What it lacked...\\nwas rock.",
   "op": "0x62",
   "msg": "0x1629"
  },
  {
   "id": "m_007003:0x54c4",
   "off": 21700,
   "max": 48,
   "kind": "dialogue",
   "jp": "思い出したようじゃな\\nショウ\\n本当の自分の歌を",
   "en": "Looks like you've\\nremembered,\\nShow. Your own\\ntrue song.",
   "op": "0x62",
   "msg": "0x162a"
  },
  {
   "id": "m_007003:0x5970",
   "off": 22896,
   "max": 20,
   "kind": "dialogue",
   "jp": "う……ああ……！",
   "en": "Ngh... ahh...!",
   "op": "0x62",
   "msg": "0x162b"
  },
  {
   "id": "m_007003:0x5e54",
   "off": 24148,
   "max": 44,
   "kind": "dialogue",
   "jp": "行くぞ　ショウ！\\n今こそ我が身をひとつに！",
   "en": "Here we go,\\nShow! Now we\\nbecome one again!",
   "op": "0x62",
   "msg": "0x162c"
  },
  {
   "id": "m_007003:0x66cc",
   "off": 26316,
   "max": 24,
   "kind": "dialogue",
   "jp": "合一（フュージョン）！",
   "en": "Fusion!",
   "op": "0x62",
   "msg": "0x162d"
  },
  {
   "id": "m_007003:0x6b4c",
   "off": 27468,
   "max": 60,
   "kind": "dialogue",
   "jp": "互いを弾き飛ばすほどの\\n勢いで　天狗が松陰に\\nぶつかった",
   "en": "The Tengu\\nslammed into\\nShoin with\\nenough force to\\nsend them both\\nflying.",
   "op": "0x62",
   "msg": "0x162e"
  },
  {
   "id": "m_007003:0x70b8",
   "off": 28856,
   "max": 52,
   "kind": "dialogue",
   "jp": "だが　その後舞台に\\n残っていたのは\\n松陰の姿のみ",
   "en": "But afterward,\\nthe only one left\\non the stage was\\nShoin.",
   "op": "0x62",
   "msg": "0x162f"
  },
  {
   "id": "m_007003:0x76ec",
   "off": 30444,
   "max": 20,
   "kind": "dialogue",
   "jp": "な　なんだあああ",
   "en": "Wh-whaaaaat!?",
   "op": "0x62",
   "msg": "0x1630"
  },
  {
   "id": "m_007003:0x7df8",
   "off": 32248,
   "max": 40,
   "kind": "dialogue",
   "jp": "松陰先生の身体に\\n天狗の人が入った",
   "en": "That Tengu\\nfellow went into\\nShoin-sensei's\\nbody!",
   "op": "0x62",
   "msg": "0x1631"
  },
  {
   "id": "m_007003:0x8518",
   "off": 34072,
   "max": 32,
   "kind": "dialogue",
   "jp": "す　すげえ\\nどうなってんだ",
   "en": "Wh-whoa... What\\nthe hell just\\nhappened?",
   "op": "0x62",
   "msg": "0x1632"
  },
  {
   "id": "m_007003:0x8c78",
   "off": 35960,
   "max": 12,
   "kind": "dialogue",
   "jp": "ふうう……",
   "en": "Phewww...",
   "op": "0x62",
   "msg": "0x1633"
  },
  {
   "id": "m_007003:0x8c94",
   "off": 35988,
   "max": 24,
   "kind": "dialogue",
   "jp": "ようやく元に戻ったな",
   "en": "Ahh, at long last,\\nI'm myself again.",
   "op": "0x62",
   "msg": "0x1634"
  },
  {
   "id": "m_007003:0x942c",
   "off": 37932,
   "max": 40,
   "kind": "dialogue",
   "jp": "天狗のおじさんと\\n合体しちゃったの？",
   "en": "You merged with\\nthe old Tengu\\nguy?",
   "op": "0x62",
   "msg": "0x1635"
  },
  {
   "id": "m_007003:0x9954",
   "off": 39252,
   "max": 40,
   "kind": "dialogue",
   "jp": "そうじゃ　合体して\\n元に戻ったんじゃよ",
   "en": "That's right. We\\nmerged, and I'm\\nmyself again, lad.",
   "op": "0x62",
   "msg": "0x1636"
  },
  {
   "id": "m_007003:0xa248",
   "off": 41544,
   "max": 16,
   "kind": "dialogue",
   "jp": "元に戻った……",
   "en": "Back to himself...",
   "op": "0x62",
   "msg": "0x1637"
  },
  {
   "id": "m_007003:0xa6d4",
   "off": 42708,
   "max": 24,
   "kind": "dialogue",
   "jp": "どういうことですか？",
   "en": "What do you\\nmean?",
   "op": "0x62",
   "msg": "0x1638"
  },
  {
   "id": "m_007003:0xae74",
   "off": 44660,
   "max": 60,
   "kind": "dialogue",
   "jp": "天狗はわしが井伊に\\n洗脳される瞬間に\\n切り離した良き心じゃ",
   "en": "The Tengu was\\nmy good heart,\\ncut loose the very\\nmoment Ii\\nbrainwashed me.",
   "op": "0x62",
   "msg": "0x1639"
  },
  {
   "id": "m_007003:0xaec0",
   "off": 44736,
   "max": 48,
   "kind": "dialogue",
   "jp": "わしがむざむざ\\nやられるはずは\\nないじゃろう",
   "en": "You didn't think\\nI'd go down\\nwithout a fight,\\ndid you, lads?",
   "op": "0x62",
   "msg": "0x163a"
  },
  {
   "id": "m_007003:0xb590",
   "off": 46480,
   "max": 52,
   "kind": "dialogue",
   "jp": "だから　テンちゃんは\\nわしに色々して\\nくれたのか",
   "en": "So that's why\\nTen-chan did all\\nthat stuff for me!",
   "op": "0x62",
   "msg": "0x163b"
  },
  {
   "id": "m_007003:0xb5d4",
   "off": 46548,
   "max": 40,
   "kind": "dialogue",
   "jp": "さすがはセンセーの先生！\\nやるなあ！",
   "en": "That's Sensei's\\nsensei for ya!\\nNice work!",
   "op": "0x62",
   "msg": "0x163c"
  },
  {
   "id": "m_007003:0xbca0",
   "off": 48288,
   "max": 28,
   "kind": "dialogue",
   "jp": "本当に元に戻ったんですね",
   "en": "You really are\\nback to yourself.",
   "op": "0x62",
   "msg": "0x163d"
  },
  {
   "id": "m_007003:0xc360",
   "off": 50016,
   "max": 40,
   "kind": "dialogue",
   "jp": "すまんかったのう\\nみんな\\n心配かけた",
   "en": "Sorry about all\\nthat, everyone. I\\nmade you worry.",
   "op": "0x62",
   "msg": "0x163e"
  },
  {
   "id": "m_007003:0xca2c",
   "off": 51756,
   "max": 40,
   "kind": "dialogue",
   "jp": "松陰先生……\\nオレ様……オレは……！",
   "en": "Shoin-sensei...\\nYours truly... I...!",
   "op": "0x62",
   "msg": "0x163f"
  },
  {
   "id": "m_007003:0xd0f8",
   "off": 53496,
   "max": 36,
   "kind": "dialogue",
   "jp": "晋作や皆の魂\\nしかとわしに届いたぞ",
   "en": "Shinsaku, your\\nsoul and\\neveryone's\\nreached me loud\\nand clear.",
   "op": "0x62",
   "msg": "0x1640"
  },
  {
   "id": "m_007003:0xd958",
   "off": 55640,
   "max": 20,
   "kind": "dialogue",
   "jp": "松陰先生ーーーっ",
   "en": "Shoin-senseiiiii!",
   "op": "0x62",
   "msg": "0x1641"
  },
  {
   "id": "m_007003:0xddf0",
   "off": 56816,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍馬達と一緒になって\\nお前も成長したようじゃ",
   "en": "Being with Ryoma\\nand the others\\nhas helped you\\ngrow too, it\\nseems, my boy.",
   "op": "0x62",
   "msg": "0x1642"
  },
  {
   "id": "m_007003:0xe29c",
   "off": 58012,
   "max": 24,
   "kind": "dialogue",
   "jp": "ありがとうございますっ",
   "en": "Thank you so\\nmuch!",
   "op": "0x62",
   "msg": "0x1643"
  },
  {
   "id": "m_007003:0xea3c",
   "off": 59964,
   "max": 32,
   "kind": "dialogue",
   "jp": "やった\\n松陰先生が元に戻った！",
   "en": "We did it!\\nShoin-sensei is\\nback to himself!",
   "op": "0x62",
   "msg": "0x1644"
  },
  {
   "id": "m_007003:0xf208",
   "off": 61960,
   "max": 32,
   "kind": "dialogue",
   "jp": "おおー！\\nこれはめでたいぜよ！",
   "en": "Woohoo! Now this\\nis cause to\\ncelebrate!",
   "op": "0x62",
   "msg": "0x1645"
  },
  {
   "id": "m_007003:0xfab8",
   "off": 64184,
   "max": 60,
   "kind": "dialogue",
   "jp": "これからは先生も\\nオレ達と一緒に\\n雷舞ができるんですね！",
   "en": "So from now on\\nyou can play a\\nlive with us too,\\nSensei!",
   "op": "0x62",
   "msg": "0x1646"
  },
  {
   "id": "m_007003:0xff70",
   "off": 65392,
   "max": 32,
   "kind": "dialogue",
   "jp": "すまんが\\nそれはできんのじゃ",
   "en": "I'm sorry, lad, but\\nthat I cannot do.",
   "op": "0x62",
   "msg": "0x1647"
  },
  {
   "id": "m_007003:0x10610",
   "off": 67088,
   "max": 44,
   "kind": "dialogue",
   "jp": "ど　どうしてですか？\\nオレ達が未熟だから？",
   "en": "Wh-why not?\\nBecause we're not\\ngood enough yet?",
   "op": "0x62",
   "msg": "0x1648"
  },
  {
   "id": "m_007003:0x106f4",
   "off": 67316,
   "max": 68,
   "kind": "dialogue",
   "jp": "もっと練習します！\\nオレ　先生に教わりたい\\nことが　たくさん――",
   "en": "I'll practice\\nharder! There's so\\nmuch I want you\\nto teach me,\\nSensei--",
   "op": "0x62",
   "msg": "0x1649"
  },
  {
   "id": "m_007003:0x10e04",
   "off": 69124,
   "max": 48,
   "kind": "dialogue",
   "jp": "うろたえる高杉に\\n松陰が優しく\\nほほえみかける",
   "en": "Shoin smiled\\ngently at the\\nflustered\\nTakasugi.",
   "op": "0x62",
   "msg": "0x164a"
  },
  {
   "id": "m_007003:0x11154",
   "off": 69972,
   "max": 48,
   "kind": "dialogue",
   "jp": "同時に松陰の身体が\\n光に包まれ\\nふわりと浮いた",
   "en": "At the same time,\\nShoin's body was\\nwrapped in light\\nand floated softly\\nupward.",
   "op": "0x62",
   "msg": "0x164b"
  },
  {
   "id": "m_007003:0x11a08",
   "off": 72200,
   "max": 8,
   "kind": "dialogue",
   "jp": "先生",
   "en": "Sensei...",
   "op": "0x62",
   "msg": "0x164c"
  },
  {
   "id": "m_007003:0x123d0",
   "off": 74704,
   "max": 28,
   "kind": "dialogue",
   "jp": "そんな顔をするな\\n晋作よ",
   "en": "Don't make that\\nface, Shinsaku.",
   "op": "0x62",
   "msg": "0x164d"
  },
  {
   "id": "m_007003:0x123fc",
   "off": 74748,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしの身体はな\\nもう命数を使い果たして\\nおるのじゃ",
   "en": "You see, my body\\nhas already used\\nup all its allotted\\nyears.",
   "op": "0x62",
   "msg": "0x164e"
  },
  {
   "id": "m_007003:0x12440",
   "off": 74816,
   "max": 68,
   "kind": "dialogue",
   "jp": "お前達のことが心配で\\n少々無理をして現世に\\n留まっておったのじゃが",
   "en": "I was worried\\nabout you all, so I\\npushed myself a\\nlittle to stay in\\nthis world, but...",
   "op": "0x62",
   "msg": "0x164f"
  },
  {
   "id": "m_007003:0x12494",
   "off": 74900,
   "max": 60,
   "kind": "dialogue",
   "jp": "お前達が　わしのロックを\\nきちんと受け継いでくれて\\nおった",
   "en": "...you've all\\ninherited my\\nrock, every bit of\\nit.",
   "op": "0x62",
   "msg": "0x1650"
  },
  {
   "id": "m_007003:0x124e0",
   "off": 74976,
   "max": 24,
   "kind": "dialogue",
   "jp": "晋作　桂\\nそれに龍馬よ",
   "en": "Shinsaku,\\nKatsura... and you\\ntoo, Ryoma.",
   "op": "0x62",
   "msg": "0x1651"
  },
  {
   "id": "m_007003:0x12508",
   "off": 75016,
   "max": 68,
   "kind": "dialogue",
   "jp": "お前達は　もう一人前の\\n志士じゃ　いつしか\\nわしさえも越えるだろう",
   "en": "You are all\\nfull-fledged\\nrebels now.\\nSomeday, you'll\\nsurpass even me.",
   "op": "0x62",
   "msg": "0x1652"
  },
  {
   "id": "m_007003:0x12f58",
   "off": 77656,
   "max": 28,
   "kind": "dialogue",
   "jp": "そんな\\n先生　オレは……！",
   "en": "No... Sensei, I...!",
   "op": "0x62",
   "msg": "0x1653"
  },
  {
   "id": "m_007003:0x13920",
   "off": 80160,
   "max": 44,
   "kind": "dialogue",
   "jp": "わしは　役目を終えた\\n少し休ませてもらうぞ",
   "en": "I've done my part.\\nI'll be taking a\\nlittle rest now,\\nlad.",
   "op": "0x62",
   "msg": "0x1654"
  },
  {
   "id": "m_007003:0x13cf8",
   "off": 81144,
   "max": 48,
   "kind": "dialogue",
   "jp": "松陰の身体を包む光が\\nどんどんと強くなっていく",
   "en": "The light\\nwrapped around\\nShoin's body grew\\nbrighter and\\nbrighter.",
   "op": "0x62",
   "msg": "0x1655"
  },
  {
   "id": "m_007003:0x14030",
   "off": 81968,
   "max": 32,
   "kind": "dialogue",
   "jp": "さらばだ\\n愛しい弟子達よ……",
   "en": "Farewell, my\\nbeloved\\ndisciples...",
   "op": "0x62",
   "msg": "0x1656"
  },
  {
   "id": "m_007003:0x14a48",
   "off": 84552,
   "max": 24,
   "kind": "dialogue",
   "jp": "先生\\nうううっ……",
   "en": "Sensei... Nnngh...",
   "op": "0x62",
   "msg": "0x1657"
  },
  {
   "id": "m_007003:0x14f00",
   "off": 85760,
   "max": 56,
   "kind": "dialogue",
   "jp": "そして松陰の魂は\\n光の粒となって\\n天へと昇っていった",
   "en": "And then Shoin's\\nsoul became\\nparticles of light\\nand rose up to\\nthe heavens.",
   "op": "0x62",
   "msg": "0x1658"
  },
  {
   "id": "m_007003:0x15390",
   "off": 86928,
   "max": 36,
   "kind": "dialogue",
   "jp": "松陰先生……\\nあとは任せてください",
   "en": "Shoin-sensei...\\nLeave the rest to\\nus.",
   "op": "0x62",
   "msg": "0x1659"
  },
  {
   "id": "m_007003:0x153c4",
   "off": 86980,
   "max": 48,
   "kind": "dialogue",
   "jp": "先生の教えは\\n先生のロックは\\n決して忘れません",
   "en": "Your teachings...\\nyour rock... I'll\\nnever forget\\nthem.",
   "op": "0x62",
   "msg": "0x165a"
  },
  {
   "id": "m_007003:0x15a98",
   "off": 88728,
   "max": 64,
   "kind": "dialogue",
   "jp": "私達は　必ず幕府を倒し\\n自由に歌が歌える世界を\\n取り戻します",
   "en": "We will bring\\ndown the\\nshogunate\\nwithout fail, and\\ntake back a world\\nwhere songs can\\nbe sung freely.",
   "op": "0x62",
   "msg": "0x165b"
  },
  {
   "id": "m_007003:0x16178",
   "off": 90488,
   "max": 60,
   "kind": "dialogue",
   "jp": "モジャモジャの先生\\n笑いながら天に帰って\\nいったぜよ……",
   "en": "The Shaggy\\nSensei went back\\nup to heaven with\\na smile, y'know...",
   "op": "0x62",
   "msg": "0x165c"
  },
  {
   "id": "m_007003:0x1664c",
   "off": 91724,
   "max": 100,
   "kind": "dialogue",
   "jp": "松陰との別れの余韻に\\n浸っていた龍馬達は\\n背後に黒い影が\\n忍び寄っていることに\\n気付いていなかった",
   "en": "Lost in the\\nafterglow of their\\nfarewell to Shoin,\\nRyoma and the\\nothers didn't\\nnotice a dark\\nshadow creeping\\nup behind them.",
   "op": "0x62",
   "msg": "0x165d"
  },
  {
   "id": "m_007003:0x174b8",
   "off": 95416,
   "max": 20,
   "kind": "dialogue",
   "jp": "危ないっ！\\n坂本",
   "en": "Look out!\\nSakamoto!",
   "op": "0x62",
   "msg": "0x165e"
  },
  {
   "id": "m_007003:0x17f50",
   "off": 98128,
   "max": 12,
   "kind": "dialogue",
   "jp": "はぐっ",
   "en": "Hngh!",
   "op": "0x62",
   "msg": "0x165f"
  },
  {
   "id": "m_007003:0x18b4c",
   "off": 101196,
   "max": 16,
   "kind": "dialogue",
   "jp": "トサカくん",
   "en": "Tosaka-kun!",
   "op": "0x62",
   "msg": "0x1660"
  },
  {
   "id": "m_007003:0x1916c",
   "off": 102764,
   "max": 48,
   "kind": "dialogue",
   "jp": "いきなり舞台に現れた\\n影が　龍馬を攫って行く",
   "en": "The shadow that\\nhad suddenly\\nappeared on\\nstage carried\\nRyoma off.",
   "op": "0x62",
   "msg": "0x1661"
  },
  {
   "id": "m_007003:0x195e0",
   "off": 103904,
   "max": 12,
   "kind": "dialogue",
   "jp": "しまった！",
   "en": "Damn it!",
