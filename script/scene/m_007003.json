{
 "source": "m_007003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_007003:0x10f8",
   "off": 4344,
   "max": 40,
   "kind": "dialogue",
   "jp": "高杉の歌に吉田松陰は\\n舞台に崩れ落ちた",
   "en": "",
   "op": "0x62",
   "msg": "0x161d"
  },
  {
   "id": "m_007003:0x1130",
   "off": 4400,
   "max": 48,
   "kind": "dialogue",
   "jp": "うつろに譫言を繰り返す\\n松陰をみんなが見守る",
   "en": "",
   "op": "0x62",
   "msg": "0x1674"
  },
  {
   "id": "m_007003:0x1170",
   "off": 4464,
   "max": 76,
   "kind": "dialogue",
   "jp": "松陰が再び元にもどって\\n自分達の所へ\\n帰ってくることを\\nひたすらに願って",
   "en": "",
   "op": "0x62",
   "msg": "0x1675"
  },
  {
   "id": "m_007003:0x1600",
   "off": 5632,
   "max": 20,
   "kind": "dialogue",
   "jp": "わしの……歌……",
   "en": "",
   "op": "0x62",
   "msg": "0x161e"
  },
  {
   "id": "m_007003:0x1624",
   "off": 5668,
   "max": 28,
   "kind": "dialogue",
   "jp": "違う……\\nこれではない……",
   "en": "",
   "op": "0x62",
   "msg": "0x161f"
  },
  {
   "id": "m_007003:0x1d34",
   "off": 7476,
   "max": 24,
   "kind": "dialogue",
   "jp": "来てるっ　来ておるぞっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1620"
  },
  {
   "id": "m_007003:0x239c",
   "off": 9116,
   "max": 28,
   "kind": "dialogue",
   "jp": "テンちゃん\\n大丈夫なのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1621"
  },
  {
   "id": "m_007003:0x2834",
   "off": 10292,
   "max": 28,
   "kind": "dialogue",
   "jp": "あとはワシに\\n任せておけ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1622"
  },
  {
   "id": "m_007003:0x2fe0",
   "off": 12256,
   "max": 32,
   "kind": "dialogue",
   "jp": "わしの歌……には\\nない……もの",
   "en": "",
   "op": "0x62",
   "msg": "0x1623"
  },
  {
   "id": "m_007003:0x3010",
   "off": 12304,
   "max": 32,
   "kind": "dialogue",
   "jp": "晋作の歌には\\nそれがあった……",
   "en": "",
   "op": "0x62",
   "msg": "0x1624"
  },
  {
   "id": "m_007003:0x3040",
   "off": 12352,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしの歌に……\\n足りないものは……",
   "en": "",
   "op": "0x62",
   "msg": "0x1625"
  },
  {
   "id": "m_007003:0x39dc",
   "off": 14812,
   "max": 16,
   "kind": "dialogue",
   "jp": "ロックです！",
   "en": "",
   "op": "0x62",
   "msg": "0x1626"
  },
  {
   "id": "m_007003:0x443c",
   "off": 17468,
   "max": 12,
   "kind": "dialogue",
   "jp": "ロック！",
   "en": "",
   "op": "0x62",
   "msg": "0x1627"
  },
  {
   "id": "m_007003:0x446c",
   "off": 17516,
   "max": 32,
   "kind": "dialogue",
   "jp": "そうか……\\nそうじゃった……！",
   "en": "",
   "op": "0x62",
   "msg": "0x1628"
  },
  {
   "id": "m_007003:0x4bb0",
   "off": 19376,
   "max": 32,
   "kind": "dialogue",
   "jp": "足りないものは……\\nロック",
   "en": "",
   "op": "0x62",
   "msg": "0x1629"
  },
  {
   "id": "m_007003:0x54c4",
   "off": 21700,
   "max": 48,
   "kind": "dialogue",
   "jp": "思い出したようじゃな\\nショウ\\n本当の自分の歌を",
   "en": "",
   "op": "0x62",
   "msg": "0x162a"
  },
  {
   "id": "m_007003:0x5970",
   "off": 22896,
   "max": 20,
   "kind": "dialogue",
   "jp": "う……ああ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x162b"
  },
  {
   "id": "m_007003:0x5e54",
   "off": 24148,
   "max": 44,
   "kind": "dialogue",
   "jp": "行くぞ　ショウ！\\n今こそ我が身をひとつに！",
   "en": "",
   "op": "0x62",
   "msg": "0x162c"
  },
  {
   "id": "m_007003:0x66cc",
   "off": 26316,
   "max": 24,
   "kind": "dialogue",
   "jp": "合一（フュージョン）！",
   "en": "",
   "op": "0x62",
   "msg": "0x162d"
  },
  {
   "id": "m_007003:0x6b4c",
   "off": 27468,
   "max": 60,
   "kind": "dialogue",
   "jp": "互いを弾き飛ばすほどの\\n勢いで　天狗が松陰に\\nぶつかった",
   "en": "",
   "op": "0x62",
   "msg": "0x162e"
  },
  {
   "id": "m_007003:0x70b8",
   "off": 28856,
   "max": 52,
   "kind": "dialogue",
   "jp": "だが　その後舞台に\\n残っていたのは\\n松陰の姿のみ",
   "en": "",
   "op": "0x62",
   "msg": "0x162f"
  },
  {
   "id": "m_007003:0x76ec",
   "off": 30444,
   "max": 20,
   "kind": "dialogue",
   "jp": "な　なんだあああ",
   "en": "",
   "op": "0x62",
   "msg": "0x1630"
  },
  {
   "id": "m_007003:0x7df8",
   "off": 32248,
   "max": 40,
   "kind": "dialogue",
   "jp": "松陰先生の身体に\\n天狗の人が入った",
   "en": "",
   "op": "0x62",
   "msg": "0x1631"
  },
  {
   "id": "m_007003:0x8518",
   "off": 34072,
   "max": 32,
   "kind": "dialogue",
   "jp": "す　すげえ\\nどうなってんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1632"
  },
  {
   "id": "m_007003:0x8c78",
   "off": 35960,
   "max": 12,
   "kind": "dialogue",
   "jp": "ふうう……",
   "en": "",
   "op": "0x62",
   "msg": "0x1633"
  },
  {
   "id": "m_007003:0x8c94",
   "off": 35988,
   "max": 24,
   "kind": "dialogue",
   "jp": "ようやく元に戻ったな",
   "en": "",
   "op": "0x62",
   "msg": "0x1634"
  },
  {
   "id": "m_007003:0x942c",
   "off": 37932,
   "max": 40,
   "kind": "dialogue",
   "jp": "天狗のおじさんと\\n合体しちゃったの？",
   "en": "",
   "op": "0x62",
   "msg": "0x1635"
  },
  {
   "id": "m_007003:0x9954",
   "off": 39252,
   "max": 40,
   "kind": "dialogue",
   "jp": "そうじゃ　合体して\\n元に戻ったんじゃよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1636"
  },
  {
   "id": "m_007003:0xa248",
   "off": 41544,
   "max": 16,
   "kind": "dialogue",
   "jp": "元に戻った……",
   "en": "",
   "op": "0x62",
   "msg": "0x1637"
  },
  {
   "id": "m_007003:0xa6d4",
   "off": 42708,
   "max": 24,
   "kind": "dialogue",
   "jp": "どういうことですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1638"
  },
  {
   "id": "m_007003:0xae74",
   "off": 44660,
   "max": 60,
   "kind": "dialogue",
   "jp": "天狗はわしが井伊に\\n洗脳される瞬間に\\n切り離した良き心じゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1639"
  },
  {
   "id": "m_007003:0xaec0",
   "off": 44736,
   "max": 48,
   "kind": "dialogue",
   "jp": "わしがむざむざ\\nやられるはずは\\nないじゃろう",
   "en": "",
   "op": "0x62",
   "msg": "0x163a"
  },
  {
   "id": "m_007003:0xb590",
   "off": 46480,
   "max": 52,
   "kind": "dialogue",
   "jp": "だから　テンちゃんは\\nわしに色々して\\nくれたのか",
   "en": "",
   "op": "0x62",
   "msg": "0x163b"
  },
  {
   "id": "m_007003:0xb5d4",
   "off": 46548,
   "max": 40,
   "kind": "dialogue",
   "jp": "さすがはセンセーの先生！\\nやるなあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x163c"
  },
  {
   "id": "m_007003:0xbca0",
   "off": 48288,
   "max": 28,
   "kind": "dialogue",
   "jp": "本当に元に戻ったんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x163d"
  },
  {
   "id": "m_007003:0xc360",
   "off": 50016,
   "max": 40,
   "kind": "dialogue",
   "jp": "すまんかったのう\\nみんな\\n心配かけた",
   "en": "",
   "op": "0x62",
   "msg": "0x163e"
  },
  {
   "id": "m_007003:0xca2c",
   "off": 51756,
   "max": 40,
   "kind": "dialogue",
   "jp": "松陰先生……\\nオレ様……オレは……！",
   "en": "",
   "op": "0x62",
   "msg": "0x163f"
  },
  {
   "id": "m_007003:0xd0f8",
   "off": 53496,
   "max": 36,
   "kind": "dialogue",
   "jp": "晋作や皆の魂\\nしかとわしに届いたぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x1640"
  },
  {
   "id": "m_007003:0xd958",
   "off": 55640,
   "max": 20,
   "kind": "dialogue",
   "jp": "松陰先生ーーーっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1641"
  },
  {
   "id": "m_007003:0xddf0",
   "off": 56816,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍馬達と一緒になって\\nお前も成長したようじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1642"
  },
  {
   "id": "m_007003:0xe29c",
   "off": 58012,
   "max": 24,
   "kind": "dialogue",
   "jp": "ありがとうございますっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1643"
  },
  {
   "id": "m_007003:0xea3c",
   "off": 59964,
   "max": 32,
   "kind": "dialogue",
   "jp": "やった\\n松陰先生が元に戻った！",
   "en": "",
   "op": "0x62",
   "msg": "0x1644"
  },
  {
   "id": "m_007003:0xf208",
   "off": 61960,
   "max": 32,
   "kind": "dialogue",
   "jp": "おおー！\\nこれはめでたいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1645"
  },
  {
   "id": "m_007003:0xfab8",
   "off": 64184,
   "max": 60,
   "kind": "dialogue",
   "jp": "これからは先生も\\nオレ達と一緒に\\n雷舞ができるんですね！",
   "en": "",
   "op": "0x62",
   "msg": "0x1646"
  },
  {
   "id": "m_007003:0xff70",
   "off": 65392,
   "max": 32,
   "kind": "dialogue",
   "jp": "すまんが\\nそれはできんのじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1647"
  },
  {
   "id": "m_007003:0x10610",
   "off": 67088,
   "max": 44,
   "kind": "dialogue",
   "jp": "ど　どうしてですか？\\nオレ達が未熟だから？",
   "en": "",
   "op": "0x62",
   "msg": "0x1648"
  },
  {
   "id": "m_007003:0x106f4",
   "off": 67316,
   "max": 68,
   "kind": "dialogue",
   "jp": "もっと練習します！\\nオレ　先生に教わりたい\\nことが　たくさん――",
   "en": "",
   "op": "0x62",
   "msg": "0x1649"
  },
  {
   "id": "m_007003:0x10e04",
   "off": 69124,
   "max": 48,
   "kind": "dialogue",
   "jp": "うろたえる高杉に\\n松陰が優しく\\nほほえみかける",
   "en": "",
   "op": "0x62",
   "msg": "0x164a"
  },
  {
   "id": "m_007003:0x11154",
   "off": 69972,
   "max": 48,
   "kind": "dialogue",
   "jp": "同時に松陰の身体が\\n光に包まれ\\nふわりと浮いた",
   "en": "",
   "op": "0x62",
   "msg": "0x164b"
  },
  {
   "id": "m_007003:0x11a08",
   "off": 72200,
   "max": 8,
   "kind": "dialogue",
   "jp": "先生",
   "en": "",
   "op": "0x62",
   "msg": "0x164c"
  },
  {
   "id": "m_007003:0x123d0",
   "off": 74704,
   "max": 28,
   "kind": "dialogue",
   "jp": "そんな顔をするな\\n晋作よ",
   "en": "",
   "op": "0x62",
   "msg": "0x164d"
  },
  {
   "id": "m_007003:0x123fc",
   "off": 74748,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしの身体はな\\nもう命数を使い果たして\\nおるのじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x164e"
  },
  {
   "id": "m_007003:0x12440",
   "off": 74816,
   "max": 68,
   "kind": "dialogue",
   "jp": "お前達のことが心配で\\n少々無理をして現世に\\n留まっておったのじゃが",
   "en": "",
   "op": "0x62",
   "msg": "0x164f"
  },
  {
   "id": "m_007003:0x12494",
   "off": 74900,
   "max": 60,
   "kind": "dialogue",
   "jp": "お前達が　わしのロックを\\nきちんと受け継いでくれて\\nおった",
   "en": "",
   "op": "0x62",
   "msg": "0x1650"
  },
  {
   "id": "m_007003:0x124e0",
   "off": 74976,
   "max": 24,
   "kind": "dialogue",
   "jp": "晋作　桂\\nそれに龍馬よ",
   "en": "",
   "op": "0x62",
   "msg": "0x1651"
  },
  {
   "id": "m_007003:0x12508",
   "off": 75016,
   "max": 68,
   "kind": "dialogue",
   "jp": "お前達は　もう一人前の\\n志士じゃ　いつしか\\nわしさえも越えるだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x1652"
  },
  {
   "id": "m_007003:0x12f58",
   "off": 77656,
   "max": 28,
   "kind": "dialogue",
   "jp": "そんな\\n先生　オレは……！",
   "en": "",
   "op": "0x62",
   "msg": "0x1653"
  },
  {
   "id": "m_007003:0x13920",
   "off": 80160,
   "max": 44,
   "kind": "dialogue",
   "jp": "わしは　役目を終えた\\n少し休ませてもらうぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x1654"
  },
  {
   "id": "m_007003:0x13cf8",
   "off": 81144,
   "max": 48,
   "kind": "dialogue",
   "jp": "松陰の身体を包む光が\\nどんどんと強くなっていく",
   "en": "",
   "op": "0x62",
   "msg": "0x1655"
  },
  {
   "id": "m_007003:0x14030",
   "off": 81968,
   "max": 32,
   "kind": "dialogue",
   "jp": "さらばだ\\n愛しい弟子達よ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1656"
  },
  {
   "id": "m_007003:0x14a48",
   "off": 84552,
   "max": 24,
   "kind": "dialogue",
   "jp": "先生\\nうううっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1657"
  },
  {
   "id": "m_007003:0x14f00",
   "off": 85760,
   "max": 56,
   "kind": "dialogue",
   "jp": "そして松陰の魂は\\n光の粒となって\\n天へと昇っていった",
   "en": "",
   "op": "0x62",
   "msg": "0x1658"
  },
  {
   "id": "m_007003:0x15390",
   "off": 86928,
   "max": 36,
   "kind": "dialogue",
   "jp": "松陰先生……\\nあとは任せてください",
   "en": "",
   "op": "0x62",
   "msg": "0x1659"
  },
  {
   "id": "m_007003:0x153c4",
   "off": 86980,
   "max": 48,
   "kind": "dialogue",
   "jp": "先生の教えは\\n先生のロックは\\n決して忘れません",
   "en": "",
   "op": "0x62",
   "msg": "0x165a"
  },
  {
   "id": "m_007003:0x15a98",
   "off": 88728,
   "max": 64,
   "kind": "dialogue",
   "jp": "私達は　必ず幕府を倒し\\n自由に歌が歌える世界を\\n取り戻します",
   "en": "",
   "op": "0x62",
   "msg": "0x165b"
  },
  {
   "id": "m_007003:0x16178",
   "off": 90488,
   "max": 60,
   "kind": "dialogue",
   "jp": "モジャモジャの先生\\n笑いながら天に帰って\\nいったぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x165c"
  },
  {
   "id": "m_007003:0x1664c",
   "off": 91724,
   "max": 100,
   "kind": "dialogue",
   "jp": "松陰との別れの余韻に\\n浸っていた龍馬達は\\n背後に黒い影が\\n忍び寄っていることに\\n気付いていなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x165d"
  },
  {
   "id": "m_007003:0x174b8",
   "off": 95416,
   "max": 20,
   "kind": "dialogue",
   "jp": "危ないっ！\\n坂本",
   "en": "",
   "op": "0x62",
   "msg": "0x165e"
  },
  {
   "id": "m_007003:0x17f50",
   "off": 98128,
   "max": 12,
   "kind": "dialogue",
   "jp": "はぐっ",
   "en": "",
   "op": "0x62",
   "msg": "0x165f"
  },
  {
   "id": "m_007003:0x18b4c",
   "off": 101196,
   "max": 16,
   "kind": "dialogue",
   "jp": "トサカくん",
   "en": "",
   "op": "0x62",
   "msg": "0x1660"
  },
  {
   "id": "m_007003:0x1916c",
   "off": 102764,
   "max": 48,
   "kind": "dialogue",
   "jp": "いきなり舞台に現れた\\n影が　龍馬を攫って行く",
   "en": "",
   "op": "0x62",
   "msg": "0x1661"
  },
  {
   "id": "m_007003:0x195e0",
   "off": 103904,
   "max": 12,
   "kind": "dialogue",
   "jp": "しまった！",
   "en": "",
   "op": "0x62",
   "msg": "0x1662"
  },
  {
   "id": "m_007003:0x19e24",
   "off": 106020,
   "max": 28,
   "kind": "dialogue",
   "jp": "なにしやがるっ！\\n待て！",
   "en": "",
   "op": "0x62",
   "msg": "0x1663"
  },
  {
   "id": "m_007003:0x1a5b4",
   "off": 107956,
   "max": 16,
   "kind": "dialogue",
   "jp": "龍馬くんっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1664"
  },
  {
   "id": "m_007003:0x1ae98",
   "off": 110232,
   "max": 52,
   "kind": "dialogue",
   "jp": "追いかけた\\n高杉たちの前に\\n何人もの武士が現れた",
   "en": "",
   "op": "0x62",
   "msg": "0x1665"
  },
  {
   "id": "m_007003:0x1aedc",
   "off": 110300,
   "max": 64,
   "kind": "dialogue",
   "jp": "それだけではない\\n今までじっと座っていた\\n観客達が立ちあがり",
   "en": "",
   "op": "0x62",
   "msg": "0x1666"
  },
  {
   "id": "m_007003:0x1af2c",
   "off": 110380,
   "max": 36,
   "kind": "dialogue",
   "jp": "彼らの道をふさぐように\\n取り囲む",
   "en": "",
   "op": "0x62",
   "msg": "0x1667"
  },
  {
   "id": "m_007003:0x1af60",
   "off": 110432,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍馬の姿はすでに\\nどこにも見えない",
   "en": "",
   "op": "0x62",
   "msg": "0x1668"
  },
  {
   "id": "m_007003:0x1b5f8",
   "off": 112120,
   "max": 16,
   "kind": "dialogue",
   "jp": "龍馬ぁぁぁぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1669"
  },
  {
   "id": "m_007003:0x1beb0",
   "off": 114352,
   "max": 28,
   "kind": "dialogue",
   "jp": "そんな……これ\\nまずいよ",
   "en": "",
   "op": "0x62",
   "msg": "0x166a"
  },
  {
   "id": "m_007003:0x1c520",
   "off": 116000,
   "max": 16,
   "kind": "dialogue",
   "jp": "考えるのは後だ",
   "en": "",
   "op": "0x62",
   "msg": "0x166b"
  },
  {
   "id": "m_007003:0x1c540",
   "off": 116032,
   "max": 28,
   "kind": "dialogue",
   "jp": "いったん\\nここを離れるぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x166c"
  },
  {
   "id": "m_007003:0x1cee4",
   "off": 118500,
   "max": 24,
   "kind": "dialogue",
   "jp": "で　でも龍馬くんが！",
   "en": "",
   "op": "0x62",
   "msg": "0x166d"
  },
  {
   "id": "m_007003:0x1d6e8",
   "off": 120552,
   "max": 68,
   "kind": "dialogue",
   "jp": "引き際を見誤るな\\nここで俺達まで捕まったら\\n誰が坂本を助けるんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x166e"
  },
  {
   "id": "m_007003:0x1dba8",
   "off": 121768,
   "max": 48,
   "kind": "dialogue",
   "jp": "土方さんの言うとおりだよ\\nここは退いた方がいい",
   "en": "",
   "op": "0x62",
   "msg": "0x166f"
  },
  {
   "id": "m_007003:0x1e360",
   "off": 123744,
   "max": 24,
   "kind": "dialogue",
   "jp": "くっ……\\nわかりました",
   "en": "",
   "op": "0x62",
   "msg": "0x1670"
  },
  {
   "id": "m_007003:0x1ea1c",
   "off": 125468,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍馬……\\n必ず助けてやるからな！",
   "en": "",
   "op": "0x62",
   "msg": "0x1671"
  },
  {
   "id": "m_007003:0x1f138",
   "off": 127288,
   "max": 28,
   "kind": "dialogue",
   "jp": "行くぞ！\\n俺が道を開く！",
   "en": "",
   "op": "0x62",
   "msg": "0x1672"
  },
  {
   "id": "m_007003:0x1f604",
   "off": 128516,
   "max": 104,
   "kind": "dialogue",
   "jp": "松陰を取り戻したものの\\n龍馬を捕らえられた四人は\\n助ける決意を胸に秘めながら\\n会場を離れるのだった――",
   "en": "",
   "op": "0x62",
   "msg": "0x1673"
  }
 ]
}
