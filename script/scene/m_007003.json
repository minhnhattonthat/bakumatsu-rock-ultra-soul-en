   "msg": "0x1666"
  },
  {
   "id": "m_007003:0x1af2c",
   "off": 110380,
   "max": 36,
   "kind": "dialogue",
   "jp": "彼らの道をふさぐように\\n取り囲む",
   "en": "...and surrounded\\nthem, as if to\\nblock their path.",
   "op": "0x62",
   "msg": "0x1667"
  },
  {
   "id": "m_007003:0x1af60",
   "off": 110432,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍馬の姿はすでに\\nどこにも見えない",
   "en": "Ryoma was\\nalready nowhere\\nto be seen.",
   "op": "0x62",
   "msg": "0x1668"
  },
  {
   "id": "m_007003:0x1b5f8",
   "off": 112120,
   "max": 16,
   "kind": "dialogue",
   "jp": "龍馬ぁぁぁぁ",
