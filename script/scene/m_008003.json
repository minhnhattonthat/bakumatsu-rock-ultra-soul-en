{
 "source": "m_008003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_008003:0x13ac",
   "off": 5036,
   "max": 28,
   "kind": "dialogue",
   "jp": "ああ……！\\n今のは……！",
   "en": "",
   "op": "0x62",
   "msg": "0x18b0"
  },
  {
   "id": "m_008003:0x1864",
   "off": 6244,
   "max": 80,
   "kind": "dialogue",
   "jp": "復活した龍馬による\\n即興雷舞は　天歌に\\n操られかけていた民達を\\n一度で魅了した",
   "en": "",
   "op": "0x62",
   "msg": "0x18b1"
  },
  {
   "id": "m_008003:0x1e34",
   "off": 7732,
   "max": 24,
   "kind": "dialogue",
   "jp": "今のは\\nなんだ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x18b2"
  },
  {
   "id": "m_008003:0x22c8",
   "off": 8904,
   "max": 40,
   "kind": "dialogue",
   "jp": "天歌なんかよりも\\n心が沸き立つようだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18b3"
  },
  {
   "id": "m_008003:0x276c",
   "off": 10092,
   "max": 24,
   "kind": "dialogue",
   "jp": "ロックとか\\n言ってたぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x18b4"
  },
  {
   "id": "m_008003:0x3184",
   "off": 12676,
   "max": 24,
   "kind": "dialogue",
   "jp": "ロック最高ーーーっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18b5"
  },
  {
   "id": "m_008003:0x3834",
   "off": 14388,
   "max": 24,
   "kind": "dialogue",
   "jp": "ロック最高ーーーっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18b6"
  },
  {
   "id": "m_008003:0x4254",
   "off": 16980,
   "max": 32,
   "kind": "dialogue",
   "jp": "おおっ！\\nありがとうぜよーー！",
   "en": "",
   "op": "0x62",
   "msg": "0x18b7"
  },
  {
   "id": "m_008003:0x4284",
   "off": 17028,
   "max": 28,
   "kind": "dialogue",
   "jp": "ロックは最高ぜよーーー！",
   "en": "",
   "op": "0x62",
   "msg": "0x18b8"
  },
  {
   "id": "m_008003:0x4a3c",
   "off": 19004,
   "max": 32,
   "kind": "dialogue",
   "jp": "天歌の支配が\\n解けてる……！",
   "en": "",
   "op": "0x62",
   "msg": "0x18b9"
  },
  {
   "id": "m_008003:0x50a8",
   "off": 20648,
   "max": 60,
   "kind": "dialogue",
   "jp": "ああ　天歌みたいな\\n作りもんと　わしの\\nロックは違うぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18ba"
  },
  {
   "id": "m_008003:0x50f4",
   "off": 20724,
   "max": 60,
   "kind": "dialogue",
   "jp": "お前達も　わしの\\nロックで熱くなって\\n心が震えたじゃろ？",
   "en": "",
   "op": "0x62",
   "msg": "0x18bb"
  },
  {
   "id": "m_008003:0x55ac",
   "off": 21932,
   "max": 12,
   "kind": "dialogue",
   "jp": "……くっ",
   "en": "",
   "op": "0x62",
   "msg": "0x18bc"
  },
  {
   "id": "m_008003:0x5d40",
   "off": 23872,
   "max": 44,
   "kind": "dialogue",
   "jp": "悔しいけれど……\\nこの男の言うとおり……",
   "en": "",
   "op": "0x62",
   "msg": "0x18bd"
  },
  {
   "id": "m_008003:0x5d7c",
   "off": 23932,
   "max": 48,
   "kind": "dialogue",
   "jp": "私は今……\\nこの男のロックに\\n感動している……",
   "en": "",
   "op": "0x62",
   "msg": "0x18be"
  },
  {
   "id": "m_008003:0x63ec",
   "off": 25580,
   "max": 40,
   "kind": "dialogue",
   "jp": "うう……\\n幾松姐さん\\nあたしもですぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x18bf"
  },
  {
   "id": "m_008003:0x6b98",
   "off": 27544,
   "max": 20,
   "kind": "dialogue",
   "jp": "……ああ　そうさ",
   "en": "",
   "op": "0x62",
   "msg": "0x18c0"
  },
  {
   "id": "m_008003:0x6bc4",
   "off": 27588,
   "max": 32,
   "kind": "dialogue",
   "jp": "アタシも感動しち\\nまったよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18c1"
  },
  {
   "id": "m_008003:0x6bf4",
   "off": 27636,
   "max": 48,
   "kind": "dialogue",
   "jp": "あんたの想いの強さは\\nよくわかったわ\\n坂本龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x18c2"
  },
  {
   "id": "m_008003:0x72a4",
   "off": 29348,
   "max": 52,
   "kind": "dialogue",
   "jp": "だけどあんたの心と音楽は\\nなんでそんなに強いの？",
   "en": "",
   "op": "0x62",
   "msg": "0x18c3"
  },
  {
   "id": "m_008003:0x72e8",
   "off": 29416,
   "max": 48,
   "kind": "dialogue",
   "jp": "あんたはどうしてそこまで\\nロックを愛せるの？",
   "en": "",
   "op": "0x62",
   "msg": "0x18c4"
  },
  {
   "id": "m_008003:0x7a74",
   "off": 31348,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ははっ",
   "en": "",
   "op": "0x62",
   "msg": "0x18c5"
  },
  {
   "id": "m_008003:0x7a90",
   "off": 31376,
   "max": 72,
   "kind": "dialogue",
   "jp": "土佐にいた頃はなぁ　わしは\\n歌が下手だ　下手だと\\n言われ続けておった",
   "en": "",
   "op": "0x62",
   "msg": "0x18c6"
  },
  {
   "id": "m_008003:0x7ae8",
   "off": 31464,
   "max": 68,
   "kind": "dialogue",
   "jp": "だけど　姉さんと\\n弥太郎だけは　わしの歌を\\n好きだと言ってくれた",
   "en": "",
   "op": "0x62",
   "msg": "0x18c7"
  },
  {
   "id": "m_008003:0x8514",
   "off": 34068,
   "max": 36,
   "kind": "dialogue",
   "jp": "弥太郎ってのは\\nわしのダチでな……",
   "en": "",
   "op": "0x62",
   "msg": "0x18c8"
  },
  {
   "id": "m_008003:0x854c",
   "off": 34124,
   "max": 52,
   "kind": "dialogue",
   "jp": "この弥太郎　ガキの頃は\\nほとんど喋らん奴じゃった",
   "en": "",
   "op": "0x62",
   "msg": "0x18c9"
  },
  {
   "id": "m_008003:0x8dec",
   "off": 36332,
   "max": 68,
   "kind": "dialogue",
   "jp": "無視され続けたわしは\\nある日　弥太郎を想って\\n歌ってみたんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18ca"
  },
  {
   "id": "m_008003:0x8e40",
   "off": 36416,
   "max": 32,
   "kind": "dialogue",
   "jp": "一人でいたら\\nさみしくないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x18cb"
  },
  {
   "id": "m_008003:0x9374",
   "off": 37748,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしらと一緒に\\n遊ぼうぜよ\\nってな",
   "en": "",
   "op": "0x62",
   "msg": "0x18cc"
  },
  {
   "id": "m_008003:0x9744",
   "off": 38724,
   "max": 36,
   "kind": "dialogue",
   "jp": "嬉しそうな顔で\\n龍馬は思い出を語る",
   "en": "",
   "op": "0x62",
   "msg": "0x18cd"
  },
  {
   "id": "m_008003:0x9a70",
   "off": 39536,
   "max": 44,
   "kind": "dialogue",
   "jp": "遊び仲間には　へたくそな\\n歌だと笑われた",
   "en": "",
   "op": "0x62",
   "msg": "0x18ce"
  },
  {
   "id": "m_008003:0x9aac",
   "off": 39596,
   "max": 32,
   "kind": "dialogue",
   "jp": "そして　弥太郎も\\n笑ったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x18cf"
  },
  {
   "id": "m_008003:0x9adc",
   "off": 39644,
   "max": 68,
   "kind": "dialogue",
   "jp": "へたくそな歌だけど\\nあんなに一生懸命に\\n歌うから無視できなんだと",
   "en": "",
   "op": "0x62",
   "msg": "0x18d0"
  },
  {
   "id": "m_008003:0xa1a8",
   "off": 41384,
   "max": 68,
   "kind": "dialogue",
   "jp": "歌は……　音楽はなぁ\\n人の心を揺さぶるもんじゃと\\nわしは思うぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x18d1"
  },
  {
   "id": "m_008003:0xa1fc",
   "off": 41468,
   "max": 40,
   "kind": "dialogue",
   "jp": "たくさんの音楽が\\nこの世にはあるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x18d2"
  },
  {
   "id": "m_008003:0xa234",
   "off": 41524,
   "max": 68,
   "kind": "dialogue",
   "jp": "お上が認めたものだけが\\n音楽だなんて　そんな\\nバカな話があるもんか",
   "en": "",
   "op": "0x62",
   "msg": "0x18d3"
  },
  {
   "id": "m_008003:0xa8a4",
   "off": 43172,
   "max": 48,
   "kind": "dialogue",
   "jp": "音楽は　人の自由な心が\\n生み出す熱い魂ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18d4"
  },
  {
   "id": "m_008003:0xa8e4",
   "off": 43236,
   "max": 48,
   "kind": "dialogue",
   "jp": "わしは　胸の中の熱情を\\n抑えきれないんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18d5"
  },
  {
   "id": "m_008003:0xb0a8",
   "off": 45224,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああ……\\nあんたの言う通りだわ\\n坂本龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x18d6"
  },
  {
   "id": "m_008003:0xb0e4",
   "off": 45284,
   "max": 20,
   "kind": "dialogue",
   "jp": "アタシ達の負けね",
   "en": "",
   "op": "0x62",
   "msg": "0x18d7"
  },
  {
   "id": "m_008003:0xb73c",
   "off": 46908,
   "max": 16,
   "kind": "dialogue",
   "jp": "姐さん……！",
   "en": "",
   "op": "0x62",
   "msg": "0x18d8"
  },
  {
   "id": "m_008003:0xbbc8",
   "off": 48072,
   "max": 28,
   "kind": "dialogue",
   "jp": "だってそうでしょう\\n幾松",
   "en": "",
   "op": "0x62",
   "msg": "0x18d9"
  },
  {
   "id": "m_008003:0xbbf4",
   "off": 48116,
   "max": 48,
   "kind": "dialogue",
   "jp": "アタシたちも\\nただ　歌いたかったんじゃ\\nないか",
   "en": "",
   "op": "0x62",
   "msg": "0x18da"
  },
  {
   "id": "m_008003:0xc2bc",
   "off": 49852,
   "max": 24,
   "kind": "dialogue",
   "jp": "……ぅん\\nそぉだよね☆",
   "en": "",
   "op": "0x62",
   "msg": "0x18db"
  },
  {
   "id": "m_008003:0xc2e4",
   "off": 49892,
   "max": 44,
   "kind": "dialogue",
   "jp": "でもぉ\\n勝手に歌えば\\n罰せられるしぃ……",
   "en": "",
   "op": "0x62",
   "msg": "0x18dc"
  },
  {
   "id": "m_008003:0xca94",
   "off": 51860,
   "max": 36,
   "kind": "dialogue",
   "jp": "だから\\n徳川幕府の手先に\\nなった",
   "en": "",
   "op": "0x62",
   "msg": "0x18dd"
  },
  {
   "id": "m_008003:0xd0fc",
   "off": 53500,
   "max": 24,
   "kind": "dialogue",
   "jp": "歌いたかったから……",
   "en": "",
   "op": "0x62",
   "msg": "0x18de"
  },
  {
   "id": "m_008003:0xd898",
   "off": 55448,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前達も\\n音楽を愛する\\nロックな男……",
   "en": "",
   "op": "0x62",
   "msg": "0x18df"
  },
  {
   "id": "m_008003:0xdd44",
   "off": 56644,
   "max": 32,
   "kind": "dialogue",
   "jp": "いや　ロックな\\nおなごぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18e0"
  },
  {
   "id": "m_008003:0xe3fc",
   "off": 58364,
   "max": 32,
   "kind": "dialogue",
   "jp": "……すまなかったね\\n坂本龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x18e1"
  },
  {
   "id": "m_008003:0xe42c",
   "off": 58412,
   "max": 20,
   "kind": "dialogue",
   "jp": "ねぇ\\n幾松　おうの",
   "en": "",
   "op": "0x62",
   "msg": "0x18e2"
  },
  {
   "id": "m_008003:0xec1c",
   "off": 60444,
   "max": 20,
   "kind": "dialogue",
   "jp": "はい！\\nはぁい！",
   "en": "",
   "op": "0x62",
   "msg": "0x18e3"
  },
  {
   "id": "m_008003:0xf52c",
   "off": 62764,
   "max": 56,
   "kind": "dialogue",
   "jp": "アタシたち　他の方法で\\n愛獲になってやろうじゃ\\nないか",
   "en": "",
   "op": "0x62",
   "msg": "0x18e4"
  },
  {
   "id": "m_008003:0xf574",
   "off": 62836,
   "max": 44,
   "kind": "dialogue",
   "jp": "幕府に押しつけられた\\n天歌なんかじゃなく",
   "en": "",
   "op": "0x62",
   "msg": "0x18e5"
  },
  {
   "id": "m_008003:0xfe00",
   "off": 65024,
   "max": 8,
   "kind": "dialogue",
   "jp": "はい！",
   "en": "",
   "op": "0x62",
   "msg": "0x18e6"
  },
  {
   "id": "m_008003:0x10590",
   "off": 66960,
   "max": 48,
   "kind": "dialogue",
   "jp": "アタシもアンタ達となら\\nやりとげてみせるよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18e7"
  },
  {
   "id": "m_008003:0x1105c",
   "off": 69724,
   "max": 48,
   "kind": "dialogue",
   "jp": "三人は手を握り合い\\nそして　そっと\\n抱き合った",
   "en": "",
   "op": "0x62",
   "msg": "0x18e8"
  },
  {
   "id": "m_008003:0x114d4",
   "off": 70868,
   "max": 44,
   "kind": "dialogue",
   "jp": "うう……っ！\\nいい光景じゃ！\\n……ずずっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18e9"
  },
  {
   "id": "m_008003:0x11b44",
   "off": 72516,
   "max": 8,
   "kind": "dialogue",
   "jp": "おい！",
   "en": "",
   "op": "0x62",
   "msg": "0x18ea"
  },
  {
   "id": "m_008003:0x11fd0",
   "off": 73680,
   "max": 56,
   "kind": "dialogue",
   "jp": "感動してるところに\\n水を差すようだが\\nそろそろやばいぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x18eb"
  },
  {
   "id": "m_008003:0x1251c",
   "off": 75036,
   "max": 8,
   "kind": "dialogue",
   "jp": "ほえ？",
   "en": "",
   "op": "0x62",
   "msg": "0x18ec"
  },
  {
   "id": "m_008003:0x12ab4",
   "off": 76468,
   "max": 76,
   "kind": "dialogue",
   "jp": "龍馬の即興雷舞の音を\\n聞きつけた幕府側の\\n武士達が押し寄せよう\\nとしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x18ed"
  },
  {
   "id": "m_008003:0x12f4c",
   "off": 77644,
   "max": 44,
   "kind": "dialogue",
   "jp": "手持ちの痺れ玉も\\n使い切ってしまいましたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x18ee"
  },
  {
   "id": "m_008003:0x135b8",
   "off": 79288,
   "max": 40,
   "kind": "dialogue",
   "jp": "そんなもの\\n使わなくても\\n大丈夫でしょ",
   "en": "",
   "op": "0x62",
   "msg": "0x18ef"
  },
  {
   "id": "m_008003:0x13c7c",
   "off": 81020,
   "max": 60,
   "kind": "dialogue",
   "jp": "ああ　ここにいる見物人は\\nお前のロックに\\n魅せられている",
   "en": "",
   "op": "0x62",
   "msg": "0x18f0"
  },
  {
   "id": "m_008003:0x1448c",
   "off": 83084,
   "max": 56,
   "kind": "dialogue",
   "jp": "沖田と土方の言葉に\\n高杉がはっとして\\n辺りに目をやる",
   "en": "",
   "op": "0x62",
   "msg": "0x18f1"
  },
  {
   "id": "m_008003:0x14574",
   "off": 83316,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬の処刑を見に来て\\nいたはずの民達が――",
   "en": "",
   "op": "0x62",
   "msg": "0x18f2"
  },
  {
   "id": "m_008003:0x145b0",
   "off": 83376,
   "max": 28,
   "kind": "dialogue",
   "jp": "人の波が割れ\\n道が開いた",
   "en": "",
   "op": "0x62",
   "msg": "0x18f3"
  },
  {
   "id": "m_008003:0x148d4",
   "off": 84180,
   "max": 20,
   "kind": "dialogue",
   "jp": "今だ！\\n逃げるぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x18f4"
  },
  {
   "id": "m_008003:0x14f80",
   "off": 85888,
   "max": 8,
   "kind": "dialogue",
   "jp": "おう！",
   "en": "",
   "op": "0x62",
   "msg": "0x18f5"
  },
  {
   "id": "m_008003:0x14f98",
   "off": 85912,
   "max": 24,
   "kind": "dialogue",
   "jp": "みんな\\n行くぜよっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18f6"
  },
  {
   "id": "m_008003:0x1578c",
   "off": 87948,
   "max": 20,
   "kind": "dialogue",
   "jp": "しんがりは任せろ",
   "en": "",
   "op": "0x62",
   "msg": "0x18f7"
  },
  {
   "id": "m_008003:0x15c1c",
   "off": 89116,
   "max": 40,
   "kind": "dialogue",
   "jp": "トサカくん達には\\n指一本触れさせない",
   "en": "",
   "op": "0x62",
   "msg": "0x18f8"
  },
  {
   "id": "m_008003:0x1650c",
   "off": 91404,
   "max": 44,
   "kind": "dialogue",
   "jp": "お前らを置いていくような\\nこと出来るか！",
   "en": "",
   "op": "0x62",
   "msg": "0x18f9"
  },
  {
   "id": "m_008003:0x169b4",
   "off": 92596,
   "max": 36,
   "kind": "dialogue",
   "jp": "そうじゃ！\\nお前達も危ないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x18fa"
  },
  {
   "id": "m_008003:0x17160",
   "off": 94560,
   "max": 16,
   "kind": "dialogue",
   "jp": "落ち着け\\n坂本",
   "en": "",
   "op": "0x62",
   "msg": "0x18fb"
  },
  {
   "id": "m_008003:0x17180",
   "off": 94592,
   "max": 36,
   "kind": "dialogue",
   "jp": "捕らえられた上に\\nあの雷舞の後だ",
   "en": "",
   "op": "0x62",
   "msg": "0x18fc"
  },
  {
   "id": "m_008003:0x171b4",
   "off": 94644,
   "max": 32,
   "kind": "dialogue",
   "jp": "お前の体力は\\nもう限界だろう",
   "en": "",
   "op": "0x62",
   "msg": "0x18fd"
  },
  {
   "id": "m_008003:0x17664",
   "off": 95844,
   "max": 40,
   "kind": "dialogue",
   "jp": "そう言って土方は\\n龍馬の背中を叩いた",
   "en": "",
   "op": "0x62",
   "msg": "0x18fe"
  },
  {
   "id": "m_008003:0x17c44",
   "off": 97348,
   "max": 12,
   "kind": "dialogue",
   "jp": "う……っ",
   "en": "",
   "op": "0x62",
   "msg": "0x18ff"
  },
  {
   "id": "m_008003:0x18334",
   "off": 99124,
   "max": 48,
   "kind": "dialogue",
   "jp": "このくらいで\\nよろける奴が\\n四の五の抜かすな",
   "en": "",
   "op": "0x62",
   "msg": "0x1900"
  },
  {
   "id": "m_008003:0x187e0",
   "off": 100320,
   "max": 52,
   "kind": "dialogue",
   "jp": "……うう\\nすまんぜよ\\nヒジゾーさんの言う通りじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1901"
  },
  {
   "id": "m_008003:0x18c90",
   "off": 101520,
   "max": 44,
   "kind": "dialogue",
   "jp": "しんがりを任せられるは\\n武士の誉れ　行け！",
   "en": "",
   "op": "0x62",
   "msg": "0x1902"
  },
  {
   "id": "m_008003:0x19138",
   "off": 102712,
   "max": 20,
   "kind": "dialogue",
   "jp": "……わかったぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1903"
  },
  {
   "id": "m_008003:0x196c8",
   "off": 104136,
   "max": 44,
   "kind": "dialogue",
   "jp": "そして龍馬は\\n暗黒桜桃隊達を\\n振り返った",
   "en": "",
   "op": "0x62",
   "msg": "0x1904"
  },
  {
   "id": "m_008003:0x19ca8",
   "off": 105640,
   "max": 40,
   "kind": "dialogue",
   "jp": "おい　何をしてる！\\n一緒に逃げるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1905"
  },
  {
   "id": "m_008003:0x1a560",
   "off": 107872,
   "max": 12,
   "kind": "dialogue",
   "jp": "……えっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1906"
  },
  {
   "id": "m_008003:0x1ac28",
   "off": 109608,
   "max": 68,
   "kind": "dialogue",
   "jp": "幕府の歌う天歌を捨てて\\n己の音楽を突き進むなら\\nわしらの仲間じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1907"
  },
  {
   "id": "m_008003:0x1b018",
   "off": 110616,
   "max": 28,
   "kind": "dialogue",
   "jp": "龍馬は大きく\\n手を広げた",
   "en": "",
   "op": "0x62",
   "msg": "0x1908"
  },
  {
   "id": "m_008003:0x1b3d4",
   "off": 111572,
   "max": 12,
   "kind": "dialogue",
   "jp": "……坂本",
   "en": "",
   "op": "0x62",
   "msg": "0x1909"
  },
  {
   "id": "m_008003:0x1b8fc",
   "off": 112892,
   "max": 60,
   "kind": "dialogue",
   "jp": "一瞬の逡巡の後\\nお龍は\\n手を繋いだ妹分達と\\n立ち上がった",
   "en": "",
   "op": "0x62",
   "msg": "0x190a"
  },
  {
   "id": "m_008003:0x1be4c",
   "off": 114252,
   "max": 28,
   "kind": "dialogue",
   "jp": "行くよ！\\n幾松！\\nおうの！",
   "en": "",
   "op": "0x62",
   "msg": "0x190b"
  },
  {
   "id": "m_008003:0x1c6c8",
   "off": 116424,
   "max": 20,
   "kind": "dialogue",
   "jp": "はいっ\\n姐さん！",
   "en": "",
   "op": "0x62",
   "msg": "0x190c"
  },
  {
   "id": "m_008003:0x1cc64",
   "off": 117860,
   "max": 60,
   "kind": "dialogue",
   "jp": "三人娘たちも龍馬達の\\n背を追って　お白州から\\n飛び出した",
   "en": "",
   "op": "0x62",
   "msg": "0x190d"
  },
  {
   "id": "m_008003:0x1d0e0",
   "off": 119008,
   "max": 56,
   "kind": "dialogue",
   "jp": "あの三人も\\n連れてっちゃったよ\\n相変わらずお人好しだね",
   "en": "",
   "op": "0x62",
   "msg": "0x190e"
  },
  {
   "id": "m_008003:0x1d75c",
   "off": 120668,
   "max": 32,
   "kind": "dialogue",
   "jp": "それが\\n坂本龍馬という\\n男だ",
   "en": "",
   "op": "0x62",
   "msg": "0x190f"
  },
  {
   "id": "m_008003:0x1dbf8",
   "off": 121848,
   "max": 12,
   "kind": "dialogue",
   "jp": "そうですね",
   "en": "",
   "op": "0x62",
   "msg": "0x1910"
  },
  {
   "id": "m_008003:0x1dc14",
   "off": 121876,
   "max": 28,
   "kind": "dialogue",
   "jp": "だから僕達も\\n仲間になれた",
   "en": "",
   "op": "0x62",
   "msg": "0x1911"
  },
  {
   "id": "m_008003:0x1e540",
   "off": 124224,
   "max": 20,
   "kind": "dialogue",
   "jp": "……総司\\n来るぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1912"
  },
  {
   "id": "m_008003:0x1ec8c",
   "off": 126092,
   "max": 48,
   "kind": "dialogue",
   "jp": "さて　僕たちも\\n少しはいいところを\\n見せないと",
   "en": "",
   "op": "0x62",
   "msg": "0x1913"
  },
  {
   "id": "m_008003:0x1f2e8",
   "off": 127720,
   "max": 68,
   "kind": "dialogue",
   "jp": "派手に行くよ\\n巻き込まれたくなければ\\nみんな　さっさと逃げろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1914"
  },
  {
   "id": "m_008003:0x1f8b8",
   "off": 129208,
   "max": 40,
   "kind": "dialogue",
   "jp": "沖田と土方は\\n残っている民達を追い払う",
   "en": "",
   "op": "0x62",
   "msg": "0x1915"
  },
  {
   "id": "m_008003:0x1f8f0",
   "off": 129264,
   "max": 72,
   "kind": "dialogue",
   "jp": "そして　追手の来る方へ\\n視線を向けると　勢いよく\\n駆け出したのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x1916"
  },
  {
   "id": "m_008003:0x1fe8c",
   "off": 130700,
   "max": 32,
   "kind": "dialogue",
   "jp": "アルベルゴ\\nディテラーダ",
   "en": "",
   "op": "0x62",
   "msg": "0x1917"
  },
  {
   "id": "m_008003:0x1febc",
   "off": 130748,
   "max": 24,
   "kind": "dialogue",
   "jp": "あれから\\n数日後――",
   "en": "",
   "op": "0x62",
   "msg": "0x1918"
  },
  {
   "id": "m_008003:0x20324",
   "off": 131876,
   "max": 60,
   "kind": "dialogue",
   "jp": "ふぅ……\\nテラーダも無事に営業再開\\nになったし一安心だな",
   "en": "",
   "op": "0x62",
   "msg": "0x1919"
  },
  {
   "id": "m_008003:0x209a4",
   "off": 133540,
   "max": 68,
   "kind": "dialogue",
   "jp": "まだ幕府の目はあるから\\n私達は　潜んでいないと\\nいけませんけどね",
   "en": "",
   "op": "0x62",
   "msg": "0x191a"
  },
  {
   "id": "m_008003:0x21320",
   "off": 135968,
   "max": 24,
   "kind": "dialogue",
   "jp": "お！\\n二人ともきたか！",
   "en": "",
   "op": "0x62",
   "msg": "0x191b"
  },
  {
   "id": "m_008003:0x219dc",
   "off": 137692,
   "max": 40,
   "kind": "dialogue",
   "jp": "やあ　相変わらず\\n呑気な顔してるねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x191c"
  },
  {
   "id": "m_008003:0x220a4",
   "off": 139428,
   "max": 12,
   "kind": "dialogue",
   "jp": "なんだと！",
   "en": "",
   "op": "0x62",
   "msg": "0x191d"
  },
  {
   "id": "m_008003:0x22840",
   "off": 141376,
   "max": 16,
   "kind": "dialogue",
   "jp": "総司\\n自重しろ",
   "en": "",
   "op": "0x62",
   "msg": "0x191e"
  },
  {
   "id": "m_008003:0x22e90",
   "off": 142992,
   "max": 8,
   "kind": "dialogue",
   "jp": "はぁい",
   "en": "",
   "op": "0x62",
   "msg": "0x191f"
  },
  {
   "id": "m_008003:0x23760",
   "off": 145248,
   "max": 16,
   "kind": "dialogue",
   "jp": "むかつく……！",
   "en": "",
   "op": "0x62",
   "msg": "0x1920"
  },
  {
   "id": "m_008003:0x23e84",
   "off": 147076,
   "max": 52,
   "kind": "dialogue",
   "jp": "かっかっか！\\nみんな　すっかり仲良う\\nなったなぁ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1921"
  },
  {
   "id": "m_008003:0x247fc",
   "off": 149500,
   "max": 12,
   "kind": "dialogue",
   "jp": "どこがだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1922"
  },
  {
   "id": "m_008003:0x24ef4",
   "off": 151284,
   "max": 56,
   "kind": "dialogue",
   "jp": "あ　仲間と言えば\\nテラーダに新しい従業員が\\n入ったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1923"
  },
  {
   "id": "m_008003:0x255c8",
   "off": 153032,
   "max": 52,
   "kind": "dialogue",
   "jp": "ああ\\nお尋ね者の龍馬くんが\\n働くのは難しいですしね",
   "en": "",
   "op": "0x62",
   "msg": "0x1924"
  },
  {
   "id": "m_008003:0x25c94",
   "off": 154772,
   "max": 48,
   "kind": "dialogue",
   "jp": "へえー　どんなの？\\n女将さんみたいな人外系？",
   "en": "",
   "op": "0x62",
   "msg": "0x1925"
  },
  {
   "id": "m_008003:0x265b0",
   "off": 157104,
   "max": 44,
   "kind": "dialogue",
   "jp": "ちょっと！　総ちゃん！\\n何か言ったかしら",
   "en": "",
   "op": "0x62",
   "msg": "0x1926"
  },
  {
   "id": "m_008003:0x26af8",
   "off": 158456,
   "max": 8,
   "kind": "dialogue",
   "jp": "何も～",
   "en": "",
   "op": "0x62",
   "msg": "0x1927"
  },
  {
   "id": "m_008003:0x27374",
   "off": 160628,
   "max": 24,
   "kind": "dialogue",
   "jp": "とにかく紹介するぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1928"
  },
  {
   "id": "m_008003:0x27808",
   "off": 161800,
   "max": 24,
   "kind": "dialogue",
   "jp": "おーい！\\nお前達ー！",
   "en": "",
   "op": "0x62",
   "msg": "0x1929"
  },
  {
   "id": "m_008003:0x2814c",
   "off": 164172,
   "max": 16,
   "kind": "dialogue",
   "jp": "いらっしゃい！",
   "en": "",
   "op": "0x62",
   "msg": "0x192a"
  },
  {
   "id": "m_008003:0x28174",
   "off": 164212,
   "max": 44,
   "kind": "dialogue",
   "jp": "アタシ達が\\nテラーダの\\n新しい看板娘よ！",
   "en": "",
   "op": "0x62",
   "msg": "0x192b"
  },
  {
   "id": "m_008003:0x28dac",
   "off": 167340,
   "max": 16,
   "kind": "dialogue",
   "jp": "暗黒桜桃隊",
   "en": "",
   "op": "0x62",
   "msg": "0x192c"
  },
  {
   "id": "m_008003:0x2983c",
   "off": 170044,
   "max": 72,
   "kind": "dialogue",
   "jp": "ぁのねぇ　おうのたち\\n地下愛獲っていうのを\\n頑張ることにしたんですぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x192d"
  },
  {
   "id": "m_008003:0x29d14",
   "off": 171284,
   "max": 80,
   "kind": "dialogue",
   "jp": "お盆を持って現れたのは\\nあの逃走劇の後\\nいずこかに姿を消していた\\n三人娘だった",
   "en": "",
   "op": "0x62",
   "msg": "0x192e"
  },
  {
   "id": "m_008003:0x2a1a4",
   "off": 172452,
   "max": 48,
   "kind": "dialogue",
   "jp": "お登勢やんに引き合わせ\\nたら　気が合ってなあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x192f"
  },
  {
   "id": "m_008003:0x2a820",
   "off": 174112,
   "max": 16,
   "kind": "dialogue",
   "jp": "お　お前なぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1930"
  },
  {
   "id": "m_008003:0x2ad00",
   "off": 175360,
   "max": 64,
   "kind": "dialogue",
   "jp": "自分を殺そうとしていた\\n連中に　仕事の世話をして\\nやったのか",
   "en": "",
   "op": "0x62",
   "msg": "0x1931"
  },
  {
   "id": "m_008003:0x2b264",
   "off": 176740,
   "max": 12,
   "kind": "dialogue",
   "jp": "そうぜよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1932"
  },
  {
   "id": "m_008003:0x2b90c",
   "off": 178444,
   "max": 28,
   "kind": "dialogue",
   "jp": "それが龍馬くんですよ\\n晋作",
   "en": "",
   "op": "0x62",
   "msg": "0x1933"
  },
  {
   "id": "m_008003:0x2bdac",
   "off": 179628,
   "max": 48,
   "kind": "dialogue",
   "jp": "ああ！　ああ！\\nそうだよな！\\nこのバカ野郎が",
   "en": "",
   "op": "0x62",
   "msg": "0x1934"
  },
  {
   "id": "m_008003:0x2c560",
   "off": 181600,
   "max": 40,
   "kind": "dialogue",
   "jp": "問題ないぜよ！\\nわしらは仲間だからな！",
   "en": "",
   "op": "0x62",
   "msg": "0x1935"
  },
  {
   "id": "m_008003:0x2ca18",
   "off": 182808,
   "max": 48,
   "kind": "dialogue",
   "jp": "いつもの龍馬節に\\nみなが苦笑いを\\n禁じ得ない",
   "en": "",
   "op": "0x62",
   "msg": "0x1936"
  },
  {
   "id": "m_008003:0x2ca58",
   "off": 182872,
   "max": 28,
   "kind": "dialogue",
   "jp": "そんな中\\nお龍が口を挟む",
   "en": "",
   "op": "0x62",
   "msg": "0x1937"
  },
  {
   "id": "m_008003:0x2d134",
   "off": 184628,
   "max": 56,
   "kind": "dialogue",
   "jp": "ちょっと待った\\n勝手に仲間にして\\nもらっちゃ困るわね",
   "en": "",
   "op": "0x62",
   "msg": "0x1938"
  },
  {
   "id": "m_008003:0x2d970",
   "off": 186736,
   "max": 8,
   "kind": "dialogue",
   "jp": "ほえ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1939"
  },
  {
   "id": "m_008003:0x2ddf4",
   "off": 187892,
   "max": 52,
   "kind": "dialogue",
   "jp": "アタシたちは　美少女\\n愛獲なのよ？\\nそう簡単に……",
   "en": "",
   "op": "0x62",
   "msg": "0x193a"
  },
  {
   "id": "m_008003:0x2de40",
   "off": 187968,
   "max": 24,
   "kind": "dialogue",
   "jp": "ううん\\nちょっと待った",
   "en": "",
   "op": "0x62",
   "msg": "0x193b"
  },
  {
   "id": "m_008003:0x2e29c",
   "off": 189084,
   "max": 44,
   "kind": "dialogue",
   "jp": "お龍は五人の\\n男達の顔を\\nじっと見つめる",
   "en": "",
   "op": "0x62",
   "msg": "0x193c"
  },
  {
   "id": "m_008003:0x2e668",
   "off": 190056,
   "max": 68,
   "kind": "dialogue",
   "jp": "そうだね　条件次第では\\nアタシたちの仲間に\\nしてやってもいいかも",
   "en": "",
   "op": "0x62",
   "msg": "0x193d"
  },
  {
   "id": "m_008003:0x2ebc8",
   "off": 191432,
   "max": 12,
   "kind": "dialogue",
   "jp": "本当か！",
   "en": "",
   "op": "0x62",
   "msg": "0x193e"
  },
  {
   "id": "m_008003:0x2f2cc",
   "off": 193228,
   "max": 28,
   "kind": "dialogue",
   "jp": "メガネ君と\\n沖田さんならね",
   "en": "",
   "op": "0x62",
   "msg": "0x193f"
  },
  {
   "id": "m_008003:0x2fbd0",
   "off": 195536,
   "max": 20,
   "kind": "dialogue",
   "jp": "\\fnt1はい\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x1940"
  },
  {
   "id": "m_008003:0x306fc",
   "off": 198396,
   "max": 28,
   "kind": "dialogue",
   "jp": "兄さん達\\n女装してみない？",
   "en": "",
   "op": "0x62",
   "msg": "0x1941"
  },
  {
   "id": "m_008003:0x310ec",
   "off": 200940,
   "max": 24,
   "kind": "dialogue",
   "jp": "\\fnt1はいぃぃ\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x1942"
  },
  {
   "id": "m_008003:0x319d4",
   "off": 203220,
   "max": 32,
   "kind": "dialogue",
   "jp": "な　なんでこの二人\\nだけ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1943"
  },
  {
   "id": "m_008003:0x32110",
   "off": 205072,
   "max": 32,
   "kind": "dialogue",
   "jp": "そんなの\\n当たり前じゃないか",
   "en": "",
   "op": "0x62",
   "msg": "0x1944"
  },
  {
   "id": "m_008003:0x32140",
   "off": 205120,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍さんやボウヤ\\nそれに土方さんは",
   "en": "",
   "op": "0x62",
   "msg": "0x1945"
  },
  {
   "id": "m_008003:0x3220c",
   "off": 205324,
   "max": 36,
   "kind": "dialogue",
   "jp": "女装しても\\nちょっと……\\nねえ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1946"
  },
  {
   "id": "m_008003:0x32874",
   "off": 206964,
   "max": 36,
   "kind": "dialogue",
   "jp": "おい\\n前から気になって\\nたんだが",
   "en": "",
   "op": "0x62",
   "msg": "0x1947"
  },
  {
   "id": "m_008003:0x328b0",
   "off": 207024,
   "max": 60,
   "kind": "dialogue",
   "jp": "まさかボウヤって\\n言うのはオレ様の\\nことじゃないだろうな？",
   "en": "",
   "op": "0x62",
   "msg": "0x1948"
  },
  {
   "id": "m_008003:0x32e08",
   "off": 208392,
   "max": 24,
   "kind": "dialogue",
   "jp": "あら\\nボウヤはボウヤよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1949"
  },
  {
   "id": "m_008003:0x32ec8",
   "off": 208584,
   "max": 48,
   "kind": "dialogue",
   "jp": "女装が似合わないって\\n言われて　気に障った？",
   "en": "",
   "op": "0x62",
   "msg": "0x194a"
  },
  {
   "id": "m_008003:0x3346c",
   "off": 210028,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレ様が腹を立ててるのは\\nそこじゃないっっ",
   "en": "",
   "op": "0x62",
   "msg": "0x194b"
  },
  {
   "id": "m_008003:0x33920",
   "off": 211232,
   "max": 40,
   "kind": "dialogue",
   "jp": "なにせアタシたちは\\n美少女の愛獲だもの",
   "en": "",
   "op": "0x62",
   "msg": "0x194c"
  },
  {
   "id": "m_008003:0x33efc",
   "off": 212732,
   "max": 56,
   "kind": "dialogue",
   "jp": "楽しげに語る\\nお龍の背後から\\nそっと近づく\\n影があった",
   "en": "",
   "op": "0x62",
   "msg": "0x194d"
  },
  {
   "id": "m_008003:0x343d4",
   "off": 213972,
   "max": 12,
   "kind": "dialogue",
   "jp": "……姐さん",
   "en": "",
   "op": "0x62",
   "msg": "0x194e"
  },
  {
   "id": "m_008003:0x349dc",
   "off": 215516,
   "max": 20,
   "kind": "dialogue",
   "jp": "わっ\\nびっくりした",
   "en": "",
   "op": "0x62",
   "msg": "0x194f"
  },
  {
   "id": "m_008003:0x34a00",
   "off": 215552,
   "max": 56,
   "kind": "dialogue",
   "jp": "幾松　気配を消して\\n背後に立つのは\\nやめなさいってば！",
   "en": "",
   "op": "0x62",
   "msg": "0x1950"
  },
  {
   "id": "m_008003:0x34ff0",
   "off": 217072,
   "max": 36,
   "kind": "dialogue",
   "jp": "ご　ごめんなさい\\nつい　クセで……",
   "en": "",
   "op": "0x62",
   "msg": "0x1951"
  },
  {
   "id": "m_008003:0x35490",
   "off": 218256,
   "max": 20,
   "kind": "dialogue",
   "jp": "で\\nどうしたんだい",
   "en": "",
   "op": "0x62",
   "msg": "0x1952"
  },
  {
   "id": "m_008003:0x35a5c",
   "off": 219740,
   "max": 60,
   "kind": "dialogue",
   "jp": "幾松はお龍の\\n問いには答えず\\nなぜか桂と沖田の\\n前に立つ",
   "en": "",
   "op": "0x62",
   "msg": "0x1953"
  },
  {
   "id": "m_008003:0x35eb4",
   "off": 220852,
   "max": 40,
   "kind": "dialogue",
   "jp": "……姐さんが認めても\\n私は認めない……",
   "en": "",
   "op": "0x62",
   "msg": "0x1954"
  },
  {
   "id": "m_008003:0x35eec",
   "off": 220908,
   "max": 16,
   "kind": "dialogue",
   "jp": "お龍姐さんは",
   "en": "",
   "op": "0x62",
   "msg": "0x1955"
  },
  {
   "id": "m_008003:0x36910",
   "off": 223504,
   "max": 36,
   "kind": "dialogue",
   "jp": "ぁたしと幾松姐さんの\\nものですぅ♪",
   "en": "",
   "op": "0x62",
   "msg": "0x1956"
  },
  {
   "id": "m_008003:0x36ef0",
   "off": 225008,
   "max": 48,
   "kind": "dialogue",
   "jp": "桂と沖田を見る\\n二人の目は\\n笑っていなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x1957"
  },
  {
   "id": "m_008003:0x37360",
   "off": 226144,
   "max": 60,
   "kind": "dialogue",
   "jp": "あはは\\n土下座してお願いされても\\nこっちから　お　断　り",
   "en": "",
   "op": "0x62",
   "msg": "0x1958"
  },
  {
   "id": "m_008003:0x379e8",
   "off": 227816,
   "max": 8,
   "kind": "dialogue",
   "jp": "……",
   "en": "",
   "op": "0x62",
   "msg": "0x1959"
  },
  {
   "id": "m_008003:0x37f04",
   "off": 229124,
   "max": 32,
   "kind": "dialogue",
   "jp": "土方さん\\nどうしたんですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x195a"
  },
  {
   "id": "m_008003:0x382b8",
   "off": 230072,
   "max": 20,
   "kind": "choice",
   "jp": "総司は俺の仲間だ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_008003:0x382d8",
   "off": 230104,
   "max": 20,
   "kind": "choice",
   "jp": "見てみたい気がする",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_008003:0x382f8",
   "off": 230136,
   "max": 8,
   "kind": "choice",
   "jp": "断る！",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_008003:0x38d78",
   "off": 232824,
   "max": 20,
   "kind": "dialogue",
   "jp": "総司は俺の仲間だ",
   "en": "",
   "op": "0x62",
   "msg": "0x195b"
  },
  {
   "id": "m_008003:0x38d9c",
   "off": 232860,
   "max": 24,
   "kind": "dialogue",
   "jp": "そちらへ渡す気はない",
   "en": "",
   "op": "0x62",
   "msg": "0x195c"
  },
  {
   "id": "m_008003:0x39684",
   "off": 235140,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうですよね！\\n土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x195d"
  },
  {
   "id": "m_008003:0x3a1c0",
   "off": 238016,
   "max": 36,
   "kind": "dialogue",
   "jp": "ちょっとだけ\\n見てみたい気もするな",
   "en": "",
   "op": "0x62",
   "msg": "0x195e"
  },
  {
   "id": "m_008003:0x3a82c",
   "off": 239660,
   "max": 32,
   "kind": "dialogue",
   "jp": "何か言いました？\\n土方さん？",
   "en": "",
   "op": "0x62",
   "msg": "0x195f"
  },
  {
   "id": "m_008003:0x3b014",
   "off": 241684,
   "max": 48,
   "kind": "dialogue",
   "jp": "いやっ\\n何も言っていない\\n気のせいだ　ごほん",
   "en": "",
   "op": "0x62",
   "msg": "0x1960"
  },
  {
   "id": "m_008003:0x3be84",
   "off": 245380,
   "max": 8,
   "kind": "dialogue",
   "jp": "断る！",
   "en": "",
   "op": "0x62",
   "msg": "0x1961"
  },
  {
   "id": "m_008003:0x3bea4",
   "off": 245412,
   "max": 32,
   "kind": "dialogue",
   "jp": "うちの子を\\n嫁に出す気はない！",
   "en": "",
   "op": "0x62",
   "msg": "0x1962"
  },
  {
   "id": "m_008003:0x3c688",
   "off": 247432,
   "max": 48,
   "kind": "dialogue",
   "jp": "うちの子\\nお父さん宣言\\nぷっ　あははは！",
   "en": "",
   "op": "0x62",
   "msg": "0x1963"
  },
  {
   "id": "m_008003:0x3cd58",
   "off": 249176,
   "max": 28,
   "kind": "dialogue",
   "jp": "土方さん\\n僕は男ですよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1964"
  },
  {
   "id": "m_008003:0x3cd8c",
   "off": 249228,
   "max": 60,
   "kind": "dialogue",
   "jp": "嫁になるにしたって\\n土方さん以外に嫁ぐ気は\\nないからね！",
   "en": "",
   "op": "0x62",
   "msg": "0x1965"
  },
  {
   "id": "m_008003:0x3d468",
   "off": 250984,
   "max": 24,
   "kind": "dialogue",
   "jp": "わお\\nこりゃ複雑だねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x1966"
  },
  {
   "id": "m_008003:0x3dc38",
   "off": 252984,
   "max": 24,
   "kind": "dialogue",
   "jp": "私は絶対に歓迎しない",
   "en": "",
   "op": "0x62",
   "msg": "0x1967"
  },
  {
   "id": "m_008003:0x3dc60",
   "off": 253024,
   "max": 36,
   "kind": "dialogue",
   "jp": "私たちと一緒に\\n演るだなんて……",
   "en": "",
   "op": "0x62",
   "msg": "0x1968"
  },
  {
   "id": "m_008003:0x3dc94",
   "off": 253076,
   "max": 44,
   "kind": "dialogue",
   "jp": "貴方を生かしておく\\n必要を感じないわ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1969"
  },
  {
   "id": "m_008003:0x3e404",
   "off": 254980,
   "max": 32,
   "kind": "dialogue",
   "jp": "黄泉路の歌姫\\n限定復活かよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x196a"
  },
  {
   "id": "m_008003:0x3eac8",
   "off": 256712,
   "max": 56,
   "kind": "dialogue",
   "jp": "とっ　とりあえず\\n私は決してそちらには\\n入りません！",
   "en": "",
   "op": "0x62",
   "msg": "0x196b"
  },
  {
   "id": "m_008003:0x3f140",
   "off": 258368,
   "max": 12,
   "kind": "dialogue",
   "jp": "惜しいのう",
   "en": "",
   "op": "0x62",
   "msg": "0x196c"
  },
  {
   "id": "m_008003:0x3f624",
   "off": 259620,
   "max": 20,
   "kind": "dialogue",
   "jp": "惜しくないです",
   "en": "",
   "op": "0x62",
   "msg": "0x196d"
  },
  {
   "id": "m_008003:0x3fbbc",
   "off": 261052,
   "max": 68,
   "kind": "dialogue",
   "jp": "桂の悲痛な叫びと\\n皆の笑い声が\\nテラーダの店内に\\n響いたのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x196e"
  },
  {
   "id": "m_008003:0x3fc10",
   "off": 261136,
   "max": 48,
   "kind": "dialogue",
   "jp": "ともあれ\\n暗黒桜桃隊は\\n龍馬達の仲間となった",
   "en": "",
   "op": "0x62",
   "msg": "0x196f"
  },
  {
   "id": "m_008003:0x3fc50",
   "off": 261200,
   "max": 64,
   "kind": "dialogue",
   "jp": "力強い同志も得て\\n彼らはこれからも\\n幕府へと立ち向かっていく",
   "en": "",
   "op": "0x62",
   "msg": "0x1970"
  },
  {
   "id": "m_008003:0x3fca0",
   "off": 261280,
   "max": 40,
   "kind": "dialogue",
   "jp": "それは自由な音楽を\\n日の本で奏でるため",
   "en": "",
   "op": "0x62",
   "msg": "0x1971"
  },
  {
   "id": "m_008003:0x3fcd8",
   "off": 261336,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍馬達の戦いの日々に\\nまだ終わりは見えない――",
   "en": "",
   "op": "0x62",
   "msg": "0x1972"
  }
 ]
}
