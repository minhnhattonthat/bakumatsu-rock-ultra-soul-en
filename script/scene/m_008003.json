{
 "source": "m_008003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_008003:0x13ac",
   "off": 5036,
   "max": 28,
   "kind": "dialogue",
   "jp": "ああ……！\\n今のは……！",
   "en": "Ah...! What was\\nthat just now...!",
   "op": "0x62",
   "msg": "0x18b0"
  },
  {
   "id": "m_008003:0x1864",
   "off": 6244,
   "max": 80,
   "kind": "dialogue",
   "jp": "復活した龍馬による\\n即興雷舞は　天歌に\\n操られかけていた民達を\\n一度で魅了した",
   "en": "In one go, the\\nrevived Ryoma's\\nimpromptu live\\nwon over the\\npeople Heaven's\\nSong had nearly\\ncontrolled.",
   "op": "0x62",
   "msg": "0x18b1"
  },
  {
   "id": "m_008003:0x1e34",
   "off": 7732,
   "max": 24,
   "kind": "dialogue",
   "jp": "今のは\\nなんだ……！",
   "en": "What was that...!",
   "op": "0x62",
   "msg": "0x18b2"
  },
  {
   "id": "m_008003:0x22c8",
   "off": 8904,
   "max": 40,
   "kind": "dialogue",
   "jp": "天歌なんかよりも\\n心が沸き立つようだ！",
   "en": "It gets my heart\\npumpin' way more\\nthan Heaven's\\nSong!",
   "op": "0x62",
   "msg": "0x18b3"
  },
  {
   "id": "m_008003:0x276c",
   "off": 10092,
   "max": 24,
   "kind": "dialogue",
   "jp": "ロックとか\\n言ってたぞ",
   "en": "He called it \"rock\"!",
   "op": "0x62",
   "msg": "0x18b4"
  },
  {
   "id": "m_008003:0x3184",
   "off": 12676,
   "max": 24,
   "kind": "dialogue",
   "jp": "ロック最高ーーーっ！",
   "en": "Rock is the\\nBEEEST!",
   "op": "0x62",
   "msg": "0x18b5"
  },
  {
   "id": "m_008003:0x3834",
   "off": 14388,
   "max": 24,
   "kind": "dialogue",
   "jp": "ロック最高ーーーっ！",
   "en": "Rock is the\\nBEEEST!",
   "op": "0x62",
   "msg": "0x18b6"
  },
  {
   "id": "m_008003:0x4254",
   "off": 16980,
   "max": 32,
   "kind": "dialogue",
   "jp": "おおっ！\\nありがとうぜよーー！",
   "en": "Whoa! Thank ya\\nkindlyyy!",
   "op": "0x62",
   "msg": "0x18b7"
  },
  {
   "id": "m_008003:0x4284",
   "off": 17028,
   "max": 28,
   "kind": "dialogue",
   "jp": "ロックは最高ぜよーーー！",
   "en": "Rock is the\\nbeeeest!",
   "op": "0x62",
   "msg": "0x18b8"
  },
  {
   "id": "m_008003:0x4a3c",
   "off": 19004,
   "max": 32,
   "kind": "dialogue",
   "jp": "天歌の支配が\\n解けてる……！",
   "en": "Heaven's Song's\\nhold is breaking...!",
   "op": "0x62",
   "msg": "0x18b9"
  },
  {
   "id": "m_008003:0x50a8",
   "off": 20648,
   "max": 60,
   "kind": "dialogue",
   "jp": "ああ　天歌みたいな\\n作りもんと　わしの\\nロックは違うぜよ！",
   "en": "Yep! My rock ain't\\nsome made-up\\nthing like\\nHeaven's Song!",
   "op": "0x62",
   "msg": "0x18ba"
  },
  {
   "id": "m_008003:0x50f4",
   "off": 20724,
   "max": 60,
   "kind": "dialogue",
   "jp": "お前達も　わしの\\nロックで熱くなって\\n心が震えたじゃろ？",
   "en": "You gals got fired\\nup by my rock\\ntoo, and felt your\\nhearts tremble,\\nright?",
   "op": "0x62",
   "msg": "0x18bb"
  },
  {
   "id": "m_008003:0x55ac",
   "off": 21932,
   "max": 12,
   "kind": "dialogue",
   "jp": "……くっ",
   "en": "...Ngh.",
   "op": "0x62",
   "msg": "0x18bc"
  },
  {
   "id": "m_008003:0x5d40",
   "off": 23872,
   "max": 44,
   "kind": "dialogue",
   "jp": "悔しいけれど……\\nこの男の言うとおり……",
   "en": "Much as it pains\\nme... he's right...",
   "op": "0x62",
   "msg": "0x18bd"
  },
  {
   "id": "m_008003:0x5d7c",
   "off": 23932,
   "max": 48,
   "kind": "dialogue",
   "jp": "私は今……\\nこの男のロックに\\n感動している……",
   "en": "Right now... I'm\\nmoved... by this\\nman's rock...",
   "op": "0x62",
   "msg": "0x18be"
  },
  {
   "id": "m_008003:0x63ec",
   "off": 25580,
   "max": 40,
   "kind": "dialogue",
   "jp": "うう……\\n幾松姐さん\\nあたしもですぅ",
   "en": "Uuu... Sis\\nIkumatsu, me\\ntoooo...",
   "op": "0x62",
   "msg": "0x18bf"
  },
  {
   "id": "m_008003:0x6b98",
   "off": 27544,
   "max": 20,
   "kind": "dialogue",
   "jp": "……ああ　そうさ",
   "en": "...Yeah, that's\\nright.",
   "op": "0x62",
   "msg": "0x18c0"
  },
  {
   "id": "m_008003:0x6bc4",
   "off": 27588,
   "max": 32,
   "kind": "dialogue",
   "jp": "アタシも感動しち\\nまったよ！",
   "en": "It got to me too!",
   "op": "0x62",
   "msg": "0x18c1"
  },
  {
   "id": "m_008003:0x6bf4",
   "off": 27636,
   "max": 48,
   "kind": "dialogue",
   "jp": "あんたの想いの強さは\\nよくわかったわ\\n坂本龍馬",
   "en": "I get just how\\nstrong your\\nfeelings are now,\\nRyoma Sakamoto.",
   "op": "0x62",
   "msg": "0x18c2"
  },
  {
   "id": "m_008003:0x72a4",
   "off": 29348,
   "max": 52,
   "kind": "dialogue",
   "jp": "だけどあんたの心と音楽は\\nなんでそんなに強いの？",
   "en": "But why are your\\nheart and your\\nmusic so strong?",
   "op": "0x62",
   "msg": "0x18c3"
  },
  {
   "id": "m_008003:0x72e8",
   "off": 29416,
   "max": 48,
   "kind": "dialogue",
   "jp": "あんたはどうしてそこまで\\nロックを愛せるの？",
   "en": "How can you love\\nrock that much?",
   "op": "0x62",
   "msg": "0x18c4"
  },
  {
   "id": "m_008003:0x7a74",
   "off": 31348,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ははっ",
   "en": "...Haha.",
   "op": "0x62",
   "msg": "0x18c5"
  },
  {
   "id": "m_008003:0x7a90",
   "off": 31376,
   "max": 72,
   "kind": "dialogue",
   "jp": "土佐にいた頃はなぁ　わしは\\n歌が下手だ　下手だと\\n言われ続けておった",
   "en": "Back in Tosa,\\nfolks never\\nstopped tellin' me\\nwhat a lousy\\nsinger I was.",
   "op": "0x62",
   "msg": "0x18c6"
  },
  {
   "id": "m_008003:0x7ae8",
   "off": 31464,
   "max": 68,
   "kind": "dialogue",
   "jp": "だけど　姉さんと\\n弥太郎だけは　わしの歌を\\n好きだと言ってくれた",
   "en": "But my big sister\\nand Yataro--they\\nwere the only\\nones who said\\nthey liked my\\nsingin'.",
   "op": "0x62",
   "msg": "0x18c7"
  },
  {
   "id": "m_008003:0x8514",
   "off": 34068,
   "max": 36,
   "kind": "dialogue",
   "jp": "弥太郎ってのは\\nわしのダチでな……",
   "en": "Yataro's a buddy\\nof mine...",
   "op": "0x62",
   "msg": "0x18c8"
  },
  {
   "id": "m_008003:0x854c",
   "off": 34124,
   "max": 52,
   "kind": "dialogue",
   "jp": "この弥太郎　ガキの頃は\\nほとんど喋らん奴じゃった",
   "en": "Back when we\\nwere kids, Yataro\\nhardly said a\\nword.",
   "op": "0x62",
   "msg": "0x18c9"
  },
  {
   "id": "m_008003:0x8dec",
   "off": 36332,
   "max": 68,
   "kind": "dialogue",
   "jp": "無視され続けたわしは\\nある日　弥太郎を想って\\n歌ってみたんじゃ！",
   "en": "Yataro kept\\nignorin' me, so\\none day I tried\\nsingin' a song just\\nfor him!",
   "op": "0x62",
   "msg": "0x18ca"
  },
  {
   "id": "m_008003:0x8e40",
   "off": 36416,
   "max": 32,
   "kind": "dialogue",
   "jp": "一人でいたら\\nさみしくないか？",
   "en": "\"Ain't you lonely,\\nall by yourself?\"",
   "op": "0x62",
   "msg": "0x18cb"
  },
  {
   "id": "m_008003:0x9374",
   "off": 37748,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしらと一緒に\\n遊ぼうぜよ\\nってな",
   "en": "\"Come on and\\nplay with us!\"\\nSomethin' like\\nthat.",
   "op": "0x62",
   "msg": "0x18cc"
  },
  {
   "id": "m_008003:0x9744",
   "off": 38724,
   "max": 36,
   "kind": "dialogue",
   "jp": "嬉しそうな顔で\\n龍馬は思い出を語る",
   "en": "Smiling happily,\\nRyoma recounted\\nthe memory.",
   "op": "0x62",
   "msg": "0x18cd"
  },
  {
   "id": "m_008003:0x9a70",
   "off": 39536,
   "max": 44,
   "kind": "dialogue",
   "jp": "遊び仲間には　へたくそな\\n歌だと笑われた",
   "en": "My playmates\\nlaughed and said\\nit was a lousy\\nsong.",
   "op": "0x62",
   "msg": "0x18ce"
  },
  {
   "id": "m_008003:0x9aac",
   "off": 39596,
   "max": 32,
   "kind": "dialogue",
   "jp": "そして　弥太郎も\\n笑ったんじゃ",
   "en": "And Yataro\\nlaughed too.",
   "op": "0x62",
   "msg": "0x18cf"
  },
  {
   "id": "m_008003:0x9adc",
   "off": 39644,
   "max": 68,
   "kind": "dialogue",
   "jp": "へたくそな歌だけど\\nあんなに一生懸命に\\n歌うから無視できなんだと",
   "en": "He said it was a\\nlousy song, but I\\nsang it so hard he\\njust couldn't\\nignore it.",
   "op": "0x62",
   "msg": "0x18d0"
  },
  {
   "id": "m_008003:0xa1a8",
   "off": 41384,
   "max": 68,
   "kind": "dialogue",
   "jp": "歌は……　音楽はなぁ\\n人の心を揺さぶるもんじゃと\\nわしは思うぜよ",
   "en": "Songs... music,\\ny'know... I reckon\\nit's somethin' that\\nshakes people's\\nhearts.",
   "op": "0x62",
   "msg": "0x18d1"
  },
  {
   "id": "m_008003:0xa1fc",
   "off": 41468,
   "max": 40,
   "kind": "dialogue",
   "jp": "たくさんの音楽が\\nこの世にはあるぜよ",
   "en": "There's all kinds\\nof music in this\\nworld.",
   "op": "0x62",
   "msg": "0x18d2"
  },
  {
   "id": "m_008003:0xa234",
   "off": 41524,
   "max": 68,
   "kind": "dialogue",
   "jp": "お上が認めたものだけが\\n音楽だなんて　そんな\\nバカな話があるもんか",
   "en": "Sayin' only what\\nthe authorities\\napprove counts as\\nmusic--how could\\nanything be that\\ndumb?",
   "op": "0x62",
   "msg": "0x18d3"
  },
  {
   "id": "m_008003:0xa8a4",
   "off": 43172,
   "max": 48,
   "kind": "dialogue",
   "jp": "音楽は　人の自由な心が\\n生み出す熱い魂ぜよ！",
   "en": "Music is a burnin'\\nsoul born from\\npeople's free\\nhearts!",
   "op": "0x62",
   "msg": "0x18d4"
  },
  {
   "id": "m_008003:0xa8e4",
   "off": 43236,
   "max": 48,
   "kind": "dialogue",
   "jp": "わしは　胸の中の熱情を\\n抑えきれないんじゃ！",
   "en": "I just can't hold\\nback the passion\\nin my chest!",
   "op": "0x62",
   "msg": "0x18d5"
  },
  {
   "id": "m_008003:0xb0a8",
   "off": 45224,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああ……\\nあんたの言う通りだわ\\n坂本龍馬",
   "en": "Ah... you're right,\\nRyoma Sakamoto.",
   "op": "0x62",
   "msg": "0x18d6"
  },
  {
   "id": "m_008003:0xb0e4",
   "off": 45284,
   "max": 20,
   "kind": "dialogue",
   "jp": "アタシ達の負けね",
   "en": "We're beat.",
   "op": "0x62",
   "msg": "0x18d7"
  },
  {
   "id": "m_008003:0xb73c",
   "off": 46908,
   "max": 16,
   "kind": "dialogue",
   "jp": "姐さん……！",
   "en": "Sis...!",
   "op": "0x62",
   "msg": "0x18d8"
  },
  {
   "id": "m_008003:0xbbc8",
   "off": 48072,
   "max": 28,
   "kind": "dialogue",
   "jp": "だってそうでしょう\\n幾松",
   "en": "Well, it's true,\\nisn't it, Ikumatsu?",
   "op": "0x62",
   "msg": "0x18d9"
  },
  {
   "id": "m_008003:0xbbf4",
   "off": 48116,
   "max": 48,
   "kind": "dialogue",
   "jp": "アタシたちも\\nただ　歌いたかったんじゃ\\nないか",
   "en": "All we ever\\nwanted was just\\nto sing, wasn't it?",
   "op": "0x62",
   "msg": "0x18da"
  },
  {
   "id": "m_008003:0xc2bc",
   "off": 49852,
   "max": 24,
   "kind": "dialogue",
   "jp": "……ぅん\\nそぉだよね☆",
   "en": "...Mm-hm. That's\\nriiight~",
   "op": "0x62",
   "msg": "0x18db"
  },
  {
   "id": "m_008003:0xc2e4",
   "off": 49892,
   "max": 44,
   "kind": "dialogue",
   "jp": "でもぉ\\n勝手に歌えば\\n罰せられるしぃ……",
   "en": "Buuut if we sing\\non our own, we\\nget punished...",
   "op": "0x62",
   "msg": "0x18dc"
  },
  {
   "id": "m_008003:0xca94",
   "off": 51860,
   "max": 36,
   "kind": "dialogue",
   "jp": "だから\\n徳川幕府の手先に\\nなった",
   "en": "So we became the\\nTokugawa\\nshogunate's\\nlackeys.",
   "op": "0x62",
   "msg": "0x18dd"
  },
  {
   "id": "m_008003:0xd0fc",
   "off": 53500,
   "max": 24,
   "kind": "dialogue",
   "jp": "歌いたかったから……",
   "en": "Because we\\nwanted to sing...",
   "op": "0x62",
   "msg": "0x18de"
  },
  {
   "id": "m_008003:0xd898",
   "off": 55448,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前達も\\n音楽を愛する\\nロックな男……",
   "en": "So you gals love\\nmusic too--you're\\nrockin' men...",
   "op": "0x62",
   "msg": "0x18df"
  },
  {
   "id": "m_008003:0xdd44",
   "off": 56644,
   "max": 32,
   "kind": "dialogue",
   "jp": "いや　ロックな\\nおなごぜよ！",
   "en": "No wait, rockin'\\nladies!",
   "op": "0x62",
   "msg": "0x18e0"
  },
  {
   "id": "m_008003:0xe3fc",
   "off": 58364,
   "max": 32,
   "kind": "dialogue",
   "jp": "……すまなかったね\\n坂本龍馬",
   "en": "...Sorry about all\\nthat, Ryoma\\nSakamoto.",
   "op": "0x62",
   "msg": "0x18e1"
  },
  {
   "id": "m_008003:0xe42c",
   "off": 58412,
   "max": 20,
   "kind": "dialogue",
   "jp": "ねぇ\\n幾松　おうの",
   "en": "Hey, Ikumatsu,\\nOuno.",
   "op": "0x62",
   "msg": "0x18e2"
  },
  {
   "id": "m_008003:0xec1c",
   "off": 60444,
   "max": 20,
   "kind": "dialogue",
   "jp": "はい！\\nはぁい！",
   "en": "Yes! Yesss!",
   "op": "0x62",
   "msg": "0x18e3"
  },
  {
   "id": "m_008003:0xf52c",
   "off": 62764,
   "max": 56,
   "kind": "dialogue",
   "jp": "アタシたち　他の方法で\\n愛獲になってやろうじゃ\\nないか",
   "en": "Let's make it as\\nidols some other\\nway.",
   "op": "0x62",
   "msg": "0x18e4"
  },
  {
   "id": "m_008003:0xf574",
   "off": 62836,
   "max": 44,
   "kind": "dialogue",
   "jp": "幕府に押しつけられた\\n天歌なんかじゃなく",
   "en": "Not with Heaven's\\nSong, forced on\\nus by the\\nshogunate.",
   "op": "0x62",
   "msg": "0x18e5"
  },
  {
   "id": "m_008003:0xfe00",
   "off": 65024,
   "max": 8,
   "kind": "dialogue",
   "jp": "はい！",
   "en": "Yes!",
   "op": "0x62",
   "msg": "0x18e6"
  },
  {
   "id": "m_008003:0x10590",
   "off": 66960,
   "max": 48,
   "kind": "dialogue",
   "jp": "アタシもアンタ達となら\\nやりとげてみせるよ！",
   "en": "With you two, I\\nknow I can pull it\\noff!",
   "op": "0x62",
   "msg": "0x18e7"
  },
  {
   "id": "m_008003:0x1105c",
   "off": 69724,
   "max": 48,
   "kind": "dialogue",
   "jp": "三人は手を握り合い\\nそして　そっと\\n抱き合った",
   "en": "The three joined\\nhands, and then\\ngently embraced.",
   "op": "0x62",
   "msg": "0x18e8"
  },
  {
   "id": "m_008003:0x114d4",
   "off": 70868,
   "max": 44,
   "kind": "dialogue",
   "jp": "うう……っ！\\nいい光景じゃ！\\n……ずずっ！",
   "en": "Uuu...! What a\\nbeautiful sight!\\n...*Sniff!*",
   "op": "0x62",
   "msg": "0x18e9"
  },
  {
   "id": "m_008003:0x11b44",
   "off": 72516,
   "max": 8,
   "kind": "dialogue",
   "jp": "おい！",
   "en": "Hey!",
   "op": "0x62",
   "msg": "0x18ea"
  },
  {
   "id": "m_008003:0x11fd0",
   "off": 73680,
   "max": 56,
   "kind": "dialogue",
   "jp": "感動してるところに\\n水を差すようだが\\nそろそろやばいぜ",
   "en": "Sorry to rain on\\nyour tearful\\nmoment, but\\nthings are about\\nto get ugly.",
   "op": "0x62",
   "msg": "0x18eb"
  },
  {
   "id": "m_008003:0x1251c",
   "off": 75036,
   "max": 8,
   "kind": "dialogue",
   "jp": "ほえ？",
   "en": "Huh?",
   "op": "0x62",
   "msg": "0x18ec"
  },
  {
   "id": "m_008003:0x12ab4",
   "off": 76468,
   "max": 76,
   "kind": "dialogue",
   "jp": "龍馬の即興雷舞の音を\\n聞きつけた幕府側の\\n武士達が押し寄せよう\\nとしていた",
   "en": "Shogunate\\nsamurai who had\\nheard the sound\\nof Ryoma's\\nimpromptu live\\nwere about to\\ncome swarming\\nin.",
   "op": "0x62",
   "msg": "0x18ed"
  },
  {
   "id": "m_008003:0x12f4c",
   "off": 77644,
   "max": 44,
   "kind": "dialogue",
   "jp": "手持ちの痺れ玉も\\n使い切ってしまいましたよ",
   "en": "And I've used up\\nall the numbing\\nbombs I had on\\nme.",
   "op": "0x62",
   "msg": "0x18ee"
  },
  {
   "id": "m_008003:0x135b8",
   "off": 79288,
   "max": 40,
   "kind": "dialogue",
