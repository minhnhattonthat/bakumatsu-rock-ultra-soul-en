{
 "source": "m_009001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_009001:0x11d0",
   "off": 4560,
   "max": 72,
   "kind": "dialogue",
   "jp": "幕府に召し捕られた龍馬は\\n高杉達の助けによって\\n辛くも打ち首を免れた",
   "en": "",
   "op": "0x62",
   "msg": "0x19a0"
  },
  {
   "id": "m_009001:0x1228",
   "off": 4648,
   "max": 80,
   "kind": "dialogue",
   "jp": "即興の雷舞を行いつつ\\n裁きの場から逃れた\\n龍馬達の雄姿に　民衆は\\n大いに沸いた",
   "en": "",
   "op": "0x62",
   "msg": "0x19a1"
  },
  {
   "id": "m_009001:0x1288",
   "off": 4744,
   "max": 84,
   "kind": "dialogue",
   "jp": "辻では　龍馬達が\\nいつどこで次の突風雷舞を\\n行うのか　その噂で\\n持ちきりであった",
   "en": "",
   "op": "0x62",
   "msg": "0x19a2"
  },
  {
   "id": "m_009001:0x1734",
   "off": 5940,
   "max": 20,
   "kind": "dialogue",
   "jp": "なぁ\\n聞いたかよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x19a3"
  },
  {
   "id": "m_009001:0x1758",
   "off": 5976,
   "max": 60,
   "kind": "dialogue",
   "jp": "幕府のお役人が\\n坂本龍馬とその仲間を\\n総出で捜してるって話",
   "en": "",
   "op": "0x62",
   "msg": "0x19a4"
  },
  {
   "id": "m_009001:0x1dd4",
   "off": 7636,
   "max": 20,
   "kind": "dialogue",
   "jp": "聞いた\\n聞いた！",
   "en": "",
   "op": "0x62",
   "msg": "0x19a5"
  },
  {
   "id": "m_009001:0x1df8",
   "off": 7672,
   "max": 32,
   "kind": "dialogue",
   "jp": "下級武士や\\n忍の者だけじゃなく",
   "en": "",
   "op": "0x62",
   "msg": "0x19a6"
  },
  {
   "id": "m_009001:0x1e28",
   "off": 7720,
   "max": 68,
   "kind": "dialogue",
   "jp": "身分の高いお武家様や\\nご隠居達にも強制的に\\n坂本を捜させてるとか",
   "en": "",
   "op": "0x62",
   "msg": "0x19a7"
  },
  {
   "id": "m_009001:0x22e8",
   "off": 8936,
   "max": 60,
   "kind": "dialogue",
   "jp": "そりゃ　そうだろう\\nお裁きの場から\\n逃げ出されたばかりか",
   "en": "",
   "op": "0x62",
   "msg": "0x19a8"
  },
  {
   "id": "m_009001:0x2334",
   "off": 9012,
   "max": 40,
   "kind": "dialogue",
   "jp": "公然と雷舞までやって\\nのけたって話だ",
   "en": "",
   "op": "0x62",
   "msg": "0x19a9"
  },
  {
   "id": "m_009001:0x236c",
   "off": 9068,
   "max": 56,
   "kind": "dialogue",
   "jp": "幕府のお偉方も\\nはらわたが煮えくり返る\\n思いだろうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19aa"
  },
  {
   "id": "m_009001:0x2820",
   "off": 10272,
   "max": 44,
   "kind": "dialogue",
   "jp": "なるほどな\\nそらぁ幕府も\\n本気になるわな",
   "en": "",
   "op": "0x62",
   "msg": "0x19ab"
  },
  {
   "id": "m_009001:0x2e38",
   "off": 11832,
   "max": 76,
   "kind": "dialogue",
   "jp": "ああ　幕府に捕まったら\\n坂本達は今度こそ終いだ\\n即刻打ち首だって有り得る",
   "en": "",
   "op": "0x62",
   "msg": "0x19ac"
  },
  {
   "id": "m_009001:0x2e94",
   "off": 11924,
   "max": 72,
   "kind": "dialogue",
   "jp": "坂本達は今頃きっと\\n追っ手に見つからないよう\\n必死に身を隠してるはずだ",
   "en": "",
   "op": "0x62",
   "msg": "0x19ad"
  },
  {
   "id": "m_009001:0x3574",
   "off": 13684,
   "max": 68,
   "kind": "dialogue",
   "jp": "だろうなぁ……\\nこりゃ　しばらく坂本達の\\n雷舞は見られそうにないな",
   "en": "",
   "op": "0x62",
   "msg": "0x19ae"
  },
  {
   "id": "m_009001:0x35c8",
   "off": 13768,
   "max": 56,
   "kind": "dialogue",
   "jp": "坂本の歌が\\n当分聴けないと思うと\\nえらい寂しいな……",
   "en": "",
   "op": "0x62",
   "msg": "0x19af"
  },
  {
   "id": "m_009001:0x3d10",
   "off": 15632,
   "max": 52,
   "kind": "dialogue",
   "jp": "……ああっ\\n今すぐ坂本龍馬のロックが\\n聴きたいっ",
   "en": "",
   "op": "0x62",
   "msg": "0x19b0"
  },
  {
   "id": "m_009001:0x40fc",
   "off": 16636,
   "max": 28,
   "kind": "dialogue",
   "jp": "町人は空に\\n向かって吼えた",
   "en": "",
   "op": "0x62",
   "msg": "0x19b1"
  },
  {
   "id": "m_009001:0x4128",
   "off": 16680,
   "max": 12,
   "kind": "dialogue",
   "jp": "すると――",
   "en": "",
   "op": "0x62",
   "msg": "0x19b2"
  },
  {
   "id": "m_009001:0x46c8",
   "off": 18120,
   "max": 48,
   "kind": "dialogue",
   "jp": "おっ　そこの人\\n嬉しいことを\\n言ってくれる！",
   "en": "",
   "op": "0x62",
   "msg": "0x19b3"
  },
  {
   "id": "m_009001:0x50f8",
   "off": 20728,
   "max": 32,
   "kind": "dialogue",
   "jp": "町人の前に\\n坂本龍馬が現れた！",
   "en": "",
   "op": "0x62",
   "msg": "0x19b4"
  },
  {
   "id": "m_009001:0x58cc",
   "off": 22732,
   "max": 36,
   "kind": "dialogue",
   "jp": "うぉぉっ\\n坂本龍馬\\nホンモノか",
   "en": "",
   "op": "0x62",
   "msg": "0x19b5"
  },
  {
   "id": "m_009001:0x614c",
   "off": 24908,
   "max": 28,
   "kind": "dialogue",
   "jp": "正真正銘の\\n坂本龍馬ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x19b6"
  },
  {
   "id": "m_009001:0x6800",
   "off": 26624,
   "max": 52,
   "kind": "dialogue",
   "jp": "何でこんなところに\\n隠れてなくても\\nいいのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x19b7"
  },
  {
   "id": "m_009001:0x6d48",
   "off": 27976,
   "max": 52,
   "kind": "dialogue",
   "jp": "隠れ家でじっとしてるのも\\nわしの性に合わなくてなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x19b8"
  },
  {
   "id": "m_009001:0x6d8c",
   "off": 28044,
   "max": 80,
   "kind": "dialogue",
   "jp": "ちょいと　その辺で\\n一人雷舞（ソロライブ）\\nでもかましてやろうと\\n出てきたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19b9"
  },
  {
   "id": "m_009001:0x7398",
   "off": 29592,
   "max": 40,
   "kind": "dialogue",
   "jp": "ちょいと　その辺で……\\nって　ここで",
   "en": "",
   "op": "0x62",
   "msg": "0x19ba"
  },
  {
   "id": "m_009001:0x7c2c",
   "off": 31788,
   "max": 48,
   "kind": "dialogue",
   "jp": "好きなときに\\n好きな場所で\\n好きな歌を歌う！",
   "en": "",
   "op": "0x62",
   "msg": "0x19bb"
  },
  {
   "id": "m_009001:0x7c6c",
   "off": 31852,
   "max": 32,
   "kind": "dialogue",
   "jp": "それが　わしの\\nロックぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x19bc"
  },
  {
   "id": "m_009001:0x8224",
   "off": 33316,
   "max": 40,
   "kind": "dialogue",
   "jp": "それじゃ\\nどの曲から\\nいこうかな……",
   "en": "",
   "op": "0x62",
   "msg": "0x19bd"
  },
  {
   "id": "m_009001:0x8ca8",
   "off": 36008,
   "max": 44,
   "kind": "dialogue",
   "jp": "ちょ　ちょっと待った！\\nダメだ　ダメだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x19be"
  },
  {
   "id": "m_009001:0x9374",
   "off": 37748,
   "max": 60,
   "kind": "dialogue",
   "jp": "なんぜよ？　お前さん達\\nわしの歌を聴きたいと\\n言ってたのに",
   "en": "",
   "op": "0x62",
   "msg": "0x19bf"
  },
  {
   "id": "m_009001:0x99f0",
   "off": 39408,
   "max": 48,
   "kind": "dialogue",
   "jp": "それはそうだけど\\nとにかく　ここじゃ\\nダメだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x19c0"
  },
  {
   "id": "m_009001:0x9f3c",
   "off": 40764,
   "max": 24,
   "kind": "dialogue",
   "jp": "え～？\\nどうしてぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19c1"
  },
  {
   "id": "m_009001:0xa6d8",
   "off": 42712,
   "max": 52,
   "kind": "dialogue",
   "jp": "この辺りじゃ\\nそこら中で　役人の\\n目が光ってる！",
   "en": "",
   "op": "0x62",
   "msg": "0x19c2"
  },
  {
   "id": "m_009001:0xa71c",
   "off": 42780,
   "max": 40,
   "kind": "dialogue",
   "jp": "こんなところで雷舞を\\nやらかしてみろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x19c3"
  },
  {
   "id": "m_009001:0xa754",
   "off": 42836,
   "max": 64,
   "kind": "dialogue",
   "jp": "あんたばかりか\\n聴いていた　俺達まで\\nたちまち捕まっちまう！",
   "en": "",
   "op": "0x62",
   "msg": "0x19c4"
  },
  {
   "id": "m_009001:0xae34",
   "off": 44596,
   "max": 16,
   "kind": "dialogue",
   "jp": "む　むう……",
   "en": "",
   "op": "0x62",
   "msg": "0x19c5"
  },
  {
   "id": "m_009001:0xb484",
   "off": 46212,
   "max": 52,
   "kind": "dialogue",
   "jp": "なあ　坂本さん\\nあんたのロックは\\nみんなが認めてる",
   "en": "",
   "op": "0x62",
   "msg": "0x19c6"
  },
  {
   "id": "m_009001:0xb4c8",
   "off": 46280,
   "max": 64,
   "kind": "dialogue",
   "jp": "だが　今は時が悪い\\nほとぼりが冷めるまで\\n大人しくしてろって",
   "en": "",
   "op": "0x62",
   "msg": "0x19c7"
  },
  {
   "id": "m_009001:0xbf70",
   "off": 49008,
   "max": 56,
   "kind": "dialogue",
   "jp": "しかし　わしは\\n歌いたくて歌いたくて\\n仕方ないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x19c8"
  },
  {
   "id": "m_009001:0xc7b4",
   "off": 51124,
   "max": 76,
   "kind": "dialogue",
   "jp": "二人の町人は\\n顔を見合わせると\\n揃えたように\\n気の毒そうな\\n表情を浮かべた",
   "en": "",
   "op": "0x62",
   "msg": "0x19c9"
  },
  {
   "id": "m_009001:0xcb08",
   "off": 51976,
   "max": 56,
   "kind": "dialogue",
   "jp": "そ　そりゃ　俺達も\\nあんたのロックを\\n聴きたいが……",
   "en": "",
   "op": "0x62",
   "msg": "0x19ca"
  },
  {
   "id": "m_009001:0xcfbc",
   "off": 53180,
   "max": 68,
   "kind": "dialogue",
   "jp": "そうだ　次の突風雷舞は\\nいつ　どこでやるか\\nもう決まってるのかい？",
   "en": "",
   "op": "0x62",
   "msg": "0x19cb"
  },
  {
   "id": "m_009001:0xd784",
   "off": 55172,
   "max": 64,
   "kind": "dialogue",
   "jp": "仲間とも話し合っては\\nいるんだが　なかなか\\n決まらなくて……",
   "en": "",
   "op": "0x62",
   "msg": "0x19cc"
  },
  {
   "id": "m_009001:0xde04",
   "off": 56836,
   "max": 56,
   "kind": "dialogue",
   "jp": "じゃあ　それが\\n決まったら教えてくれよ\\n応援に行くから",
   "en": "",
   "op": "0x62",
   "msg": "0x19cd"
  },
  {
   "id": "m_009001:0xe5c0",
   "off": 58816,
   "max": 24,
   "kind": "dialogue",
   "jp": "おう！\\n是非来てくれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x19ce"
  },
  {
   "id": "m_009001:0xedb0",
   "off": 60848,
   "max": 36,
   "kind": "dialogue",
   "jp": "そういうことで……\\nおいっ　行くぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x19cf"
  },
  {
   "id": "m_009001:0xf250",
   "off": 62032,
   "max": 32,
   "kind": "dialogue",
   "jp": "あ　ああ\\nじゃあな　坂本さん",
   "en": "",
   "op": "0x62",
   "msg": "0x19d0"
  },
  {
   "id": "m_009001:0xf9f4",
   "off": 63988,
   "max": 40,
   "kind": "dialogue",
   "jp": "お～い！\\n雷舞には絶対\\n来るぜよ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x19d1"
  },
  {
   "id": "m_009001:0xfdc8",
   "off": 64968,
   "max": 60,
   "kind": "dialogue",
   "jp": "大声で手を振る龍馬から\\n逃げるように　町人達は\\n去って行く",
   "en": "",
   "op": "0x62",
   "msg": "0x19d2"
  },
  {
   "id": "m_009001:0xfe14",
   "off": 65044,
   "max": 80,
   "kind": "dialogue",
   "jp": "そして\\nふと周りを見れば\\nあれほど賑わっていた\\n辻から人が\\nいなくなっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x19d3"
  },
  {
   "id": "m_009001:0x1020c",
   "off": 66060,
   "max": 60,
   "kind": "dialogue",
   "jp": "……ふう\\n一人雷舞という気分でも\\nなくなってしまったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19d4"
  },
  {
   "id": "m_009001:0x10258",
   "off": 66136,
   "max": 32,
   "kind": "dialogue",
   "jp": "腹も減ったし\\n隠れ家へ戻るか",
   "en": "",
   "op": "0x62",
   "msg": "0x19d5"
  },
  {
   "id": "m_009001:0x10708",
   "off": 67336,
   "max": 60,
   "kind": "dialogue",
   "jp": "龍馬はそう呟くと\\nとぼとぼと誰もいない\\n裏辻へと姿を消した",
   "en": "",
   "op": "0x62",
   "msg": "0x19d6"
  },
  {
   "id": "m_009001:0x10c20",
   "off": 68640,
   "max": 72,
   "kind": "dialogue",
   "jp": "その背中をじっと見つめる\\n一人の男がいたことを\\n龍馬は気付かなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x19d7"
  },
  {
   "id": "m_009001:0x11544",
   "off": 70980,
   "max": 68,
   "kind": "dialogue",
   "jp": "腹が減ったぜよ～\\n誰か　一緒にテラーダへ\\nメシを食いにいかんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x19d8"
  },
  {
   "id": "m_009001:0x11c24",
   "off": 72740,
   "max": 28,
   "kind": "dialogue",
   "jp": "坂本\\nどこへ行っていた？",
   "en": "",
   "op": "0x62",
   "msg": "0x19d9"
  },
  {
   "id": "m_009001:0x122d8",
   "off": 74456,
   "max": 40,
   "kind": "dialogue",
   "jp": "どこって\\nまあそこら辺を\\n散歩して……",
   "en": "",
   "op": "0x62",
   "msg": "0x19da"
  },
  {
   "id": "m_009001:0x12c70",
   "off": 76912,
   "max": 52,
   "kind": "dialogue",
   "jp": "あれほど　勝手な\\n行動を取るなと\\n言っただろう！",
   "en": "",
   "op": "0x62",
   "msg": "0x19db"
  },
  {
   "id": "m_009001:0x136ec",
   "off": 79596,
   "max": 56,
   "kind": "dialogue",
   "jp": "いや　その\\nじっとしてられなくて\\nすまん　ヒジゾーさん",
   "en": "",
   "op": "0x62",
   "msg": "0x19dc"
  },
  {
   "id": "m_009001:0x13c14",
   "off": 80916,
   "max": 40,
   "kind": "dialogue",
   "jp": "まさか　歌ったりは\\nしてないだろうな？",
   "en": "",
   "op": "0x62",
   "msg": "0x19dd"
  },
  {
   "id": "m_009001:0x141ac",
   "off": 82348,
   "max": 32,
   "kind": "dialogue",
   "jp": "ないない！\\n歌ってないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19de"
  },
  {
   "id": "m_009001:0x14650",
   "off": 83536,
   "max": 16,
   "kind": "dialogue",
   "jp": "……本当か？",
   "en": "",
   "op": "0x62",
   "msg": "0x19df"
  },
  {
   "id": "m_009001:0x14b74",
   "off": 84852,
   "max": 48,
   "kind": "dialogue",
   "jp": "ご贔屓さんに止められて\\n結局　歌えなかったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19e0"
  },
  {
   "id": "m_009001:0x15020",
   "off": 86048,
   "max": 60,
   "kind": "dialogue",
   "jp": "それなら問題ないが\\n目立つような行動は\\nくれぐれも自重しろ",
   "en": "",
   "op": "0x62",
   "msg": "0x19e1"
  },
  {
   "id": "m_009001:0x1506c",
   "off": 86124,
   "max": 44,
   "kind": "dialogue",
   "jp": "我々の置かれている\\n状況を　よく考えるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x19e2"
  },
  {
   "id": "m_009001:0x1581c",
   "off": 88092,
   "max": 56,
   "kind": "dialogue",
   "jp": "土方さ～ん\\nトサカくんに　そんなこと\\n言ってもムダムダ",
   "en": "",
   "op": "0x62",
   "msg": "0x19e3"
  },
  {
   "id": "m_009001:0x15864",
   "off": 88164,
   "max": 28,
   "kind": "dialogue",
   "jp": "三歩歩いたら忘れちゃうよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19e4"
  },
  {
   "id": "m_009001:0x15890",
   "off": 88208,
   "max": 68,
   "kind": "dialogue",
   "jp": "首輪をつけて　鎖で\\n繋いででも置かない限り\\nじっとなんかしてないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19e5"
  },
  {
   "id": "m_009001:0x160c8",
   "off": 90312,
   "max": 60,
   "kind": "dialogue",
   "jp": "ソ　ソウちん\\nいくらなんでも　それは\\n勘弁して欲しいぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19e6"
  },
  {
   "id": "m_009001:0x161ac",
   "off": 90540,
   "max": 64,
   "kind": "dialogue",
   "jp": "そりゃ　わしだって\\n勝手に外に出たことは\\n悪いと思ってるが……",
   "en": "",
   "op": "0x62",
   "msg": "0x19e7"
  },
  {
   "id": "m_009001:0x16668",
   "off": 91752,
   "max": 56,
   "kind": "dialogue",
   "jp": "これからは　ちゃんと\\n言うことをきくって\\n約束できる？",
   "en": "",
   "op": "0x62",
   "msg": "0x19e8"
  },
  {
   "id": "m_009001:0x16e90",
   "off": 93840,
   "max": 12,
   "kind": "dialogue",
   "jp": "もちろん！",
   "en": "",
   "op": "0x62",
   "msg": "0x19e9"
  },
  {
   "id": "m_009001:0x175b8",
   "off": 95672,
   "max": 36,
   "kind": "dialogue",
   "jp": "ふぅん　それじゃ\\n試してみようか",
   "en": "",
   "op": "0x62",
   "msg": "0x19ea"
  },
  {
   "id": "m_009001:0x17988",
   "off": 96648,
   "max": 56,
   "kind": "dialogue",
   "jp": "沖田は指で\\nリズムを取ると\\n軽やかな声で\\n歌い出した",
   "en": "",
   "op": "0x62",
   "msg": "0x19eb"
  },
  {
   "id": "m_009001:0x18054",
   "off": 98388,
   "max": 52,
   "kind": "dialogue",
   "jp": "もう引き返すつもりは\\n毛頭ない\\nもう立ち止まんない",
   "en": "",
   "op": "0x62",
   "msg": "0x19ec"
  },
  {
   "id": "m_009001:0x18730",
   "off": 100144,
   "max": 56,
   "kind": "dialogue",
   "jp": "こうなった以上は\\n何人たりとも絶対敵わない\\nオーイエー",
   "en": "",
   "op": "0x62",
   "msg": "0x19ee"
  },
  {
   "id": "m_009001:0x18fcc",
   "off": 102348,
   "max": 36,
   "kind": "dialogue",
   "jp": "あはははは！\\nやっぱりダメじゃん！",
   "en": "",
   "op": "0x62",
   "msg": "0x19ef"
  },
  {
   "id": "m_009001:0x197e4",
   "off": 104420,
   "max": 64,
   "kind": "dialogue",
   "jp": "い　今のはずるいぜよ！\\n先に歌い始めたのは\\nソウちんなのに！",
   "en": "",
   "op": "0x62",
   "msg": "0x19f0"
  },
  {
   "id": "m_009001:0x19ca0",
   "off": 105632,
   "max": 64,
   "kind": "dialogue",
   "jp": "ダ～メ　言い訳無用\\nこれは首輪で繋いで\\nおく方がよさそうだね～",
   "en": "",
   "op": "0x62",
   "msg": "0x19f1"
  },
  {
   "id": "m_009001:0x1a334",
   "off": 107316,
   "max": 36,
   "kind": "dialogue",
   "jp": "うう\\nソウちんは\\n厳しいぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x19f2"
  },
  {
   "id": "m_009001:0x1a948",
   "off": 108872,
   "max": 80,
   "kind": "dialogue",
   "jp": "沖田には敵わないと\\n悟ったのか　龍馬は\\n話題を切り替えようと\\n桂を振り返った",
   "en": "",
   "op": "0x62",
   "msg": "0x19f3"
  },
  {
   "id": "m_009001:0x1ade0",
   "off": 110048,
   "max": 56,
   "kind": "dialogue",
   "jp": "そうじゃ　センセー\\n次の雷舞の日程は\\nどうなっとる？",
   "en": "",
   "op": "0x62",
   "msg": "0x19f4"
  },
  {
   "id": "m_009001:0x1ae28",
   "off": 110120,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしは　ご贔屓さんに\\n次の雷舞の予定を\\n聞かれたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19f5"
  },
  {
   "id": "m_009001:0x1b4fc",
   "off": 111868,
   "max": 16,
   "kind": "dialogue",
   "jp": "……龍馬くん",
   "en": "",
   "op": "0x62",
   "msg": "0x19f6"
  },
  {
   "id": "m_009001:0x1b51c",
   "off": 111900,
   "max": 52,
   "kind": "dialogue",
   "jp": "何度も同じ話をしましたが\\n今は時期がまずいんです",
   "en": "",
   "op": "0x62",
   "msg": "0x19f7"
  },
  {
   "id": "m_009001:0x1b560",
   "off": 111968,
   "max": 60,
   "kind": "dialogue",
   "jp": "いくつかの雷舞屋に\\n交渉してみましたが\\nすべて断られました",
   "en": "",
   "op": "0x62",
   "msg": "0x19f8"
  },
  {
   "id": "m_009001:0x1bda8",
   "off": 114088,
   "max": 60,
   "kind": "dialogue",
   "jp": "いつものように\\n突風雷舞でいいだろう\\n神出鬼没でいくぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19f9"
  },
  {
   "id": "m_009001:0x1c5ec",
   "off": 116204,
   "max": 40,
   "kind": "dialogue",
   "jp": "そっちは　もっと\\n厳しい状況なんです",
   "en": "",
   "op": "0x62",
   "msg": "0x19fa"
  },
  {
   "id": "m_009001:0x1c624",
   "off": 116260,
   "max": 64,
   "kind": "dialogue",
   "jp": "今や　京の街のどこで\\n見回り隊探知機を起動しても\\n警告だらけ",
   "en": "",
   "op": "0x62",
   "msg": "0x19fb"
  },
  {
   "id": "m_009001:0x1c674",
   "off": 116340,
   "max": 52,
   "kind": "dialogue",
   "jp": "楽器を弾いているのが\\n見つかろうものなら\\n即御用",
   "en": "",
   "op": "0x62",
   "msg": "0x19fc"
  },
  {
   "id": "m_009001:0x1c6b8",
   "off": 116408,
   "max": 32,
   "kind": "dialogue",
   "jp": "その場で\\n斬り捨て御免ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x19fd"
  },
  {
   "id": "m_009001:0x1d12c",
   "off": 119084,
   "max": 28,
   "kind": "dialogue",
   "jp": "でも　わしは\\n歌いたい",
   "en": "",
   "op": "0x62",
   "msg": "0x19fe"
  },
  {
   "id": "m_009001:0x1d160",
   "off": 119136,
   "max": 56,
   "kind": "dialogue",
   "jp": "井伊の天歌で\\n抑えつけられていた間\\nずっと歌えなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x19ff"
  },
  {
   "id": "m_009001:0x1d1a8",
   "off": 119208,
   "max": 40,
   "kind": "dialogue",
   "jp": "魂が解放されて\\n改めて強く思ったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a00"
  },
  {
   "id": "m_009001:0x1d1e0",
   "off": 119264,
   "max": 64,
   "kind": "dialogue",
   "jp": "わしが生きるということは\\n歌うこと　そのものだって\\nことを！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a01"
  },
  {
   "id": "m_009001:0x1d230",
   "off": 119344,
   "max": 48,
   "kind": "dialogue",
   "jp": "思い切り歌わなくちゃ\\n魂が破裂してしまうぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a02"
  },
  {
   "id": "m_009001:0x1d9f4",
   "off": 121332,
   "max": 40,
   "kind": "dialogue",
   "jp": "気持ちは　わからなくも\\nないんだけど",
   "en": "",
   "op": "0x62",
   "msg": "0x1a03"
  },
  {
   "id": "m_009001:0x1e0b8",
   "off": 123064,
   "max": 20,
   "kind": "dialogue",
   "jp": "……参りましたね",
   "en": "",
   "op": "0x62",
   "msg": "0x1a04"
  },
  {
   "id": "m_009001:0x1e0dc",
   "off": 123100,
   "max": 68,
   "kind": "dialogue",
   "jp": "歌えないということが\\nこれほどまでに　心に\\n負担を掛けるとは……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a05"
  },
  {
   "id": "m_009001:0x1e130",
   "off": 123184,
   "max": 64,
   "kind": "dialogue",
   "jp": "龍馬くんは　この調子\\nですし　晋作もあんな\\n風になってしまうし",
   "en": "",
   "op": "0x62",
   "msg": "0x1a06"
  },
  {
   "id": "m_009001:0x1e7b8",
   "off": 124856,
   "max": 40,
   "kind": "dialogue",
   "jp": "ん？\\nシンディが　どうか\\nしたのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a07"
  },
  {
   "id": "m_009001:0x1ef70",
   "off": 126832,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ふぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a08"
  },
  {
   "id": "m_009001:0x1f61c",
   "off": 128540,
   "max": 52,
   "kind": "dialogue",
   "jp": "あれ　シンディ？\\n元気がなさそうだな\\n大丈夫か？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a09"
  },
  {
   "id": "m_009001:0x1fcec",
   "off": 130284,
   "max": 12,
   "kind": "dialogue",
   "jp": "……はぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a0a"
  },
  {
   "id": "m_009001:0x20174",
   "off": 131444,
   "max": 28,
   "kind": "dialogue",
   "jp": "おーーい\\n聞こえとるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a0b"
  },
  {
   "id": "m_009001:0x20618",
   "off": 132632,
   "max": 16,
   "kind": "dialogue",
   "jp": "……ふぅぅぅぅ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a0c"
  },
  {
   "id": "m_009001:0x20cc4",
   "off": 134340,
   "max": 36,
   "kind": "dialogue",
   "jp": "心ここにあらずとでも\\n言うのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a0d"
  },
  {
   "id": "m_009001:0x20cf8",
   "off": 134392,
   "max": 40,
   "kind": "dialogue",
   "jp": "高杉は　ここ数日\\nずっとこんな感じだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a0e"
  },
  {
   "id": "m_009001:0x21360",
   "off": 136032,
   "max": 52,
   "kind": "dialogue",
   "jp": "話し掛けても\\n溜息ばっかで\\n張り合いがないんだよね",
   "en": "",
   "op": "0x62",
   "msg": "0x1a0f"
  },
  {
   "id": "m_009001:0x213a4",
   "off": 136100,
   "max": 32,
   "kind": "dialogue",
   "jp": "まるで\\n泰平化した人みたいだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a10"
  },
  {
   "id": "m_009001:0x21ba4",
   "off": 138148,
   "max": 60,
   "kind": "dialogue",
   "jp": "ちょっ　ソウちん\\nそらぁ冗談でも笑えない\\nなあ　シンディ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a11"
  },
  {
   "id": "m_009001:0x2228c",
   "off": 139916,
   "max": 16,
   "kind": "dialogue",
   "jp": "……はぁぁぁぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a12"
  },
  {
   "id": "m_009001:0x22a88",
   "off": 141960,
   "max": 68,
   "kind": "dialogue",
   "jp": "ま　まさかシンディ\\n本当に泰平化されたのか？\\nだけど　どこで……？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a13"
  },
  {
   "id": "m_009001:0x22f48",
   "off": 143176,
   "max": 16,
   "kind": "dialogue",
   "jp": "……うぅぅぅん",
   "en": "",
   "op": "0x62",
   "msg": "0x1a14"
  },
  {
   "id": "m_009001:0x233dc",
   "off": 144348,
   "max": 52,
   "kind": "dialogue",
   "jp": "やっぱり反応がない\\nど　どうすれば\\nいいんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a15"
  },
  {
   "id": "m_009001:0x237a4",
   "off": 145316,
   "max": 20,
   "kind": "choice",
   "jp": "土方の判断を仰ぐ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_009001:0x237c4",
   "off": 145348,
   "max": 20,
   "kind": "choice",
   "jp": "沖田の判断を仰ぐ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_009001:0x237e4",
   "off": 145380,
   "max": 20,
   "kind": "choice",
   "jp": "高杉の判断を仰ぐ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_009001:0x23fec",
   "off": 147436,
   "max": 44,
   "kind": "dialogue",
   "jp": "ヒジゾーさん\\nお前さんの知恵を\\n貸してくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a16"
  },
  {
   "id": "m_009001:0x24028",
   "off": 147496,
   "max": 44,
   "kind": "dialogue",
   "jp": "今　頼りになるのは\\nヒジゾーさんだけじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a17"
  },
  {
   "id": "m_009001:0x24698",
   "off": 149144,
   "max": 60,
   "kind": "dialogue",
   "jp": "俺は医者じゃないんだ\\nどうすれば良いのか\\nさっぱりわからん",
   "en": "",
   "op": "0x62",
   "msg": "0x1a18"
  },
  {
   "id": "m_009001:0x24eb0",
   "off": 151216,
   "max": 36,
   "kind": "dialogue",
   "jp": "えーと……みんな\\n心配はいらないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a19"
  },
  {
   "id": "m_009001:0x25934",
   "off": 153908,
   "max": 32,
   "kind": "dialogue",
   "jp": "ソウちん！\\nなんとかしてくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a1a"
  },
  {
   "id": "m_009001:0x2596c",
   "off": 153964,
   "max": 52,
   "kind": "dialogue",
   "jp": "シンディの元気を\\n取り戻すには\\nどうすればいい？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a1b"
  },
  {
   "id": "m_009001:0x25fe0",
   "off": 155616,
   "max": 36,
   "kind": "dialogue",
   "jp": "えーと\\nこういう時の\\n対処法は……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a1c"
  },
  {
   "id": "m_009001:0x260b4",
   "off": 155828,
   "max": 40,
   "kind": "dialogue",
   "jp": "鳴かぬなら\\n殺してしまえ\\nホトトギス",
   "en": "",
   "op": "0x62",
   "msg": "0x1a1d"
  },
  {
   "id": "m_009001:0x26184",
   "off": 156036,
   "max": 28,
   "kind": "dialogue",
   "jp": "ってことで\\nいいのかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a1e"
  },
  {
   "id": "m_009001:0x2687c",
   "off": 157820,
   "max": 24,
   "kind": "dialogue",
   "jp": "ちょっ\\nよくないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a1f"
  },
  {
   "id": "m_009001:0x26e34",
   "off": 159284,
   "max": 36,
   "kind": "dialogue",
   "jp": "役に立たないなら\\n斬って捨てるのが",
   "en": "",
   "op": "0x62",
   "msg": "0x1a20"
  },
  {
   "id": "m_009001:0x26e68",
   "off": 159336,
   "max": 32,
   "kind": "dialogue",
   "jp": "面倒がないと\\n思ったんだけど",
   "en": "",
   "op": "0x62",
   "msg": "0x1a21"
  },
  {
   "id": "m_009001:0x27304",
   "off": 160516,
   "max": 16,
   "kind": "dialogue",
   "jp": "そ　そんな～",
   "en": "",
   "op": "0x62",
   "msg": "0x1a22"
  },
  {
   "id": "m_009001:0x27af0",
   "off": 162544,
   "max": 40,
   "kind": "dialogue",
   "jp": "えーと……龍馬くん\\n心配はいらないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a23"
  },
  {
   "id": "m_009001:0x28524",
   "off": 165156,
   "max": 48,
   "kind": "dialogue",
   "jp": "シンディ\\nわしは一体どうすれば\\nいいんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a24"
  },
  {
   "id": "m_009001:0x28b98",
   "off": 166808,
   "max": 16,
   "kind": "dialogue",
   "jp": "……はぁぁぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a25"
  },
  {
   "id": "m_009001:0x29078",
   "off": 168056,
   "max": 36,
   "kind": "dialogue",
   "jp": "溜息だけじゃ\\n何もわからんぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a26"
  },
  {
   "id": "m_009001:0x29880",
   "off": 170112,
   "max": 40,
   "kind": "dialogue",
   "jp": "えーと……龍馬くん\\n心配はいらないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a27"
  },
  {
   "id": "m_009001:0x29e40",
   "off": 171584,
   "max": 48,
   "kind": "dialogue",
   "jp": "心配いらないって\\nどういうことぜよ\\nセンセー",
   "en": "",
   "op": "0x62",
   "msg": "0x1a28"
  },
  {
   "id": "m_009001:0x2a2ec",
   "off": 172780,
   "max": 60,
   "kind": "dialogue",
   "jp": "晋作――というか\\n私達は　松陰先生から\\n認められたでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x1a29"
  },
  {
   "id": "m_009001:0x2a338",
   "off": 172856,
   "max": 24,
   "kind": "dialogue",
   "jp": "すでに一人前の志士だと",
   "en": "",
   "op": "0x62",
   "msg": "0x1a2a"
  },
  {
   "id": "m_009001:0x2a864",
   "off": 174180,
   "max": 64,
   "kind": "dialogue",
   "jp": "シンディが　あんな風に\\nなってしまったのは\\nそのせいなのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a2b"
  },
  {
   "id": "m_009001:0x2ae90",
   "off": 175760,
   "max": 60,
   "kind": "dialogue",
   "jp": "晋作は　褒められると\\nどうしていいか\\nわからなくなるんです",
   "en": "",
   "op": "0x62",
   "msg": "0x1a2c"
  },
  {
   "id": "m_009001:0x2b6d8",
   "off": 177880,
   "max": 8,
   "kind": "dialogue",
   "jp": "へ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a2d"
  },
  {
   "id": "m_009001:0x2be00",
   "off": 179712,
   "max": 36,
   "kind": "dialogue",
   "jp": "百点満点の試験で\\n九十八点を取れば",
   "en": "",
   "op": "0x62",
   "msg": "0x1a2e"
  },
  {
   "id": "m_009001:0x2be34",
   "off": 179764,
   "max": 52,
   "kind": "dialogue",
   "jp": "間違えた二点を\\n埋めるために\\n猛練習するんですが",
   "en": "",
   "op": "0x62",
   "msg": "0x1a2f"
  },
  {
   "id": "m_009001:0x2be78",
   "off": 179832,
   "max": 52,
   "kind": "dialogue",
   "jp": "百点を取ってしまうと\\n目標を見失うらしいん\\nですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a30"
  },
  {
   "id": "m_009001:0x2bebc",
   "off": 179900,
   "max": 64,
   "kind": "dialogue",
   "jp": "目標だった松陰先生に\\n認められて　途方に\\n暮れちゃったんです",
   "en": "",
   "op": "0x62",
   "msg": "0x1a31"
  },
  {
   "id": "m_009001:0x2c598",
   "off": 181656,
   "max": 16,
   "kind": "dialogue",
   "jp": "……はぁぁぁぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a32"
  },
  {
   "id": "m_009001:0x2ce08",
   "off": 183816,
   "max": 28,
   "kind": "dialogue",
   "jp": "あはははは\\n可愛いじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x1a33"
  },
  {
   "id": "m_009001:0x2d54c",
   "off": 185676,
   "max": 60,
   "kind": "dialogue",
   "jp": "いつもなら\\nベースを弾いていれば\\n気も晴れるんでしょうけど",
   "en": "",
   "op": "0x62",
   "msg": "0x1a34"
  },
  {
   "id": "m_009001:0x2d598",
   "off": 185752,
   "max": 40,
   "kind": "dialogue",
   "jp": "今は練習も満足に\\nできませんから……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a35"
  },
  {
   "id": "m_009001:0x2dc5c",
   "off": 187484,
   "max": 40,
   "kind": "dialogue",
   "jp": "素直に喜べばいいものを\\n面倒な性格だな",
   "en": "",
   "op": "0x62",
   "msg": "0x1a36"
  },
  {
   "id": "m_009001:0x2e2cc",
   "off": 189132,
   "max": 32,
   "kind": "dialogue",
   "jp": "は？\\n土方さんが\\nそれを言う？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a37"
  },
  {
   "id": "m_009001:0x2e80c",
   "off": 190476,
   "max": 52,
   "kind": "dialogue",
   "jp": "……なんだ　総司\\n言いたいことが\\nありそうだな？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a38"
  },
  {
   "id": "m_009001:0x2ed54",
   "off": 191828,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方さんこそ　だいたい\\nスカシくんと同じじゃ\\nないですかぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a39"
  },
  {
   "id": "m_009001:0x2f214",
   "off": 193044,
   "max": 24,
   "kind": "dialogue",
   "jp": "む……\\n似てなどいない",
   "en": "",
   "op": "0x62",
   "msg": "0x1a3a"
  },
  {
   "id": "m_009001:0x2f818",
   "off": 194584,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方さんは　準備に時間を\\nかけるんですよ\\n完璧主義だから",
   "en": "",
   "op": "0x62",
   "msg": "0x1a3b"
  },
  {
   "id": "m_009001:0x2f864",
   "off": 194660,
   "max": 32,
   "kind": "dialogue",
   "jp": "何度も何度も\\n稽古を繰り返して",
   "en": "",
   "op": "0x62",
   "msg": "0x1a3c"
  },
  {
   "id": "m_009001:0x2f894",
   "off": 194708,
   "max": 64,
   "kind": "dialogue",
   "jp": "失敗したら\\nこんな舞台を　近藤さんに\\n見せられるかーっ！　って",
   "en": "",
   "op": "0x62",
   "msg": "0x1a3d"
  },
  {
   "id": "m_009001:0x2f97c",
   "off": 194940,
   "max": 48,
   "kind": "dialogue",
   "jp": "そこまでは\\n元気がいいんです\\n問題はそのあと",
   "en": "",
   "op": "0x62",
   "msg": "0x1a3e"
  },
  {
   "id": "m_009001:0x2fa54",
   "off": 195156,
   "max": 68,
   "kind": "dialogue",
   "jp": "ようやく本番が終わって\\n近藤さんに　よくやったぞ\\nって言われるまで",
   "en": "",
   "op": "0x62",
   "msg": "0x1a3f"
  },
  {
   "id": "m_009001:0x2faa8",
   "off": 195240,
   "max": 44,
   "kind": "dialogue",
   "jp": "石を口に詰め込んだ\\nみたいな顔してるんです",
   "en": "",
   "op": "0x62",
   "msg": "0x1a40"
  },
  {
   "id": "m_009001:0x3015c",
   "off": 196956,
   "max": 40,
   "kind": "dialogue",
   "jp": "それが　近藤さんに\\n褒められると――",
   "en": "",
   "op": "0x62",
   "msg": "0x1a41"
  },
  {
   "id": "m_009001:0x30b84",
   "off": 199556,
   "max": 64,
   "kind": "dialogue",
   "jp": "いったーい\\n舌を噛むところだったじゃ\\nないですか　土方さん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a42"
  },
  {
   "id": "m_009001:0x31208",
   "off": 201224,
   "max": 68,
   "kind": "dialogue",
   "jp": "いっそのこと　少し短く\\nなった方が口数が減って\\n良かったかもしれん",
   "en": "",
   "op": "0x62",
   "msg": "0x1a43"
  },
  {
   "id": "m_009001:0x31ca8",
   "off": 203944,
   "max": 56,
   "kind": "dialogue",
   "jp": "……うるせえ！\\nオレ様の耳元で\\nギャンギャン騒ぐな！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a44"
  },
  {
   "id": "m_009001:0x324f0",
   "off": 206064,
   "max": 16,
   "kind": "dialogue",
   "jp": "お？\\n反応した",
   "en": "",
   "op": "0x62",
   "msg": "0x1a45"
  },
  {
   "id": "m_009001:0x32abc",
   "off": 207548,
   "max": 56,
   "kind": "dialogue",
   "jp": "沖田　言っておくが\\nオレ様は土方みたいに\\n弱虫じゃねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a46"
  },
  {
   "id": "m_009001:0x33464",
   "off": 210020,
   "max": 60,
   "kind": "dialogue",
   "jp": "高杉　それは俺の台詞だ\\nお前みたいな腰抜けと\\n一緒にするな",
   "en": "",
   "op": "0x62",
   "msg": "0x1a47"
  },
  {
   "id": "m_009001:0x34174",
   "off": 213364,
   "max": 32,
   "kind": "dialogue",
   "jp": "何だとぉ？\\nやんのか　てめぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a48"
  },
  {
   "id": "m_009001:0x347ac",
   "off": 214956,
   "max": 44,
   "kind": "dialogue",
   "jp": "お前がそのつもりなら\\n相手になってもいいぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a49"
  },
  {
   "id": "m_009001:0x35348",
   "off": 217928,
   "max": 52,
   "kind": "dialogue",
   "jp": "ちょっと　ちょっと\\n晋作も　土方さんも\\n落ち着いて",
   "en": "",
   "op": "0x62",
   "msg": "0x1a4a"
  },
  {
   "id": "m_009001:0x35a1c",
   "off": 219676,
   "max": 32,
   "kind": "dialogue",
   "jp": "やれやれー！\\nもっとやれー！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a4b"
  },
  {
   "id": "m_009001:0x360e4",
   "off": 221412,
   "max": 28,
   "kind": "dialogue",
   "jp": "沖田くんも\\nけしかけない！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a4c"
  },
  {
   "id": "m_009001:0x36684",
   "off": 222852,
   "max": 72,
   "kind": "dialogue",
   "jp": "火花を散らす高杉と土方\\nしかし　すぐにどちらから\\nともなく　拳を引いた",
   "en": "",
   "op": "0x62",
   "msg": "0x1a4d"
  },
  {
   "id": "m_009001:0x36b2c",
   "off": 224044,
   "max": 56,
   "kind": "dialogue",
   "jp": "すまん　桂\\n俺ともあろう者が\\n少し気が立っていたようだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a4e"
  },
  {
   "id": "m_009001:0x371a8",
   "off": 225704,
   "max": 64,
   "kind": "dialogue",
   "jp": "ちっ　ここで土方と\\n殴り合ったって\\n気分が晴れるわけでもねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a4f"
  },
  {
   "id": "m_009001:0x37970",
   "off": 227696,
   "max": 68,
   "kind": "dialogue",
   "jp": "やはり　雷舞ができない\\nという状況は厳しいですね\\n八方塞がりか……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a50"
  },
  {
   "id": "m_009001:0x38064",
   "off": 229476,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしは　シンディや\\nセンセー　みんなと\\n出会って",
   "en": "",
   "op": "0x62",
   "msg": "0x1a51"
  },
  {
   "id": "m_009001:0x380a8",
   "off": 229544,
   "max": 40,
   "kind": "dialogue",
   "jp": "歌うことの意義を\\n見出すことができた",
   "en": "",
   "op": "0x62",
   "msg": "0x1a52"
  },
  {
   "id": "m_009001:0x38758",
   "off": 231256,
   "max": 80,
   "kind": "dialogue",
   "jp": "歌うことで　泰平化された\\nみんなを元に戻して　自由に\\n歌える世界を取り戻す――",
   "en": "",
   "op": "0x62",
   "msg": "0x1a53"
  },
  {
   "id": "m_009001:0x387b8",
   "off": 231352,
   "max": 60,
   "kind": "dialogue",
   "jp": "幕府の横暴を打ち破るには\\nわしらが歌うしかない\\n違うか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a54"
  },
  {
   "id": "m_009001:0x38804",
   "off": 231428,
   "max": 60,
   "kind": "dialogue",
   "jp": "そのわしが　今は\\n幕府を恐れて　歌えない\\n何か間違っとる！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a55"
  },
  {
   "id": "m_009001:0x38f60",
   "off": 233312,
   "max": 12,
   "kind": "dialogue",
   "jp": "しかし……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a56"
  },
  {
   "id": "m_009001:0x39658",
   "off": 235096,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしは　歌わなくちゃ\\nならないんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a57"
  },
  {
   "id": "m_009001:0x39b04",
   "off": 236292,
   "max": 24,
   "kind": "dialogue",
   "jp": "ならば\\n歌ってみるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a58"
  },
  {
   "id": "m_009001:0x3a57c",
   "off": 238972,
   "max": 8,
   "kind": "dialogue",
   "jp": "誰だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a59"
  },
  {
   "id": "m_009001:0x3aa98",
   "off": 240280,
   "max": 60,
   "kind": "dialogue",
   "jp": "突然割り込んできた\\n聞き覚えのない声に\\n全員が身を硬くする",
   "en": "",
   "op": "0x62",
   "msg": "0x1a5a"
  },
  {
   "id": "m_009001:0x3b19c",
   "off": 242076,
   "max": 60,
   "kind": "dialogue",
   "jp": "すまん　すまん\\n驚かせる気はなかった\\nまあ　落ち着いてくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a5b"
  },
  {
   "id": "m_009001:0x3b78c",
   "off": 243596,
   "max": 60,
   "kind": "dialogue",
   "jp": "声の主は　暗闇から\\n姿を現すと　龍馬達の\\n前まで進み出る",
   "en": "",
   "op": "0x62",
   "msg": "0x1a5c"
  },
  {
   "id": "m_009001:0x3b7d8",
   "off": 243672,
   "max": 68,
   "kind": "dialogue",
   "jp": "その露わになった男の\\n顔を見て龍馬　高杉\\n桂は　あっと声を上げた",
   "en": "",
   "op": "0x62",
   "msg": "0x1a5d"
  },
  {
   "id": "m_009001:0x3bd84",
   "off": 245124,
   "max": 76,
   "kind": "dialogue",
   "jp": "お前さん　いつもわしらの\\n雷舞に来てくれる　贔屓の\\nお武家さんじゃないか",
   "en": "",
   "op": "0x62",
   "msg": "0x1a5e"
  },
  {
   "id": "m_009001:0x3c4b4",
   "off": 246964,
   "max": 72,
   "kind": "dialogue",
   "jp": "そうだ　間違いない\\nオレ様達の雷舞を\\n毎日のように\\n見に来ていた男だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a5f"
  },
  {
   "id": "m_009001:0x3cb98",
   "off": 248728,
   "max": 48,
   "kind": "dialogue",
   "jp": "私も見覚えがあります\\nでも　どうしてここに？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a60"
  },
  {
   "id": "m_009001:0x3d34c",
   "off": 250700,
   "max": 52,
   "kind": "dialogue",
   "jp": "わはははは\\n覚えていてくれたとは\\n嬉しい限りだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a61"
  },
  {
   "id": "m_009001:0x3d894",
   "off": 252052,
   "max": 52,
   "kind": "dialogue",
   "jp": "自己紹介しておこう\\n俺は\\fnt1勝海舟\\fnt0という者だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a62"
  },
  {
   "id": "m_009001:0x3e0ac",
   "off": 254124,
   "max": 8,
   "kind": "dialogue",
   "jp": "……！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a63"
  },
  {
   "id": "m_009001:0x3e53c",
   "off": 255292,
   "max": 24,
   "kind": "dialogue",
   "jp": "\\fnt1勝海舟だと？\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x1a65"
  },
  {
   "id": "m_009001:0x3e9d0",
   "off": 256464,
   "max": 68,
   "kind": "dialogue",
   "jp": "確か徳川幕府に　似た\\n名前の老中がいたような\\n気がするんですが……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a66"
  },
  {
   "id": "m_009001:0x3ea24",
   "off": 256548,
   "max": 12,
   "kind": "dialogue",
   "jp": "まさかね",
   "en": "",
   "op": "0x62",
   "msg": "0x1a67"
  },
  {
   "id": "m_009001:0x3f1b4",
   "off": 258484,
   "max": 36,
   "kind": "dialogue",
   "jp": "ああ　そうだ\\nその老中の勝海舟だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a68"
  },
  {
   "id": "m_009001:0x3fa38",
   "off": 260664,
   "max": 12,
   "kind": "dialogue",
   "jp": "ええっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a69"
  },
  {
   "id": "m_009001:0x3ff60",
   "off": 261984,
   "max": 44,
   "kind": "dialogue",
   "jp": "勝海舟が頷いた瞬間\\n場の空気が凍りついた",
   "en": "",
   "op": "0x62",
   "msg": "0x1a6a"
  },
  {
   "id": "m_009001:0x403d0",
   "off": 263120,
   "max": 48,
   "kind": "dialogue",
   "jp": "幕府の要人が　なぜ？\\n我々を捕らえに来たのか",
   "en": "",
   "op": "0x62",
   "msg": "0x1a6b"
  },
  {
   "id": "m_009001:0x40a40",
   "off": 264768,
   "max": 56,
   "kind": "dialogue",
   "jp": "いや　違う違う\\n確かに俺は幕府の老中だが\\nそうじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x1a6c"
  },
  {
   "id": "m_009001:0x40a88",
   "off": 264840,
   "max": 68,
   "kind": "dialogue",
   "jp": "少なくとも　お前達を\\n捕まえようなんざ\\nこれっぽっちも思ってねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a6d"
  },
  {
   "id": "m_009001:0x40f48",
   "off": 266056,
   "max": 20,
   "kind": "dialogue",
   "jp": "では\\nなにをしに？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a6e"
  },
  {
   "id": "m_009001:0x413a0",
   "off": 267168,
   "max": 52,
   "kind": "dialogue",
   "jp": "その土方の問いに\\n勝は目を細めると\\n柔和に微笑んだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a6f"
  },
  {
   "id": "m_009001:0x41a6c",
   "off": 268908,
   "max": 44,
   "kind": "dialogue",
   "jp": "桂小五郎\\n高杉晋作\\nそして　坂本龍馬……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a70"
  },
  {
   "id": "m_009001:0x41aa8",
   "off": 268968,
   "max": 32,
   "kind": "dialogue",
   "jp": "お前達が\\nショウの弟子なんだな",
   "en": "",
   "op": "0x62",
   "msg": "0x1a71"
  },
  {
   "id": "m_009001:0x421e8",
   "off": 270824,
   "max": 60,
   "kind": "dialogue",
   "jp": "ショウだって？\\n松陰先生のことを\\nそう呼ぶってことは……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a72"
  },
  {
   "id": "m_009001:0x42864",
   "off": 272484,
   "max": 52,
   "kind": "dialogue",
   "jp": "俺も　かつてショウと\\n共にロックを追求したもんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a73"
  },
  {
   "id": "m_009001:0x42f30",
   "off": 274224,
   "max": 48,
   "kind": "dialogue",
   "jp": "ロック\\nお前さんも　わしらと同じ\\n志士か",
   "en": "",
   "op": "0x62",
   "msg": "0x1a74"
  },
  {
   "id": "m_009001:0x433dc",
   "off": 275420,
   "max": 40,
   "kind": "dialogue",
   "jp": "そうだ\\nあの頃は　カイと\\n呼ばれていた",
   "en": "",
   "op": "0x62",
   "msg": "0x1a75"
  },
  {
   "id": "m_009001:0x43918",
   "off": 276760,
   "max": 36,
   "kind": "dialogue",
   "jp": "おお\\nセンセーの先生の\\n仲間か",
   "en": "",
   "op": "0x62",
   "msg": "0x1a76"
  },
  {
   "id": "m_009001:0x43db8",
   "off": 277944,
   "max": 68,
   "kind": "dialogue",
   "jp": "ふむ　お前が持ってるのは\\nショウのギターだな\\nちょっと貸してくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a77"
  },
  {
   "id": "m_009001:0x44318",
   "off": 279320,
   "max": 24,
   "kind": "dialogue",
   "jp": "む？\\nいいぜよ\\nほれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a78"
  },
  {
   "id": "m_009001:0x449dc",
   "off": 281052,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬　先生の宝を\\nやすやすと貸すんじゃ――",
   "en": "",
   "op": "0x62",
   "msg": "0x1a79"
  },
  {
   "id": "m_009001:0x457b4",
   "off": 284596,
   "max": 12,
   "kind": "dialogue",
   "jp": "なっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a7a"
  },
  {
   "id": "m_009001:0x45c70",
   "off": 285808,
   "max": 28,
   "kind": "dialogue",
   "jp": "勝が披露した\\nたった一小節",
   "en": "",
   "op": "0x62",
   "msg": "0x1a7b"
  },
  {
   "id": "m_009001:0x45c9c",
   "off": 285852,
   "max": 72,
   "kind": "dialogue",
   "jp": "それだけで松陰と\\n同じロックの魂が\\nそこにあることが\\n誰にも理解できた",
   "en": "",
   "op": "0x62",
   "msg": "0x1a7c"
  },
  {
   "id": "m_009001:0x46124",
   "off": 287012,
   "max": 64,
   "kind": "dialogue",
   "jp": "ショウは晩年　超魂を\\n追い求めて　全国を\\n駆けずり回っていたが",
   "en": "",
   "op": "0x62",
   "msg": "0x1a7d"
  },
  {
   "id": "m_009001:0x46174",
   "off": 287092,
   "max": 56,
   "kind": "dialogue",
   "jp": "あいつは　いつだって\\nお前達のことを\\n気に掛けていたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a7e"
  },
  {
   "id": "m_009001:0x461bc",
   "off": 287164,
   "max": 56,
   "kind": "dialogue",
   "jp": "自分にもしものことが\\nあれば弟子達を頼む……\\nともな",
   "en": "",
   "op": "0x62",
   "msg": "0x1a7f"
  },
  {
   "id": "m_009001:0x46838",
   "off": 288824,
   "max": 12,
   "kind": "dialogue",
   "jp": "先生……",
   "en": "",
   "op": "0x62",
   "msg": "0x1a80"
  },
  {
   "id": "m_009001:0x46cc0",
   "off": 289984,
   "max": 48,
   "kind": "dialogue",
   "jp": "おっと　そうだ\\n今　この周囲に\\n見回りはいない",
   "en": "",
   "op": "0x62",
   "msg": "0x1a81"
  },
  {
   "id": "m_009001:0x47204",
   "off": 291332,
   "max": 40,
   "kind": "dialogue",
   "jp": "先に言っておくべき\\nだったな　ははは",
   "en": "",
   "op": "0x62",
   "msg": "0x1a82"
  },
  {
   "id": "m_009001:0x47bf0",
   "off": 293872,
   "max": 72,
   "kind": "dialogue",
   "jp": "桂が　慌てて\\n見回り隊探知機を\\n覗き込むが\\nそこには一切の\\n反応はない",
   "en": "",
   "op": "0x62",
   "msg": "0x1a83"
  },
  {
   "id": "m_009001:0x47c48",
   "off": 293960,
   "max": 44,
   "kind": "dialogue",
   "jp": "恐らく勝が\\n警備体制を\\n指示したのだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x1a84"
  },
  {
   "id": "m_009001:0x48440",
   "off": 296000,
   "max": 36,
   "kind": "dialogue",
   "jp": "ほれ　返すぜ\\n大事にしろよ\\n坂本",
   "en": "",
   "op": "0x62",
   "msg": "0x1a85"
  },
  {
   "id": "m_009001:0x48af0",
   "off": 297712,
   "max": 60,
   "kind": "dialogue",
   "jp": "ロックを愛する人なら\\n疑うことなんか\\nひとつもないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a86"
  },
  {
   "id": "m_009001:0x493f4",
   "off": 300020,
   "max": 28,
   "kind": "dialogue",
   "jp": "土方さん\\nどう思います？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a87"
  },
  {
   "id": "m_009001:0x4988c",
   "off": 301196,
   "max": 28,
   "kind": "dialogue",
   "jp": "様子を見ても\\nいいだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x1a88"
  },
  {
   "id": "m_009001:0x49d24",
   "off": 302372,
   "max": 72,
   "kind": "dialogue",
   "jp": "土方さんも　甘いなぁ\\n面倒になりそうだから\\n殺しちゃった方が早いのに",
   "en": "",
   "op": "0x62",
   "msg": "0x1a89"
  },
  {
   "id": "m_009001:0x4a1e8",
   "off": 303592,
   "max": 20,
   "kind": "dialogue",
   "jp": "総司\\nやめておけ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a8a"
  },
  {
   "id": "m_009001:0x4a980",
   "off": 305536,
   "max": 44,
   "kind": "dialogue",
   "jp": "そっちは　元新選組の\\n土方歳三と沖田総司か",
   "en": "",
   "op": "0x62",
   "msg": "0x1a8b"
  },
  {
   "id": "m_009001:0x4ad58",
   "off": 306520,
   "max": 52,
   "kind": "dialogue",
   "jp": "勝は\\n値踏みするように\\n土方と沖田の\\n顔を覗き込む",
   "en": "",
   "op": "0x62",
   "msg": "0x1a8c"
  },
  {
   "id": "m_009001:0x4ad9c",
   "off": 306588,
   "max": 60,
   "kind": "dialogue",
   "jp": "その鋭い眼光に\\n沖田すら　直立不動で\\n息を呑むしかなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x1a8d"
  },
  {
   "id": "m_009001:0x4b2ec",
   "off": 307948,
   "max": 64,
   "kind": "dialogue",
   "jp": "……なるほど\\nいい面構えをしている\\n骨のある志士になりそうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a8e"
  },
  {
   "id": "m_009001:0x4ba94",
   "off": 309908,
   "max": 28,
   "kind": "dialogue",
   "jp": "あ　ありがとう\\nございます",
   "en": "",
   "op": "0x62",
   "msg": "0x1a8f"
  },
  {
   "id": "m_009001:0x4c238",
   "off": 311864,
   "max": 68,
   "kind": "dialogue",
   "jp": "あんた――いや勝先生が\\n松陰先生の仲間だったって\\nことはわかった",
   "en": "",
   "op": "0x62",
   "msg": "0x1a90"
  },
  {
   "id": "m_009001:0x4c28c",
   "off": 311948,
   "max": 28,
   "kind": "dialogue",
   "jp": "で　俺達に\\n何の用事だ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a91"
  },
  {
   "id": "m_009001:0x4c904",
   "off": 313604,
   "max": 20,
   "kind": "dialogue",
   "jp": "いいか\\nよく聞け",
   "en": "",
   "op": "0x62",
   "msg": "0x1a92"
  },
  {
   "id": "m_009001:0x4cd94",
   "off": 314772,
   "max": 12,
   "kind": "dialogue",
   "jp": "……ごくり",
   "en": "",
   "op": "0x62",
   "msg": "0x1a93"
  },
  {
   "id": "m_009001:0x4d14c",
   "off": 315724,
   "max": 32,
   "kind": "dialogue",
   "jp": "全員の視線が\\n勝に集中する――",
   "en": "",
   "op": "0x62",
   "msg": "0x1a94"
  },
  {
   "id": "m_009001:0x4d8ac",
   "off": 317612,
   "max": 28,
   "kind": "dialogue",
   "jp": "\\fnt1おい\\nおっさん！\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x1a95"
  },
  {
   "id": "m_009001:0x4dfd8",
   "off": 319448,
   "max": 56,
   "kind": "dialogue",
   "jp": "いやあ　悪い悪い\\nしかし　話をするにも腹が\\n減ったな",
   "en": "",
   "op": "0x62",
   "msg": "0x1a96"
  },
  {
   "id": "m_009001:0x4e020",
   "off": 319520,
   "max": 56,
   "kind": "dialogue",
   "jp": "どこか　うまいものを\\n食わせるところは\\n知らないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a97"
  },
  {
   "id": "m_009001:0x4e6f8",
   "off": 321272,
   "max": 28,
   "kind": "dialogue",
   "jp": "それなら\\nテラーダぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1a98"
  },
  {
   "id": "m_009001:0x4edac",
   "off": 322988,
   "max": 40,
   "kind": "dialogue",
   "jp": "ほう\\nいいだろう\\n話は　そこでしよう",
   "en": "",
   "op": "0x62",
   "msg": "0x1a99"
  },
  {
   "id": "m_009001:0x4f478",
   "off": 324728,
   "max": 36,
   "kind": "dialogue",
   "jp": "ですが　勝先生\\n私達はお尋ね者です",
   "en": "",
   "op": "0x62",
   "msg": "0x1a9a"
  },
  {
   "id": "m_009001:0x4f4ac",
   "off": 324780,
   "max": 40,
   "kind": "dialogue",
   "jp": "気軽に出歩くわけには\\nいかないんです",
   "en": "",
   "op": "0x62",
   "msg": "0x1a9b"
  },
  {
   "id": "m_009001:0x4fb6c",
   "off": 326508,
   "max": 68,
   "kind": "dialogue",
   "jp": "幕府の偉い人と一緒なら\\n見回りに見つかっても\\n平気なんじゃない？",
   "en": "",
   "op": "0x62",
   "msg": "0x1a9c"
  },
  {
   "id": "m_009001:0x501f0",
   "off": 328176,
   "max": 72,
   "kind": "dialogue",
   "jp": "おい　お前達が見回りに\\n見つかっても　俺は助ける\\n気なんぞ　ねえからな",
   "en": "",
   "op": "0x62",
   "msg": "0x1a9d"
  },
  {
   "id": "m_009001:0x50754",
   "off": 329556,
   "max": 64,
   "kind": "dialogue",
   "jp": "ええ？　だって\\nおなかが減ったって\\n言ったのはおじさんでしょ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a9e"
  },
  {
   "id": "m_009001:0x50c18",
   "off": 330776,
   "max": 32,
   "kind": "dialogue",
   "jp": "はあ\\nケツの穴の小せえ奴らだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1a9f"
  },
  {
   "id": "m_009001:0x51154",
   "off": 332116,
   "max": 12,
   "kind": "dialogue",
   "jp": "け　ケツ",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa0"
  },
  {
   "id": "m_009001:0x51b64",
   "off": 334692,
   "max": 52,
   "kind": "dialogue",
   "jp": "見回りにビビって\\nメシも食えねえようで\\n何が志士だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa1"
  },
  {
   "id": "m_009001:0x51ba8",
   "off": 334760,
   "max": 68,
   "kind": "dialogue",
   "jp": "食べたいときに食べ\\n歌いたいときに歌う！\\nそれが志士というものよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa2"
  },
  {
   "id": "m_009001:0x523b0",
   "off": 336816,
   "max": 16,
   "kind": "dialogue",
   "jp": "その通りぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa3"
  },
  {
   "id": "m_009001:0x52a58",
   "off": 338520,
   "max": 52,
   "kind": "dialogue",
   "jp": "というわけで\\nそのテラーダとやらに\\n案内してくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa4"
  },
  {
   "id": "m_009001:0x53274",
   "off": 340596,
   "max": 20,
   "kind": "dialogue",
   "jp": "……どうします？",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa5"
  },
  {
   "id": "m_009001:0x53704",
   "off": 341764,
   "max": 56,
   "kind": "dialogue",
   "jp": "お前の見回り隊探知機と\\nやらに　反応はないの\\nだろう？",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa6"
  },
  {
   "id": "m_009001:0x53bb8",
   "off": 342968,
   "max": 28,
   "kind": "dialogue",
   "jp": "それは\\nそうなんですけど",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa7"
  },
  {
   "id": "m_009001:0x54050",
   "off": 344144,
   "max": 48,
   "kind": "dialogue",
   "jp": "この様子では\\n何か食わないと\\n話が進まなそうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa8"
  },
  {
   "id": "m_009001:0x54708",
   "off": 345864,
   "max": 68,
   "kind": "dialogue",
   "jp": "仕方ありませんね\\n道中　十分気をつけて\\nテラーダへ行きましょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x1aa9"
  }
 ]
}
