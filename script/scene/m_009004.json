{
 "source": "m_009004.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_009004:0x13b8",
   "off": 5048,
   "max": 12,
   "kind": "dialogue",
   "jp": "……まるで",
   "en": "",
   "op": "0x62",
   "msg": "0x1bb6"
  },
  {
   "id": "m_009004:0x13d4",
   "off": 5076,
   "max": 40,
   "kind": "dialogue",
   "jp": "まるで　悪い夢を\\n見ていたみたいぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bb7"
  },
  {
   "id": "m_009004:0x1a40",
   "off": 6720,
   "max": 12,
   "kind": "dialogue",
   "jp": "坂本……",
   "en": "",
   "op": "0x62",
   "msg": "0x1bb8"
  },
  {
   "id": "m_009004:0x1edc",
   "off": 7900,
   "max": 48,
   "kind": "dialogue",
   "jp": "ヒジゾーさんのロック\\nガツンと魂に響いたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bb9"
  },
  {
   "id": "m_009004:0x2388",
   "off": 9096,
   "max": 48,
   "kind": "dialogue",
   "jp": "……そうか　届いたか\\nこれが俺の誠（まこと）だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bba"
  },
  {
   "id": "m_009004:0x2a54",
   "off": 10836,
   "max": 24,
   "kind": "dialogue",
   "jp": "龍馬くん\\n大丈夫かい？",
   "en": "",
   "op": "0x62",
   "msg": "0x1bbb"
  },
  {
   "id": "m_009004:0x2ee8",
   "off": 12008,
   "max": 8,
   "kind": "dialogue",
   "jp": "おう！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bbc"
  },
  {
   "id": "m_009004:0x3404",
   "off": 13316,
   "max": 68,
   "kind": "dialogue",
   "jp": "近藤のおっさんが遺した\\n想いと　ヒジゾーさんが\\n伝えてくれた誠を",
   "en": "",
   "op": "0x62",
   "msg": "0x1bbd"
  },
  {
   "id": "m_009004:0x3458",
   "off": 13400,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしの魂に　きっちり\\n刻みつけてきた",
   "en": "",
   "op": "0x62",
   "msg": "0x1bbe"
  },
  {
   "id": "m_009004:0x349c",
   "off": 13468,
   "max": 44,
   "kind": "dialogue",
   "jp": "もう　闇につけ込まれる\\nことはないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bbf"
  },
  {
   "id": "m_009004:0x3c64",
   "off": 15460,
   "max": 48,
   "kind": "dialogue",
   "jp": "信じられん\\n闇から這い上がって\\nくるとは……",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc0"
  },
  {
   "id": "m_009004:0x437c",
   "off": 17276,
   "max": 28,
   "kind": "dialogue",
   "jp": "井伊\\nもう　やめにするぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc1"
  },
  {
   "id": "m_009004:0x43a8",
   "off": 17320,
   "max": 48,
   "kind": "dialogue",
   "jp": "天歌で　人の心を\\n抑えつけて　何が\\n楽しい？",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc2"
  },
  {
   "id": "m_009004:0x43e8",
   "off": 17384,
   "max": 52,
   "kind": "dialogue",
   "jp": "天歌で　人の心を\\n操ったところで\\n虚しいだけぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc3"
  },
  {
   "id": "m_009004:0x4898",
   "off": 18584,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc4"
  },
  {
   "id": "m_009004:0x4d20",
   "off": 19744,
   "max": 24,
   "kind": "dialogue",
   "jp": "金か？\\n権力のためか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc5"
  },
  {
   "id": "m_009004:0x4d48",
   "off": 19784,
   "max": 48,
   "kind": "dialogue",
   "jp": "そんなものは\\n本当に大切なもんじゃ\\nないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc6"
  },
  {
   "id": "m_009004:0x5500",
   "off": 21760,
   "max": 32,
   "kind": "dialogue",
   "jp": "井伊大老\\nもう終わりにしよう",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc7"
  },
  {
   "id": "m_009004:0x5bd0",
   "off": 23504,
   "max": 16,
   "kind": "dialogue",
   "jp": "終わり\\nだと？",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc8"
  },
  {
   "id": "m_009004:0x6068",
   "off": 24680,
   "max": 44,
   "kind": "dialogue",
   "jp": "土方　貴様はなにか\\n勘違いをしていないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1bc9"
  },
  {
   "id": "m_009004:0x6718",
   "off": 26392,
   "max": 36,
   "kind": "dialogue",
   "jp": "土方だけではない\\n沖田も高杉も桂も",
   "en": "",
   "op": "0x62",
   "msg": "0x1bca"
  },
  {
   "id": "m_009004:0x674c",
   "off": 26444,
   "max": 28,
   "kind": "dialogue",
   "jp": "そして　坂本龍馬\\nお前もだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bcb"
  },
  {
   "id": "m_009004:0x6e84",
   "off": 28292,
   "max": 32,
   "kind": "dialogue",
   "jp": "勘違い？\\nどういうことじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1bcc"
  },
  {
   "id": "m_009004:0x76b8",
   "off": 30392,
   "max": 68,
   "kind": "dialogue",
   "jp": "何も終わってはいない！\\n慶喜様がおられる限りは\\n何も終わらぬのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bcd"
  },
  {
   "id": "m_009004:0x7f84",
   "off": 32644,
   "max": 28,
   "kind": "dialogue",
   "jp": "慶喜様？\\n将軍様のことか！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bce"
  },
  {
   "id": "m_009004:0x8ae4",
   "off": 35556,
   "max": 32,
   "kind": "dialogue",
   "jp": "天歌泰平による\\n民衆の平等……",
   "en": "",
   "op": "0x62",
   "msg": "0x1bcf"
  },
  {
   "id": "m_009004:0x8b14",
   "off": 35604,
   "max": 72,
   "kind": "dialogue",
   "jp": "それは即ち　慶喜様\\n以外の命は　全て等しく\\nゴミであるということよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd0"
  },
  {
   "id": "m_009004:0x8fd8",
   "off": 36824,
   "max": 16,
   "kind": "dialogue",
   "jp": "それは違うぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd1"
  },
  {
   "id": "m_009004:0x94b8",
   "off": 38072,
   "max": 16,
   "kind": "dialogue",
   "jp": "何も違わぬ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd2"
  },
  {
   "id": "m_009004:0x94e0",
   "off": 38112,
   "max": 64,
   "kind": "dialogue",
   "jp": "この世のあまねく全ては\\n慶喜様のためだけに\\n存在しているのだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd3"
  },
  {
   "id": "m_009004:0x999c",
   "off": 39324,
   "max": 60,
   "kind": "dialogue",
   "jp": "ゴミはゴミらしく\\n地に這いつくばれ！\\n我が天歌によって",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd4"
  },
  {
   "id": "m_009004:0x9ea8",
   "off": 40616,
   "max": 60,
   "kind": "dialogue",
   "jp": "まっ　待て　井伊\\n話せば　きっと\\nわかりあえるはずじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd5"
  },
  {
   "id": "m_009004:0xabd8",
   "off": 43992,
   "max": 40,
   "kind": "dialogue",
   "jp": "まずいっ！\\n井伊が歌い始めやがった！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd6"
  },
  {
   "id": "m_009004:0xb3e4",
   "off": 46052,
   "max": 28,
   "kind": "dialogue",
   "jp": "総司！\\n天歌を抑え込むぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd7"
  },
  {
   "id": "m_009004:0xb87c",
   "off": 47228,
   "max": 20,
   "kind": "dialogue",
   "jp": "はい\\n土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd8"
  },
  {
   "id": "m_009004:0xc018",
   "off": 49176,
   "max": 52,
   "kind": "dialogue",
   "jp": "ううう……\\n闇の力を取り込んで\\nいるだけあって……",
   "en": "",
   "op": "0x62",
   "msg": "0x1bd9"
  },
  {
   "id": "m_009004:0xc05c",
   "off": 49244,
   "max": 44,
   "kind": "dialogue",
   "jp": "なんて……重い力……\\n潰されそう……ぐうっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bda"
  },
  {
   "id": "m_009004:0xc6cc",
   "off": 50892,
   "max": 44,
   "kind": "dialogue",
   "jp": "怯むな　桂さん！\\nオレ様の歌で跳ね返す！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bdb"
  },
  {
   "id": "m_009004:0xd490",
   "off": 54416,
   "max": 44,
   "kind": "dialogue",
   "jp": "貴様達に真の平等を\\n与えるのが　我の使命",
   "en": "",
   "op": "0x62",
   "msg": "0x1bdc"
  },
  {
   "id": "m_009004:0xd4d4",
   "off": 54484,
   "max": 64,
   "kind": "dialogue",
   "jp": "人々が自分の都合で\\n好き放題していては\\n泰平の世など望めない",
   "en": "",
   "op": "0x62",
   "msg": "0x1bdd"
  },
  {
   "id": "m_009004:0xd9e4",
   "off": 55780,
   "max": 20,
   "kind": "dialogue",
   "jp": "井伊\\nそれは違う！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bde"
  },
  {
   "id": "m_009004:0xde7c",
   "off": 56956,
   "max": 56,
   "kind": "dialogue",
   "jp": "好き勝手にワガママを\\n言うのと自由にするのは\\n違う！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bdf"
  },
  {
   "id": "m_009004:0xdec4",
   "off": 57028,
   "max": 56,
   "kind": "dialogue",
   "jp": "喜びだけじゃない\\n苦しみ　悲しみ\\nそれすら分かち合って",
   "en": "",
   "op": "0x62",
   "msg": "0x1be0"
  },
  {
   "id": "m_009004:0xdf0c",
   "off": 57100,
   "max": 40,
   "kind": "dialogue",
   "jp": "みんなで前に進むのが\\n真の泰平だろう！",
   "en": "",
   "op": "0x62",
   "msg": "0x1be1"
  },
  {
   "id": "m_009004:0xe404",
   "off": 58372,
   "max": 44,
   "kind": "dialogue",
   "jp": "そんな綺麗事を認める\\nわけにはいかんのだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1be2"
  },
  {
   "id": "m_009004:0xe448",
   "off": 58440,
   "max": 60,
   "kind": "dialogue",
   "jp": "解き放たれた人々が\\n暴徒と化して　いずれは\\n戦になるだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x1be3"
  },
  {
   "id": "m_009004:0xe954",
   "off": 59732,
   "max": 20,
   "kind": "dialogue",
   "jp": "そんなことはない！",
   "en": "",
   "op": "0x62",
   "msg": "0x1be4"
  },
  {
   "id": "m_009004:0xe980",
   "off": 59776,
   "max": 68,
   "kind": "dialogue",
   "jp": "楽しく歌って過ごす方が\\n泰平だって　みんな\\nわかってるはずじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1be5"
  },
  {
   "id": "m_009004:0xee9c",
   "off": 61084,
   "max": 28,
   "kind": "dialogue",
   "jp": "思い上がるな！\\n下郎が",
   "en": "",
   "op": "0x62",
   "msg": "0x1be6"
  },
  {
   "id": "m_009004:0xeed0",
   "off": 61136,
   "max": 52,
   "kind": "dialogue",
   "jp": "我の天歌で\\n真の泰平の意味を\\n理解させてやろう！",
   "en": "",
   "op": "0x62",
   "msg": "0x1be7"
  },
  {
   "id": "m_009004:0xf8f0",
   "off": 63728,
   "max": 36,
   "kind": "dialogue",
   "jp": "それこそお前の\\n思い上がりじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1be8"
  },
  {
   "id": "m_009004:0xfd94",
   "off": 64916,
   "max": 32,
   "kind": "dialogue",
   "jp": "ぐっ……\\nすさまじい気の応酬だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1be9"
  },
  {
   "id": "m_009004:0x10234",
   "off": 66100,
   "max": 36,
   "kind": "dialogue",
   "jp": "すごいね……\\n僕達まで弾かれそうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bea"
  },
  {
   "id": "m_009004:0x106d8",
   "off": 67288,
   "max": 36,
   "kind": "dialogue",
   "jp": "くそっ\\n後れを取るなよ\\n桂さん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1beb"
  },
  {
   "id": "m_009004:0x10b7c",
   "off": 68476,
   "max": 44,
   "kind": "dialogue",
   "jp": "ぐっ\\n目眩がして息苦しい\\n晋作　龍馬くん",
   "en": "",
   "op": "0x62",
   "msg": "0x1bec"
  },
  {
   "id": "m_009004:0x11028",
   "off": 69672,
   "max": 32,
   "kind": "dialogue",
   "jp": "もう一息！\\nわしらのロックで",
   "en": "",
   "op": "0x62",
   "msg": "0x1bed"
  },
  {
   "id": "m_009004:0x114c8",
   "off": 70856,
   "max": 40,
   "kind": "dialogue",
   "jp": "我が天歌に耐えるとは\\nたいしたものだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bee"
  },
  {
   "id": "m_009004:0x11504",
   "off": 70916,
   "max": 72,
   "kind": "dialogue",
   "jp": "その気迫がいつまでもつか\\n見せてもらおうではないか\\nははっ　はははは！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bef"
  },
  {
   "id": "m_009004:0x11c00",
   "off": 72704,
   "max": 76,
   "kind": "dialogue",
   "jp": "暗く澱んだ気を放つ井伊と\\n抑え込もうとする龍馬達の\\n激しい気がぶつかり合う",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf0"
  },
  {
   "id": "m_009004:0x11c5c",
   "off": 72796,
   "max": 68,
   "kind": "dialogue",
   "jp": "そしてその歌声は\\n空気を震わせ\\n屋敷を揺らして\\n町へと轟いていった",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf1"
  },
  {
   "id": "m_009004:0x1224c",
   "off": 74316,
   "max": 24,
   "kind": "dialogue",
   "jp": "井伊\\n天歌をやめろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf2"
  },
  {
   "id": "m_009004:0x12984",
   "off": 76164,
   "max": 20,
   "kind": "dialogue",
   "jp": "今さら命乞いか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf3"
  },
  {
   "id": "m_009004:0x12fd8",
   "off": 77784,
   "max": 52,
   "kind": "dialogue",
   "jp": "とても暗いなにか……\\nイヤなものを感じるんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf4"
  },
  {
   "id": "m_009004:0x13488",
   "off": 78984,
   "max": 24,
   "kind": "dialogue",
   "jp": "つまらぬ言い掛かりだな",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf5"
  },
  {
   "id": "m_009004:0x1391c",
   "off": 80156,
   "max": 72,
   "kind": "dialogue",
   "jp": "これは　ソウちんの時と\\n同じじゃ！　歌をやめないと\\n魂を食われるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf6"
  },
  {
   "id": "m_009004:0x14260",
   "off": 82528,
   "max": 48,
   "kind": "dialogue",
   "jp": "なに……？\\nそんなはずはない\\nあれは我が……",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf7"
  },
  {
   "id": "m_009004:0x14890",
   "off": 84112,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぐぅっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf8"
  },
  {
   "id": "m_009004:0x14db8",
   "off": 85432,
   "max": 60,
   "kind": "dialogue",
   "jp": "……なんだこれは？\\n何か……が　我の魂を\\n蝕み始めている？",
   "en": "",
   "op": "0x62",
   "msg": "0x1bf9"
  },
  {
   "id": "m_009004:0x1598c",
   "off": 88460,
   "max": 24,
   "kind": "dialogue",
   "jp": "今すぐ天歌をやめろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1bfa"
  },
  {
   "id": "m_009004:0x15ebc",
   "off": 89788,
   "max": 44,
   "kind": "dialogue",
   "jp": "……敵に同情するとは\\nつくづく愚か者だな",
   "en": "",
   "op": "0x62",
   "msg": "0x1bfb"
  },
  {
   "id": "m_009004:0x16364",
   "off": 90980,
   "max": 44,
   "kind": "dialogue",
   "jp": "愚か者でも構わない！\\n天歌をやめるんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1bfc"
  },
  {
   "id": "m_009004:0x168a8",
   "off": 92328,
   "max": 48,
   "kind": "dialogue",
   "jp": "ふっ\\nこれしきのこと\\n我が力でなんとでもなる",
   "en": "",
   "op": "0x62",
   "msg": "0x1bfd"
  },
  {
   "id": "m_009004:0x16eec",
   "off": 93932,
   "max": 40,
   "kind": "dialogue",
   "jp": "化け物になって\\n命を落とすつもりか",
   "en": "",
   "op": "0x62",
   "msg": "0x1bfe"
  },
  {
   "id": "m_009004:0x173ec",
   "off": 95212,
   "max": 56,
   "kind": "dialogue",
   "jp": "それで泰平の世を\\n慶喜様の心の平穏を\\n守れるのであれば",
   "en": "",
   "op": "0x62",
   "msg": "0x1bff"
  },
  {
   "id": "m_009004:0x174e0",
   "off": 95456,
   "max": 24,
   "kind": "dialogue",
   "jp": "我が命などくれてやる！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c00"
  },
  {
   "id": "m_009004:0x179c8",
   "off": 96712,
   "max": 20,
   "kind": "dialogue",
   "jp": "ダメじゃっ\\n井伊！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c01"
  },
  {
   "id": "m_009004:0x179f4",
   "off": 96756,
   "max": 48,
   "kind": "dialogue",
   "jp": "井伊！\\nわしらの歌に耳を傾けろ\\n心を向けろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c02"
  },
  {
   "id": "m_009004:0x18420",
   "off": 99360,
   "max": 44,
   "kind": "dialogue",
   "jp": "ヒジゾーさん\\nソウちん\\n援護を頼むぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1c03"
  },
  {
   "id": "m_009004:0x18ce0",
   "off": 101600,
   "max": 16,
   "kind": "dialogue",
   "jp": "任せろ\\n坂本",
   "en": "",
   "op": "0x62",
   "msg": "0x1c04"
  },
  {
   "id": "m_009004:0x19388",
   "off": 103304,
   "max": 32,
   "kind": "dialogue",
   "jp": "存分に歌って！\\nトサカくん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c05"
  },
  {
   "id": "m_009004:0x19c30",
   "off": 105520,
   "max": 40,
   "kind": "dialogue",
   "jp": "シンディ！\\nセンセーも！\\n頼んだぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c06"
  },
  {
   "id": "m_009004:0x1a4ec",
   "off": 107756,
   "max": 64,
   "kind": "dialogue",
   "jp": "オレ様を差し置いて\\n頼んだもクソもあるかよ！\\n死ぬ気で歌え！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c07"
  },
  {
   "id": "m_009004:0x1abc8",
   "off": 109512,
   "max": 36,
   "kind": "dialogue",
   "jp": "準備万端だよ！\\nさあ　はじめよう",
   "en": "",
   "op": "0x62",
   "msg": "0x1c08"
  },
  {
   "id": "m_009004:0x1b100",
   "off": 110848,
   "max": 52,
   "kind": "dialogue",
   "jp": "その時\\n五つに分かたれていた\\n片魂が光を放ち始めた",
   "en": "",
   "op": "0x62",
   "msg": "0x1c09"
  },
  {
   "id": "m_009004:0x1b5a4",
   "off": 112036,
   "max": 60,
   "kind": "dialogue",
   "jp": "その光は\\n踊るように近づいて\\nひとつの大きな\\n光に変わる",
   "en": "",
   "op": "0x62",
   "msg": "0x1c0a"
  },
  {
   "id": "m_009004:0x1bb90",
   "off": 113552,
   "max": 32,
   "kind": "dialogue",
   "jp": "……これはっ！\\n超魂の輝き",
   "en": "",
   "op": "0x62",
   "msg": "0x1c0b"
  },
  {
   "id": "m_009004:0x1c90c",
   "off": 117004,
   "max": 36,
   "kind": "dialogue",
   "jp": "今こそ\\n魂をひとつにして\\n歌おう",
   "en": "",
   "op": "0x62",
   "msg": "0x1c0c"
  },
  {
   "id": "m_009004:0x1c940",
   "off": 117056,
   "max": 68,
   "kind": "dialogue",
   "jp": "キタキタキタぁぁぁ！\\nこのリズムぜよ！\\nこの音色ぜよぉぉぉおお！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c0d"
  },
  {
   "id": "m_009004:0x1c994",
   "off": 117140,
   "max": 64,
   "kind": "dialogue",
   "jp": "無限の熱情がわき上がる！\\n魂が震えるぜよ！\\nもう止められない！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c0e"
  },
  {
   "id": "m_009004:0x1c9e4",
   "off": 117220,
   "max": 60,
   "kind": "dialogue",
   "jp": "井伊！\\nわしらのロックを聴け！\\nわしらの歌を受けとめろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c0f"
  },
  {
   "id": "m_009004:0x1ca30",
   "off": 117296,
   "max": 20,
   "kind": "dialogue",
   "jp": "うぉぉおおおおお！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c10"
  },
  {
   "id": "m_009004:0x1ca54",
   "off": 117332,
   "max": 24,
   "kind": "dialogue",
   "jp": "これが――\\nわしが――",
   "en": "",
   "op": "0x62",
   "msg": "0x1c11"
  },
  {
   "id": "m_009004:0x1ca7c",
   "off": 117372,
   "max": 28,
   "kind": "dialogue",
   "jp": "ロックじゃぁぁぁぁあああ",
   "en": "",
   "op": "0x62",
   "msg": "0x1c12"
  },
  {
   "id": "m_009004:0x1cab0",
   "off": 117424,
   "max": 48,
   "kind": "dialogue",
   "jp": "\\fnt1烈（レッツ）\\nロックンロォォル\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x1c13"
  }
 ]
