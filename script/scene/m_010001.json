{
 "source": "m_010001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_010001:0x11d0",
   "off": 4560,
   "max": 72,
   "kind": "dialogue",
   "jp": "井伊直弼を倒した龍馬達が\\n京の都へと戻ってから\\n十日が経とうとしている",
   "en": "",
   "op": "0x62",
   "msg": "0x1c98"
  },
  {
   "id": "m_010001:0x1228",
   "off": 4648,
   "max": 52,
   "kind": "dialogue",
   "jp": "親徳川の急先鋒だった\\n井伊大老を失った\\n徳川幕府は",
   "en": "",
   "op": "0x62",
   "msg": "0x1c99"
  },
  {
   "id": "m_010001:0x126c",
   "off": 4716,
   "max": 60,
   "kind": "dialogue",
   "jp": "急激に統治力を弱め\\n今や　その天秤は\\n倒幕に傾きつつある",
   "en": "",
   "op": "0x62",
   "msg": "0x1c9a"
  },
  {
   "id": "m_010001:0x12b8",
   "off": 4792,
   "max": 12,
   "kind": "dialogue",
   "jp": "そして――",
   "en": "",
   "op": "0x62",
   "msg": "0x1c9b"
  },
  {
   "id": "m_010001:0x12d4",
   "off": 4820,
   "max": 116,
   "kind": "dialogue",
   "jp": "泰平化を解かれた新選組の\\n隊士達からの熱い要望と\\n勝海舟の口添えにより\\n土方と沖田の　新選組への\\n復隊が決まった",
   "en": "",
   "op": "0x62",
   "msg": "0x1c9c"
  },
  {
   "id": "m_010001:0x1a60",
   "off": 6752,
   "max": 36,
   "kind": "dialogue",
   "jp": "これで　本当の\\n新選組の復活じゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1c9d"
  },
  {
   "id": "m_010001:0x1a94",
   "off": 6804,
   "max": 48,
   "kind": "dialogue",
   "jp": "ヒジゾーさんも\\nソウちんも\\n本当によかったなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x1c9e"
  },
  {
   "id": "m_010001:0x21e4",
   "off": 8676,
   "max": 28,
   "kind": "dialogue",
   "jp": "とはいえ\\nちょっと複雑です",
   "en": "",
   "op": "0x62",
   "msg": "0x1c9f"
  },
  {
   "id": "m_010001:0x2210",
   "off": 8720,
   "max": 40,
   "kind": "dialogue",
   "jp": "未だ　私達は幕府の\\nお尋ね者ですからね",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca0"
  },
  {
   "id": "m_010001:0x2750",
   "off": 10064,
   "max": 64,
   "kind": "dialogue",
   "jp": "表向きには　また\\nあの二人と敵対しあう\\nことになってしまいます",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca1"
  },
  {
   "id": "m_010001:0x27a0",
   "off": 10144,
   "max": 56,
   "kind": "dialogue",
   "jp": "今までみたいに\\n気軽に話すことも\\nできなくなりますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca2"
  },
  {
   "id": "m_010001:0x2e74",
   "off": 11892,
   "max": 48,
   "kind": "dialogue",
   "jp": "だが　あの二人が\\n正式に新選組に\\n復帰すれば",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca3"
  },
  {
   "id": "m_010001:0x2eb4",
   "off": 11956,
   "max": 52,
   "kind": "dialogue",
   "jp": "今までよりも\\n格段に幕府の情報を\\n集めやすくなるぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca4"
  },
  {
   "id": "m_010001:0x2ef8",
   "off": 12024,
   "max": 64,
   "kind": "dialogue",
   "jp": "井伊を操っていた\\n徳川家の黒幕のことも\\n何かわかるかもしれない",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca5"
  },
  {
   "id": "m_010001:0x3450",
   "off": 13392,
   "max": 48,
   "kind": "dialogue",
   "jp": "ようやく　オレ様達に\\n風が吹き始めたようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca6"
  },
  {
   "id": "m_010001:0x3490",
   "off": 13456,
   "max": 28,
   "kind": "dialogue",
   "jp": "この機会を逃す\\n手はないぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca7"
  },
  {
   "id": "m_010001:0x3930",
   "off": 14640,
   "max": 32,
   "kind": "dialogue",
   "jp": "お登勢や～ん\\n酒はないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca8"
  },
  {
   "id": "m_010001:0x3dd0",
   "off": 15824,
   "max": 48,
   "kind": "dialogue",
   "jp": "一気に幕府を切り崩し\\n倒幕の動きを推し進――",
   "en": "",
   "op": "0x62",
   "msg": "0x1ca9"
  },
  {
   "id": "m_010001:0x4284",
   "off": 17028,
   "max": 64,
   "kind": "dialogue",
   "jp": "お登勢や～ん？\\nお龍でもいいんじゃが\\n酒を持ってきてくれ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x1caa"
  },
  {
   "id": "m_010001:0x4b2c",
   "off": 19244,
   "max": 60,
   "kind": "dialogue",
   "jp": "酒　酒　うるせえ\\nオレ様は　真面目な\\n話をしてるんだぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cab"
  },
  {
   "id": "m_010001:0x52d8",
   "off": 21208,
   "max": 32,
   "kind": "dialogue",
   "jp": "そうは言っても\\nめでたいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1cac"
  },
  {
   "id": "m_010001:0x53a0",
   "off": 21408,
   "max": 52,
   "kind": "dialogue",
   "jp": "これで　あの二人も\\n本来の志に向かって\\n邁進できる",
   "en": "",
   "op": "0x62",
   "msg": "0x1cad"
  },
  {
   "id": "m_010001:0x547c",
   "off": 21628,
   "max": 52,
   "kind": "dialogue",
   "jp": "近藤のオッサンも\\n天国で喜んどるに\\n違いないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cae"
  },
  {
   "id": "m_010001:0x592c",
   "off": 22828,
   "max": 12,
   "kind": "dialogue",
   "jp": "近藤か……",
   "en": "",
   "op": "0x62",
   "msg": "0x1caf"
  },
  {
   "id": "m_010001:0x5948",
   "off": 22856,
   "max": 20,
   "kind": "dialogue",
   "jp": "たしかにそうかもな",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb0"
  },
  {
   "id": "m_010001:0x6254",
   "off": 25172,
   "max": 40,
   "kind": "dialogue",
   "jp": "めでたい時は酒じゃ！\\n祝杯をあげるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb1"
  },
  {
   "id": "m_010001:0x699c",
   "off": 27036,
   "max": 28,
   "kind": "dialogue",
   "jp": "当の本人も\\nいないのにか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb2"
  },
  {
   "id": "m_010001:0x6ff8",
   "off": 28664,
   "max": 68,
   "kind": "dialogue",
   "jp": "そこが寂しいところじゃな\\nまあ仕方がないぜよ\\nわしらだけでも祝杯を",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb3"
  },
  {
   "id": "m_010001:0x755c",
   "off": 30044,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前　酒が飲みたい\\nだけじゃねえか……",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb4"
  },
  {
   "id": "m_010001:0x7c20",
   "off": 31776,
   "max": 44,
   "kind": "dialogue",
   "jp": "まあまあ　晋作\\n今日くらいは\\nいいじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb5"
  },
  {
   "id": "m_010001:0x8544",
   "off": 34116,
   "max": 32,
   "kind": "dialogue",
   "jp": "お龍～！\\n幾松～！\\nおうの～！",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb6"
  },
  {
   "id": "m_010001:0x8574",
   "off": 34164,
   "max": 40,
   "kind": "dialogue",
   "jp": "誰でもいいから\\n酒を持ってきてくれ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb7"
  },
  {
   "id": "m_010001:0x8cc4",
   "off": 36036,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんだ？\\n誰もいないのか？\\n不用心だな",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb8"
  },
  {
   "id": "m_010001:0x94f8",
   "off": 38136,
   "max": 32,
   "kind": "dialogue",
   "jp": "弥太郎！\\n酒盛りをするぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cb9"
  },
  {
   "id": "m_010001:0x9df0",
   "off": 40432,
   "max": 44,
   "kind": "dialogue",
   "jp": "おかしいな\\n呼んでも弥太郎が\\nこないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cba"
  },
  {
   "id": "m_010001:0xa4b8",
   "off": 42168,
   "max": 32,
   "kind": "dialogue",
   "jp": "ちょっと奥を\\n見てきましょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x1cbb"
  },
  {
   "id": "m_010001:0xa968",
   "off": 43368,
   "max": 56,
   "kind": "dialogue",
   "jp": "そう言って厨房を覗いた\\n桂が血相を変えて\\n帰って来た",
   "en": "",
   "op": "0x62",
   "msg": "0x1cbc"
  },
  {
   "id": "m_010001:0xb17c",
   "off": 45436,
   "max": 52,
   "kind": "dialogue",
   "jp": "大変です\\n厨房で　お登勢さんが\\n倒れています",
   "en": "",
   "op": "0x62",
   "msg": "0x1cbd"
  },
  {
   "id": "m_010001:0xb8dc",
   "off": 47324,
   "max": 8,
   "kind": "dialogue",
   "jp": "何",
   "en": "",
   "op": "0x62",
   "msg": "0x1cbe"
  },
  {
   "id": "m_010001:0xc0ec",
   "off": 49388,
   "max": 24,
   "kind": "dialogue",
   "jp": "……う\\n……う……う",
   "en": "",
   "op": "0x62",
   "msg": "0x1cbf"
  },
  {
   "id": "m_010001:0xc964",
   "off": 51556,
   "max": 40,
   "kind": "dialogue",
   "jp": "お登勢やん\\nい　一体どうしたんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc0"
  },
  {
   "id": "m_010001:0xd0b0",
   "off": 53424,
   "max": 12,
   "kind": "dialogue",
   "jp": "うふふ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc1"
  },
  {
   "id": "m_010001:0xd758",
   "off": 55128,
   "max": 52,
   "kind": "dialogue",
   "jp": "眠ってるみたいなんだけど\\n揺すっても起きないんです",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc2"
  },
  {
   "id": "m_010001:0xddd4",
   "off": 56788,
   "max": 40,
   "kind": "dialogue",
   "jp": "こんなとこで寝てると\\n風邪を引くぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc3"
  },
  {
   "id": "m_010001:0xe580",
   "off": 58752,
   "max": 16,
   "kind": "dialogue",
   "jp": "……えへへへ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc4"
  },
  {
   "id": "m_010001:0xed6c",
   "off": 60780,
   "max": 16,
   "kind": "dialogue",
   "jp": "……だめだな",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc5"
  },
  {
   "id": "m_010001:0xed8c",
   "off": 60812,
   "max": 32,
   "kind": "dialogue",
   "jp": "何か\\n変なものでも食ったか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc6"
  },
  {
   "id": "m_010001:0xf228",
   "off": 61992,
   "max": 16,
   "kind": "dialogue",
   "jp": "お登勢や～ん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc7"
  },
  {
   "id": "m_010001:0xfa1c",
   "off": 64028,
   "max": 28,
   "kind": "dialogue",
   "jp": "晋作も龍馬くんも\\nどいて",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc8"
  },
  {
   "id": "m_010001:0xfde4",
   "off": 64996,
   "max": 72,
   "kind": "dialogue",
   "jp": "桂はお登勢の傍らに跪くと\\n何かを確認するように\\n瞼を開き　脈を取った",
   "en": "",
   "op": "0x62",
   "msg": "0x1cc9"
  },
  {
   "id": "m_010001:0x10134",
   "off": 65844,
   "max": 56,
   "kind": "dialogue",
   "jp": "見たところ\\n特に異常は無いようです\\nただ随分と脈が弱い",
   "en": "",
   "op": "0x62",
   "msg": "0x1cca"
  },
  {
   "id": "m_010001:0x1017c",
   "off": 65916,
   "max": 68,
   "kind": "dialogue",
   "jp": "何かあって倒れたという\\nよりも　衰弱して\\n眠ってるっていう感じです",
   "en": "",
   "op": "0x62",
   "msg": "0x1ccb"
  },
  {
   "id": "m_010001:0x10800",
   "off": 67584,
   "max": 36,
   "kind": "dialogue",
   "jp": "徹夜で働き過ぎて\\n倒れたのかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x1ccc"
  },
  {
   "id": "m_010001:0x10ca0",
   "off": 68768,
   "max": 56,
   "kind": "dialogue",
   "jp": "わかりません\\nでも　一応医者に\\n診せた方がいいでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x1ccd"
  },
  {
   "id": "m_010001:0x11374",
   "off": 70516,
   "max": 44,
   "kind": "dialogue",
   "jp": "まずは奥に\\n寝かせるべきだ\\n手伝え　龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x1cce"
  },
  {
   "id": "m_010001:0x1181c",
   "off": 71708,
   "max": 12,
   "kind": "dialogue",
   "jp": "お　おう",
   "en": "",
   "op": "0x62",
   "msg": "0x1ccf"
  },
  {
   "id": "m_010001:0x11da4",
   "off": 73124,
   "max": 72,
   "kind": "dialogue",
   "jp": "お登勢を運ぼうと\\n奥の障子を開けると\\nそこにも二人\\n倒れている者がいた",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd0"
  },
  {
   "id": "m_010001:0x123f4",
   "off": 74740,
   "max": 12,
   "kind": "dialogue",
   "jp": "……なっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd1"
  },
  {
   "id": "m_010001:0x1291c",
   "off": 76060,
   "max": 48,
   "kind": "dialogue",
   "jp": "そこに転がる二人を見て\\n龍馬と高杉は絶句する",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd2"
  },
  {
   "id": "m_010001:0x131b0",
   "off": 78256,
   "max": 12,
   "kind": "dialogue",
   "jp": "うふふ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd3"
  },
  {
   "id": "m_010001:0x13638",
   "off": 79416,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぁはは……",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd4"
  },
  {
   "id": "m_010001:0x13ed4",
   "off": 81620,
   "max": 60,
   "kind": "dialogue",
   "jp": "お登勢やんと同じじゃ\\nこれはいったい\\nどういうことぜよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd5"
  },
  {
   "id": "m_010001:0x13f20",
   "off": 81696,
   "max": 36,
   "kind": "dialogue",
   "jp": "そういや\\n幾松はどうしたんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd6"
  },
  {
   "id": "m_010001:0x145e0",
   "off": 83424,
   "max": 24,
   "kind": "dialogue",
   "jp": "そうだ\\n一人足りないぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd7"
  },
  {
   "id": "m_010001:0x14c3c",
   "off": 85052,
   "max": 44,
   "kind": "dialogue",
   "jp": "医者を呼びにいった？\\nでも　草履はあるし",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd8"
  },
  {
   "id": "m_010001:0x15440",
   "off": 87104,
   "max": 32,
   "kind": "dialogue",
   "jp": "おーい　幾松\\nどこぜよーー",
   "en": "",
   "op": "0x62",
   "msg": "0x1cd9"
  },
  {
   "id": "m_010001:0x159c8",
   "off": 88520,
   "max": 12,
   "kind": "dialogue",
   "jp": "……けて",
   "en": "",
   "op": "0x62",
   "msg": "0x1cda"
  },
  {
   "id": "m_010001:0x16144",
   "off": 90436,
   "max": 28,
   "kind": "dialogue",
   "jp": "おい\\n何か聞こえなかったか",
   "en": "",
   "op": "0x62",
   "msg": "0x1cdb"
  },
  {
   "id": "m_010001:0x16804",
   "off": 92164,
   "max": 20,
   "kind": "dialogue",
   "jp": "奥の間の方ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x1cdc"
  },
  {
   "id": "m_010001:0x16ca8",
   "off": 93352,
   "max": 72,
   "kind": "dialogue",
   "jp": "奥の間へ続く襖を\\n開けると　そこには\\nグッタリとした\\n幾松の姿があった",
   "en": "",
   "op": "0x62",
   "msg": "0x1cdd"
  },
  {
   "id": "m_010001:0x17184",
   "off": 94596,
   "max": 32,
   "kind": "dialogue",
   "jp": "幾松\\nお前は無事じゃったか！",
   "en": "",
   "op": "0x62",
   "msg": "0x1cde"
  },
  {
   "id": "m_010001:0x17848",
   "off": 96328,
   "max": 40,
   "kind": "dialogue",
   "jp": "良かった　皆さん……\\n来てくれて……",
   "en": "",
   "op": "0x62",
   "msg": "0x1cdf"
  },
  {
   "id": "m_010001:0x1802c",
   "off": 98348,
   "max": 36,
   "kind": "dialogue",
   "jp": "そのまま龍馬の腕に\\n倒れ込む幾松",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce0"
  },
  {
   "id": "m_010001:0x18328",
   "off": 99112,
   "max": 68,
   "kind": "dialogue",
   "jp": "倒れている者達を\\n布団に寝かせ　\\n龍馬達は意識が戻るのを\\n待った",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce1"
  },
  {
   "id": "m_010001:0x18ae8",
   "off": 101096,
   "max": 16,
   "kind": "dialogue",
   "jp": "おかしいだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce2"
  },
  {
   "id": "m_010001:0x18f74",
   "off": 102260,
   "max": 60,
   "kind": "dialogue",
   "jp": "医者という医者を訪ねて\\n門を叩いたが　誰も出て\\nきやしねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce3"
  },
  {
   "id": "m_010001:0x1964c",
   "off": 104012,
   "max": 68,
   "kind": "dialogue",
   "jp": "それだけじゃありません\\n気付けを買いに薬屋に\\n行ったけど誰もいない",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce4"
  },
  {
   "id": "m_010001:0x19cd4",
   "off": 105684,
   "max": 56,
   "kind": "dialogue",
   "jp": "近所も覗いてみたが\\n皆　同じような状態で\\n倒れていた",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce5"
  },
  {
   "id": "m_010001:0x1a188",
   "off": 106888,
   "max": 60,
   "kind": "dialogue",
   "jp": "揺すっても叩いても\\n誰も目を覚まさない\\n返事すらしません",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce6"
  },
  {
   "id": "m_010001:0x1a948",
   "off": 108872,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしらがいない間に\\n何があったんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce7"
  },
  {
   "id": "m_010001:0x1b460",
   "off": 111712,
   "max": 32,
   "kind": "dialogue",
   "jp": "おい　坂本！\\n坂本はいるか",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce8"
  },
  {
   "id": "m_010001:0x1b49c",
   "off": 111772,
   "max": 52,
   "kind": "dialogue",
   "jp": "おい　土方だ\\n坂本　高杉　桂！\\nいるなら開けろ",
   "en": "",
   "op": "0x62",
   "msg": "0x1ce9"
  },
  {
   "id": "m_010001:0x1b9e8",
   "off": 113128,
   "max": 28,
   "kind": "dialogue",
   "jp": "おっ\\nヒジゾーさんじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1cea"
  },
  {
   "id": "m_010001:0x1ba14",
   "off": 113172,
   "max": 44,
   "kind": "dialogue",
   "jp": "はいはい\\nわしなら　おるぜ――\\nむぐぐっ",
   "en": "",
   "op": "0x62",
   "msg": "0x1ceb"
  },
  {
   "id": "m_010001:0x1c20c",
   "off": 115212,
   "max": 32,
   "kind": "dialogue",
   "jp": "気安く返事を\\nするんじゃねえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1cec"
  },
  {
   "id": "m_010001:0x1c244",
   "off": 115268,
   "max": 40,
   "kind": "dialogue",
   "jp": "今の土方は幕府側の\\n新選組なんだぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1ced"
  },
  {
   "id": "m_010001:0x1c8ac",
   "off": 116908,
   "max": 64,
   "kind": "dialogue",
   "jp": "もがっ……テラーダに\\n飯を食いに来ただけかも\\nしれんじゃろ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1cee"
  },
  {
   "id": "m_010001:0x1cf88",
   "off": 118664,
   "max": 40,
   "kind": "dialogue",
   "jp": "表には本日休業の\\n札を掛けてあります",
   "en": "",
   "op": "0x62",
   "msg": "0x1cef"
  },
  {
   "id": "m_010001:0x1d4c4",
   "off": 120004,
   "max": 32,
   "kind": "dialogue",
   "jp": "きっと\\n腹が減ってるだけぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf0"
  },
  {
   "id": "m_010001:0x1dbdc",
   "off": 121820,
   "max": 36,
   "kind": "dialogue",
   "jp": "お前はバカか？\\n立場をよく考えろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf1"
  },
  {
   "id": "m_010001:0x1dc18",
   "off": 121880,
   "max": 32,
   "kind": "dialogue",
   "jp": "とにかく\\nじっとして何も言うな",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf2"
  },
  {
   "id": "m_010001:0x1e154",
   "off": 123220,
   "max": 20,
   "kind": "dialogue",
   "jp": "わ　わかったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf3"
  },
  {
   "id": "m_010001:0x1ea58",
   "off": 125528,
   "max": 64,
   "kind": "dialogue",
   "jp": "……くっ\\nもしやと様子を見に来たが\\nやつらもやられたのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf4"
  },
  {
   "id": "m_010001:0x1f130",
   "off": 127280,
   "max": 68,
   "kind": "dialogue",
   "jp": "いや～　殺しても死なない\\nような連中だもの\\n隠れてるだけじゃない？",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf5"
  },
  {
   "id": "m_010001:0x1f950",
   "off": 129360,
   "max": 76,
   "kind": "dialogue",
   "jp": "どうして隠れる必要がある\\n後ろ暗いところがなければ\\nそんな必要はないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf6"
  },
  {
   "id": "m_010001:0x1fe18",
   "off": 130584,
   "max": 68,
   "kind": "dialogue",
   "jp": "前に僕達　さんざん彼らを\\n付け狙ったよね？\\n忘れたの？　土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf7"
  },
  {
   "id": "m_010001:0x20448",
   "off": 132168,
   "max": 20,
   "kind": "dialogue",
   "jp": "どうしろと言うんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf8"
  },
  {
   "id": "m_010001:0x208e0",
   "off": 133344,
   "max": 64,
   "kind": "dialogue",
   "jp": "\\fnt1出てこなければ\\n斬り捨てる！\\fnt0\\nとでも言えばいいのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1cf9"
  },
  {
   "id": "m_010001:0x21504",
   "off": 136452,
   "max": 52,
   "kind": "dialogue",
   "jp": "な……今……\\n出てこなきゃ斬るって\\n聞こえたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cfa"
  },
  {
   "id": "m_010001:0x21df4",
   "off": 138740,
   "max": 16,
   "kind": "dialogue",
   "jp": "絶対に出るなよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1cfb"
  },
  {
   "id": "m_010001:0x224a8",
   "off": 140456,
   "max": 36,
   "kind": "dialogue",
   "jp": "さて　どうやって\\n逃げ出そうか……",
   "en": "",
   "op": "0x62",
   "msg": "0x1cfc"
  },
  {
   "id": "m_010001:0x22ce4",
   "off": 142564,
   "max": 48,
   "kind": "dialogue",
   "jp": "もう　そんなんだから\\nみんなに怖がられるんです",
   "en": "",
   "op": "0x62",
   "msg": "0x1cfd"
  },
  {
   "id": "m_010001:0x23358",
   "off": 144216,
   "max": 28,
   "kind": "dialogue",
   "jp": "だったら\\nなんて言えばいい",
   "en": "",
   "op": "0x62",
   "msg": "0x1cfe"
  },
  {
   "id": "m_010001:0x23888",
   "off": 145544,
   "max": 20,
   "kind": "dialogue",
   "jp": "こういう時は……",
   "en": "",
   "op": "0x62",
   "msg": "0x1cff"
  },
  {
   "id": "m_010001:0x23c30",
   "off": 146480,
   "max": 12,
   "kind": "choice",
   "jp": "桂を呼ぶ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_010001:0x23c48",
   "off": 146504,
   "max": 12,
   "kind": "choice",
   "jp": "龍馬を呼ぶ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_010001:0x23c60",
   "off": 146528,
   "max": 12,
   "kind": "choice",
   "jp": "高杉を呼ぶ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_010001:0x24460",
   "off": 148576,
   "max": 64,
   "kind": "dialogue",
   "jp": "メガネくんなら\\nちゃんと話せばわかって\\nくれるんじゃないかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d00"
  },
  {
   "id": "m_010001:0x24b3c",
   "off": 150332,
   "max": 40,
   "kind": "dialogue",
   "jp": "確かに\\nあの中では桂が\\n一番冷静な男だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d01"
  },
  {
   "id": "m_010001:0x24b74",
   "off": 150388,
   "max": 12,
   "kind": "dialogue",
   "jp": "……よし",
   "en": "",
   "op": "0x62",
   "msg": "0x1d02"
  },
  {
   "id": "m_010001:0x24ffc",
   "off": 151548,
   "max": 56,
   "kind": "dialogue",
   "jp": "桂！　聞こえるか？\\nお前達を捕まえに\\n来たのではない！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d03"
  },
  {
   "id": "m_010001:0x25044",
   "off": 151620,
   "max": 16,
   "kind": "dialogue",
   "jp": "話をしに来た！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d04"
  },
  {
   "id": "m_010001:0x256ec",
   "off": 153324,
   "max": 40,
   "kind": "dialogue",
   "jp": "今　京で不可解な事件が\\n起こってるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d05"
  },
  {
   "id": "m_010001:0x25724",
   "off": 153380,
   "max": 64,
   "kind": "dialogue",
   "jp": "もしかしたら\\nメガネくんや　その仲間に\\n心当たりないかなって",
   "en": "",
   "op": "0x62",
   "msg": "0x1d06"
  },
  {
   "id": "m_010001:0x25f70",
   "off": 155504,
   "max": 20,
   "kind": "dialogue",
   "jp": "桂さん\\nどうする？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d07"
  },
  {
   "id": "m_010001:0x26620",
   "off": 157216,
   "max": 36,
   "kind": "dialogue",
   "jp": "確かに心当たりは\\n存分にあります",
   "en": "",
   "op": "0x62",
   "msg": "0x1d08"
  },
  {
   "id": "m_010001:0x26654",
   "off": 157268,
   "max": 40,
   "kind": "dialogue",
   "jp": "これは協力できると\\n見ていいでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x1d09"
  },
  {
   "id": "m_010001:0x26d14",
   "off": 158996,
   "max": 64,
   "kind": "dialogue",
   "jp": "捕まえるつもりだったら\\n声なんかかけずに\\n押し入ってきてるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d0a"
  },
  {
   "id": "m_010001:0x2755c",
   "off": 161116,
   "max": 36,
   "kind": "dialogue",
   "jp": "……どうやら\\n出てきてくれそうだね",
   "en": "",
   "op": "0x62",
   "msg": "0x1d0b"
  },
  {
   "id": "m_010001:0x27ffc",
   "off": 163836,
   "max": 24,
   "kind": "dialogue",
   "jp": "ちわ～す\\n坂本さ～ん",
   "en": "",
   "op": "0x62",
   "msg": "0x1d0c"
  },
  {
   "id": "m_010001:0x286b0",
   "off": 165552,
   "max": 60,
   "kind": "dialogue",
   "jp": "牛丼の　なか吉屋です\\n出前の牛丼大盛り\\nお持ちしました～",
   "en": "",
   "op": "0x62",
   "msg": "0x1d0d"
  },
  {
   "id": "m_010001:0x28c54",
   "off": 166996,
   "max": 32,
   "kind": "dialogue",
   "jp": "\\fnt1ぎゅ\\nぎゅ\\n牛丼\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x1d0e"
  },
  {
   "id": "m_010001:0x29150",
   "off": 168272,
   "max": 16,
   "kind": "dialogue",
   "jp": "バカ\\n黙れ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d0f"
  },
  {
   "id": "m_010001:0x295e8",
   "off": 169448,
   "max": 44,
   "kind": "dialogue",
   "jp": "桂さん\\n龍馬を押さえつけろ！\\n口を塞げ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d10"
  },
  {
   "id": "m_010001:0x29d18",
   "off": 171288,
   "max": 44,
   "kind": "dialogue",
   "jp": "あははは\\nトサカくんは\\n本当にバカだなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d11"
  },
  {
   "id": "m_010001:0x2a1c0",
   "off": 172480,
   "max": 60,
   "kind": "dialogue",
   "jp": "いるのはわかってる\\nお前達に話があってきた\\nここを開けろ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d12"
  },
  {
   "id": "m_010001:0x2ad80",
   "off": 175488,
   "max": 36,
   "kind": "dialogue",
   "jp": "スカシく～ん\\n死んでたら返事して",
   "en": "",
   "op": "0x62",
   "msg": "0x1d13"
  },
  {
   "id": "m_010001:0x2b304",
   "off": 176900,
   "max": 52,
   "kind": "dialogue",
   "jp": "死んでたら\\n返事なんか出来るか\\nお前はバカか",
   "en": "",
   "op": "0x62",
   "msg": "0x1d14"
  },
  {
   "id": "m_010001:0x2ba34",
   "off": 178740,
   "max": 20,
   "kind": "dialogue",
   "jp": "ですって\\n土方さん",
   "en": "",
   "op": "0x62",
   "msg": "0x1d15"
  },
  {
   "id": "m_010001:0x2bec4",
   "off": 179908,
   "max": 28,
   "kind": "dialogue",
   "jp": "確実に\\n中にいるようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x1d16"
  },
  {
   "id": "m_010001:0x2c914",
   "off": 182548,
   "max": 32,
   "kind": "dialogue",
   "jp": "くそっ！\\nオレ様としたことが",
   "en": "",
   "op": "0x62",
   "msg": "0x1d17"
  },
  {
   "id": "m_010001:0x2d3ec",
   "off": 185324,
   "max": 48,
   "kind": "dialogue",
   "jp": "二人とも　取り敢えず\\n中に入ってくれますか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d18"
  },
  {
   "id": "m_010001:0x2dc34",
   "off": 187444,
   "max": 60,
   "kind": "dialogue",
   "jp": "ああ　よかった\\nやっぱり　トサカくん達は\\n無事だったんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d19"
  },
  {
   "id": "m_010001:0x2e2b0",
   "off": 189104,
   "max": 20,
   "kind": "dialogue",
   "jp": "どういう意味じゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d1a"
  },
  {
   "id": "m_010001:0x2e7d8",
   "off": 190424,
   "max": 52,
   "kind": "dialogue",
   "jp": "今ね……\\n京の都中の人々が\\n謎の眠りについてるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d1b"
  },
  {
   "id": "m_010001:0x2eea8",
   "off": 192168,
   "max": 56,
   "kind": "dialogue",
   "jp": "今日一日　新選組の\\n隊士全員で　京中を\\nかけずり回った",
   "en": "",
   "op": "0x62",
   "msg": "0x1d1c"
  },
  {
   "id": "m_010001:0x2f35c",
   "off": 193372,
   "max": 24,
   "kind": "dialogue",
   "jp": "何か\\nわかったんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d1d"
  },
  {
   "id": "m_010001:0x2f7f0",
   "off": 194544,
   "max": 68,
   "kind": "dialogue",
   "jp": "いや　何も掴めなかった\\nその上　隊士の半分は\\n帰ってこなかった……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d1e"
  },
  {
   "id": "m_010001:0x2fd9c",
   "off": 195996,
   "max": 48,
   "kind": "dialogue",
   "jp": "なんと\\n新選組の隊士まで\\nやられてしもうたんか",
   "en": "",
   "op": "0x62",
   "msg": "0x1d1f"
  },
  {
   "id": "m_010001:0x30250",
   "off": 197200,
   "max": 52,
   "kind": "dialogue",
   "jp": "お前達　何か知らないか？\\nどんな小さなことでもいい",
   "en": "",
   "op": "0x62",
   "msg": "0x1d20"
  },
  {
   "id": "m_010001:0x30798",
   "off": 198552,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうは\\n言われてもなぁ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d21"
  },
  {
   "id": "m_010001:0x30f3c",
   "off": 200508,
   "max": 28,
   "kind": "dialogue",
   "jp": "流行り病なんじゃ\\nないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d22"
  },
  {
   "id": "m_010001:0x315f0",
   "off": 202224,
   "max": 68,
   "kind": "dialogue",
   "jp": "それにしては広まるのが\\n早すぎるし　僕達も\\n眠ってなきゃおかしい",
   "en": "",
   "op": "0x62",
   "msg": "0x1d23"
  },
  {
   "id": "m_010001:0x31cd0",
   "off": 203984,
   "max": 12,
   "kind": "dialogue",
   "jp": "確かに……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d24"
  },
  {
   "id": "m_010001:0x3223c",
   "off": 205372,
   "max": 12,
   "kind": "dialogue",
   "jp": "ううっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d25"
  },
  {
   "id": "m_010001:0x329b4",
   "off": 207284,
   "max": 24,
   "kind": "dialogue",
   "jp": "あれ\\nその子は……？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d26"
  },
  {
   "id": "m_010001:0x33064",
   "off": 208996,
   "max": 48,
   "kind": "dialogue",
   "jp": "そうじゃ！\\n幾松が何かを\\n知ってるかもしれん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d27"
  },
  {
   "id": "m_010001:0x33730",
   "off": 210736,
   "max": 20,
   "kind": "dialogue",
   "jp": "可能性はありますね",
   "en": "",
   "op": "0x62",
   "msg": "0x1d28"
  },
  {
   "id": "m_010001:0x33754",
   "off": 210772,
   "max": 60,
   "kind": "dialogue",
   "jp": "みんなが倒れてる中　\\n幾松さんだけは\\n意識がありましたし",
   "en": "",
   "op": "0x62",
   "msg": "0x1d29"
  },
  {
   "id": "m_010001:0x337a0",
   "off": 210848,
   "max": 48,
   "kind": "dialogue",
   "jp": "幾松さん　幾松さん……\\n起きられそうですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d2a"
  },
  {
   "id": "m_010001:0x33e6c",
   "off": 212588,
   "max": 52,
   "kind": "dialogue",
   "jp": "桂さん……\\nそれに坂本さんに……\\n高杉さん……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d2b"
  },
  {
   "id": "m_010001:0x345c0",
   "off": 214464,
   "max": 28,
   "kind": "dialogue",
   "jp": "な……\\n新選組も……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d2d"
  },
  {
   "id": "m_010001:0x34c24",
   "off": 216100,
   "max": 36,
   "kind": "dialogue",
   "jp": "ちぇ\\nずいぶんと嫌われた\\nもんだね",
   "en": "",
   "op": "0x62",
   "msg": "0x1d2e"
  },
  {
   "id": "m_010001:0x352e4",
   "off": 217828,
   "max": 44,
   "kind": "dialogue",
   "jp": "幾松\\n起きてすぐで悪いが\\n話は出来るか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d2f"
  },
  {
   "id": "m_010001:0x35828",
   "off": 219176,
   "max": 20,
   "kind": "dialogue",
   "jp": "は……\\nはい……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d30"
  },
  {
   "id": "m_010001:0x35ed4",
   "off": 220884,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしらが留守にしていた間\\n何が起こったか教えてくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d31"
  },
  {
   "id": "m_010001:0x36384",
   "off": 222084,
   "max": 40,
   "kind": "dialogue",
   "jp": "そう言われても……\\n私もさっぱり……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d32"
  },
  {
   "id": "m_010001:0x36b34",
   "off": 224052,
   "max": 60,
   "kind": "dialogue",
   "jp": "この京に住まう人々の\\nほとんどが死んだように\\n眠っている",
   "en": "",
   "op": "0x62",
   "msg": "0x1d33"
  },
  {
   "id": "m_010001:0x36b80",
   "off": 224128,
   "max": 36,
   "kind": "dialogue",
   "jp": "見ろ\\n目を覚ましたのは\\nお前だけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d34"
  },
  {
   "id": "m_010001:0x37248",
   "off": 225864,
   "max": 48,
   "kind": "dialogue",
   "jp": "お龍姐さん……\\nおうの……\\nお登勢さんまで……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d35"
  },
  {
   "id": "m_010001:0x376f4",
   "off": 227060,
   "max": 16,
   "kind": "dialogue",
   "jp": "そんな……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d36"
  },
  {
   "id": "m_010001:0x37de4",
   "off": 228836,
   "max": 44,
   "kind": "dialogue",
   "jp": "うそ……起きて……\\nねぇ……起きてよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d37"
  },
  {
   "id": "m_010001:0x3832c",
   "off": 230188,
   "max": 72,
   "kind": "dialogue",
   "jp": "しかし\\nいくら幾松が\\n声をかけようが\\n揺すろうが\\n誰も返事をしない\\n",
   "en": "",
   "op": "0x62",
   "msg": "0x1d38"
  },
  {
   "id": "m_010001:0x387b4",
   "off": 231348,
   "max": 56,
   "kind": "dialogue",
   "jp": "覚えているだけでいい\\n何でもいいから\\n話してくれない？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d39"
  },
  {
   "id": "m_010001:0x38e88",
   "off": 233096,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x1d3a"
  },
  {
   "id": "m_010001:0x394d4",
   "off": 234708,
   "max": 56,
   "kind": "dialogue",
   "jp": "そうじゃ　お前さん\\nなんで奥座敷で\\n倒れてたんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d3b"
  },
  {
   "id": "m_010001:0x39988",
   "off": 235912,
   "max": 28,
   "kind": "dialogue",
   "jp": "それは…………\\nあっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d3c"
  },
  {
   "id": "m_010001:0x3a040",
   "off": 237632,
   "max": 32,
   "kind": "dialogue",
   "jp": "思い当たることが\\nあるようだな",
   "en": "",
   "op": "0x62",
   "msg": "0x1d3d"
  },
  {
   "id": "m_010001:0x3a6e8",
   "off": 239336,
   "max": 40,
   "kind": "dialogue",
   "jp": "あれは確か……\\n夜明け前の事でした……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d3e"
  },
  {
   "id": "m_010001:0x3b0ec",
   "off": 241900,
   "max": 24,
   "kind": "dialogue",
   "jp": "う～ん\\nムニャムニャ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d3f"
  },
  {
   "id": "m_010001:0x3baf8",
   "off": 244472,
   "max": 16,
   "kind": "dialogue",
   "jp": "あいたっ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d40"
  },
  {
   "id": "m_010001:0x3bf84",
   "off": 245636,
   "max": 80,
   "kind": "dialogue",
   "jp": "もう……おうのは本当に\\n寝相が悪いんだから……\\nおかげで目が覚め\\nちゃった……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d41"
  },
  {
   "id": "m_010001:0x3c848",
   "off": 247880,
   "max": 28,
   "kind": "dialogue",
   "jp": "ぐぁ～ごぉ～\\nぐぁ～ごぉ～",
   "en": "",
   "op": "0x62",
   "msg": "0x1d42"
  },
  {
   "id": "m_010001:0x3ce20",
   "off": 249376,
   "max": 52,
   "kind": "dialogue",
   "jp": "お龍姐さんも大口開けて\\n……またいびきかいてるし…",
   "en": "",
   "op": "0x62",
   "msg": "0x1d43"
  },
  {
   "id": "m_010001:0x3d538",
   "off": 251192,
   "max": 36,
   "kind": "dialogue",
   "jp": "なんだか私も喉が\\n渇いてきたわ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d44"
  },
  {
   "id": "m_010001:0x3d580",
   "off": 251264,
   "max": 36,
   "kind": "dialogue",
   "jp": "うっ……何これ……\\n耳鳴り……？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d45"
  },
  {
   "id": "m_010001:0x3da20",
   "off": 252448,
   "max": 24,
   "kind": "dialogue",
   "jp": "……淋しい\\n淋しいよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d46"
  },
  {
   "id": "m_010001:0x3dec4",
   "off": 253636,
   "max": 20,
   "kind": "dialogue",
   "jp": "だ　誰の声……？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d47"
  },
  {
   "id": "m_010001:0x3e354",
   "off": 254804,
   "max": 40,
   "kind": "dialogue",
   "jp": "悲しいよ\\n寂しいよ\\n一人はイヤだよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d48"
  },
  {
   "id": "m_010001:0x3e7fc",
   "off": 255996,
   "max": 56,
   "kind": "dialogue",
   "jp": "うっ……\\nこれは天歌……？\\nどこから聴こえてくるの…？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d49"
  },
  {
   "id": "m_010001:0x3ecb0",
   "off": 257200,
   "max": 52,
   "kind": "dialogue",
   "jp": "誰か　話を聞いてよ……\\n誰でもいい……\\n誰でも……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d4a"
  },
  {
   "id": "m_010001:0x3f6d4",
   "off": 259796,
   "max": 72,
   "kind": "dialogue",
   "jp": "それから先は意識が無くて\\n……気がついたら\\n奥座敷に倒れていたの……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d4b"
  },
  {
   "id": "m_010001:0x3fdb8",
   "off": 261560,
   "max": 32,
   "kind": "dialogue",
   "jp": "不思議な声と\\n天歌ですか……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d4c"
  },
  {
   "id": "m_010001:0x4041c",
   "off": 263196,
   "max": 44,
   "kind": "dialogue",
   "jp": "だが井伊はもういないぜ\\n一体　誰が天歌を",
   "en": "",
   "op": "0x62",
   "msg": "0x1d4d"
  },
  {
   "id": "m_010001:0x40bcc",
   "off": 265164,
   "max": 52,
   "kind": "dialogue",
   "jp": "しかし　どうして\\n幾松だけが\\n無事じゃったんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d4e"
  },
  {
   "id": "m_010001:0x41244",
   "off": 266820,
   "max": 56,
   "kind": "dialogue",
   "jp": "それは多分……\\n桂さんにもらった\\nこれのおかげかも……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d4f"
  },
  {
   "id": "m_010001:0x416c0",
   "off": 267968,
   "max": 44,
   "kind": "dialogue",
   "jp": "そう言って\\n幾松は懐から\\n耳栓を取り出す",
   "en": "",
   "op": "0x62",
   "msg": "0x1d50"
  },
  {
   "id": "m_010001:0x41a94",
   "off": 268948,
   "max": 48,
   "kind": "dialogue",
   "jp": "耳栓？\\nなんで　こんなものを\\n持っとるんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d51"
  },
  {
   "id": "m_010001:0x41f40",
   "off": 270144,
   "max": 64,
   "kind": "dialogue",
   "jp": "お龍姐さんのいびきが\\n酷いから……\\n桂さんから借りてたの……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d52"
  },
  {
   "id": "m_010001:0x42708",
   "off": 272136,
   "max": 56,
   "kind": "dialogue",
   "jp": "とても悲しそうな\\n声だった……\\n不安そうな子供の――",
   "en": "",
   "op": "0x62",
   "msg": "0x1d53"
  },
  {
   "id": "m_010001:0x42df4",
   "off": 273908,
   "max": 12,
   "kind": "dialogue",
   "jp": "子供……？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d54"
  },
  {
   "id": "m_010001:0x43444",
   "off": 275524,
   "max": 16,
   "kind": "dialogue",
   "jp": "どうした\\n土方",
   "en": "",
   "op": "0x62",
   "msg": "0x1d55"
  },
  {
   "id": "m_010001:0x4396c",
   "off": 276844,
   "max": 28,
   "kind": "dialogue",
   "jp": "いや　しかし\\nまさかな……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d56"
  },
  {
   "id": "m_010001:0x43e04",
   "off": 278020,
   "max": 52,
   "kind": "dialogue",
   "jp": "何か思い当たることが\\nあるなら　教えてくれ\\n土方",
   "en": "",
   "op": "0x62",
   "msg": "0x1d57"
  },
  {
   "id": "m_010001:0x446ec",
   "off": 280300,
   "max": 12,
   "kind": "dialogue",
   "jp": "慶喜様……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d58"
  },
  {
   "id": "m_010001:0x44ff0",
   "off": 282608,
   "max": 12,
   "kind": "dialogue",
   "jp": "何だと",
   "en": "",
   "op": "0x62",
   "msg": "0x1d59"
  },
  {
   "id": "m_010001:0x45724",
   "off": 284452,
   "max": 64,
   "kind": "dialogue",
   "jp": "俺も近藤さんの\\n付き添いでチラリと\\nお顔を拝見したくらいだが",
   "en": "",
   "op": "0x62",
   "msg": "0x1d5a"
  },
  {
   "id": "m_010001:0x45774",
   "off": 284532,
   "max": 56,
   "kind": "dialogue",
   "jp": "まだ　お若い方だった\\n若いと言うよりも\\nまさに幼子だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d5b"
  },
  {
   "id": "m_010001:0x45e48",
   "off": 286280,
   "max": 68,
   "kind": "dialogue",
   "jp": "確かに代替わりした\\nばかりだけど　そんなに\\n若かったんですね……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d5c"
  },
  {
   "id": "m_010001:0x46698",
   "off": 288408,
   "max": 36,
   "kind": "dialogue",
   "jp": "確かめにいかなくちゃ\\nならんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d5d"
  },
  {
   "id": "m_010001:0x46f1c",
   "off": 290588,
   "max": 28,
   "kind": "dialogue",
   "jp": "確かめるって\\nなにをだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d5e"
  },
  {
   "id": "m_010001:0x473b4",
   "off": 291764,
   "max": 60,
   "kind": "dialogue",
   "jp": "決まっとる\\nその悲しげな子供の声が\\n将軍様の声かどうかじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d5f"
  },
  {
   "id": "m_010001:0x47908",
   "off": 293128,
   "max": 52,
   "kind": "dialogue",
   "jp": "おい　お前は\\n何を言っているのか\\nわかってるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d60"
  },
  {
   "id": "m_010001:0x4794c",
   "off": 293196,
   "max": 56,
   "kind": "dialogue",
   "jp": "井伊が去り\\n弱体化したとはいえ\\n相手は幕府の将軍だぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d61"
  },
  {
   "id": "m_010001:0x482d0",
   "off": 295632,
   "max": 20,
   "kind": "dialogue",
   "jp": "だからなんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d62"
  },
  {
   "id": "m_010001:0x482fc",
   "off": 295676,
   "max": 44,
   "kind": "dialogue",
   "jp": "目も鼻も口も耳も\\nついとるヤツなんじゃろ？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d63"
  },
  {
   "id": "m_010001:0x48338",
   "off": 295736,
   "max": 72,
   "kind": "dialogue",
   "jp": "もし将軍様が寂しいと\\n言ってるなら　わしの\\nロックを聴かせてやるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d64"
  },
  {
   "id": "m_010001:0x48a9c",
   "off": 297628,
   "max": 48,
   "kind": "dialogue",
   "jp": "驚いた\\nトサカくんはバカなのか\\n大物なのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d65"
  },
  {
   "id": "m_010001:0x49168",
   "off": 299368,
   "max": 68,
   "kind": "dialogue",
   "jp": "まあ　ここまで来れば\\nそろそろ大物ってことで\\nいいんじゃないですか",
   "en": "",
   "op": "0x62",
   "msg": "0x1d66"
  },
  {
   "id": "m_010001:0x49848",
   "off": 301128,
   "max": 36,
   "kind": "dialogue",
   "jp": "しかし　どうやって\\n将軍に会う？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d67"
  },
  {
   "id": "m_010001:0x49eb0",
   "off": 302768,
   "max": 64,
   "kind": "dialogue",
   "jp": "二条城に踏み入るのか？\\nさすがの勝先生も\\nかばっちゃくれねえぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d68"
  },
  {
   "id": "m_010001:0x4a58c",
   "off": 304524,
   "max": 68,
   "kind": "dialogue",
   "jp": "それとも　忍び込む？\\nでも城ともなると\\nそう簡単にはいかないですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d69"
  },
  {
   "id": "m_010001:0x4ac68",
   "off": 306280,
   "max": 44,
   "kind": "dialogue",
   "jp": "それでなくたって\\nキミ達はお尋ね者なんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d6a"
  },
  {
   "id": "m_010001:0x4aca4",
   "off": 306340,
   "max": 52,
   "kind": "dialogue",
   "jp": "僕らと一緒に行動すること\\n自体が難しいと思うけど",
   "en": "",
   "op": "0x62",
   "msg": "0x1d6b"
  },
  {
   "id": "m_010001:0x4b45c",
   "off": 308316,
   "max": 64,
   "kind": "dialogue",
   "jp": "将軍様に会うにしても\\nわしら全員揃ってなければ\\n意味がないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d6c"
  },
  {
   "id": "m_010001:0x4be08",
   "off": 310792,
   "max": 12,
   "kind": "dialogue",
   "jp": "それだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d6d"
  },
  {
   "id": "m_010001:0x4c5bc",
   "off": 312764,
   "max": 36,
   "kind": "dialogue",
   "jp": "何かいい考えでも\\n思いついたのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d6e"
  },
  {
   "id": "m_010001:0x4cc90",
   "off": 314512,
   "max": 36,
   "kind": "dialogue",
   "jp": "土方さん\\n私達を捕まえてください！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d6f"
  },
  {
   "id": "m_010001:0x4d304",
   "off": 316164,
   "max": 60,
   "kind": "dialogue",
   "jp": "セ　センセー\\n考えすぎて　おかしく\\nなってしまったのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d70"
  },
  {
   "id": "m_010001:0x4d8b4",
   "off": 317620,
   "max": 48,
   "kind": "dialogue",
   "jp": "し　失礼だな\\nおかしくなんて\\nなってません！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d71"
  },
  {
   "id": "m_010001:0x4e08c",
   "off": 319628,
   "max": 32,
   "kind": "dialogue",
   "jp": "なるほど\\n桂の考えはわかった",
   "en": "",
   "op": "0x62",
   "msg": "0x1d72"
  },
  {
   "id": "m_010001:0x4e738",
   "off": 321336,
   "max": 52,
   "kind": "dialogue",
   "jp": "俺と総司が\\nお前達三人を捕らえ\\n二条城に連行する",
   "en": "",
   "op": "0x62",
   "msg": "0x1d73"
  },
  {
   "id": "m_010001:0x4e77c",
   "off": 321404,
   "max": 60,
   "kind": "dialogue",
   "jp": "そういう筋書きか\\n俺達の立場を逆手に\\n取った　うまい手だ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d74"
  },
  {
   "id": "m_010001:0x4eed8",
   "off": 323288,
   "max": 68,
   "kind": "dialogue",
   "jp": "これなら怪しまれずに\\n私達全員が揃ったまま\\n二条城に入れるはずです",
   "en": "",
   "op": "0x62",
   "msg": "0x1d75"
  },
  {
   "id": "m_010001:0x4f5b8",
   "off": 325048,
   "max": 24,
   "kind": "dialogue",
   "jp": "どうする\\n坂本\\n高杉",
   "en": "",
   "op": "0x62",
   "msg": "0x1d76"
  },
  {
   "id": "m_010001:0x4fa4c",
   "off": 326220,
   "max": 68,
   "kind": "dialogue",
   "jp": "まかり間違えば\\n二条城に入る前に斬首――\\nということもありうるが",
   "en": "",
   "op": "0x62",
   "msg": "0x1d77"
  },
  {
   "id": "m_010001:0x500d4",
   "off": 327892,
   "max": 48,
   "kind": "dialogue",
   "jp": "忘れたのか？\\nオレ様達は\\nロックンローラーだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d78"
  },
  {
   "id": "m_010001:0x50114",
   "off": 327956,
   "max": 44,
   "kind": "dialogue",
   "jp": "ノるか　ソるかは\\n望むところだ\\nなあ　龍馬",
   "en": "",
   "op": "0x62",
   "msg": "0x1d79"
  },
  {
   "id": "m_010001:0x507d8",
   "off": 329688,
   "max": 52,
   "kind": "dialogue",
   "jp": "斬首は怖いが\\nそれしかないなら\\nそれしかないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d7a"
  },
  {
   "id": "m_010001:0x5081c",
   "off": 329756,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしは　センセーや\\nヒジゾーさんを信じる\\nだけじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d7b"
  },
  {
   "id": "m_010001:0x51144",
   "off": 332100,
   "max": 56,
   "kind": "dialogue",
   "jp": "井伊が死んで　天歌の\\n脅威はなくなったと\\n思っていたが",
   "en": "",
   "op": "0x62",
   "msg": "0x1d7c"
  },
  {
   "id": "m_010001:0x5118c",
   "off": 332172,
   "max": 32,
   "kind": "dialogue",
   "jp": "どうやら　そうでは\\nなさそうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d7d"
  },
  {
   "id": "m_010001:0x51628",
   "off": 333352,
   "max": 56,
   "kind": "dialogue",
   "jp": "今の京の状態は\\n近藤さんが目指した\\n世の中とは言えん",
   "en": "",
   "op": "0x62",
   "msg": "0x1d7e"
  },
  {
   "id": "m_010001:0x51670",
   "off": 333424,
   "max": 48,
   "kind": "dialogue",
   "jp": "新選組　局長としても\\n見過ごすわけにはいかん",
   "en": "",
   "op": "0x62",
   "msg": "0x1d7f"
  },
  {
   "id": "m_010001:0x516b0",
   "off": 333488,
   "max": 36,
   "kind": "dialogue",
   "jp": "俺の方からも頼む\\n協力して欲しい",
   "en": "",
   "op": "0x62",
   "msg": "0x1d80"
  },
  {
   "id": "m_010001:0x51df0",
   "off": 335344,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしらは仲間じゃろ\\n頭を下げる必要なんて\\nないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d81"
  },
  {
   "id": "m_010001:0x51e34",
   "off": 335412,
   "max": 64,
   "kind": "dialogue",
   "jp": "斬首になったらなったで\\n首から上だけでも\\nロックは歌えるかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x1d82"
  },
  {
   "id": "m_010001:0x524b8",
   "off": 337080,
   "max": 32,
   "kind": "dialogue",
   "jp": "龍馬くんなら\\n歌えそうですねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d83"
  },
  {
   "id": "m_010001:0x52b7c",
   "off": 338812,
   "max": 44,
   "kind": "dialogue",
   "jp": "首を切り落としたら\\n少しはバカが治るかもな",
   "en": "",
   "op": "0x62",
   "msg": "0x1d84"
  },
  {
   "id": "m_010001:0x53284",
   "off": 340612,
   "max": 28,
   "kind": "dialogue",
   "jp": "シンディ！\\nそら酷いぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x1d85"
  },
  {
   "id": "m_010001:0x53aac",
   "off": 342700,
   "max": 16,
   "kind": "dialogue",
   "jp": "……ありがとう",
   "en": "",
   "op": "0x62",
   "msg": "0x1d86"
  },
  {
   "id": "m_010001:0x53acc",
   "off": 342732,
   "max": 40,
   "kind": "dialogue",
   "jp": "この土方歳三\\n何が何でもお前達を――",
   "en": "",
   "op": "0x62",
   "msg": "0x1d87"
  },
  {
   "id": "m_010001:0x543f0",
   "off": 345072,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや　俺達全員で\\n将軍の前に立つと\\n約束しよう",
   "en": "",
   "op": "0x62",
   "msg": "0x1d88"
  },
  {
   "id": "m_010001:0x54c5c",
   "off": 347228,
   "max": 28,
   "kind": "dialogue",
   "jp": "頼んだぜよ\\nヒジゾーさん",
   "en": "",
   "op": "0x62",
   "msg": "0x1d89"
  },
  {
   "id": "m_010001:0x55314",
   "off": 348948,
   "max": 40,
   "kind": "dialogue",
   "jp": "早速　準備を始めよう\\n総司　戻るぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d8a"
  },
  {
   "id": "m_010001:0x559d4",
   "off": 350676,
   "max": 20,
   "kind": "dialogue",
   "jp": "はいっ\\n土方さん！",
   "en": "",
   "op": "0x62",
   "msg": "0x1d8b"
  },
  {
   "id": "m_010001:0x55a90",
   "off": 350864,
   "max": 48,
   "kind": "dialogue",
   "jp": "改めて捕まえに来るから\\n首を洗って待っててね～",
   "en": "",
   "op": "0x62",
   "msg": "0x1d8c"
  },
  {
   "id": "m_010001:0x55f50",
   "off": 352080,
   "max": 44,
   "kind": "dialogue",
   "jp": "土方と沖田は　早足で\\nテラーダを出て行った",
   "en": "",
   "op": "0x62",
   "msg": "0x1d8d"
  },
  {
   "id": "m_010001:0x563c8",
   "off": 353224,
   "max": 40,
   "kind": "dialogue",
   "jp": "ちっ\\n沖田の野郎\\n笑えねえ冗談だぜ……",
   "en": "",
   "op": "0x62",
   "msg": "0x1d8e"
  }
 ]
}
