   "jp": "まあ　任せておけ\\nお前のためじゃなくても\\n絶対に勝つ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5021"
  },
  {
   "id": "m_011002:0x37f90",
   "off": 229264,
   "max": 24,
   "kind": "dialogue",
   "jp": "おう！\\n絶対勝つぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5022"
  },
  {
   "id": "m_011002:0x38a30",
   "off": 231984,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬達が舞台に姿を\\n現すと大きな歓声が\\n起こった",
   "en": "",
   "op": "0x62",
   "msg": "0x5023"
  },
  {
   "id": "m_011002:0x38a74",
   "off": 232052,
   "max": 60,
   "kind": "dialogue",
   "jp": "龍馬達が　天歌から\\n民衆を解放したことは\\nまだ記憶に新しい",
   "en": "",
   "op": "0x62",
   "msg": "0x5024"
  },
  {
   "id": "m_011002:0x38ac0",
   "off": 232128,
   "max": 64,
   "kind": "dialogue",
   "jp": "観客からの\\n心地良い熱気に\\n龍馬達は魂をさらに\\n燃え上がらせた",
   "en": "",
   "op": "0x62",
   "msg": "0x5025"
  },
  {
   "id": "m_011002:0x39094",
   "off": 233620,
   "max": 56,
   "kind": "dialogue",
   "jp": "いける……いけるぜよ\\n今日のお客さんは\\nノリノリぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5026"
  },
  {
   "id": "m_011002:0x39768",
   "off": 235368,
   "max": 36,
   "kind": "dialogue",
   "jp": "ああ　この空気　\\nヒリヒリするぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x5027"
  },
  {
   "id": "m_011002:0x39e28",
   "off": 237096,
   "max": 52,
   "kind": "dialogue",
   "jp": "行きましょう　二人とも\\n私達のロックを\\n響かせに！",
   "en": "",
   "op": "0x62",
   "msg": "0x5028"
  },
  {
   "id": "m_011002:0x3aaa4",
   "off": 240292,
   "max": 60,
   "kind": "dialogue",
   "jp": "わたしの声は小さくて\\nまだまだ　世界の皆には\\n届けられない",
   "en": "",
   "op": "0x62",
   "msg": "0x5029"
  },
  {
   "id": "m_011002:0x3ab8c",
   "off": 240524,
   "max": 52,
   "kind": "dialogue",
   "jp": "だけど明日は\\nきっと未来来る！\\nだから付いてきて！",
   "en": "",
   "op": "0x62",
   "msg": "0x502a"
  },
  {
   "id": "m_011002:0x3ac6c",
   "off": 240748,
   "max": 60,
   "kind": "dialogue",
   "jp": "ハイスピードで！\\n駆け抜けるよ\\n烈！　ロックンロール！",
   "en": "",
   "op": "0x62",
   "msg": "0x502b"
  },
  {
   "id": "m_011002:0x3b500",
   "off": 242944,
   "max": 60,
   "kind": "dialogue",
   "jp": "ヤバイ　来たぜ来たぜ……\\nオレの中で\\nなんかが雷光した",
   "en": "",
   "op": "0x62",
   "msg": "0x502c"
  },
  {
   "id": "m_011002:0x3b54c",
   "off": 243020,
   "max": 36,
   "kind": "dialogue",
   "jp": "来い来い　来い\\nクールに行くぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x502d"
  },
  {
   "id": "m_011002:0x3b61c",
   "off": 243228,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレ様の歌で\\nてめーら昇天せてやる",
   "en": "",
   "op": "0x62",
   "msg": "0x502e"
  },
  {
   "id": "m_011002:0x3be98",
   "off": 245400,
   "max": 56,
   "kind": "dialogue",
   "jp": "よし！\\n燃えてきた燃えてきた\\n燃えてきたぜよぉぉぉぉ！",
   "en": "",
   "op": "0x62",
   "msg": "0x502f"
  },
  {
   "id": "m_011002:0x3c084",
   "off": 245892,
   "max": 28,
   "kind": "dialogue",
   "jp": "わしの中で\\n何かが迸るっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5030"
  },
  {
   "id": "m_011002:0x3c0b0",
   "off": 245936,
   "max": 36,
   "kind": "dialogue",
   "jp": "みんなに届けたいと\\n叫んでるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5031"
  },
  {
   "id": "m_011002:0x3c0e4",
   "off": 245988,
   "max": 68,
   "kind": "dialogue",
   "jp": "シャウト　シャウト\\nシャウトぉぉ！\\nわしのロックを\\n聴くぜよぉぉ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5032"
  }
 ]
}
