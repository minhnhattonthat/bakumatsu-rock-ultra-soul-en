{
 "source": "m_011002.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_011002:0x12b8",
   "off": 4792,
   "max": 68,
   "kind": "dialogue",
   "jp": "――江戸城　月明かりの下\\n勝海舟と徳川慶喜は\\n顔を付き合わせていた",
   "en": "",
   "op": "0x62",
   "msg": "0x4f94"
  },
  {
   "id": "m_011002:0x130c",
   "off": 4876,
   "max": 20,
   "kind": "dialogue",
   "jp": "その顔は……暗い",
   "en": "",
   "op": "0x62",
   "msg": "0x4f95"
  },
  {
   "id": "m_011002:0x18a4",
   "off": 6308,
   "max": 40,
   "kind": "dialogue",
   "jp": "……龍馬達に言わなくて\\n良かったのかな",
   "en": "",
   "op": "0x62",
   "msg": "0x4f96"
  },
  {
   "id": "m_011002:0x1d48",
   "off": 7496,
   "max": 20,
   "kind": "dialogue",
   "jp": "何を……でしょうか",
   "en": "",
   "op": "0x62",
   "msg": "0x4f97"
  },
  {
   "id": "m_011002:0x25fc",
   "off": 9724,
   "max": 48,
   "kind": "dialogue",
   "jp": "ペリージュニアが超魂の\\n持ち主であることだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x4f98"
  },
  {
   "id": "m_011002:0x263c",
   "off": 9788,
   "max": 32,
   "kind": "dialogue",
   "jp": "感じるんだ\\n尋常じゃない力を",
   "en": "",
   "op": "0x62",
   "msg": "0x4f99"
  },
  {
   "id": "m_011002:0x2eb8",
   "off": 11960,
   "max": 56,
   "kind": "dialogue",
   "jp": "慶喜様　今は彼らに\\n戦ってもらうより他\\nありますまい",
   "en": "",
   "op": "0x62",
   "msg": "0x4f9a"
  },
  {
   "id": "m_011002:0x336c",
   "off": 13164,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x4f9b"
  },
  {
   "id": "m_011002:0x3c68",
   "off": 15464,
   "max": 48,
   "kind": "dialogue",
   "jp": "信じましょう\\n彼らはあなた様を\\n救いだした志士",
   "en": "",
   "op": "0x62",
   "msg": "0x4f9c"
  },
  {
   "id": "m_011002:0x3ca8",
   "off": 15528,
   "max": 36,
   "kind": "dialogue",
   "jp": "あとは\\n出たとこ勝負……\\nですかな",
   "en": "",
   "op": "0x62",
   "msg": "0x4f9d"
  },
  {
   "id": "m_011002:0x452c",
   "off": 17708,
   "max": 36,
   "kind": "dialogue",
   "jp": "うん……\\nそうだね\\n彼らを信じよう",
   "en": "",
   "op": "0x62",
   "msg": "0x4f9e"
  },
  {
   "id": "m_011002:0x4cac",
   "off": 19628,
   "max": 48,
   "kind": "dialogue",
   "jp": "勝海舟が去った後\\n慶喜は不安げに\\n月を見上げた",
   "en": "",
   "op": "0x62",
   "msg": "0x4f9f"
  },
  {
   "id": "m_011002:0x4cec",
   "off": 19692,
   "max": 56,
   "kind": "dialogue",
   "jp": "このように心細い時\\nそばにいてくれた直弼は\\nもういない",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa0"
  },
  {
   "id": "m_011002:0x4d34",
   "off": 19764,
   "max": 48,
   "kind": "dialogue",
   "jp": "慶喜は　ただ龍馬達の\\n勝利を祈るしかなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa1"
  },
  {
   "id": "m_011002:0x506c",
   "off": 20588,
   "max": 40,
   "kind": "dialogue",
   "jp": "直弼……\\nみんなを\\n助けてあげて……",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa2"
  },
  {
   "id": "m_011002:0x5444",
   "off": 21572,
   "max": 44,
   "kind": "dialogue",
   "jp": "祈りを捧げる慶喜を\\n月だけが見下ろしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa3"
  },
  {
   "id": "m_011002:0x5d44",
   "off": 23876,
   "max": 60,
   "kind": "dialogue",
   "jp": "おっしゃ～！　\\n雷舞じゃ　雷舞じゃ\\nワクワクしてきたぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa4"
  },
  {
   "id": "m_011002:0x6a0c",
   "off": 27148,
   "max": 60,
   "kind": "dialogue",
   "jp": "うろうろすんじゃねえ\\n落ち着いていられねえのか\\nテメェは",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa5"
  },
  {
   "id": "m_011002:0x71e4",
   "off": 29156,
   "max": 56,
   "kind": "dialogue",
   "jp": "そう言う晋作こそ\\nずいぶんそわそわして\\n見えますが？",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa6"
  },
  {
   "id": "m_011002:0x7c08",
   "off": 31752,
   "max": 44,
   "kind": "dialogue",
   "jp": "そっそそんなことはねえよ\\nかかか桂さん！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa7"
  },
  {
   "id": "m_011002:0x80b0",
   "off": 32944,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんじゃ　シンディ\\n緊張しとるんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa8"
  },
  {
   "id": "m_011002:0x80e8",
   "off": 33000,
   "max": 64,
   "kind": "dialogue",
   "jp": "そう言うときはこう手に\\n人って書いてだな\\n飲み込むといいぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x4fa9"
  },
  {
   "id": "m_011002:0x863c",
   "off": 34364,
   "max": 12,
   "kind": "dialogue",
   "jp": "ほれほれ",
   "en": "",
   "op": "0x62",
   "msg": "0x4faa"
  },
  {
   "id": "m_011002:0x8d74",
   "off": 36212,
   "max": 48,
   "kind": "dialogue",
   "jp": "バカっ！　\\n今さらオレ様が雷舞で\\n緊張するか！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fab"
  },
  {
   "id": "m_011002:0x8db4",
   "off": 36276,
   "max": 56,
   "kind": "dialogue",
   "jp": "っつうか　テメェの手を\\n押しつけてくるな！\\n汗くせえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fac"
  },
  {
   "id": "m_011002:0x9300",
   "off": 37632,
   "max": 28,
   "kind": "dialogue",
   "jp": "汗くさいのは\\n特訓の証ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x4fad"
  },
  {
   "id": "m_011002:0x9834",
   "off": 38964,
   "max": 40,
   "kind": "dialogue",
   "jp": "だったらオレ様の\\n手の方がくさいはずだ",
   "en": "",
   "op": "0x62",
   "msg": "0x4fae"
  },
  {
   "id": "m_011002:0x9d78",
   "off": 40312,
   "max": 36,
   "kind": "dialogue",
   "jp": "どれ……くんくん\\nうわっ　くさっ",
   "en": "",
   "op": "0x62",
   "msg": "0x4faf"
  },
  {
   "id": "m_011002:0xa3f4",
   "off": 41972,
   "max": 12,
   "kind": "dialogue",
   "jp": "なんだと",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb0"
  },
  {
   "id": "m_011002:0xabfc",
   "off": 44028,
   "max": 44,
   "kind": "dialogue",
   "jp": "二人とも\\n少しは落ち着いたら\\nどうです",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb1"
  },
  {
   "id": "m_011002:0xb44c",
   "off": 46156,
   "max": 56,
   "kind": "dialogue",
   "jp": "まったく……\\n雷舞の前だというのに　\\n何をふざけている",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb2"
  },
  {
   "id": "m_011002:0xbd14",
   "off": 48404,
   "max": 48,
   "kind": "dialogue",
   "jp": "相手は\\nあのジュニアだってのに\\n余裕だねぇ～",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb3"
  },
  {
   "id": "m_011002:0xc468",
   "off": 50280,
   "max": 52,
   "kind": "dialogue",
   "jp": "ヒジゾーさんにソウちん！\\n二人も雷舞に出るんか",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb4"
  },
  {
   "id": "m_011002:0xcc78",
   "off": 52344,
   "max": 32,
   "kind": "dialogue",
   "jp": "いや　俺達は雷舞の\\n警備係だ",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb5"
  },
  {
   "id": "m_011002:0xd1ac",
   "off": 53676,
   "max": 48,
   "kind": "dialogue",
   "jp": "だるいんだよね～\\nはぁ……\\nサボっちゃおかな",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb6"
  },
  {
   "id": "m_011002:0xd808",
   "off": 55304,
   "max": 44,
   "kind": "dialogue",
   "jp": "真面目にやれ　総司\\nこれも立派なお役目だぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb7"
  },
  {
   "id": "m_011002:0xdde8",
   "off": 56808,
   "max": 40,
   "kind": "dialogue",
   "jp": "はいはい　土方さんは\\n真面目だなぁ～",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb8"
  },
  {
   "id": "m_011002:0xe438",
   "off": 58424,
   "max": 72,
   "kind": "dialogue",
   "jp": "いいこにしてますから\\n後でごほうびに甘～いもの\\n食べに行きましょうね",
   "en": "",
   "op": "0x62",
   "msg": "0x4fb9"
  },
  {
   "id": "m_011002:0xebec",
   "off": 60396,
   "max": 24,
   "kind": "dialogue",
   "jp": "なっ\\nお前はまた……",
   "en": "",
   "op": "0x62",
   "msg": "0x4fba"
  },
  {
   "id": "m_011002:0xf118",
   "off": 61720,
   "max": 68,
   "kind": "dialogue",
   "jp": "いいじゃないですか\\n土方さんだって　苺慶喜\\n気に入ってるでしょ？",
   "en": "",
   "op": "0x62",
   "msg": "0x4fbb"
  },
  {
   "id": "m_011002:0xf8e0",
   "off": 63712,
   "max": 56,
   "kind": "dialogue",
   "jp": "ヒジゾーさんも\\n苺慶喜好きなんか？\\nあれはうまいなぁ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fbc"
  },
  {
   "id": "m_011002:0x102a8",
   "off": 66216,
   "max": 52,
   "kind": "dialogue",
   "jp": "い　いや　俺は別に……\\n総司が無理矢理にだな……",
   "en": "",
   "op": "0x62",
   "msg": "0x4fbd"
  },
  {
   "id": "m_011002:0x10ba8",
   "off": 68520,
   "max": 60,
   "kind": "dialogue",
   "jp": "恥ずかしがらなくても\\nいいじゃないですか\\n私も好きですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x4fbe"
  },
  {
   "id": "m_011002:0x11060",
   "off": 69728,
   "max": 60,
   "kind": "dialogue",
   "jp": "けっ　あんなもん\\nロックじゃねえ！\\n激辛こそロックだぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fbf"
  },
  {
   "id": "m_011002:0x116f4",
   "off": 71412,
   "max": 44,
   "kind": "dialogue",
   "jp": "だからって慶喜にまで\\n唐辛子をかけなくても",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc0"
  },
  {
   "id": "m_011002:0x11fa0",
   "off": 73632,
   "max": 48,
   "kind": "dialogue",
   "jp": "うわ　気持ち悪っ\\nスカシくん\\n味覚は大丈夫？",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc1"
  },
  {
   "id": "m_011002:0x127e8",
   "off": 75752,
   "max": 36,
   "kind": "dialogue",
   "jp": "うるせぇっ！\\n唐辛子はロックだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc2"
  },
  {
   "id": "m_011002:0x130fc",
   "off": 78076,
   "max": 44,
   "kind": "dialogue",
   "jp": "ところで　じゅにあは\\nどこにおるんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc3"
  },
  {
   "id": "m_011002:0x13138",
   "off": 78136,
   "max": 48,
   "kind": "dialogue",
   "jp": "雷舞の前に\\nいっちょ挨拶して\\nおきたいんじゃが",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc4"
  },
  {
   "id": "m_011002:0x1394c",
   "off": 80204,
   "max": 40,
   "kind": "dialogue",
   "jp": "ジュニアに挨拶？\\nそれ　面白そうだね",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc5"
  },
  {
   "id": "m_011002:0x13df0",
   "off": 81392,
   "max": 56,
   "kind": "dialogue",
   "jp": "そうだな\\n雷舞前に顔合わせは\\nしておいた方がいいだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc6"
  },
  {
   "id": "m_011002:0x13e38",
   "off": 81464,
   "max": 16,
   "kind": "dialogue",
   "jp": "俺が案内しよう",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc7"
  },
  {
   "id": "m_011002:0x146dc",
   "off": 83676,
   "max": 104,
   "kind": "dialogue",
   "jp": "土方に案内された先には\\nまるでそこが自分の城で\\nあるかのごとく\\n傲慢に　そして尊大に\\nくつろぐ男がいた",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc8"
  },
  {
   "id": "m_011002:0x14754",
   "off": 83796,
   "max": 68,
   "kind": "dialogue",
   "jp": "その後ろには\\nまるで影のように\\n一人のギタリストが\\n付き添っている",
   "en": "",
   "op": "0x62",
   "msg": "0x4fc9"
  },
  {
   "id": "m_011002:0x14e5c",
   "off": 85596,
   "max": 12,
   "kind": "dialogue",
   "jp": "頼もーう！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fca"
  },
  {
   "id": "m_011002:0x1588c",
   "off": 88204,
   "max": 12,
   "kind": "dialogue",
   "jp": "……誰だ？",
   "en": "",
   "op": "0x62",
   "msg": "0x4fcb"
  },
  {
   "id": "m_011002:0x16198",
   "off": 90520,
   "max": 56,
   "kind": "dialogue",
   "jp": "ジュニア殿　彼らは今日\\n貴殿と競演する\\n志士である……",
   "en": "",
   "op": "0x62",
   "msg": "0x4fcc"
  },
  {
   "id": "m_011002:0x166e4",
   "off": 91876,
   "max": 32,
   "kind": "dialogue",
   "jp": "オッケーオッケー\\nオレの前座ね",
   "en": "",
   "op": "0x62",
   "msg": "0x4fcd"
  },
  {
   "id": "m_011002:0x16dfc",
   "off": 93692,
   "max": 44,
   "kind": "dialogue",
   "jp": "ぜ　前座だとっ\\nテメェ　何様のつもりだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fce"
  },
  {
   "id": "m_011002:0x172ac",
   "off": 94892,
   "max": 24,
   "kind": "dialogue",
   "jp": "ペリージュニア様だが？",
   "en": "",
   "op": "0x62",
   "msg": "0x4fcf"
  },
  {
   "id": "m_011002:0x17740",
   "off": 96064,
   "max": 16,
   "kind": "dialogue",
   "jp": "この野郎……！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd0"
  },
  {
   "id": "m_011002:0x17ec8",
   "off": 97992,
   "max": 28,
   "kind": "dialogue",
   "jp": "ストップ\\n近づくな　ゴミ共",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd1"
  },
  {
   "id": "m_011002:0x18508",
   "off": 99592,
   "max": 12,
   "kind": "dialogue",
   "jp": "テメェ！",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd2"
  },
  {
   "id": "m_011002:0x18ef8",
   "off": 102136,
   "max": 44,
   "kind": "dialogue",
   "jp": "晋作　落ち着いて\\n今は挨拶に来たんですから",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd3"
  },
  {
   "id": "m_011002:0x193a0",
   "off": 103328,
   "max": 36,
   "kind": "dialogue",
   "jp": "おう　そうじゃった！\\nわしらは……",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd4"
  },
  {
   "id": "m_011002:0x19b48",
   "off": 105288,
   "max": 44,
   "kind": "dialogue",
   "jp": "ゴミの名前なんて\\nどうでもいい\\n無意味だ",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd5"
  },
  {
   "id": "m_011002:0x19b84",
   "off": 105348,
   "max": 24,
   "kind": "dialogue",
   "jp": "それより美女はどこだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd6"
  },
  {
   "id": "m_011002:0x19bac",
   "off": 105388,
   "max": 56,
   "kind": "dialogue",
   "jp": "とびっきりの\\nヤマトナデシコ以外と\\n話をする気はない",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd7"
  },
  {
   "id": "m_011002:0x19bf4",
   "off": 105460,
   "max": 20,
   "kind": "dialogue",
   "jp": "そう伝えたはずだ",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd8"
  },
  {
   "id": "m_011002:0x1a4f8",
   "off": 107768,
   "max": 64,
   "kind": "dialogue",
   "jp": "テメェ　ふざけてるのか！\\nオレ様達をゴミ扱い\\nしやがって……",
   "en": "",
   "op": "0x62",
   "msg": "0x4fd9"
  },
  {
   "id": "m_011002:0x1adbc",
   "off": 110012,
   "max": 40,
   "kind": "dialogue",
   "jp": "うふふふ\\n思った通り\\n面白くなってきた",
   "en": "",
   "op": "0x62",
   "msg": "0x4fda"
  },
  {
