  },
  {
   "id": "m_011003:0x87ec",
   "off": 34796,
   "max": 28,
   "kind": "dialogue",
   "jp": "オーライ！\\nレディたち！",
   "en": "",
   "op": "0x62",
   "msg": "0x5044"
  },
  {
   "id": "m_011003:0x88b0",
   "off": 34992,
   "max": 32,
   "kind": "dialogue",
   "jp": "控え室で\\nずっと寂しかったよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5045"
  },
  {
   "id": "m_011003:0x8978",
   "off": 35192,
   "max": 44,
   "kind": "dialogue",
   "jp": "君達にラブを\\n伝えたくて\\nたまらないんだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5046"
  },
  {
   "id": "m_011003:0x9520",
   "off": 38176,
   "max": 40,
   "kind": "dialogue",
   "jp": "受け止めてくれ\\nマイスイートハート！",
   "en": "",
   "op": "0x62",
   "msg": "0x5047"
  },
  {
   "id": "m_011003:0x9558",
   "off": 38232,
   "max": 60,
   "kind": "dialogue",
   "jp": "オレのホットで\\nスパイシーなラブを\\nレディに捧げるよ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x5048"
  }
