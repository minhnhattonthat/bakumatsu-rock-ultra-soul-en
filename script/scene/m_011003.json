   "max": 28,
   "kind": "dialogue",
   "jp": "ああ　Ｊ\\nバトルタイムだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5042"
  },
  {
   "id": "m_011003:0x7f30",
