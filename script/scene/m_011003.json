 "entries": [
  {
   "id": "m_011003:0x1468",
   "off": 5224,
   "max": 28,
   "kind": "dialogue",
   "jp": "よしっ\\n手応えあったぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5033"
  },
  {
   "id": "m_011003:0x1b20",
   "off": 6944,
   "max": 44,
   "kind": "dialogue",
   "jp": "ええ　最高の演奏が\\n出来たと思いますよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5034"
  },
  {
   "id": "m_011003:0x21e4",
   "off": 8676,
   "max": 52,
   "kind": "dialogue",
   "jp": "はぁ～　やっぱ雷舞は\\n気持ちいいな！\\n最高ぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5035"
  },
  {
   "id": "m_011003:0x29ac",
   "off": 10668,
   "max": 40,
   "kind": "dialogue",
   "jp": "オーケー　オーケー\\nいいんじゃないか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5036"
  },
  {
   "id": "m_011003:0x2a7c",
   "off": 10876,
   "max": 56,
   "kind": "dialogue",
   "jp": "マトモに楽器が\\n弾けるんだな\\n曲芸としてはなかなかだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5037"
  },
  {
   "id": "m_011003:0x3294",
   "off": 12948,
   "max": 56,
   "kind": "dialogue",
   "jp": "おっ　ホントか\\nじゅにあに褒められると\\n照れるなぁ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5038"
  },
  {
   "id": "m_011003:0x32dc",
   "off": 13020,
   "max": 40,
   "kind": "dialogue",
   "jp": "ロックを好きな者同士\\nもうダチぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5039"
  },
  {
   "id": "m_011003:0x3c0c",
   "off": 15372,
   "max": 40,
   "kind": "dialogue",
   "jp": "ロックを好きな者？\\nユーはモンキーだ",
   "en": "",
   "op": "0x62",
   "msg": "0x503a"
  },
  {
   "id": "m_011003:0x4504",
   "off": 17668,
   "max": 20,
   "kind": "dialogue",
   "jp": "へ？\\nもんきぃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x503b"
  },
  {
   "id": "m_011003:0x4b58",
   "off": 19288,
   "max": 48,
   "kind": "dialogue",
   "jp": "ロックとは神の音楽\\n奏でることが許されるのは",
   "en": "",
   "op": "0x62",
   "msg": "0x503c"
  },
  {
   "id": "m_011003:0x56e8",
   "off": 22248,
   "max": 44,
   "kind": "dialogue",
   "jp": "ロックスター\\nそう　神である\\nオレだけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x503d"
  },
  {
   "id": "m_011003:0x60f0",
   "off": 24816,
   "max": 12,
   "kind": "dialogue",
   "jp": "なんだと！",
   "en": "",
   "op": "0x62",
   "msg": "0x503e"
  },
  {
   "id": "m_011003:0x65fc",
   "off": 26108,
   "max": 68,
   "kind": "dialogue",
   "jp": "龍馬のバカはともかく\\nオレ様達のロックを\\n悪く言うのは許さねぇ！",
   "en": "",
   "op": "0x62",
   "msg": "0x503f"
  },
  {
   "id": "m_011003:0x6e18",
   "off": 28184,
   "max": 28,
   "kind": "dialogue",
   "jp": "ああ　そう\\n大体オッケー",
   "en": "",
   "op": "0x62",
   "msg": "0x5040"
  },
  {
   "id": "m_011003:0x73bc",
   "off": 29628,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
