{
 "source": "m_011004.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_011004:0x129c",
   "off": 4764,
   "max": 44,
   "kind": "dialogue",
   "jp": "龍馬達の演奏以上の\\n大歓声が会場を包んだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5049"
  },
  {
   "id": "m_011004:0x12d8",
   "off": 4824,
   "max": 60,
   "kind": "dialogue",
   "jp": "もはや熱気は　会場が\\n燃え上がりそうなほど\\n高まっている",
   "en": "",
   "op": "0x62",
   "msg": "0x504a"
  },
  {
   "id": "m_011004:0x1a5c",
   "off": 6748,
   "max": 32,
   "kind": "dialogue",
   "jp": "ぎゃあああ！\\nジュニア様ー！",
   "en": "",
   "op": "0x62",
   "msg": "0x504b"
  },
  {
   "id": "m_011004:0x1ef8",
   "off": 7928,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああっ　ダメ……\\n私　もう立ってられない",
   "en": "",
   "op": "0x62",
   "msg": "0x504c"
  },
  {
   "id": "m_011004:0x2844",
   "off": 10308,
   "max": 28,
   "kind": "dialogue",
   "jp": "ジューニアー\\nうおおお",
   "en": "",
   "op": "0x62",
   "msg": "0x504d"
  },
  {
   "id": "m_011004:0x2cdc",
   "off": 11484,
   "max": 44,
   "kind": "dialogue",
   "jp": "坂本達もすげえけど\\nやっぱ格が違うぜ……",
   "en": "",
   "op": "0x62",
   "msg": "0x504e"
  },
  {
   "id": "m_011004:0x392c",
   "off": 14636,
   "max": 48,
   "kind": "dialogue",
   "jp": "ハートで理解しただろう\\nオレこそがロックスター",
   "en": "",
   "op": "0x62",
   "msg": "0x504f"
  },
  {
   "id": "m_011004:0x3974",
   "off": 14708,
   "max": 28,
   "kind": "dialogue",
   "jp": "イッツ\\nロケンロゥーッ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5050"
  },
  {
   "id": "m_011004:0x44a4",
   "off": 17572,
   "max": 56,
   "kind": "dialogue",
   "jp": "オレ様達のは\\nロックじゃねえって\\n言いたいのかよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5051"
  },
  {
   "id": "m_011004:0x4958",
   "off": 18776,
   "max": 52,
   "kind": "dialogue",
   "jp": "ですが　晋作\\nあの演奏の前では\\nそう言われても……",
   "en": "",
   "op": "0x62",
   "msg": "0x5052"
  },
  {
   "id": "m_011004:0x4e08",
   "off": 19976,
   "max": 12,
   "kind": "dialogue",
   "jp": "くっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5053"
  },
  {
   "id": "m_011004:0x5598",
   "off": 21912,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや……\\n実際すごい演奏じゃ\\n世界は広いぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5054"
  },
  {
   "id": "m_011004:0x5c0c",
   "off": 23564,
   "max": 52,
   "kind": "dialogue",
   "jp": "感心してる場合か！\\nこのままじゃ\\n負けちまうぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5055"
  },
  {
   "id": "m_011004:0x60bc",
   "off": 24764,
   "max": 56,
   "kind": "dialogue",
   "jp": "あっ　そうか\\nいや　でも　ホントに\\nすごかったぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5056"
  },
  {
   "id": "m_011004:0x6610",
   "off": 26128,
   "max": 44,
   "kind": "dialogue",
   "jp": "じゅにあ\\n後でサインとか\\nくれないかなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x5057"
  },
  {
   "id": "m_011004:0x6d08",
   "off": 27912,
   "max": 52,
   "kind": "dialogue",
   "jp": "敵にサインもらって\\nどうする！\\nバカか　お前は！",
   "en": "",
   "op": "0x62",
   "msg": "0x5058"
  },
  {
   "id": "m_011004:0x73d8",
   "off": 29656,
   "max": 36,
   "kind": "dialogue",
   "jp": "さすが龍馬くんは\\n大物ですね……",
   "en": "",
   "op": "0x62",
   "msg": "0x5059"
  },
  {
   "id": "m_011004:0x7bf0",
   "off": 31728,
   "max": 36,
   "kind": "dialogue",
   "jp": "次の曲　行こうか\\nアーユーレディ？",
   "en": "",
   "op": "0x62",
   "msg": "0x505a"
  },
  {
   "id": "m_011004:0x8438",
   "off": 33848,
   "max": 60,
   "kind": "dialogue",
   "jp": "ジュニアがマイクを\\n持つだけで地が揺れるほど\\n歓声が起きた",
   "en": "",
   "op": "0x62",
   "msg": "0x505b"
  },
  {
   "id": "m_011004:0x8484",
   "off": 33924,
   "max": 68,
   "kind": "dialogue",
   "jp": "人々の熱狂は高まり　魂を\\nジュニアに奪われたように\\n陶然としている",
   "en": "",
   "op": "0x62",
   "msg": "0x505c"
  },
  {
   "id": "m_011004:0x84d8",
   "off": 34008,
   "max": 48,
   "kind": "dialogue",
   "jp": "その圧倒的な魂の音に\\n高杉たちも聴き惚れかけた",
   "en": "",
   "op": "0x62",
   "msg": "0x505d"
  },
  {
   "id": "m_011004:0x8be0",
   "off": 35808,
   "max": 68,
   "kind": "dialogue",
   "jp": "何をぼんやりしている！\\n貴様らがここで負けたら\\n日本はどうなる！",
   "en": "",
   "op": "0x62",
   "msg": "0x505e"
  },
  {
   "id": "m_011004:0x90a0",
   "off": 37024,
   "max": 52,
   "kind": "dialogue",
   "jp": "そうだよ！\\nそれに僕の貞操も\\nピンチなんだけど",
   "en": "",
   "op": "0x62",
   "msg": "0x505f"
  },
  {
   "id": "m_011004:0x9860",
   "off": 39008,
   "max": 16,
   "kind": "dialogue",
   "jp": "そうじゃった！",
   "en": "",
   "op": "0x62",
   "msg": "0x5060"
  },
  {
   "id": "m_011004:0xa050",
   "off": 41040,
   "max": 72,
   "kind": "dialogue",
   "jp": "沖田の貞操は知らねえが\\nあいつに日本を好き勝手\\nさせるわけにはいかねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x5061"
  },
  {
   "id": "m_011004:0xa514",
   "off": 42260,
   "max": 36,
   "kind": "dialogue",
   "jp": "藁で巻かれるなんて\\nごめんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5062"
  },
  {
   "id": "m_011004:0xacbc",
   "off": 44220,
   "max": 52,
   "kind": "dialogue",
   "jp": "そ　そうじゃった\\nそんなんじゃ\\n風邪を引くぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5063"
  },
  {
   "id": "m_011004:0xb330",
   "off": 45872,
   "max": 44,
   "kind": "dialogue",
   "jp": "トサカくんはバカだから\\n引かなそうだけど",
   "en": "",
   "op": "0x62",
   "msg": "0x5064"
  },
  {
   "id": "m_011004:0xb984",
   "off": 47492,
   "max": 24,
   "kind": "dialogue",
   "jp": "何故か夏には引くんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x5065"
  },
  {
   "id": "m_011004:0xbf58",
   "off": 48984,
   "max": 36,
   "kind": "dialogue",
   "jp": "……それってやっぱり\\nバカなんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x5066"
  },
  {
   "id": "m_011004:0xc704",
   "off": 50948,
   "max": 48,
   "kind": "dialogue",
   "jp": "龍馬がバカなのは\\n今さらだろう！\\nそれより！",
   "en": "",
   "op": "0x62",
   "msg": "0x5067"
  },
  {
   "id": "m_011004:0xcf10",
   "off": 53008,
   "max": 44,
   "kind": "dialogue",
   "jp": "ああ　俺達も力を貸す\\n今度は五人で行くぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x5068"
  },
  {
   "id": "m_011004:0xd3b8",
   "off": 54200,
   "max": 40,
   "kind": "dialogue",
   "jp": "やっぱり僕がいないと\\nダメなんだから",
   "en": "",
   "op": "0x62",
   "msg": "0x5069"
  },
  {
   "id": "m_011004:0xdb68",
   "off": 56168,
   "max": 52,
   "kind": "dialogue",
   "jp": "くやしいですが\\n今は言い返せませんね\\nお願いします",
   "en": "",
   "op": "0x62",
   "msg": "0x506a"
  },
  {
   "id": "m_011004:0xe3a8",
   "off": 58280,
   "max": 56,
   "kind": "dialogue",
   "jp": "よっしゃあ！\\nわしら超魂團の\\nロックをぶつけるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x506b"
  },
  {
   "id": "m_011004:0xec4c",
   "off": 60492,
   "max": 24,
   "kind": "dialogue",
   "jp": "よし　行くぞ\\n龍馬っ！",
   "en": "",
   "op": "0x62",
   "msg": "0x506c"
  },
  {
   "id": "m_011004:0xf334",
   "off": 62260,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬のギターソロを最初に\\n五人の超魂が輝き始める",
   "en": "",
   "op": "0x62",
   "msg": "0x506d"
  },
  {
   "id": "m_011004:0x10940",
   "off": 67904,
   "max": 48,
   "kind": "dialogue",
   "jp": "じゅにあーっっ！\\nわしらのロックも\\n聴くぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x506e"
  },
  {
   "id": "m_011004:0x1110c",
   "off": 69900,
   "max": 24,
   "kind": "dialogue",
   "jp": "ん？\\nまだいたのか……",
   "en": "",
   "op": "0x62",
   "msg": "0x506f"
  },
  {
   "id": "m_011004:0x11934",
   "off": 71988,
   "max": 16,
   "kind": "dialogue",
   "jp": "勝ちに来たぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5070"
  },
  {
   "id": "m_011004:0x12060",
   "off": 73824,
   "max": 32,
   "kind": "dialogue",
   "jp": "確かにお前のロックは\\nすごい",
   "en": "",
   "op": "0x62",
   "msg": "0x5071"
  },
  {
   "id": "m_011004:0x12090",
   "off": 73872,
   "max": 28,
   "kind": "dialogue",
   "jp": "熱い魂を\\n熱情を感じる！",
   "en": "",
   "op": "0x62",
   "msg": "0x5072"
  },
  {
   "id": "m_011004:0x12890",
   "off": 75920,
   "max": 64,
   "kind": "dialogue",
   "jp": "だが　わしらだって\\nロックを愛する心では\\n負けていないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5073"
  },
  {
   "id": "m_011004:0x1335c",
   "off": 78684,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああ\\nその通りだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5074"
  },
  {
   "id": "m_011004:0x137ec",
   "off": 79852,
   "max": 28,
   "kind": "dialogue",
   "jp": "まだ勝負は\\nついていません",
   "en": "",
   "op": "0x62",
   "msg": "0x5075"
  },
  {
   "id": "m_011004:0x140d0",
   "off": 82128,
   "max": 20,
   "kind": "dialogue",
   "jp": "今度は俺達もいる",
   "en": "",
   "op": "0x62",
   "msg": "0x5076"
  },
  {
   "id": "m_011004:0x14560",
   "off": 83296,
   "max": 24,
   "kind": "dialogue",
   "jp": "全力でいっちゃうよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5077"
  },
  {
   "id": "m_011004:0x15048",
   "off": 86088,
   "max": 20,
   "kind": "dialogue",
   "jp": "ほう……！\\n超魂か",
   "en": "",
   "op": "0x62",
   "msg": "0x5078"
  },
  {
   "id": "m_011004:0x157a8",
   "off": 87976,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x5079"
  },
  {
   "id": "m_011004:0x15ce0",
   "off": 89312,
   "max": 16,
   "kind": "dialogue",
   "jp": "ドンウォリ\\nＪ",
   "en": "",
   "op": "0x62",
   "msg": "0x507a"
  },
  {
   "id": "m_011004:0x15d00",
   "off": 89344,
   "max": 48,
   "kind": "dialogue",
   "jp": "それでも　連中は\\nオレの引き立て役に\\n過ぎん",
   "en": "",
   "op": "0x62",
   "msg": "0x507b"
  },
  {
   "id": "m_011004:0x15d40",
   "off": 89408,
   "max": 16,
   "kind": "dialogue",
   "jp": "何故なら――",
   "en": "",
   "op": "0x62",
   "msg": "0x507c"
  },
  {
   "id": "m_011004:0x1685c",
   "off": 92252,
   "max": 32,
   "kind": "dialogue",
   "jp": "オレがロック\\nオレこそがロック",
   "en": "",
   "op": "0x62",
   "msg": "0x507d"
  },
  {
   "id": "m_011004:0x16894",
   "off": 92308,
   "max": 56,
   "kind": "dialogue",
   "jp": "前座の出番はそこまでだ\\n次はオレの曲を\\n聴かせてやる",
   "en": "",
   "op": "0x62",
   "msg": "0x507e"
  },
  {
   "id": "m_011004:0x168dc",
   "off": 92380,
   "max": 28,
   "kind": "dialogue",
   "jp": "イッツ\\nロケンロゥーッ！",
   "en": "",
   "op": "0x62",
   "msg": "0x507f"
  },
  {
   "id": "m_011004:0x17400",
   "off": 95232,
   "max": 28,
   "kind": "dialogue",
   "jp": "眩しく輝く\\n龍馬達の超魂",
   "en": "",
   "op": "0x62",
   "msg": "0x5080"
  },
  {
   "id": "m_011004:0x1742c",
   "off": 95276,
   "max": 52,
   "kind": "dialogue",
   "jp": "だがペリージュニアの持つ\\n超魂の力はそれ以上だった",
   "en": "",
   "op": "0x62",
   "msg": "0x5081"
  },
  {
   "id": "m_011004:0x17470",
   "off": 95344,
   "max": 80,
   "kind": "dialogue",
   "jp": "小さな星を呑み込む\\n太陽の如く\\n巨大に熱く燃えさかり\\n龍馬たちに襲い掛かる！",
   "en": "",
   "op": "0x62",
   "msg": "0x5082"
  },
  {
   "id": "m_011004:0x17adc",
   "off": 96988,
   "max": 52,
   "kind": "dialogue",
   "jp": "ぐあっっ！\\nな　なんじゃ　これは？\\n体が熱い……！",
   "en": "",
   "op": "0x62",
   "msg": "0x5083"
  },
  {
   "id": "m_011004:0x18354",
   "off": 99156,
   "max": 48,
   "kind": "dialogue",
   "jp": "魂が燃やし尽くされそうだ\\nまさか　こんな……",
   "en": "",
   "op": "0x62",
   "msg": "0x5084"
  },
  {
   "id": "m_011004:0x18808",
   "off": 100360,
   "max": 40,
   "kind": "dialogue",
   "jp": "私達の超魂が\\n押さえつけられるっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5085"
  },
  {
   "id": "m_011004:0x19160",
   "off": 102752,
   "max": 28,
   "kind": "dialogue",
   "jp": "ヤツは\\nどれほどの力を……",
   "en": "",
   "op": "0x62",
   "msg": "0x5086"
  },
  {
   "id": "m_011004:0x19600",
   "off": 103936,
   "max": 32,
   "kind": "dialogue",
   "jp": "ちょっと\\nこんなの反則でしょ",
   "en": "",
   "op": "0x62",
   "msg": "0x5087"
  },
  {
   "id": "m_011004:0x19ee4",
   "off": 106212,
   "max": 28,
   "kind": "dialogue",
   "jp": "じゅにあ\\nお前も超魂を……",
   "en": "",
   "op": "0x62",
   "msg": "0x5088"
  },
  {
   "id": "m_011004:0x1a37c",
   "off": 107388,
   "max": 52,
   "kind": "dialogue",
   "jp": "当然だ\\n世界中のロッカーが\\nオレの前にひれ伏した",
   "en": "",
   "op": "0x62",
   "msg": "0x5089"
  },
  {
   "id": "m_011004:0x1a458",
   "off": 107608,
   "max": 40,
   "kind": "dialogue",
   "jp": "ワン　ツー　スリー……\\n大体　オッケー",
   "en": "",
   "op": "0x62",
   "msg": "0x508a"
  },
  {
   "id": "m_011004:0x1ac10",
   "off": 109584,
   "max": 20,
   "kind": "dialogue",
   "jp": "複数の超魂だとっ",
   "en": "",
   "op": "0x62",
   "msg": "0x508b"
  },
  {
   "id": "m_011004:0x1b268",
   "off": 111208,
   "max": 36,
   "kind": "dialogue",
   "jp": "そんなことが\\nあり得るなんて……",
   "en": "",
   "op": "0x62",
   "msg": "0x508c"
  },
  {
   "id": "m_011004:0x1b924",
   "off": 112932,
   "max": 52,
   "kind": "dialogue",
   "jp": "でも　実際ヤツの体から\\nいくつもの超魂を\\n感じるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x508d"
  },
  {
   "id": "m_011004:0x1c0dc",
   "off": 114908,
   "max": 32,
   "kind": "dialogue",
   "jp": "ちゃんとした\\n条約が欲しいなら",
   "en": "",
   "op": "0x62",
   "msg": "0x508e"
  },
  {
   "id": "m_011004:0x1c10c",
   "off": 114956,
   "max": 36,
   "kind": "dialogue",
   "jp": "ユー達の超魂と\\n引き換えにしようか",
   "en": "",
   "op": "0x62",
   "msg": "0x508f"
  },
  {
   "id": "m_011004:0x1c1d8",
   "off": 115160,
   "max": 56,
   "kind": "dialogue",
   "jp": "悪くない取り引きだろう\\nドゥー　ユー\\nアンダースタン？",
   "en": "",
   "op": "0x62",
   "msg": "0x5090"
  },
  {
   "id": "m_011004:0x1c4b8",
   "off": 115896,
   "max": 12,
   "kind": "choice",
   "jp": "わからん！",
