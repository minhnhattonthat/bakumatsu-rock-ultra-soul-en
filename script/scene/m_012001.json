{
 "source": "m_012001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_012001:0x11d0",
   "off": 4560,
   "max": 52,
   "kind": "dialogue",
   "jp": "雷舞を終えた五人は\\n勝海舟の屋敷へと\\n集まっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x50f1"
  },
  {
   "id": "m_012001:0x1214",
   "off": 4628,
   "max": 36,
   "kind": "dialogue",
   "jp": "皆　口には出さずとも\\n表情は暗い",
   "en": "",
   "op": "0x62",
   "msg": "0x50f2"
  },
  {
   "id": "m_012001:0x1248",
   "off": 4680,
   "max": 40,
   "kind": "dialogue",
   "jp": "目を輝かせているのは\\n龍馬だけであった",
   "en": "",
   "op": "0x62",
   "msg": "0x50f3"
  },
  {
   "id": "m_012001:0x18cc",
   "off": 6348,
   "max": 28,
   "kind": "dialogue",
   "jp": "くそっ！\\nなんてザマだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x50f4"
  },
  {
   "id": "m_012001:0x1f2c",
   "off": 7980,
   "max": 40,
   "kind": "dialogue",
   "jp": "まったく\\n歯が立ちません\\nでした……",
   "en": "",
   "op": "0x62",
   "msg": "0x50f5"
  },
  {
   "id": "m_012001:0x25f0",
   "off": 9712,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x50f6"
  },
  {
   "id": "m_012001:0x2d80",
   "off": 11648,
   "max": 20,
   "kind": "dialogue",
   "jp": "負けを認めるの",
   "en": "",
   "op": "0x62",
   "msg": "0x50f7"
  },
  {
   "id": "m_012001:0x2da4",
   "off": 11684,
   "max": 44,
   "kind": "dialogue",
   "jp": "それはアイツに超魂を\\n渡すってことだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x50f8"
  },
  {
   "id": "m_012001:0x3414",
   "off": 13332,
   "max": 36,
   "kind": "dialogue",
   "jp": "誰もそんなことは\\n言ってねえだろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x50f9"
  },
  {
   "id": "m_012001:0x3448",
   "off": 13384,
   "max": 32,
   "kind": "dialogue",
   "jp": "オレ様の超魂は\\nオレ様のものだ",
   "en": "",
   "op": "0x62",
   "msg": "0x50fa"
  },
  {
   "id": "m_012001:0x3980",
   "off": 14720,
   "max": 52,
   "kind": "dialogue",
   "jp": "だが　オレ様はアイツの\\nロックに圧倒されちまった",
   "en": "",
   "op": "0x62",
   "msg": "0x50fb"
  },
  {
   "id": "m_012001:0x4050",
   "off": 16464,
   "max": 56,
   "kind": "dialogue",
   "jp": "ええ　すごかったですね\\n何よりあの複数の超魂の\\n力……",
   "en": "",
   "op": "0x62",
   "msg": "0x50fc"
  },
  {
   "id": "m_012001:0x473c",
   "off": 18236,
   "max": 64,
   "kind": "dialogue",
   "jp": "あれはすごかったぜよ\\nびっくりじゃ！\\n教えて欲しいくらいじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x50fd"
  },
  {
   "id": "m_012001:0x4f40",
   "off": 20288,
   "max": 32,
   "kind": "dialogue",
   "jp": "龍馬　テメェ\\nどっちの味方だ",
   "en": "",
   "op": "0x62",
   "msg": "0x50fe"
  },
  {
   "id": "m_012001:0x5474",
   "off": 21620,
   "max": 52,
   "kind": "dialogue",
   "jp": "わしはただ\\nすごいもんはすごいと\\n言ってるだけぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x50ff"
  },
  {
   "id": "m_012001:0x5c3c",
   "off": 23612,
   "max": 64,
   "kind": "dialogue",
   "jp": "……しかし　坂本は\\nあれが天歌と同じだと\\n言ってなかったか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5100"
  },
  {
   "id": "m_012001:0x6300",
   "off": 25344,
   "max": 44,
   "kind": "dialogue",
   "jp": "あ　ああ……うーん\\n上手くは言えんのじゃが",
   "en": "",
   "op": "0x62",
   "msg": "0x5101"
  },
  {
   "id": "m_012001:0x63d4",
   "off": 25556,
   "max": 64,
   "kind": "dialogue",
   "jp": "熱くて　魂も感じる\\nそんで圧倒的な力に\\nねじふせられそうになる",
   "en": "",
   "op": "0x62",
   "msg": "0x5102"
  },
  {
   "id": "m_012001:0x64bc",
   "off": 25788,
   "max": 56,
   "kind": "dialogue",
   "jp": "でも……\\n無理矢理　聴かせて\\n従えるなら天歌と同じぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5103"
  },
  {
   "id": "m_012001:0x6d00",
   "off": 27904,
   "max": 52,
   "kind": "dialogue",
   "jp": "それに　何ちゅうか\\nあのロックは\\n何か哀しいんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x5104"
  },
  {
   "id": "m_012001:0x7594",
   "off": 30100,
   "max": 56,
   "kind": "dialogue",
   "jp": "ふーん　トサカくんが\\nそう言うなら\\nそうかもしれないね",
   "en": "",
   "op": "0x62",
   "msg": "0x5105"
  },
  {
   "id": "m_012001:0x7a48",
   "off": 31304,
   "max": 56,
   "kind": "dialogue",
   "jp": "……だが哀しかろうと\\nヤツの超魂が強力なのは\\n確かだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5106"
  },
  {
   "id": "m_012001:0x811c",
   "off": 33052,
   "max": 20,
   "kind": "dialogue",
   "jp": "ええ\\nその通りです",
   "en": "",
   "op": "0x62",
   "msg": "0x5107"
  },
  {
   "id": "m_012001:0x88b8",
   "off": 35000,
   "max": 56,
   "kind": "dialogue",
   "jp": "しかも　\\nそれをジュニアとＪの\\n演奏技術が高めてやがる",
   "en": "",
   "op": "0x62",
   "msg": "0x5108"
  },
  {
   "id": "m_012001:0x9088",
   "off": 37000,
   "max": 64,
   "kind": "dialogue",
   "jp": "とくにあのギターリフ……\\n一瞬で魂を持って\\nいかれるかと思った",
   "en": "",
   "op": "0x62",
   "msg": "0x5109"
  },
  {
   "id": "m_012001:0x988c",
   "off": 39052,
   "max": 36,
   "kind": "dialogue",
   "jp": "わしもあんな風に\\n弾いてみたいのう",
   "en": "",
   "op": "0x62",
   "msg": "0x510a"
  },
  {
   "id": "m_012001:0xa104",
   "off": 41220,
   "max": 52,
   "kind": "dialogue",
   "jp": "バカ野郎　\\nオレ様ならともかく\\nテメェには無理だ",
   "en": "",
   "op": "0x62",
   "msg": "0x510b"
  },
  {
   "id": "m_012001:0xa7e0",
   "off": 42976,
   "max": 44,
   "kind": "dialogue",
   "jp": "何をぅ！　これでも\\n上手くなったんじゃぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x510c"
  },
  {
   "id": "m_012001:0xaf24",
   "off": 44836,
   "max": 32,
   "kind": "dialogue",
   "jp": "ええ\\n龍馬くんは上手くなった",
   "en": "",
   "op": "0x62",
   "msg": "0x510d"
  },
  {
   "id": "m_012001:0xaf54",
   "off": 44884,
   "max": 36,
   "kind": "dialogue",
   "jp": "修行の成果を\\n抜群に感じましたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x510e"
  },
  {
   "id": "m_012001:0xb024",
   "off": 45092,
   "max": 68,
   "kind": "dialogue",
   "jp": "それだけじゃない\\n私も晋作も以前より実力は\\n上がっていたはずです",
   "en": "",
   "op": "0x62",
   "msg": "0x510f"
  },
  {
   "id": "m_012001:0xb964",
   "off": 47460,
   "max": 40,
   "kind": "dialogue",
   "jp": "……だがジュニアには\\n勝てなかった　か",
   "en": "",
   "op": "0x62",
   "msg": "0x5110"
  },
  {
   "id": "m_012001:0xc0ac",
   "off": 49324,
   "max": 52,
   "kind": "dialogue",
   "jp": "ええ\\n井の中の蛙　大海を知らず\\nとはこのことですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5111"
  },
  {
   "id": "m_012001:0xc724",
   "off": 50980,
   "max": 32,
   "kind": "dialogue",
   "jp": "認めたくはないが\\n世界は広いな",
   "en": "",
   "op": "0x62",
   "msg": "0x5112"
  },
  {
   "id": "m_012001:0xcec8",
   "off": 52936,
   "max": 68,
   "kind": "dialogue",
   "jp": "はぁ～　おかげで僕が\\nジュニアの世話役を\\nさせられることになるし",
   "en": "",
   "op": "0x62",
   "msg": "0x5113"
  },
  {
   "id": "m_012001:0xd428",
   "off": 54312,
   "max": 28,
   "kind": "dialogue",
   "jp": "\\fnt1サイアク\\fnt0だよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5114"
  },
  {
   "id": "m_012001:0xd8c0",
   "off": 55488,
   "max": 52,
   "kind": "dialogue",
   "jp": "僕があのヘンタイに\\n襲われちゃったら\\nどうするのさ",
   "en": "",
   "op": "0x62",
   "msg": "0x5115"
  },
  {
   "id": "m_012001:0xe210",
   "off": 57872,
   "max": 24,
   "kind": "dialogue",
   "jp": "……その時は俺が斬る",
   "en": "",
   "op": "0x62",
   "msg": "0x5116"
  },
  {
   "id": "m_012001:0xeaf8",
   "off": 60152,
   "max": 20,
   "kind": "dialogue",
   "jp": "土方さん頼もし～い",
   "en": "",
   "op": "0x62",
   "msg": "0x5117"
  },
  {
   "id": "m_012001:0xf360",
   "off": 62304,
   "max": 48,
   "kind": "dialogue",
   "jp": "いざというときは\\nアリかも\\nしれませんね……",
   "en": "",
   "op": "0x62",
   "msg": "0x5118"
  },
  {
   "id": "m_012001:0xfbc0",
   "off": 64448,
   "max": 36,
   "kind": "dialogue",
   "jp": "おい　桂さん\\n真顔で頷くなって！",
   "en": "",
   "op": "0x62",
   "msg": "0x5119"
  },
  {
   "id": "m_012001:0x103e4",
   "off": 66532,
   "max": 80,
   "kind": "dialogue",
   "jp": "ま　それは最終手段として\\nここでぐだぐだ言ってる\\nだけなんだったら\\n僕　帰るね",
   "en": "",
   "op": "0x62",
   "msg": "0x511a"
  },
  {
   "id": "m_012001:0x10444",
   "off": 66628,
   "max": 36,
   "kind": "dialogue",
   "jp": "さっさと立ち直って\\n練習でもしなよ",
   "en": "",
   "op": "0x62",
   "msg": "0x511b"
  },
  {
   "id": "m_012001:0x10518",
   "off": 66840,
   "max": 56,
   "kind": "dialogue",
   "jp": "地べたにいつまでも\\n這いつくばってるヤツは\\n負け犬だよ",
   "en": "",
   "op": "0x62",
   "msg": "0x511c"
  },
  {
   "id": "m_012001:0x10bec",
   "off": 68588,
   "max": 12,
   "kind": "dialogue",
   "jp": "なっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x511d"
  },
  {
   "id": "m_012001:0x11404",
   "off": 70660,
   "max": 44,
   "kind": "dialogue",
   "jp": "……そんな負け犬\\n好敵手とは認めないから",
   "en": "",
   "op": "0x62",
   "msg": "0x511e"
  },
  {
   "id": "m_012001:0x11b4c",
   "off": 72524,
   "max": 32,
   "kind": "dialogue",
   "jp": "ほら　土方さん\\n行きましょう",
   "en": "",
   "op": "0x62",
   "msg": "0x511f"
  },
  {
   "id": "m_012001:0x12208",
   "off": 74248,
   "max": 24,
   "kind": "dialogue",
   "jp": "ああ……\\nではまたな",
   "en": "",
   "op": "0x62",
   "msg": "0x5120"
  },
  {
   "id": "m_012001:0x128b8",
   "off": 75960,
   "max": 48,
   "kind": "dialogue",
   "jp": "おうっ　ヒジゾーさんも\\nソウちんもまたなー！",
   "en": "",
   "op": "0x62",
   "msg": "0x5121"
  },
  {
   "id": "m_012001:0x12f34",
   "off": 77620,
   "max": 40,
   "kind": "dialogue",
   "jp": "ったくあいつは毎度毎度\\n口の悪い……",
   "en": "",
   "op": "0x62",
   "msg": "0x5122"
  },
  {
   "id": "m_012001:0x133d8",
   "off": 78808,
   "max": 48,
   "kind": "dialogue",
   "jp": "いや～\\nソウちんなりに\\n励ましてくれたんじゃろ",
   "en": "",
   "op": "0x62",
   "msg": "0x5123"
  },
  {
   "id": "m_012001:0x13418",
   "off": 78872,
   "max": 48,
   "kind": "dialogue",
   "jp": "ソウちんも　シンディと\\n一緒で素直じゃないから",
   "en": "",
   "op": "0x62",
   "msg": "0x5124"
  },
  {
   "id": "m_012001:0x13af4",
   "off": 80628,
   "max": 60,
   "kind": "dialogue",
   "jp": "誰がアイツと一緒だ\\n沖田と似てるのは\\n桂さんの方だろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5125"
  },
  {
   "id": "m_012001:0x141dc",
   "off": 82396,
   "max": 40,
   "kind": "dialogue",
   "jp": "晋作　それは\\n聞き捨てなりませんねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x5126"
  },
  {
   "id": "m_012001:0x14998",
   "off": 84376,
   "max": 24,
   "kind": "dialogue",
   "jp": "あっ　いや　その……",
   "en": "",
   "op": "0x62",
   "msg": "0x5127"
  },
  {
   "id": "m_012001:0x14a64",
   "off": 84580,
   "max": 60,
   "kind": "dialogue",
   "jp": "と　とにかくだ！\\n言い方は気に入らないが\\n間違ってはいねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x5128"
  },
  {
   "id": "m_012001:0x1539c",
   "off": 86940,
   "max": 76,
   "kind": "dialogue",
   "jp": "オレ様達は狭い日本で\\n頂上（トップ）に\\n立ったからって\\n安穏としてたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5129"
  },
  {
   "id": "m_012001:0x153f8",
   "off": 87032,
   "max": 64,
   "kind": "dialogue",
   "jp": "確かに実力も上がった\\nだが　そこにあぐらを\\nかいてたんじゃ……",
   "en": "",
   "op": "0x62",
   "msg": "0x512a"
  },
  {
   "id": "m_012001:0x1596c",
   "off": 88428,
   "max": 48,
   "kind": "dialogue",
   "jp": "もっと上だ！\\n世界を……\\n奴をぶったおすぞ！",
   "en": "",
   "op": "0x62",
   "msg": "0x512b"
  },
  {
   "id": "m_012001:0x16338",
   "off": 90936,
   "max": 44,
   "kind": "dialogue",
   "jp": "そうじゃ！\\nやるぞ　シンディ！\\nセンセー！",
   "en": "",
   "op": "0x62",
   "msg": "0x512c"
  },
  {
   "id": "m_012001:0x16c98",
   "off": 93336,
   "max": 56,
   "kind": "dialogue",
   "jp": "晋作　龍馬くん\\nやりましょう！\\n世界を超えるんです！",
   "en": "",
   "op": "0x62",
   "msg": "0x512d"
  },
  {
   "id": "m_012001:0x1736c",
   "off": 95084,
   "max": 36,
   "kind": "dialogue",
   "jp": "桂さん　龍馬\\n今夜は寝かせないぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x512e"
  },
  {
   "id": "m_012001:0x176bc",
   "off": 95932,
   "max": 16,
   "kind": "choice",
   "jp": "さすがシンディ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_012001:0x176d8",
   "off": 95960,
   "max": 16,
   "kind": "choice",
   "jp": "三人で頑張ろう",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_012001:0x176f4",
   "off": 95988,
   "max": 16,
   "kind": "choice",
   "jp": "燃えてきたぜよ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_012001:0x17f00",
   "off": 98048,
   "max": 36,
   "kind": "dialogue",
   "jp": "さすがシンディ！\\nやってやるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x512f"
  },
  {
   "id": "m_012001:0x18568",
   "off": 99688,
   "max": 36,
   "kind": "dialogue",
   "jp": "はっ　当然のことを\\n言ったまでだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5130"
  },
  {
   "id": "m_012001:0x1859c",
   "off": 99740,
   "max": 40,
   "kind": "dialogue",
   "jp": "途中で寝やがったら\\n水ぶっかけるからな",
   "en": "",
   "op": "0x62",
   "msg": "0x5131"
  },
  {
   "id": "m_012001:0x18ad8",
   "off": 101080,
   "max": 40,
   "kind": "dialogue",
   "jp": "ははっ　それは\\n勘弁してほしいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5132"
  },
  {
   "id": "m_012001:0x197ac",
   "off": 104364,
   "max": 20,
   "kind": "dialogue",
   "jp": "三人で頑張ろう！",
   "en": "",
   "op": "0x62",
   "msg": "0x5133"
  },
  {
   "id": "m_012001:0x19e04",
   "off": 105988,
   "max": 40,
   "kind": "dialogue",
   "jp": "ええ　もちろんです\\n私も燃えてきました",
   "en": "",
   "op": "0x62",
   "msg": "0x5134"
  },
  {
   "id": "m_012001:0x19ee0",
   "off": 106208,
   "max": 56,
   "kind": "dialogue",
   "jp": "今こそ私が発明した\\nこの目覚まし飲料の\\n出番ですね",
   "en": "",
   "op": "0x62",
   "msg": "0x5135"
  },
  {
   "id": "m_012001:0x1a7e0",
   "off": 108512,
   "max": 44,
   "kind": "dialogue",
   "jp": "い　いや\\nそれはちょっと\\n遠慮するぜ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5136"
  },
  {
   "id": "m_012001:0x1b708",
   "off": 112392,
   "max": 24,
   "kind": "dialogue",
   "jp": "燃えてきたぜよぉぉ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5137"
  },
  {
   "id": "m_012001:0x1b730",
   "off": 112432,
   "max": 44,
   "kind": "dialogue",
   "jp": "強敵と戦うための特訓！\\nこれぞ男の道ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5138"
  },
  {
   "id": "m_012001:0x1bef4",
   "off": 114420,
   "max": 40,
   "kind": "dialogue",
   "jp": "ったく暑苦しいヤツだ\\nクールにいこうぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x5139"
  },
  {
   "id": "m_012001:0x1c560",
   "off": 116064,
   "max": 48,
   "kind": "dialogue",
   "jp": "でもその龍馬くんに\\n火をつけたのは晋作ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x513a"
  },
  {
   "id": "m_012001:0x1cd14",
   "off": 118036,
   "max": 24,
   "kind": "dialogue",
   "jp": "燃えてきたぁぁぁぁぁ！",
   "en": "",
   "op": "0x62",
   "msg": "0x513b"
  },
  {
   "id": "m_012001:0x1d5a0",
   "off": 120224,
   "max": 32,
   "kind": "dialogue",
   "jp": "しかし\\n徹夜で練習ですか……",
   "en": "",
   "op": "0x62",
   "msg": "0x513c"
  },
  {
   "id": "m_012001:0x1dc04",
   "off": 121860,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんだ　桂さんは\\nやらないってのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x513d"
  },
  {
   "id": "m_012001:0x1e144",
   "off": 123204,
   "max": 44,
   "kind": "dialogue",
   "jp": "そうは言いませんよ\\nただ　懐かしいな　と",
   "en": "",
   "op": "0x62",
   "msg": "0x513e"
  },
  {
   "id": "m_012001:0x1e198",
   "off": 123288,
   "max": 68,
   "kind": "dialogue",
   "jp": "天歌がまだ世を支配して\\nいた頃はしょっちゅう\\n徹夜してましたよね",
   "en": "",
   "op": "0x62",
   "msg": "0x513f"
  },
  {
   "id": "m_012001:0x1e6f4",
   "off": 124660,
   "max": 64,
   "kind": "dialogue",
   "jp": "確かに　あの頃の\\nがむしゃらな熱情を\\n忘れていたのかもしれねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x5140"
  },
  {
   "id": "m_012001:0x1e7e0",
   "off": 124896,
   "max": 92,
   "kind": "dialogue",
   "jp": "だが　それを取り戻した\\nロックに必要なのは\\nいつだって挑戦精神\\n（チャレンジマインド）だ",
   "en": "",
   "op": "0x62",
   "msg": "0x5141"
  },
  {
   "id": "m_012001:0x1f12c",
   "off": 127276,
   "max": 44,
   "kind": "dialogue",
   "jp": "心が止まってたんじゃあ\\nロックは奏でられん",
   "en": "",
   "op": "0x62",
   "msg": "0x5142"
  },
  {
   "id": "m_012001:0x1f168",
   "off": 127336,
   "max": 36,
   "kind": "dialogue",
   "jp": "今日からまた三人で\\n走り出すぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5143"
  },
  {
   "id": "m_012001:0x1f7b8",
   "off": 128952,
   "max": 36,
   "kind": "dialogue",
   "jp": "よーし　燃えてきた\\n燃えてきたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5144"
  },
  {
   "id": "m_012001:0x1f7ec",
   "off": 129004,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしの中で滾る熱いロック\\n歌いたくて\\nたまらないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5145"
  },
  {
   "id": "m_012001:0x1f834",
   "off": 129076,
   "max": 28,
   "kind": "dialogue",
   "jp": "烈！\\nロックンロールぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5146"
  },
  {
   "id": "m_012001:0x203fc",
   "off": 132092,
   "max": 20,
   "kind": "dialogue",
   "jp": "おうっ！\\n行くぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5147"
  },
  {
   "id": "m_012001:0x2088c",
   "off": 133260,
   "max": 12,
   "kind": "dialogue",
   "jp": "はいっ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5148"
  },
  {
   "id": "m_012001:0x20f0c",
   "off": 134924,
   "max": 36,
   "kind": "dialogue",
   "jp": "こうして龍馬達の特訓が\\n始まった",
   "en": "",
   "op": "0x62",
   "msg": "0x5149"
  },
  {
   "id": "m_012001:0x20f40",
   "off": 134976,
   "max": 88,
   "kind": "dialogue",
   "jp": "かつて天歌と戦っていた\\n時のように\\nいやそれ以上に熱く激しく\\n三人は練習に打ち込んだ",
   "en": "",
   "op": "0x62",
   "msg": "0x514a"
  }
 ]
}
