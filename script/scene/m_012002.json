{
 "source": "m_012002.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_012002:0x12b8",
   "off": 4792,
   "max": 40,
   "kind": "dialogue",
   "jp": "そして龍馬達が\\n特訓を重ねている頃……",
   "en": "",
   "op": "0x62",
   "msg": "0x514b"
  },
  {
   "id": "m_012002:0x1728",
   "off": 5928,
   "max": 44,
   "kind": "dialogue",
   "jp": "どうも～\\n世話役を仰せつかった\\n沖田で～す",
   "en": "",
   "op": "0x62",
   "msg": "0x514c"
  },
  {
   "id": "m_012002:0x1b00",
   "off": 6912,
   "max": 60,
   "kind": "dialogue",
   "jp": "イヤイヤながらも沖田は\\nジュニアの接待を\\n任せられていた",
   "en": "",
   "op": "0x62",
   "msg": "0x514d"
  },
  {
   "id": "m_012002:0x218c",
   "off": 8588,
   "max": 56,
   "kind": "dialogue",
   "jp": "おー！　ナデシコ！\\nまた会えるなんて\\nデスティニーだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x514e"
  },
  {
   "id": "m_012002:0x2b5c",
   "off": 11100,
   "max": 40,
   "kind": "dialogue",
   "jp": "シルクのような肌と髪\\nまさにドール……",
   "en": "",
   "op": "0x62",
   "msg": "0x514f"
  },
  {
   "id": "m_012002:0x2b94",
   "off": 11156,
   "max": 44,
   "kind": "dialogue",
   "jp": "ウツクシイとはまさに\\nナデシコのための言葉",
   "en": "",
   "op": "0x62",
   "msg": "0x5150"
  },
  {
   "id": "m_012002:0x355c",
   "off": 13660,
   "max": 12,
   "kind": "dialogue",
   "jp": "あはは……",
   "en": "",
   "op": "0x62",
   "msg": "0x5151"
  },
  {
   "id": "m_012002:0x3af8",
   "off": 15096,
   "max": 24,
   "kind": "dialogue",
   "jp": "何言ってんの\\nコイツ",
   "en": "",
   "op": "0x62",
   "msg": "0x5152"
  },
  {
   "id": "m_012002:0x4408",
   "off": 17416,
   "max": 52,
   "kind": "dialogue",
   "jp": "ナデシコ！\\nオレ達のラブ\\n邪魔するものはなにもない",
   "en": "",
   "op": "0x62",
   "msg": "0x5153"
  },
  {
   "id": "m_012002:0x44e4",
   "off": 17636,
   "max": 60,
   "kind": "dialogue",
   "jp": "さあ　オレのホットで\\nスパイシーなラブに\\n溺れてくれ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x5154"
  },
  {
   "id": "m_012002:0x4ebc",
   "off": 20156,
   "max": 12,
   "kind": "dialogue",
   "jp": "ぞぞぞ～っ",
   "en": "",
   "op": "0x62",
   "msg": "0x5155"
  },
  {
   "id": "m_012002:0x566c",
   "off": 22124,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x5156"
  },
  {
   "id": "m_012002:0x5c3c",
   "off": 23612,
   "max": 40,
   "kind": "dialogue",
   "jp": "わかったわかった\\nＪ\\n確かに性急過ぎた",
   "en": "",
   "op": "0x62",
   "msg": "0x5157"
  },
  {
   "id": "m_012002:0x61ec",
   "off": 25068,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x5158"
  },
  {
   "id": "m_012002:0x6794",
   "off": 26516,
   "max": 52,
   "kind": "dialogue",
   "jp": "おわびにナデシコの願い\\n一つ　叶えよう\\n何がいい？",
   "en": "",
   "op": "0x62",
   "msg": "0x5159"
  },
  {
   "id": "m_012002:0x6e90",
   "off": 28304,
   "max": 16,
   "kind": "dialogue",
   "jp": "何でもいいの？",
   "en": "",
   "op": "0x62",
   "msg": "0x515a"
  },
  {
   "id": "m_012002:0x73b4",
   "off": 29620,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレにできないことなんて\\n何もない\\nオレは……",
   "en": "",
   "op": "0x62",
   "msg": "0x515b"
  },
  {
   "id": "m_012002:0x7de8",
   "off": 32232,
   "max": 16,
   "kind": "dialogue",
   "jp": "ロックスターだ",
   "en": "",
   "op": "0x62",
   "msg": "0x515c"
  },
  {
   "id": "m_012002:0x8834",
   "off": 34868,
   "max": 16,
   "kind": "dialogue",
   "jp": "うっわぁぁ……",
   "en": "",
   "op": "0x62",
   "msg": "0x515d"
  },
  {
   "id": "m_012002:0x8fe0",
   "off": 36832,
   "max": 48,
   "kind": "dialogue",
   "jp": "それならぁ～僕達と\\n一緒に雷舞をして下さいよ",
   "en": "",
   "op": "0x62",
   "msg": "0x515e"
  },
  {
   "id": "m_012002:0x95b0",
   "off": 38320,
   "max": 24,
   "kind": "dialogue",
   "jp": "ん？\\nナデシコ達と？",
   "en": "",
   "op": "0x62",
   "msg": "0x515f"
  },
  {
   "id": "m_012002:0x9a44",
   "off": 39492,
   "max": 36,
   "kind": "dialogue",
   "jp": "ええ　僕　新選組って\\n愛獲なんです",
   "en": "",
   "op": "0x62",
   "msg": "0x5160"
  },
  {
   "id": "m_012002:0x9f7c",
   "off": 40828,
   "max": 40,
   "kind": "dialogue",
   "jp": "オッケー\\nアイドルとの雷舞\\n悪くない",
   "en": "",
   "op": "0x62",
   "msg": "0x5161"
  },
  {
   "id": "m_012002:0xa04c",
   "off": 41036,
   "max": 52,
   "kind": "dialogue",
   "jp": "むしろ　最高\\n新しいラブが\\n生まれる予感がするよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5162"
  },
  {
   "id": "m_012002:0xa6d4",
   "off": 42708,
   "max": 8,
   "kind": "dialogue",
   "jp": "ぞぞっ",
   "en": "",
   "op": "0x62",
   "msg": "0x5163"
  },
  {
   "id": "m_012002:0xac6c",
   "off": 44140,
   "max": 68,
   "kind": "dialogue",
   "jp": "というかこの間　僕\\nトサカ……坂本くん達と\\n一緒に歌ってましたよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5164"
  },
  {
   "id": "m_012002:0xb2d8",
   "off": 45784,
   "max": 8,
   "kind": "dialogue",
   "jp": "うん？",
   "en": "",
   "op": "0x62",
   "msg": "0x5165"
  },
  {
   "id": "m_012002:0xb8f8",
   "off": 47352,
   "max": 20,
   "kind": "dialogue",
   "jp": "覚えてないのかよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5166"
  },
  {
   "id": "m_012002:0xbf04",
   "off": 48900,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x5167"
  },
  {
   "id": "m_012002:0xc43c",
   "off": 50236,
   "max": 40,
   "kind": "dialogue",
   "jp": "ああ　大体オッケー\\nＪ　手配は頼んだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5168"
  },
  {
   "id": "m_012002:0xc9f4",
   "off": 51700,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x5169"
  },
  {
   "id": "m_012002:0xd440",
   "off": 54336,
   "max": 88,
   "kind": "dialogue",
   "jp": "ペリージュニアと新選組が\\n合同雷舞を行うという\\n知らせは\\n瞬く間に江戸中を\\n駆け巡った",
   "en": "",
   "op": "0x62",
   "msg": "0x516a"
  },
  {
   "id": "m_012002:0xd4a8",
   "off": 54440,
   "max": 72,
   "kind": "dialogue",
   "jp": "むろん雷舞の券は即日完売\\n二大スターの夢の競演を\\n人々は熱狂で迎えた",
   "en": "",
   "op": "0x62",
   "msg": "0x516b"
  },
  {
   "id": "m_012002:0xd930",
   "off": 55600,
   "max": 48,
   "kind": "dialogue",
   "jp": "うわぁ～　いるいる\\n今日もうじゃうじゃと……",
   "en": "",
   "op": "0x62",
   "msg": "0x516c"
  },
  {
   "id": "m_012002:0xdfa4",
   "off": 57252,
   "max": 52,
   "kind": "dialogue",
   "jp": "おい　総司\\nこんなところで油を\\n売ってるんじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x516d"
  },
  {
   "id": "m_012002:0xdfe8",
   "off": 57320,
   "max": 48,
   "kind": "dialogue",
   "jp": "お前はジュニアの接待を\\n任せられてるはずだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x516e"
  },
  {
   "id": "m_012002:0xe494",
   "off": 58516,
   "max": 72,
   "kind": "dialogue",
   "jp": "ちょっとした息抜きですよ\\nだって　あいつ　すーぐ\\n唇とか触ろうとするし",
   "en": "",
   "op": "0x62",
   "msg": "0x516f"
  },
  {
   "id": "m_012002:0xeee4",
   "off": 61156,
   "max": 24,
   "kind": "dialogue",
   "jp": "……今から斬りに行くか",
   "en": "",
   "op": "0x62",
   "msg": "0x5170"
  },
  {
   "id": "m_012002:0xf910",
   "off": 63760,
   "max": 68,
   "kind": "dialogue",
   "jp": "あ　ヤキモチですか？\\nジュニアより土方さんの\\n方がアブナイかも？",
   "en": "",
   "op": "0x62",
   "msg": "0x5171"
  },
  {
   "id": "m_012002:0xff14",
   "off": 65300,
   "max": 12,
   "kind": "dialogue",
   "jp": "おい\\n総司",
   "en": "",
   "op": "0x62",
   "msg": "0x5172"
  },
  {
   "id": "m_012002:0x1039c",
   "off": 66460,
   "max": 8,
   "kind": "dialogue",
   "jp": "へ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5173"
  },
  {
   "id": "m_012002:0x10ba4",
   "off": 68516,
   "max": 40,
   "kind": "dialogue",
   "jp": "いったぁ～\\nもうすーぐ\\nぶつんだから～",
   "en": "",
   "op": "0x62",
   "msg": "0x5174"
  },
  {
   "id": "m_012002:0x110e0",
   "off": 69856,
   "max": 56,
   "kind": "dialogue",
   "jp": "でも　土方さんになら\\n触らせてあげても\\nいいですよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5175"
  },
  {
   "id": "m_012002:0x11918",
   "off": 71960,
   "max": 28,
   "kind": "dialogue",
   "jp": "いたいっ\\n二度もぶった！",
   "en": "",
   "op": "0x62",
   "msg": "0x5176"
  },
  {
   "id": "m_012002:0x11e4c",
   "off": 73292,
   "max": 64,
   "kind": "dialogue",
   "jp": "バカばかり言ってないで\\nさっさとジュニアの\\nところへ行ってこい",
   "en": "",
   "op": "0x62",
   "msg": "0x5177"
  },
  {
   "id": "m_012002:0x12518",
   "off": 75032,
   "max": 64,
   "kind": "dialogue",
   "jp": "自分の準備も忘れるな\\n今日は……我ら新選組と\\nヤツの真剣勝負だ",
   "en": "",
   "op": "0x62",
   "msg": "0x5178"
  },
  {
   "id": "m_012002:0x12be0",
   "off": 76768,
   "max": 64,
   "kind": "dialogue",
   "jp": "わかってますよ\\nトサカくん達の手前\\n無様なとこ見せられないし",
   "en": "",
   "op": "0x62",
   "msg": "0x5179"
  },
  {
   "id": "m_012002:0x132d0",
   "off": 78544,
   "max": 32,
   "kind": "dialogue",
   "jp": "来てるんですよね\\nトサカくん達",
   "en": "",
   "op": "0x62",
   "msg": "0x517a"
  },
  {
   "id": "m_012002:0x13808",
   "off": 79880,
   "max": 32,
   "kind": "dialogue",
   "jp": "ああ　\\n招待状は出しておいた",
   "en": "",
   "op": "0x62",
   "msg": "0x517b"
  },
  {
   "id": "m_012002:0x13838",
   "off": 79928,
   "max": 32,
   "kind": "dialogue",
   "jp": "挨拶にくると\\n言っていたが……",
   "en": "",
   "op": "0x62",
   "msg": "0x517c"
  },
  {
   "id": "m_012002:0x14218",
   "off": 82456,
   "max": 64,
   "kind": "dialogue",
   "jp": "おーい！　ソウち～ん\\nヒジゾーさん　\\n陣中見舞いに来たぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x517d"
  },
  {
   "id": "m_012002:0x148a4",
   "off": 84132,
   "max": 24,
   "kind": "dialogue",
   "jp": "差し入れも\\nありますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x517e"
  },
  {
   "id": "m_012002:0x153bc",
   "off": 86972,
   "max": 32,
   "kind": "dialogue",
   "jp": "なになに？\\nわっ　ピッツァ！",
   "en": "",
   "op": "0x62",
   "msg": "0x517f"
  },
  {
   "id": "m_012002:0x153ec",
   "off": 87020,
   "max": 36,
   "kind": "dialogue",
   "jp": "もしかして\\nお登勢さんのお手製？",
   "en": "",
   "op": "0x62",
   "msg": "0x5180"
  },
  {
   "id": "m_012002:0x15b38",
   "off": 88888,
   "max": 32,
   "kind": "dialogue",
   "jp": "悪かったな\\nオレ様の手作りで",
   "en": "",
   "op": "0x62",
   "msg": "0x5181"
  },
  {
   "id": "m_012002:0x16220",
   "off": 90656,
   "max": 48,
   "kind": "dialogue",
   "jp": "えっ\\nスカシくんが作ったの？\\nこのピッツァを？",
   "en": "",
   "op": "0x62",
   "msg": "0x5182"
  },
  {
   "id": "m_012002:0x168e8",
   "off": 92392,
   "max": 56,
   "kind": "dialogue",
   "jp": "お登勢やんはすっかり\\nじゅにあの\\n大贔屓じゃからなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x5183"
  },
  {
   "id": "m_012002:0x16fbc",
   "off": 94140,
   "max": 32,
   "kind": "dialogue",
   "jp": "文句があるなら\\n食うんじゃねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x5184"
  },
  {
   "id": "m_012002:0x17bd0",
   "off": 97232,
   "max": 44,
   "kind": "dialogue",
   "jp": "食べないとは\\n言ってないし\\nいただきまーす",
   "en": "",
   "op": "0x62",
   "msg": "0x5185"
  },
  {
   "id": "m_012002:0x18900",
   "off": 100608,
   "max": 36,
   "kind": "dialogue",
   "jp": "スカシくん　料理\\n上手いんだね～",
   "en": "",
   "op": "0x62",
   "msg": "0x5186"
  },
  {
   "id": "m_012002:0x19060",
   "off": 102496,
   "max": 60,
   "kind": "dialogue",
   "jp": "気合いを入れるために\\nトッピング用の\\n唐辛子も持ってきたぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x5187"
  },
  {
   "id": "m_012002:0x196e8",
   "off": 104168,
   "max": 52,
   "kind": "dialogue",
   "jp": "……それは遠慮する\\n歌う前に喉を痛めると\\n大変だ",
   "en": "",
   "op": "0x62",
   "msg": "0x5188"
  },
  {
   "id": "m_012002:0x19c34",
   "off": 105524,
   "max": 24,
   "kind": "dialogue",
   "jp": "けっ\\nロックじゃねえな",
   "en": "",
   "op": "0x62",
   "msg": "0x5189"
  },
  {
   "id": "m_012002:0x1a3d4",
   "off": 107476,
   "max": 56,
   "kind": "dialogue",
   "jp": "しかし　新選組と\\nジュニアが合同雷舞とは\\n驚きですね",
   "en": "",
   "op": "0x62",
   "msg": "0x518a"
  },
  {
   "id": "m_012002:0x1aa4c",
   "off": 109132,
   "max": 52,
   "kind": "dialogue",
   "jp": "あんな中途半端に\\n負けっぱなしは\\nイヤだったしね",
   "en": "",
   "op": "0x62",
   "msg": "0x518b"
  },
  {
   "id": "m_012002:0x1aa90",
   "off": 109200,
   "max": 64,
   "kind": "dialogue",
   "jp": "ジュニアに頼んでみたら\\nすぐに\\nん～　大体オッケー♪\\nだってさ",
   "en": "",
   "op": "0x62",
   "msg": "0x518c"
  },
  {
   "id": "m_012002:0x1b2a8",
   "off": 111272,
   "max": 64,
   "kind": "dialogue",
   "jp": "ほへ～　ソウちんは\\n本当にじゅにあに\\n気に入られてるんじゃなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x518d"
  },
  {
   "id": "m_012002:0x1bd60",
   "off": 114016,
   "max": 72,
   "kind": "dialogue",
   "jp": "ごめんね　トサカくん\\nそっちが雪辱を果たす前に\\n僕達が勝っちゃうかも",
   "en": "",
   "op": "0x62",
   "msg": "0x518e"
  },
  {
   "id": "m_012002:0x1c568",
   "off": 116072,
   "max": 16,
   "kind": "dialogue",
   "jp": "けっ\\n言ってろ",
   "en": "",
   "op": "0x62",
   "msg": "0x518f"
  },
  {
   "id": "m_012002:0x1cc10",
   "off": 117776,
   "max": 60,
   "kind": "dialogue",
   "jp": "この間はしっかり\\nソウちん達の歌を\\n聴けんかったからなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x5190"
  },
  {
   "id": "m_012002:0x1ccf4",
   "off": 118004,
   "max": 28,
   "kind": "dialogue",
   "jp": "今日は楽しみにしてるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5191"
  },
  {
   "id": "m_012002:0x1d3b4",
   "off": 119732,
   "max": 40,
   "kind": "dialogue",
   "jp": "……ああ\\n日本の威信が\\nかかっている",
   "en": "",
   "op": "0x62",
   "msg": "0x5192"
  },
  {
   "id": "m_012002:0x1d3f8",
   "off": 119800,
   "max": 28,
   "kind": "dialogue",
   "jp": "簡単に負けるつもりはない",
   "en": "",
   "op": "0x62",
   "msg": "0x5193"
  },
  {
   "id": "m_012002:0x1da60",
   "off": 121440,
   "max": 48,
   "kind": "dialogue",
   "jp": "しかしジュニアは強敵です\\n気をつけてください",
   "en": "",
   "op": "0x62",
   "msg": "0x5194"
  },
  {
   "id": "m_012002:0x1df0c",
   "off": 122636,
   "max": 64,
   "kind": "dialogue",
   "jp": "重々承知の上だ\\nだが　総司が作ってくれた\\nこの機会（チャンス）",
   "en": "",
   "op": "0x62",
   "msg": "0x5195"
  },
  {
   "id": "m_012002:0x1df5c",
   "off": 122716,
   "max": 48,
   "kind": "dialogue",
   "jp": "逃すわけにはいかない\\n全力でヤツに立ち向かうぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x5196"
  },
  {
   "id": "m_012002:0x1e628",
   "off": 124456,
   "max": 20,
   "kind": "dialogue",
   "jp": "勝算はあるのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5197"
  },
  {
   "id": "m_012002:0x1eedc",
   "off": 126684,
   "max": 24,
   "kind": "dialogue",
   "jp": "ああ\\n鳳舞合奏を使う",
   "en": "",
   "op": "0x62",
   "msg": "0x5198"
  },
  {
   "id": "m_012002:0x1f7d4",
   "off": 128980,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんじゃと\\nそれはダメじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5199"
  },
  {
   "id": "m_012002:0x1f89c",
   "off": 129180,
   "max": 56,
   "kind": "dialogue",
   "jp": "いくらじゅにあに\\n勝つためでも\\n鳳舞合奏はいかんぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x519a"
  },
  {
   "id": "m_012002:0x1fff0",
   "off": 131056,
   "max": 36,
   "kind": "dialogue",
   "jp": "まあまあ\\n落ち着いてよ\\nトサカくん",
   "en": "",
   "op": "0x62",
   "msg": "0x519b"
  },
  {
   "id": "m_012002:0x20024",
   "off": 131108,
   "max": 40,
   "kind": "dialogue",
   "jp": "天歌だって元は人を\\n癒すための音楽だよ",
   "en": "",
   "op": "0x62",
   "msg": "0x519c"
  },
  {
   "id": "m_012002:0x20690",
   "off": 132752,
   "max": 60,
   "kind": "dialogue",
   "jp": "ああ　今の俺達の\\n鳳舞合奏は井伊大老の\\n作ったものではない",
   "en": "",
   "op": "0x62",
   "msg": "0x519d"
  },
  {
   "id": "m_012002:0x20b48",
   "off": 133960,
   "max": 72,
   "kind": "dialogue",
   "jp": "それを元にみんなに\\n楽しんでもらえるように\\n改造（アレンジ）したんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x519e"
  },
  {
   "id": "m_012002:0x214c8",
   "off": 136392,
   "max": 40,
   "kind": "dialogue",
   "jp": "そうじゃったのか\\n早とちりしてすまん",
   "en": "",
   "op": "0x62",
   "msg": "0x519f"
  },
  {
   "id": "m_012002:0x21598",
   "off": 136600,
   "max": 44,
   "kind": "dialogue",
   "jp": "ヒジゾーさんも\\nソウちんも\\n本気なんじゃな",
   "en": "",
   "op": "0x62",
   "msg": "0x51a0"
  },
  {
   "id": "m_012002:0x21da0",
   "off": 138656,
   "max": 72,
   "kind": "dialogue",
   "jp": "ああ　お前達との雷舞で\\nジュニアがどれほどの\\n実力者かはわかっている",
   "en": "",
   "op": "0x62",
   "msg": "0x51a1"
  },
  {
   "id": "m_012002:0x22264",
   "off": 139876,
   "max": 36,
   "kind": "dialogue",
   "jp": "出し惜しみなんて\\nしてられないよ",
   "en": "",
   "op": "0x62",
   "msg": "0x51a2"
  },
  {
   "id": "m_012002:0x22704",
   "off": 141060,
   "max": 56,
   "kind": "dialogue",
   "jp": "そういうわけだ\\n今日は観客席で\\n俺たちの歌を聴いていろ",
   "en": "",
   "op": "0x62",
   "msg": "0x51a3"
  },
  {
   "id": "m_012002:0x22ec8",
   "off": 143048,
   "max": 32,
   "kind": "dialogue",
   "jp": "わかった\\n楽しみにしてるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x51a4"
  },
  {
   "id": "m_012002:0x236c8",
   "off": 145096,
   "max": 56,
   "kind": "dialogue",
   "jp": "先を越されるようで\\n腹は立つが……\\n負けるんじゃねえぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x51a5"
  },
  {
   "id": "m_012002:0x23b7c",
   "off": 146300,
   "max": 20,
   "kind": "dialogue",
   "jp": "頑張ってください",
   "en": "",
   "op": "0x62",
   "msg": "0x51a6"
  },
  {
   "id": "m_012002:0x24314",
   "off": 148244,
   "max": 68,
   "kind": "dialogue",
   "jp": "わしらも特訓中なんじゃ\\n勝っても負けても\\nまた五人で雷舞するぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x51a7"
  },
  {
   "id": "m_012002:0x24b34",
   "off": 150324,
   "max": 48,
   "kind": "dialogue",
   "jp": "どうせなら勝って\\n祝勝雷舞と\\nしたいところだ",
   "en": "",
   "op": "0x62",
   "msg": "0x51a8"
  },
  {
   "id": "m_012002:0x24ff0",
   "off": 151536,
   "max": 56,
   "kind": "dialogue",
   "jp": "っと時間だ\\nじゃあ　僕　ジュニアの\\nところへ行ってくる",
   "en": "",
   "op": "0x62",
   "msg": "0x51a9"
  },
  {
   "id": "m_012002:0x254ac",
   "off": 152748,
   "max": 40,
   "kind": "dialogue",
   "jp": "俺も準備をしてこよう\\nまたな　三人とも",
   "en": "",
   "op": "0x62",
   "msg": "0x51aa"
  },
  {
   "id": "m_012002:0x25868",
   "off": 153704,
   "max": 20,
   "kind": "choice",
   "jp": "ソウちん　頑張れよ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_012002:0x25888",
   "off": 153736,
   "max": 24,
   "kind": "choice",
   "jp": "ヒジゾーさん　ファイト",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_012002:0x258ac",
   "off": 153772,
   "max": 24,
   "kind": "choice",
   "jp": "じゅにあにもよろしく",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_012002:0x260b8",
   "off": 155832,
   "max": 24,
   "kind": "dialogue",
   "jp": "ソウちん\\n頑張れよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x51ab"
  },
  {
   "id": "m_012002:0x26710",
   "off": 157456,
   "max": 56,
   "kind": "dialogue",
   "jp": "あはは　僕の魅力で\\nジュニアもめろめろに\\nしてくるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x51ac"
  },
  {
   "id": "m_012002:0x26c5c",
   "off": 158812,
   "max": 20,
   "kind": "dialogue",
   "jp": "さすがソウちん！",
   "en": "",
   "op": "0x62",
   "msg": "0x51ad"
  },
  {
   "id": "m_012002:0x27608",
   "off": 161288,
   "max": 28,
   "kind": "dialogue",
   "jp": "ヒジゾーさん\\nファイトぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x51ae"
  },
  {
   "id": "m_012002:0x27c68",
   "off": 162920,
   "max": 24,
   "kind": "dialogue",
   "jp": "ああ\\n精一杯努めよう",
   "en": "",
   "op": "0x62",
   "msg": "0x51af"
  },
  {
   "id": "m_012002:0x28458",
   "off": 164952,
   "max": 32,
   "kind": "dialogue",
   "jp": "トサカくん\\n僕には何もないの？",
   "en": "",
   "op": "0x62",
   "msg": "0x51b0"
  },
  {
   "id": "m_012002:0x28bb4",
   "off": 166836,
   "max": 36,
   "kind": "dialogue",
   "jp": "もちろんソウちんも\\n頑張るぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x51b1"
  },
  {
   "id": "m_012002:0x29570",
   "off": 169328,
   "max": 24,
   "kind": "dialogue",
   "jp": "じゅにあにもよろしく",
   "en": "",
   "op": "0x62",
   "msg": "0x51b2"
  },
  {
   "id": "m_012002:0x29bc8",
   "off": 170952,
   "max": 44,
   "kind": "dialogue",
   "jp": "はいはーい\\nま　向こうは\\nトサカくんなんて",
   "en": "",
   "op": "0x62",
   "msg": "0x51b3"
  },
  {
   "id": "m_012002:0x29c04",
   "off": 171012,
   "max": 36,
   "kind": "dialogue",
   "jp": "どうでもいいと\\n思ってるけどね～",
   "en": "",
   "op": "0x62",
   "msg": "0x51b4"
  },
  {
   "id": "m_012002:0x2a27c",
   "off": 172668,
   "max": 16,
   "kind": "dialogue",
   "jp": "そ　そうか……",
   "en": "",
   "op": "0x62",
   "msg": "0x51b5"
  },
  {
   "id": "m_012002:0x2a81c",
   "off": 174108,
   "max": 28,
   "kind": "dialogue",
   "jp": "それじゃあ\\nまた後でな～！",
   "en": "",
   "op": "0x62",
   "msg": "0x51b6"
  },
  {
   "id": "m_012002:0x2b0d4",
   "off": 176340,
   "max": 56,
   "kind": "dialogue",
   "jp": "そして始まった新選組と\\nペリージュニアとの\\n合同雷舞",
   "en": "",
   "op": "0x62",
   "msg": "0x51b7"
  },
  {
   "id": "m_012002:0x2b11c",
   "off": 176412,
   "max": 68,
   "kind": "dialogue",
   "jp": "日本随一の愛獲だけあり\\n新選組が姿を現すだけで\\n歓声が巻き起こった",
   "en": "",
   "op": "0x62",
   "msg": "0x51b8"
  },
  {
   "id": "m_012002:0x2b8f8",
   "off": 178424,
   "max": 24,
   "kind": "dialogue",
   "jp": "きゃー！\\n土方様～！",
   "en": "",
   "op": "0x62",
   "msg": "0x51b9"
  },
  {
   "id": "m_012002:0x2bd8c",
   "off": 179596,
   "max": 36,
   "kind": "dialogue",
   "jp": "総司きゅ～ん！\\nこっち向いて～っ！",
   "en": "",
   "op": "0x62",
   "msg": "0x51ba"
  },
  {
   "id": "m_012002:0x2c7cc",
   "off": 182220,
   "max": 56,
   "kind": "dialogue",
   "jp": "ふふっ　\\n僕達の人気だって\\nジュニアに負けてないよね",
   "en": "",
   "op": "0x62",
   "msg": "0x51bb"
  },
  {
   "id": "m_012002:0x2cc80",
   "off": 183424,
   "max": 32,
   "kind": "dialogue",
   "jp": "気を抜くな　総司\\n全力で行くぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x51bc"
  },
  {
   "id": "m_012002:0x2d1b4",
   "off": 184756,
   "max": 8,
   "kind": "dialogue",
   "jp": "は～い",
   "en": "",
   "op": "0x62",
   "msg": "0x51bd"
  },
  {
   "id": "m_012002:0x2d568",
   "off": 185704,
   "max": 72,
   "kind": "dialogue",
   "jp": "表情を引き締めた\\n土方の傍らで\\n沖田が完全無欠の\\n愛獲笑顔を浮かべる",
   "en": "",
   "op": "0x62",
   "msg": "0x51be"
  },
  {
   "id": "m_012002:0x2d5c0",
   "off": 185792,
   "max": 40,
   "kind": "dialogue",
   "jp": "それを見た女性煌が\\n黄色い悲鳴を上げる",
   "en": "",
   "op": "0x62",
   "msg": "0x51bf"
  },
  {
   "id": "m_012002:0x2dd70",
   "off": 187760,
   "max": 40,
   "kind": "dialogue",
   "jp": "俺達の歌が\\n聴きたいのならば\\n静まれ",
   "en": "",
   "op": "0x62",
   "msg": "0x51c0"
  },
  {
   "id": "m_012002:0x2dda8",
   "off": 187816,
   "max": 40,
   "kind": "dialogue",
   "jp": "今宵はお前達と新選組の\\n蘭出舞の日だ",
   "en": "",
   "op": "0x62",
   "msg": "0x51c1"
  },
  {
   "id": "m_012002:0x2de7c",
   "off": 188028,
   "max": 56,
   "kind": "dialogue",
   "jp": "我々の歌と踊りに\\n酔いしれ……\\n身も心も俺達に捧げろ",
   "en": "",
   "op": "0x62",
   "msg": "0x51c2"
  },
  {
   "id": "m_012002:0x2e554",
   "off": 189780,
   "max": 56,
   "kind": "dialogue",
   "jp": "今日　この雷舞へ来ることが\\nできた人は　とても幸運だね",
   "en": "",
   "op": "0x62",
   "msg": "0x51c3"
  },
  {
   "id": "m_012002:0x2e634",
   "off": 190004,
   "max": 56,
   "kind": "dialogue",
   "jp": "僕たち　新選組は\\n新たな段階（ステップ）を\\n踏み出す",
   "en": "",
   "op": "0x62",
   "msg": "0x51c4"
  },
  {
   "id": "m_012002:0x2e67c",
   "off": 190076,
   "max": 40,
   "kind": "dialogue",
   "jp": "今日の雷舞は\\nきっと歴史に残るはずさ",
   "en": "",
   "op": "0x62",
   "msg": "0x51c5"
  },
  {
   "id": "m_012002:0x2e74c",
   "off": 190284,
   "max": 40,
   "kind": "dialogue",
   "jp": "いいかい？\\nまばたきだって\\n厳禁だよ",
   "en": "",
   "op": "0x62",
   "msg": "0x51c6"
  },
  {
   "id": "m_012002:0x2e81c",
   "off": 190492,
   "max": 20,
   "kind": "dialogue",
   "jp": "さあ\\n始めようか！",
   "en": "",
   "op": "0x62",
   "msg": "0x51c7"
  },
  {
   "id": "m_012002:0x2ef48",
   "off": 192328,
   "max": 60,
   "kind": "dialogue",
   "jp": "土方と沖田を中心に\\n新選組の隊士達が\\n見事な踊りを見せる",
   "en": "",
   "op": "0x62",
   "msg": "0x51c8"
  },
  {
   "id": "m_012002:0x2ef94",
   "off": 192404,
   "max": 84,
   "kind": "dialogue",
   "jp": "それは以前の鳳舞合奏\\nとはまるで違い\\n見る者の心を震わせる\\n魂のこもった歌だった",
   "en": "",
   "op": "0x62",
   "msg": "0x51c9"
  },
  {
   "id": "m_012002:0x2f588",
   "off": 193928,
   "max": 52,
   "kind": "dialogue",
   "jp": "すごい！　すごいぜよ！\\nソウちんとヒジゾーさん！",
   "en": "",
   "op": "0x62",
   "msg": "0x51ca"
  },
  {
   "id": "m_012002:0x2fd9c",
   "off": 195996,
   "max": 40,
   "kind": "dialogue",
   "jp": "ああ　これは天歌だが\\n昔とは別物だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x51cb"
  },
  {
   "id": "m_012002:0x30240",
   "off": 197184,
   "max": 72,
   "kind": "dialogue",
   "jp": "この間は　きちんと\\n聴けませんでしたが\\n二人の実力が\\n伝わってきます",
   "en": "",
   "op": "0x62",
   "msg": "0x51cc"
  },
  {
   "id": "m_012002:0x30a0c",
   "off": 199180,
   "max": 60,
   "kind": "dialogue",
   "jp": "わしが修行に出てる間\\nヒジゾーさん達も\\n頑張ってたんじゃな",
   "en": "",
   "op": "0x62",
   "msg": "0x51cd"
  },
  {
   "id": "m_012002:0x31228",
   "off": 201256,
   "max": 44,
   "kind": "dialogue",
   "jp": "これはオレ様達も\\nうかうかしてられないぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x51ce"
  },
  {
   "id": "m_012002:0x316d0",
   "off": 202448,
   "max": 40,
   "kind": "dialogue",
   "jp": "ええ　体も心も\\n熱くなってきました！",
   "en": "",
   "op": "0x62",
   "msg": "0x51cf"
  },
  {
   "id": "m_012002:0x32044",
   "off": 204868,
   "max": 52,
   "kind": "dialogue",
   "jp": "ううう！\\nわしはもう昂ぶりが\\n抑えられんぜよ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x51d0"
  },
  {
   "id": "m_012002:0x32d3c",
   "off": 208188,
   "max": 32,
   "kind": "dialogue",
   "jp": "バカ！　落ち着け！\\n脱ぐな！",
   "en": "",
   "op": "0x62",
   "msg": "0x51d1"
  },
  {
   "id": "m_012002:0x3387c",
   "off": 211068,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふふん\\n当然の反応\\n（リアクション）だね",
   "en": "",
   "op": "0x62",
   "msg": "0x51d2"
  },
  {
   "id": "m_012002:0x33d24",
   "off": 212260,
   "max": 64,
   "kind": "dialogue",
   "jp": "もう一曲　お前たちに\\n贈りたいところだが\\n次はジュニアの番だ",
   "en": "",
   "op": "0x62",
   "msg": "0x51d3"
  },
  {
   "id": "m_012002:0x342f4",
   "off": 213748,
   "max": 56,
   "kind": "dialogue",
   "jp": "ちらりと土方が袖を見ると\\n悠然とジュニアが\\n歩いてきた",
   "en": "",
   "op": "0x62",
   "msg": "0x51d4"
  },
  {
   "id": "m_012002:0x3433c",
   "off": 213820,
   "max": 64,
   "kind": "dialogue",
   "jp": "背後にＪを従え\\n王者のごとくゆったりと\\n構える姿に気負いはない",
   "en": "",
   "op": "0x62",
   "msg": "0x51d5"
  },
  {
   "id": "m_012002:0x3438c",
   "off": 213900,
   "max": 60,
   "kind": "dialogue",
   "jp": "新選組を讃える歓声すら\\n自分のものと\\n思っているようだった",
   "en": "",
   "op": "0x62",
   "msg": "0x51d6"
  },
  {
   "id": "m_012002:0x34808",
   "off": 215048,
   "max": 56,
   "kind": "dialogue",
   "jp": "大体　オッケー\\nさっきのが　この国の\\nアイドルソング",
   "en": "",
   "op": "0x62",
   "msg": "0x51d7"
  },
  {
   "id": "m_012002:0x34850",
   "off": 215120,
   "max": 36,
   "kind": "dialogue",
   "jp": "そしてここからは\\nロックの時間だ",
   "en": "",
   "op": "0x62",
   "msg": "0x51d8"
  },
  {
   "id": "m_012002:0x34fc0",
   "off": 217024,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x51d9"
  },
  {
   "id": "m_012002:0x35974",
   "off": 219508,
   "max": 36,
   "kind": "dialogue",
   "jp": "オレに会いにきてくれた\\nレディたち",
   "en": "",
   "op": "0x62",
   "msg": "0x51da"
  },
  {
   "id": "m_012002:0x359a8",
   "off": 219560,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレのロックで\\nレディ達を\\n一夜の夢に誘おう",
   "en": "",
   "op": "0x62",
   "msg": "0x51db"
  },
  {
   "id": "m_012002:0x35a80",
   "off": 219776,
   "max": 12,
   "kind": "dialogue",
   "jp": "いいね？",
   "en": "",
   "op": "0x62",
   "msg": "0x51dc"
  },
  {
   "id": "m_012002:0x360f4",
   "off": 221428,
   "max": 72,
   "kind": "dialogue",
   "jp": "ジュニアが甘く\\nウィンクを決めただけで\\n会場がシンと\\n静まりかえった",
   "en": "",
   "op": "0x62",
   "msg": "0x51dd"
  },
  {
   "id": "m_012002:0x36158",
   "off": 221528,
   "max": 48,
   "kind": "dialogue",
   "jp": "そして次の瞬間\\n割れんばかりの大歓声が\\n起こる",
   "en": "",
   "op": "0x62",
   "msg": "0x51de"
  },
  {
   "id": "m_012002:0x367dc",
   "off": 223196,
   "max": 40,
   "kind": "dialogue",
   "jp": "目をぱちっとしただけで\\nあんなに……",
   "en": "",
   "op": "0x62",
   "msg": "0x51df"
  },
  {
   "id": "m_012002:0x368b4",
   "off": 223412,
   "max": 24,
   "kind": "dialogue",
   "jp": "わしらもやってみるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x51e0"
  },
  {
   "id": "m_012002:0x37050",
   "off": 225360,
   "max": 48,
   "kind": "dialogue",
   "jp": "バカ野郎\\nオレ様達はあくまで\\n音楽で勝負だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x51e1"
  },
  {
   "id": "m_012002:0x37790",
   "off": 227216,
   "max": 52,
   "kind": "dialogue",
   "jp": "いや　でもあれも一つの\\nパフォーマンスですよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x51e2"
  },
  {
   "id": "m_012002:0x382e8",
   "off": 230120,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x51e3"
  },
  {
   "id": "m_012002:0x38820",
   "off": 231456,
   "max": 48,
   "kind": "dialogue",
   "jp": "オッケー　Ｊ\\nトークだけじゃ\\n物足りないよな",
   "en": "",
   "op": "0x62",
   "msg": "0x51e4"
  },
  {
   "id": "m_012002:0x39148",
   "off": 233800,
   "max": 56,
   "kind": "dialogue",
   "jp": "レディ達が待っているのは\\nオレのロック\\nそれは神の啓示",
   "en": "",
   "op": "0x62",
   "msg": "0x51e5"
  },
  {
   "id": "m_012002:0x39694",
   "off": 235156,
   "max": 52,
   "kind": "dialogue",
   "jp": "さあ　溺れてくれ……！\\nイッツ　ロッケンローッ！",
   "en": "",
   "op": "0x62",
   "msg": "0x51e6"
  },
  {
   "id": "m_012002:0x39efc",
   "off": 237308,
   "max": 80,
   "kind": "dialogue",
   "jp": "完成され尽くした\\nギターリフが始まった瞬間\\n全ての観客がジュニアに\\n魅了された",
   "en": "",
   "op": "0x62",
   "msg": "0x51e7"
  },
  {
   "id": "m_012002:0x39f5c",
   "off": 237404,
   "max": 76,
   "kind": "dialogue",
   "jp": "それは先ほど鳳舞合奏に\\n酔いしれていた\\n新選組の煌とて\\n例外ではなかった",
   "en": "",
   "op": "0x62",
   "msg": "0x51e8"
  },
  {
   "id": "m_012002:0x3a58c",
   "off": 238988,
   "max": 56,
   "kind": "dialogue",
   "jp": "きゃーっっ！\\nジュニア様！\\n新選組も良かったけど……",
   "en": "",
   "op": "0x62",
   "msg": "0x51e9"
  },
  {
   "id": "m_012002:0x3aa9c",
   "off": 240284,
   "max": 48,
   "kind": "dialogue",
   "jp": "ジュニア様の方が百倍\\nううん　百万倍ステキ～！",
   "en": "",
   "op": "0x62",
   "msg": "0x51ea"
  },
  {
   "id": "m_012002:0x3b518",
   "off": 242968,
   "max": 12,
   "kind": "dialogue",
   "jp": "なっ……",
   "en": "",
   "op": "0x62",
   "msg": "0x51eb"
  },
  {
   "id": "m_012002:0x3bf64",
   "off": 245604,
   "max": 52,
   "kind": "dialogue",
   "jp": "あんなすごい鳳舞合奏でも\\nじゅにあには勝てんのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x51ec"
  },
  {
   "id": "m_012002:0x3c638",
   "off": 247352,
   "max": 48,
   "kind": "dialogue",
   "jp": "見ろ　ヤツの超魂のうねり\\n尋常じゃねえ……！",
   "en": "",
   "op": "0x62",
   "msg": "0x51ed"
  },
  {
   "id": "m_012002:0x3cd04",
   "off": 249092,
   "max": 36,
   "kind": "dialogue",
   "jp": "ええ　神々しささえ\\n感じます……！",
   "en": "",
   "op": "0x62",
   "msg": "0x51ee"
  },
  {
   "id": "m_012002:0x3d878",
   "off": 252024,
   "max": 60,
   "kind": "dialogue",
   "jp": "ベイビィ達\\nここからもっと激しくなる\\n立ってられるかな？",
   "en": "",
   "op": "0x62",
   "msg": "0x51ef"
  },
  {
   "id": "m_012002:0x3de70",
   "off": 253552,
   "max": 56,
   "kind": "dialogue",
   "jp": "ジュニアの曲に\\n魅了されているのは\\n観客ばかりではない",
   "en": "",
   "op": "0x62",
   "msg": "0x51f0"
  },
  {
   "id": "m_012002:0x3deb8",
   "off": 253624,
   "max": 68,
   "kind": "dialogue",
   "jp": "舞台の上にいた新選組の\\n隊士すら\\n今やジュニアの虜と\\nなっていた",
   "en": "",
   "op": "0x62",
   "msg": "0x51f1"
  },
  {
   "id": "m_012002:0x3e4ec",
   "off": 255212,
   "max": 36,
   "kind": "dialogue",
   "jp": "ああっ　くやしいが\\nやっぱすげえ！",
   "en": "",
   "op": "0x62",
   "msg": "0x51f2"
  },
  {
   "id": "m_012002:0x3e98c",
   "off": 256396,
   "max": 48,
   "kind": "dialogue",
   "jp": "うおおお！　ジュニア！\\n俺もお前の虜だ～っ！",
   "en": "",
   "op": "0x62",
   "msg": "0x51f3"
  },
  {
   "id": "m_012002:0x3f14c",
   "off": 258380,
   "max": 24,
   "kind": "dialogue",
   "jp": "くっ……\\nお前たち……",
   "en": "",
   "op": "0x62",
   "msg": "0x51f4"
  },
  {
   "id": "m_012002:0x3f51c",
   "off": 259356,
   "max": 44,
   "kind": "dialogue",
   "jp": "立ち上がり隊士達を\\n叱咤しようとする土方",
   "en": "",
   "op": "0x62",
   "msg": "0x51f5"
  },
  {
   "id": "m_012002:0x3f75c",
   "off": 259932,
   "max": 60,
   "kind": "dialogue",
   "jp": "しかし　その土方も\\nジュニアの超魂の力に\\n圧され　膝をつく",
   "en": "",
   "op": "0x62",
   "msg": "0x51f6"
  },
  {
   "id": "m_012002:0x3f848",
   "off": 260168,
   "max": 44,
   "kind": "dialogue",
   "jp": "だが　\\nそこで立ち上がったのは\\n沖田だった",
   "en": "",
   "op": "0x62",
   "msg": "0x51f7"
  },
  {
   "id": "m_012002:0x3fd40",
   "off": 261440,
   "max": 28,
   "kind": "dialogue",
   "jp": "土方さんは\\n休んでて下さい",
   "en": "",
   "op": "0x62",
   "msg": "0x51f8"
  },
  {
   "id": "m_012002:0x40274",
   "off": 262772,
   "max": 16,
   "kind": "dialogue",
   "jp": "総司\\nお前……",
   "en": "",
   "op": "0x62",
   "msg": "0x51f9"
  },
  {
   "id": "m_012002:0x40714",
   "off": 263956,
   "max": 48,
   "kind": "dialogue",
   "jp": "僕にだって新選組隊士と\\nしての意地があります",
   "en": "",
   "op": "0x62",
   "msg": "0x51fa"
  },
  {
   "id": "m_012002:0x41478",
   "off": 267384,
   "max": 32,
   "kind": "dialogue",
   "jp": "ん？　ナデシコ？\\nどうした？",
   "en": "",
   "op": "0x62",
   "msg": "0x51fb"
  },
  {
   "id": "m_012002:0x41540",
   "off": 267584,
   "max": 32,
   "kind": "dialogue",
   "jp": "オレとデュエット\\nしたいのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x51fc"
  },
  {
   "id": "m_012002:0x419dc",
   "off": 268764,
   "max": 16,
   "kind": "dialogue",
   "jp": "そのつもりだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x51fd"
  },
  {
   "id": "m_012002:0x41e68",
   "off": 269928,
   "max": 60,
   "kind": "dialogue",
   "jp": "こういうの柄じゃないけど\\n僕の歌で痺れさせて\\nあげるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x51fe"
  }
 ]
}
