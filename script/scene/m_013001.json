{
 "source": "m_013001.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_013001:0x11d0",
   "off": 4560,
   "max": 32,
   "kind": "dialogue",
   "jp": "ジュニアに\\n敗北を喫した龍馬達",
   "en": "",
   "op": "0x62",
   "msg": "0x5330"
  },
  {
   "id": "m_013001:0x1200",
   "off": 4608,
   "max": 48,
   "kind": "dialogue",
   "jp": "そこに現れたのは\\n誠仮面と名乗る\\n謎の男だった",
   "en": "",
   "op": "0x62",
   "msg": "0x5331"
  },
  {
   "id": "m_013001:0x1240",
   "off": 4672,
   "max": 76,
   "kind": "dialogue",
   "jp": "誠仮面は\\n龍馬達に特訓を課す\\nそれがジュニアに勝つ\\n唯一の道だと彼は言う",
   "en": "",
   "op": "0x62",
   "msg": "0x5332"
  },
  {
   "id": "m_013001:0x129c",
   "off": 4764,
   "max": 60,
   "kind": "dialogue",
   "jp": "彼らが地獄の特訓に\\n叩き込まれてから\\n数日が経っていた――",
   "en": "",
   "op": "0x62",
   "msg": "0x5333"
  },
  {
   "id": "m_013001:0x1720",
   "off": 5920,
   "max": 36,
   "kind": "dialogue",
   "jp": "はいはい\\nみんな！\\n起きて起きて！",
   "en": "",
   "op": "0x62",
   "msg": "0x5334"
  },
  {
   "id": "m_013001:0x1ca4",
   "off": 7332,
   "max": 52,
   "kind": "dialogue",
   "jp": "うう～ん……\\nもう少しだけ\\n寝かせてください……",
   "en": "",
   "op": "0x62",
   "msg": "0x5335"
  },
  {
   "id": "m_013001:0x2158",
   "off": 8536,
   "max": 40,
   "kind": "dialogue",
   "jp": "特訓じゃねえ\\nロックの練習がしてぇ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5336"
  },
  {
   "id": "m_013001:0x2600",
   "off": 9728,
   "max": 52,
   "kind": "dialogue",
   "jp": "むにゃむにゃ……\\nロックンロールは\\n最高ぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5337"
  },
  {
   "id": "m_013001:0x2d34",
   "off": 11572,
   "max": 44,
   "kind": "dialogue",
   "jp": "起きないつもりなら\\nこっちにも考えがあるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5338"
  },
  {
   "id": "m_013001:0x36fc",
   "off": 14076,
   "max": 52,
   "kind": "dialogue",
   "jp": "たしかこの辺りに\\n……あったあった\\nよ～し　これで",
   "en": "",
   "op": "0x62",
   "msg": "0x5339"
  },
  {
   "id": "m_013001:0x47f8",
   "off": 18424,
   "max": 36,
   "kind": "dialogue",
   "jp": "わあ\\nな　なんじゃ　なんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x533a"
  },
  {
   "id": "m_013001:0x5008",
   "off": 20488,
   "max": 48,
   "kind": "dialogue",
   "jp": "うおおっ！\\n今度こそジュニアの\\n野郎の襲撃か",
   "en": "",
   "op": "0x62",
   "msg": "0x533b"
  },
  {
   "id": "m_013001:0x56dc",
   "off": 22236,
   "max": 44,
   "kind": "dialogue",
   "jp": "ふぁ\\nメ　メガネ\\nメガネはどこですか？",
   "en": "",
   "op": "0x62",
   "msg": "0x533c"
  },
  {
   "id": "m_013001:0x5f2c",
   "off": 24364,
   "max": 24,
   "kind": "dialogue",
   "jp": "おはよう\\n目は覚めた？",
   "en": "",
   "op": "0x62",
   "msg": "0x533d"
  },
  {
   "id": "m_013001:0x6780",
   "off": 26496,
   "max": 8,
   "kind": "dialogue",
   "jp": "沖田！",
   "en": "",
   "op": "0x62",
   "msg": "0x533e"
  },
  {
   "id": "m_013001:0x6c68",
   "off": 27752,
   "max": 12,
   "kind": "dialogue",
   "jp": "沖田くん",
   "en": "",
   "op": "0x62",
   "msg": "0x533f"
  },
  {
   "id": "m_013001:0x7420",
   "off": 29728,
   "max": 40,
   "kind": "dialogue",
   "jp": "ふぁぁぁぁ\\nおはようぜよ～\\nソウちん",
   "en": "",
   "op": "0x62",
   "msg": "0x5340"
  },
  {
   "id": "m_013001:0x7ae0",
   "off": 31456,
   "max": 16,
   "kind": "dialogue",
   "jp": "あのさ　君たち",
   "en": "",
   "op": "0x62",
   "msg": "0x5341"
  },
  {
   "id": "m_013001:0x7b00",
   "off": 31488,
   "max": 52,
   "kind": "dialogue",
   "jp": "毎朝　耳元で拳銃を\\n発射されないと\\n起きないわけ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5342"
  },
  {
   "id": "m_013001:0x8180",
   "off": 33152,
   "max": 36,
   "kind": "dialogue",
   "jp": "あっ\\nオレ様の拳銃！\\n返しやがれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5343"
  },
  {
   "id": "m_013001:0x8620",
   "off": 34336,
   "max": 52,
   "kind": "dialogue",
   "jp": "言われなくたって\\nこんな無粋なもの\\n返すよ　ほら",
   "en": "",
   "op": "0x62",
   "msg": "0x5344"
  },
  {
   "id": "m_013001:0x8d28",
   "off": 36136,
   "max": 24,
   "kind": "dialogue",
   "jp": "返せ！\\nまったく……",
   "en": "",
   "op": "0x62",
   "msg": "0x5345"
  },
  {
   "id": "m_013001:0x94c4",
   "off": 38084,
   "max": 56,
   "kind": "dialogue",
   "jp": "わしは　てっきり\\n誠仮面が起こしに\\n来たかと思ったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5346"
  },
  {
   "id": "m_013001:0x9b98",
   "off": 39832,
   "max": 64,
   "kind": "dialogue",
   "jp": "せっかく新曲もできたし\\nぐっすり眠れると\\n思っていたのですが",
   "en": "",
   "op": "0x62",
   "msg": "0x5347"
  },
  {
   "id": "m_013001:0xa384",
   "off": 41860,
   "max": 36,
   "kind": "dialogue",
   "jp": "は？\\n誠仮面？　新曲？\\nなにそれ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5348"
  },
  {
   "id": "m_013001:0xac6c",
   "off": 44140,
   "max": 60,
   "kind": "dialogue",
   "jp": "おはよう諸君\\nわたしなら　ここだ！\\n今日も存分に特訓を――",
   "en": "",
   "op": "0x62",
   "msg": "0x5349"
  },
  {
   "id": "m_013001:0xb4bc",
   "off": 46268,
   "max": 4,
   "kind": "dialogue",
   "jp": "あ",
   "en": "",
   "op": "0x62",
   "msg": "0x534a"
  },
  {
   "id": "m_013001:0xbef4",
   "off": 48884,
   "max": 44,
   "kind": "dialogue",
   "jp": "うおっ\\n総司　じゃなくて\\nお　沖田君",
   "en": "",
   "op": "0x62",
   "msg": "0x534b"
  },
  {
   "id": "m_013001:0xc89c",
   "off": 51356,
   "max": 32,
   "kind": "dialogue",
   "jp": "どっ　どどど\\nどうしたのかね",
   "en": "",
   "op": "0x62",
   "msg": "0x534c"
  },
  {
   "id": "m_013001:0xc8cc",
   "off": 51404,
   "max": 60,
   "kind": "dialogue",
   "jp": "君は　その　ジュニアの\\n世話役を仰せつかっていた\\nはずでは",
   "en": "",
   "op": "0x62",
   "msg": "0x534d"
  },
  {
   "id": "m_013001:0xcfa0",
   "off": 53152,
   "max": 12,
   "kind": "dialogue",
   "jp": "……あの",
   "en": "",
   "op": "0x62",
   "msg": "0x534e"
  },
  {
   "id": "m_013001:0xd784",
   "off": 55172,
   "max": 36,
   "kind": "dialogue",
   "jp": "そ　そんなに私を\\n見るんじゃないっ",
   "en": "",
   "op": "0x62",
   "msg": "0x534f"
  },
  {
   "id": "m_013001:0xe33c",
   "off": 58172,
   "max": 32,
   "kind": "dialogue",
   "jp": "私は誠仮面！\\nロックの使者だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5350"
  },
  {
   "id": "m_013001:0xeb90",
   "off": 60304,
   "max": 48,
   "kind": "dialogue",
   "jp": "仮面をかぶった\\n鼻息の荒い\\n変態は置いといて",
   "en": "",
   "op": "0x62",
   "msg": "0x5351"
  },
  {
   "id": "m_013001:0xf3b8",
   "off": 62392,
   "max": 36,
   "kind": "dialogue",
   "jp": "変態\\n違うぞ　違うんだ！\\n沖田君",
   "en": "",
   "op": "0x62",
   "msg": "0x5352"
  },
  {
   "id": "m_013001:0xfb68",
   "off": 64360,
   "max": 36,
   "kind": "dialogue",
   "jp": "トサカくん\\nスカシくん\\nメガネくん",
   "en": "",
   "op": "0x62",
   "msg": "0x5353"
  },
  {
   "id": "m_013001:0xfb9c",
   "off": 64412,
   "max": 64,
   "kind": "dialogue",
   "jp": "君たちに　報せなきゃ\\nならないことがあって\\n抜け出してきたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5354"
  },
  {
   "id": "m_013001:0x10274",
   "off": 66164,
   "max": 24,
   "kind": "dialogue",
   "jp": "報せ？\\nわしらにか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5355"
  },
  {
   "id": "m_013001:0x10924",
   "off": 67876,
   "max": 72,
   "kind": "dialogue",
   "jp": "本当は土方さんの判断を\\n仰ぐべきなんだけど\\nここ数日　見当たらなくて",
   "en": "",
   "op": "0x62",
   "msg": "0x5356"
  },
  {
   "id": "m_013001:0x110f0",
   "off": 69872,
   "max": 24,
   "kind": "dialogue",
   "jp": "そ　それは大変だったな",
   "en": "",
   "op": "0x62",
   "msg": "0x5357"
  },
  {
   "id": "m_013001:0x116a0",
   "off": 71328,
   "max": 52,
   "kind": "dialogue",
   "jp": "僕の独断で\\nトサカくんたちに\\n報せに来たんだけど",
   "en": "",
   "op": "0x62",
   "msg": "0x5358"
  },
  {
   "id": "m_013001:0x11e58",
   "off": 73304,
   "max": 84,
   "kind": "dialogue",
   "jp": "それは\\nちと早まったんじゃないか？\\n勝手なことをすると\\nヒジゾーさんに怒られるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5359"
  },
  {
   "id": "m_013001:0x12544",
   "off": 75076,
   "max": 44,
   "kind": "dialogue",
   "jp": "うーん\\nたぶん怒らないんじゃ\\nないかなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x535a"
  },
  {
   "id": "m_013001:0x12bbc",
   "off": 76732,
   "max": 32,
   "kind": "dialogue",
   "jp": "そこの人も\\nそう思いますよね？",
   "en": "",
   "op": "0x62",
   "msg": "0x535b"
  },
  {
   "id": "m_013001:0x1325c",
   "off": 78428,
   "max": 52,
   "kind": "dialogue",
   "jp": "そ　そうだな\\n君の判断は正しかったんじゃ\\nないか",
   "en": "",
   "op": "0x62",
   "msg": "0x535c"
  },
  {
   "id": "m_013001:0x13850",
   "off": 79952,
   "max": 64,
   "kind": "dialogue",
   "jp": "その土方という人も\\n咎めはしないだろう\\nうん　そうに違いない",
   "en": "",
   "op": "0x62",
   "msg": "0x535d"
  },
  {
   "id": "m_013001:0x1401c",
   "off": 81948,
   "max": 56,
   "kind": "dialogue",
   "jp": "そういえば\\nわしもヒジゾーさんは\\nしばらく見てないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x535e"
  },
  {
   "id": "m_013001:0x14838",
   "off": 84024,
   "max": 64,
   "kind": "dialogue",
   "jp": "僕が接待名目で\\n貞操の危機までさらして\\n黒船に通っていたのに",
   "en": "",
   "op": "0x62",
   "msg": "0x535f"
  },
  {
   "id": "m_013001:0x14888",
   "off": 84104,
   "max": 28,
   "kind": "dialogue",
   "jp": "土方さんってば\\nひどいよね",
   "en": "",
   "op": "0x62",
   "msg": "0x5360"
  },
  {
   "id": "m_013001:0x14db8",
   "off": 85432,
   "max": 28,
   "kind": "dialogue",
   "jp": "そう思いません？\\nそこの人",
   "en": "",
   "op": "0x62",
   "msg": "0x5361"
  },
  {
   "id": "m_013001:0x1545c",
   "off": 87132,
   "max": 40,
   "kind": "dialogue",
   "jp": "いや　まあ\\n彼には彼なりに\\n事情が……",
   "en": "",
   "op": "0x62",
   "msg": "0x5362"
  },
  {
   "id": "m_013001:0x15a40",
   "off": 88640,
   "max": 68,
   "kind": "dialogue",
   "jp": "こんな状況だもの\\n居ても立ってもいられない\\n気持ちは分かるけどさ",
   "en": "",
   "op": "0x62",
   "msg": "0x5363"
  },
  {
   "id": "m_013001:0x15a9c",
   "off": 88732,
   "max": 64,
   "kind": "dialogue",
   "jp": "僕にくらい一言あっても\\nいいんじゃないかなー\\nねえ　そこの人",
   "en": "",
   "op": "0x62",
   "msg": "0x5364"
  },
  {
   "id": "m_013001:0x160c0",
   "off": 90304,
   "max": 24,
   "kind": "dialogue",
   "jp": "す　すまん\\n総司……",
   "en": "",
   "op": "0x62",
   "msg": "0x5365"
  },
  {
   "id": "m_013001:0x16a80",
   "off": 92800,
   "max": 32,
   "kind": "dialogue",
   "jp": "だいたい\\nその仮面はなんなの？",
   "en": "",
   "op": "0x62",
   "msg": "0x5366"
  },
  {
   "id": "m_013001:0x16ab0",
   "off": 92848,
   "max": 48,
   "kind": "dialogue",
   "jp": "それでごまかせるのは\\nトサカくんくらいだよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5367"
  },
  {
   "id": "m_013001:0x16af8",
   "off": 92920,
   "max": 40,
   "kind": "dialogue",
   "jp": "自分で恥ずかしいって\\n思わないのかなぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x5368"
  },
  {
   "id": "m_013001:0x1729c",
   "off": 94876,
   "max": 32,
   "kind": "dialogue",
   "jp": "うう……\\nもう許してくれ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5369"
  },
  {
   "id": "m_013001:0x17964",
   "off": 96612,
   "max": 44,
   "kind": "dialogue",
   "jp": "なんで誠仮面は\\nソウちんに謝ってるんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x536a"
  },
  {
   "id": "m_013001:0x18028",
   "off": 98344,
   "max": 32,
   "kind": "dialogue",
   "jp": "そりゃ謝るよね\\nだって　ねえ？",
   "en": "",
   "op": "0x62",
   "msg": "0x536b"
  },
  {
   "id": "m_013001:0x186ec",
   "off": 100076,
   "max": 48,
   "kind": "dialogue",
   "jp": "お　大人には大人の事情\\nというものがあるんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x536c"
  },
  {
   "id": "m_013001:0x18dc8",
   "off": 101832,
   "max": 24,
   "kind": "dialogue",
   "jp": "誠仮面も大変なんじゃな",
   "en": "",
   "op": "0x62",
   "msg": "0x536d"
  },
  {
   "id": "m_013001:0x195b0",
   "off": 103856,
   "max": 28,
   "kind": "dialogue",
   "jp": "まあいいや\\n本題に入るよ",
   "en": "",
   "op": "0x62",
   "msg": "0x536e"
  },
  {
   "id": "m_013001:0x195dc",
   "off": 103900,
   "max": 40,
   "kind": "dialogue",
   "jp": "ジュニアが雷舞をやる\\nことが決まった",
   "en": "",
   "op": "0x62",
   "msg": "0x536f"
  },
  {
   "id": "m_013001:0x19c48",
   "off": 105544,
   "max": 40,
   "kind": "dialogue",
   "jp": "雷舞？　今さらだぜ\\nそりゃ　やるだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x5370"
  },
  {
   "id": "m_013001:0x19c80",
   "off": 105600,
   "max": 56,
   "kind": "dialogue",
   "jp": "これまでも各地で\\n好き放題やらかして\\nきたじゃねぇか",
   "en": "",
   "op": "0x62",
   "msg": "0x5371"
  },
  {
   "id": "m_013001:0x19cc8",
   "off": 105672,
   "max": 36,
   "kind": "dialogue",
   "jp": "なにせ\\nロックスター様\\nだからな",
   "en": "",
   "op": "0x62",
   "msg": "0x5372"
  },
  {
   "id": "m_013001:0x1a200",
   "off": 107008,
   "max": 44,
   "kind": "dialogue",
   "jp": "これまでの雷舞とは\\nまるで規模が違うんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5373"
  },
  {
   "id": "m_013001:0x1a23c",
   "off": 107068,
   "max": 92,
   "kind": "dialogue",
   "jp": "富士山の山麓に作られた\\n特設舞台（スペシャル\\nステージ）に日本中の\\n人々を集めるつもりだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5374"
  },
  {
   "id": "m_013001:0x1aa24",
   "off": 109092,
   "max": 36,
   "kind": "dialogue",
   "jp": "特設舞台？\\nあのじゅにあのことじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x5375"
  },
  {
   "id": "m_013001:0x1af5c",
   "off": 110428,
   "max": 36,
   "kind": "dialogue",
   "jp": "さぞかし\\nでっかいんじゃろうなあ",
   "en": "",
   "op": "0x62",
   "msg": "0x5376"
  },
  {
   "id": "m_013001:0x1b93c",
   "off": 112956,
   "max": 60,
   "kind": "dialogue",
   "jp": "その雷舞の計画書や\\n演奏する曲の楽譜を\\n持ち出してきたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5377"
  },
  {
   "id": "m_013001:0x1c184",
   "off": 115076,
   "max": 48,
   "kind": "dialogue",
   "jp": "ちょっと\\nその計画書とやらを\\n見せてください",
   "en": "",
   "op": "0x62",
   "msg": "0x5378"
  },
  {
   "id": "m_013001:0x1c960",
   "off": 117088,
   "max": 16,
   "kind": "dialogue",
   "jp": "はい　どうぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x5379"
  },
  {
   "id": "m_013001:0x1d06c",
   "off": 118892,
   "max": 48,
   "kind": "dialogue",
   "jp": "お　おい\\nまさか盗んできた\\nんじゃなかろうな",
   "en": "",
   "op": "0x62",
   "msg": "0x537a"
  },
  {
   "id": "m_013001:0x1d518",
   "off": 120088,
   "max": 32,
   "kind": "dialogue",
   "jp": "ちょっと\\n拝借しただけですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x537b"
  },
  {
   "id": "m_013001:0x1d548",
   "off": 120136,
   "max": 56,
   "kind": "dialogue",
   "jp": "大量にあった資料の\\nほんの一部ですし\\nバレやしません",
   "en": "",
   "op": "0x62",
   "msg": "0x537c"
  },
  {
   "id": "m_013001:0x1d9fc",
   "off": 121340,
   "max": 44,
   "kind": "dialogue",
   "jp": "バレなければ\\n良いというものでも\\nなかろう",
   "en": "",
   "op": "0x62",
   "msg": "0x537d"
  },
  {
   "id": "m_013001:0x1e050",
   "off": 122960,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x537e"
  },
  {
   "id": "m_013001:0x1e584",
   "off": 124292,
   "max": 16,
   "kind": "dialogue",
   "jp": "む\\nどうした？",
   "en": "",
   "op": "0x62",
   "msg": "0x537f"
  },
  {
   "id": "m_013001:0x1eab0",
   "off": 125616,
   "max": 20,
   "kind": "dialogue",
   "jp": "……あのですねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x5380"
  },
  {
   "id": "m_013001:0x1f488",
   "off": 128136,
   "max": 72,
   "kind": "dialogue",
   "jp": "バレるのバレないのって\\n謎の仮面野郎だけには\\n言われたくないんですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5381"
  },
  {
   "id": "m_013001:0x1fe20",
   "off": 130592,
   "max": 24,
   "kind": "dialogue",
   "jp": "うおっ\\nお　沖田君？",
   "en": "",
   "op": "0x62",
   "msg": "0x5382"
  },
  {
   "id": "m_013001:0x20668",
   "off": 132712,
   "max": 44,
   "kind": "dialogue",
   "jp": "上司である\\n土方さんが\\n失踪している間――",
   "en": "",
   "op": "0x62",
   "msg": "0x5383"
  },
  {
   "id": "m_013001:0x206ac",
   "off": 132780,
   "max": 68,
   "kind": "dialogue",
   "jp": "この資料を持ち出すのに\\n僕がどれだけ苦労したと\\n思ってるんです？",
   "en": "",
   "op": "0x62",
   "msg": "0x5384"
  },
  {
   "id": "m_013001:0x20bc8",
   "off": 134088,
   "max": 20,
   "kind": "dialogue",
   "jp": "\\fnt1ああん？\\fnt0",
   "en": "",
   "op": "0x62",
   "msg": "0x5385"
  },
  {
   "id": "m_013001:0x21330",
   "off": 135984,
   "max": 52,
   "kind": "dialogue",
   "jp": "あ　いや　なにも\\n沖田君の苦労を\\n認めないわけでは",
   "en": "",
   "op": "0x62",
   "msg": "0x5386"
  },
  {
   "id": "m_013001:0x21b10",
   "off": 138000,
   "max": 44,
   "kind": "dialogue",
   "jp": "もちろん\\n土方さんには\\n認めてもらいますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5387"
  },
  {
   "id": "m_013001:0x21b54",
   "off": 138068,
   "max": 60,
   "kind": "dialogue",
   "jp": "かかった経費の\\n領収書も　ぜ～んぶね\\n文句は言わせません",
   "en": "",
   "op": "0x62",
   "msg": "0x5388"
  },
  {
   "id": "m_013001:0x22414",
   "off": 140308,
   "max": 52,
   "kind": "dialogue",
   "jp": "お　沖田君\\nあまり無茶な領収書は\\nどうだろうか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5389"
  },
  {
   "id": "m_013001:0x22460",
   "off": 140384,
   "max": 80,
   "kind": "dialogue",
   "jp": "この間も　脇差の代金だの\\n個人的な飲み食いのツケを\\n経費で落とそうとして――",
   "en": "",
   "op": "0x62",
   "msg": "0x538a"
  },
  {
   "id": "m_013001:0x22e3c",
   "off": 142908,
   "max": 32,
   "kind": "dialogue",
   "jp": "絶対に　文句は\\n言わせません！",
   "en": "",
   "op": "0x62",
   "msg": "0x538b"
  },
  {
   "id": "m_013001:0x237ec",
   "off": 145388,
   "max": 16,
   "kind": "dialogue",
   "jp": "う　うむ……",
   "en": "",
   "op": "0x62",
   "msg": "0x538c"
  },
  {
   "id": "m_013001:0x23f2c",
   "off": 147244,
   "max": 32,
   "kind": "dialogue",
   "jp": "メガネくん\\nその資料はどう？",
   "en": "",
   "op": "0x62",
   "msg": "0x538d"
  },
  {
   "id": "m_013001:0x248f4",
   "off": 149748,
   "max": 32,
   "kind": "dialogue",
   "jp": "これはすごい\\nすごい計画ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x538e"
  },
  {
   "id": "m_013001:0x24930",
   "off": 149808,
   "max": 52,
   "kind": "dialogue",
   "jp": "もし実現すれば\\n空前絶後の規模の\\n雷舞になります",
   "en": "",
   "op": "0x62",
   "msg": "0x538f"
  },
  {
   "id": "m_013001:0x25164",
   "off": 151908,
   "max": 56,
   "kind": "dialogue",
   "jp": "既にジュニアは\\n江戸中の女の子を引き\\n連れて出発したよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5390"
  },
  {
   "id": "m_013001:0x251ac",
   "off": 151980,
   "max": 24,
   "kind": "dialogue",
   "jp": "それを伝えにきたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5391"
  },
  {
   "id": "m_013001:0x25860",
   "off": 153696,
   "max": 44,
   "kind": "dialogue",
   "jp": "この雷舞が行われれば\\n日本の民の心は――",
   "en": "",
   "op": "0x62",
   "msg": "0x5392"
  },
  {
   "id": "m_013001:0x2589c",
   "off": 153756,
   "max": 44,
   "kind": "dialogue",
   "jp": "すべての女性の心が\\nジュニアに傾くだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x5393"
  },
  {
   "id": "m_013001:0x258d8",
   "off": 153816,
   "max": 72,
   "kind": "dialogue",
   "jp": "そうなってしまえば\\nいかに日本が抗おうとも\\n不利な条件での開国は必至",
   "en": "",
   "op": "0x62",
   "msg": "0x5394"
  },
  {
   "id": "m_013001:0x25fb8",
   "off": 155576,
   "max": 28,
   "kind": "dialogue",
   "jp": "……どうする？\\nトサカくん",
   "en": "",
   "op": "0x62",
   "msg": "0x5395"
  },
  {
   "id": "m_013001:0x269f4",
   "off": 158196,
   "max": 44,
   "kind": "dialogue",
   "jp": "もちろん\\n決まっとる！\\nやってやるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5396"
  },
  {
   "id": "m_013001:0x27398",
   "off": 160664,
   "max": 64,
   "kind": "dialogue",
   "jp": "おお　ジュニアの\\n野望を阻止するために\\n立ち上がってくれるか！",
   "en": "",
   "op": "0x62",
   "msg": "0x5397"
  },
  {
   "id": "m_013001:0x27a08",
   "off": 162312,
   "max": 8,
   "kind": "dialogue",
   "jp": "へ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5398"
  },
  {
   "id": "m_013001:0x27fe0",
   "off": 163808,
   "max": 16,
   "kind": "dialogue",
   "jp": "ち　違うのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5399"
  },
  {
   "id": "m_013001:0x28774",
   "off": 165748,
   "max": 40,
   "kind": "dialogue",
   "jp": "わしは　難しい話は\\nようわからんが――",
   "en": "",
   "op": "0x62",
   "msg": "0x539a"
  },
  {
   "id": "m_013001:0x28e1c",
   "off": 167452,
   "max": 52,
   "kind": "dialogue",
   "jp": "要は　日本一の\\nドでかい雷舞っちゅう\\nことじゃろ？",
   "en": "",
   "op": "0x62",
   "msg": "0x539b"
  },
  {
   "id": "m_013001:0x294cc",
   "off": 169164,
   "max": 60,
   "kind": "dialogue",
   "jp": "そりゃあ　志士として\\n参加しないわけには\\nいかないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x539c"
  },
  {
   "id": "m_013001:0x29e10",
   "off": 171536,
   "max": 48,
   "kind": "dialogue",
   "jp": "え？　いや\\n日本をメリケンから\\n護るためでは？",
   "en": "",
   "op": "0x62",
   "msg": "0x539d"
  },
  {
   "id": "m_013001:0x2a568",
   "off": 173416,
   "max": 44,
   "kind": "dialogue",
   "jp": "確かに　条約の話も\\n大事なのかもしれねぇ",
   "en": "",
   "op": "0x62",
   "msg": "0x539e"
  },
  {
   "id": "m_013001:0x2a5a4",
   "off": 173476,
   "max": 56,
   "kind": "dialogue",
   "jp": "だがな　オレ様達は\\n志士（ロックンローラー）\\nなんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x539f"
  },
  {
   "id": "m_013001:0x2ac74",
   "off": 175220,
   "max": 48,
   "kind": "dialogue",
   "jp": "ロックを歌わないのは\\n息をしないのと同じぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x53a0"
  },
  {
   "id": "m_013001:0x2b340",
   "off": 176960,
   "max": 64,
   "kind": "dialogue",
   "jp": "龍馬の言うとおりだ\\nこの数日で　それが\\n痛いほどよく分かった",
   "en": "",
   "op": "0x62",
   "msg": "0x53a1"
  },
  {
   "id": "m_013001:0x2b390",
   "off": 177040,
   "max": 40,
   "kind": "dialogue",
   "jp": "アンタのおかげだ\\n誠仮面　礼を言うぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x53a2"
  },
  {
   "id": "m_013001:0x2ba54",
   "off": 178772,
   "max": 12,
   "kind": "dialogue",
   "jp": "……そうか",
   "en": "",
   "op": "0x62",
   "msg": "0x53a3"
  },
  {
   "id": "m_013001:0x2c240",
   "off": 180800,
   "max": 44,
   "kind": "dialogue",
   "jp": "でかい舞台で\\nクールにかまして\\nやろうぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x53a4"
  },
  {
   "id": "m_013001:0x2c784",
   "off": 182148,
   "max": 56,
   "kind": "dialogue",
   "jp": "なあ　桂さん！\\nって　難しい顔をして\\nどうしたんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x53a5"
  },
  {
   "id": "m_013001:0x2ccd4",
   "off": 183508,
   "max": 52,
   "kind": "dialogue",
   "jp": "え？　ああ\\nちょっと気になる\\nものがありましてね",
   "en": "",
   "op": "0x62",
   "msg": "0x53a6"
  },
  {
   "id": "m_013001:0x2d184",
   "off": 184708,
   "max": 32,
   "kind": "dialogue",
   "jp": "どれだ？\\nオレ様にも見せてくれ",
   "en": "",
   "op": "0x62",
   "msg": "0x53a7"
  },
  {
   "id": "m_013001:0x2dfb4",
   "off": 188340,
   "max": 32,
   "kind": "dialogue",
   "jp": "なんだこりゃ\\nこれ　楽譜か？",
   "en": "",
   "op": "0x62",
   "msg": "0x53a8"
  },
  {
   "id": "m_013001:0x2dfe4",
   "off": 188388,
   "max": 56,
   "kind": "dialogue",
   "jp": "和音（コード）も\\n音程（メロディ）も\\nメチャクチャだぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x53a9"
  },
  {
   "id": "m_013001:0x2e6b4",
   "off": 190132,
   "max": 32,
   "kind": "dialogue",
   "jp": "確かにおかしいよね\\n失敗作かな",
   "en": "",
   "op": "0x62",
   "msg": "0x53aa"
  },
  {
   "id": "m_013001:0x2f098",
   "off": 192664,
   "max": 36,
   "kind": "dialogue",
   "jp": "分かりませんか？\\nこれ　暗号文です",
   "en": "",
   "op": "0x62",
   "msg": "0x53ab"
  },
  {
   "id": "m_013001:0x2f538",
   "off": 193848,
   "max": 56,
   "kind": "dialogue",
   "jp": "暗号っていうと\\n桂さんのマル秘手帳\\nみたいな　アレか？",
   "en": "",
   "op": "0x62",
   "msg": "0x53ac"
  },
  {
   "id": "m_013001:0x2fa88",
   "off": 195208,
   "max": 20,
   "kind": "dialogue",
   "jp": "そうです　そうです",
   "en": "",
   "op": "0x62",
   "msg": "0x53ad"
  },
  {
   "id": "m_013001:0x30018",
   "off": 196632,
   "max": 60,
   "kind": "dialogue",
   "jp": "桂は\\n暗号で記された資料を\\nものすごい速度で\\nめくっていく",
   "en": "",
   "op": "0x62",
   "msg": "0x53ae"
  },
  {
   "id": "m_013001:0x305b0",
   "off": 198064,
   "max": 40,
   "kind": "dialogue",
   "jp": "ふうん……\\nなるほど\\nこれは興味深い",
   "en": "",
   "op": "0x62",
   "msg": "0x53af"
  },
  {
   "id": "m_013001:0x30e10",
   "off": 200208,
   "max": 32,
   "kind": "dialogue",
   "jp": "メガネくん\\nそれ　読めるの",
   "en": "",
   "op": "0x62",
   "msg": "0x53b0"
  },
  {
   "id": "m_013001:0x31394",
   "off": 201620,
   "max": 20,
   "kind": "dialogue",
   "jp": "まあ　だいたいは",
   "en": "",
   "op": "0x62",
   "msg": "0x53b1"
  },
  {
   "id": "m_013001:0x31b2c",
   "off": 203564,
   "max": 20,
   "kind": "dialogue",
   "jp": "さすがはセンセー！",
   "en": "",
   "op": "0x62",
   "msg": "0x53b2"
  },
  {
   "id": "m_013001:0x321dc",
   "off": 205276,
   "max": 32,
   "kind": "dialogue",
   "jp": "私は判じ物が\\n大好きでしてね",
   "en": "",
   "op": "0x62",
   "msg": "0x53b3"
  },
  {
   "id": "m_013001:0x3220c",
   "off": 205324,
   "max": 28,
   "kind": "dialogue",
   "jp": "こういうのは\\n得意なんです",
   "en": "",
   "op": "0x62",
   "msg": "0x53b4"
  },
  {
   "id": "m_013001:0x326b8",
   "off": 206520,
   "max": 52,
   "kind": "dialogue",
   "jp": "判じ物とは\\n江戸時代に流行した\\n絵文字パズルである",
   "en": "",
   "op": "0x62",
   "msg": "0x53b5"
  },
  {
   "id": "m_013001:0x32c70",
   "off": 207984,
   "max": 56,
   "kind": "dialogue",
   "jp": "判じ物が好きだから\\n読めるということも\\nなかろうが……",
   "en": "",
   "op": "0x62",
   "msg": "0x53b6"
  },
  {
   "id": "m_013001:0x333c8",
   "off": 209864,
   "max": 60,
   "kind": "dialogue",
   "jp": "メリケンの言葉は\\n文字の数が少ないから\\n解読もしやすいです",
   "en": "",
   "op": "0x62",
   "msg": "0x53b7"
  },
  {
   "id": "m_013001:0x33aa8",
   "off": 211624,
   "max": 40,
   "kind": "dialogue",
   "jp": "お　おい　桂さん\\n何が書いてあるんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x53b8"
  },
  {
   "id": "m_013001:0x3416c",
   "off": 213356,
   "max": 36,
   "kind": "dialogue",
   "jp": "……かなり重要な\\n書類のようですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x53b9"
  },
  {
   "id": "m_013001:0x34828",
   "off": 215080,
   "max": 40,
   "kind": "dialogue",
   "jp": "だろうね\\nわざわざ暗号で\\n記すんだから",
   "en": "",
   "op": "0x62",
   "msg": "0x53ba"
  },
  {
   "id": "m_013001:0x34ce0",
   "off": 216288,
   "max": 60,
   "kind": "dialogue",
   "jp": "桂は暗号文の内容を\\n紙に書きつけると\\nそれを沖田に渡した",
   "en": "",
   "op": "0x62",
   "msg": "0x53bb"
  },
  {
   "id": "m_013001:0x35160",
   "off": 217440,
   "max": 48,
   "kind": "dialogue",
   "jp": "この資料は\\n勝先生に届けた方が\\nいいでしょう",
   "en": "",
   "op": "0x62",
   "msg": "0x53bc"
  },
  {
   "id": "m_013001:0x351a0",
   "off": 217504,
   "max": 48,
   "kind": "dialogue",
   "jp": "条約の交渉が\\nかなりやりやすく\\nなるはずです",
   "en": "",
   "op": "0x62",
   "msg": "0x53bd"
  },
  {
   "id": "m_013001:0x3586c",
   "off": 219244,
   "max": 48,
   "kind": "dialogue",
   "jp": "それについては\\n私が責任をもって\\n任されよう",
   "en": "",
   "op": "0x62",
   "msg": "0x53be"
  },
  {
   "id": "m_013001:0x35ef8",
   "off": 220920,
   "max": 44,
   "kind": "dialogue",
   "jp": "えっ\\n誠仮面は　一緒に\\n雷舞へ行かんのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x53bf"
  },
  {
   "id": "m_013001:0x363a8",
   "off": 222120,
   "max": 40,
   "kind": "dialogue",
   "jp": "人には　それぞれ\\n役割というものがある",
   "en": "",
   "op": "0x62",
   "msg": "0x53c0"
  },
  {
   "id": "m_013001:0x363e0",
   "off": 222176,
   "max": 72,
   "kind": "dialogue",
   "jp": "この資料も　君たちが\\n雷舞でジュニアに勝って\\nこそ生かせるというもの",
   "en": "",
   "op": "0x62",
   "msg": "0x53c1"
  },
  {
   "id": "m_013001:0x36438",
   "off": 222264,
   "max": 40,
   "kind": "dialogue",
   "jp": "君たちは一刻も早く\\n富士山へと向かえ",
   "en": "",
   "op": "0x62",
   "msg": "0x53c2"
  },
  {
   "id": "m_013001:0x368dc",
   "off": 223452,
   "max": 28,
   "kind": "dialogue",
   "jp": "それじゃ\\nお別れなんか？",
   "en": "",
   "op": "0x62",
   "msg": "0x53c3"
  },
  {
   "id": "m_013001:0x36e10",
   "off": 224784,
   "max": 64,
   "kind": "dialogue",
   "jp": "短い間ではあったが\\n三人とも特訓の中で\\n思うことがあったはずだ",
   "en": "",
   "op": "0x62",
   "msg": "0x53c4"
  },
  {
   "id": "m_013001:0x36e60",
   "off": 224864,
   "max": 60,
   "kind": "dialogue",
   "jp": "それさえ忘れなければ\\nロックの神は諸君らに\\n微笑むだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x53c5"
  },
  {
   "id": "m_013001:0x36eac",
   "off": 224940,
   "max": 20,
   "kind": "dialogue",
   "jp": "では\\nさらばだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x53c6"
  },
  {
   "id": "m_013001:0x37700",
   "off": 227072,
   "max": 28,
   "kind": "dialogue",
   "jp": "あっ！\\n行ってしまったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x53c7"
  },
  {
   "id": "m_013001:0x37c30",
   "off": 228400,
   "max": 60,
   "kind": "dialogue",
   "jp": "いったい\\n誰じゃったんじゃろう\\nまっこと熱い男だったぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x53c8"
  },
  {
   "id": "m_013001:0x3849c",
   "off": 230556,
   "max": 24,
   "kind": "dialogue",
   "jp": "ありがとう！\\n誠仮面",
   "en": "",
   "op": "0x62",
   "msg": "0x53c9"
  },
  {
   "id": "m_013001:0x38c74",
   "off": 232564,
   "max": 56,
   "kind": "dialogue",
   "jp": "なあ沖田よ\\n土方のあれなんだが\\nどっちが本性なんだ？",
   "en": "",
   "op": "0x62",
   "msg": "0x53ca"
  },
  {
   "id": "m_013001:0x39344",
   "off": 234308,
   "max": 48,
   "kind": "dialogue",
   "jp": "うーん　不器用なだけで\\nどっちも土方さんかな",
   "en": "",
   "op": "0x62",
   "msg": "0x53cb"
  },
  {
   "id": "m_013001:0x399c0",
   "off": 235968,
   "max": 20,
   "kind": "dialogue",
   "jp": "不器用ですか……",
   "en": "",
   "op": "0x62",
   "msg": "0x53cc"
  },
  {
   "id": "m_013001:0x39d68",
   "off": 236904,
   "max": 16,
   "kind": "choice",
   "jp": "ピンと来ない",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_013001:0x39d84",
   "off": 236932,
   "max": 16,
   "kind": "choice",
   "jp": "納得しました",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_013001:0x39da0",
   "off": 236960,
   "max": 12,
   "kind": "choice",
   "jp": "変ですよ",
   "en": "",
   "op": "0x51"
  },
  {
   "id": "m_013001:0x3a6e4",
   "off": 239332,
   "max": 64,
   "kind": "dialogue",
   "jp": "ピンと来ませんね……\\n一人二役だなんて\\n器用だと思いますけど",
   "en": "",
   "op": "0x62",
   "msg": "0x53cd"
  },
  {
   "id": "m_013001:0x3aba0",
   "off": 240544,
   "max": 72,
   "kind": "dialogue",
   "jp": "器用な人なら仮面なんて\\n被らないで　素顔でうまく\\n立ち回ると思わない？",
   "en": "",
   "op": "0x62",
   "msg": "0x53ce"
  },
  {
   "id": "m_013001:0x3b100",
   "off": 241920,
   "max": 52,
   "kind": "dialogue",
   "jp": "あー　なるほど\\nそういう意味での\\n不器用なんですね",
   "en": "",
   "op": "0x62",
   "msg": "0x53cf"
  },
  {
   "id": "m_013001:0x3b648",
   "off": 243272,
   "max": 48,
   "kind": "dialogue",
   "jp": "土方さんって　そういう\\nところが面白いんだよね",
   "en": "",
   "op": "0x62",
   "msg": "0x53d0"
  },
  {
   "id": "m_013001:0x3bb98",
   "off": 244632,
   "max": 24,
   "kind": "dialogue",
   "jp": "面白いって言いますか",
   "en": "",
   "op": "0x62",
   "msg": "0x53d1"
  },
  {
   "id": "m_013001:0x3c860",
   "off": 247904,
   "max": 28,
   "kind": "dialogue",
   "jp": "なるほど！\\n納得しました",
   "en": "",
   "op": "0x62",
   "msg": "0x53d2"
  },
  {
   "id": "m_013001:0x3ccf8",
   "off": 249080,
   "max": 28,
   "kind": "dialogue",
   "jp": "オレ様には\\nピンとこねえな",
   "en": "",
   "op": "0x62",
   "msg": "0x53d3"
  },
  {
   "id": "m_013001:0x3d22c",
   "off": 250412,
   "max": 48,
   "kind": "dialogue",
   "jp": "そういう不器用な人なら\\n私の身近にもいますから",
   "en": "",
   "op": "0x62",
   "msg": "0x53d4"
  },
  {
   "id": "m_013001:0x3d8f4",
   "off": 252148,
   "max": 36,
   "kind": "dialogue",
   "jp": "ふふふ　似た者同士って\\n感じだよね",
   "en": "",
   "op": "0x62",
   "msg": "0x53d5"
  },
  {
   "id": "m_013001:0x3dd94",
   "off": 253332,
   "max": 44,
   "kind": "dialogue",
   "jp": "そうですねえ\\nお互い苦労しますね\\n沖田くん",
   "en": "",
   "op": "0x62",
   "msg": "0x53d6"
  },
  {
   "id": "m_013001:0x3e23c",
   "off": 254524,
   "max": 40,
   "kind": "dialogue",
   "jp": "面白いから苦労って\\n感じはしないけど",
   "en": "",
   "op": "0x62",
   "msg": "0x53d7"
  },
  {
   "id": "m_013001:0x3ef10",
   "off": 257808,
   "max": 60,
   "kind": "dialogue",
   "jp": "変ですよ\\n不器用なら不器用なりに\\n接してくれればいいのに",
   "en": "",
   "op": "0x62",
   "msg": "0x53d8"
  },
  {
   "id": "m_013001:0x3f3c8",
   "off": 259016,
   "max": 68,
   "kind": "dialogue",
   "jp": "それができない不器用さん\\nだから　変装しようと\\n思い至ったんでしょ",
   "en": "",
   "op": "0x62",
   "msg": "0x53d9"
  },
  {
   "id": "m_013001:0x3f924",
   "off": 260388,
   "max": 56,
   "kind": "dialogue",
   "jp": "なるほど……素顔では\\nうまくできないって\\nことですか",
   "en": "",
   "op": "0x62",
   "msg": "0x53da"
  },
  {
   "id": "m_013001:0x3fdd8",
   "off": 261592,
   "max": 64,
   "kind": "dialogue",
   "jp": "それもそうだし\\nバレてないって思いこむ\\nところも不器用だよね",
   "en": "",
   "op": "0x62",
   "msg": "0x53db"
  },
  {
   "id": "m_013001:0x40330",
   "off": 262960,
   "max": 72,
   "kind": "dialogue",
   "jp": "お人好しで不器用ですか\\n私の身近にも一人いるので\\nなんとなくわかります",
   "en": "",
   "op": "0x62",
   "msg": "0x53dc"
  },
  {
   "id": "m_013001:0x40b10",
   "off": 264976,
   "max": 52,
   "kind": "dialogue",
   "jp": "なんだよ　それ\\n答えになってんのか\\n全然わからねえ",
   "en": "",
   "op": "0x62",
   "msg": "0x53dd"
  },
  {
   "id": "m_013001:0x41320",
   "off": 267040,
   "max": 56,
   "kind": "dialogue",
   "jp": "スカシくんも\\n仮面を被ってみたら？\\n素直になれるかもよ",
   "en": "",
   "op": "0x62",
   "msg": "0x53de"
  },
  {
   "id": "m_013001:0x41870",
   "off": 268400,
   "max": 44,
   "kind": "dialogue",
   "jp": "あはは　それは私も\\n同じことを思ってました",
   "en": "",
   "op": "0x62",
   "msg": "0x53df"
  },
  {
   "id": "m_013001:0x4202c",
   "off": 270380,
   "max": 28,
   "kind": "dialogue",
   "jp": "うるせえよ\\n余計なお世話だ",
   "en": "",
   "op": "0x62",
   "msg": "0x53e0"
  },
  {
   "id": "m_013001:0x426f0",
   "off": 272112,
   "max": 20,
   "kind": "dialogue",
   "jp": "それにしても……",
   "en": "",
   "op": "0x62",
   "msg": "0x53e1"
  },
  {
   "id": "m_013001:0x42c1c",
   "off": 273436,
   "max": 64,
   "kind": "dialogue",
   "jp": "このところ　ずっと\\n張り詰めていた緊張が\\n程良く解けましたね",
   "en": "",
   "op": "0x62",
   "msg": "0x53e2"
  },
  {
   "id": "m_013001:0x432f8",
   "off": 275192,
   "max": 12,
   "kind": "dialogue",
   "jp": "……まあな",
   "en": "",
   "op": "0x62",
   "msg": "0x53e3"
  },
  {
   "id": "m_013001:0x439a0",
   "off": 276896,
   "max": 24,
   "kind": "dialogue",
   "jp": "誠仮面のおかげですね",
   "en": "",
   "op": "0x62",
   "msg": "0x53e4"
  },
  {
   "id": "m_013001:0x44050",
   "off": 278608,
   "max": 48,
   "kind": "dialogue",
   "jp": "そうじゃな\\nメシもうまいし\\n気分は最高ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x53e5"
  },
  {
   "id": "m_013001:0x4485c",
   "off": 280668,
   "max": 60,
   "kind": "dialogue",
   "jp": "さて　土方さんと\\n合流したら　僕らも\\n君たちを追いかけるよ",
   "en": "",
   "op": "0x62",
   "msg": "0x53e6"
  },
  {
   "id": "m_013001:0x44d14",
   "off": 281876,
   "max": 40,
   "kind": "dialogue",
   "jp": "こっちの楽譜は\\n私がもらっておきます",
   "en": "",
   "op": "0x62",
   "msg": "0x53e7"
  },
  {
   "id": "m_013001:0x44d4c",
   "off": 281932,
   "max": 56,
   "kind": "dialogue",
   "jp": "これは\\n私たちの手にあってこそ\\n役に立つものですから",
   "en": "",
   "op": "0x62",
   "msg": "0x53e8"
  },
  {
   "id": "m_013001:0x45508",
   "off": 283912,
   "max": 32,
   "kind": "dialogue",
   "jp": "ところでさ\\n新曲って何の話？",
   "en": "",
   "op": "0x62",
   "msg": "0x53e9"
  },
  {
   "id": "m_013001:0x45cd8",
   "off": 285912,
   "max": 44,
   "kind": "dialogue",
   "jp": "これです\\n誠仮面による\\n特訓の成果ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x53ea"
  },
  {
   "id": "m_013001:0x46244",
   "off": 287300,
   "max": 56,
   "kind": "dialogue",
   "jp": "桂から手渡された\\n新曲の楽譜に目を通した\\n沖田は――",
   "en": "",
   "op": "0x62",
   "msg": "0x53eb"
  },
  {
   "id": "m_013001:0x46828",
   "off": 288808,
   "max": 12,
   "kind": "dialogue",
   "jp": "……いいね",
   "en": "",
   "op": "0x62",
   "msg": "0x53ec"
  },
  {
   "id": "m_013001:0x46f50",
   "off": 290640,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうじゃろう\\nそうじゃろう",
   "en": "",
   "op": "0x62",
   "msg": "0x53ed"
  },
  {
   "id": "m_013001:0x47608",
   "off": 292360,
   "max": 20,
   "kind": "dialogue",
   "jp": "クールな出来だぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x53ee"
  },
  {
   "id": "m_013001:0x47cb4",
   "off": 294068,
   "max": 44,
   "kind": "dialogue",
   "jp": "ジュニアと戦うのが\\n楽しみになってきたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x53ef"
  },
  {
   "id": "m_013001:0x485f4",
   "off": 296436,
   "max": 16,
   "kind": "dialogue",
   "jp": "よっしゃあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x53f0"
  },
  {
   "id": "m_013001:0x48614",
   "off": 296468,
   "max": 52,
   "kind": "dialogue",
   "jp": "そうと決まれば\\nさっそく富士山に向けて\\n出発じゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x53f1"
  },
  {
   "id": "m_013001:0x48ac4",
   "off": 297668,
   "max": 60,
   "kind": "dialogue",
   "jp": "わしらのロックを\\nじゅにあに　そして\\nみんなに届けるぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x53f2"
  },
  {
   "id": "m_013001:0x4908c",
   "off": 299148,
   "max": 76,
   "kind": "dialogue",
   "jp": "こうして龍馬達は\\n富士山麓で行われる\\n特設舞台に向けて\\n旅立ったのだった",
   "en": "",
   "op": "0x62",
   "msg": "0x53f3"
  }
 ]
}
