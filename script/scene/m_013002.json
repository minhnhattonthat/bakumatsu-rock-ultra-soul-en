{
 "source": "m_013002.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_013002:0x12f0",
   "off": 4848,
   "max": 48,
   "kind": "dialogue",
   "jp": "オッケー　いいね\\nオレの鼓動が\\nイキっぱなしだ",
   "en": "",
   "op": "0x62",
   "msg": "0x53f4"
  },
  {
   "id": "m_013002:0x1834",
   "off": 6196,
   "max": 56,
   "kind": "dialogue",
   "jp": "今日　この雷舞で\\nレディたちのハートを\\n奪ってあげよう",
   "en": "",
   "op": "0x62",
   "msg": "0x53f5"
  },
  {
   "id": "m_013002:0x187c",
   "off": 6268,
   "max": 56,
   "kind": "dialogue",
   "jp": "アーユーレディ？\\n曲が始まれば\\nもう後戻りはできない",
   "en": "",
   "op": "0x62",
   "msg": "0x53f6"
  },
  {
   "id": "m_013002:0x18c4",
   "off": 6340,
   "max": 48,
   "kind": "dialogue",
   "jp": "このオレに\\n全てを捧げる覚悟は\\nできているか？",
   "en": "",
   "op": "0x62",
   "msg": "0x53f7"
  },
  {
   "id": "m_013002:0x1f2c",
   "off": 7980,
   "max": 72,
   "kind": "dialogue",
   "jp": "オレは　今日ここで\\nレディたちに会うために\\n生まれてきた気がする……",
   "en": "",
   "op": "0x62",
   "msg": "0x53f8"
  },
  {
   "id": "m_013002:0x1f84",
   "off": 8068,
   "max": 24,
   "kind": "dialogue",
   "jp": "オッケー　Ｊ\\n始めよう",
   "en": "",
   "op": "0x62",
   "msg": "0x53f9"
  },
  {
   "id": "m_013002:0x2870",
   "off": 10352,
   "max": 44,
   "kind": "dialogue",
   "jp": "その雷舞\\n始めるのは待って\\nもらうぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x53fa"
  },
  {
   "id": "m_013002:0x30c4",
   "off": 12484,
   "max": 68,
   "kind": "dialogue",
   "jp": "せっかくの雷舞じゃ！\\n日本代表の志士として\\n参加させてもらうぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x53fb"
  },
  {
   "id": "m_013002:0x3118",
   "off": 12568,
   "max": 24,
   "kind": "dialogue",
   "jp": "みんなも構わんよな",
   "en": "",
   "op": "0x62",
   "msg": "0x53fc"
  },
  {
   "id": "m_013002:0x3a78",
   "off": 14968,
   "max": 64,
   "kind": "dialogue",
   "jp": "おい　坂本龍馬だぜ\\nよくもジュニアの前に\\n顔を出せたもんだな",
   "en": "",
   "op": "0x62",
   "msg": "0x53fd"
  },
  {
   "id": "m_013002:0x3f34",
   "off": 16180,
   "max": 56,
   "kind": "dialogue",
   "jp": "ジュニア様の雷舞の\\n邪魔をするなんて\\n信じらんない",
   "en": "",
   "op": "0x62",
   "msg": "0x53fe"
  },
  {
   "id": "m_013002:0x4834",
   "off": 18484,
   "max": 68,
   "kind": "dialogue",
   "jp": "ひっこめー！\\nあたしたちとジュニア様の\\n神聖な舞台を汚さないで！",
   "en": "",
   "op": "0x62",
   "msg": "0x53ff"
  },
  {
   "id": "m_013002:0x4cf4",
   "off": 19700,
   "max": 40,
   "kind": "dialogue",
   "jp": "お呼びじゃないんだよ！\\n帰れ　帰れ",
   "en": "",
   "op": "0x62",
   "msg": "0x5400"
  },
  {
   "id": "m_013002:0x56b0",
   "off": 22192,
   "max": 40,
   "kind": "dialogue",
   "jp": "こりゃまた　えらく\\n嫌われたもんじゃな",
   "en": "",
   "op": "0x62",
   "msg": "0x5401"
  },
  {
   "id": "m_013002:0x5df8",
   "off": 24056,
   "max": 24,
   "kind": "dialogue",
   "jp": "それも\\n今の内だけです",
   "en": "",
   "op": "0x62",
   "msg": "0x5402"
  },
  {
   "id": "m_013002:0x64ac",
   "off": 25772,
   "max": 44,
   "kind": "dialogue",
   "jp": "オレ様たちは志士だ\\n音楽で黙らせてやろうぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x5403"
  },
  {
   "id": "m_013002:0x6b70",
   "off": 27504,
   "max": 36,
   "kind": "dialogue",
   "jp": "おう！　シンディの\\n言う通りじゃ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5404"
  },
  {
   "id": "m_013002:0x7368",
   "off": 29544,
   "max": 36,
   "kind": "dialogue",
   "jp": "龍ちゃん　晋ちゃん！\\n五郎ちゃん！",
   "en": "",
   "op": "0x62",
   "msg": "0x5405"
  },
  {
   "id": "m_013002:0x7808",
   "off": 30728,
   "max": 40,
   "kind": "dialogue",
   "jp": "なんだ\\nお登勢さんも\\n来てたのかよ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5406"
  },
  {
   "id": "m_013002:0x7cb4",
   "off": 31924,
   "max": 28,
   "kind": "dialogue",
   "jp": "あら\\nなんだはないでしょ",
   "en": "",
   "op": "0x62",
   "msg": "0x5407"
  },
  {
   "id": "m_013002:0x8368",
   "off": 33640,
   "max": 40,
   "kind": "dialogue",
   "jp": "おう　お登勢やん\\nお龍　おうの　幾松も",
   "en": "",
   "op": "0x62",
   "msg": "0x5408"
  },
  {
   "id": "m_013002:0x83a0",
   "off": 33696,
   "max": 32,
   "kind": "dialogue",
   "jp": "みんな揃って\\nじゅにあの雷舞か",
   "en": "",
   "op": "0x62",
   "msg": "0x5409"
  },
  {
   "id": "m_013002:0x8898",
   "off": 34968,
   "max": 56,
   "kind": "dialogue",
   "jp": "うう　龍ちゃんに\\n言れると　さすがに\\nココロが痛むわぁ",
   "en": "",
   "op": "0x62",
   "msg": "0x540a"
  },
  {
   "id": "m_013002:0x8f78",
   "off": 36728,
   "max": 56,
   "kind": "dialogue",
   "jp": "今日は日本中から\\n贔屓が集ってるんだ\\nしょうがないだろ",
   "en": "",
   "op": "0x62",
   "msg": "0x540b"
  },
  {
   "id": "m_013002:0x9654",
   "off": 38484,
   "max": 52,
   "kind": "dialogue",
   "jp": "ジュニア様の雷舞……\\n一瞬たりとも\\n見逃せない……",
   "en": "",
   "op": "0x62",
   "msg": "0x540c"
  },
  {
   "id": "m_013002:0x9d28",
   "off": 40232,
   "max": 20,
   "kind": "dialogue",
   "jp": "ぁたしもですぅ！",
   "en": "",
   "op": "0x62",
   "msg": "0x540d"
  },
  {
   "id": "m_013002:0xa3c0",
   "off": 41920,
   "max": 24,
   "kind": "dialogue",
   "jp": "これは負けられんぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x540e"
  },
  {
   "id": "m_013002:0xa3e8",
   "off": 41960,
   "max": 72,
   "kind": "dialogue",
   "jp": "今日はわしのロックで\\nみんなの心と　うまい\\nピッツァを取り戻すぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x540f"
  },
  {
   "id": "m_013002:0xac6c",
   "off": 44140,
   "max": 56,
   "kind": "dialogue",
   "jp": "みんな　\\n腰が抜けんように\\n椅子にしがみついておけ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5410"
  },
  {
   "id": "m_013002:0xb3c8",
   "off": 46024,
   "max": 60,
   "kind": "dialogue",
   "jp": "あら？　龍ちゃん\\nちょっと　カッコよく\\nなったんじゃない？",
   "en": "",
   "op": "0x62",
   "msg": "0x5411"
  },
  {
   "id": "m_013002:0xba4c",
   "off": 47692,
   "max": 56,
   "kind": "dialogue",
   "jp": "わははは　そういわれると\\n照れくさいぜよ\\nわはははは！",
   "en": "",
   "op": "0x62",
   "msg": "0x5412"
  },
  {
   "id": "m_013002:0xc350",
   "off": 50000,
   "max": 56,
   "kind": "dialogue",
   "jp": "お登勢さん\\nあんたが誰の贔屓か\\n思い出させてやるからな",
   "en": "",
   "op": "0x62",
   "msg": "0x5413"
  },
  {
   "id": "m_013002:0xc804",
   "off": 51204,
   "max": 60,
   "kind": "dialogue",
   "jp": "行きましょう\\n全身に力がわいてきます\\n膝が勝手に震えますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5414"
  },
  {
   "id": "m_013002:0xd108",
   "off": 53512,
   "max": 52,
   "kind": "dialogue",
   "jp": "武者震いか\\n特訓の……ゴホン\\nいけそうだな　坂本",
   "en": "",
   "op": "0x62",
   "msg": "0x5415"
  },
  {
   "id": "m_013002:0xd658",
   "off": 54872,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x5416"
  },
  {
   "id": "m_013002:0xe064",
   "off": 57444,
   "max": 60,
   "kind": "dialogue",
   "jp": "ああ　わしはやる気満々\\n気合いも充分っ！\\n全開で行くぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5417"
  },
  {
   "id": "m_013002:0xe63c",
   "off": 58940,
   "max": 84,
   "kind": "dialogue",
   "jp": "龍馬達が舞台に躍り出ると\\n期待に胸を膨らませた観客の\\n大歓声が雷舞会場を包み込む",
   "en": "",
   "op": "0x62",
   "msg": "0x5418"
  },
  {
   "id": "m_013002:0xec10",
   "off": 60432,
   "max": 56,
   "kind": "dialogue",
   "jp": "オレに勝負を挑むとは\\nそのグレイトな勇気は\\n認めよう",
   "en": "",
   "op": "0x62",
   "msg": "0x5419"
  },
  {
   "id": "m_013002:0xf0c4",
   "off": 61636,
   "max": 60,
   "kind": "dialogue",
   "jp": "おう　じゅにあ\\n今日のわしらのロックは\\nひと味違うぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x541a"
  },
  {
   "id": "m_013002:0xf57c",
   "off": 62844,
   "max": 56,
   "kind": "dialogue",
   "jp": "上等なビッグマウスだ\\nロックンローラーは\\nそれでいい",
   "en": "",
   "op": "0x62",
   "msg": "0x541b"
  },
  {
   "id": "m_013002:0xf5c4",
   "off": 62916,
   "max": 24,
   "kind": "dialogue",
   "jp": "……で誰だ　お前は？",
   "en": "",
   "op": "0x62",
   "msg": "0x541c"
  },
  {
   "id": "m_013002:0xfc78",
   "off": 64632,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレ様たちのことを\\n覚えてねえのかよ",
   "en": "",
   "op": "0x62",
   "msg": "0x541d"
  },
  {
   "id": "m_013002:0x10338",
   "off": 66360,
   "max": 52,
   "kind": "dialogue",
   "jp": "男の顔と名前は\\n家族とＪ以外\\n覚えないみたいだよ",
   "en": "",
   "op": "0x62",
   "msg": "0x541e"
  },
  {
   "id": "m_013002:0x10888",
   "off": 67720,
   "max": 60,
   "kind": "dialogue",
   "jp": "オウ　マイスイートハニー\\nなぜナデシコは\\nそっちにいる？",
   "en": "",
   "op": "0x62",
   "msg": "0x541f"
  },
  {
   "id": "m_013002:0x10d40",
   "off": 68928,
   "max": 64,
   "kind": "dialogue",
   "jp": "なぜって　僕は元々\\nこっち側の人間だし\\n藁巻き一丁はごめんだし",
   "en": "",
   "op": "0x62",
   "msg": "0x5420"
  },
  {
   "id": "m_013002:0x111fc",
   "off": 70140,
   "max": 44,
   "kind": "dialogue",
   "jp": "ナデシコにワラを？\\n言うわけがないだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x5421"
  },
  {
   "id": "m_013002:0x11850",
   "off": 71760,
   "max": 60,
   "kind": "dialogue",
   "jp": "スケスケシルクのキモノを\\nプレゼントしよう\\nきっと気に入る",
   "en": "",
   "op": "0x62",
   "msg": "0x5422"
  },
  {
   "id": "m_013002:0x11e50",
   "off": 73296,
   "max": 60,
   "kind": "dialogue",
   "jp": "あー親切にしてもらって\\nいまさら言うのは\\n心苦しいんだけど",
   "en": "",
   "op": "0x62",
   "msg": "0x5423"
  },
  {
   "id": "m_013002:0x12408",
   "off": 74760,
   "max": 60,
   "kind": "dialogue",
   "jp": "不思議そうに首を傾げる\\nジュニアに向けて\\n一呼吸おくと――",
   "en": "",
   "op": "0x62",
   "msg": "0x5424"
  },
  {
   "id": "m_013002:0x12c58",
   "off": 76888,
   "max": 16,
   "kind": "dialogue",
   "jp": "僕\\n男だから",
   "en": "",
   "op": "0x62",
   "msg": "0x5425"
  },
  {
   "id": "m_013002:0x13670",
   "off": 79472,
   "max": 52,
   "kind": "dialogue",
   "jp": "ワッツ\\n男？　ナデシコが男？\\n笑えないジョークだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5426"
  },
  {
   "id": "m_013002:0x13b20",
   "off": 80672,
   "max": 36,
   "kind": "dialogue",
   "jp": "本当なんだけど……\\n証拠を見る？",
   "en": "",
   "op": "0x62",
   "msg": "0x5427"
  },
  {
   "id": "m_013002:0x142dc",
   "off": 82652,
   "max": 40,
   "kind": "dialogue",
   "jp": "沖田はジュニアに\\n証拠を見せつけた",
   "en": "",
   "op": "0x62",
   "msg": "0x5428"
  },
  {
   "id": "m_013002:0x14da4",
   "off": 85412,
   "max": 36,
   "kind": "dialogue",
   "jp": "アンビリーバボー！\\nだましたのか！",
   "en": "",
   "op": "0x62",
   "msg": "0x5429"
  },
  {
   "id": "m_013002:0x156a8",
   "off": 87720,
   "max": 44,
   "kind": "dialogue",
   "jp": "あんたが勝手に女だと\\n思い込んだんでしょ",
   "en": "",
   "op": "0x62",
   "msg": "0x542a"
  },
  {
   "id": "m_013002:0x15b58",
   "off": 88920,
   "max": 64,
   "kind": "dialogue",
   "jp": "な　なんてことだ\\nＪは　ナデシコが男だと\\n気付いていたのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x542b"
  },
  {
   "id": "m_013002:0x16428",
   "off": 91176,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x542c"
  },
  {
   "id": "m_013002:0x16b6c",
   "off": 93036,
   "max": 44,
   "kind": "dialogue",
   "jp": "オレはとんでもない\\n過ちを犯していた……",
   "en": "",
   "op": "0x62",
   "msg": "0x542d"
  },
  {
   "id": "m_013002:0x16ba8",
   "off": 93096,
   "max": 44,
   "kind": "dialogue",
   "jp": "手を出さなかったのは\\n不幸中のワザワイか",
   "en": "",
   "op": "0x62",
   "msg": "0x542e"
  },
  {
   "id": "m_013002:0x173b4",
   "off": 95156,
   "max": 40,
   "kind": "dialogue",
   "jp": "日本語が間違ってるが\\nまあ　そうかもな",
   "en": "",
   "op": "0x62",
   "msg": "0x542f"
  },
  {
   "id": "m_013002:0x17858",
   "off": 96344,
   "max": 60,
   "kind": "dialogue",
   "jp": "かなり効いてますね\\nジュニアはすっかり\\n落ち込んでますよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5430"
  },
  {
   "id": "m_013002:0x183a4",
   "off": 99236,
   "max": 68,
   "kind": "dialogue",
   "jp": "うふふ　ジュニアの\\n出鼻をくじくために\\nここまで我慢してきたんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5431"
  },
  {
   "id": "m_013002:0x183f8",
   "off": 99320,
   "max": 36,
   "kind": "dialogue",
   "jp": "落ち込んでもらわなくちゃ\\n困るよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5432"
  },
  {
   "id": "m_013002:0x18c7c",
   "off": 101500,
   "max": 64,
   "kind": "dialogue",
   "jp": "沖田は綺麗な顔して\\n相変わらずどす黒いな\\nジュニアに同情するぜ",
   "en": "",
   "op": "0x62",
   "msg": "0x5433"
  },
  {
   "id": "m_013002:0x19578",
   "off": 103800,
   "max": 12,
   "kind": "dialogue",
   "jp": "いいだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x5434"
  },
  {
   "id": "m_013002:0x19a08",
   "off": 104968,
   "max": 52,
   "kind": "dialogue",
   "jp": "神をだました\\n報いは受けてもらうぞ\\nかかってこい",
   "en": "",
   "op": "0x62",
   "msg": "0x5435"
  },
  {
   "id": "m_013002:0x1a5ec",
   "off": 108012,
   "max": 56,
   "kind": "dialogue",
   "jp": "いきますよ！\\n精一杯のロックを\\nいえ　最高のロックを！",
   "en": "",
   "op": "0x62",
   "msg": "0x5436"
  },
  {
   "id": "m_013002:0x1acc0",
   "off": 109760,
   "max": 16,
   "kind": "dialogue",
   "jp": "おう\\n行くぜ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5437"
  },
  {
   "id": "m_013002:0x1b368",
   "off": 111464,
   "max": 60,
   "kind": "dialogue",
   "jp": "聴け　じゅにあ！\\nわしの熱く滾る魂の\\nロックを受け止めろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5438"
  }
 ]
}
