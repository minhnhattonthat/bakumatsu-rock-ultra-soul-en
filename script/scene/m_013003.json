{
 "source": "m_013003.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_013003:0x10f0",
   "off": 4336,
   "max": 80,
   "kind": "dialogue",
   "jp": "龍馬達のロックは\\n互いの超魂を震わせ\\n大きな波となって\\nジュニアを揺さぶった",
   "en": "",
   "op": "0x62",
   "msg": "0x5439"
  },
  {
   "id": "m_013003:0x1580",
   "off": 5504,
   "max": 52,
   "kind": "dialogue",
   "jp": "ほう……\\n少しはオレを感じさせる\\nようになったか",
   "en": "",
   "op": "0x62",
   "msg": "0x543a"
  },
  {
   "id": "m_013003:0x1d58",
   "off": 7512,
   "max": 12,
   "kind": "dialogue",
   "jp": "…………",
   "en": "",
   "op": "0x62",
   "msg": "0x543b"
  },
  {
   "id": "m_013003:0x2620",
   "off": 9760,
   "max": 72,
   "kind": "dialogue",
   "jp": "モンキーの……いや\\nレッドボーイのロックから\\n力強いグルーヴを感じる",
   "en": "",
   "op": "0x62",
   "msg": "0x543c"
  },
  {
   "id": "m_013003:0x2d8c",
   "off": 11660,
   "max": 32,
   "kind": "dialogue",
   "jp": "れっどぼーい？\\nわしのことか？",
   "en": "",
   "op": "0x62",
   "msg": "0x543d"
  },
  {
   "id": "m_013003:0x33ec",
   "off": 13292,
   "max": 8,
   "kind": "dialogue",
   "jp": "そうだ",
   "en": "",
   "op": "0x62",
   "msg": "0x543e"
  },
  {
   "id": "m_013003:0x3910",
   "off": 14608,
   "max": 56,
   "kind": "dialogue",
   "jp": "おう　じゅにあ\\nわしらのことを\\n思い出したようじゃの",
   "en": "",
   "op": "0x62",
   "msg": "0x543f"
  },
  {
   "id": "m_013003:0x3dc4",
   "off": 15812,
   "max": 44,
   "kind": "dialogue",
   "jp": "レッドボーイ\\n誰かの超魂を\\n奪ったのか？",
   "en": "",
   "op": "0x62",
   "msg": "0x5440"
  },
  {
   "id": "m_013003:0x426c",
   "off": 17004,
   "max": 24,
   "kind": "dialogue",
   "jp": "わはは\\nそれはないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5441"
  },
  {
   "id": "m_013003:0x4798",
   "off": 18328,
   "max": 60,
   "kind": "dialogue",
   "jp": "誰かから超魂を奪う\\n方法なんて知らんし\\n奪うつもりもない",
   "en": "",
   "op": "0x62",
   "msg": "0x5442"
  },
  {
   "id": "m_013003:0x50dc",
   "off": 20700,
   "max": 28,
   "kind": "dialogue",
   "jp": "ごまかすな\\nレッドボーイ",
   "en": "",
   "op": "0x62",
   "msg": "0x5443"
  },
  {
   "id": "m_013003:0x5108",
   "off": 20744,
   "max": 44,
   "kind": "dialogue",
   "jp": "こんな短い期間での\\nレベルアップは不可能だ",
   "en": "",
   "op": "0x62",
   "msg": "0x5444"
  },
  {
   "id": "m_013003:0x5968",
   "off": 22888,
   "max": 36,
   "kind": "dialogue",
   "jp": "無理かどうかは\\n誰が決めるんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5445"
  },
  {
   "id": "m_013003:0x5e80",
   "off": 24192,
   "max": 72,
   "kind": "dialogue",
   "jp": "わしらは無理と決め付けず\\nみんなで心をひとつにして\\n魂を震わせたぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5446"
  },
  {
   "id": "m_013003:0x6560",
   "off": 25952,
   "max": 52,
   "kind": "dialogue",
   "jp": "ワッツ？\\nココロをひとつに？\\nそれはサムライの魂か",
   "en": "",
   "op": "0x62",
   "msg": "0x5447"
  },
  {
   "id": "m_013003:0x6bd8",
   "off": 27608,
   "max": 56,
   "kind": "dialogue",
   "jp": "いいえ　ジュニア\\n私たちの力の源は\\n心の共鳴効果ですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5448"
  },
  {
   "id": "m_013003:0x708c",
   "off": 28812,
   "max": 44,
   "kind": "dialogue",
   "jp": "共鳴効果？\\nハウリング……か\\nナンセンスだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5449"
  },
  {
   "id": "m_013003:0x70c8",
   "off": 28872,
   "max": 36,
   "kind": "dialogue",
   "jp": "ココロに形はない\\n共鳴もしない！",
   "en": "",
   "op": "0x62",
   "msg": "0x544a"
  },
  {
   "id": "m_013003:0x7784",
   "off": 30596,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうかなあ\\nじゃあなぜジュニアは\\n僕達の歌に感動したのさ",
   "en": "",
   "op": "0x62",
   "msg": "0x544b"
  },
  {
   "id": "m_013003:0x80b8",
   "off": 32952,
   "max": 24,
   "kind": "dialogue",
   "jp": "……感動？\\nオレが？",
   "en": "",
   "op": "0x62",
   "msg": "0x544c"
  },
  {
   "id": "m_013003:0x87f0",
   "off": 34800,
   "max": 36,
   "kind": "dialogue",
   "jp": "聞いて下さい\\nジュニア\\nそれにＪも",
   "en": "",
   "op": "0x62",
   "msg": "0x544d"
  },
  {
   "id": "m_013003:0x8824",
   "off": 34852,
   "max": 64,
   "kind": "dialogue",
   "jp": "私達にこの新しい力を\\n与えてくれたのは\\nジュニア　あなたですよ",
   "en": "",
   "op": "0x62",
   "msg": "0x544e"
  },
  {
   "id": "m_013003:0x8efc",
   "off": 36604,
   "max": 60,
   "kind": "dialogue",
   "jp": "そうじゃ！\\n世界のロックをわしらに\\n聴かせてくれたからぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x544f"
  },
  {
   "id": "m_013003:0x8f48",
   "off": 36680,
   "max": 64,
   "kind": "dialogue",
   "jp": "じゅにあのロックを聴くまで\\nわしらは自分自身に\\n満足をしていた",
   "en": "",
   "op": "0x62",
   "msg": "0x5450"
  },
  {
   "id": "m_013003:0x949c",
   "off": 38044,
   "max": 52,
   "kind": "dialogue",
   "jp": "じゃが　じゅにあの\\nロックを聴いて\\n打ちのめされた",
   "en": "",
   "op": "0x62",
   "msg": "0x5451"
  },
  {
   "id": "m_013003:0x94e8",
   "off": 38120,
   "max": 40,
   "kind": "dialogue",
   "jp": "魂が震えた\\n素晴らしいロックじゃった",
   "en": "",
   "op": "0x62",
   "msg": "0x5452"
  },
  {
   "id": "m_013003:0x9bb0",
   "off": 39856,
   "max": 56,
   "kind": "dialogue",
   "jp": "当たり前だ\\nオレのロックは世界一\\nこれは世界の常識だ",
   "en": "",
   "op": "0x62",
   "msg": "0x5453"
  },
  {
   "id": "m_013003:0xa228",
   "off": 41512,
   "max": 36,
   "kind": "dialogue",
   "jp": "世界一になって\\nどうしたいんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x5454"
  },
  {
   "id": "m_013003:0xa25c",
   "off": 41564,
   "max": 40,
   "kind": "dialogue",
   "jp": "世界一なんて言葉に\\nどんな意味がある？",
   "en": "",
   "op": "0x62",
   "msg": "0x5455"
  },
  {
   "id": "m_013003:0xab7c",
   "off": 43900,
   "max": 68,
   "kind": "dialogue",
   "jp": "わしは　ただ世界中の\\n人に　わしのロックを\\n聴いてもらいたいぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5456"
  },
  {
   "id": "m_013003:0xb2e4",
   "off": 45796,
   "max": 56,
   "kind": "dialogue",
   "jp": "オレと同じだろう\\nロックで世界を\\n征服するつもりなら",
   "en": "",
   "op": "0x62",
   "msg": "0x5457"
  },
  {
   "id": "m_013003:0xbb30",
   "off": 47920,
   "max": 64,
   "kind": "dialogue",
   "jp": "違う　わしのロックで\\nみんなに楽しい気持ちに\\nなって欲しい！",
   "en": "",
   "op": "0x62",
   "msg": "0x5458"
  },
  {
   "id": "m_013003:0xbb80",
   "off": 48000,
   "max": 24,
   "kind": "dialogue",
   "jp": "そう思ってるだけぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5459"
  },
  {
   "id": "m_013003:0xc3f4",
   "off": 50164,
   "max": 32,
   "kind": "dialogue",
   "jp": "レッドボーイの真意は\\nそれか",
   "en": "",
   "op": "0x62",
   "msg": "0x545a"
  },
  {
   "id": "m_013003:0xc424",
   "off": 50212,
   "max": 44,
   "kind": "dialogue",
   "jp": "ロックでニッポンを\\n征服するつもりだな？",
   "en": "",
   "op": "0x62",
   "msg": "0x545b"
  },
  {
   "id": "m_013003:0xc96c",
   "off": 51564,
   "max": 56,
   "kind": "dialogue",
   "jp": "違う！　\\nみんなにわしのロックを\\n熱情を　気持ちを――",
   "en": "",
   "op": "0x62",
   "msg": "0x545c"
  },
  {
   "id": "m_013003:0xc9b4",
   "off": 51636,
   "max": 40,
   "kind": "dialogue",
   "jp": "ただ届けたい\\n歌いたい\\nそれだけぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x545d"
  },
  {
   "id": "m_013003:0xcef0",
   "off": 52976,
   "max": 76,
   "kind": "dialogue",
   "jp": "そんな気持ちになれたんは\\nじゅにあとＪのおかげじゃ\\n本当に感謝してるぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x545e"
  },
  {
   "id": "m_013003:0xd528",
   "off": 54568,
   "max": 24,
   "kind": "dialogue",
   "jp": "……感謝か\\nいいだろう",
   "en": "",
   "op": "0x62",
   "msg": "0x545f"
  },
  {
   "id": "m_013003:0xd564",
   "off": 54628,
   "max": 72,
   "kind": "dialogue",
   "jp": "認めよう　レッドボーイ\\nお前たちが　この国最高の\\nロックンローラーだと",
   "en": "",
   "op": "0x62",
   "msg": "0x5460"
  },
  {
   "id": "m_013003:0xd5c4",
   "off": 54724,
   "max": 40,
   "kind": "dialogue",
   "jp": "だがオレは世界一\\n最高のロックスター",
   "en": "",
   "op": "0x62",
   "msg": "0x5461"
  },
  {
   "id": "m_013003:0xe170",
   "off": 57712,
   "max": 64,
   "kind": "dialogue",
   "jp": "そこまで言うなら\\nオレを楽しませることが\\nできるんだろうな？",
   "en": "",
   "op": "0x62",
   "msg": "0x5462"
  },
  {
   "id": "m_013003:0xe64c",
   "off": 58956,
   "max": 32,
   "kind": "dialogue",
   "jp": "ロックの神である\\nこのオレを",
   "en": "",
   "op": "0x62",
   "msg": "0x5463"
  },
  {
   "id": "m_013003:0xf05c",
   "off": 61532,
   "max": 20,
   "kind": "dialogue",
   "jp": "ああ\\nもちろんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x5464"
  },
  {
   "id": "m_013003:0xf58c",
   "off": 62860,
   "max": 48,
   "kind": "dialogue",
   "jp": "もっともっと\\n楽しむぜよ！\\nこの最高の舞台を！",
   "en": "",
   "op": "0x62",
   "msg": "0x5465"
  },
  {
   "id": "m_013003:0xfa40",
   "off": 64064,
   "max": 28,
   "kind": "dialogue",
   "jp": "そうとも\\nレッドボーイ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5466"
  },
  {
   "id": "m_013003:0x101e4",
   "off": 66020,
   "max": 32,
   "kind": "dialogue",
   "jp": "私たちは志士\\n転がり続ける石",
   "en": "",
   "op": "0x62",
   "msg": "0x5467"
  },
  {
   "id": "m_013003:0x1021c",
   "off": 66076,
   "max": 64,
   "kind": "dialogue",
   "jp": "龍馬くん　ほんの少し\\n離れていた間に\\n驚くほど成長しましたね",
   "en": "",
   "op": "0x62",
   "msg": "0x5468"
  },
  {
   "id": "m_013003:0x108fc",
   "off": 67836,
   "max": 20,
   "kind": "dialogue",
   "jp": "なんか照れるのぉ",
   "en": "",
   "op": "0x62",
   "msg": "0x5469"
  },
  {
   "id": "m_013003:0x10fac",
   "off": 69548,
   "max": 32,
   "kind": "dialogue",
   "jp": "身近すぎると\\n気付かないもんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x546a"
  },
  {
   "id": "m_013003:0x10fdc",
   "off": 69596,
   "max": 52,
   "kind": "dialogue",
   "jp": "桂さんの考え\\nオレ様の天才ぶり\\n龍馬のバカさ加減",
   "en": "",
   "op": "0x62",
   "msg": "0x546b"
  },
  {
   "id": "m_013003:0x11020",
   "off": 69664,
   "max": 28,
   "kind": "dialogue",
   "jp": "沖田の努力\\n土方の想い……",
   "en": "",
   "op": "0x62",
   "msg": "0x546c"
  },
  {
   "id": "m_013003:0x1104c",
   "off": 69708,
   "max": 56,
   "kind": "dialogue",
   "jp": "すべてを認めあって\\nぶつけあうことで\\n火花を散らすんだ",
   "en": "",
   "op": "0x62",
   "msg": "0x546d"
  },
  {
   "id": "m_013003:0x115a4",
   "off": 71076,
   "max": 56,
   "kind": "dialogue",
   "jp": "だからロックは面白え！\\nだからロックは\\n魂を熱くする！",
   "en": "",
   "op": "0x62",
   "msg": "0x546e"
  },
  {
   "id": "m_013003:0x11db8",
   "off": 73144,
   "max": 44,
   "kind": "dialogue",
   "jp": "ジュニア\\nお前たちには本当に\\n感謝している",
   "en": "",
   "op": "0x62",
   "msg": "0x546f"
  },
  {
   "id": "m_013003:0x12260",
   "off": 74336,
   "max": 52,
   "kind": "dialogue",
   "jp": "大きな壁にぶつかることで\\n大切なことを思い出せたよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5470"
  },
  {
   "id": "m_013003:0x12710",
   "off": 75536,
   "max": 36,
   "kind": "dialogue",
   "jp": "近藤さんの夢を\\n実現させるために",
   "en": "",
   "op": "0x62",
   "msg": "0x5471"
  },
  {
   "id": "m_013003:0x12bb0",
   "off": 76720,
   "max": 44,
   "kind": "dialogue",
   "jp": "僕たちは\\n立ち止まってなんか\\nいられない",
   "en": "",
   "op": "0x62",
   "msg": "0x5472"
  },
  {
   "id": "m_013003:0x13360",
   "off": 78688,
   "max": 52,
   "kind": "dialogue",
   "jp": "今のわしらには\\nそれにふさわしい\\nロックがあるはず",
   "en": "",
   "op": "0x62",
   "msg": "0x5473"
  },
  {
   "id": "m_013003:0x13cac",
   "off": 81068,
   "max": 40,
   "kind": "dialogue",
   "jp": "この日のために\\n新曲を作り上げたぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5474"
  },
  {
   "id": "m_013003:0x144a8",
   "off": 83112,
   "max": 64,
   "kind": "dialogue",
   "jp": "オレに向かってロックを\\n語るとは　大きく出たな\\nレッドボーイ",
   "en": "",
   "op": "0x62",
   "msg": "0x5475"
  },
  {
   "id": "m_013003:0x14c54",
   "off": 85076,
   "max": 12,
   "kind": "dialogue",
   "jp": "オッケーだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5476"
  },
  {
   "id": "m_013003:0x14c74",
   "off": 85108,
   "max": 44,
   "kind": "dialogue",
   "jp": "もっと\\n聴かせてみろ\\nお前たちのロックを",
   "en": "",
   "op": "0x62",
   "msg": "0x5477"
  },
  {
   "id": "m_013003:0x14cb4",
   "off": 85172,
   "max": 40,
   "kind": "dialogue",
   "jp": "もっと\\n響かせてみろ\\nこのオレの魂に！",
   "en": "",
   "op": "0x62",
   "msg": "0x5478"
  },
  {
   "id": "m_013003:0x1584c",
   "off": 88140,
   "max": 64,
   "kind": "dialogue",
   "jp": "覚悟しろよ　ジュニア\\nクールに構えていられる\\nのも　今だけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x5479"
  },
  {
   "id": "m_013003:0x15eb4",
   "off": 89780,
   "max": 68,
   "kind": "dialogue",
   "jp": "さあ　来たぜ来たぜ！\\n俺様の中で新しいロックが\\n雷光してやがる！",
   "en": "",
   "op": "0x62",
   "msg": "0x547a"
  },
  {
   "id": "m_013003:0x16594",
   "off": 91540,
   "max": 56,
   "kind": "dialogue",
   "jp": "誰の支配も必要ない\\n私たちの想いが\\n歌が　未来を作る！",
   "en": "",
   "op": "0x62",
   "msg": "0x547b"
  },
  {
   "id": "m_013003:0x16c68",
   "off": 93288,
   "max": 28,
   "kind": "dialogue",
   "jp": "俺たちは未熟\\nかもしれない",
   "en": "",
   "op": "0x62",
   "msg": "0x547c"
  },
  {
   "id": "m_013003:0x17100",
   "off": 94464,
   "max": 56,
   "kind": "dialogue",
   "jp": "だがそれは\\n前に進む余地が――\\n未来があるということ",
   "en": "",
   "op": "0x62",
   "msg": "0x547d"
  },
  {
   "id": "m_013003:0x177d0",
   "off": 96208,
   "max": 68,
   "kind": "dialogue",
   "jp": "今日の僕たちは\\n昨日までの僕たちじゃない\\nそれを教えてあげるよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x547e"
  },
  {
   "id": "m_013003:0x17eac",
   "off": 97964,
   "max": 52,
   "kind": "dialogue",
   "jp": "じゅにあ！\\nわしらのロックを\\nお前の魂に刻み込め！",
   "en": "",
   "op": "0x62",
   "msg": "0x547f"
