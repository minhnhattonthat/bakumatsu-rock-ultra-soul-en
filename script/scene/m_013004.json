{
 "source": "m_013004.bin",
 "format": "mz-scene",
 "entries": [
  {
   "id": "m_013004:0x10f0",
   "off": 4336,
   "max": 52,
   "kind": "dialogue",
   "jp": "龍馬を中心としたロックは\\n雷舞会場を大いに沸かせた",
   "en": "",
   "op": "0x62",
   "msg": "0x5484"
  },
  {
   "id": "m_013004:0x1134",
   "off": 4404,
   "max": 48,
   "kind": "dialogue",
   "jp": "観客達の熱狂が龍馬達の\\n心と超魂を揺さぶり――",
   "en": "",
   "op": "0x62",
   "msg": "0x5485"
  },
  {
   "id": "m_013004:0x1174",
   "off": 4468,
   "max": 96,
   "kind": "dialogue",
   "jp": "揺さぶられた心と超魂は\\n互いに共鳴して巨大な魂の\\nうねりとなって雷舞会場を\\n呑み込んでいった",
   "en": "",
   "op": "0x62",
   "msg": "0x5486"
  },
  {
   "id": "m_013004:0x1614",
   "off": 5652,
   "max": 24,
   "kind": "dialogue",
   "jp": "言葉にならないわ……",
   "en": "",
   "op": "0x62",
   "msg": "0x5487"
  },
  {
   "id": "m_013004:0x1cc4",
   "off": 7364,
   "max": 40,
   "kind": "dialogue",
   "jp": "これほど心に響く\\nロックは初めて……",
   "en": "",
   "op": "0x62",
   "msg": "0x5488"
  },
  {
   "id": "m_013004:0x24c8",
   "off": 9416,
   "max": 24,
   "kind": "dialogue",
   "jp": "すごく心が震えて……",
   "en": "",
   "op": "0x62",
   "msg": "0x5489"
  },
  {
   "id": "m_013004:0x2964",
   "off": 10596,
   "max": 32,
   "kind": "dialogue",
   "jp": "熱い涙がぁ\\nあふれますぅ……",
   "en": "",
   "op": "0x62",
   "msg": "0x548a"
  },
  {
   "id": "m_013004:0x2f00",
   "off": 12032,
   "max": 32,
   "kind": "dialogue",
   "jp": "大地を揺るがす程の\\n歓声が響く",
   "en": "",
   "op": "0x62",
   "msg": "0x548b"
  },
  {
   "id": "m_013004:0x35f4",
   "off": 13812,
   "max": 60,
   "kind": "dialogue",
   "jp": "じゅにあ！\\nお前の魂に伝わったか？\\nわしらの熱い想いが！",
   "en": "",
   "op": "0x62",
   "msg": "0x548c"
  },
  {
   "id": "m_013004:0x3aac",
   "off": 15020,
   "max": 28,
   "kind": "dialogue",
   "jp": "オッケーだ\\nレッドボーイ",
   "en": "",
   "op": "0x62",
   "msg": "0x548d"
  },
  {
   "id": "m_013004:0x3ae8",
   "off": 15080,
   "max": 56,
   "kind": "dialogue",
   "jp": "極東の小さな島国に\\nこれほどのロッカーが\\nいたとはな",
   "en": "",
   "op": "0x62",
   "msg": "0x548e"
  },
  {
   "id": "m_013004:0x3b30",
   "off": 15152,
   "max": 40,
   "kind": "dialogue",
   "jp": "お前たちの超魂は\\n神にこそふさわしい",
   "en": "",
   "op": "0x62",
   "msg": "0x548f"
  },
  {
   "id": "m_013004:0x4668",
   "off": 18024,
   "max": 28,
   "kind": "dialogue",
   "jp": "さあ\\n超魂をオレに捧げろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5490"
  },
  {
   "id": "m_013004:0x469c",
   "off": 18076,
   "max": 40,
   "kind": "dialogue",
   "jp": "オレは完全無欠の\\nロックの神になる！",
   "en": "",
   "op": "0x62",
   "msg": "0x5491"
  },
  {
   "id": "m_013004:0x5048",
   "off": 20552,
   "max": 64,
   "kind": "dialogue",
   "jp": "まだ　わからんのか\\nロックは　歌は\\nそんなもんじゃないぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5492"
  },
  {
   "id": "m_013004:0x559c",
   "off": 21916,
   "max": 56,
   "kind": "dialogue",
   "jp": "なあ　じゅにあ\\nロックは超魂で奏でる\\nものじゃないぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x5493"
  },
  {
   "id": "m_013004:0x55e4",
   "off": 21988,
   "max": 44,
   "kind": "dialogue",
   "jp": "魂がロックを生み出し\\nロックが魂を震わせる",
   "en": "",
   "op": "0x62",
   "msg": "0x5494"
  },
  {
   "id": "m_013004:0x5620",
   "off": 22048,
   "max": 36,
   "kind": "dialogue",
   "jp": "その力の結晶が\\n超魂になるんじゃ",
   "en": "",
   "op": "0x62",
   "msg": "0x5495"
  },
  {
   "id": "m_013004:0x5b58",
   "off": 23384,
   "max": 28,
   "kind": "dialogue",
   "jp": "……オレにロックを語るな",
   "en": "",
   "op": "0x62",
   "msg": "0x5496"
  },
  {
   "id": "m_013004:0x5ff0",
   "off": 24560,
   "max": 52,
   "kind": "dialogue",
   "jp": "奪った超魂で奏でても\\nそれは自分の\\nロックじゃない",
   "en": "",
   "op": "0x62",
   "msg": "0x5497"
  },
  {
   "id": "m_013004:0x6a24",
   "off": 27172,
   "max": 44,
   "kind": "dialogue",
   "jp": "己の中から熱くたぎって\\n湧き出てくる音楽！",
   "en": "",
   "op": "0x62",
   "msg": "0x5498"
  },
  {
   "id": "m_013004:0x6b7c",
   "off": 27516,
   "max": 68,
   "kind": "dialogue",
   "jp": "超魂よりも己の魂を震わせ\\n溢れ出るもの！\\nそれこそがロックぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x5499"
  },
  {
   "id": "m_013004:0x7404",
   "off": 29700,
   "max": 16,
   "kind": "dialogue",
   "jp": "だからどうした",
   "en": "",
   "op": "0x62",
   "msg": "0x549a"
  },
  {
   "id": "m_013004:0x7ba4",
   "off": 31652,
   "max": 32,
   "kind": "dialogue",
   "jp": "オレは神！\\nロックスターだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x549b"
  },
  {
   "id": "m_013004:0x83b8",
   "off": 33720,
   "max": 64,
   "kind": "dialogue",
   "jp": "な　なんだ？\\nジュニアから感じる\\nこの重圧（プレッシャー）は",
   "en": "",
   "op": "0x62",
   "msg": "0x549c"
  },
  {
   "id": "m_013004:0x8cb4",
   "off": 36020,
   "max": 68,
   "kind": "dialogue",
   "jp": "神（スター）は負けない！\\n負けないからこそ\\n王（キング）なのだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x549d"
  },
  {
   "id": "m_013004:0x8d08",
   "off": 36104,
   "max": 32,
   "kind": "dialogue",
   "jp": "聴かせてやろう\\n真のロックを！",
   "en": "",
   "op": "0x62",
   "msg": "0x549e"
  },
  {
   "id": "m_013004:0x9570",
   "off": 38256,
   "max": 32,
   "kind": "dialogue",
   "jp": "そして　全員跪け！\\n神の前に！",
   "en": "",
   "op": "0x62",
   "msg": "0x549f"
  },
  {
   "id": "m_013004:0x9a14",
   "off": 39444,
   "max": 8,
   "kind": "dialogue",
   "jp": "Ｊ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54a0"
  },
  {
   "id": "m_013004:0xad80",
   "off": 44416,
   "max": 52,
   "kind": "dialogue",
   "jp": "フハハハハハハ！\\nいいぞ　Ｊ！\\nもっと　もっとだ",
   "en": "",
   "op": "0x62",
   "msg": "0x54a1"
  },
  {
   "id": "m_013004:0xb67c",
   "off": 46716,
   "max": 28,
   "kind": "dialogue",
   "jp": "な　なんじゃ\\nこの力は",
   "en": "",
   "op": "0x62",
   "msg": "0x54a2"
  },
  {
   "id": "m_013004:0xbfb4",
   "off": 49076,
   "max": 28,
   "kind": "dialogue",
   "jp": "ジュニア！\\nいけません",
   "en": "",
   "op": "0x62",
   "msg": "0x54a3"
  },
  {
   "id": "m_013004:0xc8d0",
   "off": 51408,
   "max": 32,
   "kind": "dialogue",
   "jp": "センセー！\\nどうしたんじゃ？",
   "en": "",
   "op": "0x62",
   "msg": "0x54a4"
  },
  {
   "id": "m_013004:0xcd6c",
   "off": 52588,
   "max": 64,
   "kind": "dialogue",
   "jp": "Ｊが奏でるギターの\\n音色で　超魂から力を\\n引き出してるんです",
   "en": "",
   "op": "0x62",
   "msg": "0x54a5"
  },
  {
   "id": "m_013004:0xd2c0",
   "off": 53952,
   "max": 28,
   "kind": "dialogue",
   "jp": "それはどういう\\nことぜよ",
   "en": "",
   "op": "0x62",
   "msg": "0x54a6"
  },
  {
   "id": "m_013004:0xd758",
   "off": 55128,
   "max": 64,
   "kind": "dialogue",
   "jp": "無理に超魂の力を\\n引き出そうとすれば\\n心が壊れてしまいます！",
   "en": "",
   "op": "0x62",
   "msg": "0x54a7"
  },
  {
   "id": "m_013004:0xdcb4",
   "off": 56500,
   "max": 48,
   "kind": "dialogue",
   "jp": "なんだって\\nやめるんじゃ！\\nＪ！　じゅにあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54a8"
  },
  {
   "id": "m_013004:0xe5fc",
   "off": 58876,
   "max": 8,
   "kind": "dialogue",
   "jp": "……",
   "en": "",
   "op": "0x62",
   "msg": "0x54a9"
  },
  {
   "id": "m_013004:0xeb28",
   "off": 60200,
   "max": 24,
   "kind": "dialogue",
   "jp": "手を止めるな！\\nＪ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54aa"
  },
  {
   "id": "m_013004:0xf2d0",
   "off": 62160,
   "max": 24,
   "kind": "dialogue",
   "jp": "ジュニア！　\\nやめろ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54ab"
  },
  {
   "id": "m_013004:0xf980",
   "off": 63872,
   "max": 48,
   "kind": "dialogue",
   "jp": "オレは今　最高に楽しい\\nこんな気分は　初めてだ",
   "en": "",
   "op": "0x62",
   "msg": "0x54ac"
  },
  {
   "id": "m_013004:0xf9c0",
   "off": 63936,
   "max": 56,
   "kind": "dialogue",
   "jp": "お前たちのロックを\\n聴かされて　黙って\\nいられるか？",
   "en": "",
   "op": "0x62",
   "msg": "0x54ad"
  },
  {
   "id": "m_013004:0xfa08",
   "off": 64008,
   "max": 48,
   "kind": "dialogue",
   "jp": "この気持ちを\\nこの衝動を\\n抑えきれるものか！",
   "en": "",
   "op": "0x62",
   "msg": "0x54ae"
  },
  {
   "id": "m_013004:0xfa48",
   "off": 64072,
   "max": 44,
   "kind": "dialogue",
   "jp": "オレは\\nオレのために歌う\\nただそれだけだ",
   "en": "",
   "op": "0x62",
   "msg": "0x54af"
  },
  {
   "id": "m_013004:0x104ec",
   "off": 66796,
   "max": 28,
   "kind": "dialogue",
   "jp": "Ｊ\\nお前のために\\n弾け",
   "en": "",
   "op": "0x62",
   "msg": "0x54b0"
  },
  {
   "id": "m_013004:0x10518",
   "off": 66840,
   "max": 48,
   "kind": "dialogue",
   "jp": "お前のロックで\\nオレの魂に\\n火をつけてくれ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54b1"
  },
  {
   "id": "m_013004:0x110c4",
   "off": 69828,
   "max": 36,
   "kind": "dialogue",
   "jp": "オッケー！\\nそうだ！\\nこの力だ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54b2"
  },
  {
   "id": "m_013004:0x11100",
   "off": 69888,
   "max": 68,
   "kind": "dialogue",
   "jp": "これこそ　オレの力！\\n誰に何と言われようとも\\nオレが生きてきた証！",
   "en": "",
   "op": "0x62",
   "msg": "0x54b3"
  },
  {
   "id": "m_013004:0x11ab4",
   "off": 72372,
   "max": 56,
   "kind": "dialogue",
   "jp": "今こそ　拘束を解こう！\\nもう抑えつける必要は\\nない！",
   "en": "",
   "op": "0x62",
   "msg": "0x54b4"
  },
  {
   "id": "m_013004:0x12670",
   "off": 75376,
   "max": 60,
   "kind": "dialogue",
   "jp": "あの拘束衣は\\n強すぎる超魂の力を\\n抑えるためだったのか",
   "en": "",
   "op": "0x62",
   "msg": "0x54b5"
  },
  {
   "id": "m_013004:0x12d44",
   "off": 77124,
   "max": 52,
   "kind": "dialogue",
   "jp": "す　すごい！\\n複数の超魂を同時に\\n解放するなんて",
   "en": "",
   "op": "0x62",
   "msg": "0x54b6"
  },
  {
   "id": "m_013004:0x13414",
   "off": 78868,
   "max": 36,
   "kind": "dialogue",
   "jp": "解放ですって？\\nあれは暴走です",
   "en": "",
   "op": "0x62",
   "msg": "0x54b7"
  },
  {
   "id": "m_013004:0x13bfc",
   "off": 80892,
   "max": 32,
   "kind": "dialogue",
   "jp": "聴け\\nこれが神のロックだ",
   "en": "",
   "op": "0x62",
   "msg": "0x54b8"
  },
  {
   "id": "m_013004:0x145ec",
   "off": 83436,
   "max": 44,
   "kind": "dialogue",
   "jp": "いかんぜよ！\\nやめるんじゃ！\\nじゅにあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54b9"
  },
  {
   "id": "m_013004:0x14ef8",
   "off": 85752,
   "max": 24,
   "kind": "dialogue",
   "jp": "龍馬くん\\n歌うんです",
   "en": "",
   "op": "0x62",
   "msg": "0x54ba"
  },
  {
   "id": "m_013004:0x1538c",
   "off": 86924,
   "max": 44,
   "kind": "dialogue",
   "jp": "センセー！\\nそれでじゅにあを\\n救えるんか",
   "en": "",
   "op": "0x62",
   "msg": "0x54bb"
  },
  {
   "id": "m_013004:0x15834",
   "off": 88116,
   "max": 56,
   "kind": "dialogue",
   "jp": "私たち五人に\\n不可能はありません\\n私たちならできます！",
   "en": "",
   "op": "0x62",
   "msg": "0x54bc"
  },
  {
   "id": "m_013004:0x15ef8",
   "off": 89848,
   "max": 44,
   "kind": "dialogue",
   "jp": "そうじゃ\\nロックは人の心を\\n楽しませるもの",
   "en": "",
   "op": "0x62",
   "msg": "0x54bd"
  },
  {
   "id": "m_013004:0x15f34",
   "off": 89908,
   "max": 56,
   "kind": "dialogue",
   "jp": "ジュニアのロックの\\nパワーは　確かに\\nすごいぜよ……",
   "en": "",
   "op": "0x62",
   "msg": "0x54be"
  },
  {
   "id": "m_013004:0x168d4",
   "off": 92372,
   "max": 64,
   "kind": "dialogue",
   "jp": "だが　違うんじゃ！\\n自分が楽しくない\\nロックなんて間違っとる！",
   "en": "",
   "op": "0x62",
   "msg": "0x54bf"
  },
  {
   "id": "m_013004:0x174c8",
   "off": 95432,
   "max": 56,
   "kind": "dialogue",
   "jp": "ほう　神のロックに\\n正面から立ち向かおうと\\nいうのか",
   "en": "",
   "op": "0x62",
   "msg": "0x54c0"
  },
  {
   "id": "m_013004:0x17a14",
   "off": 96788,
   "max": 24,
   "kind": "dialogue",
   "jp": "いいぞ！\\nオッケーだ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54c1"
  },
  {
   "id": "m_013004:0x17a3c",
   "off": 96828,
   "max": 64,
   "kind": "dialogue",
   "jp": "それでこそロック！\\n我がライバルと認めよう\\n燃えてきたぞ",
   "en": "",
   "op": "0x62",
   "msg": "0x54c2"
  },
  {
   "id": "m_013004:0x18484",
   "off": 99460,
   "max": 40,
   "kind": "dialogue",
   "jp": "坂本\\n俺は　お前を信じる\\n存分に歌え",
   "en": "",
   "op": "0x62",
   "msg": "0x54c3"
  },
  {
   "id": "m_013004:0x18b44",
   "off": 101188,
   "max": 56,
   "kind": "dialogue",
   "jp": "トサカくんの想いは\\n僕らの想いだよ\\nそれを忘れないで",
   "en": "",
   "op": "0x62",
   "msg": "0x54c4"
  },
  {
   "id": "m_013004:0x19228",
   "off": 102952,
   "max": 48,
   "kind": "dialogue",
   "jp": "私たちのほとばしる熱情を\\n熱いロックに乗せて！",
   "en": "",
   "op": "0x62",
   "msg": "0x54c5"
  },
  {
   "id": "m_013004:0x198f4",
   "off": 104692,
   "max": 56,
   "kind": "dialogue",
   "jp": "オレ様のロックで\\nジュニアのハートに\\nブチ込んでやる！",
   "en": "",
   "op": "0x62",
   "msg": "0x54c6"
  },
  {
   "id": "m_013004:0x1a4b8",
   "off": 107704,
   "max": 60,
   "kind": "dialogue",
   "jp": "うぉぉぉおおお！\\nこれが最後の曲\\n（ラストナンバー）ぜよ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54c7"
  },
  {
   "id": "m_013004:0x1a508",
   "off": 107784,
   "max": 72,
   "kind": "dialogue",
   "jp": "わしらの心から……\\n魂から溢れ出す熱いロック\\nで目を覚ませ　じゅにあ！",
   "en": "",
   "op": "0x62",
   "msg": "0x54c8"
  }
 ]
}
